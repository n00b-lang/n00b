# a module comment
module shapes {
  profile bce
  target x86_64-linux
  meta !ir.note("hand written")

  global @count: i32

  static global @seen: (x: int, y: i64)

  static func @helper() -> void {
    block e:
      unreachable
  }

  func @sum(%n: i32, %acc: i32) -> i32 {
    local $t: ptr[i32]

    block entry:
      # the loop counter starts here
      %z: i32 = const 0 !loc(0, 1, 2, 1, 3, 1, 4)
      jump loop

    block loop:
      %p: i32 = phi [entry: %z], [body: %s]
      %c: bool = lt %p, %n
      branch %c, body, done

    block body:
      %s: i32 = add wrap %p, %acc !ir.rule("sint" from typed)
      %sz: u64 = sizeof (i32, i32) -> i32
      switch %s, default: done, [0: loop], [1: done]

    block done:
      return %acc
  }
}
