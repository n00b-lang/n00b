<ref> ::= %"$" %INTEGER

<tag> ::= %STRING

<num> ::= %INTEGER

<name> ::= %IDENTIFIER

<a-scope> ::= <tag> | <tag> %"," <ref>

<a-declares> ::= <ref> | <ref> %"," <tag>

<a-assigns> ::= <ref> %"," <ref>

<a-branch> ::= <ref> %"," <ref>
             | <ref> %"," <ref> %"," <ref>

<a-pair> ::= <ref> | <ref> %"," <ref>

<a-ref> ::= <ref>

<a-tag> ::= <tag>

<a-tags> ::= <tag> (%"," <tag>)*

<a-disambig> ::= <name> | <name> %"," <num>

<a-direction> ::= <ref> %"," <tag>
