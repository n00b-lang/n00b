<ref> ::= %"$" %INTEGER | %"$" %IDENTIFIER

<tag> ::= %STRING

<num> ::= %INTEGER

<name> ::= %IDENTIFIER

<a-scope> ::= <tag> | <tag> %"," <ref>

<a-declares> ::= <ref>
               | <ref> %"," <tag>
               | <ref> %"," <ref>
               | <ref> %"," <ref> %"," <tag>

<a-type> ::= <ref> | <ref> %"," <type> | <ref> %"," <tag>

<a-assigns> ::= <ref> %"," <ref>

<a-branch> ::= <ref> %"," <ref>
             | <ref> %"," <ref> %"," <ref>

<a-pair> ::= <ref> | <ref> %"," <ref>

<a-ref> ::= <ref>


<a-tag> ::= <tag>

<a-capture> ::= <tag> | <tag> %"," <tag>

<a-adt> ::= <tag> %"," <ref> %"," <tag> %"," <ref>

<a-literal> ::= <tag> | <tag> %"," <ref>

<a-int> ::= <num>

<a-disambig> ::= <pred> | <pred> %"," <num>

<a-infer> ::= <infer> | <ref> %"," <infer> | <tag> | <ref> %"," <tag>

<a-mutability> ::= <ref> %"," <tag>

<a-namespace> ::= <tag>

<a-direction> ::= <ref> %"," <tag>

<a-emit> ::= <tag> (%"," <ref>)*

<a-constrain> ::= <ref> %"," <con-list>

<con-list> ::= <con> | <con> %"+" <con-list>

<con> ::= %"==" <type>
        | %"!=" <type>
        | %"one_of" %"(" <type-list> %")"
        | %"promotes_to" <type>
        | %"has_field" %"(" %IDENTIFIER %":" <type> %")"
        | %"has_param" %"(" <num> %"," <type> %")"
        | %IDENTIFIER

<type-list> ::= <type> | <type> %"," <type-list>

<a-val> ::= <val>

<val> ::= <ref>
        | <num>
        | %"sizeof" %"(" <type> %")"
        | %"alignof" %"(" <type> %")"
        | %"offsetof" %"(" <type> %"," %IDENTIFIER %")"

<pred> ::= %IDENTIFIER | <pred-call>

<pred-call> ::= %IDENTIFIER %"(" %")"
              | %IDENTIFIER %"(" <pred-args> %")"

<pred-args> ::= <pred-arg> | <pred-arg> %"," <pred-args>

<pred-arg> ::= <ref> | <num> | <tag> | <name> | <pred-call>
