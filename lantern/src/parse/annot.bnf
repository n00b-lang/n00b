<ref> ::= %"$" %INTEGER | %"$" %IDENTIFIER

<tag> ::= %STRING

<num> ::= %INTEGER

<name> ::= %IDENTIFIER

<a-scope> ::= <tag> | <tag> %"," <ref>

<a-declares> ::= <ref> | <ref> %"," <tag>

<a-assigns> ::= <ref> %"," <ref>

<a-branch> ::= <ref> %"," <ref>
             | <ref> %"," <ref> %"," <ref>

<a-pair> ::= <ref> | <ref> %"," <ref>

<a-ref> ::= <ref>

<a-tag> ::= <tag>

<a-tags> ::= <tag> (%"," <tag>)*

<a-disambig> ::= <pred> | <pred> %"," <num>

<a-namespace> ::= <tag>

<a-direction> ::= <ref> %"," <tag>

<pred> ::= %IDENTIFIER | <pred-call>

<pred-call> ::= %IDENTIFIER %"(" %")"
              | %IDENTIFIER %"(" <pred-args> %")"

<pred-args> ::= <pred-arg> | <pred-arg> %"," <pred-args>

<pred-arg> ::= <ref> | <num> | <tag> | <name> | <pred-call>
