@lex-embed("<?php", "?>", as("INLINE_HTML"), open_as("OPEN_TAG"), close_as("CLOSE_TAG"))
@lex-comment("//")
@lex-comment("#")
@lex-comment("/*", "*/")
@lex-heredoc-header("php-label", quotes("single", "double"))
@lex-heredoc("<<<", header("php-label"), as("HEREDOC"),
             terminator_indent("allow"), body_indent("strip"))
@lex-string('"', '"', escape('\\'), as("ENCAPSED_STRING"))
@lex-string("'", "'", escape('\\'), as("STRING"))
@lex-sigil("$", as("VARIABLE"))
@lex-number(digits("0123456789"), sep("_"), point("leading", "trailing"), exp("eE"), int("INTEGER"), float("FLOAT"))
@lex-number(prefix("0x"), digits("0123456789abcdefABCDEF"), sep("_"), int("INTEGER"))
@lex-number(prefix("0b"), digits("01"), sep("_"), int("INTEGER"))
@lex-number(prefix("0o"), digits("01234567"), sep("_"), int("INTEGER"))
@lex-ident(as("IDENTIFIER"))
@lex-layout(brackets("()[]{}"))
