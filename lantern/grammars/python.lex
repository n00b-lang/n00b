@lex-comment("# type:", as("TYPE_COMMENT"))
@lex-comment("#")
@lex-string-family(plain, prefixes("u", "U", "b", "B"), quotes('"', "'"), escape('\\'), as("STRING"))
@lex-string-family(prefixes("r", "R", "br", "Br", "bR", "BR", "rb", "rB", "Rb", "RB"), quotes('"', "'"), raw, as("STRING"))
@lex-string-family(prefixes("f", "F"), quotes('"', "'"), escape('\\'), interp("{", "}"), hole_tokens, as("FSTRING_START", "FSTRING_MIDDLE", "FSTRING_END"))
@lex-string-family(prefixes("fr", "fR", "Fr", "FR", "rf", "rF", "Rf", "RF"), quotes('"', "'"), raw, interp("{", "}"), hole_tokens, as("FSTRING_START", "FSTRING_MIDDLE", "FSTRING_END"))
@lex-string-family(plain, prefixes("u", "U", "b", "B"), quotes('"""', "'''"), escape('\\'), multiline, as("STRING"))
@lex-string-family(prefixes("r", "R", "br", "Br", "bR", "BR", "rb", "rB", "Rb", "RB"), quotes('"""', "'''"), raw, multiline, as("STRING"))
@lex-string-family(prefixes("f", "F"), quotes('"""', "'''"), escape('\\'), multiline, interp("{", "}"), hole_tokens, as("FSTRING_START", "FSTRING_MIDDLE", "FSTRING_END"))
@lex-string-family(prefixes("fr", "fR", "Fr", "FR", "rf", "rF", "Rf", "RF"), quotes('"""', "'''"), raw, multiline, interp("{", "}"), hole_tokens, as("FSTRING_START", "FSTRING_MIDDLE", "FSTRING_END"))
@lex-number(digits("0123456789"), sep("_"), point("leading", "trailing"), exp("eE"), int("INTEGER"), float("FLOAT"), suffix("j", "FLOAT"), suffix("J", "FLOAT"))
@lex-number(prefix("0x"), digits("0123456789abcdefABCDEF"), sep("_", "after-prefix"), int("INTEGER"))
@lex-number(prefix("0b"), digits("01"), sep("_", "after-prefix"), int("INTEGER"))
@lex-number(prefix("0o"), digits("01234567"), sep("_", "after-prefix"), int("INTEGER"))
@lex-ident(as("IDENTIFIER"))
@lex-soft-keywords("match", "case", "type")
@lex-layout(indent("INDENT", "DEDENT"), newline("NEWLINE"), eof("ENDMARKER"), continue('\\'), brackets("()[]{}"))
