@lex-comment("//")
@lex-comment("/*", "*/")
@lex-string('"""', '"""', escape('\\'), multiline, as("TEXT_BLOCK"))
@lex-string('"', '"', escape('\\'), as("STRING"))
@lex-string("'", "'", escape('\\'), scalar, as("CHAR"))
@lex-number(digits("0123456789"), sep("_"), point("leading", "trailing"), exp("eE"), int("INTEGER"), float("FLOAT"), suffix("L", "INTEGER", "integer"), suffix("l", "INTEGER", "integer"), suffix("f", "FLOAT"), suffix("F", "FLOAT"), suffix("d", "FLOAT"), suffix("D", "FLOAT"))
@lex-number(prefix("0x"), digits("0123456789abcdefABCDEF"), sep("_"), point("trailing", "exponent-required"), exp("pP"), int("INTEGER"), float("FLOAT"), suffix("L", "INTEGER", "integer"), suffix("l", "INTEGER", "integer"), suffix("f", "FLOAT"), suffix("F", "FLOAT"), suffix("d", "FLOAT"), suffix("D", "FLOAT"))
@lex-number(prefix("0b"), digits("01"), sep("_"), int("INTEGER"), suffix("L", "INTEGER", "integer"), suffix("l", "INTEGER", "integer"))
@lex-ident(as("IDENTIFIER"))
@lex-layout(brackets("()[]{}"))
