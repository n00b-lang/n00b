@lex-comment("//")
@lex-comment("/*", "*/")
@lex-string('"', '"', escape('\\'), as("STRING"))
@lex-string("`", "`", raw, multiline, as("STRING"))
@lex-string("'", "'", escape('\\'), scalar, as("RUNE"))
@lex-number(digits("0123456789"), sep("_"), point("leading", "trailing"), exp("eE"), int("INTEGER"), float("FLOAT"), suffix("i", "IMAGINARY"))
@lex-number(prefix("0x"), digits("0123456789abcdefABCDEF"), sep("_", "after-prefix"), point("trailing", "exponent-required"), exp("pP"), int("INTEGER"), float("FLOAT"), suffix("i", "IMAGINARY"))
@lex-number(prefix("0b"), digits("01"), sep("_", "after-prefix"), int("INTEGER"), suffix("i", "IMAGINARY"))
@lex-number(prefix("0o"), digits("01234567"), sep("_", "after-prefix"), int("INTEGER"), suffix("i", "IMAGINARY"))
@lex-ident(as("IDENTIFIER"))
@lex-layout(brackets("()[]"), terminator(";", "break continue fallthrough return ++ --"))
