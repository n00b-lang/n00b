@lex-comment("//")
@lex-comment("/*", "*/")
@lex-string('"', '"', escape('\\'), as("STRING"))
@lex-string("'", "'", escape('\\'), as("CHAR"))
@lex-number-suffixes("c-integer", suffix("ull", "INTEGER", "integer"), suffix("ULL", "INTEGER", "integer"), suffix("llu", "INTEGER", "integer"), suffix("LLU", "INTEGER", "integer"), suffix("ul", "INTEGER", "integer"), suffix("UL", "INTEGER", "integer"), suffix("ll", "INTEGER", "integer"), suffix("LL", "INTEGER", "integer"), suffix("u", "INTEGER", "integer"), suffix("U", "INTEGER", "integer"))
@lex-number-suffixes("c-long", suffix("l"), suffix("L"))
@lex-number-suffixes("c-float", suffix("f", "FLOAT"), suffix("F", "FLOAT"))
@lex-number(digits("0123456789"), sep("'"), point("leading", "trailing"), exp("eE"), int("INTEGER"), float("FLOAT"), use_suffixes("c-integer", "c-long", "c-float"))
@lex-number(prefix("0x"), digits("0123456789abcdefABCDEF"), sep("'"), point("trailing", "exponent-required"), exp("pP"), int("INTEGER"), float("FLOAT"), use_suffixes("c-integer", "c-long", "c-float"))
@lex-number(prefix("0X"), digits("0123456789abcdefABCDEF"), sep("'"), point("trailing", "exponent-required"), exp("pP"), int("INTEGER"), float("FLOAT"), use_suffixes("c-integer", "c-long", "c-float"))
@lex-number(prefix("0b"), digits("01"), sep("'"), int("INTEGER"), use_suffixes("c-integer", "c-long"))
@lex-number(prefix("0B"), digits("01"), sep("'"), int("INTEGER"), use_suffixes("c-integer", "c-long"))
@lex-ident(as("IDENTIFIER"))
@lex-layout(brackets("()[]"), continue('\\'))
@lex-directive("#")
