# C2Y Grammar (translated from bCe parse.c)

@lex-comment("//")
@lex-comment("/*", "*/")
@lex-string('r"', '"', raw, as("STRING"))
@lex-string('b"', '"', escape('\\'), as("STRING"))
@lex-string('"', '"', escape('\\'), as("STRING"))
@lex-string("'", "'", escape('\\'), as("CHAR"))
@lex-number(radix("0x", "0123456789abcdefABCDEF'"), radix("0X", "0123456789abcdefABCDEF'"), radix("0b", "01'"), radix("0B", "01'"), sep("'"), exp("eEpP"), int("INTEGER"), float("FLOAT"))
@lex-number(suffix("ull", "INTEGER"), suffix("ULL", "INTEGER"), suffix("ul", "INTEGER"), suffix("UL", "INTEGER"), suffix("ll", "INTEGER"), suffix("LL", "INTEGER"), suffix("u", "INTEGER"), suffix("U", "INTEGER"), suffix("l", "INTEGER"), suffix("L", "INTEGER"), suffix("f", "FLOAT"), suffix("F", "FLOAT"))
@lex-ident(as("IDENTIFIER"))
@lex-layout(brackets("()[]"), continue('\\'))
@lex-directive("%", eol("PP_EOL"), as("PP_DIRECTIVE"))
@lex-directive("#", eol("PP_EOL"), as("PP_DIRECTIVE"))

<provided_identifier> ::= %IDENTIFIER

<constant> ::= %INTEGER
    | %FLOAT
    | %CHAR
    | %"true"
    | %"false"
    | %"nullptr"

<string_literal> ::= %STRING+

<typedef_name_terminal> ::= %TYPEDEF_NAME

<pp_directive> ::= %PP_DIRECTIVE

<pp_eol> ::= %PP_EOL

<pp_cond_if> ::= %"%if" <pp_expression> <pp_eol>

<pp_cond_elif> ::= %"%elif" <pp_expression> <pp_eol>

<pp_cond_else> ::= %"%else" <pp_eol>

<pp_cond_endif> ::= %"%endif" <pp_eol>

<pp_expression> ::= <pp_logical_or_expression>

<pp_logical_or_expression> ::= <pp_logical_or_expression> %"||" <pp_logical_and_expression>
    | <pp_logical_and_expression>

<pp_logical_and_expression> ::= <pp_logical_and_expression> %"&&" <pp_inclusive_or_expression>
    | <pp_inclusive_or_expression>

<pp_inclusive_or_expression> ::= <pp_inclusive_or_expression> %"|" <pp_exclusive_or_expression>
    | <pp_exclusive_or_expression>

<pp_exclusive_or_expression> ::= <pp_exclusive_or_expression> %"^" <pp_and_expression>
    | <pp_and_expression>

<pp_and_expression> ::= <pp_and_expression> %"&" <pp_equality_expression>
    | <pp_equality_expression>

<pp_equality_expression> ::= <pp_equality_expression> %"==" <pp_relational_expression>
    | <pp_equality_expression> %"!=" <pp_relational_expression>
    | <pp_relational_expression>

<pp_relational_expression> ::= <pp_relational_expression> %"<" <pp_shift_expression>
    | <pp_relational_expression> %"<=" <pp_shift_expression>
    | <pp_relational_expression> %">" <pp_shift_expression>
    | <pp_relational_expression> %">=" <pp_shift_expression>
    | <pp_shift_expression>

<pp_shift_expression> ::= <pp_shift_expression> %"<<" <pp_additive_expression>
    | <pp_shift_expression> %">>" <pp_additive_expression>
    | <pp_additive_expression>

<pp_additive_expression> ::= <pp_additive_expression> %"+" <pp_multiplicative_expression>
    | <pp_additive_expression> %"-" <pp_multiplicative_expression>
    | <pp_multiplicative_expression>

<pp_multiplicative_expression> ::= <pp_multiplicative_expression> %"*" <pp_unary_expression>
    | <pp_multiplicative_expression> %"/" <pp_unary_expression>
    | <pp_multiplicative_expression> %"%" <pp_unary_expression>
    | <pp_unary_expression>

<pp_unary_expression> ::= %"!" <pp_unary_expression>
    | %"~" <pp_unary_expression>
    | %"+" <pp_unary_expression>
    | %"-" <pp_unary_expression>
    | <pp_primary_expression>

<pp_primary_expression> ::= <constant>
    | <string_literal>
    | <identifier>
    | %"(" <pp_expression> %")"
    | <pp_builtin_call>

<pp_builtin_call> ::= %"%" <identifier> %"(" <pp_argument_expression_list>? %")"

<pp_argument_expression_list> ::= <pp_expression> (%"," <pp_expression>)*

<pp_external_cond_elif> ::= <pp_cond_elif> <external_declaration>*

<pp_external_cond_else> ::= <pp_cond_else> <external_declaration>*

<pp_external_cond_block> ::= <pp_cond_if> <external_declaration>* <pp_external_cond_elif>* <pp_external_cond_else>? <pp_cond_endif>

<pp_block_cond_elif> ::= <pp_cond_elif> <block_item>*

<pp_block_cond_else> ::= <pp_cond_else> <block_item>*

<pp_block_cond_block> ::= <pp_cond_if> <block_item>* <pp_block_cond_elif>* <pp_block_cond_else>? <pp_cond_endif>

<pp_member_cond_elif> ::= <pp_cond_elif> <member_declaration>*

<pp_member_cond_else> ::= <pp_cond_else> <member_declaration>*

<pp_member_cond_block> ::= <pp_cond_if> <member_declaration>* <pp_member_cond_elif>* <pp_member_cond_else>? <pp_cond_endif>

<pp_macro_invocation> ::= <identifier> %"(" <balanced_token_sequence>? %")" %";"?

<import_component> ::= <identifier>
    | %"private"
    | %"package"
    | %"export"
    | %"foreign"
    | %"float"
    | %"int"
    | %"static"

<import_group_items> ::= <import_component>
    | <import_group_items> %"," <import_component>

<import_group> ::= %"{" <import_group_items> %"}"

<import_path> ::= <import_component>
    | <import_path> %"." <import_component>
    | <import_path> %"." <import_group>

<import_declaration> ::= %"import" <import_path> %";"

<typedef_name> ::= <typedef_name_terminal> | %IDENTIFIER

<non_bracket_token> ::= %IDENTIFIER
    | %"__UINT8_TYPE__"
    | %"__UINT16_TYPE__"
    | %"__UINT32_TYPE__"
    | %"__UINT64_TYPE__"
    | %"__UINTPTR_TYPE__"
    | %"__SIZE_TYPE__"
    | %"__INT8_TYPE__"
    | %"__INT16_TYPE__"
    | %"__INT32_TYPE__"
    | %"__INT64_TYPE__"
    | %"__INTPTR_TYPE__"
    | %"__PTRDIFF_TYPE__"
    | %INTEGER
    | %FLOAT
    | %STRING
    | %CHAR
    | %TYPEDEF_NAME
    | %"+"
    | %"-"
    | %"*"
    | %"/"
    | %"%"
    | %"&"
    | %"|"
    | %"^"
    | %"~"
    | %"!"
    | %"="
    | %"<"
    | %">"
    | %"."
    | %","
    | %";"
    | %":"
    | %"?"
    | %"#"
    | %"@"
    | %"->"
    | %"++"
    | %"--"
    | %"<<"
    | %">>"
    | %"<="
    | %">="
    | %"=="
    | %"!="
    | %"&&"
    | %"||"
    | %"+="
    | %"-="
    | %"*="
    | %"/="
    | %"%="
    | %"&="
    | %"^="
    | %"|="
    | %"<<="
    | %">>="
    | %"..."
    | %"::"
    | %"__asm__"
    | %"__asm"
    | %"__attribute__"
    | %"__attribute"
    | %"__bf16"
    | %"__cdecl"
    | %"__declspec"
    | %"__Float32x4_t"
    | %"__Float64x2_t"
    | %"__SVBool_t"
    | %"__SVFloat32_t"
    | %"__SVFloat64_t"
    | %"__builtin_bit_cast"
    | %"__builtin_offsetof"
    | %"__builtin_types_compatible_p"
    | %"__builtin_va_arg"
    | %"__builtin_va_list"
    | %"__const__"
    | %"__const"
    | %"__extension__"
    | %"__fastcall"
    | %"__fp16"
    | %"__forceinline"
    | %"__inline__"
    | %"__inline"
    | %"__int16"
    | %"__int32"
    | %"__int64"
    | %"__int8"
    | %"__int128_t"
    | %"__int128"
    | %"__mfp8"
    | %"__nonnull"
    | %"__null_unspecified"
    | %"__nullable"
    | %"__ptr32"
    | %"__ptr64"
    | %"__restrict__"
    | %"__restrict"
    | %"__signed__"
    | %"__signed"
    | %"__stdcall"
    | %"__thread"
    | %"__thiscall"
    | %"__typeof__"
    | %"__typeof"
    | %"__uint128_t"
    | %"__vectorcall"
    | %"__volatile__"
    | %"__volatile"
    | %"_Alignas"
    | %"_Alignof"
    | %"_Atomic"
    | %"_BitInt"
    | %"_Bool"
    | %"_Complex"
    | %"_Countof"
    | %"_Decimal128"
    | %"_Decimal32"
    | %"_Decimal64"
    | %"_Float128"
    | %"_Float16"
    | %"_Float32"
    | %"_Float32x"
    | %"_Float64"
    | %"_Float64x"
    | %"_Generic"
    | %"_Nonnull"
    | %"_Noreturn"
    | %"_Null_unspecified"
    | %"_Nullable"
    | %"_Static_assert"
    | %"_Thread_local"
    | %"alignas"
    | %"alignof"
    | %"asm"
    | %"auto"
    | %"bool"
    | %"break"
    | %"case"
    | %"cast"
    | %"char"
    | %"const"
    | %"constexpr"
    | %"_Constexpr_paste"
    | %"continue"
    | %"default"
    | %"do"
    | %"double"
    | %"else"
    | %"enum"
    | %"extern"
    | %"export"
    | %"false"
    | %"float"
    | %"for"
    | %"foreign"
    | %"goto"
    | %"if"
    | %"inline"
    | %"int"
    | %"_Kargs"
    | %"_Kargs_of"
    | %"_Lower"
    | %"long"
    | %"nullptr"
    | %"_Once"
    | %"_Opaque"
    | %"_Package"
    | %"package"
    | %"private"
    | %"register"
    | %"restrict"
    | %"return"
    | %"short"
    | %"signed"
    | %"sizeof"
    | %"static_assert"
    | %"static"
    | %"struct"
    | %"switch"
    | %"thread_local"
    | %"true"
    | %"typedef"
    | %"var"
    | %"_Box"
    | %"_Box_init"
    | %"_Box_payload"
    | %"_Box_sizeof"
    | %"_Baseid"
    | %"_Typehash"
    | %"_Static_typehash"
    | %"_Static_sizeof"
    | %"_Static_is_pointer"
    | %"_Typeid"
    | %"_Vargs_type_of"
    | %"_Dynamic_is_pointer"
    | %"_Dynamic_payload"
    | %"typeof_unqual"
    | %"typeof"
    | %"_Typestr"
    | %"union"
    | %"unsigned"
    | %"void"
    | %"volatile"
    | %"while"

<token> ::= <non_bracket_token>
    | %"("
    | %")"
    | %"["
    | %"]"
    | %"{"
    | %"}"

<AND_expression> ::= <AND_expression> %"&" <equality_expression>
    | <equality_expression>

<abstract_declarator> ::= <pointer>
    | <pointer>? <direct_abstract_declarator>

<additive_expression> ::= <additive_expression> %"+" <multiplicative_expression>
    | <additive_expression> %"-" <multiplicative_expression>
    | <additive_expression> %"+%" <multiplicative_expression>
    | <additive_expression> %"-%" <multiplicative_expression>
    | <multiplicative_expression>

<_kw_kw_type_alignment> ::= %"alignas"
    | %"_Alignas"

<alignment_specifier> ::= <_kw_kw_type_alignment> %"(" <type_name> %")"
    | <_kw_kw_type_alignment> %"(" <constant_expression> %")"

<argument_expression_list> ::= <keyword_argument>
    | <assignment_expression>
    | <argument_expression_list> %"," <keyword_argument>
    | <argument_expression_list> %"," <assignment_expression>

<array_literal> ::= %"[" <array_literal_list>? %","? %"]"

<array_literal_list> ::= <initializer> (%"," <initializer>)*

<modified_literal> ::= %IDENTIFIER %"{" <array_literal_list>? %","? %"}"
    | %IDENTIFIER %"{" <dict_pair_list> %","? %"}"

# WP-011: bare dict literal `{key: value, ...}`. Disambiguates from
# `<braced_initializer>` by requiring at least one `<dict_pair>` (i.e.
# at least one `:` key/value separator).  Empty `{}` and comma-only
# initializer lists fall through to `<braced_initializer>`; designated
# initializers (`.x = 5`) likewise stay in `<braced_initializer>`.
# The `<modified_literal>` rule above shares <dict_pair_list> so that
# explicit `d{key: value, ...}` accepts the same body shape; the
# modifier-vs-bare distinction is resolved by the xform pass.
<dict_literal> ::= %"{" <dict_pair_list> %","? %"}"

<dict_pair_list> ::= <dict_pair> (%"," <dict_pair>)*

<dict_pair> ::= <initializer> %":" <initializer>

<array_abstract_declarator> ::= <direct_abstract_declarator>? %"[" <type_qualifier_list>? <assignment_expression>? %"]"
    | <direct_abstract_declarator>? %"[" %"static"? <type_qualifier_list>? <assignment_expression>? %"]"
    | <direct_abstract_declarator>? %"[" <type_qualifier_list> %"static" <assignment_expression> %"]"
    | <direct_abstract_declarator>? %"[" %"*" %"]"

<array_declarator> ::= <direct_declarator> %"[" <type_qualifier_list>? <assignment_expression>? %"]"
    | <direct_declarator> %"[" %"static" <type_qualifier_list>? <assignment_expression> %"]"
    | <direct_declarator> %"[" %"static"? <type_qualifier_list>? <assignment_expression>? %"]"
    | <direct_declarator> %"[" <type_qualifier_list> %"static" <assignment_expression> %"]"

<assignment_expression> ::= <unary_expression> <assignment_operator> <assignment_expression>
    | <conditional_expression>

<_ops_op_assign> ::= %"="
    | %"*="
    | %"/="
    | %"%="
    | %"+="
    | %"-="
    | %"+%="
    | %"-%="
    | %"*%="
    | %"<<="
    | %">>="
    | %"&="
    | %"^="
    | %"|="

<assignment_operator> ::= <_ops_op_assign>

<atomic_type_specifier> ::= %"_Atomic" %"(" <type_name> %")"

<attribute> ::= <attribute_token> <attribute_argument_clause>?

<attribute_argument_clause> ::= %"(" <balanced_token_sequence>? %")"

<attribute_declaration> ::= <attribute_specifier_sequence> %";"

<attribute_list> ::= <attribute> (%"," <attribute>?)*
    | (%"," <attribute>?)+

<attribute_prefix> ::= <identifier>

<attribute_prefixed_token> ::= <attribute_prefix> %"::" <identifier>

<attribute_specifier> ::= %"[" %"[" <attribute_list>? %"]" %"]"
    | <_kw_kw_gcc_attribute> %"(" %"(" <balanced_token_sequence>? %")" %")"
    | <_kw_kw_ms_declspec> %"(" <balanced_token_sequence>? %")"
    | <_kw_kw_ms_attribute>

<_kw_kw_gcc_attribute> ::= %"__attribute__"
    | %"__attribute"

<_kw_kw_ms_declspec> ::= %"__declspec"

<_kw_kw_ms_calling_convention> ::= %"__cdecl"
    | %"__fastcall"
    | %"__stdcall"
    | %"__thiscall"
    | %"__vectorcall"

<_kw_kw_ms_attribute> ::= <_kw_kw_ms_calling_convention>

<attribute_specifier_sequence> ::= <attribute_specifier>+

<attribute_token> ::= <attribute_prefixed_token>
    | <standard_attribute>

<balanced_token> ::= %"(" <balanced_token_sequence>? %")"
    | %"[" <balanced_token_sequence>? %"]"
    | %"{" <balanced_token_sequence>? %"}"
    | <synthetic_identifier>
    | <non_bracket_token>

<balanced_token_sequence> ::= <balanced_token>+

<block_item> ::= <local_declaration>
    | <label>
    | <unlabeled_statement>
    | <pp_directive>
    | <pp_block_cond_block>

<block_item_list> ::= <block_item>+

<braced_initializer> ::= %"{" <initializer_list> %","? %"}"
    | %"{" %"}"

<cast_expression> ::= %"cast" %"[" <type_name> %"]" <cast_expression>
    | %"__extension__" <cast_expression>
    | <unary_expression>

<compound_literal> ::= %"(" <storage_class_specifiers>? <type_name> %")" <braced_initializer>

<compound_statement> ::= %"{" <block_item_list>? %"}"

<conditional_expression> ::= <logical_OR_expression> %"?" <expression> %":" <conditional_expression>
<conditional_expression> ::= <logical_OR_expression>

<constant_expression> ::= <conditional_expression>

<constant_range_expression> ::= <constant_expression> %"..." <constant_expression>

<declaration> ::= %"var" <attribute_specifier_sequence>? <declaration_specifiers> <init_declarator_list> %";"
    | <attribute_specifier_sequence> <declaration_specifiers> <init_declarator_list> %";"
    | <declaration_specifiers> <init_declarator_list>? %";"
<declaration> ::= <static_assert_declaration>
    | <attribute_declaration>
    | %"var" <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <keyword_clause> %";"
    | %"var" <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <lower_clause> %";"
    | %"var" <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <keyword_clause> <lower_clause> %";"
    | <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <keyword_clause> %";"
    | <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <lower_clause> %";"
    | <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <keyword_clause> <lower_clause> %";"
    | <declaration_specifiers> <declarator> <rpc_clause> %";"
    | <declaration_specifiers> <declarator> <keyword_clause> <rpc_clause> %";"
    | <declaration_specifiers> <declarator> <rpc_clause> <keyword_clause> %";"
    | <declaration_specifiers> <attribute_specifier_sequence> %";"
    | %"__extension__" <declaration>

<local_declaration> ::= %"var" <attribute_specifier_sequence>? <declaration_specifiers> <init_declarator_list> %";"
    | %"static" <attribute_specifier_sequence>? <declaration_specifiers> <init_declarator_list> %";"
    | <attribute_specifier_sequence> %"static" <declaration_specifiers> <init_declarator_list> %";"
    | %"extern" <attribute_specifier_sequence>? <declaration_specifiers> <init_declarator_list> %";"
    | %"typedef" <attribute_specifier_sequence>? <declaration_specifiers> <init_declarator_list> %";"
    | <attribute_specifier_sequence>? <struct_or_union_specifier> <attribute_specifier_sequence>? %";"
    | <attribute_specifier_sequence>? <enum_specifier> <attribute_specifier_sequence>? %";"
    | <static_assert_declaration>
    | <attribute_declaration>
    | %"var" <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <keyword_clause> %";"
    | %"var" <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <lower_clause> %";"
    | %"var" <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <keyword_clause> <lower_clause> %";"
    | %"__extension__" <local_declaration>

<type_modifier_specifier> ::= <_kw_kw_type_qualifier>
    | <alignment_specifier>

<type_modifier_specifiers> ::= <type_modifier_specifier> <attribute_specifier_sequence>?
    | <type_modifier_specifiers> <type_modifier_specifier> <attribute_specifier_sequence>?

<declaration_prefix_specifier> ::= <storage_class_specifier>
    | <function_specifier>
    | <type_modifier_specifier>

<declaration_prefix_specifiers> ::= <declaration_prefix_specifier> <attribute_specifier_sequence>?
    | <declaration_prefix_specifiers> <declaration_prefix_specifier> <attribute_specifier_sequence>?

<declaration_specifier> ::= <declaration_prefix_specifier>
    | <type_specifier_qualifier>

<declaration_specifiers> ::= <declaration_prefix_specifiers>? <type_specifier_qualifier> <type_modifier_specifiers>? <attribute_specifier_sequence>?
    | %"auto" <attribute_specifier_sequence>?

<declarator> ::= <pointer>? <direct_declarator>

<designation> ::= <designator_list> %"="

<designator> ::= %"[" <constant_expression> %"]"
    | %"." <_member_name>

<designator_list> ::= <designator>+

<offsetof_member_designator> ::= <identifier> <designator>*

<direct_abstract_declarator> ::= <function_abstract_declarator> <attribute_specifier_sequence>?
    | <array_abstract_declarator> <attribute_specifier_sequence>?
    | %"(" <abstract_declarator> %")"
    | %"(" <attribute_specifier_sequence> <abstract_declarator> %")"

<direct_declarator> ::= %"(" <declarator> %")"
    | %"(" <attribute_specifier_sequence> <declarator> %")"
    | <function_declarator> <attribute_specifier_sequence>?
    | <array_declarator> <attribute_specifier_sequence>?
    | <identifier> <attribute_specifier_sequence>?
    | %TYPEDEF_NAME <attribute_specifier_sequence>?
    | <synthetic_identifier> <attribute_specifier_sequence>?

<enum_specifier> ::= %"enum" <attribute_specifier_sequence>? <tag_name>? <enum_type_specifier>? %"{" <enumerator_list> %"}"
    | %"enum" <attribute_specifier_sequence>? <tag_name>? <enum_type_specifier>? %"{" <enumerator_list> %"," %"}"
    | %"enum" <tag_name> <enum_type_specifier>?

<enum_type_specifier> ::= %":" <specifier_qualifier_list>

<enumeration_constant> ::= <identifier>

<enumerator> ::= <enumeration_constant> <attribute_specifier_sequence>? %"=" <constant_expression>
    | <enumeration_constant> <attribute_specifier_sequence>?

<enumerator_list> ::= <enumerator> (%"," <enumerator>)*

<equality_expression> ::= <equality_expression> %"==" <relational_expression>
    | <equality_expression> %"!=" <relational_expression>
    | <relational_expression>

<exclusive_OR_expression> ::= <exclusive_OR_expression> %"^" <AND_expression>
    | <AND_expression>

<expression> ::= <expression> %"," <assignment_expression>
    | <assignment_expression>

<expression_statement> ::= <attribute_specifier_sequence> <expression> %";"
    | <expression> %";"
    | %";"

<external_declaration> ::= <function_definition>
    | <declaration>
    | <attribute_specifier_sequence>
    | <gcc_asm_statement>
    | %";"
    | %"_Package" <identifier> %";"
    | <import_declaration>
    | <blueprint_declaration>
    | <variant_declaration>
    | <pp_macro_invocation>
    | <pp_directive>
    | <pp_external_cond_block>

<function_abstract_declarator> ::= <direct_abstract_declarator>? %"(" <parameter_type_list>? %")"

<function_body> ::= <compound_statement>

<generic_type_parameter> ::= %IDENTIFIER

<generic_type_parameter_list> ::= <generic_type_parameter> (%"," <generic_type_parameter>)*

<generic_function_parameters> ::= %"[" <generic_type_parameter_list> %"]"

<generic_type_argument> ::= <specifier_qualifier_list> <pointer> <direct_abstract_declarator>
    | <specifier_qualifier_list> <pointer>
    | <specifier_qualifier_list> <direct_abstract_declarator>
    | <specifier_qualifier_list>

<generic_type_argument_list> ::= <generic_type_argument>
    | <generic_type_argument_list> %"," <generic_type_argument>

<generic_call_arguments> ::= %"[" <generic_type_argument_list> %"]"

<function_declarator> ::= <direct_declarator> <generic_function_parameters> %"(" <parameter_type_list>? %")"
    | <direct_declarator> %"(" <parameter_type_list>? %")"

<function_definition> ::= <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <keyword_clause> <function_body>
    | <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <lower_clause> <function_body>
    | <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <keyword_clause> <lower_clause> <function_body>
    | <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <rpc_clause> <function_body>
    | <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <keyword_clause> <rpc_clause> <function_body>
    | <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <rpc_clause> <keyword_clause> <function_body>
    | <attribute_specifier_sequence>? <declaration_specifiers> <declarator> <function_body>
    | %"__extension__" <function_definition>

<lower_clause> ::= %"_Lower" %"(" <lower_item_list>? %")"

<lower_item_list> ::= <lower_item> (%"," <lower_item>)* %","?

<lower_item> ::= <identifier>
    | <identifier> %":" <assignment_expression>
    | %"return" %":" <type_name>

<_kw_kw_fn_specifier> ::= %"inline"
    | %"_Noreturn"
    | %"__inline__"
    | %"__inline"
    | %"__forceinline"

<function_specifier> ::= <_kw_kw_fn_specifier>
    | %"_Once"

<_kw_kw_gcc_asm> ::= %"__asm__"
    | %"__asm"
    | %"asm"

<gcc_asm_label> ::= <_kw_kw_gcc_asm> %"(" <asm_label_token>+ %")"

<asm_label_token> ::= %STRING
    | %IDENTIFIER

<gcc_asm_statement> ::= <_kw_kw_gcc_asm> <_kw_kw_type_qualifier>? %"goto"? %"(" <balanced_token_sequence>? %")" %";"

<generic_assoc_list> ::= <generic_association> (%"," <generic_association>)*

<generic_association> ::= %"default" %":" <assignment_expression>
    | <type_name> %":" <assignment_expression>

<generic_controlling_operand> ::= <type_name>
    | <assignment_expression>

<generic_selection> ::= %"_Generic" %"(" <generic_controlling_operand> %"," <generic_assoc_list> %")"

<identifier> ::= <synthetic_identifier>
    | <provided_identifier>

<inclusive_OR_expression> ::= <inclusive_OR_expression> %"|" <exclusive_OR_expression>
    | <exclusive_OR_expression>

<init_declarator> ::= <declarator> <gcc_asm_label>? <attribute_specifier_sequence>? %"=" <initializer>
    | <declarator> <gcc_asm_label>? <attribute_specifier_sequence>?

<init_declarator_list> ::= <init_declarator> (%"," <init_declarator>)*

<initializer> ::= <dict_literal>
    | <braced_initializer>
    | <array_literal>
    | <modified_literal>
    | <assignment_expression>

<initializer_list> ::= <designation>? <initializer> (%"," <designation>? <initializer>)*

<iteration_statement> ::= %"while" %"(" <expression> %")" <secondary_block>
<iteration_statement> ::= %"do" <secondary_block> %"while" %"(" <expression> %")" %";"
<iteration_statement> ::= %"for" %"(" <expression>? %";" <expression>? %";" <expression>? %")" <secondary_block>
    | %"for" %"(" <local_declaration> <expression>? %";" <expression>? %")" <secondary_block>

<jump_statement> ::= %"goto" <identifier> %";"
    | %"continue" <identifier> %";"
    | %"continue" %";"
    | %"break" <identifier> %";"
    | %"break" %";"
    | %"return" <expression>? %";"
    | %"goto" %"*" <expression> %";"

<keyword_argument> ::= %"." <identifier> %"=" <assignment_expression>

<keyword_clause> ::= %"_Kargs" <keyword_param_list>
    | %"_Kargs" %":" %"_Opaque"

# The `rpc` keyword is contextual — the tokenizer only emits it as a
# grammar terminal when preceded by `@`, so existing user code that
# uses `rpc` as an identifier (variable, field, function) is unaffected.
<rpc_clause> ::= %"_Rpc" %"(" <string_literal> %")"

<keyword_param> ::= <declaration_specifiers> <declarator> %"=" <initializer>
    | <declaration_specifiers> <declarator>

<keyword_param_list> ::= <keyword_param> (%"," <keyword_param>)*

<label> ::= <attribute_specifier_sequence>? <identifier> %":"
    | <attribute_specifier_sequence>? %"case" <constant_range_expression> %":"
    | <attribute_specifier_sequence>? %"case" <constant_expression> %":"
    | <attribute_specifier_sequence>? %"default" %":"

<labeled_statement> ::= <label> <statement>

<logical_AND_expression> ::= <logical_AND_expression> %"&&" <inclusive_OR_expression>
    | <inclusive_OR_expression>

<logical_OR_expression> ::= <logical_OR_expression> %"||" <logical_AND_expression>
    | <logical_AND_expression>

<member_declaration> ::= <attribute_specifier_sequence>? <specifier_qualifier_list> <member_declarator_list>? %";"
    | <static_assert_declaration>
    | %"__extension__" <member_declaration>
    | <pp_directive>
    | <pp_member_cond_block>

<member_declaration_list> ::= <member_declaration>+

<member_declarator> ::= <declarator>? %":" <constant_expression>
    | <declarator>

<member_declarator_list> ::= <member_declarator> (%"," <member_declarator>)*

<multiplicative_expression> ::= <multiplicative_expression> %"*" <cast_expression>
    | <multiplicative_expression> %"/" <cast_expression>
    | <multiplicative_expression> %"%" <cast_expression>
    | <multiplicative_expression> %"*%" <cast_expression>
    | <cast_expression>

<parameter_declaration> ::= <attribute_specifier_sequence>? <declaration_specifiers> <declarator> %"=" <initializer>
    | <attribute_specifier_sequence>? <declaration_specifiers> <declarator>
    | <attribute_specifier_sequence> <declaration_specifiers> <abstract_declarator>
    | <declaration_specifiers> <abstract_declarator>?

<parameter_list> ::= <parameter_declaration> (%"," <parameter_declaration>)*

<parameter_type_list> ::= <parameter_list> %"," <type_name> %"+" <keyword_clause>?
    | <parameter_list> %"," <type_name> %"+" %"," <keyword_param_list>
    | <parameter_list> %"," <type_name> %"+" <keyword_param_list>
    | <parameter_list> %"," %"+" %"," <keyword_param_list>
    | <parameter_list> %"," %"+" <keyword_clause>?
    | <parameter_list> %"," %"+" <keyword_param_list>
    | <type_name> %"+" %"," <keyword_param_list>
    | <type_name> %"+" <keyword_clause>?
    | <type_name> %"+" <keyword_param_list>
    | %"+" %"," <keyword_param_list>
    | %"+" <keyword_clause>?
    | %"+" <keyword_param_list>
    | <parameter_list> %"," %"..."
    | %"..."
    | <parameter_list>
    | <parameter_list> %"," <keyword_clause>
    | <keyword_clause>

<pointer> ::= %"*" <attribute_specifier_sequence>? <type_qualifier_list>? <pointer>
    | %"*" <attribute_specifier_sequence>? <type_qualifier_list>?
    | %"^" <attribute_specifier_sequence>? <type_qualifier_list>? <pointer>
    | %"^" <attribute_specifier_sequence>? <type_qualifier_list>?

<postfix_expression> @disambig(id_is_blueprint, 100) ::= <postfix_expression> %"[" <expression> %"]"
    | <postfix_expression> %"(" <argument_expression_list>? %")"
    | <postfix_expression> %"." <_member_name>
    | <postfix_expression> %"->" <_member_name>
    | <postfix_expression> %"++"
    | <postfix_expression> %"--"
    | <compound_literal>
    | %"(" <type_name> %")" <braced_initializer>
    | %"(" <storage_class_specifiers> <type_name> %")" <braced_initializer>
    | <primary_expression>
    | <postfix_expression> %"!"
    | <postfix_expression> <generic_call_arguments> %"(" <argument_expression_list>? %")"

<_member_name> ::= <identifier>
    | %TYPEDEF_NAME
    | <synthetic_identifier>

<primary_block> ::= <compound_statement>
    | <selection_statement>
    | <iteration_statement>

<primary_expression> ::= <constant>
    | <synthetic_string_literal>
    | %"(" <expression> %")"
    | <generic_selection>
    | <static_assert_declaration>
    | %"(" <compound_statement> %")"
    | <identifier>
    | %"__builtin_va_arg" %"(" <assignment_expression> %"," <type_name> %")"
    | %"__builtin_types_compatible_p" %"(" <type_name> %"," <type_name> %")"
    | %"__builtin_bit_cast" %"(" <type_name> %"," <assignment_expression> %")"
    | %"__builtin_offsetof" %"(" <type_name> %"," <offsetof_member_designator> %")"
    | %"__extension__" <primary_expression>
    | %"_Typehash" %"(" <typeid_atom> <typeid_continuation>? %")"
    | %"_Typehash" %"[" <typeid_atom> <typeid_continuation>? %"]"
    | %"_Static_typehash" %"[" <typeid_atom> <typeid_continuation>? %"]"
    | %"_Static_sizeof" %"[" <typeid_atom> <typeid_continuation>? %"]"
    | %"_Static_is_pointer" %"[" <typeid_atom> <typeid_continuation>? %"]"
    | %"_Dynamic_typehash" %"(" <assignment_expression> %")"
    | %"_Dynamic_is_pointer" %"(" <assignment_expression> %")"
    | %"_Dynamic_sizeof" %"(" <assignment_expression> %")"
    | %"_Dynamic_payload" %"(" <assignment_expression> %")"
    | %"_Box_init" %"(" <argument_expression_list> %")"
    | %"_Box_payload" %"(" <assignment_expression> %")"
    | %"_Box_sizeof" %"(" <assignment_expression> %")"
    | %"_Box" %"(" <argument_expression_list> %")"
    | %"_Baseid" %"(" <blueprint_name> %")"
    | %"_Baseid" %"(" %"_Option" %")"
    | %"_Baseid" %"(" %"_Result" %")"

<relational_expression> ::= <relational_expression> %"<" <shift_expression>
    | <relational_expression> %">" <shift_expression>
    | <relational_expression> %"<=" <shift_expression>
    | <relational_expression> %">=" <shift_expression>
    | <shift_expression>

<secondary_block> ::= <statement>

<selection_header> ::= <simple_declaration>
    | <local_declaration> <expression>
    | <expression>

<selection_statement> ::= %"if" %"(" <selection_header> %")" <secondary_block> %"else" <secondary_block>
    | %"if" %"(" <selection_header> %")" <secondary_block>
<selection_statement> ::= %"switch" %"(" <selection_header> %")" <secondary_block>

<shift_expression> ::= <shift_expression> %"<<" <additive_expression>
    | <shift_expression> %">>" <additive_expression>
    | <additive_expression>

<simple_declaration> ::= %"var" <attribute_specifier_sequence>? <declaration_specifiers> <declarator> %"=" <initializer>

<specifier_qualifier_list> ::= <type_modifier_specifiers>? <type_specifier_qualifier> <type_modifier_specifiers>? <attribute_specifier_sequence>?

<standard_attribute> ::= <identifier>

<statement> ::= <labeled_statement>
    | <unlabeled_statement>

<typecase_statement> ::= %"_Typecase" %"(" <assignment_expression> %")" %"{" <typecase_arm_list> %"}"

<typecase_arm_list> ::= <typecase_arm>+

<typecase_arm> ::= <type_name> <identifier> %":" <compound_statement>
                 | %"var" <type_name> <identifier> %":" <compound_statement>
    | %"default" %":" <compound_statement>

<_kw_kw_static_assert> ::= %"static_assert"
    | %"_Static_assert"

<static_assert_declaration> ::= <_kw_kw_static_assert> %"(" <constant_expression> %","? <string_literal>? %")" %";"

<_kw_kw_storage_class> ::= %"auto"
    | %"constexpr"
    | %"extern"
    | %"export"
    | %"foreign"
    | %"package"
    | %"private"
    | %"register"
    | %"static"
    | %"thread_local"
    | %"typedef"
    | %"_Thread_local"
    | %"__thread"

<storage_class_specifier> ::= <_kw_kw_storage_class>

<storage_class_specifiers> ::= <storage_class_specifier>+

<_kw_kw_struct_or_union> ::= %"struct"
    | %"union"
    | %"_Variant"

<tag_name> ::= <identifier>
    | %TYPEDEF_NAME
    | <synthetic_identifier>

<_kw_blueprint> ::= %"_Blueprint"

<blueprint_declaration> ::= <_kw_blueprint> %"[" <blueprint_parameters> %"]" <identifier> %"{" <member_declaration_list> %"}" %";"
    | <_kw_blueprint> %"[" %"(" <blueprint_parameters> %")" %"]" <identifier> %"{" <member_declaration_list> %"}" %";"
    | <_kw_blueprint> %"[" <blueprint_parameters> %"]" <identifier> %"{" %"}" %";"
    | <_kw_blueprint> %"[" %"(" <blueprint_parameters> %")" %"]" <identifier> %"{" %"}" %";"
    | <_kw_blueprint> %"[" <blueprint_parameters> %"]" <identifier> %";"
    | <_kw_blueprint> %"[" %"(" <blueprint_parameters> %")" %"]" <identifier> %";"

<blueprint_name> ::= <typedef_name_terminal> | %IDENTIFIER

<blueprint_parameters> ::= <identifier>
    | <blueprint_parameters> %"," <identifier>

<variant_declaration> ::= %"_Variant" %"[" <blueprint_parameters> %"]" <identifier> %"{" <member_declaration_list> %"}" %";"
    | %"_Variant" %"[" %"(" <blueprint_parameters> %")" %"]" <identifier> %"{" <member_declaration_list> %"}" %";"
    | %"_Variant" %"[" <blueprint_parameters> %"]" <identifier> %"{" %"}" %";"
    | %"_Variant" %"[" %"(" <blueprint_parameters> %")" %"]" <identifier> %"{" %"}" %";"
    | %"_Variant" %"[" <blueprint_parameters> %"]" <identifier> %";"
    | %"_Variant" %"[" %"(" <blueprint_parameters> %")" %"]" <identifier> %";"

<blueprint_instantiation> @disambig(id_is_not_blueprint, 100) ::= <blueprint_name> %"[" <blueprint_arguments> %"]"
    | <blueprint_name> %"[" %"(" <blueprint_arguments> %")" %"]"

<blueprint_arguments> ::= <type_name>
    | <blueprint_arguments> %"," <type_name>

<struct_or_union_specifier> ::= <_kw_kw_struct_or_union> <attribute_specifier_sequence>? <tag_name>? %"{" <member_declaration_list> %"}"
    | <_kw_kw_struct_or_union> <attribute_specifier_sequence>? <tag_name>? %"{" %"}"
    | <_kw_kw_struct_or_union> <attribute_specifier_sequence>? <tag_name>

<_named_id_kw_typeid> ::= %"_Typeid"
<_named_id_kw_Option> ::= %"_Option"
<_named_id_kw_ref> ::= %"ref"
<_named_id_kw_cptr> ::= %"cptr"
<_named_id_kw_Variant_new> ::= %"_Variant_new"
<_named_id_kw_Variant_tag> ::= %"_Variant_tag"

<_named_id_kw_Result_ok> ::= %"_Result_ok"

<_named_id_kw_Result_err> ::= %"_Result_err"
<_named_id_kw_Result> ::= %"_Result"
<_named_id_kw_Kargs> ::= %"_Kargs"
<_named_id_kw_Varargs> ::= %"_Varargs"
<_named_id_kw_Varargs_next> ::= %"_Varargs_next"

<synthetic_identifier> ::= <_named_id_kw_typeid> %"(" <typeid_atom> <typeid_continuation>? %")"
    | <_named_id_kw_Option> %"[" <typeid_atom> <typeid_continuation>? %"]"
    | <_named_id_kw_Option> %"[" %"(" <typeid_atom> <typeid_continuation>? %")" %"]"
    | <_named_id_kw_ref> %"[" <typeid_atom> <typeid_continuation>? %"]"
    | <_named_id_kw_ref> %"[" %"(" <typeid_atom> <typeid_continuation>? %")" %"]"
    | <_named_id_kw_cptr> %"[" <typeid_atom> <typeid_continuation>? %"]"
    | <_named_id_kw_cptr> %"[" %"(" <typeid_atom> <typeid_continuation>? %")" %"]"
    | <_named_id_kw_Result> %"[" <typeid_atom> <typeid_continuation>? %"]"
    | <_named_id_kw_Result> %"[" %"(" <typeid_atom> <typeid_continuation>? %")" %"]"
    | <_named_id_kw_Variant_new> %"(" <typeid_atom> <typeid_continuation>? %")"
    | <_named_id_kw_Variant_tag> %"(" <typeid_atom> <typeid_continuation>? %")"
    | <_named_id_kw_Result_ok> %"(" <typeid_atom> <typeid_continuation>? %")"
    | <_named_id_kw_Result_err> %"(" <typeid_atom> <typeid_continuation>? %")"
    | <_named_id_kw_Kargs>
    | <_named_id_kw_Varargs>
    | <_named_id_kw_Varargs_next> %"(" <assignment_expression> %"," <typeid_atom> <typeid_continuation>? %")"
    | %"_Constexpr_paste" %"(" <argument_expression_list> %")"

<_named_id_kw_typestr> ::= %"_Typestr"

<synthetic_string_literal> ::= <_named_id_kw_typestr> %"(" <typeid_atom> <typeid_continuation>? %")"
    | <string_literal>

<translation_unit> ::= <external_declaration>+

<type_name> ::= <specifier_qualifier_list> <abstract_declarator>?

<_kw_kw_type_qualifier> ::= %"const"
    | %"restrict"
    | %"volatile"
    | %"_Atomic"
    | %"__const__"
    | %"__const"
    | %"__restrict__"
    | %"__restrict"
    | %"__volatile__"
    | %"__volatile"
    | %"_Nullable"
    | %"_Nonnull"
    | %"_Null_unspecified"
    | %"__nullable"
    | %"__nonnull"
    | %"__null_unspecified"
    | %"__ptr32"
    | %"__ptr64"

<type_qualifier_list> ::= <_kw_kw_type_qualifier>+

<_kw_kw_type_specifier> ::= %"void"
    | %"__UINT8_TYPE__"
    | %"__UINT16_TYPE__"
    | %"__UINT32_TYPE__"
    | %"__UINT64_TYPE__"
    | %"__UINTPTR_TYPE__"
    | %"__SIZE_TYPE__"
    | %"__INT8_TYPE__"
    | %"__INT16_TYPE__"
    | %"__INT32_TYPE__"
    | %"__INT64_TYPE__"
    | %"__INTPTR_TYPE__"
    | %"__PTRDIFF_TYPE__"
    | %"char"
    | %"short"
    | %"int"
    | %"long"
    | %"float"
    | %"double"
    | %"signed"
    | %"unsigned"
    | %"bool"
    | %"_Bool"
    | %"_Complex"
    | %"_Decimal32"
    | %"_Decimal64"
    | %"_Decimal128"
    | %"_Float16"
    | %"_Float32"
    | %"_Float32x"
    | %"_Float64"
    | %"_Float64x"
    | %"_Float128"
    | %"__signed__"
    | %"__signed"
    | %"__builtin_va_list"
    | %"__int8"
    | %"__int16"
    | %"__int32"
    | %"__int64"
    | %"__int128"
    | %"__int128_t"
    | %"__uint128_t"
    | %"__fp16"
    | %"__bf16"
    | %"__mfp8"
    | %"__Float32x4_t"
    | %"__Float64x2_t"
    | %"__SVFloat32_t"
    | %"__SVFloat64_t"
    | %"__SVBool_t"
    | %"_Box"
    | %"_Box_payload"
    | %"_Box_init"
    | %"_Box_sizeof"

<bitint_type_specifier> ::= %"_BitInt" %"(" <constant_expression> %")"
    | %"UnsignedBitInt" %"(" <constant_expression> %")"

<kargs_of_type_specifier> ::= %"_Kargs_of" %"(" <identifier> %")"

<vargs_type_of_type_specifier> ::= %"_Vargs_type_of" %"(" <identifier> %")"

<type_specifier> ::= <_kw_kw_type_specifier>
    | <bitint_type_specifier>
    | <kargs_of_type_specifier>
    | <vargs_type_of_type_specifier>
    | <atomic_type_specifier>
    | <struct_or_union_specifier>
    | <enum_specifier>
    | <typedef_name>
    | <typeof_specifier>
    | <synthetic_identifier>
    | <blueprint_instantiation>

<type_specifier_qualifier> ::= <type_specifier>

<typeid_atom> ::= <string_literal>
    | <type_name>
    | <assignment_expression>

<typeid_continuation> ::= %"," <typeid_atom> <typeid_continuation>?
    | %","

<_kw_kw_typeof> ::= %"typeof"
    | %"__typeof__"
    | %"__typeof"

<typeof_specifier> ::= <_kw_kw_typeof> %"(" <typeof_specifier_argument> %")"
    | %"typeof_unqual" %"(" <typeof_specifier_argument> %")"

<typeof_specifier_argument> ::= <expression>

<unary_expression> ::= %"++" <unary_expression>
    | %"--" <unary_expression>
    | <unary_operator> <cast_expression>
    | %"sizeof" %"(" <type_name> %")"
    | %"sizeof" <unary_expression>
    | <_kw_kw_alignof> %"(" <type_name> %")"
    | %"_Countof" %"(" <type_name> %")"
    | %"_Countof" <unary_expression>
    | %"&&" <identifier>
    | <try_expression>
    | <postfix_expression>

# bCe `_try <unary-expression>`: error-propagation for bCe_result_t. Spelled
# `_try` (not `try`) because bCe uses `try` as an ordinary identifier. Lowered
# by xform_try: on a non-ok result, the enclosing function returns the error;
# otherwise the expression yields the unwrapped `.ok` value.
<try_expression> ::= %"_Try" <unary_expression>

<_kw_kw_alignof> ::= %"alignof"
    | %"_Alignof"

<_ops_op_unary> ::= %"&"
    | %"*"
    | %"+"
    | %"-"
    | %"~"
    | %"!"

<unary_operator> ::= <_ops_op_unary>

<unlabeled_statement> ::= <expression_statement>
    | <attribute_specifier_sequence>? <primary_block>
    | <attribute_specifier_sequence>? <jump_statement>
    | <gcc_asm_statement>
    | <defer_statement>
    | <with_statement>
    | <typecase_statement>
    | <macro_block_statement>

<macro_block_statement> ::= <postfix_expression> <compound_statement>

# C _Defer TS (WG14 N3734). bCe only has to parse it; clang lowers it natively
# under -fdefer-ts, which bCe forces. `defer` is rewritten to `_Defer` by the
# prescan unless --bCe-disable-defer is given.
<defer_statement> ::= %"_Defer" <secondary_block>
<defer_statement> ::= %"defer" <secondary_block>

# `_With (T *p = acquire(); release(p)) { ... }` -- a scoped binding whose
# cleanup runs on every exit path. The cleanup clause is optional; without it
# the release template given by --bCe-with-release is used, so bCe never learns
# the runtime's finalizer. Lowered by xform_with to a block holding the
# declaration and a _Defer. `with` is rewritten to `_With` by the prescan unless
# --bCe-disable-with is given. The `;` separates the binding from the cleanup,
# so the one-clause form needs no trailing semicolon.
<with_statement> ::= %"_With" %"(" %"var"? <attribute_specifier_sequence>? <declaration_specifiers> <init_declarator_list> (%";" <expression>)? %")" <secondary_block>
<with_statement> ::= %"with" %"(" %"var"? <attribute_specifier_sequence>? <declaration_specifiers> <init_declarator_list> (%";" <expression>)? %")" <secondary_block>
