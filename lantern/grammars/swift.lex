@lex-comment("//")
@lex-comment("/*", "*/", nested)
@lex-string('"""', '"""', escape('\\'), multiline, as("MULTILINE_STRING"))
@lex-fence('#', '#', fill('#'), body('"', '"'), minimum("0"), as("STRING"))
@lex-string('"', '"', escape('\\'), as("STRING"))
@lex-regex("/", "/", not_after("IDENTIFIER", "IMPLICIT_PARAM", "INTEGER", "FLOAT", "STRING", "MULTILINE_STRING", "REGEX_LIT", ")", "]", "}", "true", "false", "nil", "self", "super"), as("REGEX_LIT"))
@lex-sigil("$", as("IMPLICIT_PARAM"), digits)
@lex-number(digits("0123456789"), sep("_"), point("leading", "trailing"), exp("eE"), int("INTEGER"), float("FLOAT"))
@lex-number(prefix("0x"), digits("0123456789abcdefABCDEF"), sep("_", "after-prefix"), point("trailing", "exponent-required"), exp("pP"), int("INTEGER"), float("FLOAT"))
@lex-number(prefix("0b"), digits("01"), sep("_", "after-prefix"), int("INTEGER"))
@lex-number(prefix("0o"), digits("01234567"), sep("_", "after-prefix"), int("INTEGER"))
@lex-ident(as("IDENTIFIER"))
@lex-layout(brackets("()[]"), terminator("NEWLINE", "break continue fallthrough return"))
