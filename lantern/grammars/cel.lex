@lex-comment("//")
@lex-string-family(plain, quotes('"', "'"), escape('\\'), as("STRING"))
@lex-string('"""', '"""', escape('\\'), multiline, as("STRING"))
@lex-string('b"', '"', escape('\\'), as("BYTES"))
@lex-string-family(prefixes("r", "R"), quotes('"', "'"), raw, as("STRING"))
@lex-number(digits("0123456789"), point("leading", "trailing"), exp("eE"), int("INTEGER"), float("FLOAT"), suffix("u", "UINT", "integer"), suffix("U", "UINT", "integer"))
@lex-number(prefix("0x"), digits("0123456789abcdefABCDEF"), int("INTEGER"), suffix("u", "UINT", "integer"), suffix("U", "UINT", "integer"))
@lex-ident(as("IDENTIFIER"))
@lex-layout(brackets("()[]{}"))
