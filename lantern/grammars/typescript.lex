@lex-comment("//")
@lex-comment("/*", "*/")
@lex-string("`", "`", escape('\\'), multiline, interp("${", "}"), as("TEMPLATE_HEAD", "TEMPLATE_MIDDLE", "TEMPLATE_TAIL"))
@lex-string-family(plain, quotes('"', "'"), escape('\\'), as("STRING"))
@lex-regex("/", "/", not_after("IDENTIFIER", "INTEGER", "FLOAT", "STRING", "TEMPLATE_TAIL", "REGEX_LIT", ")", "]", "}", "++", "--", "this", "super", "true", "false", "null"), flags("dgimsuvy"), as("REGEX_LIT"))
@lex-number(digits("0123456789"), sep("_"), point("leading", "trailing"), exp("eE"), int("INTEGER"), float("FLOAT"))
@lex-number(prefix("0x"), digits("0123456789abcdefABCDEF"), sep("_"), int("INTEGER"))
@lex-number(prefix("0b"), digits("01"), sep("_"), int("INTEGER"))
@lex-number(prefix("0o"), digits("01234567"), sep("_"), int("INTEGER"))
@lex-ident(as("IDENTIFIER"), start("$"), extra("$"))
@lex-layout(brackets("()[]{}"))
