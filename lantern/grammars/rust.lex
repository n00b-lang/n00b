@lex-comment("//")
@lex-comment("/*", "*/", nested)
@lex-fence('br#', '#', fill('#'), body('"', '"'), minimum("0"), as("RAW_BYTE_STRING"))
@lex-fence('r#', '#', fill('#'), body('"', '"'), minimum("0"), as("RAW_STRING"))
@lex-string('br"', '"', raw, as("RAW_BYTE_STRING"))
@lex-string('r"', '"', raw, multiline, as("RAW_STRING"))
@lex-string("b'", "'", escape('\\'), scalar, as("BYTE_LIT"))
@lex-string('b"', '"', escape('\\'), as("BYTE_STRING"))
@lex-string('"', '"', escape('\\'), multiline, as("STRING"))
@lex-string("'", "'", escape('\\'), scalar, as("CHAR"))
@lex-number-suffixes("rust-integer", suffix("usize", "INTEGER", "integer"), suffix("isize", "INTEGER", "integer"), suffix("i8", "INTEGER", "integer"), suffix("i16", "INTEGER", "integer"), suffix("i32", "INTEGER", "integer"), suffix("i64", "INTEGER", "integer"), suffix("i128", "INTEGER", "integer"), suffix("u8", "INTEGER", "integer"), suffix("u16", "INTEGER", "integer"), suffix("u32", "INTEGER", "integer"), suffix("u64", "INTEGER", "integer"), suffix("u128", "INTEGER", "integer"))
@lex-number-suffixes("rust-float", suffix("f32", "FLOAT"), suffix("f64", "FLOAT"))
@lex-number(digits("0123456789"), sep("_"), point("trailing"), exp("eE"), int("INTEGER"), float("FLOAT"), use_suffixes("rust-integer", "rust-float"))
@lex-number(prefix("0x"), digits("0123456789abcdefABCDEF"), sep("_", "after-prefix"), int("INTEGER"), use_suffixes("rust-integer"))
@lex-number(prefix("0b"), digits("01"), sep("_", "after-prefix"), int("INTEGER"), use_suffixes("rust-integer"))
@lex-number(prefix("0o"), digits("01234567"), sep("_", "after-prefix"), int("INTEGER"), use_suffixes("rust-integer"))
@lex-sigil("r#", as("IDENTIFIER"))
@lex-ident(as("IDENTIFIER"))
@lex-layout(brackets("()[]{}"))
