@lex-comment("//")
@lex-comment("/*", "*/", nested)
@lex-string('"""', '"""', multiline, as("MULTILINE_STRING"))
@lex-string('"', '"', escape('\\'), as("STRING"))
@lex-string("'", "'", escape('\\'), scalar, as("CHAR"))
@lex-number(digits("0123456789"), sep("_"), point("trailing"), exp("eE"), int("INTEGER"), float("FLOAT"), suffix("L", "INTEGER", "integer"), suffix("u", "INTEGER", "integer"), suffix("f", "FLOAT"))
@lex-number(prefix("0x"), digits("0123456789abcdefABCDEF"), sep("_"), int("INTEGER"), suffix("L", "INTEGER", "integer"), suffix("u", "INTEGER", "integer"))
@lex-number(prefix("0b"), digits("01"), sep("_"), int("INTEGER"), suffix("L", "INTEGER", "integer"), suffix("u", "INTEGER", "integer"))
@lex-ident(as("IDENTIFIER"))
@lex-layout(newline("NL"), eof("EOF"), brackets("()[]"))
