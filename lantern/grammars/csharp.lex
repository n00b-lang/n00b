@lex-comment("//")
@lex-comment("/*", "*/")
@lex-string('"""', '"""', multiline, raw, as("RAW_STRING"))
@lex-string('$"', '"', escape('\\'), as("INTERPOLATED_STRING"))
@lex-string('@"', '"', raw, multiline, as("VERBATIM_STRING"))
@lex-string('"', '"', escape('\\'), as("STRING"))
@lex-string("'", "'", escape('\\'), scalar, as("CHAR"))
@lex-number-suffixes("csharp-integer", suffix("UL", "INTEGER", "integer"), suffix("ul", "INTEGER", "integer"), suffix("LU", "INTEGER", "integer"), suffix("lu", "INTEGER", "integer"), suffix("L", "INTEGER", "integer"), suffix("l", "INTEGER", "integer"), suffix("U", "INTEGER", "integer"), suffix("u", "INTEGER", "integer"))
@lex-number-suffixes("csharp-float", suffix("f", "FLOAT"), suffix("F", "FLOAT"), suffix("m", "FLOAT"), suffix("M", "FLOAT"), suffix("d", "FLOAT"), suffix("D", "FLOAT"))
@lex-number(digits("0123456789"), sep("_"), point("leading", "trailing"), exp("eE"), int("INTEGER"), float("FLOAT"), use_suffixes("csharp-integer", "csharp-float"))
@lex-number(prefix("0x"), digits("0123456789abcdefABCDEF"), sep("_", "after-prefix"), int("INTEGER"), use_suffixes("csharp-integer"))
@lex-number(prefix("0b"), digits("01"), sep("_", "after-prefix"), int("INTEGER"), use_suffixes("csharp-integer"))
@lex-ident(as("IDENTIFIER"))
@lex-layout(brackets("()[]{}"))
