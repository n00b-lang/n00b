IR_OP(SHR,             "shr",             2, 2,  OPERAND0,    "vv",  IR_MOD_SHIFT,                   HASRESULT)
IR_OP(ROL,             "rol",             2, 2,  OPERAND0,    "vv",  IR_MOD_SHIFT,                   HASRESULT)
