#ifndef IR_EFFECT_NAME
#define IR_EFFECT_NAME(name, bits)
#endif
#ifndef IR_EFFECT_GROUP
#define IR_EFFECT_GROUP(name, bits)
#endif

IR_EFFECT_NAME(input,          IR_SUMMARY_MAY_INPUT)
IR_EFFECT_NAME(output,         IR_SUMMARY_MAY_OUTPUT)
IR_EFFECT_NAME(env,            IR_SUMMARY_READS_ENV)
IR_EFFECT_NAME(clock,          IR_SUMMARY_READS_CLOCK)
IR_EFFECT_NAME(random,         IR_SUMMARY_READS_RANDOM)
IR_EFFECT_NAME(reads_globals,  IR_SEFFECT_READS_NONLOCAL)
IR_EFFECT_NAME(writes_globals, IR_SEFFECT_WRITES_NONLOCAL)
IR_EFFECT_NAME(blocks,         IR_SUMMARY_MAY_BLOCK)
IR_EFFECT_NAME(spawns,         IR_SUMMARY_STARTS_THREADS)
IR_EFFECT_NAME(allocates,      IR_SUMMARY_MAY_ALLOCATE)
IR_EFFECT_NAME(panics,         IR_SUMMARY_MAY_TRAP)
IR_EFFECT_NAME(noreturn,       IR_SUMMARY_MAY_DIVERGE)

IR_EFFECT_GROUP(impure,
                IR_SUMMARY_MAY_INPUT | IR_SUMMARY_MAY_OUTPUT
                | IR_SUMMARY_READS_ENV | IR_SUMMARY_READS_CLOCK
                | IR_SUMMARY_READS_RANDOM | IR_SEFFECT_WRITES_NONLOCAL
                | IR_SUMMARY_STARTS_THREADS)
IR_EFFECT_GROUP(nondeterministic,
                IR_SUMMARY_MAY_INPUT | IR_SUMMARY_READS_ENV
                | IR_SUMMARY_READS_CLOCK | IR_SUMMARY_READS_RANDOM
                | IR_SEFFECT_READS_NONLOCAL)

#undef IR_EFFECT_NAME
#undef IR_EFFECT_GROUP
