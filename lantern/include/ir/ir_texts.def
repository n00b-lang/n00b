IR_TEXT(DETAIL, "{0}")
IR_TEXT(PROMOTED_BY_RULE, "promoted to an error by the diagnostic policy rule for `{0}`")
IR_TEXT(PROMOTED, "promoted to an error by the diagnostic policy")
IR_TEXT(HERE, "here")
IR_TEXT(DECLARED_HERE, "`{0}` is declared here")
IR_TEXT(DEAD_BLOCK, "this code can never run: no path reaches block `{0}`")
IR_TEXT(UNSET_READ, "`{0}` is read on a path where it has no value")
IR_TEXT(UNSET_AT_RETURN, "`{0}` is not assigned on every path to this return")
IR_TEXT(UNSET_TEMPORARY, "a temporary value is read on a path where it has no value")
IR_TEXT(UNUSED_ASSIGNMENT, "the value assigned to `{0}` here is never read")
IR_TEXT(UNUSED_RESULT, "the value of this expression is never used")
IR_TEXT(CALLS_ITSELF_AGAIN, "calls itself again")
IR_TEXT(UNBOUNDED_RECURSION, "`{0}` calls itself on every path, so a call to it never returns")
IR_TEXT(ASSIGNED_TWICE, "`{0}` can be assigned only once, but this can assign it a second time")
IR_TEXT(MAY_ALREADY_BE_ASSIGNED, "it may already be assigned here")
IR_TEXT(NO_PRIMARY_SPAN_LABEL, "reported without a location")
IR_TEXT(NO_PRIMARY_SPAN, "a diagnostic was reported with no primary span, which is a bug in whatever reported it")
IR_TEXT(PASS_SILENT, "{0} failed and said nothing: a pass reports what it could not do")
IR_TEXT(THIS_LAYOUT, "this layout")
IR_TEXT(THIS_GLOBAL_STATIC_INITIALIZER, "this global static initializer")
IR_TEXT(THIS_GLOBAL_STORAGE_REQUIREMENT, "this global storage requirement")
