    "intended.")
N00B_DIAG(UNION_DISCRIMINANT_TYPE, "N00B-T1036", ERROR,
    "a union discriminant is not an 8, 16 or 32-bit integer",
    "The field that selects a union arm must be an 8, 16 or 32-bit\n"
