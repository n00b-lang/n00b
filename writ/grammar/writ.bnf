<file> ::= <item>* | <profile-decl> <profile-decl>* | <binding-decl> <binding-decl>*
<declarations> ::= <item>*
<embedded> ::= <item>* <embedded-binding>*
<item> ::= <directive> | <decl>

<directive> ::= <library-directive> | <link-directive> | <header-directive> | <encoding-directive> | <define-directive> | <include-path-directive> | <compile-commands-directive> | <use-directive> | <platforms-directive> | <import-directive> | <abi-directive> | <lang-directive> | <crate-directive> | <feature-directive> | <version-directive>
<library-directive> ::= %"library" %IDENTIFIER
<link-directive> ::= %"link" %STRING
<header-directive> ::= %"header" <header-name>
<header-name> ::= <header-quoted> | <header-angle>
<header-quoted> ::= %STRING
<header-angle> ::= %"<" <header-path> %">"
<header-path> ::= <header-part> (<header-sep> <header-part>)*
<header-part> ::= %IDENTIFIER | %INTEGER
<header-sep> ::= %"." | %"/" | %"-"
<encoding-directive> ::= %"encoding" %IDENTIFIER
<define-directive> ::= %"define" %IDENTIFIER (%"=" <expr>)?
<include-path-directive> ::= %"include_path" %STRING
<compile-commands-directive> ::= %"compile_commands" %STRING
<use-directive> ::= %"use" %STRING | %"use" <header-angle>
<platforms-directive> ::= %"platforms" <platform-name> (%"," <platform-name>)*
<platform-name> ::= <platform-part> (%"-" <platform-part>)*
<platform-part> ::= %IDENTIFIER | %"*"
<import-directive> ::= %"import" <header-name> <raw-mark>?
<raw-mark> ::= %"raw"
<abi-directive> ::= %"abi" %IDENTIFIER
<lang-directive> ::= %"lang" <lang-name>
<lang-name> ::= %IDENTIFIER (%"+" %"+")?
<crate-directive> ::= %"crate" %IDENTIFIER <text>
<feature-directive> ::= %"feature" %IDENTIFIER %"=" <feature-source> <text>
<feature-source> ::= %"cargo" | %"define" | %"configure"
<version-directive> ::= %"version" %"query" %IDENTIFIER %"(" %")" %"->" <type> %"format" <text>

<decl> ::= <const-decl> | <alias-decl> | <opaque-decl> | <handle-decl> | <struct-decl> | <enum-decl> | <flags-decl> | <callback-decl> | <fn-decl> | <refine-decl> | <allocator-decl> | <when-decl> | <var-decl> | <interface-decl> | <symbol-decl> | <conventions-decl> | <channel-decl> | <impl-decl> | <rust-error-decl>
<const-decl> ::= %"const" %IDENTIFIER %":" <type> %"=" <expr>
<alias-decl> ::= %"type" %IDENTIFIER %"=" <type>
<opaque-decl> ::= %"opaque" %IDENTIFIER <source-clause>? <thread-rule>?
<handle-decl> ::= %"handle" %IDENTIFIER %"=" <type> <none-value>? <release-attr> <thread-rule>?
<none-value> ::= %"none" <expr>
<thread-rule> ::= %"shared" | %"thread_affine"
<struct-decl> ::= %"struct" %IDENTIFIER <record-attr>* %"{" (<field> %","?)* %"}" <struct-none>?
<record-attr> ::= <layout-attr> | <size-attr> | <align-attr> | <pack-attr> | <source-clause>
<layout-attr> ::= %"layout" <layout-mode>
<layout-mode> ::= %"c" | %"explicit"
<size-attr> ::= %"@" %"size" %"(" <platform-int> (%"," <platform-int>)* %")"
<platform-int> ::= %INTEGER (%"on" <ref>)?
<align-attr> ::= %"@" %"align" %"(" %INTEGER %")"
<pack-attr> ::= %"@" %"pack" %"(" %INTEGER %")"
<field> ::= %IDENTIFIER %":" <own-attr>? <slot-type> <field-offset>?
<field-offset> ::= %"@" %INTEGER
<struct-none> ::= %"none" %"{" <field-value> (%"," <field-value>)* %","? %"}"
<field-value> ::= %IDENTIFIER %":" <expr>
<enum-decl> ::= %"enum" %IDENTIFIER (%":" <type>)? %"{" (<enum-item> %","?)* %"}" <closed-mark>?
<enum-item> ::= %IDENTIFIER (%"=" <expr>)?
<closed-mark> ::= %"closed"
<flags-decl> ::= %"flags" %IDENTIFIER %":" <type> %"{" (<enum-item> %","?)* %"}"
<callback-decl> ::= %"callback" %IDENTIFIER %"=" %"fn" <signature> <fn-clause>*
<fn-decl> ::= %"fn" %IDENTIFIER <signature> <fn-clause>*
<signature> ::= %"(" (<param-item> (%"," <param-item>)* %","?)? %")" <fn-result>?
<param-item> ::= <param> | <varargs> | <self-param>
<param> ::= %IDENTIFIER %":" <mode>? <slot-type>
<mode> ::= %"in" | %"out" | %"inout" | %"consume" | %"keep" | %"unknown"
<self-param> ::= <self-ref>? <mut-mark>? %"self"
<self-ref> ::= %"&"
<varargs> ::= %"..." <varargs-of>?
<varargs-of> ::= %"of" <type> <varargs-end>?
<varargs-end> ::= <until-end> | <count-end>
<until-end> ::= %"until" <expr>
<count-end> ::= %"count" %IDENTIFIER
<fn-result> ::= %"->" <own-attr>? <slot-type>

<slot-type> ::= <type> <slot-attr>*
<slot-attr> ::= <span> | <own-attr> | <release-attr> | <alloc-attr> | <userdata-attr> | <private-attr> | <align-attr> | <null-if-empty>
<span> ::= <span-call> | <span-static> | <span-with> | <span-until> | <span-once> | <span-unknown>
<span-call> ::= %"for" %"call"
<span-static> ::= %"static" <per-thread>?
<per-thread> ::= %"per" %"thread"
<span-with> ::= %"with" %IDENTIFIER
<span-until> ::= %"until" <event> (%"," <event>)*
<span-once> ::= %"once"
<span-unknown> ::= %"unknown"
<event> ::= <next-mark>? <ref> (%"(" <args>? %")")? <on-thread>?
<next-mark> ::= %"next"
<on-thread> ::= %"on" %"thread"
<own-attr> ::= %"own"
<release-attr> ::= %"release" %IDENTIFIER
<alloc-attr> ::= %"alloc" %IDENTIFIER
<userdata-attr> ::= %"userdata" <userdata-target>?
<userdata-target> ::= <ref> | %"(" <ref> (%"," <ref>)* %")"
<ref> ::= %IDENTIFIER
<text> ::= %STRING
<private-attr> ::= %"private"
<null-if-empty> ::= %"null" %"if" %"empty"

<type> ::= <base-type> <view>?
<view> ::= %"as" <view-target>
<view-target> ::= <named-type> | <pointer-type>
<base-type> ::= <named-type> | <path-type> | <pointer-type> | <array-type> | <inline-array> | <bytes-type> | <ref-type> | <slice-type> | <tuple-type>
<named-type> ::= %IDENTIFIER <type-args>?
<type-args> ::= <generic-args> | <encoding-arg>
<generic-args> ::= %"<" <type> (%"," <type>)* %">"
<encoding-arg> ::= %"(" %IDENTIFIER %")"
<path-type> ::= <type-path> <generic-args>?
<type-path> ::= %IDENTIFIER %"::" %IDENTIFIER (%"::" %IDENTIFIER)*
<pointer-type> ::= <pointer-mark> <pointee>
<pointee> ::= <named-type> | <path-type> | <pointer-type> | <array-type> | <bytes-type> | <ref-type> | <tuple-type>
<pointer-mark> ::= %"*" | %"?"
<array-type> ::= <pointer-mark> %"[" <element> %";" <extent> %"]"
<element> ::= <own-attr>? <slot-type>
<inline-array> ::= %"[" <type> %";" <extent> %"]"
<bytes-type> ::= <bytes-word> %"[" <bytes-extent> %"]"
<bytes-word> ::= %"bytes" | %"utf8"
<bytes-extent> ::= <extent> | <cap-len-extent>
<cap-len-extent> ::= <expr> %"->" <expr>
<ref-type> ::= %"&" <lifetime>? <mut-mark>? <base-type>
<lifetime> ::= %LIFETIME
<mut-mark> ::= %"mut"
<slice-type> ::= %"[" <type> %"]"
<tuple-type> ::= %"(" (<type> (%"," <type>)* %","?)? %")"

<extent> ::= <count-extent> | <until-extent> | <bounded-extent> | <choice-extent>
<count-extent> ::= <expr>
<until-extent> ::= %"until" <expr>
<bounded-extent> ::= %"cap" <expr> %"," %"len" <expr>
<choice-extent> ::= <or-expr> %"?" <extent> %":" <extent>

<fn-clause> ::= <pure-clause> | <sizing-clause> | <error-clause> | <outcome-clause> | <expands-clause> | <on-clause> | <thread-clause> | <reentrant-clause> | <unwind-clause> | <signal-safe-clause> | <note-clause> | <source-clause> | <symbol-clause> | <format-clause> | <pack-clause> | <since-clause> | <removed-clause>
<pure-clause> ::= %"pure"
<sizing-clause> ::= %"sizing" <sizing-protocol>? <sizing-for>? %"needs" <expr>
<sizing-protocol> ::= <sizing-query> | <sizing-retry>
<sizing-query> ::= %"query" %"(" <assign> (%"," <assign>)* %")"
<assign> ::= %IDENTIFIER %"=" <expr>
<sizing-retry> ::= %"retry"
<sizing-for> ::= %"for" %IDENTIFIER
<error-clause> ::= %"error" <expr> <via-clause>? <retry-mark>?
<via-clause> ::= %"via" <expr> <own-attr>? <release-attr>?
<retry-mark> ::= %"retry"
<outcome-clause> ::= %"outcome" %IDENTIFIER <outcome-kind> <when-part>? <via-clause>? <retry-mark>?
<outcome-kind> ::= %"success" | %"failure"
<when-part> ::= %"when" <expr>
<expands-clause> ::= %"expands" %IDENTIFIER %"(" <args>? %")"
<on-clause> ::= %"on" %IDENTIFIER <ref> %":" <on-state>
<on-state> ::= <on-word> | <not-consumed> | <span>
<on-word> ::= %"own" | %"unset" | %"partial"
<not-consumed> ::= %"not" %"consumed"
<thread-clause> ::= %"thread" <thread-target>
<thread-target> ::= <thread-word> | <same-as>
<thread-word> ::= %"any" | %"main" | %"same"
<same-as> ::= %"same_as" <event>
<reentrant-clause> ::= %"reentrant" <yes-no>
<unwind-clause> ::= %"unwind" <yes-no>
<yes-no> ::= %"yes" | %"no"
<signal-safe-clause> ::= %"signal_safe"
<note-clause> ::= %"note" %STRING
<source-clause> ::= %"source" %STRING <macro-mark>?
<macro-mark> ::= %"macro"
<symbol-clause> ::= %"symbol" <symbol-name> <symbol-version>? <when-part>?
<symbol-name> ::= <text> | <no-symbol>
<no-symbol> ::= %"none"
<symbol-version> ::= %"version" %STRING
<format-clause> ::= %"format" %"printf" %"(" <ref> %")"
<pack-clause> ::= %"pack" %"rest" <pack-target>
<pack-target> ::= <ref> | <rest-ref>
<rest-ref> ::= %"..."
<since-clause> ::= %"since" <version-lit>
<removed-clause> ::= %"removed" <version-lit>

<refine-decl> ::= %"refine" %IDENTIFIER %"{" <refine-item>* %"}"
<refine-item> ::= <param> %","? | <fn-result> | <fn-clause>
<allocator-decl> ::= %"allocator" %IDENTIFIER <alloc-attr> <release-attr>
<when-decl> ::= %"when" <expr> %"{" <item>* %"}" <else-part>?
<else-part> ::= %"else" %"{" <item>* %"}"
<var-decl> ::= %"var" %IDENTIFIER %":" <slot-type> <var-attr>*
<var-attr> ::= <var-access> | <source-clause> | <symbol-clause>
<var-access> ::= %"const" | %"mut"
<interface-decl> ::= %"interface" %IDENTIFIER %"provided" %"by" <provider> %"{" <decl>* %"}"
<provider> ::= %"library" | %"client"
<symbol-decl> ::= %"symbol" <symbol-kind> %IDENTIFIER <symbol-clause>*
<symbol-kind> ::= %"fn" | %"var"
<conventions-decl> ::= %"conventions" %"for" <convention-kind> <pattern> %"{" <fn-clause>* %"}"
<convention-kind> ::= %"fn" | %"handle" | %"struct"
<pattern> ::= <pattern-part> <pattern-part>*
<pattern-part> ::= %IDENTIFIER | %INTEGER | %"*"
<channel-decl> ::= %"error_channel" %IDENTIFIER <channel-scope> <reset-mark>? %"{" <channel-source> <valid-until>? %"}"
<channel-scope> ::= <per-thread> | <per-handle>
<per-handle> ::= %"per" %"handle" %IDENTIFIER
<reset-mark> ::= %"reset" %"before" %"call"
<channel-source> ::= <channel-kind> <expr>
<channel-kind> ::= %"value" | %"text"
<valid-until> ::= %"valid" %"until" <event> (%"," <event>)*
<impl-decl> ::= %"impl" %IDENTIFIER %"{" <impl-item>* %"}"
<impl-item> ::= <fn-decl> | <when-decl>
<rust-error-decl> ::= %"error" <rust-path> %"display"
<rust-path> ::= %IDENTIFIER (%"::" %IDENTIFIER)*

<expr> ::= <view-expr> | <or-expr>
<view-expr> ::= <or-expr> %"as" %IDENTIFIER
<or-expr> ::= <or-expr> %"or" <and-expr> | <and-expr>
<and-expr> ::= <and-expr> %"and" <cmp-expr> | <cmp-expr>
<cmp-expr> ::= <add-expr> <cmp-op> <add-expr> | <in-expr> | <add-expr>
<cmp-op> ::= %"==" | %"!=" | %"<" | %">" | %"<=" | %">="
<in-expr> ::= <add-expr> %"in" %"[" <platform-name> (%"," <platform-name>)* %"]"
<add-expr> ::= <add-expr> <add-op> <mul-expr> | <mul-expr>
<add-op> ::= %"+" | %"-"
<mul-expr> ::= <mul-expr> <mul-op> <unary-expr> | <unary-expr>
<mul-op> ::= %"*" | %"/"
<unary-expr> ::= <neg-expr> | <not-expr> | <bitnot-expr> | <deref-expr> | <postfix-expr>
<neg-expr> ::= %"-" <unary-expr>
<not-expr> ::= %"not" <unary-expr>
<bitnot-expr> ::= %"~" <unary-expr>
<deref-expr> ::= %"*" <unary-expr>
<postfix-expr> ::= <member-expr> | <call-expr> | <primary>
<member-expr> ::= <postfix-expr> %"." %IDENTIFIER
<call-expr> ::= <postfix-expr> %"(" <args>? %")"
<args> ::= <expr> (%"," <expr>)*
<primary> ::= <name-ref> | <int-lit> | <string-lit> | <version-lit> | <feature-test> | <paren-expr>
<name-ref> ::= %IDENTIFIER
<int-lit> ::= %INTEGER
<string-lit> ::= %STRING
<version-lit> ::= %INTEGER %"." %INTEGER (%"." %INTEGER)*
<feature-test> ::= %"feature" %IDENTIFIER
<paren-expr> ::= %"(" <expr> %")"

<profile-decl> ::= %"profile" %IDENTIFIER %"{" <profile-item>* %"}"
<profile-item> ::= <memory-item> | <pin-item> | <keep-alive-item> | <prim-item> | <string-item> | <buffer-item> | <pack-native-item> | <variadic-item> | <error-style-item> | <error-type-item> | <callback-style-item> | <handle-close-item> | <lifetimes-item> | <naming-item> | <reserved-item> | <label-map-item>
<memory-item> ::= %"memory" <memory-kind> (%"+" <memory-kind>)*
<memory-kind> ::= %"none" | %"rc" | %"gc" <gc-kind>
<gc-kind> ::= %"moving" | %"nonmoving"
<pin-item> ::= %"pin" <pin-span> %"via" <pin-via> <pin-release>?
<pin-span> ::= %"for" %"call" | %"longer" | %"any" | %"buffer"
<pin-via> ::= <text> | <pin-copy>
<pin-copy> ::= %"copy"
<pin-release> ::= %"release" %STRING
<keep-alive-item> ::= %"keep_alive" %"via" %STRING
<prim-item> ::= %"prim" <type> %"->" <text>
<string-item> ::= %"string" %IDENTIFIER %"to" <type> %"via" <pin-via> <copy-mode>?
<buffer-item> ::= %"buffer" %IDENTIFIER %"to" <type> %"via" <pin-via> <copy-mode>?
<copy-mode> ::= %"copies" | %"zero_copy"
<pack-native-item> ::= %"pack" <pack-kind> %IDENTIFIER %"native" <text>
<pack-kind> ::= %"rest" | %"keywords"
<variadic-item> ::= %"variadic" <variadic-kind> <yes-no>
<variadic-kind> ::= %"call" | %"define"
<error-style-item> ::= %"error" %"style" <error-style>
<error-style> ::= %"exceptions" | %"result" | %"multi_return" | %"status"
<error-type-item> ::= %"error" %"type" <text>
<callback-style-item> ::= %"callback" %"style" <callback-style>
<callback-style> ::= %"closure" | %"userdata" | %"static"
<handle-close-item> ::= %"handle" %"close" <text>
<lifetimes-item> ::= %"lifetimes" <yes-no>
<naming-item> ::= %"naming" %IDENTIFIER <ref>
<reserved-item> ::= %"reserved" <text> (%"," <text>)*
<label-map-item> ::= %"label" %IDENTIFIER %"->" <text>

<binding-decl> ::= %"binding" %IDENTIFIER %"for" <ref> <direction> %"{" <binding-item>* %"}"
<direction> ::= %"import" | %"export"
<embedded-binding> ::= %"binding" <export-mark>? %"{" <binding-item>* %"}"
<export-mark> ::= %"export"
<binding-item> ::= <module-item> | <strip-prefix-item> | <name-item> | <type-as-item> | <method-item> | <repr-item> | <keywords-item> | <error-map-item> | <borrow-item> | <policy-item> | <callback-as-item> | <label-map-item> | <hide-item> | <raw-item> | <load-item> | <library-item> | <search-path-item> | <header-item> | <provide-item> | <on-panic-item> | <allocator-own-item>
<target> ::= %IDENTIFIER (%"::" %IDENTIFIER)? (%"." %IDENTIFIER)?
<module-item> ::= %"module" %STRING
<strip-prefix-item> ::= %"strip_prefix" %STRING
<name-item> ::= %"name" <target> <text>
<type-as-item> ::= %"type" %IDENTIFIER %"as" <text>
<method-item> ::= <method-kind> <target> %"=" <target>
<method-kind> ::= %"method" | %"static"
<repr-item> ::= <repr-kind> <target> %"as" %IDENTIFIER
<repr-kind> ::= %"string" | %"buffer" | %"pack"
<keywords-item> ::= %"keywords" <keywords-target> %"as" %IDENTIFIER
<keywords-target> ::= %IDENTIFIER | %"*"
<error-map-item> ::= %"error" <pattern> %"->" <text>
<borrow-item> ::= %"borrow" <target> %"as" <borrow-mode>
<borrow-mode> ::= %"lifetime" | %"copy"
<policy-item> ::= %"policy" <target> %"use" %IDENTIFIER
<callback-as-item> ::= %"callback" %IDENTIFIER %"as" <text>
<hide-item> ::= %"hide" %STRING
<raw-item> ::= %"raw" %STRING
<load-item> ::= %"load" <load-mode>
<load-mode> ::= %"static" | %"dynamic"
<library-item> ::= %"library" <text> <when-part>?
<search-path-item> ::= %"search_path" <text>
<header-item> ::= %"header" <text>
<provide-item> ::= %"provide" <target> %"=" <text>
<on-panic-item> ::= %"on_panic" <panic-action>
<panic-action> ::= <panic-abort> | <panic-error>
<panic-abort> ::= %"abort"
<panic-error> ::= %"error" <expr>
<allocator-own-item> ::= %"allocator" %"own" %"->" %IDENTIFIER
