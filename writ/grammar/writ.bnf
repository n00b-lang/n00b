<file> ::= <item>*
<declarations> ::= <decl>*
<item> ::= <directive> | <decl>
<directive> ::= <library-directive> | <link-directive> | <header-directive>
<library-directive> ::= %"library" %IDENTIFIER
<link-directive> ::= %"link" %STRING
<header-directive> ::= %"header" <header-name>
<header-name> ::= <header-quoted> | <header-angle>
<header-quoted> ::= %STRING
<header-angle> ::= %"<" <header-path> %">"
<header-path> ::= %IDENTIFIER (<header-sep> %IDENTIFIER)*
<header-sep> ::= %"." | %"/" | %"-"
<decl> ::= <const-decl> | <fn-decl>
<const-decl> ::= %"const" %IDENTIFIER %":" <type> %"=" <expr>
<fn-decl> ::= %"fn" %IDENTIFIER %"(" <params>? %")" <fn-result>? <fn-clause>*
<params> ::= <param> (%"," <param>)* %","?
<param> ::= %IDENTIFIER %":" <mode>? <type>
<mode> ::= %"in" | %"out" | %"inout"
<fn-result> ::= %"->" <type>
<fn-clause> ::= <pure-clause> | <sizing-clause> | <error-clause>
<pure-clause> ::= %"pure"
<sizing-clause> ::= %"sizing" %"needs" <expr>
<error-clause> ::= %"error" <expr> <via-clause>?
<via-clause> ::= %"via" <expr>
<type> ::= <named-type> | <pointer-type> | <array-type> | <bytes-type>
<named-type> ::= %IDENTIFIER
<pointer-type> ::= <pointer-mark> <type>
<array-type> ::= <pointer-mark> %"[" <type> %";" <extent> %"]"
<bytes-type> ::= %"bytes" %"[" <extent> %"]"
<pointer-mark> ::= %"*" | %"?"
<extent> ::= <count-extent> | <bounded-extent>
<count-extent> ::= <expr>
<bounded-extent> ::= %"cap" <expr> %"," %"len" <expr>
<expr> ::= <or-expr>
<or-expr> ::= <or-expr> %"or" <and-expr> | <and-expr>
<and-expr> ::= <and-expr> %"and" <cmp-expr> | <cmp-expr>
<cmp-expr> ::= <add-expr> <cmp-op> <add-expr> | <add-expr>
<cmp-op> ::= %"==" | %"!=" | %"<" | %">" | %"<=" | %">="
<add-expr> ::= <add-expr> <add-op> <mul-expr> | <mul-expr>
<add-op> ::= %"+" | %"-"
<mul-expr> ::= <mul-expr> <mul-op> <unary-expr> | <unary-expr>
<mul-op> ::= %"*" | %"/"
<unary-expr> ::= <neg-expr> | <not-expr> | <postfix-expr>
<neg-expr> ::= %"-" <unary-expr>
<not-expr> ::= %"not" <unary-expr>
<postfix-expr> ::= <member-expr> | <call-expr> | <primary>
<member-expr> ::= <postfix-expr> %"." %IDENTIFIER
<call-expr> ::= <postfix-expr> %"(" <args>? %")"
<args> ::= <expr> (%"," <expr>)*
<primary> ::= <name-ref> | <int-lit> | <string-lit> | <paren-expr>
<name-ref> ::= %IDENTIFIER
<int-lit> ::= %INTEGER
<string-lit> ::= %STRING
<paren-expr> ::= %"(" <expr> %")"
