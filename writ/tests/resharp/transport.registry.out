#[cfg(feature = "experimental_capture_groups")]
#[no_mangle]
pub unsafe extern "C" fn writ_resharp_regex_options_implicit_captures(
    this: *mut writ_resharp_regex_options,
    yes: bool,
    out: *mut *mut writ_resharp_regex_options,
) -> c_int {
    guard(|| {
        let this = match take(this) {
            Ok(value) => value.0,
            Err(status) => return status,
        };
        let result = this.implicit_captures(yes);
        *out = Box::into_raw(Box::new(writ_resharp_regex_options(result)));
        STATUS_OK
    })
}

#[no_mangle]
pub unsafe extern "C" fn writ_resharp_regex_is_match(
    this: *const writ_resharp_regex,
    input: *const u8,
    input_len: usize,
    out: *mut bool,
) -> c_int {
    guard(|| {
        let this = match borrow(this) {
            Ok(value) => &value.0,
            Err(status) => return status,
        };
        let input = slice(input, input_len);
        let result = this.is_match(input);
        let result = match result {
            Ok(value) => value,
            Err(error) => return fail(error.to_string()),
        };
        *out = result;
        STATUS_OK
    })
}

#[no_mangle]
pub unsafe extern "C" fn writ_resharp_regex_new(
    pattern: *const u8,
    pattern_len: usize,
    out: *mut *mut writ_resharp_regex,
) -> c_int {
    guard(|| {
        let pattern = match text(pattern, pattern_len) {
            Ok(value) => value,
            Err(status) => return status,
        };
        let result = resharp::Regex::new(pattern);
        let result = match result {
            Ok(value) => value,
            Err(error) => return fail(error.to_string()),
        };
        *out = Box::into_raw(Box::new(writ_resharp_regex(result)));
        STATUS_OK
    })
}

#[no_mangle]
pub unsafe extern "C" fn writ_resharp_regex_with_options(
    pattern: *const u8,
    pattern_len: usize,
    opts: *mut writ_resharp_regex_options,
    out: *mut *mut writ_resharp_regex,
) -> c_int {
    guard(|| {
        let pattern = match text(pattern, pattern_len) {
            Ok(value) => value,
            Err(status) => return status,
        };
        let opts = match take(opts) {
            Ok(value) => value.0,
            Err(status) => return status,
        };
        let result = resharp::Regex::with_options(pattern, opts);
        let result = match result {
            Ok(value) => value,
            Err(error) => return fail(error.to_string()),
        };
        *out = Box::into_raw(Box::new(writ_resharp_regex(result)));
        STATUS_OK
    })
}

#[no_mangle]
pub unsafe extern "C" fn writ_resharp_regex_find_all(
    this: *const writ_resharp_regex,
    input: *const u8,
    input_len: usize,
    out: *mut Match,
    out_cap: usize,
    out_total: *mut usize,
) -> c_int {
    guard(|| {
        let this = match borrow(this) {
            Ok(value) => &value.0,
            Err(status) => return status,
        };
        let input = slice(input, input_len);
        let result = this.find_all(input);
        let result = match result {
            Ok(value) => value,
            Err(error) => return fail(error.to_string()),
        };
        write_all(&result, out, out_cap, out_total, |value| Match { start: value.start, end: value.end });
        STATUS_OK
    })
}

#[no_mangle]
pub unsafe extern "C" fn writ_resharp_regex_find_anchored(
    this: *const writ_resharp_regex,
    input: *const u8,
    input_len: usize,
    out: *mut Match,
) -> c_int {
    guard(|| {
        let this = match borrow(this) {
            Ok(value) => &value.0,
            Err(status) => return status,
        };
        let input = slice(input, input_len);
        let result = this.find_anchored(input);
        let result = match result {
            Ok(value) => value,
            Err(error) => return fail(error.to_string()),
        };
        let result = match result {
            Some(value) => value,
            None => return STATUS_NONE,
        };
        *out = Match { start: result.start, end: result.end };
        STATUS_OK
    })
}

#[no_mangle]
pub unsafe extern "C" fn writ_resharp_regex_is_full_match(
    this: *const writ_resharp_regex,
    input: *const u8,
    input_len: usize,
    out: *mut bool,
) -> c_int {
    guard(|| {
        let this = match borrow(this) {
            Ok(value) => &value.0,
            Err(status) => return status,
        };
        let input = slice(input, input_len);
        let result = this.is_full_match(input);
        let result = match result {
            Ok(value) => value,
            Err(error) => return fail(error.to_string()),
        };
        *out = result;
        STATUS_OK
    })
}

#[cfg(feature = "experimental_capture_groups")]
#[no_mangle]
pub unsafe extern "C" fn writ_resharp_regex_capture_index_for_name(
    this: *const writ_resharp_regex,
    name: *const u8,
    name_len: usize,
    out: *mut usize,
) -> c_int {
    guard(|| {
        let this = match borrow(this) {
            Ok(value) => &value.0,
            Err(status) => return status,
        };
        let name = match text(name, name_len) {
            Ok(value) => value,
            Err(status) => return status,
        };
        let result = this.capture_index_for_name(name);
        let result = match result {
            Some(value) => value,
            None => return STATUS_NONE,
        };
        *out = result;
        STATUS_OK
    })
}
