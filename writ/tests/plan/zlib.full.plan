plan zlibVersion
item 0 result result text static
slot 0 value whole result
attempt   call           fixed
classify  ok: success
ok        lift_value     ret -> result

plan deflate
item 0 strm input_output record borrowed
item 1 flush input scalar none
item 2 failed_status error_detail scalar none
slot 0 inout_pointer whole strm
slot 1 value whole flush
slot 2 value whole -
prepare   pass           strm -> s0
          pass           flush -> s1
attempt   call           fixed
classify  progress: success when (ret == Z_OK)
          done: success when (ret == Z_STREAM_END)
          stalled: failure when (ret == Z_BUF_ERROR)
          failed: failure
failed    fetch_detail   ret -> failed_status

plan deflateEnd
item 0 strm input_output record borrowed
item 1 status error_detail scalar none
slot 0 inout_pointer whole strm
slot 1 value whole -
prepare   pass           strm -> s0
attempt   call           fixed
classify  error: failure when (ret != Z_OK)
          ok: success
error     fetch_detail   ret -> status

plan inflate
item 0 strm input_output record borrowed
item 1 flush input scalar none
item 2 corrupt_detail error_detail scalar none
item 3 failed_status error_detail scalar none
slot 0 inout_pointer whole strm
slot 1 value whole flush
slot 2 value whole -
prepare   pass           strm -> s0
          pass           flush -> s1
attempt   call           fixed
classify  done: success when (ret == Z_STREAM_END)
          progress: success when (ret == Z_OK)
          stalled: failure when (ret == Z_BUF_ERROR)
          needs_dictionary: failure when (ret == Z_NEED_DICT)
          corrupt: failure when (ret == Z_DATA_ERROR)
          failed: failure
corrupt   fetch_detail   s0->msg -> corrupt_detail
failed    fetch_detail   ret -> failed_status

plan inflateEnd
item 0 strm input_output record borrowed
item 1 status error_detail scalar none
slot 0 inout_pointer whole strm
slot 1 value whole -
prepare   pass           strm -> s0
attempt   call           fixed
classify  error: failure when (ret != Z_OK)
          ok: success
error     fetch_detail   ret -> status

plan compress2
item 0 dest result bytes caller_owns
item 1 source input bytes borrowed
item 2 level input scalar none
item 3 status error_detail scalar none
slot 0 out_pointer pointer dest
slot 1 inout_pointer capacity_and_length dest
slot 2 in_pointer pointer source
slot 3 value length source
slot 4 value whole level
slot 5 value whole -
local 0 buffer u8 dest
local 1 cell c_ulong dest
prepare   check          source fits s3
          split          source -> s2, s3
          pass           level -> s4
attempt   alloc_out      dest -> L0, cap compressBound(s3)
          pass           cap(L0) -> L1
          bind_out       L0 -> s0
          bind_out       L1 -> s1
          call           fixed
classify  error: failure when (ret != Z_OK)
          ok: success
error     fetch_detail   ret -> status
ok        lift_buffer    L0 -> dest, len L1
finally   release_local  L0 unless handed over

plan compressBound
item 0 sourceLen input scalar none
item 1 result result scalar none
slot 0 value whole sourceLen
slot 1 value whole result
prepare   pass           sourceLen -> s0
attempt   call           fixed
classify  ok: success
ok        lift_value     ret -> result

plan uncompress
item 0 dest result bytes caller_owns
item 1 dest_capacity input scalar none
item 2 source input bytes borrowed
item 3 status error_detail scalar none
slot 0 out_pointer pointer dest
slot 1 inout_pointer capacity_and_length dest
slot 2 in_pointer pointer source
slot 3 value length source
slot 4 value whole -
local 0 buffer u8 dest
local 1 cell c_ulong dest
prepare   check          source fits s3
          split          source -> s2, s3
attempt   alloc_out      dest -> L0, cap dest_capacity
          pass           cap(L0) -> L1
          bind_out       L0 -> s0
          bind_out       L1 -> s1
          call           fixed
classify  error: failure when (ret != Z_OK)
          ok: success
error     fetch_detail   ret -> status
ok        lift_buffer    L0 -> dest, len L1
finally   release_local  L0 unless handed over

plan adler32
item 0 adler input scalar none
item 1 buf input bytes borrowed
item 2 result result scalar none
slot 0 value whole adler
slot 1 in_pointer pointer buf
slot 2 value length buf
slot 3 value whole result
prepare   pass           adler -> s0
          check          buf fits s2
          split          buf -> s1, s2
attempt   call           fixed
classify  ok: success
ok        lift_value     ret -> result

plan crc32
item 0 crc input scalar none
item 1 buf input bytes borrowed
item 2 result result scalar none
slot 0 value whole crc
slot 1 in_pointer pointer buf
slot 2 value length buf
slot 3 value whole result
prepare   pass           crc -> s0
          check          buf fits s2
          split          buf -> s1, s2
attempt   call           fixed
classify  ok: success
ok        lift_value     ret -> result

plan deflateInit_
item 0 strm input_output record borrowed
item 1 level input scalar none
item 2 version input text borrowed
item 3 stream_size input scalar none
item 4 status error_detail scalar none
slot 0 inout_pointer whole strm
slot 1 value whole level
slot 2 in_pointer whole version
slot 3 value whole stream_size
slot 4 value whole -
local 0 text c_char version
prepare   pass           strm -> s0
          pass           level -> s1
          encode_cstr    version -> L0
          pass           stream_size -> s3
attempt   call           fixed
classify  error: failure when (ret != Z_OK)
          ok: success
error     fetch_detail   ret -> status
finally   release_local  L0 unless handed over

plan inflateInit_
item 0 strm input_output record borrowed
item 1 version input text borrowed
item 2 stream_size input scalar none
item 3 status error_detail scalar none
slot 0 inout_pointer whole strm
slot 1 in_pointer whole version
slot 2 value whole stream_size
slot 3 value whole -
local 0 text c_char version
prepare   pass           strm -> s0
          encode_cstr    version -> L0
          pass           stream_size -> s2
attempt   call           fixed
classify  error: failure when (ret != Z_OK)
          ok: success
error     fetch_detail   ret -> status
finally   release_local  L0 unless handed over

plan deflateInit
item 0 strm input_output record borrowed
item 1 level input scalar none
item 2 status error_detail scalar none
slot 0 inout_pointer whole strm
slot 1 value whole level
slot 2 value whole -
prepare   pass           strm -> s0
          pass           level -> s1
attempt   call           fixed
classify  error: failure when (ret != Z_OK)
          ok: success
error     fetch_detail   ret -> status

