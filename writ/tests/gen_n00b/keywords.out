static int32_t keywords_encode(const char *text, size_t length, char **out) {
    if (memchr(text, 0, length)) {
        return KEYWORDS_ARGUMENT_ERROR;
    }
    *out = malloc(length + 1);
    if (!*out) {
        return KEYWORDS_OUT_OF_MEMORY;
    }
    memcpy(*out, text, length);
    (*out)[length] = 0;
    return 0;
}

