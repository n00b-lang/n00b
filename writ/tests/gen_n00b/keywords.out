type Error {
    public code: i64
    public text: string?
    public fn: string
}

type Db {
    raw: uint
}

type Open_Opts layout(c) {
    public present: u32
    public timeout_ms: u32
    public readonly: bool
    public cache_kb: u32
}

type Limits layout(c) {
    public max_rows: i64
    public min_rows: i64
}

type Sized layout(c) {
    public size: u32
    public flags: u32
}

type Plain layout(c) {
    public depth: i32
}

func db_open(path: string, timeout_ms: u32? = nil, readonly: bool? = nil, cache_kb: u32? = nil) -> Db fail: Error {
    var opts_record: Open_Opts = (present = 0, timeout_ms = 0, readonly = false, cache_kb = 0)
    if timeout_ms != nil {
        opts_record.timeout_ms = timeout_ms.get()
        opts_record.present = opts_record.present | 1
    } else {
        opts_record.timeout_ms = 30000
    }
    if readonly != nil {
        opts_record.readonly = readonly.get()
        opts_record.present = opts_record.present | 2
    } else {
        opts_record.readonly = false
    }
    if cache_kb != nil {
        opts_record.cache_kb = cache_kb.get()
        opts_record.present = opts_record.present | 4
    }
    var path_value = path
    var result: uint = 0
    let outcome = __db_open(ref path_value, ref opts_record, ref result)
    if outcome < 0 {
        let failure: Error = (code = cast[i64]outcome, text = nil, fn = "db_open")
        fail failure
    }
    return (raw = result)
}

type Db_Limit_Options {
    public max_rows: i64?
    public min_rows: i64?
}

func db_limit(db: Db, limits: Db_Limit_Options) -> i64 {
    var limits_record: Limits = (max_rows = 0, min_rows = 0)
    if limits.max_rows != nil {
        limits_record.max_rows = limits.max_rows.get()
    } else {
        limits_record.max_rows = -1
    }
    if limits.min_rows != nil {
        limits_record.min_rows = limits.min_rows.get()
    } else {
        limits_record.min_rows = -1
    }
    let result = __db_limit(db.raw, ref limits_record)
    return result
}

func db_flags(db: Db, flags: u32 = 4) -> u32 {
    var sized_record: Sized = (size = 0, flags = 0)
    sized_record.flags = flags
    sized_record.size = 8
    let result = __db_flags(db.raw, ref sized_record)
    return result
}

func db_depth(db: Db, depth: i32 = 3) -> i32 {
    var plain_record: Plain = (depth = 0)
    plain_record.depth = depth
    let result = __db_depth(db.raw, ref plain_record)
    return result
}

func close(modify self: Db) fail: Error {
    let outcome = __db_close(self.raw)
    if outcome < 0 {
        let failure: Error = (code = cast[i64]outcome, text = nil, fn = "db_close")
        fail failure
    }
    self.raw = 0
}
