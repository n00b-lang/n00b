    var key_value: Array[u8] = new[Array[u8]](cast[int]c_klen)
    __export_copy_in(c_key, ref key_value)
    var val_value: Array[u8] = new[Array[u8]](cast[int]c_vlen)
    __export_copy_in(c_val, ref val_value)
    try {
        kvstore.put(db_value, key_value, val_value)!
        return 0
    } else failure {
        __export_failed(failed, 1)
        return cast[i64]failure.code
    }
}

func __export_kv_get(c_db: uint, c_key: uint, c_klen: u64, c_out_val: uint, c_out_len: uint, failed: uint) -> i64 {
    let db_value = __export_Db(c_db)
    if db_value == nil {
        __export_failed(failed, 2)
        return -1
    }
    var key_value: Array[u8] = new[Array[u8]](cast[int]c_klen)
    __export_copy_in(c_key, ref key_value)
    try {
        let result = kvstore.get(db_value, key_value)!
