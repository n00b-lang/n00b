        __export_own_bytes(ref bytes, c_out_val, c_out_len)
        return 0
    } else failure {
        __export_failed(failed, 1)
        return cast[i64]failure.code
    }
}

func __export_kv_iter_new(c_db: uint, c_prefix: uint, c_plen: u64, failed: uint) -> uint {
    let db_value = __export_Db(c_db)
    if db_value == nil {
        __export_failed(failed, 2)
        return 0
    }
    var prefix_value: Array[u8] = new[Array[u8]](cast[int]c_plen)
    __export_copy_in(c_prefix, ref prefix_value)
    try {
        let result:  = kvstore.iter_new(db_value, prefix_value)!
        return cast[uint]__ffi_table_insert(__handles_Iter, result)
    } else failure {
        __export_failed(failed, 1)
        return 0
    }
}

func __export_kv_iter_next(c_it: uint, failed: uint) -> uint {
    let it_value = __export_Iter(c_it)
    if it_value == nil {
        __export_failed(failed, 2)
        return 0
