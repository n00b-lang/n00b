func __ffi_copy_cstr(address: uint, text: Ref[string]) -> bool {
    var bytes: Array[u8] = new[Array[u8]](cast[int]__ffi_cstr_length(address))
    __ffi_cstr_copy(address, ref bytes)
    return __string_from_utf8(ref bytes, text)
}

record Export_Hold {
    private handle: uint
    private items: List[Array[u8]]
}

var __export_holds: List[Export_Hold] = new[List[Export_Hold]]()
var __export_texts: List[Array[u8]] = new[List[Array[u8]]]()
var __export_text_addresses: List[uint] = new[List[uint]]()

func __export_drop(handle: uint) {
    var kept: List[Export_Hold] = new[List[Export_Hold]]()
    for hold in __export_holds {
        if hold.handle != handle {
            kept.append(hold)
        }
    }
    __export_holds = kept
}

func __export_hold(handle: uint, items: List[Array[u8]]) {
    __export_drop(handle)
    let hold: Export_Hold = (handle = handle, items = items)
    __export_holds.append(hold)
}

func __export_same(left: Array[u8], right: Array[u8]) -> bool {
    if left.len() != right.len() {
        return false
    }
    var i: uint = 0
    while i < left.len() {
        if left[i] != right[i] {
            return false
        }
        i += 1
    }
    return true
}

func __export_text(text: string) -> uint {
    let source: Array[u8] = __text_byte_array(text)
    var bytes: Array[u8] = new[Array[u8]](cast[int]source.len() + 1)
    var k: uint = 0
    while k < source.len() {
        bytes[k] = source[k]
        k += 1
    }
    var i = 0
    while i < cast[int]__export_texts.len() {
        if __export_same(__export_texts[i], bytes) {
            return __export_text_addresses[i]
        }
        i += 1
    }
    __export_texts.append(bytes)
    let address = __export_address(ref bytes)
    __export_text_addresses.append(address)
    return address
}

func __export_keep_kv_entry(handle: uint, key: Array[u8], val: Array[u8]) -> uint {
    var key_copy = key
    var val_copy = val
    var storage: Array[u8] = new[Array[u8]](32)
    var items: List[Array[u8]] = new[List[Array[u8]]]()
    items.append(storage)
    __export_kv_entry_fill(ref storage, ref key_copy, ref val_copy)
    items.append(key_copy)
    items.append(val_copy)
    __export_hold(handle, items)
    return __export_address(ref storage)
}

func __export_kv_open(c_path: uint, c_out_db: uint, failed: uint) -> i64 {
    var path_value: string = ""
    if !__ffi_copy_cstr(c_path, ref path_value) {
        __export_failed(failed, 2)
        return -1
    }
    try {
        let result:  = kvstore.open(path_value)!
        __export_store(c_out_db, cast[uint]__ffi_table_insert(__handles_Db, result))
        return 0
    } else failure {
        __export_failed(failed, 1)
        return cast[i64]failure.code
    }
}

func __export_kv_put(c_db: uint, c_key: uint, c_klen: u64, c_val: uint, c_vlen: u64, failed: uint) -> i64 {
    let db_value = __export_Db(c_db)
    if db_value == nil {
