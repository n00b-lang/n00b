    if result == nil {
        return 0
    }
    return __export_keep_kv_entry(2 * 4294967296 + c_it, result.key, result.val)
}

func __export_kv_errstr(c_s: i32, failed: uint) -> uint {
    let s_value = c_s
    let result = kvstore.errstr(s_value)
    return __export_text(result)
}
