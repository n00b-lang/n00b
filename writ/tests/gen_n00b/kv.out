static int32_t kv_encode(const char *text, size_t length, char **out) {
    if (memchr(text, 0, length)) {
        return KV_ARGUMENT_ERROR;
    }
    *out = malloc(length + 1);
    if (!*out) {
        return KV_OUT_OF_MEMORY;
    }
    memcpy(*out, text, length);
    (*out)[length] = 0;
    return 0;
}

static int kv_copy_text(const char *text, kv_bytes_t *out) {
    size_t length = text ? strlen(text) : 0;
    out->data = malloc(length + 1);
    if (!out->data) {
        return -1;
    }
    memcpy(out->data, text ? text : "", length + 1);
    out->length = length;
    return 0;
}

