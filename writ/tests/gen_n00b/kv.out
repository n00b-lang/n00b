static int32_t writ_kv_encode(const char *text, size_t length, char **out) {
    if (memchr(text, 0, length)) {
        return WRIT_KV_ARGUMENT_ERROR;
    }
    *out = malloc(length + 1);
    if (!*out) {
        return WRIT_KV_OUT_OF_MEMORY;
    }
    memcpy(*out, text, length);
    (*out)[length] = 0;
    return 0;
}

