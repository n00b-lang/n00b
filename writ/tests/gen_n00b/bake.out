record Error {
    public code: i64
    public text: string?
    public fn: string
}

record Bake_Item_T layout(c) {
    public key: i32
    public value: i32
    public hash: u64
    public label: Foreign[i8]? until 0
}

record Bake_Items_T layout(c) {
    public data: Foreign[Bake_Item_T]? count len
    public len: u64
    public cap: u64
}

record Bake_Variant_T layout(c) {
    public kind: i32
    public v: union by kind {
        1 => number: i64
        2 => text: Foreign[i8]? until 0
    }
}

record Bake_Slot_T layout(c) {
    public key: Foreign[Bake_Item_T]?
    public hash: u64
    public value: i32
}

record Bake_Table_T layout(c) {
    public slots: Foreign[Bake_Slot_T]? count len
    public len: u64
}

record Bake_Root_T layout(c) {
    public name: Foreign[i8]? until 0
    public items: Bake_Items_T
    public codes: Foreign[i32]? until 0
    public variant_: Bake_Variant_T
    public middle: Foreign[Bake_Item_T]?
    public op: Foreign_Fn[(i64, i64) -> i64]?
    public table: Bake_Table_T
    public cache: i64
    public fd: i32
    public path: Foreign[i8]? until 0
}

record Bake_Root_Cell {
    public raw: Foreign[Bake_Root_T]?
}

alias type Bake_Root =Ref[Bake_Root_Cell]

func __bake_root_cell(raw: uint) -> Bake_Root {
    var cell: Bake_Root_Cell = (raw = unsafe_cast[Foreign[Bake_Root_T]?] raw)
    return ref cell
}

func __finalize(consume self: Ref[Bake_Root_Cell]) {
    if self.raw != nil and debug_enabled() and !__abi_baked_address(unsafe_cast[uint] self.raw) {
        __fd_write(2, "Bake_Root collected while open; releasing it\n")
        let released = __bake_free(unsafe_cast[uint] self.raw)
    }
}

enum Bake_Kind {
    BAKE_NUMBER = 1,
    BAKE_TEXT = 2
}

public const BAKE_QUERY_NAME: i32 = 0
public const BAKE_QUERY_ITEMS: i32 = 1
public const BAKE_QUERY_CODES: i32 = 2
public const BAKE_QUERY_VARIANT: i32 = 3
public const BAKE_QUERY_SHARED: i32 = 4
public const BAKE_QUERY_MIDDLE: i32 = 5
public const BAKE_QUERY_OP: i32 = 6
public const BAKE_QUERY_HASH: i32 = 7
public const BAKE_QUERY_CACHE: i32 = 8
public const BAKE_QUERY_FD: i32 = 9

func bake_add(left: i64, right: i64) -> i64 {
    let result = __bake_add(left, right)
    return result
}

func bake_multiply(left: i64, right: i64) -> i64 {
    let result = __bake_multiply(left, right)
    return result
}

func bake_build(spec: string) -> Bake_Root fail: Error {
    var spec_value: Array[u8] = __text_byte_array(spec)
    var result: uint = 0
    let outcome = __bake_build(ref spec_value, ref result)
    if outcome < 0 {
        let failure: Error = (code = cast[i64]outcome, text = nil, fn = "bake_build")
        fail failure
    }
    return __bake_root_cell(result)
}

func bake_query(root: Bake_Root, key: i32) -> i64 {
    if root.raw == nil {
        panic("bake_query: handle is closed")
    }
    let __fixup_root: string? = __ffi_fixup(root.raw)
    if __fixup_root != nil {
        panic(__fixup_root.get())
    }
    let result = __bake_query(unsafe_cast[uint] root.raw, key)
    return result
}

func bake_reopen(root: Bake_Root) fail: Error {
    if root.raw == nil {
        let failure: Error = (code = -1, text = "handle is closed", fn = "bake_reopen")
        fail failure
    }
    let __fixup_root: string? = __ffi_fixup(root.raw)
    if __fixup_root != nil {
        let failure: Error = (code = -1, text = __fixup_root, fn = "bake_reopen")
        fail failure
    }
    let outcome = __bake_reopen(unsafe_cast[uint] root.raw)
    if outcome < 0 {
        let failure: Error = (code = cast[i64]outcome, text = nil, fn = "bake_reopen")
        fail failure
    }
    if outcome == 0 {
        let failure: Error = (code = cast[i64]outcome, text = nil, fn = "bake_reopen")
        fail failure
    }
}

func bake_open(path: string) -> i32 fail: Error {
    var path_value: Array[u8] = __text_byte_array(path)
    var result: i32 = 0
    let outcome = __bake_open(ref path_value, ref result)
    if outcome < 0 {
        let failure: Error = (code = cast[i64]outcome, text = nil, fn = "bake_open")
        fail failure
    }
    return result
}

func bake_touch(path: string, text: string) -> i32 fail: Error {
    var path_value: Array[u8] = __text_byte_array(path)
    var text_value: Array[u8] = __text_byte_array(text)
    var result: i32 = 0
    let outcome = __bake_touch(ref path_value, ref text_value, ref result)
    if outcome < 0 {
        let failure: Error = (code = cast[i64]outcome, text = nil, fn = "bake_touch")
        fail failure
    }
    return result
}

func close(modify self: Bake_Root) fail: Error {
    if self.raw == nil {
        let failure: Error = (code = -1, text = "handle is closed", fn = "bake_free")
        fail failure
    }
    if __abi_baked_address(unsafe_cast[uint] self.raw) {
        let failure: Error = (code = -1, text = "a baked object cannot be released", fn = "bake_free")
        fail failure
    }
    let outcome = __bake_free(unsafe_cast[uint] self.raw)
    if outcome < 0 {
        let failure: Error = (code = cast[i64]outcome, text = nil, fn = "bake_free")
        fail failure
    }
    self.raw = nil
}
