void *n00b_ffi_borrow(void *object, size_t *length, uint32_t access);
void n00b_ffi_release(void *object);
void n00bb_runtime_trap(const char *reason, uint64_t length);

void pts_take_bytes(pts_bytes_t *bytes, void *out) {
    size_t length = 0;
    uint8_t *data = n00b_ffi_borrow(out, &length, 1);
    if (data && bytes->data) {
        memcpy(data, bytes->data, length < bytes->length ? length : bytes->length);
    }
    n00b_ffi_release(out);
    pts_bytes_free(bytes);
}

int32_t pts_n00b_pt_scale(const void *p, double k) {
    size_t p_length = 0;
    const void *p_data = n00b_ffi_borrow((void *)p, &p_length, 0);
    int32_t writ_n00b_value = pts_pt_scale((point *)p_data, k);
    n00b_ffi_release((void *)p);
    return writ_n00b_value;
}

int32_t pts_n00b_pt_origin(void *result) {
    int32_t writ_n00b_value = pts_pt_origin((point *)result);
    return writ_n00b_value;
}

int pts_n00b_pt_type(int mode) {
    int writ_n00b_value = pts_pt_type(mode);
    return writ_n00b_value;
}

int32_t pts_n00b_pt_sum(const void *args, void *result) {
    size_t args_length = 0;
    const void *args_borrowed = n00b_ffi_borrow((void *)args, &args_length, 0);
    uint8_t *args_data = malloc(args_length + 1);
    if (args_data && args_length) {
        memcpy(args_data, args_borrowed, args_length);
    }
    if (args_data) {
        args_data[args_length] = 0;
    }
    n00b_ffi_release((void *)args);
    if (!args_data) {
        free(args_data);
        return PTS_OUT_OF_MEMORY;
    }
    int32_t writ_n00b_value = pts_pt_sum((const double *)args_data, args_length, (double *)result);
    free(args_data);
    return writ_n00b_value;
}

record Error {
    code: i64
    text: string?
    fn: string
}

record Point {
    private storage: Array[u8]
}

func point() -> Point {
    let value: Point = (storage = new[Array[u8]](8))
    return value
}

func x(self: Point) -> f64 {
    return __ffi_read_f32(ref self.storage, 0)
}

func set_x(modify self: Point, value: f64) {
    __ffi_write_f32(ref self.storage, 0, value)
}

func y(self: Point) -> f64 {
    return __ffi_read_f32(ref self.storage, 4)
}

func set_y(modify self: Point, value: f64) {
    __ffi_write_f32(ref self.storage, 4, value)
}

flagset Mode {
    PT_READ,
    PT_WRITE,
    unused_bit_2,
    PT_EXEC,
    PT_BOTH = PT_READ + PT_WRITE,
}


func peek_raw(p: uint) -> i32 {
    return __peek_raw(p)
}

func scale(modify p: Point, k: f64) fail: Scale_Failure {
    let outcome = __pt_scale(ref p.storage, k)
    if outcome < 0 {
        fail new[Scale_Failure](cast[i64]outcome, nil, "pt_scale")
    }
    if outcome == 0 {
        fail new[Scale_Failure](cast[i64]outcome, nil, "pt_scale")
    }
}

func origin() -> Point fail: Error {
    var result = point()
    let outcome = __pt_origin(ref result.storage)
    if outcome < 0 {
        let failure: Error = (code = cast[i64]outcome, text = nil, fn = "pt_origin")
        fail failure
    }
    return result
}

func type_(mode: Mode) -> i32 {
    let result = __pt_type(mode)
    return result
}

func sum(args: List[f64]) -> f64 fail: Error {
    var args_value = args
    var result: f64 = 0
    let outcome = __pt_sum(ref args_value, ref result)
    if outcome < 0 {
        let failure: Error = (code = cast[i64]outcome, text = nil, fn = "pt_sum")
        fail failure
    }
    return result
}
