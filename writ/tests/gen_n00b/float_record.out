void pts_bytes_free(pts_bytes_t *bytes) {
    free(bytes->data);
    bytes->data = NULL;
    bytes->length = 0;
}

void pts_free(void *data) {
    free(data);
}

int32_t pts_pt_scale(point *p, double k) {
    point *s0 = 0;
    double s1 = 0;
    int ret = 0;
    int32_t outcome = 0;
    s0 = p;
    s1 = k;
    ret = pt_scale(s0, s1);
    if (((long long)ret) != 0) {
        outcome = pts_pt_scale_error;
    }
    else {
        outcome = pts_pt_scale_ok;
    }
    return outcome;
}

int32_t pts_pt_origin(point *result) {
    point ret = {0};
    int32_t outcome = 0;
    ret = pt_origin();
    {
        outcome = pts_pt_origin_ok;
    }
    if (outcome == pts_pt_origin_ok) {
        *result = ret;
    }
    return outcome;
}

int pts_pt_type(int mode) {
    int s0 = 0;
    int ret = 0;
    s0 = mode;
    ret = pt_type(s0);
    return ret;
}

int32_t pts_pt_sum(const double *args, size_t args_count, double *result) {
    int s0 = 0;
    double ret = 0;
    int32_t outcome = 0;
    s0 = (int)args_count;
    switch (args_count) {
        case 0:
            ret = pt_sum(s0);
            break;
        case 1:
            ret = pt_sum(s0, (double)args[0]);
            break;
        case 2:
            ret = pt_sum(s0, (double)args[0], (double)args[1]);
            break;
        case 3:
            ret = pt_sum(s0, (double)args[0], (double)args[1], (double)args[2]);
            break;
        case 4:
            ret = pt_sum(s0, (double)args[0], (double)args[1], (double)args[2], (double)args[3]);
            break;
        case 5:
            ret = pt_sum(s0, (double)args[0], (double)args[1], (double)args[2], (double)args[3], (double)args[4]);
            break;
        case 6:
            ret = pt_sum(s0, (double)args[0], (double)args[1], (double)args[2], (double)args[3], (double)args[4], (double)args[5]);
            break;
        case 7:
            ret = pt_sum(s0, (double)args[0], (double)args[1], (double)args[2], (double)args[3], (double)args[4], (double)args[5], (double)args[6]);
            break;
        case 8:
            ret = pt_sum(s0, (double)args[0], (double)args[1], (double)args[2], (double)args[3], (double)args[4], (double)args[5], (double)args[6], (double)args[7]);
            break;
        default:
            outcome = PTS_ARGUMENT_ERROR;
            goto finish;
    }
    {
        outcome = pts_pt_sum_ok;
    }
    if (outcome == pts_pt_sum_ok) {
        *result = ret;
    }
finish:
    return outcome;
}
