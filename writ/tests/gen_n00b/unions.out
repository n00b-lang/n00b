void unions_bytes_free(unions_bytes_t *bytes) {
    free(bytes->data);
    bytes->data = NULL;
    bytes->length = 0;
}

void unions_free(void *data) {
    free(data);
}

int unions_value_kind(Value *value) {
    Value *s0 = 0;
    int ret = 0;
    s0 = value;
    ret = value_kind(s0);
    return ret;
}

