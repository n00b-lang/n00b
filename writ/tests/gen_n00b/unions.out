void *n00b_ffi_borrow(void *object, size_t *length, uint32_t access);
void n00b_ffi_release(void *object);
void n00bb_runtime_trap(const char *reason, uint64_t length);

void unions_take_bytes(unions_bytes_t *bytes, void *out) {
    size_t length = 0;
    uint8_t *data = n00b_ffi_borrow(out, &length, 1);
    if (data && bytes->data) {
        memcpy(data, bytes->data, length < bytes->length ? length : bytes->length);
    }
    n00b_ffi_release(out);
    unions_bytes_free(bytes);
}

int unions_n00b_value_kind(const void *value) {
    int writ_n00b_value = unions_value_kind((Value *)value);
    return writ_n00b_value;
}

uint8_t unions_n00b_cell_flag(const void *cell, uint64_t raw) {
    size_t cell_length = 0;
    const void *cell_data = n00b_ffi_borrow((void *)cell, &cell_length, 0);
    uint8_t writ_n00b_value = unions_cell_flag((Cell *)cell_data, (Raw *)(uintptr_t)raw);
    n00b_ffi_release((void *)cell);
    return writ_n00b_value;
}

record Error {
    public code: i64
    public text: string?
    public fn: string
}

record Raw {
    private storage: Array[u8]
}

func raw() -> Raw {
    let value: Raw = (storage = new[Array[u8]](8))
    return value
}

func i(self: Raw) -> i64 {
    return __ffi_read_i64(ref self.storage, 0)
}

func set_i(modify self: Raw, value: i64) {
    __ffi_write_i64(ref self.storage, 0, value)
}

func d(self: Raw) -> f64 {
    return __ffi_read_f64(ref self.storage, 0)
}

func set_d(modify self: Raw, value: f64) {
    __ffi_write_f64(ref self.storage, 0, value)
}

func p(self: Raw) -> uint {
    return __ffi_read_u64(ref self.storage, 0)
}

func set_p(modify self: Raw, value: uint) {
    __ffi_write_u64(ref self.storage, 0, value)
}

record Value layout(c) {
    public kind: i32
    public v: union by kind {
        1 => i: i64
        2 => d: f64
        3 => s: Foreign[i8]? until 0
        5 => _
    }
}

record Cell {
    private storage: Array[u8]
}

func cell() -> Cell {
    let value: Cell = (storage = new[Array[u8]](16))
    return value
}

func flag(self: Cell) -> u8 {
    return __ffi_read_u8(ref self.storage, 8)
}

func set_flag(modify self: Cell, value: u8) {
    __ffi_write_u8(ref self.storage, 8, value)
}

enum Value_Kind {
    VK_INT = 1,
    VK_REAL = 2,
    VK_TEXT = 3,
    VK_NULL = 5
}


func value_kind(value: Value) -> i32 {
    let result = __value_kind(ref value)
    return result
}

func cell_flag(cell: Cell, raw: uint) -> u8 {
    let result = __cell_flag(ref cell.storage, raw)
    return result
}
