int32_t policy_n00b_bind_text_text_static(uint64_t stmt, const void *text, void *result) {
    size_t text_length = 0;
    const void *text_borrowed = n00b_ffi_borrow((void *)text, &text_length, 2);
    uint8_t *text_data = malloc(text_length + 1);
    if (text_data && text_length) {
        memcpy(text_data, text_borrowed, text_length);
    }
    if (text_data) {
        text_data[text_length] = 0;
    }
    n00b_ffi_release((void *)text);
    if (!text_data) {
        free(text_data);
        return POLICY_OUT_OF_MEMORY;
    }
    int32_t writ_n00b_value = policy_bind_text_text_static((stmt_state *)(uintptr_t)stmt, (const char *)text_data, text_length, (int *)result);
    return writ_n00b_value;
}

