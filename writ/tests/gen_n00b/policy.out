    policy_bytes_free(bytes);
}

int32_t policy_n00b_bind_text_text_static(uint64_t stmt, const void *text, void *result, uint64_t *text_kept) {
    size_t text_length = 0;
    const void *text_borrowed = n00b_ffi_borrow((void *)text, &text_length, 0);
    uint8_t *text_data = malloc(text_length + 1);
    if (text_data && text_length) {
        memcpy(text_data, text_borrowed, text_length);
    }
    if (text_data) {
        text_data[text_length] = 0;
