type Error {
    public code: i64
    public text: string?
    public fn: string
}

type Event layout(c) {
    public code: i32
}

callback Event_Handler {
    call(event: uint) -> nil
    handler(event: uint) -> nil
}

type Event_Handler_Arguments layout(c) {
    public event: uint
}

func __event_handler_invoke(value: Any, arguments: uint, result: uint) -> nil {
    typecase value {
        case Event_Handler {
            var packed: Event_Handler_Arguments
            __event_handler_arguments_copy(arguments, ref packed)
            value.call(packed.event)
        }
        else {
            panic("Event_Handler dispatched to a different callback type")
        }
    }
}

func bus_subscribe(handler: Event_Handler) -> u64 {
    let handler_handle = __ffi_callback_register(cast[Any]handler, ref __event_handler_invoke, false)
    let result = __bus_subscribe(handler_handle)
    let handler_group = __ffi_hold_group()
    __ffi_hold(handler_group, cast[u64](handler_handle), ref __ffi_callback_free, "callbacks:bus_unsubscribe", [cast[u64](result)]'array, 0)
    return result
}

func bus_publish(code: i32) fail: Error {
    let outcome = __bus_publish(code)
    if outcome < 0 {
        let failure: Error = (code = cast[i64]outcome, text = nil, fn = "bus_publish")
        fail failure
    }
}

func bus_unsubscribe(id: u64) fail: Error {
    let outcome = __bus_unsubscribe(id)
    if outcome < 0 {
        let failure: Error = (code = cast[i64]outcome, text = nil, fn = "bus_unsubscribe")
        fail failure
    }
    __ffi_event("callbacks:bus_unsubscribe", [cast[u64](id)]'array, __os_thread_id())
}
