when platform in [aarch64-apple-darwin] {
    use "draft/aarch64-apple-darwin.writ"
}
when platform in [aarch64-linux-gnu] {
    use "draft/aarch64-linux-gnu.writ"
}
when platform in [x86_64-linux-gnu] {
    use "draft/x86_64-linux-gnu.writ"
}

refine alloc_func {
    -> own ?void
}

refine zlibVersion {
    -> *cstr static
}

refine crc32 {
    buf: *[u8; len] null if empty
    pure
}

refine adler32 {
    buf: *[u8; len] null if empty
    pure
}

refine compressBound {
    pure
}

refine compress2 {
    dest: out *[u8; cap destLen.in, len destLen.out]
    destLen: inout *c_ulong
    source: *[u8; sourceLen]
    sizing needs compressBound(sourceLen)
    error ret != Z_OK via ret
}

refine uncompress {
    dest: out *[u8; cap destLen.in, len destLen.out]
    destLen: inout *c_ulong
    source: *[u8; sourceLen]
    error ret != Z_OK via ret
}

refine deflateInit_ {
    strm: inout *z_stream
    version: *cstr
    error ret != Z_OK via ret
}

refine deflateInit {
    strm: inout *z_stream
    error ret != Z_OK via ret
}

refine deflate {
    strm: inout *z_stream
    outcome progress success when ret == Z_OK
    outcome done success when ret == Z_STREAM_END
    outcome stalled failure when ret == Z_BUF_ERROR
    outcome failed failure via ret
}

refine deflateEnd {
    strm: inout *z_stream
    error ret != Z_OK via ret
}

refine inflateInit_ {
    strm: inout *z_stream
    version: *cstr
    error ret != Z_OK via ret
}

refine inflateInit {
    strm: inout *z_stream
    error ret != Z_OK via ret
}

refine inflate {
    strm: inout *z_stream
    outcome done success when ret == Z_STREAM_END
    outcome progress success when ret == Z_OK
    outcome stalled failure when ret == Z_BUF_ERROR
    outcome needs_dictionary failure when ret == Z_NEED_DICT
    outcome corrupt failure when ret == Z_DATA_ERROR via strm.msg
    outcome failed failure via ret
}

refine inflateEnd {
    strm: inout *z_stream
    error ret != Z_OK via ret
}
