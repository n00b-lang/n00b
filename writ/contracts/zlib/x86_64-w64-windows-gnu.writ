library zlib
link "z"
header <zlib.h>

opaque internal_state source "struct internal_state"
callback alloc_func = fn(p0: ?void, p1: c_uint, p2: c_uint) -> ?void unknown
callback free_func = fn(p0: ?void, p1: ?void)
struct z_stream @size(88) @align(8) {
    next_in: ?c_uchar @0
    avail_in: c_uint @8
    total_in: c_ulong @12
    next_out: ?c_uchar @16
    avail_out: c_uint @24
    total_out: c_ulong @28
    msg: ?c_char @32
    state: ?internal_state @40
    zalloc: alloc_func @48
    zfree: free_func @56
    opaque: ?void @64
    data_type: c_int @72
    adler: c_ulong @76
    reserved: c_ulong @80
}
type z_streamp = ?z_stream

const ZLIB_VERSION: *cstr = "1.3.2"
const ZLIB_VERNUM: c_int = 4896
const ZLIB_VER_MAJOR: c_int = 1
const ZLIB_VER_MINOR: c_int = 3
const ZLIB_VER_REVISION: c_int = 2
const ZLIB_VER_SUBREVISION: c_int = 0
const Z_NO_FLUSH: c_int = 0
const Z_PARTIAL_FLUSH: c_int = 1
const Z_SYNC_FLUSH: c_int = 2
const Z_FULL_FLUSH: c_int = 3
const Z_FINISH: c_int = 4
const Z_BLOCK: c_int = 5
const Z_TREES: c_int = 6
const Z_OK: c_int = 0
const Z_STREAM_END: c_int = 1
const Z_NEED_DICT: c_int = 2
const Z_ERRNO: c_int = -1
const Z_STREAM_ERROR: c_int = -2
const Z_DATA_ERROR: c_int = -3
const Z_MEM_ERROR: c_int = -4
const Z_BUF_ERROR: c_int = -5
const Z_VERSION_ERROR: c_int = -6
const Z_NO_COMPRESSION: c_int = 0
const Z_BEST_SPEED: c_int = 1
const Z_BEST_COMPRESSION: c_int = 9
const Z_DEFAULT_COMPRESSION: c_int = -1
const Z_FILTERED: c_int = 1
const Z_HUFFMAN_ONLY: c_int = 2
const Z_RLE: c_int = 3
const Z_FIXED: c_int = 4
const Z_DEFAULT_STRATEGY: c_int = 0
const Z_BINARY: c_int = 0
const Z_TEXT: c_int = 1
const Z_UNKNOWN: c_int = 2
const Z_DEFLATED: c_int = 8
const Z_NULL: c_int = 0

fn zlibVersion() -> ?c_char unknown
fn deflate(strm: unknown z_streamp, flush: c_int) -> c_int
fn deflateEnd(strm: unknown z_streamp) -> c_int
fn inflate(strm: unknown z_streamp, flush: c_int) -> c_int
fn inflateEnd(strm: unknown z_streamp) -> c_int
fn compress2(dest: unknown ?c_uchar, destLen: unknown ?c_ulong, source: ?c_uchar, sourceLen: c_ulong, level: c_int) -> c_int
fn compressBound(sourceLen: c_ulong) -> c_ulong
fn uncompress(dest: unknown ?c_uchar, destLen: unknown ?c_ulong, source: ?c_uchar, sourceLen: c_ulong) -> c_int
fn adler32(adler: c_ulong, buf: ?c_uchar, len: c_uint) -> c_ulong
fn crc32(crc: c_ulong, buf: ?c_uchar, len: c_uint) -> c_ulong
fn deflateInit_(strm: unknown z_streamp, level: c_int, version: ?c_char, stream_size: c_int) -> c_int
fn inflateInit_(strm: unknown z_streamp, version: ?c_char, stream_size: c_int) -> c_int
fn deflateInit(strm: unknown z_streamp, level: c_int) -> c_int
  expands deflateInit_(strm, level, ZLIB_VERSION, sizeof(z_stream))
fn inflateInit(strm: unknown z_streamp) -> c_int
  expands inflateInit_(strm, ZLIB_VERSION, sizeof(z_stream))
