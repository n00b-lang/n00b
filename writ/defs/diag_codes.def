WRIT_DIAG(SYNTAX, "E0001", WRIT_ERROR, "syntax error")
WRIT_DIAG(LEXICAL, "E0002", WRIT_ERROR, "invalid token")
WRIT_DIAG(UNREADABLE, "E0003", WRIT_ERROR, "cannot read file")
WRIT_DIAG(AMBIGUOUS, "E0004", WRIT_ERROR, "internal error: the grammar produced more than one parse")
WRIT_DIAG(DUPLICATE, "E0101", WRIT_ERROR, "duplicate declaration")
WRIT_DIAG(UNKNOWN_TYPE, "E0102", WRIT_ERROR, "unknown type")
WRIT_DIAG(UNKNOWN_NAME, "E0103", WRIT_ERROR, "unknown name")
WRIT_DIAG(NOT_CONSTANT, "E0104", WRIT_ERROR, "constant values must be integer expressions")
WRIT_DIAG(BAD_REFINE, "E0105", WRIT_ERROR, "a refinement may only add facts or narrow them")
WRIT_DIAG(REFINE_TARGET, "E0106", WRIT_ERROR, "`refine` names no function")
WRIT_DIAG(CONVENTION_TIE, "E0107", WRIT_ERROR, "two conventions match with the same literal prefix")
WRIT_DIAG(UNKNOWN_PLATFORM, "E0108", WRIT_ERROR, "unknown platform")
WRIT_DIAG(BAD_CONDITION, "E0109", WRIT_ERROR, "a condition tests platform facts, features and versions only")
WRIT_DIAG(UNKNOWN_SLOT, "E0110", WRIT_ERROR, "names no parameter of this function")
WRIT_DIAG(BAD_PHASE, "E0201", WRIT_ERROR, "`.in` and `.out` apply only to inout parameters")
WRIT_DIAG(EXTENT_NOT_INTEGER, "E0202", WRIT_ERROR, "array extents must be integers")
WRIT_DIAG(CALL_NOT_PURE, "E0203", WRIT_ERROR, "expressions may only call functions declared pure")
WRIT_DIAG(SIZING_WITHOUT_OUTPUT, "E0204", WRIT_ERROR, "sizing applies to a function with a bounded output array")
WRIT_DIAG(OUT_NEEDS_BOUND, "E0205", WRIT_ERROR, "an out array needs a count or `cap ..., len ...`")
WRIT_DIAG(BOUND_CELL, "E0206", WRIT_ERROR, "a bounded array's capacity and length must use one inout integer parameter")
WRIT_DIAG(BAD_ARITY, "E0207", WRIT_ERROR, "wrong number of arguments")
WRIT_DIAG(OUTCOMES_OPEN, "E0208", WRIT_ERROR, "the last outcome must have no predicate")
WRIT_DIAG(ERROR_AND_OUTCOMES, "E0209", WRIT_ERROR, "a function states either `error` or `outcome` clauses, not both")
WRIT_DIAG(LAYOUT_MISMATCH, "E0210", WRIT_ERROR, "the asserted layout does not match the platform's C layout")
WRIT_DIAG(PROMOTED_VARARG, "E0211", WRIT_ERROR, "variadic arguments undergo default promotions; use `c_int` or `f64`")
WRIT_DIAG(RETURN_NEEDS_SPAN, "E0212", WRIT_ERROR, "a returned pointer needs `own`, a span, or `unknown`")
WRIT_DIAG(BAD_NONE_VALUE, "E0213", WRIT_ERROR, "a `none` value must be a constant of the handle's type")
WRIT_DIAG(FORMAT_NOT_TEXT, "E0214", WRIT_ERROR, "`format printf` names a `*cstr` parameter of a variadic function")
WRIT_DIAG(ON_UNKNOWN_OUTCOME, "E0215", WRIT_ERROR, "`on` names no outcome of this function")
WRIT_DIAG(UNSUPPORTED, "E0901", WRIT_ERROR, "not supported yet")
