WRIT_DIAG(SYNTAX, "E0001", WRIT_ERROR, "syntax error")
WRIT_DIAG(LEXICAL, "E0002", WRIT_ERROR, "invalid token")
WRIT_DIAG(UNREADABLE, "E0003", WRIT_ERROR, "cannot read file")
WRIT_DIAG(AMBIGUOUS, "E0004", WRIT_ERROR, "internal error: the grammar produced more than one parse")
WRIT_DIAG(DUPLICATE, "E0101", WRIT_ERROR, "duplicate declaration")
WRIT_DIAG(UNKNOWN_TYPE, "E0102", WRIT_ERROR, "unknown type")
WRIT_DIAG(UNKNOWN_NAME, "E0103", WRIT_ERROR, "unknown name")
WRIT_DIAG(NOT_CONSTANT, "E0104", WRIT_ERROR, "constant values must be integer expressions")
WRIT_DIAG(BAD_PHASE, "E0201", WRIT_ERROR, "`.in` and `.out` apply only to inout parameters")
WRIT_DIAG(EXTENT_NOT_INTEGER, "E0202", WRIT_ERROR, "array extents must be integers")
WRIT_DIAG(CALL_NOT_PURE, "E0203", WRIT_ERROR, "expressions may only call functions declared pure")
WRIT_DIAG(SIZING_WITHOUT_OUTPUT, "E0204", WRIT_ERROR, "sizing applies to a function with a bounded output array")
WRIT_DIAG(OUT_NEEDS_BOUND, "E0205", WRIT_ERROR, "an out array needs `cap ..., len ...`")
WRIT_DIAG(BOUND_CELL, "E0206", WRIT_ERROR, "a bounded array's capacity and length must use one inout integer parameter")
WRIT_DIAG(BAD_ARITY, "E0207", WRIT_ERROR, "wrong number of arguments")
WRIT_DIAG(UNSUPPORTED, "E0901", WRIT_ERROR, "not supported yet")
