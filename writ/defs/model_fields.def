WRIT_ENUM(writ_type_kind_t, WRIT_TYPE_VOID, WRIT_TYPE_INT, WRIT_TYPE_FLOAT, WRIT_TYPE_BOOL, WRIT_TYPE_POINTER, WRIT_TYPE_ARRAY, WRIT_TYPE_OPAQUE)
WRIT_ENUM(writ_mode_t, WRIT_MODE_IN, WRIT_MODE_OUT, WRIT_MODE_INOUT, WRIT_MODE_CONSUME, WRIT_MODE_KEEP, WRIT_MODE_MOVED, WRIT_MODE_UNKNOWN)
WRIT_ENUM(writ_extent_kind_t, WRIT_EXTENT_NONE, WRIT_EXTENT_COUNT, WRIT_EXTENT_BOUNDED)
WRIT_ENUM(writ_plan_role_t, WRIT_ROLE_INPUT, WRIT_ROLE_OUTPUT, WRIT_ROLE_INPUT_OUTPUT, WRIT_ROLE_RESULT, WRIT_ROLE_ERROR_DETAIL, WRIT_ROLE_PACK)
WRIT_ENUM(writ_plan_shape_t, WRIT_SHAPE_SCALAR, WRIT_SHAPE_VIEW, WRIT_SHAPE_HANDLE, WRIT_SHAPE_OPTIONAL, WRIT_SHAPE_BYTES, WRIT_SHAPE_TEXT, WRIT_SHAPE_ARRAY, WRIT_SHAPE_RECORD, WRIT_SHAPE_REST_PACK, WRIT_SHAPE_KEYWORD_PACK)
WRIT_ENUM(writ_after_call_t, WRIT_AFTER_NONE, WRIT_AFTER_BORROWED, WRIT_AFTER_CALLER_OWNS, WRIT_AFTER_CALLEE_OWNS, WRIT_AFTER_BORROWED_UNTIL, WRIT_AFTER_BORROWED_WITH, WRIT_AFTER_STATIC)
WRIT_ENUM(writ_pass_t, WRIT_PASS_VALUE, WRIT_PASS_IN_POINTER, WRIT_PASS_OUT_POINTER, WRIT_PASS_INOUT_POINTER, WRIT_PASS_VARIADIC_TAIL)
WRIT_ENUM(writ_part_t, WRIT_PART_WHOLE, WRIT_PART_POINTER, WRIT_PART_LENGTH, WRIT_PART_CAPACITY, WRIT_PART_CAPACITY_AND_LENGTH, WRIT_PART_ELEMENTS)
WRIT_ENUM(writ_local_kind_t, WRIT_LOCAL_BUFFER, WRIT_LOCAL_CELL, WRIT_LOCAL_TEXT)
WRIT_ENUM(writ_step_kind_t, WRIT_STEP_CHECK, WRIT_STEP_PASS, WRIT_STEP_SPLIT, WRIT_STEP_ENCODE_CSTR, WRIT_STEP_EXPAND, WRIT_STEP_ALLOC_OUT, WRIT_STEP_BIND_OUT, WRIT_STEP_CALL, WRIT_STEP_SIZE_QUERY, WRIT_STEP_SIZE_RETRY, WRIT_STEP_CLASSIFY, WRIT_STEP_FETCH_DETAIL, WRIT_STEP_LIFT_VALUE, WRIT_STEP_LIFT_BUFFER, WRIT_STEP_WRAP_HANDLE, WRIT_STEP_COPY_BORROWED, WRIT_STEP_MARK_CONSUMED, WRIT_STEP_RELEASE_LOCAL)
WRIT_ENUM(writ_phase_t, WRIT_PHASE_PREPARE, WRIT_PHASE_ATTEMPT, WRIT_PHASE_CLASSIFY, WRIT_PHASE_OUTCOME, WRIT_PHASE_FINALLY)
WRIT_ENUM(writ_outcome_kind_t, WRIT_OUTCOME_SUCCESS, WRIT_OUTCOME_FAILURE)
WRIT_ENUM(writ_language_t, WRIT_LANGUAGE_C)

WRIT_VIEW(type)
WRIT_FIELD(type, uint32_t, kind)
WRIT_FIELD(type, writ_str_t, name)
WRIT_FIELD(type, writ_str_t, c_spelling)
WRIT_FIELD(type, uint32_t, size)
WRIT_FIELD(type, uint32_t, align)
WRIT_FIELD(type, bool, is_signed)
WRIT_FIELD(type, bool, nullable)
WRIT_REF(type, type, target)
WRIT_END(type)

WRIT_VIEW(const)
WRIT_FIELD(const, writ_str_t, name)
WRIT_REF(const, type, type)
WRIT_FIELD(const, int64_t, value)
WRIT_FIELD(const, writ_span_t, declared_at)
WRIT_END(const)

WRIT_VIEW(slot)
WRIT_FIELD(slot, writ_str_t, name)
WRIT_REF(slot, type, type)
WRIT_FIELD(slot, uint32_t, mode)
WRIT_FIELD(slot, uint32_t, extent_kind)
WRIT_FIELD(slot, uint32_t, count_expr)
WRIT_FIELD(slot, uint32_t, cap_expr)
WRIT_FIELD(slot, uint32_t, len_expr)
WRIT_FIELD(slot, writ_span_t, declared_at)
WRIT_END(slot)

WRIT_VIEW(fn)
WRIT_FIELD(fn, writ_str_t, contract_name)
WRIT_FIELD(fn, writ_str_t, link_symbol)
WRIT_ARRAY(fn, slot, slots)
WRIT_REF(fn, type, result)
WRIT_FIELD(fn, bool, is_pure)
WRIT_FIELD(fn, uint32_t, sizing_expr)
WRIT_FIELD(fn, uint32_t, error_expr)
WRIT_FIELD(fn, uint32_t, via_expr)
WRIT_FIELD(fn, writ_span_t, declared_at)
WRIT_END(fn)

WRIT_VIEW(library)
WRIT_FIELD(library, writ_str_t, name)
WRIT_LIST(library, writ_str_t, links)
WRIT_LIST(library, writ_str_t, headers)
WRIT_END(library)

WRIT_VIEW(plan_item)
WRIT_FIELD(plan_item, writ_str_t, name)
WRIT_FIELD(plan_item, uint32_t, role)
WRIT_FIELD(plan_item, uint32_t, shape)
WRIT_FIELD(plan_item, uint32_t, after_call)
WRIT_REF(plan_item, type, type)
WRIT_FIELD(plan_item, uint32_t, contract_slot)
WRIT_END(plan_item)

WRIT_VIEW(plan_slot)
WRIT_REF(plan_slot, type, c_type)
WRIT_FIELD(plan_slot, uint32_t, pass)
WRIT_FIELD(plan_slot, uint32_t, part)
WRIT_FIELD(plan_slot, uint32_t, item)
WRIT_FIELD(plan_slot, uint32_t, contract_slot)
WRIT_END(plan_slot)

WRIT_VIEW(plan_local)
WRIT_FIELD(plan_local, uint32_t, kind)
WRIT_REF(plan_local, type, type)
WRIT_FIELD(plan_local, uint32_t, item)
WRIT_FIELD(plan_local, uint32_t, capacity_expr)
WRIT_FIELD(plan_local, uint32_t, capacity_item)
WRIT_END(plan_local)

WRIT_VIEW(plan_step)
WRIT_FIELD(plan_step, uint32_t, kind)
WRIT_FIELD(plan_step, uint32_t, phase)
WRIT_FIELD(plan_step, uint32_t, outcome)
WRIT_FIELD(plan_step, uint32_t, item)
WRIT_FIELD(plan_step, uint32_t, slot)
WRIT_FIELD(plan_step, uint32_t, second_slot)
WRIT_FIELD(plan_step, uint32_t, local)
WRIT_FIELD(plan_step, uint32_t, source_local)
WRIT_FIELD(plan_step, uint32_t, expr)
WRIT_END(plan_step)

WRIT_VIEW(plan_outcome)
WRIT_FIELD(plan_outcome, writ_str_t, name)
WRIT_FIELD(plan_outcome, uint32_t, kind)
WRIT_FIELD(plan_outcome, uint32_t, when_expr)
WRIT_FIELD(plan_outcome, uint32_t, via_expr)
WRIT_FIELD(plan_outcome, bool, retry)
WRIT_END(plan_outcome)

WRIT_VIEW(plan)
WRIT_REF(plan, fn, fn)
WRIT_ARRAY(plan, plan_item, items)
WRIT_ARRAY(plan, plan_slot, slots)
WRIT_ARRAY(plan, plan_local, locals)
WRIT_ARRAY(plan, plan_step, steps)
WRIT_ARRAY(plan, plan_outcome, outcomes)
WRIT_END(plan)
