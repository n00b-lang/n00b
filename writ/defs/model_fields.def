WRIT_ENUM(writ_type_kind_t, WRIT_TYPE_VOID, WRIT_TYPE_INT, WRIT_TYPE_FLOAT, WRIT_TYPE_BOOL, WRIT_TYPE_POINTER, WRIT_TYPE_ARRAY, WRIT_TYPE_OPAQUE, WRIT_TYPE_RECORD, WRIT_TYPE_ENUM, WRIT_TYPE_HANDLE, WRIT_TYPE_CSTR, WRIT_TYPE_VA_LIST, WRIT_TYPE_CALLBACK, WRIT_TYPE_VIEW, WRIT_TYPE_INLINE)
