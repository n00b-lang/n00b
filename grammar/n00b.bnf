@lexer("n00b.lex")
@declaration_point("after_initializer")
@statement_end("NEWLINE", ";")
@continue_after("(", "[", "{")

<module> @scope("module") ::= <other-top-stmts>? <eos>*

<eos> ::= %NEWLINE | %";"

<block-start> @trivia_indent($1) ::= %"{" <eos>*
<block-start> @trivia_indent($1) ::= %":" %NEWLINE %INDENT
<block-end> @trivia_indent($0) ::= <eos>* %"}"
<block-end> @trivia_indent($0) ::= <eos>* %DEDENT

<other-top-stmts> @hardline ::= <eos>* <top-level-stmt> (<eos>+ <top-level-stmt>)*

<top-level-stmt> ::=  <enum-stmt>
                   | <flagset-stmt>
                   | <if-stmt>
                   | <for-stmt>
                   | <while-stmt>
                   | <when-stmt>
                   | <typecase-stmt>
                   | <switch-stmt>
                   | <try-stmt>
                   | <func-def>
                   | <context-def>
                   | <with-stmt>
                   | <variable-decl>
                   | <labeled-for>
                   | <labeled-while>
                   | <labeled-typecase>
                   | <labeled-switch>
                   | <assert-stmt>
                   | <import-stmt>
                   | <visible-inferred-assign>
                   | <discard-stmt>
                   | <assign-stmt>
                   | <binop-assign-stmt>
                   | <expression-stmt>
                   | <alias-stmt>
                   | <type-decl>
                   | <record-decl>
                   | <variant-decl>
                   | <trait-decl>
                   | <callback-decl>
                   | <package-decl>

<body> @scope("block") @hardline($1) @indent($1) @hardline($2) ::= <block-start> <body-stmts>? <block-end>
<block> ::= <body>
<body-stmts> @infer("$0") ::= <value-stmt>
<body-stmts>              ::= <body-stmt-list>
<body-stmts> @infer("$2") ::= <body-stmt-list> <eos>+ <value-stmt>
<body-stmt-list> @hardline ::= <body-stmt> (<eos>+ <body-stmt>)*
<body-stmt>            ::=  <block>
                         | <if-stmt>
                         | <for-stmt>
                         | <while-stmt>
                         | <when-stmt>
                         | <typecase-stmt>
                         | <switch-stmt>
                         | <try-stmt>
                         | <with-stmt>
                         | <continue-stmt>
                         | <break-stmt>
                         | <return-stmt>
                         | <fail-stmt>
                         | <variable-decl>
                         | <labeled-for>
                         | <labeled-while>
                         | <labeled-typecase>
                         | <labeled-switch>
                         | <assert-stmt>
                         | <import-stmt>
                         | <export-stmt>
                         | <discard-stmt>
                         | <assign-stmt>
                         | <binop-assign-stmt>
                         | <pass-stmt>
                         | <expression-stmt>

<pass-stmt> ::= %"pass"

<label> ::= %IDENTIFIER %":"

<labeled-for> ::= <label> <for-stmt>
<labeled-while> ::= <label> <while-stmt>
<labeled-typecase> ::= <label> <typecase-stmt>
<labeled-switch> ::= <label> <switch-stmt>

<if-stmt> @scope("if") @branch($1, $2, $3) ::= %"if" <expression> <body> <elif-chain>

<elif-chain> ::= (<eos>* <elif-clause>)* (<eos>* <else-clause>)?

<elif-clause> @branch($1, $2) ::= %"elif" <expression> <body>
<else-clause> ::= %"else" <body>

<if-value-expr> @scope("if") @branch($1, $2, $3) @infer("$2 unify $3") ::=
       %"if" <expression> <value-body> <value-elif-chain>

<value-body> @scope("block") @infer("$1") @hardline($1) @indent($1) @hardline($2) ::=
       <block-start> <value-body-stmts> <block-end>

<value-body-stmts> @infer("$0") ::= <value-stmt>
<value-body-stmts> @infer("$2") ::= <body-stmt-list> <eos>+ <value-stmt>

<value-elif-chain> @infer("$1") ::= <eos>* <value-else-clause>
<value-elif-chain> @infer("$1 unify $2") ::=
       <eos>* <value-elif-clause> <value-elif-chain>

<value-elif-clause> @branch($1, $2) @infer("$2") ::= %"elif" <expression> <value-body>
<value-else-clause> @infer("$1") ::= %"else" <value-body>

<for-stmt> @scope("for") @loop($3, $4) @infer("`t unify element_of(method_return(method_return($3, iter), next))") ::=
       %"for" <for-var-list> %"in" <for-in-target-list> <body>

<for-stmt> @scope("for") @loop($3, $4) @infer("$1 unify $3") ::=
       %"for" <for-range-var> %"from" <range-loop> <body>

<for-range-var> ::= <for-binding>
<for-var-list> ::= <for-binding>
<for-var-list> ::= <for-binding> %"," <for-var-list>

<for-binding> @declares($0) @infer("`t") ::= %IDENTIFIER
<for-binding> @declares($1) @infer("`t") ::= %"let" %IDENTIFIER
<for-binding> @declares($0, $2) @infer("$0 unify $2") ::=
       %IDENTIFIER %":" <type-spec>
<for-binding> @declares($1, $3) @infer("$1 unify $3") ::=
       %"let" %IDENTIFIER %":" <type-spec>

<for-in-target-list> ::= <expression>

<while-stmt> @scope("while") @loop($1, $2) ::= %"while" <expression> <body>

<member-chain> @nospace ::= <member-chain> %"." %IDENTIFIER
<member-chain> @varref($0) @infer("lookup($0)") ::= %IDENTIFIER

<when-stmt> ::= %"when" <expression> <body> <else-when-clause>* <ctime-else>?
<else-when-clause> ::= %"else" %"when" <expression> <body>
<ctime-else> ::= %"else" <body>

<typecase-stmt> @scope("typecase") @switch($1, $3) @hardline($3) @indent($3) @hardline($4) ::=
       %"typecase" <expression> <block-start> <typecase-cases> <block-end>

<typecase-cases> @hardline($2) ::= (<eos>* %"case" <typecase-case-block>)+ <eos>* <case-else>?

<typecase-case-block> ::= <type-spec-list> <body>

<typecase-value-expr> @scope("typecase") @switch($1, $3) @infer("$3") @hardline($3) @indent($3) @hardline($4) ::=
       %"typecase" <expression> <block-start> <typecase-value-cases> <block-end>

<typecase-value-cases> @infer("$0") ::= <typecase-value-branch-list>
<typecase-value-cases> @infer("$0 unify $1") @hardline($1) ::=
       <typecase-value-branch-list> <typecase-value-else>

<typecase-value-branch-list> @infer("$0") ::= <typecase-value-case-prefix>
<typecase-value-branch-list> @infer("$0 unify $1") @hardline($1) ::=
       <typecase-value-case-prefix> <typecase-value-branch-list>

<typecase-value-case-prefix> @infer("$2") ::=
       <eos>* %"case" <typecase-value-case-block>

<typecase-value-case-block> @infer("$1") ::= <type-spec-list> <value-body>

<typecase-value-else> @infer("$2") ::= <eos>* %"else" <value-body>

<type-spec-list> ::= <type-spec> (%"," <type-spec>)* %","?

<try-stmt> @scope("try") ::= %"try" <try-body> <try-error-clause>
<try-body> @scope("block") ::= <block-start> <try-body-stmts>? <block-end>
<try-body-stmts> ::= <value-stmt>
                    | <body-stmt-list>
                    | <body-stmt-list> <eos>+ <value-stmt>
<try-error-clause> @scope("try-error") ::=
       %"else" <try-error-binding> <body>
<try-error-binding> @declares($0, "error") ::= %IDENTIFIER
<try-error-binding> @declares($0, $2, "error") @infer("$0 unify $2") ::=
       %IDENTIFIER %":" <type-spec>

<try-value-expr> @scope("try") @infer("$1 unify $2") ::=
       %"try" <value-body> <try-value-error-clause>
<try-value-error-clause> @scope("try-error") @infer("$2") ::=
       %"else" <try-error-binding> <value-body>

# Using the `type` keyword creates a 'brand new' type, meaning that
# name equiv is required for there to be equal types.
# The `alias` keyword here means that we have one type, with multiple names.

<alias-stmt> @namespace("type") @scope("type", $2) @type($2) @exposes ::=
       <member-visibility>? %"alias" %IDENTIFIER <assign-op> <type-spec>
     | <member-visibility>? %"type" %IDENTIFIER <assign-op> <type-spec>
     | <member-visibility>? %"record" %IDENTIFIER <assign-op> <type-spec>

<context-def> @scope("context", $2) @declares($2) ::=
       <member-visibility>? %"context" %IDENTIFIER <param-decl> <context-spec> <context-body>

<context-spec> ::= <provides-clause>? <error-type>?
<provides-clause> ::= %"provides" %":" <type-spec>

<context-body> ::= <block-start> <context-hooks>? <block-end>
<context-hooks> ::= <context-hook> (<eos>+ <context-hook>)*

<context-hook> ::= <pass-stmt>
                 | <context-enter>
                 | <context-exit>
                 | <context-error>
                 | <context-ensure>

<context-enter> @scope("context-hook") ::= %"enter" %"(" %")" <body>
<context-exit> @scope("context-hook") ::= %"exit" <context-hook-params> <body>
<context-error> @scope("context-hook") ::= %"error" <context-hook-params> <body>
<context-ensure> @scope("context-hook") ::= %"ensure" <context-hook-params> <body>

<context-hook-params> ::= %"(" <pos-param>? %")"

<with-stmt> @scope("with") ::= %"with" <context-manager> (%"," <context-manager>)* %","? <body>
<context-manager> @declares($0, $2) @assigns($0, $4) @infer("$0 unify $4") ::=
       %IDENTIFIER %":" <type-spec> <assign-op> <context-call>
<context-manager> @declares($0) @assigns($0, $2) @infer("$0 unify $2") ::=
       %IDENTIFIER <assign-op> <context-call>
<context-manager> ::= <context-call>
<context-call> @emit("call") @infer("return_of($0)") @call($0, $2) ::=
       <member-chain> %"(" <call-args> %")"
<context-call> @emit("call") @infer("return_of($0)") @call($0) ::=
       <member-chain> %"(" %")"

<switch-stmt> @scope("switch") @switch($1, $3) @infer("$1 unify $3") @hardline($3) @indent($3) @hardline($4) ::=
       %"switch" <expression> <block-start> <switch-cases> <block-end>

<switch-cases> @hardline($2) ::= <branch-list> <eos>* <case-else>?

<branch-list> @infer("$2") ::= <eos>* %"case" <switch-case-block>
<branch-list> @infer("$2 unify $3") @hardline($3) ::=
       <eos>* %"case" <switch-case-block> <branch-list>

<switch-case-block> ::= <case-expr-list> <body>

<case-expr-list> @infer("$0") ::= <case-expr-item>

<case-expr-list> @infer("$0 unify $2") ::=
           <case-expr-item> %"," <case-expr-list>
<case-expr-list> @infer("$0") ::= <case-expr-item> %","

<case-expr-item> @infer("$0 unify $2") ::= <expression> <range-sep> <expression>
<case-expr-item> @infer("$0")             ::= <expression>

<case-else> ::= %"else" <body>

<switch-value-expr> @scope("switch") @switch($1, $3) @infer("$3") @hardline($3) @indent($3) @hardline($4) ::=
       %"switch" <expression> <block-start> <switch-value-cases> <block-end>

<switch-value-cases> @infer("$0 unify $1") @hardline($1) ::=
       <switch-value-branch-list> <switch-value-else>

<switch-value-branch-list> @infer("$0") ::= <switch-value-case-prefix>
<switch-value-branch-list> @infer("$0 unify $1") @hardline($1) ::=
       <switch-value-case-prefix> <switch-value-branch-list>

<switch-value-case-prefix> @infer("$2") ::= <eos>* %"case" <switch-value-case-block>

<switch-value-case-block> @infer("$1") ::= <case-expr-list> <value-body>

<switch-value-else> @infer("$2") ::= <eos>* %"else" <value-body>

<range> @infer("$0") ::= <range-parts>
<range-parts> @infer("$0 unify $2") ::= <expression> <range-sep> <expression>
<range-loop> @infer("$0") ::= <range-parts> <range-step>?
<range-step> ::= %"step" <expression>
<range-sep> ::= %"to"
              | %"until"
              | %".."
              | %":"

<break-stmt> @jump("break") ::= %"break" %IDENTIFIER?
<continue-stmt> @jump("continue") ::= %"continue" %IDENTIFIER?
<return-stmt> @jump("return") @emit("return", $1) @infer("$1") ::= %"return" <expression>
<return-stmt> @jump("return") @emit("return") ::= %"return"
<fail-stmt> @jump("fail") @infer("$1") ::= %"fail" <expression>
<value-stmt> @jump("value") @infer("$1") ::= <assign-op> <expression>

<assert-stmt> ::= (%"assert"|%"require") <expression>

<import-stmt> @declares($1, "module") ::= %"import" <member-chain> (%"from" %STRING_LIT)?

<package-decl> ::= %"package" <dotted-name> <package-body>
<package-body> ::= <block-start> <package-items>? <block-end>
<package-items> ::= <package-item> (<eos>+ <package-item>)*
<package-item> ::= <export-stmt> | <when-stmt> | <pass-stmt>
<export-stmt> ::= %"export" <dotted-name> (<export-alias>)? (<export-grantee>)?
<export-stmt> ::= %"export" %"package" <dotted-name>
<export-alias> ::= %"as" %IDENTIFIER
<export-grantee> ::= %"to" <dotted-name>
<dotted-name> ::= <dotted-name> %"." %IDENTIFIER | %IDENTIFIER

<variable-decl> ::= <variable-visibility>? <declaration-prefix> <sym-decl-list>

<variable-visibility> @visibility("public") ::= %"public"
<variable-visibility> @visibility("private") ::= %"private"

<visible-inferred-assign> @visibility("public") ::= %"public" <assign-stmt>
<visible-inferred-assign> @visibility("private") ::= %"private" <assign-stmt>

<declaration-prefix> ::= <storage-class>? <binding-kind>
<storage-class> ::= %"thread"
<binding-kind> ::= %"var" | %"let" | %"const"

<sym-decl-list> ::= <sym-decl> %"," <sym-decl-list>
                  | <sym-decl>

<sym-decl> @declares($0, $2) @assigns($0, $4) @infer("$4 converts ($0 unify $2)") @nospace($1) ::=
         %IDENTIFIER %":" <type-spec> <assign-op> <expression>
<sym-decl> @declares($0, $2) @infer("$0 unify $2") @nospace($1) ::= %IDENTIFIER %":" <type-spec>
<sym-decl> @declares($0) @assigns($0, $2) @infer("$0 unify $2") ::= %IDENTIFIER <assign-op> <expression>
<sym-decl> @declares($0) ::= %IDENTIFIER

<assign-op> ::= %"="

<func-def> @scope("function", $1) @declares($1, "function") @nospace($2) @align($2) ::=
    <func-prelude> %IDENTIFIER <func-type-signature> <body>
<func-def> @scope("function", $1) @declares($1, "function") @nospace($3) @align($3) ::=
    <litmod-prelude> %IDENTIFIER <litmod-aliases>? <func-type-signature> <body>

<litmod-prelude> @nospace($1) @nospace($2) @nospace($3) ::= %"litmod" %"<" <litmod-kind> %">"
<litmod-kind> ::= %IDENTIFIER | %"record" | %"nil"
<litmod-aliases> ::= %"," %IDENTIFIER (%"," %IDENTIFIER)*

<member-visibility> @visibility("public") ::= %"public"
<member-visibility> @visibility("private") ::= %"private"

<func-visibility> @visibility("public") ::= %"public"
<func-visibility> @visibility("private") ::= %"private"

<func-prelude> ::= %"func"
<func-prelude> ::= <func-visibility> %"func"
<func-prelude> ::= <func-inline> %"func"
<func-prelude> ::= <func-visibility> <func-inline> %"func"
<func-inline> ::= %"inline"
<func-type-signature> @newline($1) ::=
    <param-decl> <function-result>? <where-clause>?

<param-decl> @group @nospace($0) @nospace($1) @nospace($2) ::= %"(" <formals>? %")"

<formals> @newline @nospace($1) @nospace($2) @nospace($3) ::=
    <required-params> (%"," <default-params>)? (%"," <vargs-param>)? %","?
<formals> @newline @nospace($1) @nospace($2) ::=
    <default-params> (%"," <vargs-param>)? %","?
<formals> @nospace($1) ::= <vargs-param> %","?

<required-params> @newline @nospace($1) ::= <pos-param> (%"," <pos-param>)*
<default-params> @newline @nospace($1) ::= <default-param> (%"," <default-param>)*

<pos-param> @declares($0, "param") @direction($0, "in") @pass_by("in") ::=
    %IDENTIFIER
<pos-param> @declares($0, $2, "param") @direction($0, "in") @pass_by("in") @nospace($1) ::=
    %IDENTIFIER %":" <type-spec>
<pos-param> @declares($1, "param") @direction($1, "out") @pass_by("out") ::=
    %"out" %IDENTIFIER
<pos-param> @declares($1, $3, "param") @direction($1, "out") @pass_by("out") @nospace($2) ::=
    %"out" %IDENTIFIER %":" <type-spec>
<pos-param> @declares($1, "param") @direction($1, "modify") @pass_by("inout") ::=
    %"modify" %IDENTIFIER
<pos-param> @declares($1, $3, "param") @direction($1, "modify") @pass_by("inout") @nospace($2) ::=
    %"modify" %IDENTIFIER %":" <type-spec>
<pos-param> @declares($1, "param") @direction($1, "consume") @pass_by("consume") ::=
    %"consume" %IDENTIFIER
<pos-param> @declares($1, $3, "param") @direction($1, "consume") @pass_by("consume") @nospace($2) ::=
    %"consume" %IDENTIFIER %":" <type-spec>

<default-param> @declares($0, "param") @direction($0, "in") @pass_by("in") @infer("$0 unify $2") ::=
                %IDENTIFIER <assign-op> <expression>
<default-param> @declares($0, $2, "param") @direction($0, "in") @pass_by("in") @infer("$0 unify $2") ::=
                %IDENTIFIER %":" <type-spec> <assign-op> <expression>
<default-param> @declares($1, "param") @direction($1, "consume") @pass_by("consume") @infer("$1 unify $3") ::=
                %"consume" %IDENTIFIER <assign-op> <expression>
<default-param> @declares($1, $3, "param") @direction($1, "consume") @pass_by("consume") @infer("$1 unify $3") ::=
                %"consume" %IDENTIFIER %":" <type-spec> <assign-op> <expression>

<vargs-param> @declares($1, $3, "param") @direction($1, "in") @pass_by("in") ::=
    %"*" %IDENTIFIER %":" <type-spec>
<vargs-param> @declares($1, "param") @direction($1, "in") @pass_by("in") ::=
    %"*" %IDENTIFIER
<vargs-param> @declares($2, $4, "param") @direction($2, "modify") @pass_by("inout") ::=
    %"modify" %"*" %IDENTIFIER %":" <type-spec>
<vargs-param> @declares($2, "param") @direction($2, "modify") @pass_by("inout") ::=
    %"modify" %"*" %IDENTIFIER
<vargs-param> @declares($2, $4, "param") @direction($2, "consume") @pass_by("consume") ::=
    %"consume" %"*" %IDENTIFIER %":" <type-spec>
<vargs-param> @declares($2, "param") @direction($2, "consume") @pass_by("consume") ::=
    %"consume" %"*" %IDENTIFIER

<function-result> ::= <return-type>? <error-type>?

<return-type> ::= <return-sigil> <union-tspec>

<return-sigil> ::= %"->"
                 | %"return" %":"

<error-type> @nospace($1) ::= %"fail" %":" <one-tspec>

<enum-stmt> @namespace("type") @scope("enum", $1) @type($1) @exposes ::= <enum-prefix> %IDENTIFIER <block-start> <enum-items> <block-end>

<enum-prefix> ::= <member-visibility>? %"enum"

<enum-items> @nospace($1) @nospace($2) ::= <enum-item> (<eos>* %"," <eos>* <enum-item>)* (<eos>* %",")?

<enum-item> @declares($0) ::= %IDENTIFIER <enum-value>
<enum-item> @declares($0) ::= %IDENTIFIER

<enum-value> ::= <assign-op> <simple-lit>
               | <assign-op> %"-" <simple-lit>

<flagset-stmt> @namespace("type") @scope("flagset", $1) @type($1) @exposes ::=
    <flagset-prefix> %IDENTIFIER <block-start> <flagset-items> <block-end>

<flagset-prefix> ::= <member-visibility>? %"flagset"

<flagset-items> @nospace($1) @nospace($2) ::= <flagset-item> (<eos>* %"," <eos>* <flagset-item>)* (<eos>* %",")?

<flagset-item> @declares($0) ::= %IDENTIFIER
<flagset-item> @declares($0) ::= %IDENTIFIER <assign-op> <flagset-value>

<flagset-value> ::= <flagset-union>
<flagset-union> ::= <flagset-union> <plus-op> <flagset-xor>
                  | <flagset-union> <minus-op> <flagset-xor>
                  | <flagset-union> <pipe-op> <flagset-xor>
                  | <flagset-xor>
<flagset-xor> ::= <flagset-xor> <xor-op> <flagset-intersection>
                | <flagset-intersection>
<flagset-intersection> ::= <flagset-intersection> <amp-op> <flagset-unary>
                         | <flagset-unary>
<flagset-unary> ::= %"~" <flagset-unary>
                  | <flagset-primary>
<flagset-primary> ::= %"nil"
                    | <flagset-name>
                    | %"(" <flagset-value> %")"
<flagset-name> @varref($0) ::= %IDENTIFIER

<assign-stmt> @assigns($0, $2) @infer("$2 converts $0") ::= <expression> <assign-op> <expression>
<discard-stmt> ::= %_ <assign-op> <expression>

<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __add, __add_assign)") ::= <expression> <plus-assign-op> <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __subtract, __subtract_assign)") ::= <expression> <minus-assign-op> <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __multiply, __multiply_assign)") ::= <expression> <multiply-assign-op> <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __divide, __divide_assign)") ::= <expression> <divide-assign-op> <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __remainder, __remainder_assign)") ::= <expression> <remainder-assign-op> <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __bit_and, __bit_and_assign)") ::= <expression> <amp-assign-op> <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __bit_or, __bit_or_assign)") ::= <expression> <pipe-assign-op> <expression>
