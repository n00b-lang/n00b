@lexer("n00b.lex")

<module> @scope("module") ::= <other-top-stmts>? <eos>*

<eos> ::= %NEWLINE | %";"

<block-start> ::= %"{" <eos>*
                | %":" %NEWLINE %INDENT
<block-end> ::= <eos>* %"}"
              | %DEDENT

<other-top-stmts> ::= <eos>* <top-level-stmt> (<eos>+ <top-level-stmt>)*

<top-level-stmt> ::=  <enum-stmt>
                   | <if-stmt>
                   | <for-stmt>
                   | <while-stmt>
                   | <when-stmt>
                   | <typecase-stmt>
                   | <switch-stmt>
                   | <try-stmt>
                   | <func-def>
                   | <context-def>
                   | <with-stmt>
                   | <comptime-stmt>
                   | <variable-decl>
                   | <labeled-for>
                   | <labeled-while>
                   | <labeled-typecase>
                   | <labeled-switch>
                   | <assert-stmt>
                   | <import-stmt>
                   | <visible-inferred-assign>
                   | <assign-stmt>
                   | <binop-assign-stmt>
                   | <expression-stmt>
                   | <alias-stmt>
                   | <type-decl>
                   | <variant-decl>
                   | <trait-decl>

<body> @scope("block") ::= <block-start> <body-stmts>? <block-end>
<block> ::= <body>
<body-stmts> @infer("$0") ::= <value-stmt>
<body-stmts>              ::= <body-stmt-list>
<body-stmts> @infer("$2") ::= <body-stmt-list> <eos>+ <value-stmt>
<body-stmt-list>          ::= <body-stmt> (<eos>+ <body-stmt>)*
<body-stmt>            ::=  <block>
                         | <if-stmt>
                         | <for-stmt>
                         | <while-stmt>
                         | <when-stmt>
                         | <typecase-stmt>
                         | <switch-stmt>
                         | <try-stmt>
                         | <with-stmt>
                         | <continue-stmt>
                         | <break-stmt>
                         | <return-stmt>
                         | <fail-stmt>
                         | <variable-decl>
                         | <labeled-for>
                         | <labeled-while>
                         | <labeled-typecase>
                         | <labeled-switch>
                         | <assert-stmt>
                         | <import-stmt>
                         | <assign-stmt>
                         | <binop-assign-stmt>
                         | <expression-stmt>

<label> ::= %IDENTIFIER %":"

<labeled-for> ::= <label> <for-stmt>
<labeled-while> ::= <label> <while-stmt>
<labeled-typecase> ::= <label> <typecase-stmt>
<labeled-switch> ::= <label> <switch-stmt>

<if-stmt> @scope("if") @branch($1, $2, $3) ::= %"if" <expression> <body> <elif-chain>

<elif-chain> ::= (<eos>* <elif-clause>)* (<eos>* <else-clause>)?

<elif-clause> @branch($1, $2) ::= %"elif" <expression> <body>
<else-clause> ::= %"else" <body>

<if-value-expr> @scope("if") @branch($1, $2, $3) @infer("$2 unify $3") ::=
       %"if" <expression> <value-body> <value-elif-chain>

<value-body> @scope("block") @infer("$1") ::= <block-start> <value-body-stmts> <block-end>

<value-body-stmts> @infer("$0") ::= <value-stmt>
<value-body-stmts> @infer("$2") ::= <body-stmt-list> <eos>+ <value-stmt>

<value-elif-chain> @infer("$1") ::= <eos>* <value-else-clause>
<value-elif-chain> @infer("$1 unify $2") ::=
       <eos>* <value-elif-clause> <value-elif-chain>

<value-elif-clause> @branch($1, $2) @infer("$2") ::= %"elif" <expression> <value-body>
<value-else-clause> @infer("$1") ::= %"else" <value-body>

<for-stmt> @scope("for") @loop($3, $4) @infer("`t unify element_of(method_return(method_return($3, iter), next))") ::=
       %"for" <for-var-list> %"in" <for-in-target-list> <body>

<for-stmt> @scope("for") @loop($3, $4) @infer("$1 unify $3") ::=
       %"for" <for-range-var> %"from" <range-loop> <body>

<for-range-var> ::= <for-binding>
<for-var-list> ::= <for-binding>
<for-var-list> ::= <for-binding> %"," <for-var-list>

<for-binding> @declares($0) @infer("`t") ::= %IDENTIFIER
<for-binding> @declares($1) @infer("`t") ::= %"let" %IDENTIFIER
<for-binding> @declares($0, $2) @infer("$0 unify $2") ::=
       %IDENTIFIER %":" <type-spec>
<for-binding> @declares($1, $3) @infer("$1 unify $3") ::=
       %"let" %IDENTIFIER %":" <type-spec>

<for-in-target-list> ::= <expression>

<while-stmt> @scope("while") @loop($1, $2) ::= %"while" <expression> <body>

<member-chain> ::= <member-chain> %"." %IDENTIFIER
<member-chain> @varref($0) @infer("lookup($0)") ::= %IDENTIFIER

<when-stmt> ::= %"when" <expression> <body> <else-when-clause>* <ctime-else>?
<else-when-clause> ::= %"else" %"when" <expression> <body>
<ctime-else> ::= %"else" <body>

<typecase-stmt> @scope("typecase") @switch($1, $3) ::=
       %"typecase" <expression> <block-start> <typecase-cases> <block-end>

<typecase-cases> ::= (<eos>* %"case" <typecase-case-block>)+ <eos>* <case-else>?

<typecase-case-block> ::= <type-spec-list> <body>

<typecase-value-expr> @scope("typecase") @switch($1, $3) @infer("$3") ::=
       %"typecase" <expression> <block-start> <typecase-value-cases> <block-end>

<typecase-value-cases> @infer("$0") ::= <typecase-value-branch-list>
<typecase-value-cases> @infer("$0 unify $1") ::=
       <typecase-value-branch-list> <typecase-value-else>

<typecase-value-branch-list> @infer("$0") ::= <typecase-value-case-prefix>
<typecase-value-branch-list> @infer("$0 unify $1") ::=
       <typecase-value-case-prefix> <typecase-value-branch-list>

<typecase-value-case-prefix> @infer("$2") ::=
       <eos>* %"case" <typecase-value-case-block>

<typecase-value-case-block> @infer("$1") ::= <type-spec-list> <value-body>

<typecase-value-else> @infer("$2") ::= <eos>* %"else" <value-body>

<type-spec-list> ::= <type-spec> (%"," <type-spec>)* %","?

<try-stmt> @scope("try") ::= %"try" <try-body> <try-error-clause>
<try-body> @scope("block") ::= <block-start> <try-body-stmts>? <block-end>
<try-body-stmts> ::= <value-stmt>
                    | <body-stmt-list>
                    | <body-stmt-list> <eos>+ <value-stmt>
<try-error-clause> @scope("try-error") @declares($1, "error") ::=
       %"else" %IDENTIFIER <body>
<try-error-clause> @scope("try-error") @declares($1, $3, "error") @infer("$1 unify $3") ::=
       %"else" %IDENTIFIER %":" <type-spec> <body>

<try-value-expr> @scope("try") @infer("$1 unify $2") ::=
       %"try" <value-body> <try-value-error-clause>
<try-value-error-clause> @scope("try-error") @declares($1, "error") ::=
       %"else" %IDENTIFIER <value-body>
<try-value-error-clause> @scope("try-error") @declares($1, $3, "error") @infer("$1 unify $3") ::=
       %"else" %IDENTIFIER %":" <type-spec> <value-body>

# Using the `type` keyword creates a 'brand new' type, meaning that
# name equiv is required for there to be equal types.
# The `alias` keyword here means that we have one type, with multiple names.

<alias-stmt> @namespace("type") @scope("type", $2) @type($2) @exposes ::=
       <member-visibility>? %"alias" %IDENTIFIER %"=" <type-spec>
     | <member-visibility>? %"type" %IDENTIFIER %"=" <type-spec>

<context-def> @scope("context", $1) @declares($1) ::=
       %"context" %IDENTIFIER <param-decl> <context-spec> <context-body>

<context-spec> ::= <provides-clause>? <error-type>?
<provides-clause> ::= %"provides" %":" <type-spec>

<context-body> ::= <block-start> <context-hooks>? <block-end>
<context-hooks> ::= <context-hook> (<eos>+ <context-hook>)*

<context-hook> ::= <context-enter>
                 | <context-exit>
                 | <context-error>
                 | <context-ensure>

<context-enter> @scope("context-hook") ::= %"enter" %"(" %")" <body>
<context-exit> @scope("context-hook") ::= %"exit" <context-hook-params> <body>
<context-error> @scope("context-hook") ::= %"error" <context-hook-params> <body>
<context-ensure> @scope("context-hook") ::= %"ensure" <context-hook-params> <body>

<context-hook-params> ::= %"(" <pos-param>? %")"

<with-stmt> @scope("with") ::= %"with" <context-manager> (%"," <context-manager>)* %","? <body>
<context-manager> @declares($0, $2) @assigns($0, $4) @infer("$0 unify $4") ::=
       %IDENTIFIER %":" <type-spec> %"=" <context-call>
<context-manager> @declares($0) @assigns($0, $2) @infer("$0 unify $2") ::=
       %IDENTIFIER %"=" <context-call>
<context-manager> ::= <context-call>
<context-call> @emit("call") @infer("return_of($0)") @call($0, $2) ::=
       <member-chain> %"(" <call-args> %")"
<context-call> @emit("call") @infer("return_of($0)") @call($0) ::=
       <member-chain> %"(" %")"

<switch-stmt> @scope("switch") @switch($1, $3) @infer("$1 unify $3") ::=
       %"switch" <expression> <block-start> <switch-cases> <block-end>

<switch-cases> ::= <branch-list> <eos>* <case-else>?

<branch-list> @infer("$2") ::= <eos>* %"case" <switch-case-block>
<branch-list> @infer("$2 unify $3") ::= <eos>* %"case" <switch-case-block> <branch-list>

<switch-case-block> ::= <case-expr-list> <body>

<case-expr-list> @infer("$0") ::= <case-expr-item>

<case-expr-list> @infer("$0 unify $2") ::=
           <case-expr-item> %"," <case-expr-list>
<case-expr-list> @infer("$0") ::= <case-expr-item> %","

<case-expr-item> @infer("$0 unify $2") ::= <expression> <range-sep> <expression>
<case-expr-item> @infer("$0")             ::= <expression>

<case-else> ::= %"else" <body>

<switch-value-expr> @scope("switch") @switch($1, $3) @infer("$3") ::=
       %"switch" <expression> <block-start> <switch-value-cases> <block-end>

<switch-value-cases> @infer("$0 unify $1") ::= <switch-value-branch-list> <switch-value-else>

<switch-value-branch-list> @infer("$0") ::= <switch-value-case-prefix>
<switch-value-branch-list> @infer("$0 unify $1") ::=
       <switch-value-case-prefix> <switch-value-branch-list>

<switch-value-case-prefix> @infer("$2") ::= <eos>* %"case" <switch-value-case-block>

<switch-value-case-block> @infer("$1") ::= <case-expr-list> <value-body>

<switch-value-else> @infer("$2") ::= <eos>* %"else" <value-body>

<range> @infer("$0") ::= <range-parts>
<range-parts> @infer("$0 unify $2") ::= <expression> <range-sep> <expression>
<range-loop> @infer("$0") ::= <range-parts> <range-step>?
<range-step> ::= %"step" <expression>
<range-sep> ::= %"to" | %"until" | %".."

<break-stmt> @jump("break") ::= %"break" %IDENTIFIER?
<continue-stmt> @jump("continue") ::= %"continue" %IDENTIFIER?
<return-stmt> @jump("return") @emit("return", $1) @infer("$1") ::= %"return" <expression>
<return-stmt> @jump("return") @emit("return") ::= %"return"
<fail-stmt> @jump("fail") @infer("$1") ::= %"fail" <expression>
<value-stmt> @jump("value") @infer("$1") ::= %"=" <expression>

<assert-stmt> ::= (%"assert"|%"require") <expression>

<import-stmt> @declares($1, "module") ::= %"import" <member-chain> (%"from" %STRING_LIT)?

<variable-decl> ::= <variable-visibility>? <declaration-prefix> <sym-decl-list>

<variable-visibility> @visibility("public") ::= %"public"
<variable-visibility> @visibility("private") ::= %"private"
<variable-visibility> @visibility("package") ::= %"package"

<visible-inferred-assign> @visibility("public") ::= %"public" <assign-stmt>
<visible-inferred-assign> @visibility("private") ::= %"private" <assign-stmt>
<visible-inferred-assign> @visibility("package") ::= %"package" <assign-stmt>

<declaration-prefix> ::= <storage-class>? <binding-kind>
<storage-class> ::= %"thread"
<binding-kind> ::= %"var" | %"let" | %"const"

<sym-decl-list> ::= <sym-decl> %"," <sym-decl-list>
                  | <sym-decl>

<sym-decl> @declares($0, $2) @assigns($0, $4)  @infer("$0 unify $4") ::=
         %IDENTIFIER %":" <type-spec> <assign-op> <expression>
<sym-decl> @declares($0, $2) @infer("$0 unify $2") ::= %IDENTIFIER %":" <type-spec>
<sym-decl> @declares($0) @assigns($0, $2) @infer("$0 unify $2") ::= %IDENTIFIER <assign-op> <expression>
<sym-decl> @declares($0) ::= %IDENTIFIER

<assign-op> ::= %"="

<comptime-stmt> ::= %"comptime" <body> <comptime-else>?
<comptime-else> ::= <eos>* %"else" <body>

<func-def> @scope("function", $1) @declares($1, "function") ::=
    <func-prelude> %IDENTIFIER <func-type-signature> <body>

<member-visibility> @visibility("public") ::= %"public"
<member-visibility> @visibility("private") ::= %"private"
<member-visibility> @visibility("package") ::= %"package"
<member-visibility> @visibility("opaque") ::= %"opaque"

<func-visibility> @visibility("public") ::= %"public"
<func-visibility> @visibility("private") ::= %"private"
<func-visibility> @visibility("package") ::= %"package"

<func-prelude> @visibility("protected") ::= %"func"
<func-prelude> ::= <func-visibility> %"func"
<func-type-signature> ::= <param-decl> <function-result>? <where-clause>?

<param-decl> ::= %"(" <formals>? %")"

<formals> ::= <required-params> (%"," <default-params>)? (%"," <vargs-param>)? %","?
            | <default-params> (%"," <vargs-param>)? %","?
            | <vargs-param> %","?

<required-params> ::= <pos-param> (%"," <pos-param>)*
<default-params> ::= <default-param> (%"," <default-param>)*

<pos-param> @declares($0, "param") @direction($0, "in") @pass_by("in") ::=
    %IDENTIFIER
<pos-param> @declares($0, $2, "param") @direction($0, "in") @pass_by("in") ::=
    %IDENTIFIER %":" <type-spec>
<pos-param> @declares($1, "param") @direction($1, "out") @pass_by("out") ::=
    %"out" %IDENTIFIER
<pos-param> @declares($1, $3, "param") @direction($1, "out") @pass_by("out") ::=
    %"out" %IDENTIFIER %":" <type-spec>
<pos-param> @declares($1, "param") @direction($1, "modify") @pass_by("inout") ::=
    %"modify" %IDENTIFIER
<pos-param> @declares($1, $3, "param") @direction($1, "modify") @pass_by("inout") ::=
    %"modify" %IDENTIFIER %":" <type-spec>
<pos-param> @declares($1, "param") @direction($1, "consume") @pass_by("consume") ::=
    %"consume" %IDENTIFIER
<pos-param> @declares($1, $3, "param") @direction($1, "consume") @pass_by("consume") ::=
    %"consume" %IDENTIFIER %":" <type-spec>

<default-param> @declares($0, "param") @direction($0, "in") @pass_by("in") @infer("$0 unify $2") ::=
                %IDENTIFIER %"=" <expression>
<default-param> @declares($0, $2, "param") @direction($0, "in") @pass_by("in") @infer("$0 unify $4") ::=
                %IDENTIFIER %":" <type-spec> %"=" <expression>
<default-param> @declares($1, "param") @direction($1, "consume") @pass_by("consume") @infer("$1 unify $3") ::=
                %"consume" %IDENTIFIER %"=" <expression>
<default-param> @declares($1, $3, "param") @direction($1, "consume") @pass_by("consume") @infer("$1 unify $5") ::=
                %"consume" %IDENTIFIER %":" <type-spec> %"=" <expression>

<vargs-param> @declares($1, $3, "param") @direction($1, "in") @pass_by("in") ::=
    %"*" %IDENTIFIER %":" <type-spec>
<vargs-param> @declares($1, "param") @direction($1, "in") @pass_by("in") ::=
    %"*" %IDENTIFIER
<vargs-param> @declares($2, $4, "param") @direction($2, "modify") @pass_by("inout") ::=
    %"modify" %"*" %IDENTIFIER %":" <type-spec>
<vargs-param> @declares($2, "param") @direction($2, "modify") @pass_by("inout") ::=
    %"modify" %"*" %IDENTIFIER
<vargs-param> @declares($2, $4, "param") @direction($2, "consume") @pass_by("consume") ::=
    %"consume" %"*" %IDENTIFIER %":" <type-spec>
<vargs-param> @declares($2, "param") @direction($2, "consume") @pass_by("consume") ::=
    %"consume" %"*" %IDENTIFIER

<function-result> ::= <return-type>? <error-type>?

<return-type> ::= <return-sigil> <union-tspec>

<return-sigil> ::= %"->"
                 | %"return" %":"

<error-type> ::= %"fail" %":" <one-tspec>

<enum-stmt> @namespace("type") @scope("enum", $1) @type($1) @exposes ::= <enum-prefix> %IDENTIFIER <block-start> <enum-items> <block-end>

<enum-prefix> ::= <member-visibility>? %"enum"

<enum-items> ::= <enum-item> (<eos>* %"," <eos>* <enum-item>)* (<eos>* %",")?

<enum-item> @declares($0) ::= %IDENTIFIER <enum-value>
<enum-item> @declares($0) ::= %IDENTIFIER

<enum-value> ::= %":" <simple-lit>
               | %"=" <simple-lit>
               | %":" %"-" <simple-lit>
               | %"=" %"-" <simple-lit>

<assign-stmt> @assigns($0, $2) ::= <expression> <assign-op> <expression>

<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __add)") ::= <expression> %"+=" <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __subtract)") ::= <expression> %"-=" <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __multiply)") ::= <expression> %"*=" <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __divide)") ::= <expression> %"/=" <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __remainder)") ::= <expression> %"%=" <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __bit_and)") ::= <expression> %"&=" <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __bit_or)") ::= <expression> %"|=" <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __bit_xor)") ::= <expression> %"^=" <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __shift_left)") ::= <expression> %"<<=" <expression>
<binop-assign-stmt> @assigns($0, $2) @emit("compound_assign", $0, $2) @infer("$0 unify method_result($0, $2, __shift_right)") ::= <expression> %">>=" <expression>

<expression-stmt> ::= <expression>

<expression> @emit("identity", $0) ::= <or-expr>

<or-expr> @branch($0, $2) @infer("bool") ::= <or-expr> %"or" <or-rhs>
<or-expr> @emit("identity", $0) ::= <and-expr>
<or-rhs> @emit("identity", $0) ::= <and-expr>

<and-expr> @branch($0, $2) @infer("bool") ::= <and-expr> %"and" <and-rhs>
<and-expr> @emit("identity", $0) ::= <equality-expr>
<and-rhs> @emit("identity", $0) ::= <equality-expr>

<equality-expr> @emit("binary", $0, $2) @infer("bool") ::=
    <compare-expr> <equality-op> <compare-expr>
<equality-expr> @emit("identity", $0) ::= <compare-expr>
<equality-op> ::= %"==" | %"!="

<compare-expr> @emit("binary", $0, $2) @infer("compare($0, $2, __cmp, Comparison)") ::=
    <bitor-expr> <compare-op> <bitor-expr>
<compare-expr> @emit("identity", $0) ::= <bitor-expr>
<compare-op> ::= %"<" | %"<=" | %">" | %">="

<bitor-expr> @emit("binary", $0, $2) @infer("method_result($0, $2, __bit_or)") ::= <bitor-expr> %"|" <bitxor-expr>
<bitor-expr> @emit("identity", $0) ::= <bitxor-expr>

<bitxor-expr> @emit("binary", $0, $2) @infer("method_result($0, $2, __bit_xor)") ::= <bitxor-expr> %"^" <bitand-expr>
<bitxor-expr> @emit("identity", $0) ::= <bitand-expr>

<bitand-expr> @emit("binary", $0, $2) @infer("method_result($0, $2, __bit_and)") ::= <bitand-expr> %"&" <shift-expr>
<bitand-expr> @emit("identity", $0) ::= <shift-expr>

<shift-expr> @emit("binary", $0, $2) @infer("method_result($0, $2, __shift_left)") ::= <shift-expr> %"<<" <add-expr>
<shift-expr> @emit("binary", $0, $2) @infer("method_result($0, $2, __shift_right)") ::= <shift-expr> %">>" <add-expr>
<shift-expr> @emit("identity", $0) ::= <add-expr>

<add-expr> @emit("binary", $0, $2) @infer("method_result($0, $2, __add)") ::= <add-expr> %"+" <mul-expr>
<add-expr> @emit("binary", $0, $2) @infer("method_result($0, $2, __subtract)") ::= <add-expr> %"-" <mul-expr>
<add-expr> @emit("identity", $0) ::= <mul-expr>

<mul-expr> @emit("binary", $0, $2) @infer("method_result($0, $2, __multiply)") ::= <mul-expr> %"*" <unary-expr>
<mul-expr> @emit("binary", $0, $2) @infer("method_result($0, $2, __divide)") ::= <mul-expr> %"/" <unary-expr>
<mul-expr> @emit("binary", $0, $2) @infer("method_result($0, $2, __remainder)") ::= <mul-expr> %"%" <unary-expr>
<mul-expr> @emit("identity", $0) ::= <unary-expr>

<unary-expr> @emit("bool_not", $1) @infer("bool unify method_return($1, __not)") ::= %"!" <unary-expr>
<unary-expr> @emit("negate", $1) @infer("method_return($1, __negate)") ::= %"-" <unary-expr>
