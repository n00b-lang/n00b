@lexer("n00b.lex")
@declaration_point("after_initializer")
@statement_end("NEWLINE", ";")
@continue_after("(", "[", "{")

<module> @scope("module") ::= <other-top-stmts>? <eos>*

<eos> ::= %NEWLINE | %";"

<block-start> @trivia_indent($1) ::= %"{" <eos>*
<block-start> @trivia_indent($1) ::= %":" %NEWLINE %INDENT
<block-end> @trivia_indent($0) ::= <eos>* %"}"
<block-end> @trivia_indent($0) ::= <eos>* %DEDENT

<other-top-stmts> @hardline ::= <eos>* <top-level-stmt> (<eos>+ <top-level-stmt>)*

<top-level-stmt> ::=  <enum-stmt>
                   | <flagset-stmt>
                   | <if-stmt>
                   | <for-stmt>
                   | <while-stmt>
                   | <top-when-stmt>
                   | <typecase-stmt>
                   | <switch-stmt>
                   | <try-stmt>
                   | <func-def>
                   | <context-def>
                   | <with-stmt>
                   | <variable-decl>
                   | <labeled-for>
                   | <labeled-while>
                   | <labeled-typecase>
                   | <labeled-switch>
                   | <assert-stmt>
                   | <import-stmt>
                   | <visible-inferred-assign>
                   | <discard-stmt>
                   | <assign-stmt>
                   | <binop-assign-stmt>
                   | <expression-stmt>
                   | <alias-stmt>
                   | <litmod-alias-stmt>
                   | <type-decl>
                   | <record-decl>
                   | <object-decl>
                   | <variant-decl>
                   | <trait-decl>
                   | <effect-decl>
                   | <mark-decl>
                   | <callback-decl>
                   | <package-decl>

<body> @scope("block") @hardline($1) @indent($1) @hardline($2) ::= <block-start> <body-stmts>? <block-end>
<block> ::= <body>
<body-stmts> ::= <value-stmt>
<body-stmts>              ::= <body-stmt-list>
<body-stmts> ::= <body-stmt-list> <eos>+ <value-stmt>
<body-stmt-list> @hardline ::= <body-stmt> (<eos>+ <body-stmt>)*
<body-stmt>            ::=  <block>
                         | <if-stmt>
                         | <for-stmt>
                         | <while-stmt>
                         | <when-stmt>
                         | <typecase-stmt>
                         | <switch-stmt>
                         | <try-stmt>
                         | <with-stmt>
                         | <continue-stmt>
                         | <break-stmt>
                         | <return-stmt>
                         | <fail-stmt>
                         | <variable-decl>
                         | <labeled-for>
                         | <labeled-while>
                         | <labeled-typecase>
                         | <labeled-switch>
                         | <assert-stmt>
                         | <import-stmt>
                         | <export-stmt>
                         | <discard-stmt>
                         | <assign-stmt>
                         | <binop-assign-stmt>
                         | <pass-stmt>
                         | <expression-stmt>

<pass-stmt> ::= %"pass"

<label> ::= %IDENTIFIER %":"

<labeled-for> ::= <label> <for-stmt>
<labeled-while> ::= <label> <while-stmt>
<labeled-typecase> ::= <label> <typecase-stmt>
<labeled-switch> ::= <label> <switch-stmt>

<if-stmt> @scope("if") @branch($1, $2, $3) ::= %"if" <expression> <body> <elif-chain>

<elif-chain> ::= (<eos>* <elif-clause>)* (<eos>* <else-clause>)?

<elif-clause> @branch($1, $2) ::= <elif-keyword> <expression> <body>
<elif-keyword> ::= %"elif" | %"elseif" | %"else" %"if"
<else-clause> ::= %"else" <body>

<if-value-expr> @scope("if") @branch($1, $2, $3) ::=
       %"if" <expression> <value-body> <value-elif-chain>

<value-body> @scope("block") @hardline($1) @indent($1) @hardline($2) ::=
       <block-start> <value-body-stmts> <block-end>

<value-body-stmts> ::= <value-stmt>
<value-body-stmts> ::= <body-stmt-list> <eos>+ <value-stmt>

<value-elif-chain> ::= <eos>* <value-else-clause>
<value-elif-chain> ::=
       <eos>* <value-elif-clause> <value-elif-chain>

<value-elif-clause> @branch($1, $2) ::= <elif-keyword> <expression> <value-body>
<value-else-clause> ::= %"else" <value-body>

<for-stmt> @scope("for") @loop($3, $4) ::=
       %"for" <for-var-list> %"in" <for-in-target-list> <body>

<for-stmt> @scope("for") @loop($3, $4) ::=
       %"for" <for-range-var> %"from" <range-loop> <body>

<for-range-var> ::= <for-binding>
<for-var-list> ::= <for-binding>
<for-var-list> ::= <for-binding> %"," <for-var-list>
<for-var-list> ::= <binding-pattern>
<for-var-list> ::= <binding-pattern> %"," <for-var-list>

<binding-pattern> @nospace($1) ::= %"(" <pattern-items> %")"
<pattern-items> ::= <pattern-item> %"," <pattern-items>
                  | <pattern-item>
                  | <pattern-item> %","
<pattern-item> ::= <pattern-target>
<pattern-target> ::= <pattern-binding> | <pattern-skip> | <binding-pattern>
<pattern-binding> @declares($0) ::= %IDENTIFIER
<pattern-binding> @declares($0) @nospace($1) ::=
       %IDENTIFIER %":" <type-spec>
<pattern-skip> ::= %_

<for-binding> @declares($0) ::= %IDENTIFIER
<for-binding> @declares($0) ::=
       %IDENTIFIER %":" <type-spec>

<for-in-target-list> ::= <expression>

<while-stmt> @scope("while") @loop($1, $2) ::= %"while" <expression> <body>

<member-chain> @nospace ::= <member-chain> %"." %IDENTIFIER
<member-chain> @varref($0) @disambig(n00bb_penalize_nil_identifier, 100) ::= %IDENTIFIER

<when-stmt> ::= %"when" <expression> <body> <else-when-clause>* <ctime-else>?
<else-when-clause> ::= %"else" %"when" <expression> <body>
<ctime-else> ::= %"else" <body>

# At module level, a `when` branch holds anything a module can: types,
# enums, functions, constants, imports. The preprocessor keeps the chosen
# branch, and its declarations belong to the module (no block scope).
<top-when-stmt> ::= %"when" <expression> <top-when-body> <top-else-when-clause>* <top-ctime-else>?
<top-else-when-clause> ::= %"else" %"when" <expression> <top-when-body>
<top-ctime-else> ::= %"else" <top-when-body>
<top-when-body> @hardline($1) @indent($1) @hardline($2) ::= <block-start> <other-top-stmts>? <block-end>

<typecase-stmt> @scope("typecase") @switch($1, $3) @hardline($3) @indent($3) @hardline($4) ::=
       %"typecase" <expression> <block-start> <typecase-cases> <block-end>

<typecase-cases> @hardline($2) ::= (<eos>* %"case" <typecase-case-block>)+ <eos>* <case-else>?

<typecase-case-block> ::= <type-spec-list> <body>

<typecase-value-expr> @scope("typecase") @switch($1, $3) @hardline($3) @indent($3) @hardline($4) ::=
       %"typecase" <expression> <block-start> <typecase-value-cases> <block-end>

<typecase-value-cases> ::= <typecase-value-branch-list>
<typecase-value-cases> @hardline($1) ::=
       <typecase-value-branch-list> <typecase-value-else>

<typecase-value-branch-list> ::= <typecase-value-case-prefix>
<typecase-value-branch-list> @hardline($1) ::=
       <typecase-value-case-prefix> <typecase-value-branch-list>

<typecase-value-case-prefix> ::=
       <eos>* %"case" <typecase-value-case-block>

<typecase-value-case-block> ::= <type-spec-list> <value-body>

<typecase-value-else> ::= <eos>* %"else" <value-body>

<type-spec-list> ::= <type-spec> (%"," <type-spec>)* %","?

<try-stmt> @scope("try") ::= %"try" <try-body> <try-error-clause>
<try-body> @scope("block") ::= <block-start> <try-body-stmts>? <block-end>
<try-body-stmts> ::= <value-stmt>
                    | <body-stmt-list>
                    | <body-stmt-list> <eos>+ <value-stmt>
<try-error-clause> @scope("try-error") ::=
       %"fail" <try-handler-params> <body>
<try-handler-params> ::= %"(" <try-error-binding> %")" | %"(" %")"
<try-error-binding> @declares($0, "error") ::= %IDENTIFIER
<try-error-binding> @declares($0, "error") ::=
       %IDENTIFIER %":" <type-spec>

<try-value-expr> @scope("try") ::=
       %"try" <value-body> <try-value-error-clause>
<try-value-error-clause> @scope("try-error") ::=
       %"fail" <try-handler-params> <value-body>

# Using the `type` keyword creates a 'brand new' type, meaning that
# name equiv is required for there to be equal types.
# The `alias` keyword here means that we have one type, with multiple names.

<alias-stmt> @namespace("type") @scope("type", $1) @type($1) @exposes ::=
       <alias-type-keyword> %IDENTIFIER <assign-op> <type-spec>
<alias-stmt> @namespace("type") @scope("type", $2) @type($2) @exposes ::=
       <member-visibility>? %"type" %IDENTIFIER <assign-op> <type-spec>
<alias-type-keyword> ::= %"alias" %"type"

<litmod-alias-stmt> ::=
       %"alias" %"litmod" <litmod-alias-name> <assign-op> <litmod-alias-target>
<litmod-alias-name> ::= %IDENTIFIER
<litmod-alias-target> ::= %IDENTIFIER

<record-keyword> ::= %"record" | %"struct"

<context-def> @scope("context", $2) @declares($2) ::=
       <member-visibility>? %"context" %IDENTIFIER <param-decl> <context-spec> <context-body>

<context-spec> ::= <provides-clause>? <error-type>?
<provides-clause> ::= %"provides" %":" <type-spec>

<context-body> ::= <block-start> <context-hooks>? <block-end>
<context-hooks> ::= <context-hook> (<eos>+ <context-hook>)*

<context-hook> ::= <pass-stmt>
                 | <context-enter>
                 | <context-exit>
                 | <context-fail>
                 | <context-ensure>

<context-enter> @scope("context-hook") ::= %"enter" %"(" %")" <body>
<context-exit> @scope("context-hook") ::= %"exit" <context-hook-params> <body>
<context-fail> @scope("context-hook") ::= %"fail" <context-hook-params> <body>
<context-ensure> @scope("context-hook") ::= %"ensure" <context-hook-params> <body>

<context-hook-params> ::= %"(" <pos-param>? %")"

<with-stmt> @scope("with") ::= %"with" <context-manager> (%"," <context-manager>)* %","? <body>
<context-manager> @declares($0) @assigns($0, $4) ::=
       %IDENTIFIER %":" <type-spec> <assign-op> <context-call>
<context-manager> @declares($0) @assigns($0, $2) ::=
       %IDENTIFIER <assign-op> <context-call>
<context-manager> ::= <context-call>
<context-call> @call($0, $2) ::=
       <member-chain> %"(" <call-args> %")"
<context-call> @call($0) ::=
       <member-chain> %"(" %")"

<switch-stmt> @scope("switch") @switch($1, $3) @hardline($3) @indent($3) @hardline($4) ::=
       %"switch" <expression> <block-start> <switch-cases> <block-end>

<switch-cases> @hardline($2) ::= <branch-list> <eos>* <case-else>?

<branch-list> ::= <eos>* %"case" <switch-case-block>
<branch-list> @hardline($3) ::=
       <eos>* %"case" <switch-case-block> <branch-list>

<switch-case-block> ::= <case-expr-list> <body>

<case-expr-list> ::= <case-expr-item>

<case-expr-list> ::=
           <case-expr-item> %"," <case-expr-list>
<case-expr-list> ::= <case-expr-item> %","

<case-expr-item> ::= <expression> <range-sep> <expression>
<case-expr-item>             ::= <expression>
<case-expr-item>             ::= <case-flags-test>

<case-flags-test> ::= <case-flags-kind> <case-flags>
<case-flags-kind> ::= %"has"
                    | %"is"
<case-flags> ::= <case-flags> <plus-op> <case-flags-xor>
               | <case-flags> <minus-op> <case-flags-xor>
               | <case-flags> <pipe-op> <case-flags-xor>
               | <case-flags-xor>
<case-flags-xor> ::= <case-flags-xor> <xor-op> <case-flags-and>
                   | <case-flags-and>
<case-flags-and> ::= <case-flags-and> <amp-op> <case-flags-unary>
                   | <case-flags-unary>
<case-flags-unary> @nospace ::= %"~" <case-flags-unary>
<case-flags-unary> ::= <case-flags-primary>
<case-flags-primary> ::= <nil-keyword>
                       | <case-flag-name>
<case-flags-primary> @nospace ::= %"(" <case-flags> %")"
<case-flag-name> ::= %IDENTIFIER

<case-else> ::= %"else" <body>

<switch-value-expr> @scope("switch") @switch($1, $3) @hardline($3) @indent($3) @hardline($4) ::=
       %"switch" <expression> <block-start> <switch-value-cases> <block-end>

<switch-value-cases> @hardline($1) ::=
       <switch-value-branch-list> <switch-value-else>

<switch-value-branch-list> ::= <switch-value-case-prefix>
<switch-value-branch-list> @hardline($1) ::=
       <switch-value-case-prefix> <switch-value-branch-list>

<switch-value-case-prefix> ::= <eos>* %"case" <switch-value-case-block>

<switch-value-case-block> ::= <case-expr-list> <value-body>

<switch-value-else> ::= <eos>* %"else" <value-body>

<range> ::= <range-parts>
<range-parts> ::= <expression> <range-sep> <expression>
<range-loop> ::= <range-parts> <range-step>?
<range-step> ::= %"step" <expression>
<range-sep> ::= %"to"
              | %"until"
              | %":"

<break-stmt> @jump("break") ::= %"break" %IDENTIFIER?
<continue-stmt> @jump("continue") ::= %"continue" %IDENTIFIER?
<return-stmt> @jump("return") ::= %"return" <expression>
<return-stmt> @jump("return") ::= %"return"
<fail-stmt> @jump("fail") ::= %"fail" <expression>
<value-stmt> @jump("value") ::= <value-sigil> <expression>
<value-sigil> ::= %"->"

<assert-stmt> ::= (%"assert"|%"require") <expression>

<import-stmt> ::= %"import" <module-import> (%"," <module-import>)* %","?
<import-stmt> ::= %"import" <module-import> %"bring" <brought-names>
<import-stmt> ::= %"bring" <brought-symbols> %"from" <module-source>
<module-import> @declares($0, "module") ::= <module-source>
<module-import> @declares($2, "module") ::= <module-source> %"as" %IDENTIFIER
<module-source> ::= <member-chain>
<brought-symbols> ::= %"all"
<brought-symbols> ::= <brought-names>
<brought-names> ::= <brought-symbol> (%"," <brought-symbol>)* %","?
<brought-symbol> ::= %IDENTIFIER (%"as" %IDENTIFIER)?

<package-decl> ::= %"package" <dotted-name> <package-body>
<package-body> ::= <block-start> <package-items>? <block-end>
<package-items> ::= <package-item> (<eos>+ <package-item>)*
<package-item> ::= <export-stmt> | <when-stmt> | <pass-stmt>
<export-stmt> ::= %"export" <dotted-name> (<export-alias>)? (<export-grantee>)?
<export-alias> ::= %"as" %IDENTIFIER
<export-grantee> ::= %"to" <dotted-name>
<dotted-name> ::= <dotted-name> %"." %IDENTIFIER | %IDENTIFIER

<variable-decl> ::= <member-visibility>? <declaration-prefix> <sym-decl-list>
<variable-decl> ::= <member-visibility>? <declaration-prefix> <binding-pattern> <assign-op> <expression>

<visible-inferred-assign> @visibility("private") ::= %"private" <assign-stmt>

<declaration-prefix> ::= <storage-class>? <binding-kind>
<storage-class> ::= %"thread"
<binding-kind> ::= %"var" | %"let" | %"const"

<sym-decl-list> ::= <sym-decl> %"," <sym-decl-list>
                  | <sym-decl>
                  | <sym-decl> %","

<sym-decl> @declares($0) @assigns($0, $4) @nospace($1) ::=
         %IDENTIFIER %":" <type-spec> <assign-op> <expression>
<sym-decl> @declares($0) @nospace($1) ::= %IDENTIFIER %":" <type-spec>
<sym-decl> @declares($0) @assigns($0, $2) ::= %IDENTIFIER <assign-op> <expression>
<sym-decl> @declares($0) ::= %IDENTIFIER

<assign-op> ::= %"="

<func-def> @scope("function", $1) @declares($1, "function") @nospace($2) @align($2) ::=
    <func-prelude> %IDENTIFIER <func-type-signature> <body>
<func-def> @scope("function", $1) @declares($1, "function") @nospace($2) @align($2) ::=
    <litmod-prelude> %IDENTIFIER <func-type-signature> <body>

<litmod-prelude> ::= <litmod-kind> %"litmod"
<litmod-kind> ::= %IDENTIFIER | <record-keyword> | <nil-keyword>

<member-visibility> @visibility("private") ::= %"private"

<function-keyword> ::= %"func" | %"fn" | %"function"
<func-prelude> ::= <function-keyword>
<func-prelude> ::= <member-visibility> <function-keyword>
<func-prelude> ::= <func-inline> <function-keyword>
<func-prelude> ::= <member-visibility> <func-inline> <function-keyword>
<func-inline> ::= %"inline"
<func-type-signature> @newline($1) ::=
    <param-decl> <function-result>? <where-clause>?

<param-decl> @group @nospace($0) @nospace($1) @nospace($2) ::= %"(" <formals>? %")"

<formals> @newline @nospace($1) @nospace($2) ::=
    <formal> (%"," <formal>)* %","?

<formal> ::= <pos-param> | <vargs-param> | <default-param>

<pos-param> @declares($0, "param") @direction($0, "in") @pass_by("in") ::=
    %IDENTIFIER
<pos-param> @declares($0, "param") @direction($0, "in") @pass_by("in") @nospace($1) ::=
    %IDENTIFIER %":" <type-spec> <mark-annotation>*
<pos-param> @declares($1, "param") @direction($1, "in") @pass_by("in") ::=
    %"in" %IDENTIFIER
<pos-param> @declares($1, "param") @direction($1, "in") @pass_by("in") @nospace($2) ::=
    %"in" %IDENTIFIER %":" <type-spec> <mark-annotation>*
<pos-param> @declares($1, "param") @direction($1, "view") @pass_by("view") ::=
    %"view" %IDENTIFIER
<pos-param> @declares($1, "param") @direction($1, "view") @pass_by("view") @nospace($2) ::=
    %"view" %IDENTIFIER %":" <type-spec> <mark-annotation>*
<pos-param> @declares($1, "param") @direction($1, "out") @pass_by("out") ::=
    %"out" %IDENTIFIER
<pos-param> @declares($1, "param") @direction($1, "out") @pass_by("out") @nospace($2) ::=
    %"out" %IDENTIFIER %":" <type-spec> <mark-annotation>*
<pos-param> @declares($1, "param") @direction($1, "modify") @pass_by("inout") ::=
    %"modify" %IDENTIFIER
<pos-param> @declares($1, "param") @direction($1, "modify") @pass_by("inout") @nospace($2) ::=
    %"modify" %IDENTIFIER %":" <type-spec> <mark-annotation>*
<pos-param> @declares($1, "param") @direction($1, "consume") @pass_by("consume") ::=
    %"consume" %IDENTIFIER
<pos-param> @declares($1, "param") @direction($1, "consume") @pass_by("consume") @nospace($2) ::=
    %"consume" %IDENTIFIER %":" <type-spec> <mark-annotation>*

<default-param> @declares($0, "param") @direction($0, "in") @pass_by("in") ::=
                %IDENTIFIER <assign-op> <expression>
<default-param> @declares($0, "param") @direction($0, "in") @pass_by("in") ::=
                %IDENTIFIER %":" <type-spec> <assign-op> <expression>
<default-param> @declares($1, "param") @direction($1, "in") @pass_by("in") ::=
                %"in" %IDENTIFIER <assign-op> <expression>
<default-param> @declares($1, "param") @direction($1, "in") @pass_by("in") ::=
                %"in" %IDENTIFIER %":" <type-spec> <assign-op> <expression>
<default-param> @declares($1, "param") @direction($1, "view") @pass_by("view") ::=
                %"view" %IDENTIFIER <assign-op> <expression>
<default-param> @declares($1, "param") @direction($1, "view") @pass_by("view") ::=
                %"view" %IDENTIFIER %":" <type-spec> <assign-op> <expression>
<default-param> @declares($1, "param") @direction($1, "consume") @pass_by("consume") ::=
                %"consume" %IDENTIFIER <assign-op> <expression>
<default-param> @declares($1, "param") @direction($1, "consume") @pass_by("consume") ::=
                %"consume" %IDENTIFIER %":" <type-spec> <assign-op> <expression>
<default-param> @declares($1, "param") @direction($1, "modify") @pass_by("inout") ::=
                %"modify" %IDENTIFIER <assign-op> <expression>
<default-param> @declares($1, "param") @direction($1, "modify") @pass_by("inout") ::=
                %"modify" %IDENTIFIER %":" <type-spec> <assign-op> <expression>
<default-param> @declares($1, "param") @direction($1, "out") @pass_by("out") ::=
                %"out" %IDENTIFIER <assign-op> <expression>
<default-param> @declares($1, "param") @direction($1, "out") @pass_by("out") ::=
                %"out" %IDENTIFIER %":" <type-spec> <assign-op> <expression>

<vargs-param> @declares($1, "param") @direction($1, "in") @pass_by("in") ::=
    %"*" %IDENTIFIER %":" <type-spec>
<vargs-param> @declares($1, "param") @direction($1, "in") @pass_by("in") ::=
    %"*" %IDENTIFIER
<vargs-param> @declares($2, "param") @direction($2, "in") @pass_by("in") ::=
    %"in" %"*" %IDENTIFIER %":" <type-spec>
<vargs-param> @declares($2, "param") @direction($2, "in") @pass_by("in") ::=
    %"in" %"*" %IDENTIFIER
<vargs-param> @declares($2, "param") @direction($2, "view") @pass_by("view") ::=
    %"view" %"*" %IDENTIFIER %":" <type-spec>
<vargs-param> @declares($2, "param") @direction($2, "view") @pass_by("view") ::=
    %"view" %"*" %IDENTIFIER
<vargs-param> @declares($2, "param") @direction($2, "modify") @pass_by("inout") ::=
    %"modify" %"*" %IDENTIFIER %":" <type-spec>
<vargs-param> @declares($2, "param") @direction($2, "modify") @pass_by("inout") ::=
    %"modify" %"*" %IDENTIFIER
<vargs-param> @declares($2, "param") @direction($2, "consume") @pass_by("consume") ::=
    %"consume" %"*" %IDENTIFIER %":" <type-spec>
<vargs-param> @declares($2, "param") @direction($2, "consume") @pass_by("consume") ::=
    %"consume" %"*" %IDENTIFIER
<vargs-param> @declares($2, "param") @direction($2, "out") @pass_by("out") ::=
    %"out" %"*" %IDENTIFIER %":" <type-spec>
<vargs-param> @declares($2, "param") @direction($2, "out") @pass_by("out") ::=
    %"out" %"*" %IDENTIFIER
<vargs-param> @declares($1, "param") @direction($1, "in") @pass_by("in") ::=
