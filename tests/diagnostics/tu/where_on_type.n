// A `where` clause after a type is rejected rather than dropped unchecked;
// one after a function signature or a trait name is still checked.
func middle(a: int, b: 'U where 'U: Integer, c: int) -> int {
    return a + c
}
func last(x: 'T where 'T: Integer, y: int) -> int {
    return y
}
func trailing(x: 'T where 'T: Integer,) -> int {
    return 1
}
func local() {
    var x: 'T where 'T: Integer = "hi"
}
trait Sized where 'T: Equal {
    func size(self: 'T) -> int
}
func checked(x: 'T) -> 'T where 'T: Integer {
    return x
}
func sized(x: 'T) -> int where 'T: Sized {
    return x.size()
}
require checked("no") == "no"
