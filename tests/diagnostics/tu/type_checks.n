func narrow() -> u8 {
    let small: u8 = 200 + 100
    return small
}

narrow()
func big() -> u64 {
    return 5
}
require big() != 0x10000000000000000
record P {
    x: u32
}

object Counter_2 {
    count: int
}

const FIXED: Counter_2 = (count = 1)
const bytes: Array[u8] = new[Array[u8]](4)
const grid: Array[Array[u8]] = new[Array[Array[u8]]](2, 2)
const points: Array[P] = [(x = 1), (x = 2)]

func element() {
    bytes[1] = 2
}

func compound() {
    bytes[1] += 2
}

func nested() {
    grid[1][0] = 3
}

func field() {
    points[0].x += 4
}

element()
compound()
nested()
field()
FIXED.count = 5
require points[0].x == 1
