# A function reference remembers its function's passing modes, which are no
# part of its type, wherever it is held, a generic function's too: a call
# through it passes a `modify` argument's place, which a `let` can't give.
record Tally {
    count: int
}
func add(modify tally: Tally, by: int) -> int {
    tally.count += by
    return tally.count
}
func apply(f: Ref[(Tally, int) -> int], modify tally: Tally) -> int {
    var one = 1
    return f.call(tally, one)
}
func replaced(modify old: 'T, given: 'T) -> 'T {
    old = given
    return given
}
func use() -> int {
    var tally: Tally
    tally.count = 0
    var held: Ref[(Tally, int) -> int] = ref add
    _ = held
    let fixed = tally
    let kept: Ref[(Tally, int) -> int] = ref add
    _ = kept.call(fixed, 1)
    var generic: Ref[(int, int) -> int] = ref replaced
    _ = generic
    return apply(ref add, tally)
}
require use() == 1
