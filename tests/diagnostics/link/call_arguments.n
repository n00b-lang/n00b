func twice(n: int) -> int {
    return n * 2
}

require twice("four") == 8
record Label { s: string }
func label(s: string) -> Label {
    return (s = s)
}
func __enter(self: Label) { }
func __exit(self: Label, value: nil, failure: 'E? = nil) -> bool { return false }

func f(x: int) -> int {
    return x
}

var b: Buffer = buffer_from_string("abc")
with label("a", "b") {
}
with label() {
}
with label(s = b) {
    b += "x"
}
with label(s = 1) {
}
with label(b) {
    b += "x"
}
require f(x = "str") == 1
func add(a: int, b: int) -> int {
    return a + b
}

require add(1) == 3
func area(width: int, height: int) -> int {
    return width * height
}

require area(2, width = 3) == 6
