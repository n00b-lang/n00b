}

record Foo {
    inner: Ref[Leaf]
}

object Outer {
    x: Ref[Foo]
}

var kept: Counter_1? = nil
var kept_leaf: Ref[Leaf]? = nil

func leak(view c: Counter_1) {
    kept = c
}

func leak_nested(view o: Outer) {
    kept_leaf = o.x.inner
}
