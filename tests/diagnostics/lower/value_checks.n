func phase() -> int {
    if comptime() {
        return 1
    }
    return 2
}

const at_build: int = phase()

func start() -> nil {
    require phase() + at_build == 3
}
var counter: int = 0

func classify(x: u8) -> int {
    if x <= 255 {
        return 1
    }
    return 0
}

func halve(n: int, d: int) -> int {
    if d < 5 {
        return n / d
    }
    return n
}

func shift(v: u32, s: u32) -> u32 {
    if s < 40 {
        return v >> s
    }
    return v
}

func bump(x: u8) -> u8 {
    return x % 100 + 200
}

func fine(x: u8) -> u8 {
    if x < 50 {
        return x + 200
    }
    return x
}

func square(n: int) -> int {
    return n * n
}

func add(n: int) -> int {
    counter += n
    return counter
}

func checked(n: int) -> int {
    require n > 0
    return n
}

square(4)
add(2)
checked(1)
require counter == 2
require classify(1) + halve(4, 2) == 3
require shift(8, 1) == 4
require bump(1) + fine(1) == 202
