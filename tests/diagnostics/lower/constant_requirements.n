func literals() {
    if 1 == 2 {
        __fd_write(2, "never\n")
    }
    if 1 != 2 {
        __fd_write(2, "always\n")
    }
    while 1 == 2 {
        __fd_write(2, "never\n")
    }
}

func requirements(x: int) {
    let a: int = 3
    require a == 3
    require x > 0
    assert a != 3
}

func failing() {
    require 1 == 2
}
