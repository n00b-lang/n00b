var counter = 0
func bump() -> bool {
    counter = counter + 1
    return true
}
func f() -> int {
    assert bump()
    return counter
}
func fill(target: Ref[int]) -> bool {
    target.__value = 7
    return true
}
var value: int = 0
assert fill(ref value)
require f() >= 0
require value == 7
object Counter_1 {
    count: int
}
func drop(consume c: Counter_1) {
}
func f_1() {
    var c: Counter_1 = (count = 1)
    drop(c)
    drop(c)
}
f_1()
record Pair {
    x: int
    y: int
}

func total(p: Pair) -> int {
    return p.x + p.y
}

func first(r: Ref[Pair]) -> int {
    r.__value.y = r.__value.x
    return r.__value.y
}

var pointer_state: Atomic[Ref[byte]?]
var p: Pair
var q: Pair
p.x = 1
let observed: Ref[byte]? = __atomic_load(ref pointer_state)
require total(p) == 1
require observed == nil
require first(ref q) == 0
