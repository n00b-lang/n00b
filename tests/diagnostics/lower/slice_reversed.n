// A slice's start may not come after its end; with constant bounds that
// count from the same end, that's known without running the program.
func slices(items: Array[int]) -> uint {
    let backwards = items[3:1]
    let from_end = items[-1:-3]
    let through = items[3 to 1]
    let meets = items[3:3]
    let one_short = items[3 to 2]
    let mixed = items[3:-4]
    return backwards.len() + from_end.len() + through.len() + meets.len() + one_short.len() + mixed.len()
}

require slices([1, 2, 3, 4, 5]) == 0
