import sys.clock
import sys.env

func stamp() -> uint {
    return sys.clock.now_ns()
}

func render(page: string) -> string {
    forbids_effect(impure)
    if stamp() == 0 {
        return ""
    }
    return page
}

func area(w: int, h: int) -> int {
    forbids_effect(impure) and !may_write(w)
    return w * h
}

func quit(code: int) {
    sys.env.exit(code)
}

func leave(code: int) {
    has_effect(output) and has_effect(noreturn)
    quit(code)
}

func maybe_leave(code: int) {
    has_effect(noreturn)
    if code != 0 {
        quit(code)
    }
}

func steady(code: int) -> int {
    forbids_effect(noreturn) or may_effect(output)
    return code + 1
}

func reads_only(items: List[int]) -> uint {
    may_read(items) and !may_write(items)
    return items.len()
}

func writes(items: List[int]) {
    !may_write(items)
    items.append(1)
}

func mixed(x: int) -> int {
    forbids_effect(output) and x > 3
    return x
}

func unknowns(x: int) {
    forbids_effect(teleport)
    has_effect(impure)
    may_read(z)
}

forbids_effect(area, clock)
may_effect(render, clock)
!may_write(area, h)
has_effect(leave, output)
forbids_effect(render, clock)
may_effect(output)
