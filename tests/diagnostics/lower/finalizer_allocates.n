object Handle {
    fd: int
}

var log: Buffer = buffer_from_string("closed:")

func __finalize(consume self: Ref[Handle]) {
    log += "x"
}

object Counted {
    n: int
}

var closed: Atomic[uint] = 0

func __finalize(consume self: Ref[Counted]) {
    __atomic_fetch_add(ref closed, 1)
}

func __init(self: Handle, fd: int) {
    self.fd = fd
}

func __init(self: Counted, n: int) {
    self.n = n
}

var h: Handle = new[Handle](3)
var c: Counted = new[Counted](1)
require h.fd + c.n == 4
