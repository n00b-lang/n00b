// A constant index or slice bound outside an array of known length is
// reported without running the program.
record Holder {
    tags: Array[int][2]
}

var fixed: Array[int][3]

func indexes() -> int {
    var grid: Array[int][2][3]
    var holder: Holder
    fixed[3] = 1
    let low = fixed[-4]
    let row = grid[2][0]
    let column = grid[1][3]
    let tag = holder.tags[2]
    let fine = fixed[2] + fixed[-3] + grid[-2][2] + holder.tags[-1]
    return low + row + column + tag + fine
}

require indexes() == 0
