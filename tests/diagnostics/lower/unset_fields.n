# A local whose address is taken is set and read through it, a field at a
# time or by the calls it's handed to; every read needs what it reads set.

record Pair {
    a: int
    b: int
}

record Outer {
    inner: Pair
    c: int
}

record Slots {
    values: Array[int][2]
    count: int
}

func first(p: Ref[Pair]) -> int {
    return p.__value.a
}

func other_field() -> int {
    var p: Pair
    p.a = 1
    return p.b
}

func handed_to_reader() -> int {
    var p: Pair
    return first(ref p)
}

func nested() -> int {
    var o: Outer
    o.inner.a = 1
    o.c = 3
    return o.inner.b
}

func one_branch(flag: bool) -> int {
    var p: Pair
    if flag {
        p.a = 1
        p.b = 1
    }
    return p.a
}

func scalar_beside_array() -> int {
    var s: Slots
    s.values[0] = 1
    return s.count
}

_ = other_field()
_ = handed_to_reader()
_ = nested()
_ = one_branch(true)
_ = scalar_beside_array()
