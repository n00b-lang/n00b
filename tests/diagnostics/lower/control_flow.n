let a = []
func f() -> int {
    break
    return 1
}
require f() == 1
func g(n: int) -> int fail: string {
    if n < 0 {
        fail "negative"
    }
    return n
}
func f_1() -> int {
    return g(3)
}
require f_1() == 3
func f_2() -> int {
    let a: int
    for i from 0 until 3 {
        a = i
    }
    return 0
}
require f_2() == 0
func f_3(n: int, b: bool) -> bool {
    return b and n
}
require f_3(1, true)
