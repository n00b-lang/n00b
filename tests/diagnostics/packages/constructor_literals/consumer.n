import shapes
import sealed

let made: shapes.Built = new[shapes.Built](1)
let local: shapes.Built = (x = 1)
require made.x == 2 and local.x == 1 and shapes.raw_built(1).x == 1

let built: sealed.Sealed = new[sealed.Sealed](1)
let hidden: sealed.Sealed = (shown = 1, hidden = 2)
require built.shown == hidden.shown

let casted = cast[shapes.Built]((x = 1))
let sealed_cast = cast[sealed.Sealed]((shown = 1, hidden = 2))
let reinterpreted = unsafe_cast[sealed.Sealed]((shown = 1, hidden = 2))
require casted.x == sealed_cast.shown and reinterpreted.shown == 1
