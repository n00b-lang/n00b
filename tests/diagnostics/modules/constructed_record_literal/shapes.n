record Built {
    x: int
}

func __init(modify self: Built, x: int) {
    self.x = x + 1
}

// The module that defines `Built` may build it field by field, bypassing
// its constructor.
func raw_built(x: int) -> Built {
    return (x = x)
}

// With no `__init`, a field tuple from any package may build it.
record Plain {
    x: int
}

record Holder {
    built: Built
}
