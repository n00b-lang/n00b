// On the package path, so another module than the test.
record Plain {
    x: int
}

record Holder {
    v: 'T
}

enum Level { low, high }

callback Pick {
    call (left: 'T, right: 'T) -> 'T
    handler (left: 'T, right: 'T) -> 'T
}

callback Count {
    call (n: int) -> int
    handler (n: int) -> int
}
