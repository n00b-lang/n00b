import sys.gc.finalize
import sys.gc.alloc

var kept: List[string] = new[List[string]]()
func keep(s: string) {
    kept.append(s)
}
func escape_site() -> uint {
    var b: Buffer = buffer_from_string("kept")
    let view: string = b
    let n: uint = byte_len(view)
    keep(view)
    return n
}
escape_site()
func failing() -> uint fail: string {
    var b: Buffer = buffer_from_string("kept")
    let view: string = b
    fail view
}
try {
    let n: uint = failing()!
} fail(e) {
}
record Holder_2 { text: string }
func keep_2() -> uint {
    var b: Buffer = buffer_from_string("kept")
    var holder: Holder_2 = (text = "")
    holder.text = b
    return byte_len(holder.text)
}
keep_2()


var g_3: Buffer = buffer_from_string("kept")
func drain() -> uint {
    let m: Ref[sys.gc.core.Mutator]? = sys.gc.alloc.mutator_for_native()
    if m == nil {
        return 0
    }
    return sys.gc.finalize.run(m.get().heap, 0)
}
func finalizer_run() -> uint {
    let view: string = g_3
    let n: uint = drain()
    return byte_len(view) + n
}
finalizer_run()
var g_4: Buffer = empty_buffer()
func make_4() -> Buffer {
    let x: Buffer = buffer_from_string("kept")
    g_4 = x
    return x
}
func grow() {
    g_4 += "!"
}
func fresh_global() -> uint {
    let b: Buffer = make_4()
    let view: string = b
    grow()
    return byte_len(view)
}
fresh_global()
func make_5(out c: Buffer) -> Buffer {
    let x: Buffer = buffer_from_string("kept")
    c = x
    return x
}
func fresh_out() -> uint {
    var c: Buffer = empty_buffer()
    let b: Buffer = make_5(c)
    let view: string = b
    c += "!"
