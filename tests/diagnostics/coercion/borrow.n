}
fresh_out()
callback Step {
    call(value: int) -> int
    handler(value: int) -> int
}
func bump(value: int) -> int {
    return value + 1
}
func make_6() -> Step {
    return callback[Step](ref bump)
}
func call_inside() -> uint {
    var b: Buffer = buffer_from_string("kept")
    let step: Step = make_6()
    let view: string = b
    let n: int = step.call(1)
    return byte_len(view) + cast[uint] n
}
call_inside()
func loop_inside() -> uint {
    var b: Buffer = buffer_from_string("kept")
    let view: string = b
    var total: uint = 0
    var i: int = 0
    while i < 3 {
        total = total + byte_len(view)
        i = i + 1
    }
    return total
}
loop_inside()
record Pair {
    b: Buffer
    n: int
}
func memcpy_record() -> uint {
    var first: Pair = (b = buffer_from_string("kept"), n = 1)
    var second: Pair = (b = buffer_from_string("other"), n = 2)
    let view: string = first.b
    __gc_memcpy(unsafe_cast[Ref[byte]] ref second,
                unsafe_cast[Ref[byte]] ref first, 16)
    second.b += "!"
    return byte_len(view)
}
memcpy_record()
func forward(s: string, out t: string) {
    t = s
}
func out_view() -> uint {
    var b: Buffer = buffer_from_string("kept")
    var t: string = ""
    forward(b, t)
    b += "!"
    return byte_len(t)
}
out_view()
func hold(s: string) -> Ref[string] {
    var h: string = s
    return ref h
}
func ref_local() -> uint {
    var b: Buffer = buffer_from_string("kept")
    let r: Ref[string] = hold(b)
    b += "!"
    let t: string = r.__value
    return byte_len(t)
}
ref_local()
record Holder_11 { b: Buffer }
func fill(first: Ref[Holder_11], second: Ref[Holder_11]) {
    let x: Buffer = buffer_from_string("kept")
    first.b = x
    second.b = x
}
func ref_params() -> uint {
    var p: Holder_11 = (b = empty_buffer())
    var q: Holder_11 = (b = empty_buffer())
    fill(ref p, ref q)
    let view: string = p.b
    q.b += "!"
    return byte_len(view)
}
ref_params()
func ref_view() -> uint {
    var b: Buffer = buffer_from_string("kept")
