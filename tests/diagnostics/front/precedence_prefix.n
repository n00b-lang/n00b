var p: bool = true
var q: bool = false
var a: int = 7
var b: int = 2
let negated = not p == q
let symbol = !p == q
let divided = cast[f64] a / 2.0
let widened = unsafe_cast[i64] a + 1
let referenced = ref a + b
let not_and = not p and q
let grouped = cast[f64](a) / 2.0
let negative = -a * b
let complement = ~a & b
