import ids
import state
import sys.threads

var shared: int = 0
var seen: Dict[string, int] = {}

func worker() {
    shared += 1
}

func comptime_main() {
    state.count = 77
}

func main() {
    require sys.threads.thread_start(
        callback[sys.threads.Thread_Entry](ref worker))
    shared += 1
    seen["count"] = state.count
    __fd_write(2, "ok")
}
