# Calls through function references a library made, typed and linked
# against the library's archived interface (reference_archive.sh). A call
# through a reference whose function isn't known is given variables, which
# it may write.
import modlib

func through(f: Ref[(modlib.Tally, int) -> int], start: int,
             by: int) -> int {
    var tally: modlib.Tally
    tally.count = start
    var amount = by
    let returned = f.call(tally, amount)
    return tally.count * 1000 + returned
}

func ordered_through(f: Ref[(int, b: int, zz: int) -> int]) -> int {
    var five = 5
    var seven = 7
    var three = 3
    return f.call(five, b = seven) + f.call(five, zz = three)
}

func run() {
    var t: modlib.Tally
    t.count = 1
    var two = 2
    let f = modlib.module_add()
    require f.call(t, two) == 3
    require t.count == 3
    let direct = ref modlib.tally_add
    require direct.call(t, 1) == 4
    require t.count == 4
    require through(modlib.module_add(), 1, 4) == 5005
    require through(ref modlib.tally_add, 2, 2) == 4004
    require modlib.apply(ref modlib.tally_add, t, 10) == 14
    require t.count == 14
    var five = 5
    var seven = 7
    var three = 3
    let g = modlib.module_ordered()
    require g.call(five) == 512
    require g.call(five, b = seven, zz = three) == 537
    require ordered_through(modlib.module_ordered()) == 517 + 532
    require ordered_through(ref modlib.ordered) == 517 + 532
}
run()
__fd_write(2, "ok")
