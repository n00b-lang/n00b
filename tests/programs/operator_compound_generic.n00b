func accumulate(left: `T, right: `A) -> `T fail: `E where `T: Add {
    var value = left
    value += right
    return value
}

func integers(left: int, right: int) -> int {
    return accumulate(left, right)!
}

func strings(left: string, right: string) -> string {
    return accumulate(left, right)!
}
