func measure(s: string) -> uint {
    return byte_len(s)
}

func call_argument() -> uint {
    var b: Buffer = buffer_from_string("argument")
    return measure(b)
}

func local_then_other_write() -> uint {
    var source: Buffer = buffer_from_string("source")
    var other: Buffer = buffer_from_string("other")
    let view: string = source
    let length: uint = byte_len(view)
    other += "!"
    return length + byte_len(other)
}

func distinct_concat() -> uint {
    var a: Buffer = buffer_from_string("left")
    var b: Buffer = buffer_from_string("right")
    concat(a, b)
    return byte_len(a)
}

record Holder {
    b: Buffer
}

record Named {
    n: uint
}

func __init(modify self: Named, s: string) {
    self.n = byte_len(s)
}

func build_from(source: Buffer) -> uint {
    var out: Buffer = empty_buffer()
    out += source
    out += source
    return byte_len(out)
}

func loop_slice() -> uint {
    var b: Buffer = buffer_from_string("ab")
    var total: uint = 0
    var i: int = 0
    while i < 3 {
        let view: string = b
        total += byte_len(view)
        b += "c"
        i += 1
    }
    return total
}

func held_field() -> uint {
    let h: Holder = (b = buffer_from_string("held"))
    return measure(h.b)
}

func constructed() -> uint {
    var b: Buffer = buffer_from_string("named")
    let x: Named = new[Named](b)
    return x.n
}

func indexed() -> uint {
    var l: List[Buffer] = new[List[Buffer]]()
    l.append(buffer_from_string("idx"))
    let view: string = l[0]
    return byte_len(view)
}

func interleaved() -> uint {
    var a: Buffer = buffer_from_string("aa")
    var b: Buffer = buffer_from_string("bbb")
    let first: string = a
    let second: string = b
    let n: uint = byte_len(first)
    a += "!"
    return n + byte_len(second)
}

func append_in_place() -> uint {
    var a: Buffer = buffer_from_string("grow")
    a += "x"
    return byte_len(a)
}

func forward(s: string, out t: string) {
    t = s
}

func out_view() -> uint {
    var b: Buffer = buffer_from_string("forward")
    var t: string = ""
    forward(b, t)
    let n: uint = byte_len(t)
    b += "!"
    return n + byte_len(b)
}

var swapped: Buffer = buffer_from_string("global")

func reassign_global() -> uint {
    let view: string = swapped
    swapped = buffer_from_string("other")
    return byte_len(view)
}

record Tagged {
    b: Buffer
    n: int
}

func field_writes(t: Ref[Tagged]) -> uint {
    let view: string = t.__value.b
    t.__value.n = 5
    t.__value.b = buffer_from_string("replaced")
    return byte_len(view)
}

func freed() -> uint {
    var b: Buffer = buffer_from_string("gone")
    free(b)
    b += "x"
    return byte_len(b)
}

var kept: List[string] = new[List[string]]()

func keep(s: string) {
    kept.append(s)
}

func written_while_sliced() -> bool {
    var b: Buffer = buffer_from_string("a long enough buffer text")
    let view: string = b
    b += "!"
    return view == "a long enough buffer text"
        and to_string(b) == "a long enough buffer text!"
}

func kept_by_callee() -> bool {
    var b: Buffer = buffer_from_string("another long buffer of text")
    keep(b)
    b += "!"
    return kept[0] == "another long buffer of text"
}

func returned_slice(b: Buffer) -> string {
    return b
}

func written_after_return() -> bool {
    var b: Buffer = buffer_from_string("a returned long buffer text")
    let view: string = returned_slice(b)
    b += "!"
    return view == "a returned long buffer text"
}

func written_after_end() -> bool {
    var b: Buffer = buffer_from_string("the third long buffer text")
    let n: uint = byte_len(b)
    b += "?"
    return n == 26 and to_string(b) == "the third long buffer text?"
}

func released() -> bool fail: Buffer_Error {
    var b: Buffer = buffer_from_string("a buffer long enough to live on the heap")
    b.set_index(0, 65)!
    let before: uint = string_backing_at(b)
    b.set_index(1, 66)!
    let after: uint = string_backing_at(b)
    let s: string = to_string(b)
    return before == after and string_backing_at(s) == before
}

func compared_by_contents() -> bool {
    var a: Buffer = buffer_from_string("hello there")
    var b: Buffer = buffer_from_string("hello there")
    var c: Buffer = buffer_from_string("other text")
    var seen: Dict[Buffer, int] = {a: 1}
    let hit: int? = seen[b]
    return a == b and a != c and a.hash() == b.hash()
        and a == "hello there" and "hello there" == a
        and hit != nil and hit == 1
}

require written_while_sliced()
require compared_by_contents()
try {
    require released()!
} fail(e) {
    require false
}
require kept_by_callee()
require written_after_return()
require written_after_end()
var tagged: Tagged = (b = buffer_from_string("tag"), n = 0)
require field_writes(ref tagged) == 3
require tagged.n == 5
require byte_len(tagged.b) == 8
require freed() == 1
var previous: Buffer = swapped
require reassign_global() == 6
swapped += "!"
previous += "!"
require byte_len(swapped) == 6
require byte_len(previous) == 7
require out_view() == 15
require append_in_place() == 5
require build_from(buffer_from_string("xy")) == 4
require loop_slice() == 9
require held_field() == 4
require constructed() == 5
require indexed() == 3
require interleaved() == 5
require call_argument() == 8
require local_then_other_write() == 12
require distinct_concat() == 9
__fd_write(2, "buffer slices ok\n")
