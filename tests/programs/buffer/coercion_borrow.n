func measure(s: string) -> uint {
    return byte_len(s)
}

func call_argument() -> uint {
    var b: Buffer = buffer_from_string("argument")
    return measure(b)
}

func local_then_other_write() -> uint {
    var source: Buffer = buffer_from_string("source")
    var other: Buffer = buffer_from_string("other")
    let view: string = source
    let length: uint = byte_len(view)
    other += "!"
    return length + byte_len(other)
}

func distinct_concat() -> uint {
    var a: Buffer = buffer_from_string("left")
    var b: Buffer = buffer_from_string("right")
    concat(a, b)
    return byte_len(a)
}

require call_argument() == 8
require local_then_other_write() == 12
require distinct_concat() == 9
__fd_write(2, "coercion borrow ok\n")
