trait Render {
    func render(self: 'T) -> string
    func size(self: 'T) -> int
    !may_effect(render, output) or has_effect(render, clock)
    !(may_effect(size, input) and may_effect(size, output))
    forbids_effect(render, input) or forbids_effect(size, input)
    not (has_effect(size, clock))
}

has_effect(g, alpha.Audited)
forbids_effect(h, alpha.Audited)

func checked() -> bool {
    return may_effect(io.Read) and forbids_effect(checked, impure)
}
