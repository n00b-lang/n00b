type State {
    count: int
}

callback Incompatible_Setup {
    call(value: int) -> int
    handler(modify state: State, value: int) -> int
    setup(handler: Ref[(modify state: State, value: int) -> int],
          state: Ref[State]) -> nil
}

func handle(modify state: State, value: int) -> int {
    return value
}

func setup(handler: Ref[(modify state: State, value: int) -> int],
           state: Ref[string]) -> nil {
}

func make(modify state: State) -> Incompatible_Setup {
    return callback[Incompatible_Setup](ref handle, ref state)
}
