# Regression checks for the small punch-list fixes; run by
# tests/punch_list_small.sh, which expects exactly `ok` on stderr.

# Arithmetic, bitwise and shift operators in `when` conditions.
when (7 % 4) * 2 - 1 == 5 and (1 << 3) | 1 == 9 and 6 / 2 == 3
        and (5 & 4) ^ 1 == 5 and 8 >> 1 == 4 {
    let arithmetic_when = true
} else {
    let arithmetic_when = false
}

# `pass` as the whole body of a module-level `when`.
when false { pass }

# `target_arch()` gives the triple's architecture.
when target_arch() == "arm64" or target_arch() == "x86_64" {
    let known_arch = true
} else {
    let known_arch = false
}

# `-D PUNCH_FLAG` with no `=` defines the name as `true`; the shell test
# builds with it.
when preproc_defines("PUNCH_FLAG") and preproc_value("PUNCH_FLAG") {
    let bare_define = true
} else {
    let bare_define = false
}

private alias Count = int

type Meters = int
type Name = string

# Postfix `!` on an option fails with `nil` when the failure type is an
# option.
func next_count(x: Count?) -> Count fail: string? {
    return x! + 1
}

func counted(x: Count?) -> Count {
    return try { -> next_count(x)! } fail (e) { -> -1 }
}

func inside_try(x: int?) -> int {
    return try { -> x! } fail () { -> 7 }
}

func reachable(x: int) -> int {
    if x > 0 { return 1 }
    unreachable()
}

func pick(x: int) -> int {
    switch x {
        case 1 { return 10 }
        case 2, 3 { return 20 }
        default { return 30 }
    }
}

func same_meters(a: Meters, b: Meters) -> bool {
    return a == b
}

func same_name(a: Name, b: Name) -> bool {
    return a == b
}

require arithmetic_when
require known_arch
require bare_define
require "\« \» \[" == "« » ["
require counted(3) == 4
require counted(nil) == -1
require inside_try(nil) == 7
require inside_try(2) == 2
require reachable(5) == 1
require pick(1) == 10 and pick(3) == 20 and pick(9) == 30
require True and not False
let two: Meters = 2
let three: Meters = 3
require same_meters(two, two) and !same_meters(two, three)
require same_name(cast[Name]("a"), cast[Name]("a"))
require !same_name(cast[Name]("a"), cast[Name]("b"))
let small: i8 = -128
let wide: int = -42
let byte_value: u8 = 200
require decimal(small) == "-128"
require decimal(wide) == "-42"
require decimal(byte_value) == "200"

# `i:N` and `u:N` are integers (`bits:N` is not): they implement `Integer`
# and widen to wider parameters. `ten` is a module variable, so its value
# comes from static storage, which an optimized load reads as an `i10`.
func from_bits_of(x: 'T, bits: u128) -> 'T where 'T : Integer {
    return x.from_bits(bits)
}
func widened(x: int) -> int {
    return x
}
let ten: i:10 = -3
let unsigned_ten: u:10 = 1000
require widened(ten) == -3
require decimal(ten) == "-3"
require decimal(unsigned_ten) == "1000"
require hex(unsigned_ten) == "0x3e8"
require from_bits_of(ten, 0x3ff) == cast[i:10](-1)
require from_bits_of(unsigned_ten, 0x401) == cast[u:10](1)

# Literals up to 2^128 - 1 size as `u128` and compute at that width.
let widest = 340282366920938463463374607431768211455
require widest - 1 == 340282366920938463463374607431768211454

# A module constant's value sizes the literals it meets: 6_000_000_000
# fits a `uint`.
let two_billion = 2_000_000_000
let six_billion = two_billion * 3
require six_billion == 6_000_000_000

# Set literals that meet are sized together (`u16` for both here), so
# their union types.
func union_size() -> uint {
    let small = {1, 2}
    let large = {300, 4}
    return len(small + large)
}
require union_size() == 4

# Built-in integer operators on operands of different types run at a type
# holding both, never narrowing an operand; a literal is sized from its own
# value; an inferred operand widens to hold the declared type it meets; a
# smaller declared target gets a checked narrowing.
func mixed_add(a: u8, b: u16) -> u16 {
    return a + b
}
func signed_mix(a: u8, b: i8) -> i16 {
    return a + b
}
func word_mix(a: uint, b: int) -> int {
    return a + b
}
func literal_left(a: u8) -> u16 {
    return 1000 + a
}
func literal_right(a: u8) -> u16 {
    return a + 1000
}
func negated(a: u8) -> i16 {
    return a * -1
}
func inferred_meets(a: u8) -> uint {
    var x = 1000
    x = x + 1
    return x + a
}
func narrowed(a: u16, b: u8) -> u8 {
    let r: u8 = a + b
    return r
}
func counter_product(n: uint) -> uint {
    var i = 4
    while i < n {
        i += 1
    }
    return 32 * (i - 4)
}
require mixed_add(200, 1000) == 1200
require signed_mix(200, -100) == 100
require word_mix(5, -10) == -5
require literal_left(200) == 1200 and literal_right(200) == 1200
require negated(200) == -200
require inferred_meets(200) == 1201
require narrowed(100, 20) == 120
require counter_product(6) == 64
let small_byte: u8 = 200
let wide_word: u16 = 1000
require small_byte < wide_word and !(small_byte == wide_word)

# Mixing an int and a float in an operation gives a float (#6); the int
# converts, rounding to nearest. Only in such an operation: an int is not
# otherwise a float. `cast[]` converts explicitly by the same rule.
let mixed_literals = 1.5 + 2
let half = 0.5
var float_count = 0.5
float_count = float_count + 1
let int_two = 2
func float_plus_int(f: float, n: int) -> float {
    return f + n
}
func int_times_float(n: int, f: float) -> float {
    return n * f
}
func inferred_int_meets_float(f: float) -> float {
    var n = 2
    return f + n
}
func module_int_meets_float(f: float) -> float {
    return f + int_two
}
func narrow_float_mix(f: f32, n: i16) -> f32 {
    return f + n
}
require mixed_literals == 3.5
require half + 1 == 1.5 and float_count == 1.5
require float_plus_int(0.5, 2) == 2.5 and int_times_float(3, 0.5) == 1.5
require inferred_int_meets_float(0.5) == 2.5
require module_int_meets_float(0.5) == 2.5
require narrow_float_mix(cast[f32](0.5), 2) == cast[f32](2.5)
require half < 3 and 2.0 == int_two
require cast[float](-3) == -3.0
require cast[f32](cast[u8](200)) == cast[f32](200.0)
require cast[float](cast[i128](9007199254740993)) == 9007199254740992.0

# An element read from a `typecase` arm's `Array['T]` over `Any` has the
# arm's type `'T`, whose runtime type is the one the boxed subject holds.
# Each arm's `'T` is its own, and a generic function's own variables stay
# apart from them.
func element_kind(x: 'T) -> string {
    typecase x {
        case int { return "int" }
        case string { return "string" }
        else { return "other" }
    }
}
func first_element_kind(b: Any) -> string {
    typecase b {
        case Dict['K, 'T] { return "dict" }
        case List['T] {
            let item = b[0]
            return element_kind(item)
        }
        case Array['T] {
            let item = b[0]
            return element_kind(item) + "!"
        }
        else { return "none" }
    }
}
func element_and_own(z: 'U, b: Any) -> string {
    typecase b {
        case Array['T] { return element_kind(b[0]) + element_kind(z) }
        else { return "none" }
    }
}
let element_ints: Array[int] = [1, 2]
let element_words: List[string] = ["w"]
let element_own: int = 3
require first_element_kind(cast[Any] element_ints) == "int!"
require first_element_kind(cast[Any] element_words) == "string"
require element_and_own(element_own, cast[Any] element_ints) == "intint"
require element_and_own("s", cast[Any] element_ints) == "intstring"

# A `where` clause after a type in a function constrains the function's
# variable of that name; clauses on one variable add up.
func where_middle(a: int, b: 'U where 'U: Integer, c: int) -> int {
    return a + c
}
func where_both(x: 'T where 'T: Integer) -> 'T where 'T: Hash {
    return x
}
func where_in_body(x: 'T) -> 'T {
    var y: 'T where 'T: Integer = x
    return y
}
func where_local() -> int {
    var x: 'T where 'T: Integer = 5
    return x
}
trait Where_Grows {
    func grow(self: 'T, by: 'N where 'N: Integer) -> 'T
}
record Where_Plant { height: int }
func grow(self: Where_Plant, by: int) -> Where_Plant {
    return (height = self.height + by)
}
func where_grown(x: 'T) -> 'T where 'T: Where_Grows { return x.grow(2) }
let where_plant: Where_Plant = (height = 1)
require where_middle(1, 2, 3) == 4 and where_both(2) == 2
require where_in_body(3) == 3 and where_local() == 5
require where_grown(where_plant).height == 3

# One in a record, variant or alias constrains the type's parameter, which
# each use gives a type that satisfies it.
record Where_Box {
    v: 'T where 'T: Integer
}
variant Where_Maybe {
    some: 'T where 'T: != string
    none: nil
}
alias Where_Bag = Dict['K, nil] where 'K: Integer
func where_boxed(b: Where_Box[int]) -> int { return b.v }
func where_bagged(b: Where_Bag['U]) -> uint { return b.len() }
func where_maybe() -> int {
    var m: Where_Maybe[int]
    m.some = 7
    switch m {
        case some { return 7 }
        case none { return 0 }
    }
}
let where_box: Where_Box[int] = (v = 4)
let where_bag: Where_Bag[u8] = {cast[u8](1): nil, cast[u8](2): nil}
require where_boxed(where_box) == 4 and where_maybe() == 7
require where_bagged(where_bag) == 2

# A clause may follow a type argument, a parameter of a function type or a
# parenthesized type.
func where_ints(xs: List['T where 'T: Integer]) -> uint { return xs.len() }
func where_optional(x: ('T where 'T: Integer)?) -> int { return 1 }
func where_calls(r: Ref[('T where 'T: Integer) -> 'T]) -> int { return 1 }
func where_twice(x: int) -> int { return x * 2 }
alias Where_Keys = Dict['K where 'K: Integer, nil]
func where_keyed(k: Where_Keys['U]) -> uint { return k.len() }
let where_numbers: List[int] = [1, 2]
let where_maybe_number: int? = 3
let where_keys: Dict[int, nil] = {1: nil}
require where_ints(where_numbers) == 2
require where_optional(where_maybe_number) == 1
require where_calls(ref where_twice) == 1 and where_keyed(where_keys) == 1

# A `!=` clause rules out only the type it names.
func where_not_string(x: 'T) -> 'T where 'T: != string { return x }
func where_through(x: 'U) -> 'U { return where_not_string(x) }
require where_not_string(3) == 3 and where_through(2.5) == 2.5

# A generic alias of an array, an option or a tuple: its target owns its
# type variables in the program's metadata.
alias Alias_Ints = Array['T]
alias Alias_Maybe = 'T?
alias Alias_Pair = Tuple['A, 'B]
func alias_count(x: Alias_Ints['U]) -> uint { return x.len() }
func alias_values() -> int {
    var numbers: Alias_Ints[int] = [1, 2]
    let maybe: Alias_Maybe[int] = 3
    let pair: Alias_Pair[int, string] = (4, "x")
    require numbers[1] == 2 and alias_count(numbers) == 2
    require maybe == 3 and pair[1] == "x"
    return pair[0]
}
require alias_values() == 4

# A variable given to a constrained type takes on the type's constraint.
func where_make(x: 'T) -> Where_Box['T] { return (v = x) }
require where_make(5).v == 5
__fd_write(2, "ok")
