trait Index_Write {
    func __write(self: `T, index: int, item: Array[int]) -> nil fail: int
}

func __write(self: Array[Array[int]], index: int, item: Array[int]) -> nil fail: int {}

var global_target: Array[int][4]

func accept(input: Array[int][4]) {}

func forward(input: Array[int][]) {
    accept(input)
}

func assign(input: Array[int][]) {
    var target: Array[int][4] = input
    target = input
}

func return_fixed(input: Array[int][]) -> Array[int][4] {
    return input
}

func return_fallible(input: Array[int][]) -> Array[int][4] fail: int {
    return input
}

func assign_global(input: Array[int][]) {
    global_target = input
}

func replace_out(out target: Array[int][4], input: Array[int][]) {
    target = input
}

func update_inout(modify target: Array[int][4], input: Array[int][]) {
    target = input
}

func call_out(input: Array[int][]) {
    var target: Array[int][] = input
    replace_out(target, input)
}

func call_inout(input: Array[int][]) {
    var target: Array[int][] = input
    update_inout(target, input)
}

func call_shaped_return(input: Array[int][]) {
    var target: Array[int][4] = return_fixed(input)
}

func call_fallible_shaped_return(input: Array[int][]) -> Array[int][4] fail: int {
    return return_fallible(input)!
}

func store_shaped_row(matrix: Array[int][4][5], row: Array[int][]) -> nil fail: int {
    matrix [0] = row
}

func catch_shaped_store(matrix: Array[int][4][5], row: Array[int][]) -> nil {
    try { matrix [0] = row } else err { return }
}
