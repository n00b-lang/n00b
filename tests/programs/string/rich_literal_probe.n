import text

let fancy: string = "«b»Hello«/b» «i»world«/i»"'r

func repr_of(s: string) -> string {
    var read_fd: int = -1
    var write_fd: int = -1
    require __os_pipe(ref read_fd, ref write_fd) == 0
    var written: uint = 0
    try {
        written = text.raw_repr_string(s, write_fd, nil)!
    } else failure {
        require false
    }
    require __os_close(write_fd) == 0
    var bytes: Array[u8] = new[Array[u8]](cast[int] written)
    let got: int = __os_read(read_fd, unsafe_cast[Ref[byte]] ref bytes[0],
                             written)
    require got == cast[int] written
    require __os_close(read_fd) == 0
    return from_raw(ref bytes, got)
}

func check_rich(s: string, plain: string, markup: string) {
    require tag(s) == 3
    require byte_len(s) == byte_len(plain)
    var walked: Array[u8] = __text_byte_array(s)
    let flat: string = from_raw(ref walked, cast[int] byte_len(plain))
    require tag(flat) != 3
    require flat == plain
    require repr_of(s) == markup
}

func local_literals() {
    check_rich("«b»Hi«/b»"'r, "Hi", "r\"«b»Hi«/b»\"")
    check_rich("«u»a rich literal well past the inline capacity«/u»"'r,
               "a rich literal well past the inline capacity",
               "r\"«u»a rich literal well past the inline capacity«/u»\"")
    check_rich("x «#» y «#:04d» «#a_rather_long_argument_name»"'r, "x  y  ",
               "r\"x «#0» y «#1:04d» «#a_rather_long_argument_name»\"")
}

check_rich(fancy, "Hello world", "r\"«b»Hello«/b» «i»world«/i»\"")
local_literals()
__fd_write(2, "ok")
