func bytes_of(s: string) -> Array[u8] {
    var out: Array[u8] = new[Array[u8]](cast[int] byte_len(s))
    var i: uint = 0
    while i < byte_len(s) {
        out[i] = byte_at(s, i)
        i += 1
    }
    return out
}

func filled(n: int) -> Array[u8] {
    var out: Array[u8] = new[Array[u8]](n)
    var i: int = 0
    while i < n {
        out[i] = 0x61
        i += 1
    }
    return out
}

func as_text_fails(s: string) -> bool {
    var failed = false
    try {
        as_text(s)!
    } fail(e) {
        failed = e == String_Error.bad_encoding
    }
    return failed
}

func as_text_encoding(s: string) -> Str_Encoding {
    let revealed = try {
        -> encoding(as_text(s)!)
    } fail(e) {
        -> Str_Encoding.binary
    }
    return revealed
}

func encoding_probe() -> string? {
    let long_ascii: string = "abcdefghijklmnopqrstuvwxyz0123456789" +
        "abcdefghijklmnopqrstuvwxyz0123456789"
    if encoding_of(long_ascii) != Str_Encoding.ascii {
        return "1"
    }

    let pair: string = "世界"
    let long_utf8: string = pair + pair + pair + pair + pair + pair + pair +
        pair
    if encoding_of(long_utf8) != Str_Encoding.utf8 {
        return "2"
    }

    var long_bad: Array[u8] = filled(40)
    long_bad[37] = 0xed
    long_bad[38] = 0xa0
    long_bad[39] = 0x80
    if encoding_of(from_raw(ref long_bad, 40)) != Str_Encoding.binary {
        return "3"
    }

    var straddle: Array[u8] = filled(40)
    straddle[15] = 0xf0
    straddle[16] = 0x9f
    straddle[17] = 0x98
    straddle[18] = 0x80
    if encoding_of(from_raw(ref straddle, 40)) != Str_Encoding.utf8 {
        return "4"
    }

    let ascii_lit: string = "plain ascii"
    var ascii_bytes: Array[u8] = bytes_of(ascii_lit)
    let narrowed: string = from_raw(ref ascii_bytes, 11,
                                    encoding = Str_Encoding.utf8)
    if encoding(narrowed) != Str_Encoding.ascii {
        return "5"
    }

    let utf8_lit: string = "世"
    var utf8_bytes: Array[u8] = bytes_of(utf8_lit)
    let kept: string = from_raw(ref utf8_bytes, 3,
                                encoding = Str_Encoding.utf8)
    if encoding(kept) != Str_Encoding.utf8 {
        return "6"
    }

    var bad_bytes: Array[u8] = new[Array[u8]](3)
    bad_bytes[0] = 0xed
    bad_bytes[1] = 0xa0
    bad_bytes[2] = 0x80
    let as_bin: string = from_raw(ref bad_bytes, 3,
                                  encoding = Str_Encoding.binary)
    if encoding(as_bin) != Str_Encoding.binary {
        return "7"
    }
    if !as_text_fails(as_bin) {
        return "8"
    }

    let hidden: string = from_raw(ref utf8_bytes, 3,
                                  encoding = Str_Encoding.binary)
    if as_text_encoding(hidden) != Str_Encoding.utf8 {
        return "9"
    }

    let forced: string = from_raw(ref utf8_bytes, 3,
                                  encoding = Str_Encoding.ascii,
                                  unsafe = true)
    if encoding(forced) != Str_Encoding.ascii {
        return "10"
    }

    if encoding(from_char('a')) != Str_Encoding.ascii {
        return "11"
    }
    if encoding(from_char(cast[char] 0x4e16)) != Str_Encoding.utf8 {
        return "12"
    }

    if encoding(empty_string()) != Str_Encoding.ascii {
        return "13"
    }
    return nil
}

let failed: string? = encoding_probe()
if failed == nil {
    __fd_write(2, "ok")
}
else {
    __fd_write(2, "FAIL string encoding_probe " + failed.get() + "\n")
}
