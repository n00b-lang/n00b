let p: string = [- hello -]

func check(got: string, want: string) {
    require got == want
}

comptime {} else {
    check([- hi -], "hi")
    check([- C:\new -], "C:\\new")
    check([-- has -] in --], "has -] in")
    check([- "q" -], "\"q\"")
    require byte_len(p) == 5
    require byte_at(p, 0) == 0x68 and byte_at(p, 4) == 0x6f
    check(p, "hello")
    __fd_write(2, "ok")
}
