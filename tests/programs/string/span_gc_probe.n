func make_long() -> string {
    var bytes: Array[u8] = new[Array[u8]](4000)
    var i: uint = 0
    while i < 4000 {
        bytes[i] = cast[u8] (0x41 + i % 26)
        i += 1
    }
    return from_raw(bytes, 4000)
}

func churn() {
    var round: uint = 0
    while round < 50000 {
        var junk: Array[u8] = new[Array[u8]](4000)
        var j: uint = 0
        while j < 4000 {
            junk[j] = 0x5a
            j += 64
        }
        round += 1
    }
}

var base: string = make_long()
let span: string = byte_slice(base, 1000, 1100)
require tag(span) == 2
base = ""
churn()
churn()
require byte_len(span) == 100
var i: uint = 0
while i < 100 {
    require byte_at(span, i) == cast[u8] (0x41 + (1000 + i) % 26)
    i += 1
}
__fd_write(2, "ok")
