litmod<dict> build_dict, mirror(items: Array[Tuple[int, int]]) -> Dict[int, int] fail: string {
    return {1: 2}'d
}

func static_dict() -> Dict[int, int] {
    return {1: 2, 3: 4}'mirror
}

func dynamic_dict(x: int) -> Dict[int, int] {
    return {x: 2, 3: 4}'mirror
}

func empty_dict() -> Dict[int, int] {
    return {}'mirror
}
