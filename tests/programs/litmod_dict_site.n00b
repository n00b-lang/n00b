declare_litmod("mirror", "dict", "build_dict")

func build_dict(items: Array[Tuple[int, int]]) -> Dict[int, int] fail: string {
    return d{1: 2}
}

func static_dict() -> Dict[int, int] {
    return mirror{1: 2, 3: 4}
}

func dynamic_dict(x: int) -> Dict[int, int] {
    return mirror{x: 2, 3: 4}
}

func empty_dict() -> Dict[int, int] {
    return mirror{}
}
