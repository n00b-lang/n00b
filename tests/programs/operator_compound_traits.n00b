type Box { value: int }

func __add(left: Box, right: int) -> Box {
    return left
}

func compound(left: Box, right: int) -> Box {
    var value = left
    value += right
    return value
}

func strings(left: string, right: string) -> string {
    var value = left
    value += right
    return value
}

func shifts(left: u:37, count: u:6) -> u:37 {
    var value = left
    value <<= count
    value >>= count
    return value
}
