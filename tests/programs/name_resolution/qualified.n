import pk

let it: pk.Item = (w = 3)
let s: string = "héllo"
let xs: List[int] = [1, 2, 3]
let inferred = [4, 5]
let d: Dict[string, int] = {"a": 1}
let len_value = 7

require pk.a.limit == 1 and pk.b.limit == 2
require pk.a.size(s) == 100 and pk.b.size(s) == 5
require pk.size(xs) == 3
require pk.a.area(it) == 1 and pk.b.area(it) == 2
require len(s) == 5 and len(xs) == 3 and len(inferred) == 2 and len(d) == 1
require xs.len() == 3 and builtin.containers.list.len(xs) == 3
require len_value == 7
__fd_write(2, "ok")
