# Regression: an option local assigned from a call whose result type the
# rewrite settles later (here `to_string`'s call outcome) must keep its
# option type. The settled type used to leak through the assignment into the
# local, so its `nil` initializer lowered to no value and the LLVM backend
# hit an internal error ("cannot lower 'option.is_nil'", or "could not lower
# LLVM function" when the local reached a phi).
func settled_option_local(raw: string) -> int {
    var spec: string? = nil
    if byte_len(raw) > 1 {
        var out: Buffer = new[Buffer](length = 0)
        put_u8(out, 0x41)
        spec = to_string(out)
    }
    if spec != nil {
        return 1
    }
    return 0
}

require settled_option_local("ab") == 1
require settled_option_local("a") == 0
__fd_write(2, "ok")
