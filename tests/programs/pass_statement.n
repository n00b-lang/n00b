context Quiet(label: string) {
    pass
}

func idle():
    pass

func braced() {
    pass
}

func choose(value: int) -> int {
    switch value {
        case 1 {
            pass
        }
        else {
            pass
        }
    }
    if value > 0 {
        pass
    }
    else {
        return 1
    }
    return 0
}

func elided() {
    pass
    when false {
        idle()
    }
}

func start() {
    elided()
    idle()
    braced()
    require choose(2) == 0
    __fd_write(2, "ok")
}
