var runtime_calls: int = 0

func compute() -> int {
    if !comptime() {
        runtime_calls = runtime_calls + 1
    }
    return 6 * 7
}

const answer: int = compute()

func start() {
    if answer == 42 and runtime_calls == 0 {
        __fd_write(2, "const baked, not recomputed\n")
    } elif answer == 42 {
        __fd_write(2, "const recomputed at runtime\n")
    }
}
