import registry

var mine: List[registry.Entry]?

if comptime() {
    mine = registry.entries
}

func start() {
    if mine != nil and registry.entries != nil {
        let a: List[registry.Entry] = mine
        let b: List[registry.Entry] = registry.entries
        a.append((name = "added through user", count = 2))
        if b.len() == 2 { __fd_write(2, "same object across modules\n") }
        else { __fd_write(2, "separate copies\n") }
    }
}
