var count: int
if comptime() {
    count = 3
}
// Run time reruns this initializer, so comptime_main's write is lost.
var seen: int = 0
// No initializer: run time starts from comptime_main's write.
var carried: int
func comptime_main() {
    seen = count
    carried = count
}
func main() {
    if seen == 0 and carried == 3 { __fd_write(2, "ok\n") }
}
