var runtime_calls: int = 0

func compute() -> int {
    if !comptime() {
        runtime_calls = runtime_calls + 1
    }
    return 6 * 7
}

const (answer, (other, _)) = (compute(), (compute(), 0))

func start() {
    if answer == 42 and other == 42 and runtime_calls == 0 {
        __fd_write(2, "unpacked const baked, not recomputed\n")
    } else {
        __fd_write(2, "unpacked const recomputed at runtime\n")
    }
}
