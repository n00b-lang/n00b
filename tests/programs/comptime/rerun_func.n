// The same, when run time only reads the variable through a function. A
// pure initializer that nothing else writes is still skipped (`kept`).
func square_sum(n: int) -> int {
    var total = 0
    var i = 0
    while i < n {
        total = total + i * i
        i = i + 1
    }
    return total
}

var g: int = 0
if comptime() { g = 42 }
var kept = square_sum(4)

func get() -> int { return g }

__fd_write(2, "read via func: " + decimal(get()) + "\n")

func main() {
    __fd_write(2, "kept: " + decimal(kept) + "\n")
}
