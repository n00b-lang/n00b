trait Index_Write {
    func __write(self: `T, index: int, item: string) -> int
}

func __write(self: Array[int], index: int, item: string) -> int { return 1 }
func set_item(items: Array[int]) { items [0] = "stored" }

trait Index_Slice {
    func __slice(self: `T, start_ix: int = 0, end_ix: int = -1) -> View[`E]
}

func __slice(self: Array[int], start_ix: int = 0, end_ix: int = -1) -> View[int] {
    return self [:]
}

func get_view(items: Array[int]) -> View[int] { return items [:] }
