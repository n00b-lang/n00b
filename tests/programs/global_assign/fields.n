# Array literals stored into a record's fixed-size array field with the
# wrong length: in a record literal and by assigning the field. These are
# found once types are solved, so they are separate from lengths.n.
import holder

func main() -> nil {
    var slots: holder.Slots = (tag = 1, values = [1, 2], after = 0)
    slots.values = [1, 2, 3, 4]
    holder.slots.values = [1]
    require slots.values[0] == 1
}
