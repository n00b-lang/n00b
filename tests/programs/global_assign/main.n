import holder

func main() -> nil {
    holder.reset()
    let b = holder.names["b"]
    require holder.table[0] == 4000000000 and holder.table[3] == 9
    require b != nil and b == 4000000000
    require holder.plain[1] == 8
    holder.table = [1, 2, 3, 4000000000]
    holder.names = {"c": 4000000000}
    holder.plain = [5]
    let c = holder.names["c"]
    require holder.table[0] == 1 and holder.table[3] == 4000000000
    require c != nil and c == 4000000000
    require holder.plain[0] == 5

    holder.slots.values = [4000000000, 5, 6]
    require holder.slots.values[0] == 4000000000
    require holder.slots.values[2] == 6
    require holder.slots.tag == 7 and holder.slots.after == 99
    var local: holder.Slots = (tag = 1, values = [1, 2, 3], after = 2)
    local.values = [7, 8, 9]
    require local.values[1] == 8 and local.tag == 1 and local.after == 2
}
