type State {
    count: int
}

callback Missing_Setup {
    call(value: int) -> int
    handler(modify state: State, value: int) -> int
    setup(handler: Ref[(modify state: State, value: int) -> int],
          state: Ref[State]) -> nil
}

func handle(modify state: State, value: int) -> int {
    return value
}

func make(modify state: State) -> Missing_Setup {
    return callback[Missing_Setup](ref handle, ref state)
}
