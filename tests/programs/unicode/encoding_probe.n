import unicode
import unicode.idna
import unicode.query
import unicode.security

private func name_is(got: string, want: string) -> bool {
    if byte_len(got) != byte_len(want) {
        return false
    }

    for i from 0 until byte_len(got) {
        if byte_at(got, i) != byte_at(want, i) {
            return false
        }
    }

    return true
}

private func decodes_to(s: string, want: char, want_pos: u32) -> bool {
    var pos: u32 = 0
    var got: char = cast[char] 0

    try {
        got = unicode.utf8_decode(s, pos)!
    } fail(e) {
        return false
    }

    return got == want and pos == want_pos
}

private func roundtrips(cp: char, want_len: u64) -> bool {
    let s: string = from_char(cp)

    if byte_len(s) != want_len {
        return false
    }

    return decodes_to(s, cp, cast[u32] want_len)
}

func encoding_probe() -> string? {
    if !roundtrips('A', 1) {
        return "1"
    }

    if !roundtrips(cast[char] 0x00e9, 2) {
        return "2"
    }

    if !roundtrips(cast[char] 0x4e16, 3) {
        return "3"
    }

    if !roundtrips(cast[char] 0x1f600, 4) {
        return "4"
    }

    let mixed: string = "A\u00e9\u4e16"
    var pos: u32 = 0

    var walked: bool = false
    try {
        walked = unicode.utf8_decode(mixed, pos)! == 'A' and
                 unicode.utf8_decode(mixed, pos)! == cast[char] 0x00e9 and
                 unicode.utf8_decode(mixed, pos)! == cast[char] 0x4e16
    } fail(e) {
        walked = false
    }
    if !walked {
        return "5"
    }

    var past_end: bool = false
    try {
        unicode.utf8_decode(mixed, pos)!
        past_end = true
    } fail(e) {
        past_end = false
    }
    if past_end {
        return "6"
    }

    var lead: Array[u8] = new[Array[u8]](1)
    lead[0] = 0xff
    let bad_lead: string = from_raw(ref lead, 1)

    pos = 0

    var lead_ok: bool = false
    try {
        unicode.utf8_decode(bad_lead, pos)!
        lead_ok = true
    } fail(e) {
        lead_ok = false
    }
    if lead_ok {
        return "7"
    }

    var trunc: Array[u8] = new[Array[u8]](2)
    trunc[0] = 0xe4
    trunc[1] = 0xb8
    let truncated: string = from_raw(ref trunc, 2)

    pos = 0

    var trunc_ok: bool = false
    try {
        unicode.utf8_decode(truncated, pos)!
        trunc_ok = true
    } fail(e) {
        trunc_ok = false
    }
    if trunc_ok {
        return "8"
    }

    var sur: Array[u8] = new[Array[u8]](3)
    sur[0] = 0xed
    sur[1] = 0xa0
    sur[2] = 0x80
    let surrogate: string = from_raw(ref sur, 3)

    pos = 0

    var sur_ok: bool = false
    try {
        unicode.utf8_decode(surrogate, pos)!
        sur_ok = true
    } fail(e) {
        sur_ok = false
    }
    if sur_ok {
        return "9"
    }

    var over: Array[u8] = new[Array[u8]](2)
    over[0] = 0xc0
    over[1] = 0xaf
    let overlong: string = from_raw(ref over, 2)

    pos = 0

    var over_ok: bool = false
    try {
        unicode.utf8_decode(overlong, pos)!
        over_ok = true
    } fail(e) {
        over_ok = false
    }
    if over_ok {
        return "10"
    }

    var bom_len: u32 = 0

    if unicode.detect_bom("\ufeffabc", bom_len) != unicode.Bom.utf8 or
       bom_len != 3 {
        return "11"
    }

    var u16le: Array[u8] = new[Array[u8]](4)
    u16le[0] = 0xff
    u16le[1] = 0xfe
    u16le[2] = 0x61
    u16le[3] = 0
    let le_stream: string = from_raw(ref u16le, 4)

    if unicode.detect_bom(le_stream, bom_len) != unicode.Bom.utf16_le or
       bom_len != 2 {
        return "12"
    }

    var u32be: Array[u8] = new[Array[u8]](4)
    u32be[0] = 0
    u32be[1] = 0
    u32be[2] = 0xfe
    u32be[3] = 0xff
    let be_stream: string = from_raw(ref u32be, 4)

    if unicode.detect_bom(be_stream, bom_len) != unicode.Bom.utf32_be or
       bom_len != 4 {
        return "13"
    }

    if unicode.detect_bom("test", bom_len) != unicode.Bom.none or
       bom_len != 0 {
        return "14"
    }

    if unicode.general_category('A') != unicode.Gc.lu or
       unicode.combining_class(cast[char] 0x0301) != 230 or
       unicode.char_width(cast[char] 0x4e16) != 2 or
       unicode.display_width("A\u4e16") != 3 or
       !unicode.has_property('A', unicode.Property.uppercase) {
        return "19"
    }

    let nfd_e: string = unicode.nfd("\u00e9")

    if byte_len(nfd_e) != 3 or byte_at(nfd_e, 0) != 0x65 {
        return "20"
    }

    let nfd_for_nfc: string = nfd_e
    let nfc_back: string = unicode.nfc(nfd_for_nfc)

    if byte_len(nfc_back) != 2 or byte_at(nfc_back, 0) != 0xc3 {
        return "21"
    }

    let hangul: string = unicode.nfd("\uac00")

    if byte_len(hangul) != 6 {
        return "22"
    }

    let ligature: string = unicode.nfkc("\ufb01")

    if byte_len(ligature) != 2 or byte_at(ligature, 0) != 0x66 or
       byte_at(ligature, 1) != 0x69 {
        return "23"
    }

    if !unicode.is_nfc("abc") or unicode.is_nfc(nfd_e) or
       !unicode.is_nfd(nfd_e) {
        return "24"
    }

    if unicode.toupper_char('a') != 'A' or unicode.tolower_char('A') != 'a' or
       unicode.casefold_char('A') != 'a' {
        return "25"
    }

    let up: string = unicode.toupper("stra\u00dfe")

    if byte_len(up) != 7 or byte_at(up, 4) != 0x53 or
       byte_at(up, 5) != 0x53 {
        return "26"
    }

    if unicode.casecmp("HELLO", "hello") != 0 or
       unicode.casecmp("abc", "abd") >= 0 {
        return "27"
    }

    let title: string = unicode.totitle("hello world")

    if byte_len(title) != 11 or byte_at(title, 0) != 0x48 or
       byte_at(title, 6) != 0x57 {
        return "28"
    }

    if !unicode.is_emoji(cast[char] 0x1f600) or unicode.is_emoji('A') {
        return "29"
    }

    let flag: unicode.Emoji_Scan =
        unicode.emoji_scan("\U0001f1fa\U0001f1f8", 0)

    if flag.kind != unicode.Emoji_Type.flag or flag.seq_bytes != 8 {
        return "30"
    }

    let zwj: unicode.Emoji_Scan =
        unicode.emoji_scan("\U0001f469\u200d\U0001f4bb", 0)

    if zwj.kind != unicode.Emoji_Type.zwj_seq or zwj.seq_bytes != 11 {
        return "31"
    }

    let none: unicode.Emoji_Scan = unicode.emoji_scan("abc", 0)

    if none.kind != unicode.Emoji_Type.none or none.seq_bytes != 0 {
        return "32"
    }

    if !unicode.query.matches(unicode.query.filter_gc(unicode.Gc.lu), 'A') or
       unicode.query.matches(unicode.query.filter_gc(unicode.Gc.lu), 'a') or
       !unicode.query.matches(unicode.query.filter_range(cast[char] 0x41,
                                             cast[char] 0x5a), 'Q') {
        return "33"
    }

    let ri: List[unicode.Char_Pair] =
        unicode.query.ranges(unicode.query.filter_range(cast[char] 0x1f1e6,
                                            cast[char] 0x1f1ff))

    if ri.len() != 1 {
        return "34"
    }

    let pair: unicode.Char_Pair = ri[0]

    if pair.lo != cast[char] 0x1f1e6 or pair.hi != cast[char] 0x1f1ff {
        return "35"
    }

    let cpn: string? = unicode.query.char_name('A')

    if cpn == nil or !name_is(cpn.get(), "LATIN CAPITAL LETTER A") {
        return "36"
    }

    let rev: char? = unicode.query.char_from_name("LATIN SMALL LETTER Z")

    if rev == nil or rev.get() != 'z' {
        return "37"
    }

    if unicode.query.char_name(cast[char] 0xe000) != nil {
        return "38"
    }

    let sc: unicode.Script? = unicode.query.script_by_name("Greek")

    if sc == nil or unicode.query.script(cast[char] 0x0391) != sc.get() {
        return "39"
    }

    if unicode.grapheme_count("abc") != 3 {
        return "40"
    }

    if unicode.grapheme_count("e\u0301") != 1 {
        return "41"
    }

    if unicode.grapheme_count("\r\n") != 1 {
        return "42"
    }

    if unicode.grapheme_count("\U0001f1fa\U0001f1f8") != 1 {
        return "43"
    }

    if unicode.grapheme_count("\U0001f1fa\U0001f1f8\U0001f1fa") != 2 {
        return "44"
    }

    if unicode.grapheme_count("\U0001f469\u200d\U0001f4bb") != 1 {
        return "45"
    }

    if unicode.grapheme_count("\uac01") != 1 {
        return "46"
    }

    var wit: unicode.Break_Iter = unicode.word_iter("Hello, world!")
    var wb_count: u32 = 0
    var wb_first: u32 = 0

    while unicode.next(wit) != nil {
        if wb_count == 0 {
            wb_first = wit.byte_pos
        }

        wb_count += 1
    }

    if wb_first != 5 {
        return "47"
    }

    var nit: unicode.Break_Iter = unicode.word_iter("3.14")
    var nb: u32 = 0

    while unicode.next(nit) != nil {
        nb += 1
    }

    if nb != 1 {
        return "48"
    }

    var ait: unicode.Break_Iter = unicode.word_iter("can't")
    var ab: u32 = 0

    while unicode.next(ait) != nil {
        ab += 1
    }

    if ab != 1 {
        return "49"
    }

    var sit: unicode.Break_Iter =
        unicode.sentence_iter("Hi there. How are you?")
    var sb_count: u32 = 0
    var sb_first: u32 = 0

    while unicode.next(sit) != nil {
        if sb_count == 0 {
            sb_first = sit.byte_pos
        }

        sb_count += 1
    }

    if sb_count != 2 or sb_first != 10 {
        return "50"
    }

    var lw: unicode.Break_Iter = unicode.sentence_iter("etc. and more.")
    var lc: u32 = 0

    while unicode.next(lw) != nil {
        lc += 1
    }

    if lc != 1 {
        return "51"
    }

    var abbr: unicode.Break_Iter =
        unicode.sentence_iter("See Dr. Smith now.")
    var uc: u32 = 0

    while unicode.next(abbr) != nil {
        uc += 1
    }

    if uc != 2 {
        return "52"
    }

    let lba: List[u8] = unicode.linebreaks("ab cd")

    if lba.len() != 5 {
        return "53"
    }

    if lba[1] != cast[u8] unicode.Lb_Action.none or
       lba[3] != cast[u8] unicode.Lb_Action.allowed {
        return "54"
    }

    let lbm: List[u8] = unicode.linebreaks("a\nb")

    if lbm[2] != cast[u8] unicode.Lb_Action.mandatory {
        return "55"
    }

    if unicode.line_break(' ') != unicode.Lb.sp or
       unicode.line_break('a') != unicode.Lb.al {
        return "56"
    }

    if !unicode.is_valid_identifier("abc_1") or
       unicode.is_valid_identifier("1abc") or
       unicode.is_valid_identifier("") or
       !unicode.is_xid_start('a') or
       unicode.is_xid_start('1') or
       !unicode.is_xid_continue('1') {
        return "64"
    }

    if !unicode.security.is_confusable("good", "goo\u0501") {
        return "65"
    }

    if unicode.security.is_confusable("abc", "xyz") {
        return "66"
    }

    if unicode.security.script_restriction("hello") !=
       unicode.security.Restriction.ascii_only {
        return "67"
    }

    if unicode.security.script_restriction("\u043f\u0440\u0438") !=
       unicode.security.Restriction.single_script {
        return "68"
    }

    if !unicode.security.has_mixed_scripts("a\u0440c") {
        return "69"
    }

    if unicode.security.script_restriction("a\u6f22\u304b\u30ab") !=
       unicode.security.Restriction.highly_restrictive {
        return "83"
    }

    if unicode.security.script_restriction("a\u6f22\u3105") !=
       unicode.security.Restriction.highly_restrictive {
        return "84"
    }

    if unicode.security.script_restriction("a\u6f22\ud55c") !=
       unicode.security.Restriction.highly_restrictive {
        return "85"
    }

    if unicode.security.script_restriction("a\u0440") ==
       unicode.security.Restriction.moderately_restrictive {
        return "86"
    }

    if unicode.security.script_restriction("a\u03b1") ==
       unicode.security.Restriction.moderately_restrictive {
        return "87"
    }

    if unicode.security.script_restriction("a\u05d0") !=
       unicode.security.Restriction.moderately_restrictive {
        return "88"
    }

    var ia_ok: bool = false
    try {
        ia_ok = name_is(unicode.idna.idna_to_ascii("b\u00fccher.de")!,
                        "xn--bcher-kva.de")
    } fail(e) {
        ia_ok = false
    }
    if !ia_ok {
        return "70"
    }

    var iu_ok: bool = false
    try {
        iu_ok = name_is(unicode.idna.idna_to_unicode("xn--bcher-kva.de")!,
                        "b\u00fccher.de")
    } fail(e) {
        iu_ok = false
    }
    if !iu_ok {
        return "71"
    }

    var ic_ok: bool = false
    try {
        ic_ok = name_is(unicode.idna.idna_to_ascii("\u4f8b\u3048\u3070.com")!,
                        "xn--r8j3dr99h.com")
    } fail(e) {
        ic_ok = false
    }
    if !ic_ok {
        return "72"
    }

    var iup_ok: bool = false
    try {
        iup_ok = name_is(unicode.idna.idna_to_ascii("ASCII.EXAMPLE")!,
                         "ascii.example")
    } fail(e) {
        iup_ok = false
    }
    if !iup_ok {
        return "73"
    }

    if encoding(unicode.nfc("abc")) != Str_Encoding.ascii or
       encoding(unicode.nfc("\u4e16")) != Str_Encoding.utf8 {
        return "81"
    }

    if encoding(unicode.toupper("stra\u00dfe")) != Str_Encoding.ascii {
        return "82"
    }

    if !name_is(unicode.query.script_name(unicode.query.script(cast[char] 0x0378)),
                "Unknown") or
       unicode.east_asian_width(cast[char] 0x3400) != unicode.Eaw.w {
        return "900"
    }

    if unicode.query.bidi_class(cast[char] 0x0590) != unicode.Bidi_Class.r or
       unicode.query.bidi_class(cast[char] 0x074b) != unicode.Bidi_Class.al or
       unicode.query.bidi_class(cast[char] 0x20c1) != unicode.Bidi_Class.et {
        return "901"
    }

    let spua_b: unicode.Block = unicode.query.block(cast[char] 0x100000)
    let spua_b_id: unicode.Block? =
        unicode.query.block_by_name("Supplementary Private Use Area-B")

    if !name_is(unicode.query.block_name(spua_b),
                "Supplementary Private Use Area-B") or
       spua_b_id == nil or spua_b_id.get() != spua_b {
        return "902"
    }

    if !name_is(unicode.nfc("\u1100\u1161\u11c3"), "\uac00\u11c3") {
        return "903"
    }

    var tail: Array[u8] = new[Array[u8]](32)
    var k: int = 0
    while k < 30 {
        tail[k] = 0x61
        k += 1
    }
    tail[30] = 0xe4
    tail[31] = 0xb8

    if unicode.encoding_of(from_raw(ref tail, 32)) != Str_Encoding.binary {
        return "904"
    }

    if unicode.security.script_restriction("\u65e5\u672c\u8a9e\u3072\u3089\u304c\u306a") !=
       unicode.security.Restriction.single_script {
        return "905"
    }

    let sigma: string = unicode.tolower("\u039f\u0394\u039f\u03a3")
    let sigma_len: uint = byte_len(sigma)

    if sigma_len < 2 or byte_at(sigma, sigma_len - 2) != 0xcf or
       byte_at(sigma, sigma_len - 1) != 0x82 {
        return "906"
    }

    var trip_ok: bool = false
    try {
        trip_ok = name_is(
            unicode.idna.idna_to_unicode(unicode.idna.idna_to_ascii("\u4f8b\u3048.com")!)!,
            "\u4f8b\u3048.com")
    } fail(e) {
        trip_ok = false
    }
    if !trip_ok {
        return "907"
    }

    return nil
}

let failed: string? = encoding_probe()
if failed == nil {
    __fd_write(2, "ok")
}
else {
    __fd_write(2, "FAIL encoding_probe " + failed.get() + "\n")
}
