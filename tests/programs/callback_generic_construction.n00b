callback Transform_Callback {
    call(value: `T) -> `U fail: `E
    handler(modify state: `S, value: `T) -> `U fail: `E
    setup(handler: Ref[(modify state: `S, value: `T) -> `U fail: `E],
          state: Ref[`S]) -> nil
}

func transform(modify state: int, value: string) -> bool fail: string {
    return true
}

func setup(handler: Ref[(modify state: int, value: string) -> bool fail: string],
           state: Ref[int]) -> nil {
}

func make_transform(modify state: int) -> Transform_Callback[bool, int, string, string] {
    return callback[Transform_Callback](ref transform, ref state)
}

func invoke_transform(callback_value: Transform_Callback[bool, int, string, string],
                      value: string) -> bool fail: string {
    return callback_value.call(value)!
}
