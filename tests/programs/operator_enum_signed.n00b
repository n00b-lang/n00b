enum Signed {
    negative: -7, following, zero: -0, positive: 7,
    before_zero: -1, across_zero, after_zero
}

func negative() -> Signed {
    return Signed.negative
}

func following() -> Signed {
    return Signed.following
}

func zero() -> Signed {
    return Signed.zero
}

func positive() -> Signed {
    return Signed.positive
}

func across_zero() -> Signed {
    return Signed.across_zero
}

func after_zero() -> Signed {
    return Signed.after_zero
}
