record Entry {
    value: int?
}

func clear(modify entry: Entry) {
    entry.value = nil
}

func run(entry: Entry, other: Ref[Entry]) -> int {
    var copy: Entry = entry
    if copy.value != nil {
        let pointer = ref copy
        return copy.value.get()
    }
    return 1
}

var entry: Entry = (value = 4)
require run(entry, ref entry) > 0
