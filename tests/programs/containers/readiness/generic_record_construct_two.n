type Pair {
    left: `A
    right: `B
}

func __init(modify self: Pair[`A, `B], left: `A, right: `B) {
    self.left = left
    self.right = right
}

func make_pair(left: `A, right: `B) -> Pair[`A, `B] {
    return new[Pair[`A, `B]](left, right)
}

comptime {} else {
    let pair: Pair[int, string] = make_pair(7, "seven")
    require pair.left == 7
}
