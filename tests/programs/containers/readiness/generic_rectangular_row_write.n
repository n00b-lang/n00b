func replace_second(modify grid: Array[Array[`T]], row: Array[`T]) {
    grid[1] = row
}

comptime {} else {
    var numbers: Array[Array[int]] = new[Array[Array[int]]](2, 3)
    var number_row: Array[int] = [3, 5, 7]'array
    replace_second(numbers, number_row)
    require numbers[1][0] == 3
    require numbers[1][2] == 7
    number_row[0] = 9
    require numbers[1][0] == 3

    var flags: Array[Array[bool]] = new[Array[Array[bool]]](2, 9)
    let flag_row: Array[bool] =
        [false, false, false, false, false, false, false, false, true]'array
    replace_second(flags, flag_row)
    require flags[1][8]
    require !flags[0][8]
}
