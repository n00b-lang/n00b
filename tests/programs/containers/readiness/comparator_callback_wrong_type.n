type Entry {
    rank: int
}

callback Comparator {
    call(left: `T, right: `T) -> Comparison
    handler(left: `T, right: `T) -> Comparison
}

func compare_entries(left: Entry, right: Entry) -> Comparison {
    return Comparison.equal
}

comptime {} else {
    let comparator = callback[Comparator](ref compare_entries)
    require comparator.call(1, 2) == Comparison.equal
}
