type Shared_State {
    count: uint
    items: Array[`T]
}

func __init(modify self: Shared_State[`T]) {
    self.count = 0
    self.items = new[Array[`T]](1)
}

type Shared_Handle {
    state: Ref[Shared_State[`T]]
}

func __init(modify self: Shared_Handle[`T]) {
    var state: Shared_State[`T] = new[Shared_State[`T]]()
    self.state = ref state
}

comptime {} else {
    var first: Shared_Handle[int] = new[Shared_Handle[int]]()
    var second: Shared_Handle[int] = first
    first.state.count = 1
    first.state.items[0] = 42
    require second.state.count == 1
    require second.state.items[0] == 42
}
