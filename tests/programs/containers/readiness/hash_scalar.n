import hash

comptime {} else {
    let seven: int = 7
    let copy: int = 7
    let eight: int = 8
    require seven.hash() == copy.hash()
    require seven.hash() != eight.hash()
    require seven.hash() == cast[u128] 7
    let negative: int = -1
    require negative.hash() == ~cast[u128] 0
    let narrow_negative: i8 = -1
    require narrow_negative.hash() == negative.hash()
    let narrow_positive: u8 = 255
    require narrow_positive.hash() == cast[u128] 255

    let negative_zero: float = -0.0
    let positive_zero: float = 0.0
    require negative_zero == positive_zero
    require negative_zero.hash() == positive_zero.hash()

    let wide: u128 = cast[u128] 1 << 100
    let same_wide: u128 = cast[u128] 1 << 100
    let other_wide: u128 = cast[u128] 1 << 101
    require wide.hash() == same_wide.hash()
    require wide.hash() != other_wide.hash()
    require wide.hash() == wide
    let signed_wide: i128 = -1
    require signed_wide.hash() == ~cast[u128] 0
    let highest: u128 = ~cast[u128] 0
    require highest.hash() == highest

    let yes: bool = true
    let no: bool = false
    require yes.hash() != no.hash()
    let one_byte: byte = cast[byte] 1
    let two_bytes: byte = cast[byte] 2
    require one_byte.hash() != two_bytes.hash()
    let letter: char = 'a'
    require letter.hash() == letter.hash()

    var value: int = 11
    let address: Ref[int] = ref value
    require address.hash() == address.hash()
    var other_value: int = 11
    let other_address: Ref[int] = ref other_value
    require address.hash() != other_address.hash()

    let text: string = "hash me"
    require text.hash() == "hash me".hash()

    var bytes: Array[byte] = new[Array[byte]](3)
    bytes[0] = cast[byte] 1
    bytes[1] = cast[byte] 2
    bytes[2] = cast[byte] 3
    let first_hash: u128 = hash.xxh3_128(bytes)
    require first_hash == hash.xxh3_128(bytes)
    bytes[2] = cast[byte] 4
    require first_hash != hash.xxh3_128(bytes)
}
