import builtin.containers.dict

func make_values() -> Dict[int, int] {
    return {1: 3}'dict
}

comptime {} else {
    var first = make_values()
    var second = make_values()
    _ = builtin.containers.dict.put(first, 1, 11)
    let left: int? = builtin.containers.dict.get(first, 1)
    let right: int? = builtin.containers.dict.get(second, 1)
    require left != nil
    require right != nil
    require left.get() == 11
    require right.get() == 3
}
