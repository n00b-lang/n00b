func make_list(value: int) -> List[int] {
    return [1, value]
}

func make_dict(value: int) -> Dict[string, int] {
    return {"one": value}
}

func make_set(value: int) -> Set[int] {
    return {1, value}
}

comptime {} else {
    let value: int = 7
    make_list(value)
    make_dict(value)
    make_set(value)
}
