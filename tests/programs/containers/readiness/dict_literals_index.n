import builtin.containers.dict

comptime {} else {
    var values: Dict[int, int] = {1: 2, 3: 4}'dict
    require builtin.containers.dict.len(values) == 2
    let first: int? = values[1]
    require first != nil
    require first.get() == 2
    values[1] = 9
    let updated: int? = values[1]
    require updated != nil
    require updated.get() == 9
    let empty: Dict[int, int] = {:}
    require builtin.containers.dict.len(empty) == 0
    let contextual: Dict[int, int] = {}
    require builtin.containers.dict.len(contextual) == 0
    let aliased: Dict[int, int] = {5: 6}'d
    require builtin.containers.dict.len(aliased) == 1
    let aliased_value: int? = aliased[5]
    require aliased_value != nil
    require aliased_value.get() == 6
}
