import containers.dict

type Key { value: int }

func hash(self: Key) -> u128 { return 7 }

comptime {} else {
    var items: Dict[Key, int] = new[Dict[Key, int]]()
    let first: Key = (value = 1)
    let second: Key = (value = 2)
    require containers.dict.add(items, first, 10)
    require !containers.dict.add(items, second, 20)
    require containers.dict.len(items) == 1
    let prior: int? = containers.dict.put(items, second, 30)
    require prior != nil
    require prior.get() == 10
    let via_first: int? = containers.dict.get(items, first)
    require via_first != nil
    require via_first.get() == 30
    let via_second: int? = containers.dict.get(items, second)
    require via_second != nil
    require via_second.get() == 30
    var seen: uint = 0
    for key, value in items {
        require key.value == first.value
        require value == 30
        seen += 1
    }
    require seen == 1
    require containers.dict.remove(items, second)
    require containers.dict.len(items) == 0
}
