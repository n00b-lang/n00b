import containers.traits

type MixedList {
    count: int
}

func append(modify self: MixedList, value: int, front: bool) {
    self.count = self.count + 1
}

func pop(modify self: MixedList, front: bool) -> string? {
    return nil
}

func insert(modify self: MixedList, index: int, value: int) {
    self.count = self.count + 1
}

func use_list(value: `L) where `L: containers.traits.ListLike {
    _ = value
}

comptime {} else {
    let values: MixedList = (count = 0)
    use_list(values)
}
