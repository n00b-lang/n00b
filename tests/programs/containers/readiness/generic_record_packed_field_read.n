type Packed {
    first: bool
    second: bool
    value: `T
}

func get(holder: Packed[`T]) -> `T {
    return holder.value
}

func get_first(holder: Packed[`T]) -> bool {
    return holder.first
}

func get_second(holder: Packed[`T]) -> bool {
    return holder.second
}

comptime {} else {
    let holder: Packed[bool] = (first = true, second = false, value = true)
    require get_first(holder)
    require !get_second(holder)
    require get(holder)
}
