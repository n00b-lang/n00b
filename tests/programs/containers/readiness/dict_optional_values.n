import containers.dict

comptime {} else {
    var values: Dict[int, Option[int]] =
        new[Dict[int, Option[int]]]()
    let absent: Option[int] = nil
    let first_previous: Option[Option[int]] =
        containers.dict.put(values, 1, absent)
    require first_previous == nil

    let present: Option[Option[int]] =
        containers.dict.get(values, 1)
    require present != nil
    let stored: Option[int] = present.get()
    require stored == nil

    let prior: Option[Option[int]] =
        containers.dict.put(values, 1, 42)
    require prior != nil
    let prior_value: Option[int] = prior.get()
    require prior_value == nil
    let updated: Option[Option[int]] =
        containers.dict.get(values, 1)
    require updated != nil
    let current: Option[int] = updated.get()
    require current != nil
    require current.get() == 42
    require containers.dict.get(values, 2) == nil
}
