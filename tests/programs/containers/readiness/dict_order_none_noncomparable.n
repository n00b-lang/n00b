import containers.dict
import containers.view

type Key { value: int }
type Payload { value: int }

func hash(self: Key) -> u128 { return cast[u128] self.value }

comptime {} else {
    var items: Dict[Key, Payload] = new[Dict[Key, Payload]]()
    let key: Key = (value = 7)
    let payload: Payload = (value = 9)
    _ = containers.dict.put(items, key, payload)
    let dense = containers.dict.keys(items,
        containers.dict.Sort_Order.none)
    let inserted = containers.dict.values(items,
        containers.dict.Sort_Order.insertion)
    require containers.view.len(dense) == 1
    require containers.view.len(inserted) == 1
    require dense[0].value == 7
    require inserted[0].value == 9
}
