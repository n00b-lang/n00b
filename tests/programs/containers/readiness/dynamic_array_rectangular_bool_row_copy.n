comptime {} else {
    var grid: Array[Array[bool]] = new[Array[Array[bool]]](3, 3)
    grid[0][2] = true
    grid[1][0] = true
    grid[2][1] = true
    grid[1] = grid[0]
    require grid[0][2]
    require grid[1][2]
    require !grid[1][0]
    require grid[2][1]
    grid[0] = grid[2]
    require grid[0][1]
    require !grid[0][2]
    require grid[1][2]
}
