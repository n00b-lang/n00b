type Pair {
    left: int
    right: int
}

func first(items: Array[`T]) -> `T {
    return items[0]
}

comptime {} else {
    let pair: Pair = (left = 3, right = 5)
    let items: Array[Pair] = [pair]'array
    let result: Pair = first(items)
    require result.left == 3
    require result.right == 5
}
