import containers.view

type Pair {
    left: int
}

comptime {} else {
    let pair: Pair = (left = 2)
    let values: Array[Pair] = [pair]'array
    let selected: containers.view.View[Pair] =
        values[0:1]
    require containers.view.len(selected) == 1
    let item: Pair = selected[0]
    require item.left == 2
}
