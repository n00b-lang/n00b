type Item {
    number: int
    ready: bool
}

comptime {} else {
    var integers: Array[int] = new[Array[int]](1)
    var options: Array[int?] = new[Array[int?]](1)
    var references: Array[Ref[Item]?] = new[Array[Ref[Item]?]](1)
    var records: Array[Item] = new[Array[Item]](1)
    require integers[0] == 0
    require options[0] == nil
    require references[0] == nil
    require records[0].number == 0
    require !records[0].ready
}
