comptime {} else {
    var source: Array[Array[bool]] = new[Array[Array[bool]]](2, 3)
    source[0][2] = true
    source[1][0] = true
    var copied: Array[Array[bool]] = source
    copied[0][2] = false
    require source[0][2]
    require !copied[0][2]
    require copied[1][0]
    var row: Array[bool] = source[1]
    row[0] = false
    require source[1][0]
    require !row[0]
}
