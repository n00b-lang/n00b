import containers.list

type Cell {
    public value: int
}

func __init(modify self: Cell, value: int) {
    self.value = value
}

comptime {} else {
    var values: List[Cell] = [new[Cell](1), new[Cell](2)]
    values.insert(1, new[Cell](9))
    require containers.list.len(values) == 3
    require values[1].value == 9
    let popped: Cell? = values.pop(front = true)
    require popped != nil
    require popped.get().value == 1

    var retained: List[Cell] = values
    var taken: Array[Cell] = containers.list.to_array(values)
    require __array_length(taken) == 2
    require taken[0].value == 9
    taken[0] = new[Cell](12)
    require retained[0].value == 12

    var sum: int = 0
    for let cell: Cell in retained {
        sum += cell.value
    }
    require sum == 14
}
