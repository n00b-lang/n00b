enum Sort_Order { none, insertion, key, value }

func choose(first: `T, second: `T = first,
            sort_order: Sort_Order = Sort_Order.none) -> `T {
    if sort_order == Sort_Order.none {
        return first
    }
    return second
}

comptime {} else {
    require choose(7) == 7
    require choose(7, second = 9) == 7
    var order: Sort_Order = Sort_Order.value
    require choose(7, second = 9, sort_order = order) == 9
    order = Sort_Order.none
    require choose(7, second = 9, sort_order = order) == 7
}
