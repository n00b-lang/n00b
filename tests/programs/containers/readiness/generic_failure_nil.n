func maybe_fail(reason: `E, fail_now: bool) -> nil fail: `E {
    if fail_now {
        fail reason
    }
}

comptime {} else {
    try {
        maybe_fail("requested", false)!
    } else err {
        require false
    }
    try {
        maybe_fail("requested", true)!
        require false
    } else err {
        require true
    }
}
