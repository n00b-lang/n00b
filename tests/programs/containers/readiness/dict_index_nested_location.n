import containers.dict

type Holder { items: Dict[int, int] }

comptime {} else {
    var holder: Holder = (items = new[Dict[int, int]]())
    holder.items[3] = 30
    let field_value: int? = holder.items[3]
    require field_value != nil
    require field_value.get() == 30

    var holders: Array[Holder] = new[Array[Holder]](1)
    holders[0] = holder
    holders[0].items[7] = 70
    let array_value: int? = holders[0].items[7]
    require array_value != nil
    require array_value.get() == 70
}
