type Pair {
    value: `T
    other: int
}

func read_value(items: Array[Pair[`T]]) -> `T {
    return items[0].value
}

func saved_pair(items: Array[Pair[`T]]) -> Pair[`T] {
    let saved: Pair[`T] = items[0]
    return saved
}

comptime {} else {
    var items: Array[Pair[int]] = new[Array[Pair[int]]](1)
    items[0] = (value = 11, other = 22)
    let extracted: int = read_value(items)
    let saved: Pair[int] = saved_pair(items)
    items[0] = (value = 33, other = 44)
    require extracted == 11
    require saved.value == 11
    require saved.other == 22
    require items[0].value == 33
    require items[0].other == 44
}
