import hash

comptime {} else {
    var bytes: Array[byte] = new[Array[byte]](3)
    bytes[0] = cast[byte] 1
    bytes[1] = cast[byte] 2
    bytes[2] = cast[byte] 3
    var same: Array[byte] = new[Array[byte]](3)
    same[0] = cast[byte] 1
    same[1] = cast[byte] 2
    same[2] = cast[byte] 3
    var different: Array[byte] = new[Array[byte]](3)
    different[0] = cast[byte] 1
    different[1] = cast[byte] 2
    different[2] = cast[byte] 4
    let expected: u128 = hash.xxh3_128(bytes)
    require expected == hash.xxh3_128(same)
    require expected != hash.xxh3_128(different)
}
