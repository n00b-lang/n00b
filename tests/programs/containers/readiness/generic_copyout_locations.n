type Holder {
    value: int
}

func replace(out target: `T, source: `T) {
    target = source
}

func overwrite(modify target: `T, source: `T) {
    target = source
}

comptime {} else {
    var holder: Holder = (value = 7)
    replace(holder.value, 13)
    require holder.value == 13
    overwrite(holder.value, 15)
    require holder.value == 15

    var values = [11, 29]'array
    replace(values[1], 31)
    require values[1] == 31
    overwrite(values[0], 16)
    require values[0] == 16
}
