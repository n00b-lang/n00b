import generic_shapes_dep

comptime {} else {
    let xs: generic_shapes_dep.List[int] = (item = 3)
    let map: generic_shapes_dep.Dict[string, int] =
        (key = "three", value = xs.item)
    let pair: generic_shapes_dep.Pair[int, string] =
        (first = map.value, second = map.key)
    let members: generic_shapes_dep.Set[int] = (item = map.value)
    let items: generic_shapes_dep.View[int] = (item = members.item)
    let cursor: generic_shapes_dep.Cursor[int] =
        (source = items, index = 0)
    require cursor.source.item == 3
    require cursor.index == 0
    require pair.first == 3
}
