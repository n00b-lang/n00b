type Pair {
    left: int
    right: int
}

trait Accept {
    func accept(self: `T, pair: Pair) -> int
}

func accept(self: int, pair: Pair) -> int {
    return self + pair.left + pair.right
}

func sum_pair(pair: Pair) -> int {
    return pair.left + pair.right
}

comptime {} else {
    require 7.accept((left = 11, right = 13)) == 31
    require sum_pair((left = 2, right = 5)) == 7
}
