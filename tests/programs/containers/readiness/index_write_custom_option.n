type Slots {
    public value: int?
}

func __write(modify self: Slots, index: int, item: int?) -> nil {
    self.value = item
}

comptime {} else {
    let initial: int? = nil
    var slots: Slots = (value = initial)
    slots[0] = nil
    require slots.value == nil
    slots[0] = 7
    require slots.value != nil
}
