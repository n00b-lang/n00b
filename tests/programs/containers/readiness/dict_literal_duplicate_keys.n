import containers.dict
import containers.view

comptime {} else {
    var items: Dict[int, int] = {2: 20, 1: 10, 2: 99}'dict
    require containers.dict.len(items) == 2
    let value: int? = containers.dict.get(items, 2)
    require value != nil
    require value.get() == 99

    let ordered = containers.dict.keys(
        items, containers.dict.Sort_Order.insertion)
    require containers.view.len(ordered) == 2
    require ordered[0] == 2
    require ordered[1] == 1
}
