import builtin.containers.traits

type NumberList {
    value: int
    present: bool
}

type Word {
    value: int
}

type WordList {
    value: Word
    present: bool
}

func append(modify self: NumberList, value: int, front: bool) {
    self.value = value
    self.present = true
}

func pop(modify self: NumberList, front: bool) -> int? {
    if !self.present { return nil }
    self.present = false
    return self.value
}

func insert(modify self: NumberList, index: int, value: int) {
    self.value = value
    self.present = true
}

func append(modify self: WordList, value: Word, front: bool) {
    self.value = value
    self.present = true
}

func pop(modify self: WordList, front: bool) -> Word? {
    if !self.present { return nil }
    self.present = false
    return self.value
}

func insert(modify self: WordList, index: int, value: Word) {
    self.value = value
    self.present = true
}

func round_trip(modify values: `L, value: `T) where `L: builtin.containers.traits.ListLike {
    values.append(value, false)
    _ = values.pop(false)
}

comptime {} else {
    var nums: NumberList = (value = 0, present = false)
    round_trip(nums, 9)
    require !nums.present
    require nums.value == 9
    let empty_word: Word = (value = 0)
    var words: WordList = (value = empty_word, present = false)
    let word: Word = (value = 11)
    round_trip(words, word)
    require !words.present
    require words.value.value == 11
}
