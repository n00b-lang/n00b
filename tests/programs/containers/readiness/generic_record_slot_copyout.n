type Item {
    value: int
}

func replace(out target: `T, source: `T) {
    target = source
}

func overwrite(modify target: `T, source: `T) {
    target = source
}

comptime {} else {
    let first: Item = (value = 7)
    let second: Item = (value = 11)
    var items: Array[Item] = [first, second]'array
    let replacement: Item = (value = 13)
    replace(items[0], replacement)
    require items[0].value == 13
    let next: Item = (value = 31)
    overwrite(items[1], next)
    require items[1].value == 31
}
