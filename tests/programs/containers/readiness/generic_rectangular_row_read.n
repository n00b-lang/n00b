func first(items: Array[`T]) -> `T {
    return items[0]
}

func second(items: Array[`T]) -> `T {
    return items[1]
}

comptime {} else {
    var grid: Array[Array[int]] = new[Array[Array[int]]](2, 3)
    grid[0][1] = 41
    grid[1][1] = 42
    let row: Array[int] = first(grid)
    require row[1] == 41
    let next_row: Array[int] = second(grid)
    require next_row[1] == 42

    var flags: Array[Array[bool]] = new[Array[Array[bool]]](2, 9)
    flags[0][8] = true
    flags[1][8] = true
    let bits: Array[bool] = first(flags)
    require bits[8]
    let next_bits: Array[bool] = second(flags)
    require next_bits[8]
}
