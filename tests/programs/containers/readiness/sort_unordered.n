import builtin.sort

func unordered(left: int, right: int) -> Comparison {
    return Comparison.unordered
}

comptime {} else {
    var values: Array[int] = [2, 1]
    let comparator: builtin.sort.Comparator[int] =
        callback[builtin.sort.Comparator](ref unordered)
    builtin.sort.sort_by(values, comparator)
}
