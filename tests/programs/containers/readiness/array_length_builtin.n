func count_items(items: Array[`T]) -> uint {
    return __array_length(items)
}

comptime {} else {
    let numbers: Array[int] = [3, 5, 8]'array
    require __array_length(numbers) == 3
    require count_items(numbers) == 3
    let flags: Array[bool] = [true, false, true, false]'array
    require count_items(flags) == 4
    let empty: Array[int] = []'array
    require count_items(empty) == 0
    let grid: Array[int][2][3] = new[Array[int][2][3]]()
    require __array_length(grid) == 2
    require __array_length(grid[0]) == 3
}
