import builtin.hash

type Key {
    value: int
}

func __equal(self: Key, other: Key) -> bool {
    return self.value == other.value
}

func require_hash(value: `T) -> u128 where `T: Equal + builtin.hash.Hash {
    return cast[u128]1
}

comptime {} else {
    let key: Key = (value = 7)
    let result: u128 = require_hash(key)
}
