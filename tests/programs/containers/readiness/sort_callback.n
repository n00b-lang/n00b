import builtin.sort

func descending(left: int, right: int) -> Comparison {
    if left > right { return Comparison.less }
    if left < right { return Comparison.greater }
    return Comparison.equal
}

comptime {} else {
    var values: Array[int] = [1, 4, 2, 3]
    let comparator: builtin.sort.Comparator[int] =
        callback[builtin.sort.Comparator](ref descending)
    builtin.sort.sort_by(values, comparator)
    require values[0] == 4
    require values[1] == 3
    require values[2] == 2
    require values[3] == 1
}
