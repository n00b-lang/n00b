import containers.dict

comptime {} else {
    var values: Dict[int, int] = new[Dict[int, int]]()
    _ = containers.dict.put(values, 1, 10)
    _ = containers.dict.put(values, 2, 20)
    var count: int = 0
    for let item in values {
        require item.value == item.key * 10
        count += 1
    }
    require count == 2
    count = 0
    for key, value in values {
        require value == key * 10
        count += 1
    }
    require count == 2
}
