import builtin.containers.dict

comptime {} else {
    var values: Dict[int, int] = new[Dict[int, int]]()
    require builtin.containers.dict.len(values) == 0
    require builtin.containers.dict.get(values, 7) == nil
    require !builtin.containers.dict.replace(values, 7, 99)
    require builtin.containers.dict.add(values, 7, 11)
    require !builtin.containers.dict.add(values, 7, 99)
    require builtin.containers.dict.replace(values, 7, 12)
    let replaced: int? = builtin.containers.dict.get(values, 7)
    if replaced != nil { require replaced.get() == 12 } else { require false }
    require builtin.containers.dict.len(values) == 1
    let first: int? = builtin.containers.dict.get(values, 7)
    if first != nil { require first.get() == 12 } else { require false }
    let prior: int? = builtin.containers.dict.put(values, 7, 13)
    if prior != nil { require prior.get() == 12 } else { require false }
    let updated: int? = builtin.containers.dict.get(values, 7)
    if updated != nil { require updated.get() == 13 } else { require false }
    require builtin.containers.dict.remove(values, 7)
    require builtin.containers.dict.get(values, 7) == nil
    require builtin.containers.dict.len(values) == 0
}
