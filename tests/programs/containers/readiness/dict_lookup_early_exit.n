import containers.dict

type Key {
    value: int
    bucket: u64
}

func hash(self: Key) -> u128 {
    return cast[u128](self.value * 16) + cast[u128] self.bucket
}

comptime {} else {
    var items: Dict[Key, int] = new[Dict[Key, int]]()
    let first: Key = (value = 1, bucket = 5)
    let second: Key = (value = 2, bucket = 6)
    let third: Key = (value = 3, bucket = 5)
    let missing: Key = (value = 4, bucket = 5)
    require containers.dict.add(items, first, 10)
    require containers.dict.add(items, second, 20)
    require containers.dict.add(items, third, 30)

    require containers.dict.get(items, missing) == nil

    require containers.dict.remove(items, second)
    let found: int? = containers.dict.get(items, third)
    require found != nil
    require found.get() == 30
    require containers.dict.len(items) == 2
}
