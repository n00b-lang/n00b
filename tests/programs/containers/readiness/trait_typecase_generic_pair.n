trait Pair_Comparable {
    func pair_cmp(left: `T, right: `T) -> int
}

func compare_pair(left: `T, right: `T) -> int {
    typecase left {
        case Pair_Comparable { return left.pair_cmp(right) }
        else { require false }
    }
}

func has_pair_comparable(item: `T) -> bool {
    typecase item {
        case Pair_Comparable { return true }
        else { return false }
    }
}

func compare_self(left: `T) -> int {
    typecase left {
        case Pair_Comparable { return left.pair_cmp(left) }
        else { require false }
    }
}

type Comparable_Item { value: int }
type Plain_Item { value: int }

func pair_cmp(left: Comparable_Item, right: Comparable_Item) -> int {
    return left.value - right.value
}

comptime {} else {
    let a: Comparable_Item = (value = 3)
    let b: Comparable_Item = (value = 2)
    require compare_self(a) == 0
}
