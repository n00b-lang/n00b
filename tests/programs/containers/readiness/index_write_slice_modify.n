type Slots {
    public value: int
}

func __write_slice(modify self: Slots, start_ix: int?, end_ix: int?,
                   inclusive: bool, values: Array[int]) -> nil {
    self.value = values[0]
    if inclusive {
        self.value += 10
    }
    if start_ix == nil {
        self.value += 100
    }
    if end_ix == nil {
        self.value += 1000
    }
}

comptime {} else {
    var slots: Slots = (value = 0)
    let values: Array[int] = [7, 8]'array
    slots[1:1] = values
    require slots.value == 7
    slots[1 to 2] = values
    require slots.value == 17
    var lower_bound: int = 1
    var limit: int = 2
    slots[lower_bound until limit] = values
    require slots.value == 7
    slots[:] = values
    require slots.value == 1107
}
