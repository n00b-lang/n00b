record Meter {
    value: int
}

record Counter {
    value: int
}

func __add(left: Meter, right: Meter) -> Meter {
    let result: Meter = (value = left.value + right.value)
    return result
}

func __add(left: Counter, right: Counter) -> Counter {
    let result: Counter = (value = left.value + right.value)
    return result
}

func combine(left: 'T, right: 'T) -> 'T where 'T: Add {
    return left + right
}

let a: Meter = (value = 2)
let b: Meter = (value = 3)
let c: Counter = (value = 11)
let d: Counter = (value = 13)
let meter: Meter = combine(a, b)
let counter: Counter = combine(c, d)
let integer: int = combine(3, 4)
require meter.value == 5
require counter.value == 24
require integer == 7
