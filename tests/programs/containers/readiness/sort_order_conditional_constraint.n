enum Sort_Order { none, key }

type Token {
    value: int
}

func needs_compare(value: `T, sort_order: Sort_Order = Sort_Order.none) -> bool {
    if sort_order == Sort_Order.key {
        return value < value
    }
    return true
}

comptime {} else {
    let token: Token = (value = 7)
    require needs_compare(token)
}
