import builtin.containers.dict

comptime {} else {
    var items: Dict[int, int] = new[Dict[int, int]]()
    var i: int = 0
    while i < 1000000 {
        require builtin.containers.dict.add(items, i, i * 3)
        i += 1
    }
    var sum: int = 0
    i = 0
    while i < 1000000 {
        let found: int? = builtin.containers.dict.get(items, i)
        require found != nil
        sum += found.get()
        i += 1
    }
    require sum == 1499998500000
    i = 1000000
    while i < 2000000 {
        require builtin.containers.dict.get(items, i) == nil
        i += 1
    }
    i = 1
    while i < 1000000 {
        require builtin.containers.dict.remove(items, i)
        i += 2
    }
    require builtin.containers.dict.len(items) == 500000
    var count: int = 0
    for key, value in items {
        require value == key * 3
        count += 1
    }
    require count == 500000
}
