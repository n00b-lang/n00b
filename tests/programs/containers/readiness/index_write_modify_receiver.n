type Slots {
    public value: int
}

type Holder {
    public slots: Slots
}

func __write(modify self: Slots, index: int, item: int) -> nil {
    require index == 0
    self.value = item
}

comptime {} else {
    var slots: Slots = (value = 0)
    slots[0] = 7
    require slots.value == 7
    var initial: Slots = (value = 2)
    var holder: Holder = (slots = initial)
    holder.slots[0] = 9
    require holder.slots.value == 9
}
