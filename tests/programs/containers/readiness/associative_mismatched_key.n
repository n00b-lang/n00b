import builtin.containers.traits

type MixedMap {
    value: int
}

func get(self: MixedMap, key: int) -> int? {
    return self.value
}

func put(modify self: MixedMap, key: bool, value: int) -> int? {
    self.value = value
    return nil
}

func remove(modify self: MixedMap, key: int) -> bool {
    return false
}

func contains(self: MixedMap, key: int) -> bool {
    return true
}

func use_map(modify value: `M) -> bool where `M: builtin.containers.traits.Associative {
    return value.contains(1)
}

comptime {} else {
    var value: MixedMap = (value = 0)
    require use_map(value)
}
