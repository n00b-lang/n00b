type Pair {
    left: int
    right: int
}

func first(items: Array[`T]) -> `T {
    return items[0]
}

comptime {} else {
    let pair: Pair = (left = 3, right = 5)
    var items: Array[Pair] = [pair]'array
    let result: Pair = first(items)
    items[0] = (left = 11, right = 13)
    require result.left == 3
}
