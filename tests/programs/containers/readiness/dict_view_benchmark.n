import builtin.containers.dict
import builtin.containers.view

type Key {
    a: int
    b: int
    c: int
    d: int
}

func hash(self: Key) -> u128 { return cast[u128] self.a }

comptime {} else {
    var integers: Dict[int, int] = new[Dict[int, int]]()
    var records: Dict[Key, int] = new[Dict[Key, int]]()
    var i: int = 0
    while i < 10000 {
        require builtin.containers.dict.add(integers, i, i * 3)
        let key: Key = (a = i, b = i + 1, c = i + 2, d = i + 3)
        require builtin.containers.dict.add(records, key, i * 3)
        i += 1
    }
    var total: int = 0
    var pass: int = 0
    while pass < 100 {
        let int_keys = builtin.containers.dict.keys(integers)
        let int_values = builtin.containers.dict.values(integers)
        let record_keys = builtin.containers.dict.keys(records)
        let record_values = builtin.containers.dict.values(records)
        require builtin.containers.view.len(int_keys) == 10000
        require builtin.containers.view.len(int_values) == 10000
        require builtin.containers.view.len(record_keys) == 10000
        require builtin.containers.view.len(record_values) == 10000
        let first_record: Key = record_keys[0]
        total += int_keys[0] + int_values[9999]
        total += first_record.a + record_values[9999]
        pass += 1
    }
    require total == 5999400
}
