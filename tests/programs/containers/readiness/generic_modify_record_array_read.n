type Holder {
    items: Array[`T]
}

func first(modify self: Holder[`T]) -> `T {
    return self.items[0]
}

func grow(modify self: Holder[`T]) {
    var next: Array[`T] = new[Array[`T]](4)
    next[0] = self.items[0]
    self.items = next
}

comptime {} else {
    var holder: Holder[int] = (items = [7]'array)
    require first(holder) == 7
    grow(holder)
    require first(holder) == 7
}
