func flip(target: Ref[bool]) {
    let old: bool = ref_read(target)
    ref_write(target, !old)
}

comptime {} else {
    var values: Array[bool] = new[Array[bool]](9)
    let cell: Ref[bool] = ref values[8]
    flip(cell)
    require values[8]
    require !values[7]
    flip(cell)
    require !values[8]
}
