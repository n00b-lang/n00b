import containers.dict

comptime {} else {
    var values: Dict[string, int] = new[Dict[string, int]]()
    require containers.dict.add(values, "alpha", 1)
    require containers.dict.add(values, "a longer string key", 2)
    let first: int? = containers.dict.get(values, "alpha")
    let second: int? = containers.dict.get(values, "a longer string key")
    require first != nil
    require first.get() == 1
    require second != nil
    require second.get() == 2
    require containers.dict.remove(values, "alpha")
    require !containers.dict.contains(values, "alpha")
}
