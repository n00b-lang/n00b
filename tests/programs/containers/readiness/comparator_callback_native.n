type Entry {
    rank: int
}

callback Comparator {
    call(left: `T, right: `T) -> Comparison
    handler(left: `T, right: `T) -> Comparison
}

func compare_entries(left: Entry, right: Entry) -> Comparison {
    if left.rank < right.rank { return Comparison.less }
    if left.rank > right.rank { return Comparison.greater }
    return Comparison.equal
}

func compare_with(callback_value: Comparator[Entry],
                  left: Entry, right: Entry) -> Comparison {
    return callback_value.call(left, right)
}

comptime {} else {
    let first: Entry = (rank = 2)
    let second: Entry = (rank = 5)
    let comparator: Comparator[Entry] = callback[Comparator](ref compare_entries)
    require compare_with(comparator, first, second) == Comparison.less
    require compare_with(comparator, second, first) == Comparison.greater
}
