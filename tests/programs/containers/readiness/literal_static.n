const list: List[int] = [1, 2]
const dict: Dict[string, int] = {"a dictionary key longer than the inline string limit": 1}
const set: Set[int] = {1, 2}
const strings: List[string] = ["a long string stored outside its inline value"]
const empty_list: List[int] = []
const empty_dict: Dict[string, int] = {:}
const empty_set: Set[int] = {}

comptime {} else {
    let list_value = list
    let dict_value = dict
    let set_value = set
    let strings_value = strings
    let empty_list_value = empty_list
    let empty_dict_value = empty_dict
    let empty_set_value = empty_set
}
