import containers.list

comptime {} else {
    var values: List[int] = [2, 3]
    var copied: List[int] = values
    copied[0] = 5
    require values[0] == 5

    let joined: List[int] = values + [7]
    require containers.list.len(joined) == 3
    require joined[0] == 5
    require joined[1] == 3
    require joined[2] == 7

    var sum: int = 0
    for item in joined {
        sum += item
    }
    require sum == 15
}
