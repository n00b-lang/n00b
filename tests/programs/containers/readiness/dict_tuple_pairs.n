func count_pairs(pairs: Array[Tuple[int, string]]) -> int {
    var count: int = 0
    for key, value in pairs {
        require key >= 0
        require value != ""
        count += 1
    }
    return count
}

comptime {} else {
    let pairs: Array[Tuple[int, string]] = [(1, "one"), (2, "two")]
    require count_pairs(pairs) == 2
}
