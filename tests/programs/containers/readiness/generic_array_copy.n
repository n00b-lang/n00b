func copy_items(items: Array[`T]) -> Array[`T] {
    let result: Array[`T] = items
    return result
}

comptime {} else {
    var items: Array[int] = [2, 3]'array
    let copied: Array[int] = copy_items(items)
    items[0] = 7
    require copied[0] == 2
    var flags: Array[bool] = new[Array[bool]](2)
    flags[0] = true
    let copied_flags: Array[bool] = copy_items(flags)
    flags[0] = false
    require copied_flags[0]
}
