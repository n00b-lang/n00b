type Holder {
    items: Array[int]
}

func replace(out target: `T, source: `T) {
    target = source
}

func overwrite(modify target: `T, source: `T) {
    target = source
}

func bump(modify value: int) {
    value += 1
}

comptime {} else {
    var original = [11, 29]'array
    var holder: Holder = (items = [3, 5]'array)
    replace(holder.items, original)
    bump(holder.items[0])
    require holder.items[0] == 12
    require original[0] == 11
    overwrite(holder.items, original)
    bump(holder.items[1])
    require holder.items[1] == 30
    require original[1] == 29
}
