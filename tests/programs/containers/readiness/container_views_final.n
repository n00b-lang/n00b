import containers.dict
import containers.list
import containers.set

comptime {} else {
    let numbers: List[int] = [1, 2, 3]
    var list_total: int = 0
    for number in numbers { list_total += number }
    require list_total == 6

    let members: Set[int] = {2, 4, 6}
    var set_total: int = 0
    for member in members { set_total += member }
    require set_total == 12

    var entries: Dict[int, int] = {1: 10, 2: 20}
    var pair_total: int = 0
    for key, value in entries { pair_total += key + value }
    require pair_total == 33

    let saved_keys = containers.dict.keys(entries,
        containers.dict.Sort_Order.insertion)
    let saved_values = containers.dict.values(entries,
        containers.dict.Sort_Order.insertion)
    _ = containers.dict.put(entries, 3, 30)

    var key_total: int = 0
    for key in saved_keys { key_total += key }
    require key_total == 3

    var value_total: int = 0
    for value in saved_values { value_total += value }
    require value_total == 30
}
