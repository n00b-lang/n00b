func same(a: Ref[`T], b: Ref[`T]) -> bool {
    return a == b
}

comptime {} else {
    var first: int = 1
    var second: int = 1
    let a: Ref[int] = ref first
    let b: Ref[int] = ref second
    require same(a, a)
    require !same(a, b)

    var bits: Array[bool] = new[Array[bool]](2)
    let bit_a: Ref[bool] = ref bits[0]
    let bit_b: Ref[bool] = ref bits[1]
    require bit_a == bit_a
    require bit_a != bit_b
    require same(bit_a, bit_a)
    require !same(bit_a, bit_b)
}
