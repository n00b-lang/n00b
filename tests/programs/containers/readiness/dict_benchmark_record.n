import containers.dict

type Key {
    a: int
    b: int
    c: int
    d: int
}

func hash(self: Key) -> u128 { return cast[u128] self.a }

func key_for(i: int) -> Key {
    let key: Key = (a = i, b = i + 1, c = i + 2, d = i + 3)
    return key
}

comptime {} else {
    var items: Dict[Key, int] = new[Dict[Key, int]]()
    var i: int = 0
    while i < 100000 {
        require containers.dict.add(items, key_for(i), i * 3)
        i += 1
    }
    var sum: int = 0
    i = 0
    while i < 100000 {
        let found: int? = containers.dict.get(items, key_for(i))
        require found != nil
        sum += found.get()
        i += 1
    }
    require sum == 14999850000
    i = 100000
    while i < 200000 {
        require containers.dict.get(items, key_for(i)) == nil
        i += 1
    }
    i = 1
    while i < 100000 {
        require containers.dict.remove(items, key_for(i))
        i += 2
    }
    require containers.dict.len(items) == 50000
    var count: int = 0
    for key, value in items {
        require value == key.a * 3
        count += 1
    }
    require count == 50000
}
