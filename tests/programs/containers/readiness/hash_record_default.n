import hash

type Key {
    leading: byte
    value: int
}

comptime {} else {
    let first: Key = (leading = cast[byte]1, value = 42)
    let same: Key = (leading = cast[byte]1, value = 42)
    let other: Key = (leading = cast[byte]1, value = 43)
    require first == same
    require first != other
    require first.hash() == same.hash()
    require first.hash() != other.hash()
}
