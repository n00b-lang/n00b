import builtin.containers.dict

type Key {
    value: int
    bucket: int
}

func hash(self: Key) -> u128 {
    return cast[u128](self.value * 16 + self.bucket)
}

comptime {} else {
    var values: Dict[Key, int] = new[Dict[Key, int]]()
    let first: Key = (value = 1, bucket = 14)
    let second: Key = (value = 2, bucket = 14)
    let third: Key = (value = 3, bucket = 15)
    let missing: Key = (value = 4, bucket = 14)
    require builtin.containers.dict.add(values, first, 10)
    require builtin.containers.dict.add(values, second, 20)
    require builtin.containers.dict.add(values, third, 30)
    require builtin.containers.dict.get(values, missing) == nil
    require builtin.containers.dict.remove(values, first)
    require builtin.containers.dict.get(values, first) == nil
    let found_second: int? = builtin.containers.dict.get(values, second)
    require found_second != nil
    require found_second.get() == 20
    let found_third: int? = builtin.containers.dict.get(values, third)
    require found_third != nil
    require found_third.get() == 30
    require builtin.containers.dict.add(values, missing, 40)
    let found_missing: int? = builtin.containers.dict.get(values, missing)
    require found_missing != nil
    require found_missing.get() == 40
    require builtin.containers.dict.len(values) == 3
}
