import builtin.containers.set

comptime {} else {
    var items: Set[int] = new[Set[int]]()
    var i: int = 0
    while i < 1000000 {
        require builtin.containers.set.add(items, i)
        i += 1
    }
    require builtin.containers.set.len(items) == 1000000
    i = 0
    while i < 1000000 {
        require builtin.containers.set.contains(items, i)
        i += 1
    }
    i = 1000000
    while i < 2000000 {
        require !builtin.containers.set.contains(items, i)
        i += 1
    }
    i = 1
    while i < 1000000 {
        require builtin.containers.set.remove(items, i)
        i += 2
    }
    require builtin.containers.set.len(items) == 500000
    var count: int = 0
    for value in items {
        require value % 2 == 0
        count += 1
    }
    require count == 500000
}
