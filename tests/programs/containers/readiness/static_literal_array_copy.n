litmod<array> identity, fresh(items: Array[int]) -> Array[int] fail: string {
    return items
}

func make_values() -> Array[int] {
    return [3, 5]'fresh
}

comptime {} else {
    var first = make_values()
    var second = make_values()
    first[0] = 11
    require first[0] == 11
    require second[0] == 3
}
