import containers.dict

comptime {} else {
    var first: Dict[int, int] = new[Dict[int, int]]()
    _ = containers.dict.put(first, 1, 10)
    var second: Dict[int, int] = first
    _ = containers.dict.put(first, 2, 20)
    require containers.dict.len(second) == 2
    let added: int? = containers.dict.get(second, 2)
    require added != nil
    require added.get() == 20
    require containers.dict.remove(second, 1)
    require containers.dict.len(first) == 1
    require containers.dict.get(first, 1) == nil
}
