import containers.dict

type Key { value: int }
type Payload { value: int }

func hash(self: Key) -> u128 { return cast[u128] self.value }
func __cmp(self: Key, other: Key) -> Comparison {
    if self.value < other.value { return Comparison.less }
    if self.value > other.value { return Comparison.greater }
    return Comparison.equal
}

comptime {} else {
    var items: Dict[Key, Payload] = new[Dict[Key, Payload]]()
    let first: Key = (value = 2)
    let second: Key = (value = 1)
    let payload: Payload = (value = 9)
    _ = containers.dict.put(items, first, payload)
    _ = containers.dict.put(items, second, payload)
    let ordered = containers.dict.keys(items,
        containers.dict.Sort_Order.key)
    require ordered[0].value == 1
    require ordered[1].value == 2
}
