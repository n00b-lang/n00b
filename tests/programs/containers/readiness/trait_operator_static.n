import hash

type Mask {
    value: uint
}

func __add(left: Mask, right: Mask) -> Mask {
    let result: Mask = (value = left.value + right.value)
    return result
}

func __subtract(left: Mask, right: Mask) -> Mask {
    let result: Mask = (value = left.value - right.value)
    return result
}

func __bit_and(left: Mask, right: Mask) -> Mask {
    let result: Mask = (value = left.value & right.value)
    return result
}

func __bit_xor(left: Mask, right: Mask) -> Mask {
    let result: Mask = (value = left.value ^ right.value)
    return result
}

func __equal(left: Mask, right: Mask) -> bool {
    return left.value == right.value
}

func __cmp(left: Mask, right: Mask) -> Comparison {
    if left.value < right.value { return Comparison.less }
    if left.value > right.value { return Comparison.greater }
    return Comparison.equal
}

func hash(self: Mask) -> u128 {
    return cast[u128](self.value)
}

comptime {} else {
    let left: Mask = (value = cast[uint]10)
    let right: Mask = (value = cast[uint]3)
    let greater: Mask = (value = cast[uint]11)
    let same: Mask = (value = cast[uint]10)
    require (left + right).value == 13
    require (left - right).value == 7
    require (left & right).value == 2
    require (left ^ right).value == 9
    require left != right
    require left < greater
    require left == same
    require left.hash() == 10
}
