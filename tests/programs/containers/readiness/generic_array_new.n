func fresh_like(example: Array[`T], count: int) -> Array[`T] {
    return new[Array[`T]](count)
}

func put_second(modify items: Array[`T], value: `T) {
    items[1] = value
}

func second(items: Array[`T]) -> `T {
    return items[1]
}

func fresh_grid_like(example: Array[Array[`T]], rows: int, columns: int) -> Array[Array[`T]] {
    return new[Array[Array[`T]]](rows, columns)
}

type Item {
    value: int
}

comptime {} else {
    let seed: Array[int] = new[Array[int]](1)
    let made: Array[int] = fresh_like(seed, 3)
    require made[2] == 0

    let flag_seed: Array[bool] = new[Array[bool]](1)
    let flags: Array[bool] = fresh_like(flag_seed, 9)
    require !flags[0]
    require !flags[8]

    var item_seed: Array[Item] = new[Array[Item]](1)
    item_seed[0] = (value = 1)
    let items: Array[Item] = fresh_like(item_seed, 2)
    require items[1].value == 0

    let grid_seed: Array[Array[bool]] =
        new[Array[Array[bool]]](1, 1)
    let grid: Array[Array[bool]] = fresh_grid_like(grid_seed, 2, 9)
    require !grid[1][8]

    let bits_seed: Array[bits:127] = new[Array[bits:127]](1)
    var bits_values: Array[bits:127] = fresh_like(bits_seed, 3)
    put_second(bits_values, cast[bits:127] 123)
    require second(bits_values) == cast[bits:127] 123
}
