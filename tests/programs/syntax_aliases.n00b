fn symbolic(first: bool, second: bool) -> bool {
    return first && !second || first
}

function wordy(first: bool, second: bool) return: bool:
    if first and not second or first:
        return true
    elseif second:
        return false
    else if first:
        return true
    else:
        return false

func empty(value: int) -> int? {
    if value == 1 { return null }
    elif value == 2 { return nil }
    return None
}

function no_result() -> None {
}

record First { value: int }
struct Second:
    value: int

alias type FirstAlias = First
type SecondAlias = Second

assert true
require true
