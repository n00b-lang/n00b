record P {
    x: u32
}

var points: Array[P] = new[Array[P]](2)
var fixed: Array[P][2] = new[Array[P][2]]()
points[1] = (x = 3)
fixed[0] = (x = 1)
points[1].x += 4
points[0] = (x = 0)
points[0].x = 5
fixed[0].x *= 6
require points[1].x == 7
require points[0].x == 5
require fixed[0].x == 6
__fd_write(2, "ok")
