record Mark {
    at: uint
}

func span(s: string, n: int, scale: int = 1) -> string fail: string {
    return byte_slice(s, 0, n * scale)
}

func span(c: Mark, d: Mark) -> uint {
    return d.at - c.at
}

func measure() -> uint {
    let a: Mark = (at = 2)
    let b: Mark = (at = 9)
    let gap = span(a, b)
    var text: string = ""
    var wide: string = ""
    try {
        text = span("abcd", 2)!
        wide = span("abcdef", 2, scale = 2)!
    } else failure {
    }
    return gap + byte_len(text) + byte_len(wide)
}

require measure() == 13
__fd_write(2, "ok")
