func narrow(x: u8) -> u8 {
    return x
}

func pick(c: bool, k: int) -> uint {
    return if c { -> 1 } elif k > 2 { -> 5 } else { -> 0 }
}

func total(c: bool) -> uint {
    var n: uint = 3
    n = if c { -> 2 } else { -> n }
    let extra: uint = if c { -> 1 } else { -> 0 }
    let small: u8 = if c { -> if c { -> 7 } else { -> 8 } } else { -> 0 }
    let s: u8 = narrow(if c { -> 4 } else { -> 1 })
    return n + extra + cast[uint] small + cast[uint] s + pick(c, 3)
}

require total(true) == 15
require total(false) == 9
__fd_write(2, "ok")
