record Box {
    cap: u32
    low: u8
    limit: i16?
}

func __init(modify self: Box, cap: u32, low: u8 = 1, limit: i16? = nil) {
    self.cap = cap
    self.low = low
    self.limit = limit
}

var plain: Box = new[Box](64)
var named: Box = new[Box](70000, low = 200, limit = -3)
require plain.cap == 64
require plain.low == 1
require named.cap == 70000
require named.low == 200
require named.limit.get_or_else(0) == -3
__fd_write(2, "ok")
