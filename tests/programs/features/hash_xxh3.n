var data: Array[u8] = new[Array[u8]](4200)
var i: uint = 0
while i < 4200 {
    data[i] = unsafe_cast[u8]((i * 131 + 7) & 0xff)
    i += 1
}
func prefix(n: uint) -> Array[u8] {
    var out: Array[u8] = new[Array[u8]](cast[int] n)
    var j: uint = 0
    while j < n {
        out[j] = data[j]
        j += 1
    }
    return out
}
require from_raw(prefix(0), 0, encoding = Str_Encoding.binary).hash() == 0x99aa06d3014798d86001c324468d497f
