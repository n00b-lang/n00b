var data: Array[u8] = new[Array[u8]](4200)
var i: uint = 0
while i < 4200 {
    data[i] = unsafe_cast[u8]((i * 131 + 7) & 0xff)
    i += 1
}
func prefix_hash(n: int) -> u128 {
    return from_raw(ref data, n, encoding = Str_Encoding.binary).hash()
}
require prefix_hash(0) == 0x99aa06d3014798d86001c324468d497f
require prefix_hash(1) == 0x495b62073ef70ca44c5cca45d0f4811f
