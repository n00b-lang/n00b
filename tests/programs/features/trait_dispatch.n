record Point {
    x: int
    y: int
}

func __equal(view a: Point, view b: Point) -> bool {
    return a.x == b.x
}

func count_equal(items: List['T], value: 'T) -> int where 'T: Equal {
    var found: int = 0
    var index: int = 0
    while index < cast[int]items.len() {
        if items[index] == value {
            found += 1
        }
        index += 1
    }
    return found
}

var points: List[Point] = new[List[Point]]()
points.append((x = 1, y = 2))
points.append((x = 1, y = 9))
points.append((x = 3, y = 2))
let same_x: int = count_equal(points, (x = 1, y = 0))
assert same_x == 2

var numbers: List[int] = new[List[int]]()
numbers.append(4)
numbers.append(5)
numbers.append(4)
let fours: int = count_equal(numbers, 4)
assert fours == 2

var words: List[string] = new[List[string]]()
words.append("a")
words.append("b")
words.append("a")
let found_a: int = count_equal(words, "a")
assert found_a == 2

trait Checker {
    func check(self: 'C, n: int) -> int fail: string
}

record Even {
    bias: int
}

func check(self: Even, n: int) -> int fail: string {
    if n % 2 == 1 {
        fail "odd"
    }
    return n + self.bias
}

func run_check(c: Checker, n: int) -> int {
    var out = -1
    try {
        out = c.check(n)!
    } fail(e) {
        out = -1
    }
    return out
}

let even: Even = (bias = 1)
assert run_check(even, 4) == 5
assert run_check(even, 3) == -1

trait Bumps {
    func bump(modify self: 'B) -> nil
}

record Counter {
    n: int
}

func bump(modify self: Counter) -> nil {
    self.n = self.n + 1
}

func bump_twice(modify b: Bumps) -> nil {
    b.bump()
    b.bump()
}

var counter: Counter = (n = 0)
bump_twice(counter)
assert counter.n == 2

trait Scales {
    func scale(self: 'S, by: int = 2) -> int
}

record Box {
    v: int
}

func scale(self: Box, by: int = 2) -> int {
    return self.v * by
}

func scaled(s: Scales) -> int {
    return s.scale() + s.scale(by = 10)
}

let box: Box = (v = 3)
assert scaled(box) == 36

trait Sums {
    func total(self: 'S, *rest: int) -> int
}

record Base {
    v: int
}

func total(self: Base, *rest: int) -> int {
    var sum = self.v
    for x in rest {
        sum += x
    }
    return sum
}

func summed(s: Sums) -> int {
    return s.total(1, 2, 3) + s.total()
}

let base: Base = (v = 4)
assert summed(base) == 14
assert base.total(1) == 5
assert base.total() == 4

# A trait method called as a function, `area(x)`, on a value whose type is
# bound by the trait goes to the trait's method, as `x.area()` does, not to
# the functions of that name that take concrete types.
trait Shape {
    func area(self: 'T) -> f64
}

record Square {
    side: f64
}

record Circle {
    r: f64
}

func area(self: Square) -> f64 {
    return self.side * self.side
}

func area(self: Circle) -> f64 {
    return 3.0 * self.r * self.r
}

func area_of(x: 'T) -> f64 where 'T: Shape {
    return area(x)
}

func area_of_shape(x: Shape) -> f64 {
    return area(x)
}

func area_of_any(x: Any) -> f64 {
    typecase x {
        case Shape {
            return area(x)
        }
        else {
            return 0.0
        }
    }
}

let square: Square = (side = 2.0)
let circle: Circle = (r = 1.0)
assert area_of(square) == 4.0
assert area_of(circle) == 3.0
assert area_of_shape(square) == 4.0
assert area_of_shape(circle) == 3.0
assert area_of_any(cast[Any] square) == 4.0

# With one function of that name, a call on the bound variable still goes
# through the bound, and a call on a concrete value goes to the function.
trait Sized {
    func size(self: 'T) -> int
}

record Pile {
    n: int
}

func size(self: Pile) -> int {
    return self.n
}

func size_of(x: 'T, pile: Pile) -> int where 'T: Sized {
    return size(x) + 10 * size(pile)
}

let pile: Pile = (n = 3)
let other: Pile = (n = 2)
assert size_of(pile, other) == 23

# Inside a function, a trait used as an element type is settled by what is
# stored in the container.
func stored_area(square: Square) -> f64 {
    var shapes: Array[Shape] = new[Array[Shape]](2)
    shapes[0] = square
    shapes[1] = square
    return shapes[0].area() + area(shapes[1])
}

assert stored_area(square) == 8.0
