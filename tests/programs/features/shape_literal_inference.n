func make() -> List[int] {
    return [1, 2]
}

func fill(s: Set[int]) -> int {
    return 1
}

func head(xs: Array[int]) -> int {
    return xs[0]
}

func start() -> nil {
    var xs = [1, 2, 3]
    xs.append(4)
    var total = 0
    for x in xs {
        total += x
    }
    assert total == 10
    let nested = [[1], [2, 3]]
    assert nested[1][1] == 3
    let made = make()
    assert made[0] == 1
    assert fill({}) == 1
    let d = {"a": 1}
    let found = d["a"]
    assert found != nil
    let arr = [7, 8]
    assert head(arr) == 7
    let s = {4, 5}
    assert s.len() == 2
    __fd_write(2, "ok")
}
