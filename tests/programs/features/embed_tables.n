record Span {
    low:  u32
    high: u32
}

fence litmod located(contents: string, site: Literal_Site) -> uint fail: string {
    if contents != "here" {
        fail "unexpected fence contents"
    }
    return site.line * 1000 + site.column
}

let words: Array[u16] = [- embed_u16.bin -]'embed
require __array_length(words) == 3
require words[0] == 1 and words[1] == 2 and words[2] == 0x0103

let spans: Array[Span] = [- embed_spans.bin -]'embed
require __array_length(spans) == 2
require spans[0].low == 1 and spans[0].high == 2
require spans[1].low == 3 and spans[1].high == 4

let where: uint = [- here -]'located
require where == 22019
__fd_write(2, "ok")
