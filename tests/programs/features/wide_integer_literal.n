func big() -> u128 {
    return 0xffffffffffffffffffffffffffffffff
}
func small() -> i128 {
    return -5
}
require big() == 0xffffffffffffffffffffffffffffffff
require big() != 0x99aa06d3014798d86001c324468d497f
require small() > -0x80000000000000000000000000000000
let x: u128 = 0x1_0000_0000_0000_0000
require x == 0x10000000000000000
__fd_write(2, "ok")
