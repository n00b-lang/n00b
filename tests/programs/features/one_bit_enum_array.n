enum Tc { none = 0, upper }

const fixed: Array[Tc] = [Tc.upper]

func update() -> bool {
    var cases: Array[Tc] = [Tc.none, Tc.upper, Tc.none]
    cases[2] = Tc.upper
    cases[1] = Tc.none
    var flags: Array[bool] = [true, false]
    flags[1] = true
    return cases[2] == Tc.upper and cases[1] == Tc.none and
        cases[0] != Tc.upper and flags[1]
}

require fixed[0] == Tc.upper
require update()
__fd_write(2, "ok")
