record Node {
    value: int
}

var width: Atomic[u32] = 5
var small: Atomic[i8] = -3
var flag: Atomic[bool] = false
var ratio: Atomic[f64] = 1.5
var head: Atomic[Ref[Node]?] = nil

func same(x: u32) -> u32 {
    return x
}

func bump(modify c: Atomic[u32]) {
    c = c + 1
}

func loads() -> bool {
    flag = !flag
    let w: u32 = width
    let total: u32 = w + same(width) + width
    var node: Node = (value = 7)
    head = ref node
    let h: Ref[Node]? = head
    var copy: Atomic[u32] = width
    bump(copy)
    return flag and total == 15 and width == 5 and small == -3 and
        ratio * 2.0 == 3.0 and h != nil and h.get().value == 7 and
        copy == 6
}

require loads()
__fd_write(2, "ok")
