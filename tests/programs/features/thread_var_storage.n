import sys.threads

record Holder {
    count: uint
    cells: Array[uint][3]
}

thread var held: Holder = (count = 2, cells = [5, 6, 7])
thread var grid: Array[uint][2][2] = [[1, 2], [3, 4]]
thread var names: Array[string][2] =
    ["a fairly long string value one", "a fairly long string value two"]
var written: Atomic[int] = 0
var seen: Atomic[uint] = 0
var finished: Atomic[int] = 0

func writer(argument: Ref[byte]) -> Ref[byte] {
    held.cells[1] = 70
    grid[1][0] = 30
    __atomic_store(ref written, 1)
    __atomic_fetch_add(ref finished, 1)
    return argument
}

func reader(argument: Ref[byte]) -> Ref[byte] {
    while __atomic_load(ref written) == 0 {
        sys.threads.thread_yield()
    }
    __atomic_store(ref seen, held.cells[1] * 100 + grid[1][0])
    __atomic_fetch_add(ref finished, 1)
    return argument
}

func copied_cells(h: Holder) -> Array[uint] {
    var cells: Array[uint] = h.cells
    cells[0] = 99
    return cells
}

var seed: byte = 0
require held.cells[2] == 7
require grid[0][1] == 2
require names[1] == "a fairly long string value two"
require sys.threads.thread_start(ref writer, ref seed)
require sys.threads.thread_start(ref reader, ref seed)
while __atomic_load(ref finished) < 2 {
    sys.threads.thread_yield()
}
require __atomic_load(ref seen) == 603
require held.cells[1] == 6
require grid[1][0] == 3
require copied_cells(held)[0] == 99
require held.cells[0] == 5
__fd_write(2, "ok")
