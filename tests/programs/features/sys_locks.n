import sys.threads
import sys.locks

var guard: sys.locks.Mutex
var table: sys.locks.Rw_Lock
var signal: sys.locks.Condition
var ready: Atomic[int] = 0
var total: int = 0
var finished: Atomic[int] = 0

func signaller(argument: Ref[byte]) -> Ref[byte] {
    sys.locks.condition_lock(ref signal)
    __atomic_store(ref ready, 1)
    sys.locks.condition_notify(ref signal, all = true, unlock = true)
    __atomic_fetch_add(ref finished, 1)
    return argument
}

func worker(argument: Ref[byte]) -> Ref[byte] {
    var round: int = 0
    while round < 1000 {
        sys.locks.mutex_lock(ref guard)
        total += 1
        sys.locks.mutex_unlock(ref guard)
        round += 1
    }
    sys.locks.rw_write_lock(ref table)
    sys.locks.rw_read_lock(ref table)
    sys.locks.rw_unlock(ref table)
    sys.locks.rw_unlock(ref table)
    __atomic_fetch_add(ref finished, 1)
    return argument
}

var seed: byte = 0
sys.locks.rw_lock_init(ref table)
require sys.threads.thread_start(ref worker, ref seed)
require sys.threads.thread_start(ref worker, ref seed)
while __atomic_load(ref finished) < 2 {
    sys.threads.thread_yield()
}
sys.locks.mutex_lock(ref guard)
sys.locks.mutex_lock(ref guard)
require total == 2000
sys.locks.mutex_unlock(ref guard)
sys.locks.mutex_unlock(ref guard)
require sys.locks.mutex_try_lock(ref guard)
sys.locks.mutex_unlock(ref guard)
sys.locks.condition_lock(ref signal)
require sys.threads.thread_start(ref signaller, ref seed)
while __atomic_load(ref ready) == 0 {
    require sys.locks.condition_wait(ref signal, timeout_ns = 5_000_000_000,
                                     unlock = false)
}
sys.locks.condition_unlock(ref signal)
while __atomic_load(ref finished) < 3 {
    sys.threads.thread_yield()
}
require !sys.locks.condition_wait(ref signal, timeout_ns = 1_000_000)
__fd_write(2, "ok")
