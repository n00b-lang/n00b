func at(value: 'V, index: int) -> byte {
    typecase value {
        case Array[byte] { return value[index] }
        else { return 0 }
    }
}

var bytes: Array[byte] = new[Array[byte]](2)
bytes[0] = cast[byte]7
bytes[1] = cast[byte]9
require at(bytes, 0) == 7
require at(bytes, 1) == 9
require at(42, 0) == 0
