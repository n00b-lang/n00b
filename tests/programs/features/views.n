object Counter {
    n: int
}

record Style {
    weight: int
    owner:  Counter
}

record Holder {
    style: View[Style]?
}

const plain: Style = (weight = 1, owner = (n = 7))
const bold: Style = (weight = 2, owner = (n = 8))

var current: View[Style] = ref plain
var held: Holder = (style = ref bold)
var items: Array[int] = [10, 20, 30, 40]

func style_weight(s: View[Style]) -> int {
    return s.__value.weight
}

func total(v: View[int]) -> int {
    var sum: int = 0
    var at: int = 0
    while at < cast[int] len(v) {
        sum += v[at]
        at += 1
    }
    return sum
}

func start() {
    require style_weight(current) == 1
    require current.__value.owner.n == 7
    let kept: View[Style]? = held.style
    require kept != nil
    current = ref bold
    require current == ref bold
    require style_weight(current) == 2

    let window: View[int] = view(items, 1, 3)
    require len(window) == 2
    require total(window) == 50
    items[1] = 25
    require window[0] == 25

    let copy = items[1:3]
    items[2] = 99
    require len(copy) == 2
    require copy[0] == 25 and copy[1] == 30

    __fd_write(2, "ok")
}
