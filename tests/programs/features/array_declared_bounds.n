func fill(n: uint) -> uint {
    var cells: Array[uint][n]
    var grid: Array[i32][2][3]
    var bytes: Array[u8][128]
    require cells[n - 1] == 0
    cells[0] = n
    grid[1][2] = 7
    bytes[127] = 1
    require grid[0][0] == 0
    return cells[0] + cast[uint] grid[1][2] + cast[uint] bytes[127]
}

func assign_once() -> u8 {
    let bytes: Array[u8][4]
    bytes = new[Array[u8][4]]()
    return bytes[2]
}

require fill(4) == 12
require assign_once() == 0
__fd_write(2, "ok")
