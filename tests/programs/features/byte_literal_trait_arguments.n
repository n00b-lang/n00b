var bytes: List[byte] = []
bytes.append(65)
require bytes[0] == 65
bytes[0] = 72
require bytes[0] == 72

func total(values: Array[u8]) -> uint {
    var sum: uint = 0
    for value in values {
        sum = sum + cast[uint]value
    }
    return sum
}

func listed(values: List[int]) -> uint {
    return values.len()
}

require total([1, 2, 250]) == 253
require total([]) == 0
require listed([1, 2]) == 2
