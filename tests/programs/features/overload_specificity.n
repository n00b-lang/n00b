import overload_imported

record Box {
    value: int
}

func imported_overloads() -> bool fail: int {
    var number: u32 = 0
    overload_imported.put(number)!
    var bytes: Array[u8] = new[Array[u8]](1)
    overload_imported.put(bytes)!
    let hash: u128 = overload_imported.hashed(number)!
    var small: u8 = 0
    overload_imported.store(small)!
    overload_imported.store(bytes)!
    return number == 7 and hash != 0 and small == 5 and bytes[0] == 6
}

func imported_overloads_hold() -> bool {
    try {
        return imported_overloads()!
    } fail(code) {
        return false
    }
}

func concrete_first(item: Box) -> int {
    return 2
}

func concrete_first(item: 'T) -> int {
    return 1
}

func generic_first(item: 'T) -> int {
    return 1
}

func generic_first(item: Box) -> int {
    return 2
}

func nested(item: Array['T]) -> int {
    return 1
}

func nested(item: Array[int]) -> int {
    return 2
}

func exact_over_conversion(item: 'T) -> int {
    return 1
}

func exact_over_conversion(item: string) -> int {
    return 2
}

func shared_type(left: 'T, right: 'T) -> int {
    return 1
}

func shared_type(left: int, right: string) -> int {
    return 2
}

func constrained(item: 'T) -> int {
    return 1
}

func optional_ref(memory: Ref[byte]?) -> int {
    return 1
}

func optional_ref(left: Ref[byte], right: int) -> int {
    return 2
}

func constrained(item: 'T) -> int where 'T: != string {
    return 2
}

func optional_box(item: Box?) -> int {
    return 1
}

func optional_box(left: int, right: int) -> int {
    return 2
}

func exact_over_optional(item: Box?) -> int {
    return 1
}

func exact_over_optional(item: Box) -> int {
    return 2
}

let box: Box = (value = 4)
require optional_box(box) == 1
require exact_over_optional(box) == 2
var cell: Array[u8] = new[Array[u8]](1)
let raw: Ref[byte] = unsafe_cast[Ref[byte]] ref cell[0]
require optional_ref(raw) == 1
require concrete_first(box) == 2
require generic_first(box) == 2
require concrete_first(4) == 1
require generic_first(4) == 1
let numbers: Array[int] = [1, 2]
require nested(numbers) == 2
var buffer: Buffer = buffer_from_string("x")
require exact_over_conversion(buffer) == 1
require shared_type(1, "a") == 2
require constrained(1) == 2
require constrained("a") == 1
require imported_overloads_hold()
__fd_write(2, "ok")
