func runtime_sized(n: uint) -> u8 {
    let bytes: Array[u8] = new[Array[u8]](n)
    bytes[2] = 3
    bytes[2] += 1
    return bytes[2]
}

func fixed() -> u32 {
    let words: Array[u32][4] = new[Array[u32][4]]()
    words[3] = 9
    return words[3]
}

func grid() -> i32 {
    let cells: Array[i32][2][3] = new[Array[i32][2][3]]()
    cells[1][2] = 7
    return cells[1][2]
}

func deferred() -> u8 {
    let bytes: Array[u8][4]
    bytes = new[Array[u8][4]]()
    bytes[1] = 5
    return bytes[1]
}

require runtime_sized(4) == 4
require fixed() == 9
require grid() == 7
require deferred() == 5
__fd_write(2, "ok")
