record Point {
    x: int
    y: int
}

trait Measured {
    func measure(self: `T, scale: u8) -> u8
}

func measure(self: Point, scale: u8) -> u8 {
    return scale
}

func narrow(value: u8, ratio: f64 = 0.5) -> u8 {
    return value
}

func sum(point: Point) -> int {
    return point.x + point.y
}

func pick(chosen: `T, other: `T) -> `T {
    return chosen
}

func size(text: string) -> uint {
    return byte_len(text)
}

func maybe(value: int?) -> int {
    return value.get_or_else(default = 7)
}

record Holder {
    n: u8
}

func __init(modify self: Holder, count: u8) {
    self.n = count
}

context Label(width: u8, origin: Point) {
    enter() {
    }
    ensure() {
    }
}

var b: Buffer = buffer_from_string("abc")
let h: Holder = new[Holder](count = 200)
var p: Point = (x = 1, y = 2)

require narrow(value = 250) == 250
require narrow(ratio = 2.0, value = 3) == 3
require sum(point = (x = 3, y = 4)) == 7
require pick(other = "b", chosen = "a") == "a"
require sum(point = pick(other = p, chosen = (x = 5, y = 6))) == 11
require size(text = b) == 3
require maybe(value = 5) == 5
require maybe(value = nil) == 7
require p.measure(scale = 255) == 255
require h.n == 200
with Label(width = 255, origin = (x = 0, y = 0)) {
}
