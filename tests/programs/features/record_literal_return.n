record Handle {
    raw: uint
}

func make(raw: uint) -> Handle {
    return (raw = raw)
}

func checked(raw: uint) -> Handle fail: string {
    if raw == 0 {
        fail "zero"
    }
    return (raw = raw + 1)
}

require make(5).raw == 5
try {
    require checked(1)!.raw == 2
} else failure {
    require false
}
