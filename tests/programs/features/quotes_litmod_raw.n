litmod<quotes> raw_text, verbatim(text: string) -> string fail: string {
    return text
}

func rejected(text: string) -> bool {
    let decoded = try {
        = decode_escapes(text)!
    } else e {
        = "rejected"
    }
    return decoded == "rejected"
}

func local_spelling() -> uint {
    return byte_len("x\ty"'verbatim)
}

let spelled: string = "a\nb"'verbatim
require byte_len(spelled) == 4
require local_spelling() == 4
let decoded: string = try {
    = decode_escapes(spelled)!
} else e {
    = ""
}
require byte_len(decoded) == 3
require decoded == "a\nb"
let accent: string = try {
    = decode_escapes("caf\\u00e9 \\x41\\U0001F600 \\t\\\"")!
} else e {
    = ""
}
require accent == "café \x41\U0001F600 \t\""
require rejected("bad \\q escape")
require rejected("short \\u12")
require rejected("trailing \\")
require rejected("\\uD800")
__fd_write(2, "ok")
