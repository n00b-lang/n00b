record Point {
    x: int
    y: int
}

func bump(modify n: int) {
    n += 1
}

func cell(r: Ref[int]) -> Ref[int] {
    return r
}

func local_cases() {
    var a: int = 1
    let r: Ref[int] = ref a
    require r.__value == 1
    r.__value = 5
    r.__value += 2
    bump(r.__value)
    require a == 8
    let same: Ref[int] = ref r.__value
    same.__value = 20
    cell(r).__value -= 1
    require a == 19
    var p: Point = (x = 1, y = 2)
    let rp: Ref[Point] = ref p
    rp.x = 10
    rp.__value.y = 30
    let whole: Point = rp.__value
    require whole.x == 10 and whole.y == 30
    rp.__value = (x = 4, y = 5)
    require p.x == 4 and p.y == 5
    let rr: Ref[Ref[int]] = ref r
    rr.__value.__value = 40
    require a == 40
}

local_cases()

var g: int = 1
let gr: Ref[int] = ref g
gr.__value = 5
require g == 5
gr.__value += 2
require g == 7
bump(gr.__value)
require g == 8
__fd_write(2, "ok")
