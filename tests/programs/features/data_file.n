import sys.fs

record Lanes {
    lanes: Array[u8][4]
}

const table: Array[u8] = sys.fs.data_file(source_dir() + "/data_file.bin")
const lanes: Lanes = (lanes = [table[0], table[1], table[2], table[4]])

require __array_length(table) == 5
require table[0] == 0x41
require table[3] == 0
require table[4] == 0xff
require lanes.lanes[1] == 0x42
require lanes.lanes[3] == 0xff
__fd_write(2, "ok")
