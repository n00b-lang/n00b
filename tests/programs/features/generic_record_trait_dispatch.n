import text

trait Describe {
    func describe(self: `T) -> int
}

func describe(self: Dict[string, `V]) -> int {
    return 1
}

func describe(self: Dict[int, `V]) -> int {
    return 2
}

func size_of(x: `C) -> uint where `C: Has_Length {
    return x.len()
}

func hashed(x: `H) -> u128 where `H: Hash {
    return x.hash()
}

flagset Edge {
    top, bottom, left, right
}

func combine(a: `T, b: `T) -> `T where `T: Add {
    return a + b
}

func strip(a: `T, b: `T) -> `T where `T: Subtract {
    return a - b
}

func pick(x: `T) -> int where `T: Describe {
    return x.describe()
}

func classify(x: `T) -> int {
    typecase x {
        case Dict[string, `V] { return 1 }
        case Dict[`K, `K] { return 2 }
        case List[List[`E]] { return 3 }
        else { return 0 }
    }
}

var d: Dict[string, int] = {"a": 1, "b": 2}
var s: Set[int] = {1, 2, 3, 4}
var t: Set[int] = {4, 3, 2, 1}
let l = [1, 2, 3]
let a: Array[int] = [5, 6]
require size_of(d) == 2
require size_of(s) == 4
require size_of(l) == 3
require size_of(a) == 2
require size_of("héllo") == 5
require hashed(s) == hashed(t)

var by_number: Dict[int, int] = {1: 2}
var by_number_text: Dict[int, string] = {1: "x"}
require pick(d) == 1
require pick(by_number) == 2
require classify(d) == 1
require classify(by_number) == 2
require classify(by_number_text) == 0
let inner: List[int] = [1]
let outer: List[List[int]] = [inner]
require classify(outer) == 3
require classify(inner) == 0
let both: Edge = combine(Edge.top, Edge.left)
require both == Edge.top + Edge.left
require strip(both, Edge.top) == Edge.left
require combine(2, 3) == 5
__fd_write(2, "ok")
