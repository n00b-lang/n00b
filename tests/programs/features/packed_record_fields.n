enum Mode {
    a = 0, b = 1, c = 2
}

flagset Perm {
    read, write, exec
}

record Inner {
    on:   bool
    mode: Mode
}

record Packed {
    name:  string
    x:     bool
    mode:  Mode
    small: u:3
    perm:  Perm
    maybe: bool?
    count: int
    inner: Inner
    y:     bool
}

const base: Packed = (name = "base", x = true, mode = Mode.c, small = 5,
                      perm = Perm.write, maybe = false, count = 7,
                      inner = (on = true, mode = Mode.b), y = false)

func flip(modify v: bool) {
    v = !v
}

func set_mode(modify m: Mode) {
    m = Mode.a
}

func check(p: Packed?) -> int {
    if p == nil {
        return 0
    }
    return p.get().count
}

comptime {} else {
    var p: Packed = base
    require p.x
    require p.mode == Mode.c
    require p.small == 5
    require p.perm == Perm.write
    require p.maybe != nil
    require p.count == 7
    require p.inner.on
    require p.inner.mode == Mode.b
    require !p.y
    require p.name == "base"
    p.y = true
    p.mode = Mode.b
    p.small = 6
    p.inner.mode = Mode.c
    p.maybe = nil
    require p.y and p.x
    require p.mode == Mode.b
    require p.small == 6
    require p.inner.mode == Mode.c
    require p.maybe == nil
    flip(p.x)
    require !p.x
    set_mode(p.mode)
    require p.mode == Mode.a
    require check(p) == 7
    require check(nil) == 0
    var ps: Array[Packed] = new[Array[Packed]](3)
    ps[1] = p
    require ps[1].small == 6
    require !ps[0].y
    var modes: Array[Mode] = new[Array[Mode]](5)
    modes[3] = Mode.c
    require modes[3] == Mode.c
    require modes[2] == Mode.a
    var smalls: Array[u:3] = new[Array[u:3]](4)
    smalls[2] = 7
    require smalls[2] == 7
    var perms: Array[Perm] = new[Array[Perm]](2)
    perms[1] = Perm.read + Perm.exec
    require perms[1] == Perm.read + Perm.exec
    let q: Packed = (name = "q", x = false, mode = Mode.a, small = 1,
                     perm = Perm.exec, maybe = true, count = 3,
                     inner = (on = false, mode = Mode.a), y = true)
    require q.y and !q.x and q.small == 1
}
