record Failure {
    public code: i64
    public text: string?
    public limit: u32?
}

func __init(modify self: Failure, code: i64, text: string?, limit: u32? = nil) {
    self.code = code
    self.text = text
    self.limit = limit
}

func risky(code: i64) -> nil fail: Failure {
    fail new[Failure](code, nil)
}

func limit_of(failure: Failure) -> u32 {
    let limit = failure.limit
    if limit == nil {
        return 0
    }
    return limit.get()
}

let plain = new[Failure](cast[i64]1, "named", 7)
require plain.text != nil
require limit_of(plain) == 7
let empty = new[Failure](cast[i64]2, nil, limit = 9)
require empty.text == nil
require limit_of(empty) == 9
try {
    risky(3)!
} fail(failure) {
    require failure.code == 3
    require limit_of(failure) == 0
}
