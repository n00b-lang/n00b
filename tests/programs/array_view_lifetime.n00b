trait Index_Slice {
    func __slice(self: `T, start_ix: int = 0, end_ix: int = -1) -> View[`E]
}

func __slice(self: Array[int], start_ix: int = 0, end_ix: int = -1) -> View[int] {
    return self [:]
}

var retained_view: View[int]

func consume_view(item: View[int]) -> int { return 0 }

func retain_view(item: View[int]) { retained_view = item }

func read_local_view(items: Array[int]) -> int {
    var local_view: View[int] = items [:]
    return consume_view(local_view)
}

func return_view(items: Array[int]) -> View[int] {
    return items [:]
}

func pass_to_escaping_parameter(items: Array[int]) {
    var local_view: View[int] = items [:]
    retain_view(local_view)
}
