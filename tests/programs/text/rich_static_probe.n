import text
import rich_static_base

record String_Words layout(c) {
    data:     Ref[byte]
    selector: u64
}

var failures: int = 0

func check(ok: bool, code: string) {
    if !ok {
        __fd_write(2, "FAIL rich_static_probe " + code + "\n")
        failures += 1
    }
}

func rich_over(body: Ref[text.Rich_Body]) -> string {
    var words: String_Words = (data = unsafe_cast[Ref[byte]] body,
                               selector = str_tag_rich << 62)
    let view: Ref[string] = unsafe_cast[Ref[string]] ref words
    let s: string = view
    return s
}

func body_of(s: string) -> Ref[text.Rich_Body] {
    var copy: string = s
    let words: Ref[String_Words] = unsafe_cast[Ref[String_Words]] ref copy
    return unsafe_cast[Ref[text.Rich_Body]] words.data
}

func is_rich(s: string) -> bool {
    return cast[u64] tag(s) == str_tag_rich
}

func one_record() -> List[text.Style_Record] {
    var records: List[text.Style_Record] = new[List[text.Style_Record]]()
    let blank: text.Style_Record = (start_ix = nil, end_ix = nil,
                                    style_tag = nil, format_spec = nil,
                                    substitution = (none = nil))
    records.append(blank)
    return records
}

var rs_body: text.Rich_Body = (s = "hello world", style_info = one_record(),
                               base_style = nil, opaque = false)
let rs: string = rich_over(ref rs_body)
var rs_outer_body: text.Rich_Body = (s = rs, style_info = one_record(),
                                     base_style = nil, opaque = false)
let rs_outer: string = rich_over(ref rs_outer_body)

func run_checks() {
    check(is_rich(rs), "1")
    check(body_of(rs) == ref rs_body, "2")
    check(byte_len(rs_body.s) == 11, "3")
    check(rs_body.style_info.len() == 1, "4")
    let base: string = rich_static_base.base_of(rs)
    check(!is_rich(base) and byte_len(base) == 11, "5")
    check(is_rich(rs_outer) and is_rich(rs_outer_body.s), "6")
    let nested: string = rich_static_base.base_of(rs_outer)
    check(!is_rich(nested) and byte_len(nested) == 11, "7")
    let plain: string = rich_static_base.base_of("not rich")
    check(!is_rich(plain) and byte_len(plain) == 8, "8")
    check(byte_len(rs) == 11 and byte_len(rs_outer) == 11, "9")
    check(byte_at(rs, 0) == cast[u8] 'h' and byte_at(rs_outer, 0) == cast[u8] 'h',
          "10")
    check(byte_len(buffer_from_string(rs_outer)) == 11, "11")
}

run_checks()
if failures == 0 {
    __fd_write(2, "ok")
}
