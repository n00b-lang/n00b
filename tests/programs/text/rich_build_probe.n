import text

record String_Words layout(c) {
    data:     Ref[byte]
    selector: u64
}

var failures: int = 0

func check(ok: bool, code: string) {
    if !ok {
        __fd_write(2, "FAIL rich_build_probe " + code + "\n")
        failures += 1
    }
}

func is_rich(s: string) -> bool {
    return cast[u64] tag(s) == str_tag_rich
}

func body_of(s: string) -> Ref[text.Rich_Body] {
    var copy: string = s
    let words: Ref[String_Words] = unsafe_cast[Ref[String_Words]] ref copy
    return unsafe_cast[Ref[text.Rich_Body]] words.data
}

func record_count(s: string) -> uint {
    if !is_rich(s) {
        return 0
    }
    return body_of(s).style_info.len()
}

func opt_is(o: u32?, v: u32) -> bool {
    if o == nil {
        return false
    }
    return o.get() == v
}

func push_span(modify spans: List[text.Style_Span], start: u32, end: u32,
               tag: string) {
    let s: text.Style_Span = (start = start, end = end, tag = tag)
    spans.append(s)
}

func byte_slice_of(s: string, start: i64, end: i64) -> string {
    var got: string = ""
    try {
        got = text.slice(s, start, end, unit = text.Index_Unit.byte)!
    } else failure {
        got = ""
    }
    return got
}

func run_checks() {
    var spans: List[text.Style_Span] = new[List[text.Style_Span]]()
    push_span(spans, 0, 4, "b")
    let built: string = text.rich_string("text", spans)
    check(is_rich(built), "1")
    check(byte_len(built) == 4 and byte_at(built, 0) == cast[u8] 't', "2")
    check(record_count(built) == 1, "3")

    let literal: string = "«b»text«/b»"'r
    check(built == literal, "4")
    check(built.hash() == literal.hash(), "5")

    var ext: List[text.Style_Span] = new[List[text.Style_Span]]()
    push_span(ext, 0, text.index_extends, "b")
    let open_ended: string = text.rich_string("text", ext)
    let unclosed: string = "«b»text"'r
    check(open_ended == unclosed, "6")
    check(built != open_ended, "7")

    var many: List[text.Style_Span] = new[List[text.Style_Span]]()
    push_span(many, 0, 2, "b")
    push_span(many, 2, 4, "@error")
    let two: string = text.rich_string("text", many)
    check(record_count(two) == 2, "8")
    if record_count(two) == 2 {
        let second: text.Style_Record = body_of(two).style_info[1]
        check(opt_is(second.start_ix, 2) and opt_is(second.end_ix, 4), "9")
        check(second.style_tag != nil, "10")
    }

    let nested: string = "«b»alpha «i»beta«/i»«/b»"'r
    let tail: string = byte_slice_of(nested, 6, 10)
    check(text.eq(tail, "beta"), "11")
    check(record_count(tail) == 2, "12")
    if record_count(tail) == 2 {
        let recs: List[text.Style_Record] = body_of(tail).style_info
        var clipped: bool = true
        for i from 0 until 2 {
            clipped = clipped and opt_is(recs[i].start_ix, 0) and
                opt_is(recs[i].end_ix, 4)
        }
        check(clipped, "13")
    }

    let head: string = byte_slice_of(nested, 0, 5)
    check(record_count(head) == 1, "14")

    let carry: string = byte_slice_of("«b»head tail"'r, 5, 9)
    check(record_count(carry) == 1, "15")
    if record_count(carry) == 1 {
        let er: text.Style_Record = body_of(carry).style_info[0]
        check(opt_is(er.start_ix, 0) and
              opt_is(er.end_ix, text.index_extends), "16")
    }
}

run_checks()
if failures == 0 {
    __fd_write(2, "ok")
}
