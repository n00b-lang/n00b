import text

func check(ok: bool, code: string, read_fd: int, write_fd: int) {
    if !ok {
        __os_close(read_fd)
        __os_close(write_fd)
        __fd_write(2, "FAIL capability_probe " + code + "\n")
        require false
    }
}

func capability_probe_main() {
    var read_fd: int = -1
    var write_fd: int = -1
    require __os_pipe(ref read_fd, ref write_fd) == 0
    text.terminal_force_color_depth(nil)
    check(text.terminal_color_depth(read_fd) == text.Color_Depth.mono, "1",
          read_fd, write_fd)
    text.terminal_force_color_depth(text.Color_Depth.truecolor)
    check(text.terminal_color_depth(read_fd) == text.Color_Depth.truecolor,
          "2", read_fd, write_fd)
    text.terminal_force_color_depth(text.Color_Depth.colors_256)
    check(text.terminal_color_depth(read_fd) == text.Color_Depth.colors_256,
          "3", read_fd, write_fd)
    text.terminal_force_color_depth(nil)
    check(text.terminal_color_depth(read_fd) == text.Color_Depth.mono, "4",
          read_fd, write_fd)
    check(text.terminal_width(read_fd) == nil, "5", read_fd, write_fd)
    require __os_close(write_fd) == 0
    require __os_close(read_fd) == 0
}

capability_probe_main()
__fd_write(2, "ok")
