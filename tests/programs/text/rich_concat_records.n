// A compile-time regression. Each add function builds strings with `+`
// and stores records holding them in lists of one shared parameter, and
// `block` calls all of them. Since `+` keeps rich strings' spans, a string
// it makes points into the strings it was made from. Summaries once named
// such a fresh string, and what it was filled in with, by the parameter
// place it was put in, so callers took every string already there to be
// written to, and the points-to solve of `block` grew far faster than the
// number of add functions.

record Entry {
    open:  string
    close: string
    note:  string?
}

record Book {
    list0:  List[Entry]
    list1:  List[Entry]
    list2:  List[Entry]
    list3:  List[Entry]
    list4:  List[Entry]
    list5:  List[Entry]
    list6:  List[Entry]
    list7:  List[Entry]
    list8:  List[Entry]
    list9:  List[Entry]
    list10: List[Entry]
    list11: List[Entry]
    list12: List[Entry]
    list13: List[Entry]
    list14: List[Entry]
    list15: List[Entry]
    list16: List[Entry]
    list17: List[Entry]
    list18: List[Entry]
    list19: List[Entry]
    list20: List[Entry]
    list21: List[Entry]
    list22: List[Entry]
    list23: List[Entry]
    diags:  List[string]
    names:  List[string]
}

func report(b: Book, code: string, message: string) {
    b.diags.append("lex/" + code + ": " + message)
}

func add0(b: Book, words: List[string], note: string?) {
    if words.len() < 2 {
        report(b, "bad0", "needs two words, got " + note.get_or_else("none"))
        return
    }
    b.list0.append((open = words[0] + "<", close = ">" + words[1],
                     note = note))
    b.names.append(words[0] + words[1])
}

