func block(b: Book, kind: string, forms: List[List[string]]) {
    for words in forms {
        var note: string? = nil
        if words.len() > 2 {
            note = words[2] + "!"
        }
        if kind == "none" {
            report(b, "none", "no kind")
        }
        elif kind == "k0" {
            add0(b, words, note)
        }
        elif kind == "k1" {
            add1(b, words, note)
        }
        elif kind == "k2" {
            add2(b, words, note)
        }
        elif kind == "k3" {
            add3(b, words, note)
        }
        elif kind == "k4" {
            add4(b, words, note)
        }
        elif kind == "k5" {
            add5(b, words, note)
        }
        elif kind == "k6" {
            add6(b, words, note)
        }
        elif kind == "k7" {
            add7(b, words, note)
        }
        elif kind == "k8" {
            add8(b, words, note)
        }
        elif kind == "k9" {
            add9(b, words, note)
        }
        elif kind == "k10" {
            add10(b, words, note)
        }
        elif kind == "k11" {
            add11(b, words, note)
        }
        elif kind == "k12" {
            add12(b, words, note)
        }
        elif kind == "k13" {
            add13(b, words, note)
        }
        elif kind == "k14" {
            add14(b, words, note)
        }
        elif kind == "k15" {
            add15(b, words, note)
        }
        elif kind == "k16" {
            add16(b, words, note)
        }
        elif kind == "k17" {
            add17(b, words, note)
        }
        elif kind == "k18" {
            add18(b, words, note)
        }
        elif kind == "k19" {
            add19(b, words, note)
        }
        elif kind == "k20" {
            add20(b, words, note)
        }
        elif kind == "k21" {
            add21(b, words, note)
        }
        elif kind == "k22" {
            add22(b, words, note)
        }
        elif kind == "k23" {
            add23(b, words, note)
        }
    }
    report(b, "done", kind + " finished")
}

func new_book() -> Book {
    return (
        list0 = new[List[Entry]](),
        list1 = new[List[Entry]](),
        list2 = new[List[Entry]](),
        list3 = new[List[Entry]](),
        list4 = new[List[Entry]](),
        list5 = new[List[Entry]](),
        list6 = new[List[Entry]](),
        list7 = new[List[Entry]](),
        list8 = new[List[Entry]](),
        list9 = new[List[Entry]](),
        list10 = new[List[Entry]](),
        list11 = new[List[Entry]](),
        list12 = new[List[Entry]](),
        list13 = new[List[Entry]](),
        list14 = new[List[Entry]](),
        list15 = new[List[Entry]](),
        list16 = new[List[Entry]](),
        list17 = new[List[Entry]](),
        list18 = new[List[Entry]](),
        list19 = new[List[Entry]](),
        list20 = new[List[Entry]](),
        list21 = new[List[Entry]](),
        list22 = new[List[Entry]](),
        list23 = new[List[Entry]](),
        diags = new[List[string]](), names = new[List[string]]())
}

var b:     Book               = new_book()
var forms: List[List[string]] = [["a", "b"], ["c", "d", "e"]]
block(b, "k1", forms)
block(b, "k7", forms)
if b.names.len() == 4 and b.list1.len() == 2 and b.list7.len() == 2
    and b.diags.len() == 2 and b.list1[0].open == "a<"
    and b.list7[1].close == ">d" and b.list7[1].note.get_or_else("") == "e!"
    and b.diags[1] == "lex/done: k7 finished" {
    __fd_write(2, "ok")
}
else {
    __fd_write(2, "wrong result")
}
