import text

var failures: int = 0

func check(ok: bool, code: string) {
    if !ok {
        __fd_write(2, "FAIL layout_probe " + code + "\n")
        failures += 1
    }
}

func results_for(n: int) -> Array[text.Layout_Result] {
    var r: Array[text.Layout_Result] = new[Array[text.Layout_Result]](n)
    for i from 0 until n {
        r[i] = (computed_min = 0, computed_max = 0, computed_pref = 0,
                size = 0, has_max = false)
    }
    return r
}

func blank_item() -> text.Layout {
    return (min = nil, max = nil, pref = nil, priority = 0,
            flex_multiple = 0, child_gap = 0)
}

func total_size(r: Array[text.Layout_Result], n: i64) -> i64 {
    var sum: i64 = 0
    for i from 0 until n {
        sum += r[i].size
    }
    return sum
}

func fixed_item(min: i64, pref: i64, max: i64) -> text.Layout {
    var item: text.Layout = blank_item()
    if min >= 0 {
        item.min = text.abs_dim(min)
    }
    if pref >= 0 {
        item.pref = text.abs_dim(pref)
    }
    if max >= 0 {
        item.max = text.abs_dim(max)
    }
    return item
}

func run_checks() {
    var one: Array[text.Layout] = new[Array[text.Layout]](1)
    var r1: Array[text.Layout_Result] = results_for(1)
    one[0] = fixed_item(-1, 40, -1)
    text.layout_calculate(one, r1, 1, 80)
    check(r1[0].size == 40, "1")

    var two: Array[text.Layout] = new[Array[text.Layout]](2)
    var r2: Array[text.Layout_Result] = results_for(2)
    two[0] = fixed_item(10, 30, -1)
    two[1] = fixed_item(10, 30, -1)
    text.layout_calculate(two, r2, 2, 80)
    check(r2[0].size == 30 and r2[1].size == 30, "2")

    var capped: Array[text.Layout] = new[Array[text.Layout]](2)
    var r3: Array[text.Layout_Result] = results_for(2)
    capped[0] = fixed_item(-1, 20, 25)
    capped[1] = fixed_item(-1, 20, 25)
    text.layout_calculate(capped, r3, 2, 80)
    check(r3[0].size <= 25 and r3[1].size <= 25, "3")

    var flex: Array[text.Layout] = new[Array[text.Layout]](3)
    var r4: Array[text.Layout_Result] = results_for(3)
    flex[0] = fixed_item(10, -1, -1)
    flex[0].flex_multiple = 1
    flex[1] = fixed_item(10, -1, -1)
    flex[1].flex_multiple = 2
    flex[2] = fixed_item(10, -1, -1)
    flex[2].flex_multiple = 1
    text.layout_calculate(flex, r4, 3, 90)
    check(total_size(r4, 3) == 90, "4")
    check(r4[1].size > r4[0].size and r4[1].size > r4[2].size, "5")

    var over: Array[text.Layout] = new[Array[text.Layout]](3)
    var r5: Array[text.Layout_Result] = results_for(3)
    over[0] = fixed_item(5, 30, -1)
    over[1] = fixed_item(5, 30, -1)
    over[2] = fixed_item(5, 30, -1)
    text.layout_calculate(over, r5, 3, 50)
    check(total_size(r5, 3) <= 50 and r5[0].size >= 5 and r5[1].size >= 5 and
          r5[2].size >= 5, "6")

    var pri: Array[text.Layout] = new[Array[text.Layout]](3)
    var r6: Array[text.Layout_Result] = results_for(3)
    pri[0] = fixed_item(10, 20, -1)
    pri[0].priority = 0
    pri[1] = fixed_item(10, 20, -1)
    pri[1].priority = 10
    pri[2] = fixed_item(10, 20, -1)
    pri[2].priority = 5
    text.layout_calculate(pri, r6, 3, 15)
    check(r6[1].size >= r6[0].size and r6[1].size >= r6[2].size and
          total_size(r6, 3) <= 15, "7")

    var pct: Array[text.Layout] = new[Array[text.Layout]](2)
    var r7: Array[text.Layout_Result] = results_for(2)
    pct[0] = blank_item()
    pct[1] = blank_item()
    pct[0].pref = text.pct_dim(0.25)
    pct[1].pref = text.pct_dim(0.50)
    text.layout_calculate(pct, r7, 2, 100)
    check(r7[0].size == 25 and r7[1].size == 50, "8")

    text.layout_calculate(one, r1, 0, 100)

    var exact: Array[text.Layout] = new[Array[text.Layout]](3)
    var r8: Array[text.Layout_Result] = results_for(3)
    exact[0] = fixed_item(-1, 20, -1)
    exact[1] = fixed_item(-1, 30, -1)
    exact[2] = fixed_item(-1, 50, -1)
    text.layout_calculate(exact, r8, 3, 100)
    check(r8[0].size == 20 and r8[1].size == 30 and r8[2].size == 50, "9")

    var zero_max: Array[text.Layout] = new[Array[text.Layout]](2)
    var r9: Array[text.Layout_Result] = results_for(2)
    zero_max[0] = fixed_item(-1, -1, 0)
    zero_max[1] = fixed_item(-1, 10, -1)
    zero_max[1].flex_multiple = 1
    text.layout_calculate(zero_max, r9, 2, 40)
    check(r9[0].size == 0, "10")
    check(r9[0].has_max and !r9[1].has_max, "11")

    var many: Array[text.Layout] = new[Array[text.Layout]](40)
    var r900: Array[text.Layout_Result] = results_for(40)
    for i from 0 until 40 {
        if i % 2 == 0 {
            many[i] = fixed_item(1, 1, 3)
        }
        else {
            many[i] = fixed_item(1, 1, -1)
            many[i].flex_multiple = 1
        }
    }
    text.layout_calculate(many, r900, 40, 200)
    var own: bool = total_size(r900, 40) == 200
    for i from 0 until 40 {
        if i % 2 == 0 {
            own = own and r900[i].size == 3 and r900[i].has_max
        }
        else {
            own = own and r900[i].size == 7 and !r900[i].has_max
        }
    }
    check(own, "900")
}

run_checks()
if failures == 0 {
    __fd_write(2, "ok")
}
