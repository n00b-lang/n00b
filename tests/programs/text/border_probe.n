import text

func check(ok: bool, code: string) {
    if !ok {
        __fd_write(2, "FAIL border_probe " + code + "\n")
        require false
    }
}

let all_themes: Array[text.Border_Theme] = [
    text.border_plain,
    text.border_bold,
    text.border_double,
    text.border_dash,
    text.border_bold_dash,
    text.border_dash2,
    text.border_bold_dash2,
    text.border_ascii,
    text.border_rounded,
]

func glyph_set(c: char) -> bool {
    return cast[u32] c != 0
}

func border_probe_main() {
    check(all_themes.len() == 9, "1")
    var i: uint = 0
    while i < all_themes.len() {
        let t: text.Border_Theme = all_themes[i]
        check(glyph_set(t.horizontal) and glyph_set(t.vertical) and
              glyph_set(t.upper_left) and glyph_set(t.upper_right) and
              glyph_set(t.lower_left) and glyph_set(t.lower_right) and
              glyph_set(t.cross) and glyph_set(t.top_t) and
              glyph_set(t.bottom_t) and glyph_set(t.left_t) and
              glyph_set(t.right_t), "2")
        i += 1
    }
    check(cast[u32] text.border_plain.horizontal == 0x2500 and
          cast[u32] text.border_plain.vertical == 0x2502 and
          cast[u32] text.border_plain.upper_left == 0x250c and
          cast[u32] text.border_plain.cross == 0x253c, "3")
    check(cast[u32] text.border_double.horizontal == 0x2550 and
          cast[u32] text.border_double.cross == 0x256c, "4")
    check(cast[u32] text.border_rounded.upper_left == 0x256d and
          cast[u32] text.border_rounded.lower_right == 0x256f, "5")
    check(text.border_ascii.horizontal == '-' and
          text.border_ascii.vertical == '|' and
          text.border_ascii.upper_left == '/' and
          text.border_ascii.upper_right == '\\' and
          text.border_ascii.cross == '+', "6")
    check(text.Border_Set.sides == text.Border_Set.left + text.Border_Set.right
          and cast[u64] text.Border_Set.all == 0x3f, "7")
}

border_probe_main()
__fd_write(2, "ok")
