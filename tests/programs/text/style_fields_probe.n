import text

record String_Words layout(c) {
    data:     Ref[byte]
    selector: u64
}

func check(ok: bool, code: string) {
    if !ok {
        __fd_write(2, "FAIL style_fields_probe " + code + "\n")
        require false
    }
}

func rich_over(body: Ref[text.Rich_Body]) -> string {
    var words: String_Words = (data = unsafe_cast[Ref[byte]] body,
                               selector = str_tag_rich << 62)
    let view: Ref[string] = unsafe_cast[Ref[string]] ref words
    let s: string = view
    return s
}

func no_records() -> List[text.Style_Record] {
    return new[List[text.Style_Record]]()
}

var plain_body: text.Rich_Body
plain_body.s = "hello"
plain_body.style_info = no_records()
var based_body: text.Rich_Body = (s = "hello", style_info = no_records(),
                                  base_style = nil, opaque = false)
var opaque_body: text.Rich_Body = (s = "hello", style_info = no_records(),
                                   base_style = nil, opaque = true)

let plain_s: string = rich_over(ref plain_body)
let based_s: string = rich_over(ref based_body)
let opaque_s: string = rich_over(ref opaque_body)

var bold_outer_body: text.Rich_Body = (s = "«b»hello"'r,
                                       style_info = no_records(),
                                       base_style = nil, opaque = false)
var italic_outer_body: text.Rich_Body = (s = "«i»hello"'r,
                                         style_info = no_records(),
                                         base_style = nil, opaque = false)

let bold_outer: string = rich_over(ref bold_outer_body)
let italic_outer: string = rich_over(ref italic_outer_body)

func style_fields_probe_main() {
    check(plain_body.base_style == nil, "1")
    check(!plain_body.opaque, "2")

    var bold: text.Text_Style
    bold.bold = true
    based_body.base_style = bold

    check(plain_s != based_s, "3")
    check(plain_s.hash() != based_s.hash(), "4")
    check(plain_s != opaque_s, "5")
    check(plain_s.hash() != opaque_s.hash(), "6")
    check(plain_s == plain_s and plain_s.hash() == plain_s.hash(), "7")

    let lit: string = "«b»hello"'r
    let lit_same: string = "«b»hello"'r
    check(lit.hash() == lit_same.hash(), "8")
    check(lit == lit_same, "9")

    let lit_other: string = "«i»hello"'r
    check(lit != lit_other and lit.hash() != lit_other.hash(), "10")

    check(cast[u64] tag(bold_outer_body.s) == str_tag_rich and
          cast[u64] tag(italic_outer_body.s) == str_tag_rich, "900")
    check(bold_outer != italic_outer and
          bold_outer.hash() != italic_outer.hash(), "900")
}

style_fields_probe_main()
__fd_write(2, "ok")
