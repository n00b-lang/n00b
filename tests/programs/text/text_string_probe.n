import text
import unicode

var failures: int = 0

func check(ok: bool, code: string) {
    if !ok {
        __fd_write(2, "FAIL text_string_probe " + code + "\n")
        failures += 1
    }
}

func same(a: string, b: string) -> bool {
    return text.eq(a, b)
}

func same_opt(a: string?, b: string) -> bool {
    if a == nil {
        return false
    }
    return text.eq(a.get(), b)
}

func index_of(s: string, n: i64, unit: text.Index_Unit) -> string? {
    var got: string? = nil
    try {
        got = text.index(s, n, unit = unit)!
    } else failure {
        got = nil
    }
    return got
}

func slice_of(s: string, start: i64, end: i64, unit: text.Index_Unit)
    -> string? {
    var got: string? = nil
    try {
        got = text.slice(s, start, end, unit = unit)!
    } else failure {
        got = nil
    }
    return got
}

func find_of(s: string, sub: string, unit: text.Index_Unit) -> uint? {
    var got: uint? = nil
    try {
        got = text.find(s, sub, unit = unit)!
    } else failure {
        got = nil
    }
    return got
}

func cased(s: string, which: int) -> string? {
    var got: string? = nil
    try {
        if which == 0 {
            got = text.upper(s)!
        }
        elif which == 1 {
            got = text.lower(s)!
        }
        elif which == 2 {
            got = text.fold(s)!
        }
        else {
            got = text.title(s)!
        }
    } else failure {
        got = nil
    }
    return got
}

func seeks(modify c: text.Str_Cursor, n: i64) -> bool {
    let got: bool = try {
        = text.seek(c, n)!
    } else failure {
        = false
    }
    return got
}

func check_ascii_identity() {
    let s: string = "plain ascii text"
    let n: u64 = text.unit_count(s, text.Index_Unit.char)
    check(n == 16, "1")
    check(text.unit_count(s, text.Index_Unit.char) == n and
          text.unit_count(s, text.Index_Unit.byte) == n, "37")
    var i: u64 = 0
    while i <= n {
        check(text.unit_to_byte(s, text.Index_Unit.char, i) == i, "2")
        check(text.byte_to_unit(s, text.Index_Unit.char, i) == i, "3")
        i += 1
    }
}

func check_crlf_clusters() {
    let s: string = "a\r\nb"
    check(text.unit_count(s, text.Index_Unit.byte) == 4, "4")
    check(text.unit_count(s, text.Index_Unit.char) == 4, "5")
    check(text.unit_count(s, text.Index_Unit.cluster) == 3, "6")
    let mid: string? = index_of(s, 1, text.Index_Unit.cluster)
    check(mid != nil and
          text.unit_count(mid.get_or_else(""), text.Index_Unit.byte) == 2,
          "7")
}

func check_utf8_units() {
    let s: string = "a世z"
    check(text.unit_count(s, text.Index_Unit.byte) == 5 and
          text.unit_count(s, text.Index_Unit.char) == 3 and
          text.unit_count(s, text.Index_Unit.cluster) == 3, "8")
    check(same_opt(index_of(s, 1, text.Index_Unit.char), "世"), "9")
    check(same_opt(index_of(s, -1, text.Index_Unit.char), "z"), "10")
    let cp: char = try {
        = text.char_index(s, 1)!
    } else failure {
        = '\0'
    }
    check(cast[u32] cp == 0x4e16, "11")
    check(same_opt(slice_of(s, 1, 3, text.Index_Unit.char), "世z"),
          "12")
    check(index_of(s, 3, text.Index_Unit.char) == nil, "30")
}

func check_combining_cluster() {
    let s: string = "éx"
    check(text.unit_count(s, text.Index_Unit.char) == 3, "13")
    check(text.unit_count(s, text.Index_Unit.cluster) == 2, "14")
    check(same_opt(index_of(s, 0, text.Index_Unit.cluster), "é"), "15")
}

func check_find() {
    let s: string = "a世zz"
    let rune_hit: uint? = find_of(s, "z", text.Index_Unit.char)
    check(rune_hit != nil and rune_hit.get_or_else(0) == 2, "16")
    let byte_hit: uint? = find_of(s, "z", text.Index_Unit.byte)
    check(byte_hit != nil and byte_hit.get_or_else(0) == 4, "17")
    check(find_of(s, "q", text.Index_Unit.char) == nil, "18")
}

func check_binary() {
    var raw: Array[u8] = new[Array[u8]](3)
    raw[0] = 0xff
    raw[1] = 0xfe
    raw[2] = 0x01
    let b: string = from_raw(ref raw, 3, encoding = Str_Encoding.binary)
    check(text.unit_count(b, text.Index_Unit.byte) == 3 and
          text.unit_count(b, text.Index_Unit.char) == 3 and
          text.unit_count(b, text.Index_Unit.cluster) == 3, "19")
    check(cased(b, 0) == nil, "20")
}

func check_case() {
    check(same_opt(cased("abc", 0), "ABC") and
          same_opt(cased("ABC", 1), "abc") and
          same_opt(cased("ABC", 2), "abc"), "21")
    check(same_opt(cased("straße", 0), "STRASSE"), "22")
    check(same_opt(cased("hello world", 3), "Hello World"), "35")
}

func check_cursor() {
    let s: string = "a世z"
    var c: text.Str_Cursor = text.cursor(s, text.Index_Unit.char)
    var n: u64 = 0
    while text.next(c) != nil {
        n += 1
    }
    check(n == 3 and text.at_end(c), "23")
    check(text.unit_pos(c) == n, "36")
    while text.prev(c) != nil {
        n -= 1
    }
    check(n == 0 and text.byte_pos(c) == 0, "24")
    var a: text.Str_Cursor = text.cursor(s, text.Index_Unit.char)
    var b: text.Str_Cursor = text.cursor(s, text.Index_Unit.char)
    check(seeks(a, 1) and seeks(b, 3), "31")
    check(same_opt(slice_of(s, 1, 3, text.Index_Unit.char), text.slice(a, b)),
          "25")
    check(!seeks(a, 99), "32")
}

func check_cluster_cursor() {
    let s: string = "é\U0001f1e6\U0001f1e7x"
    var fwd: text.Str_Cursor = text.cursor(s, text.Index_Unit.cluster)
    var ends: Array[u64] = new[Array[u64]](8)
    var n: u64 = 0
    while text.next(fwd) != nil and n < 8 {
        ends[n] = text.byte_pos(fwd)
        n += 1
    }
    check(n == 3, "26")
    var back: text.Str_Cursor = text.cursor(s, text.Index_Unit.cluster)
    check(seeks(back, cast[i64] n), "33")
    var k: u64 = n
    while k > 0 {
        check(text.byte_pos(back) == ends[k - 1], "27")
        _ = text.prev(back)
        k -= 1
    }
    check(text.byte_pos(back) == 0, "28")
}

func check_case_matches_unicode() {
    var cases: Array[string] = new[Array[string]](6)
    cases[0] = "o'neill mcdonald"
    cases[1] = "hello world"
    cases[2] = "a.b.c"
    cases[3] = "ALL CAPS HERE"
    cases[4] = "mixed CaSe 123 x"
    cases[5] = ""
    var i: int = 0
    while i < 6 {
        let s: string = cases[i]
        let for_title: string = s
        let for_upper: string = s
        let for_lower: string = s
        let for_fold: string = s
        check(same_opt(cased(s, 3), unicode.totitle(for_title)), "38")
        check(same_opt(cased(s, 0), unicode.toupper(for_upper)), "39")
        check(same_opt(cased(s, 1), unicode.tolower(for_lower)), "40")
        check(same_opt(cased(s, 2), unicode.casefold(for_fold)), "41")
        i += 1
    }
}

func check_deep_cluster_cursor() {
    let s: string = text.repeat("é", 40)
    let want: u64 = text.unit_count(s, text.Index_Unit.cluster)
    check(want == 40, "42")
    var fwd: text.Str_Cursor = text.cursor(s, text.Index_Unit.cluster)
    var ends: Array[u64] = new[Array[u64]](64)
    var n: u64 = 0
    while text.next(fwd) != nil and n < 64 {
        ends[n] = text.byte_pos(fwd)
        n += 1
    }
    check(n == want, "43")
    var back: text.Str_Cursor = text.cursor(s, text.Index_Unit.cluster)
    check(seeks(back, cast[i64] n), "44")
    var k: u64 = n
    while k > 0 {
        check(text.byte_pos(back) == ends[k - 1], "45")
        _ = text.prev(back)
        k -= 1
    }
    check(text.byte_pos(back) == 0 and text.unit_pos(back) == 0, "46")
    var mix: text.Str_Cursor = text.cursor(s, text.Index_Unit.cluster)
    var j: u64 = 0
    while j < 20 {
        _ = text.next(mix)
        j += 1
    }
    var m: u64 = 20
    while m > 0 {
        check(text.byte_pos(mix) == ends[m - 1], "47")
        _ = text.prev(mix)
        _ = text.next(mix)
        _ = text.prev(mix)
        m -= 1
    }
    check(text.byte_pos(mix) == 0, "48")
}

func check_ops() {
    check(text.starts_with("hello world", "hello") and
          !text.starts_with("hello", "hello world") and
          text.ends_with("hello world", "world") and
          !text.ends_with("no", "another no"), "50")
    check(same(text.trim("  padded\t\n"), "padded") and
          same(text.trim("  x", side = text.Trim_Side.start), "x") and
          same(text.trim("x  ", side = text.Trim_Side.end), "x") and
          same(text.trim(" z "), "z"), "51")
    check(same(text.repeat("ab", 3), "ababab") and
          same(text.repeat("ab", 0), ""), "52")
    check(same(text.reverse("abc"), "cba"), "53")
    check(same(text.reverse("xéy"), "yéx"), "54")
    check(same(text.replace("a.b.c", ".", "-"), "a-b-c") and
          same(text.replace("a.b.c", ".", "-", max = 1), "a-b.c") and
          same(text.replace("aaa", "a", "bb"), "bbbbbb"), "55")
    check(text.width("ab") == 2 and text.width("世") == 2, "56")
    check(same(text.fit("abc", 5), "abc  ") and
          same(text.fit("abc", 5, align = text.Align.right), "  abc") and
          same(text.fit("abcdef", 3), "abc") and
          same(text.fit("世x", 2), "世"), "57")
    let parts: List[string] = text.split("a,b,,c", ",")
    check(parts.len() == 4 and same(parts[0], "a") and same(parts[2], "") and
          same(parts[3], "c"), "58")
    let lines: List[string] = text.split("a\nb\r\nc", "",
                                         on = text.Split_On.lines)
    check(lines.len() == 3, "59")
    let units: List[string] = text.split("éx", "",
                                         on = text.Split_On.units,
                                         unit = text.Index_Unit.cluster)
    check(units.len() == 2 and same(units[0], "é"), "60")
    let cropped: List[string] = text.split(" a , b ", ",", crop = true)
    check(cropped.len() == 2 and same(cropped[0], "a"), "61")
    let wrapped: List[string] = text.wrap("aaa bbb ccc", 7)
    check(wrapped.len() >= 2, "62")
}

func check_plain() {
    let plain: string = "hello"
    check(text.unit_count(plain, text.Index_Unit.char) == 5, "29")
    check(text.cmp("abc", "abd") < 0 and text.cmp("abd", "abc") > 0 and
          text.cmp("abc", "abc") == 0, "34")
}

func check_cluster_fit() {
    let zwj: string = "\U0001f469‍\U0001f4bb"
    check(same(text.fit(zwj, 2), "  ") and same(text.fit(zwj, 4), zwj), "900")
}

check_ascii_identity()
check_crlf_clusters()
check_utf8_units()
check_combining_cluster()
check_find()
check_binary()
check_case()
check_cursor()
check_cluster_cursor()
check_deep_cluster_cursor()
check_case_matches_unicode()
check_ops()
check_plain()
check_cluster_fit()
if failures == 0 {
    __fd_write(2, "ok")
}
