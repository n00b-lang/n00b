import sys.gc.alloc
import sys.gc.collect
import text

record String_Words layout(c) {
    data:     Ref[byte]
    selector: u64
}

func check(ok: bool, code: string) {
    if !ok {
        __fd_write(2, "FAIL rich_literal_probe " + code + "\n")
        require false
    }
}

func rich_over(body: Ref[text.Rich_Body]) -> string {
    var words: String_Words = (data = unsafe_cast[Ref[byte]] body,
                               selector = str_tag_rich << 62)
    let view: Ref[string] = unsafe_cast[Ref[string]] ref words
    let s: string = view.__value
    return s
}

func body_of(s: string) -> Ref[text.Rich_Body] {
    var copy: string = s
    let words: Ref[String_Words] = unsafe_cast[Ref[String_Words]] ref copy
    return unsafe_cast[Ref[text.Rich_Body]] words.data
}

func is_rich(s: string) -> bool {
    return cast[u64] tag(s) == str_tag_rich
}

func one_record() -> List[text.Style_Record] {
    var records: List[text.Style_Record] = new[List[text.Style_Record]]()
    let blank: text.Style_Record = (start_ix = nil, end_ix = nil,
                                    style_tag = nil, format_spec = nil,
                                    substitution = (none = nil))
    records.append(blank)
    return records
}

var wrap_body: text.Rich_Body = (s = "", style_info = one_record(),
                                 base_style = nil, opaque = false)
let wrapped: string = rich_over(ref wrap_body)

func opt_is(o: u32?, v: u32) -> bool {
    if o == nil {
        return false
    }
    return o.get() == v
}

func tag_is_b(r: text.Style_Record) -> bool {
    if r.style_tag == nil {
        return false
    }
    let tag: string = r.style_tag.get()
    return byte_len(tag) == 1 and byte_at(tag, 0) == cast[u8] 'b'
}

func collect() {
    let mutator = sys.gc.alloc.mutator_for_native()
    require mutator != nil
    sys.gc.collect.collect(mutator.get().heap)
}

func rich_literal_probe_main() {
    let closed: string = "«b»text«/b»"'r
    let unclosed: string = "«b»text"'r
    check(is_rich(closed) and is_rich(unclosed), "1")
    check(byte_len(closed) == 4 and byte_len(unclosed) == 4, "2")

    let cbody: Ref[text.Rich_Body] = body_of(closed)
    let ubody: Ref[text.Rich_Body] = body_of(unclosed)
    check(cbody.style_info.len() == 1 and ubody.style_info.len() == 1, "3")

    let c: text.Style_Record = cbody.style_info[0]
    check(opt_is(c.start_ix, 0), "4")
    check(opt_is(c.end_ix, 4), "5")
    check(tag_is_b(c), "6")

    let u: text.Style_Record = ubody.style_info[0]
    check(opt_is(u.end_ix, text.index_extends), "7")
    check(tag_is_b(u), "8")

    wrap_body.s = closed

    collect()

    check(byte_len(closed) == 4 and cbody.style_info.len() == 1, "9")
    check(byte_at(closed, 0) == cast[u8] 't', "10")
    check(is_rich(wrapped) and is_rich(wrap_body.s), "11")
    check(byte_len(wrapped) == 4 and byte_at(wrapped, 0) == cast[u8] 't',
          "12")
}

rich_literal_probe_main()
__fd_write(2, "ok")
