import text

var failures: int = 0

func check(ok: bool, code: string) {
    if !ok {
        __fd_write(2, "FAIL table_probe " + code + "\n")
        failures += 1
    }
}

func cell_is(t: text.Table, row: uint, col: uint, want: string) -> bool {
    var cell: text.Table_Cell
    try {
        cell = text.cell_index(t, row, col)!
    } else e: text.Container_Err {
        return false
    }
    return cell.content == want
}

func words(a: string, b: string, c: string) -> List[string] {
    var out: List[string] = new[List[string]]()
    out.append(a)
    out.append(b)
    out.append(c)
    return out
}

func abs_of(d: text.Layout_Dim?) -> i64 {
    if d == nil {
        return -1
    }
    let v: text.Layout_Dim = d.get()
    switch v {
        case abs {
            return v.abs
        }
        case pct {
            return -2
        }
    }
}

func is_pct(d: text.Layout_Dim?) -> bool {
    if d == nil {
        return false
    }
    let v: text.Layout_Dim = d.get()
    switch v {
        case pct {
            return true
        }
        else {
            return false
        }
    }
}

func zero_props() -> text.Box_Props {
    return (border_theme = ref text.border_plain, border_style = nil,
            fill_style = nil, text_style = nil,
            borders = text.Border_Set.none, pad_top = 0, pad_bottom = 0,
            pad_left = 0, pad_right = 0, alignment = text.Align.left,
            valignment = text.Valign.top)
}

func col_sizes_match(a: text.Table, b: text.Table) -> bool {
    let n: i64 = cast[i64] text.col_count(a)
    if n != cast[i64] text.col_count(b) {
        return false
    }
    for i from 0 until n {
        if a.col_results[i].size != b.col_results[i].size {
            return false
        }
    }
    return true
}

func spec_unchanged(t: text.Table, col: uint) -> bool {
    var spec: text.Table_Col_Spec
    try {
        spec = text.col_spec(t, col)!
    } else e: text.Container_Err {
        return false
    }
    return spec.mode == text.Col_Mode.fit and spec.min == nil and
        spec.max == nil and spec.pref == nil
}

func run_checks() {
    let std: text.Table_Style = text.table_style_default()
    check(std.table_props.border_theme == ref text.border_rounded and
          std.table_props.borders == text.Border_Set.all and
          std.alt_cell_props != nil, "1")
    check(std.cell_props.pad_left == 1 and std.cell_props.pad_right == 1 and
          std.cell_props.alignment == text.Align.left and
          std.header_props.alignment == text.Align.center, "2")
    let head_opt: text.Text_Style? = std.header_props.text_style
    var head_ok: bool = false
    if head_opt != nil {
        let head: text.Text_Style = head_opt.get()
        head_ok = head.bold.get_or_else(false) and
            head.text_case == text.Text_Case.upper and
            head.fg_palette_ix != nil
    }
    check(head_ok, "3")

    let simple: text.Table_Style = text.table_style_simple()
    check(simple.table_props.border_theme == ref text.border_plain and
          simple.table_props.borders ==
          text.Border_Set.top + text.Border_Set.bottom +
          text.Border_Set.interior_h and
          simple.alt_cell_props == nil, "4")

    let ornate: text.Table_Style = text.table_style_ornate()
    check(ornate.table_props.border_theme == ref text.border_double and
          ornate.alt_cell_props != nil, "5")

    let minimal: text.Table_Style = text.table_style_minimal()
    check(minimal.table_props.borders == text.Border_Set.none and
          minimal.alt_cell_props == nil, "6")

    let ascii: text.Table_Style = text.table_style_ascii()
    check(ascii.table_props.border_theme == ref text.border_ascii and
          ascii.table_props.borders == text.Border_Set.all, "7")

    let bare: text.Box_Props = text.box_props_new(zero_props())
    check(bare.border_theme == ref text.border_plain, "8")

    var t: text.Table = new[text.Table]()
    text.col_flex(t, 2)
    text.col_fit(t)
    text.col_fixed(t, 20)
    text.add_cell(t, "a0")
    text.add_cell(t, "a1")
    text.add_cell(t, "a2")
    text.end_row(t)
    text.add_cell(t, "b0")
    text.add_cell(t, "b1")
    text.empty_cell(t)
    text.end(t)
    check(text.col_count(t) == 3 and text.row_count(t) == 2, "9")
    check(cell_is(t, 0, 0, "a0") and cell_is(t, 1, 1, "b1") and
          cell_is(t, 1, 2, ""), "10")

    var c0: text.Table_Col_Spec
    var c2: text.Table_Col_Spec
    var specs_ok: bool = true
    try {
        c0 = text.col_spec(t, 0)!
        c2 = text.col_spec(t, 2)!
    } else e: text.Container_Err {
        specs_ok = false
    }
    check(specs_ok, "11")
    if specs_ok {
        check(c0.mode == text.Col_Mode.flex and c0.flex_multiple == 2 and
              c2.mode == text.Col_Mode.fixed and c2.pref != nil and
              abs_of(c2.pref) == 20, "12")
    }

    var auto_cols: text.Table = new[text.Table]()
    text.add_cell(auto_cols, "x")
    text.add_cell(auto_cols, "y")
    text.add_cell(auto_cols, "z")
    text.end_row(auto_cols)
    check(text.col_count(auto_cols) == 3, "13")

    var spanned: text.Table = new[text.Table](num_cols = 3)
    text.add_cell(spanned, "wide", col_span = -1)
    text.end_row(spanned)
    var wide_ok: bool = false
    try {
        wide_ok = text.cell_index(spanned, 0, 0)!.col_span == 3
    } else e: text.Container_Err {
        wide_ok = false
    }
    check(wide_ok, "14")

    var ring: text.Table = new[text.Table](num_cols = 1, max_rows = 2)
    text.add_cell(ring, "r0")
    text.end_row(ring)
    text.add_cell(ring, "r1")
    text.end_row(ring)
    text.add_cell(ring, "r2")
    text.end_row(ring)
    text.add_cell(ring, "r3")
    text.end_row(ring)
    check(text.row_count(ring) == 2 and ring.total_added == 4, "15")
    check(cell_is(ring, 0, 0, "r2") and cell_is(ring, 1, 0, "r3"), "16")
    check(text.row_cell_count(ring, 0) == 1, "17")

    var casc: text.Table = new[text.Table](num_cols = 2)
    text.add_cell(casc, "h0")
    text.add_cell(casc, "h1")
    text.end_row(casc)
    text.add_cell(casc, "o0")
    text.add_cell(casc, "o1", cell_props = bare)
    text.end_row(casc)
    let r0: text.Box_Props = text.resolve_cell_props(casc, 0, 0)
    check(r0.alignment == text.Align.center, "18")

    var styled: text.Table_Cell
    try {
        styled = text.cell_index(casc, 1, 1)!
    } else e: text.Container_Err {
        require false
    }
    let rc: text.Box_Props = text.resolve_cell_props(casc, 1, 1,
                                                     cell = styled)
    check(rc.border_theme == ref text.border_plain and rc.pad_left == 0,
          "19")

    var right: text.Box_Props = zero_props()
    right.alignment = text.Align.right
    let colp: text.Box_Props = text.box_props_new(right)
    var over_ok: bool = true
    try {
        text.set_col_props(casc, 0, colp)!
        text.set_col_priority(casc, 0, 7)!
    } else e: text.Container_Err {
        over_ok = false
    }
    check(over_ok, "20")
    let over: text.Box_Props = text.resolve_cell_props(casc, 0, 0)
    check(over.alignment == text.Align.right, "21")

    var pri_ok: bool = false
    try {
        pri_ok = text.col_spec(casc, 0)!.priority == 7 and
            !casc.layout_valid
    } else e: text.Container_Err {
        pri_ok = false
    }
    check(pri_ok, "22")

    var ranged: text.Table = new[text.Table]()
    text.col_range(ranged, 4, 12)
    text.col_pct(ranged, 0.25, 0.5)
    var rspec: text.Table_Col_Spec
    var pspec: text.Table_Col_Spec
    try {
        rspec = text.col_spec(ranged, 0)!
        pspec = text.col_spec(ranged, 1)!
    } else e: text.Container_Err {
        require false
    }
    require rspec.min != nil and rspec.max != nil
    require pspec.min != nil and pspec.max != nil
    check(abs_of(rspec.min) == 4 and abs_of(rspec.max) == 12 and
          is_pct(pspec.max), "23")
    check(rspec.pref == nil, "30")
    let p_min: text.Layout_Dim? = pspec.min
    let r_max: text.Layout_Dim? = rspec.max
    var dims_ok: bool = false
    if p_min != nil and r_max != nil {
        let pct_val: text.Layout_Dim = p_min.get()
        let abs_val: text.Layout_Dim = r_max.get()
        dims_ok = text.resolve(pct_val, 100) == 25 and
            text.resolve(abs_val, 100) == 12
    }
    check(dims_ok, "24")
    text.invalidate(ranged)

    let parsed: text.Table = text.table_from_string("a,b\nc,d\n")
    check(text.row_count(parsed) == 2 and text.col_count(parsed) == 2, "25")
    check(cell_is(parsed, 1, 1, "d"), "26")

    let callout: text.Table = text.table_callout("note")
    check(text.row_count(callout) == 1 and text.col_count(callout) == 1 and
          callout.default_cell_props.pad_left == 2, "27")

    let flow: text.Table = text.table_flow(words("one", "two", "three"))
    check(text.col_count(flow) == 3 and text.row_count(flow) == 1, "28")
    var flow_flex: bool = false
    try {
        flow_flex = text.col_spec(flow, 2)!.mode == text.Col_Mode.flex
    } else e: text.Container_Err {
        require false
    }
    check(flow_flex, "29")

    var bulk: text.Table = new[text.Table](num_cols = 3)
    text.add_row(bulk, words("p", "q", "r"))
    text.add_row(bulk, words("s", "t", "u"))
    check(text.row_count(bulk) == 2 and cell_is(bulk, 1, 2, "u"), "33")

    var second_cells: uint = 0
    var second_ok: bool = true
    try {
        second_cells = text.row_index(bulk, 1)!.cells.len()
    } else e: text.Container_Err {
        second_ok = false
    }
    check(second_ok, "31")
    if second_ok {
        var past_end: bool = false
        try {
            text.row_index(bulk, 2)!
        } else e: text.Container_Err {
            past_end = true
        }
        check(second_cells == 3 and past_end, "32")
    }

    var alone: text.Table = new[text.Table]()
    text.add_cell(alone, "alpha beta gamma")
    text.add_cell(alone, "delta")
    text.end_row(alone)
    text.add_cell(alone, "epsilon zeta")
    text.add_cell(alone, "eta theta iota kappa")
    text.end_row(alone)
    var scanned: text.Table = new[text.Table]()
    text.add_cell(scanned, "alpha beta gamma")
    text.add_cell(scanned, "delta")
    text.end_row(scanned)
    text.add_cell(scanned, "epsilon zeta")
    text.add_cell(scanned, "eta theta iota kappa")
    text.end_row(scanned)
    text.natural_width(scanned)
    text.compute_layout(scanned, 40)
    text.compute_layout(alone, 40)
    check(col_sizes_match(scanned, alone) and spec_unchanged(scanned, 0) and
          spec_unchanged(scanned, 1), "900")
}

run_checks()
if failures == 0 {
    __fd_write(2, "ok")
}
