import text

func check(ok: bool, code: string) {
    if !ok {
        __fd_write(2, "FAIL color_probe " + code + "\n")
        require false
    }
}

func color_probe_main() {
    let c: text.Color = text.color_rgb(0x12, 0x34, 0x56)
    check(c == 0x123456, "1")
    check(text.color_red(c) == 0x12 and text.color_green(c) == 0x34 and
          text.color_blue(c) == 0x56, "2")
    check(text.color_quantize_256(0x000000) == 16, "3")
    check(text.color_quantize_256(0xffffff) == 231, "4")
    check(text.color_quantize_256(0xff0000) == 196, "5")
    check(text.color_quantize_256(0x808080) == 244, "6")
    check(text.color_quantize_16(0x000000) == 0 and
          text.color_quantize_16(0xffffff) == 15, "7")
    check(text.color_quantize_16(0xff0000) == 9, "8")
    check(text.color_quantize_16(0xc0c0c0) == 7 and
          text.color_quantize_16(0x808080) == 8, "9")
    let some: text.Color? = 0x123456
    check(text.color_for_depth(some, text.Color_Depth.mono) == nil, "10")
    let kept: text.Color? = text.color_for_depth(some,
                                                 text.Color_Depth.truecolor)
    check(kept != nil and kept.get() == 0x123456, "11")
    check(text.color_for_depth(nil, text.Color_Depth.truecolor) == nil, "12")
}

color_probe_main()
__fd_write(2, "ok")
