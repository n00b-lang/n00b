type Box { value: int }

func __add(left: Box, right: int) -> Box fail: int {
    fail right
}

func accumulate(left: `T, right: `A) -> `T fail: `E where `T: Add {
    var value = left
    value += right
    return value
}

func boxes(left: Box, right: int) -> Box fail: int {
    return accumulate(left, right)!
}
