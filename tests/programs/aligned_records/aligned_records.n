import aligned_types
import inline_holder

func low_bits(address: Ref[byte], alignment: uint) -> uint {
    return __abi_ref_address(address) & (alignment - 1)
}

func check_stack() {
    var pad: u8 = 1
    var state: aligned_types.Context
    state.head = cast[u64](pad)
    require low_bits(unsafe_cast[Ref[byte]] (ref state), 16) == 0
    var page: aligned_types.Page
    page.first = pad
    require low_bits(unsafe_cast[Ref[byte]] (ref page), 4096) == 0
    var holder: aligned_types.Holder
    holder.tag = pad
    require low_bits(unsafe_cast[Ref[byte]] (ref holder.state), 16) == 0
}

func check_heap() {
    let contexts: Array[aligned_types.Context] =
        new[Array[aligned_types.Context]](3)
    var i: uint = 0
    while i < 3 {
        require low_bits(unsafe_cast[Ref[byte]] (ref contexts[i]), 16) == 0
        i += 1
    }
}

func offset(field: Ref[byte], base: Ref[byte]) -> uint {
    return __abi_ref_address(field) - __abi_ref_address(base)
}

func check_reached_layouts() {
    var pair: inline_holder.Pair
    let block = unsafe_cast[Ref[byte]] (ref pair.block)
    let plain = unsafe_cast[Ref[byte]] (ref pair.plain)
    require offset(unsafe_cast[Ref[byte]] (ref pair.block.bits), block) == 8
    require offset(unsafe_cast[Ref[byte]] (ref pair.plain.marks), plain) == 16
}

check_stack()
check_heap()
check_reached_layouts()
__fd_write(2, "ok")
