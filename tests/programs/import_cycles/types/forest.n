import tree

trait Measured {
    func measure(self: 'T) -> int
}

record Forest {
    size: int
}

record Holder {
    tree: tree.Tree_Node
    count: int
}

var planted: Forest = make_forest(4)

func make_forest(n: int) -> Forest {
    return (size = n)
}

func count(item: Forest) -> int {
    return item.size
}

func measure(self: Forest) -> int {
    return self.size * 2
}

func first_label(item: tree.Tree_Node) -> int {
    return item.label
}

func holder() -> Holder {
    var inner = tree.make_tree(make_forest(1))
    inner.label = 9
    return (tree = inner, count = inner.label)
}

func total() -> int {
    return tree.shared.label + tree.wrapped(planted).left.size + holder().count - 7
}
