import forest

record Tree_Node {
    label: int
    kids: forest.Forest
}

record Pair {
    left: 'T
    right: 'T
}

var shared: Tree_Node = make_tree(forest.make_forest(2))

func make_tree(kids: forest.Forest) -> Tree_Node {
    return (label = 1, kids = kids)
}

func depth(item: Tree_Node) -> int {
    return forest.count(item.kids) - 2
}

func measured(item: forest.Forest) -> int {
    return item.measure()
}

func wrapped(item: 'T) -> Pair['T] {
    return (left = item, right = item)
}

func paired(item: forest.Forest) -> int {
    var pair: Pair[forest.Forest] = wrapped(item)
    return forest.count(pair.left) + forest.count(pair.right)
}
