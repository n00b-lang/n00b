import second

var levels: int = 3

record Token {
    weight: int
}

func token(weight: int) -> Token {
    return (weight = weight)
}

func weight_of(item: Token) -> int {
    return item.weight
}

func walk(n: int) -> int {
    if n <= 0 {
        return 0
    }
    return second.step(n - 1) + 1
}
