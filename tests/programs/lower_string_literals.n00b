func lower_plain_string() -> string {
    return "A\0B"
}

func lower_binary_string() -> string {
    return b"binary"
}

func lower_long_binary_string() -> string {
    return binary"long binary"
}

func lower_rich_string() -> string {
    return rich"«bold»text«/b» «#3:04d»«#name:s»"
}

func lower_rich_auto_string() -> string {
    return r"[|@role|]x[|/@role|][:#:]"
}

func lower_rich_escaped_string() -> string {
    return r"\«literal\» \[|text"
}

func lower_rich_open_tag_string() -> string {
    return r"«bold»open"
}

func lower_rich_plain_string() -> string {
    return r"plain rich text"
}

func lower_rich_zero_width_slot() -> string {
    return rich"«b»«#1:s»«/bold»"
}

func lower_rich_crossing_spans() -> string {
    return rich"«u»a«b»b«/u»c«/b»"
}

func lower_u32_string() -> array[codepoint] {
    return u32"A\u03bb\0"
}
