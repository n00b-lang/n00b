import function_archive_dep

var archive_initialized: int = 1

func use_archived_default() -> int {
    return function_archive_dep.renamed_add(1)
}

func forward_archived_default() -> int {
    return use_archived_default()
}

func use_archived_named() -> int {
    return function_archive_dep.renamed_add(second = 4, first = 1)
}

func use_archived_modes(input: int) -> int {
    var result: int
    var counter: int = input
    function_archive_dep.renamed_update(result, counter)
    return result
}

func use_archived_variadic() -> int {
    return function_archive_dep.renamed_variadic(1, 2, 3)
}
