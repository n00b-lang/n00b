import context_effect_dep

func use_archived_context_effect(input: int) {
    with context_effect_dep.UpdatingContext(input) {}
}

func use_archived_nested_context_effect(input: int) {
    with context_effect_dep.UpdatingContext(input) {
        with context_effect_dep.UpdatingContext(input + 1) {}
    }
}

func use_archived_failing_context_effect(input: int) -> nil fail: int {
    with context_effect_dep.FailingUpdatingContext(input) {}
}
