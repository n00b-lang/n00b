import callback_archive_dep

func archived_handler(
    modify state: callback_archive_dep.Archived_State,
    value: int) -> int fail: string {
    return value
}

func reject_uninitialized() -> callback_archive_dep.Archived_Callback {
    var state: callback_archive_dep.Archived_State
    return callback[callback_archive_dep.Archived_Callback](
        ref archived_handler, ref state)
}
