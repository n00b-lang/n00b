public type StaticPoint {
    x: int
    label: string
}

public const point: StaticPoint = (label = "point", x = 7)
public const anonymous = (right = "r", left = 8)
public const pair = (9, "tuple")
public const lookup: Dict[string, int] = {"one": 1, "two": 2}
public const flags: Set[int] = {1, 2}
public const empty_lookup: Dict[string, int] = {}
public const empty_flags: Set[int] = {}
