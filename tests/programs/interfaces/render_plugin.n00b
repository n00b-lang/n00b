import render_contract

type Widget {
}

func render(self: Widget) -> int {
    return 1
}

func use_render(item: Widget) -> int {
    return item.render()
}

func use_external_value() -> int {
    return render_contract.external_value()
}

func point_x(point: render_contract.ArchivedPoint) -> int {
    return point.x
}

func inspect_archived(item: render_contract.ArchivedValue) -> int {
    switch item {
        case number { return item.number }
        case text { return 0 }
    }
}

func preserve_color(color: render_contract.ArchivedColor) -> render_contract.ArchivedColor {
    return color
}
