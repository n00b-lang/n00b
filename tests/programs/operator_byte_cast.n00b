func widen(value: byte) -> int {
    return cast[int] value
}

func unsigned_byte(value: byte) -> u8 {
    return cast[u8] value
}

func signed_byte(value: byte) -> i8 {
    return cast[i8] value
}

func narrow(value: byte) -> u:3 {
    return cast[u:3] value
}

func arithmetic(value: byte) -> int {
    return cast[int] value + 1
}
