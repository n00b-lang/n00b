import builtin.abi
import builtin.gc
import builtin.gc.alloc
import builtin.gc.finalize
import builtin.gc.heap
import builtin.gc.mark
import builtin.gc.mutator
import builtin.gc.registry
import builtin.gc.sync
import builtin.os

type Twin {
    other: Ref[Twin]?
    id: int
    magic: int
}

var finalized: int = 0
var seen_first: bool = false
var seen_second: bool = false

func __finalize(consume self: Ref[Twin]) {
    require self.magic == 713
    let partner: Ref[Twin]? = self.other
    require partner != nil
    let other: Ref[Twin] = partner.get()
    require other.magic == 713
    require other.id != self.id
    let backlink: Ref[Twin]? = other.other
    require backlink != nil
    require backlink.get() == self
    if self.id == 0 {
        require !seen_first
        seen_first = true
    } elif self.id == 1 {
        require !seen_second
        seen_second = true
    } else { require false }
    finalized += 1
}

func allocate_twin(mutator: Ref[builtin.gc.Mutator], type_index: u32,
                   bytes: uint, alignment: uint, id: int) -> Ref[Twin]? {
    let allocated: Ref[byte]? = builtin.gc.alloc.allocate_reserved(
        mutator, ref mutator.small, type_index, bytes, alignment, true)
    if allocated == nil { return nil }
    let twin: Ref[Twin] = unsafe_cast[Ref[Twin]] allocated.get()
    twin.other = nil
    twin.id = id
    twin.magic = 713
    return twin
}

comptime {} else {
    let created: Ref[builtin.gc.Heap]? = builtin.gc.heap.create(nil)
    require created != nil
    let heap: Ref[builtin.gc.Heap] = created.get()
    let mapping: Ref[byte]? = builtin.os.map_zeroed(
        builtin.gc.block_bytes, builtin.gc.block_bytes)
    require mapping != nil
    let base: Ref[byte] = mapping.get()
    let end: Ref[byte] = __gc_byte_offset(base, builtin.gc.block_bytes)
    require builtin.gc.registry.region_add(heap, base, end)
    let block: Ref[builtin.gc.Block_Metadata] = builtin.gc.block_metadata_at(base)
    builtin.gc.block_init(heap, block)
    let attached: Ref[builtin.gc.Mutator]? = builtin.gc.mutator.create(heap)
    require attached != nil
    let mutator: Ref[builtin.gc.Mutator] = attached.get()
    var owned: Ref[builtin.gc.Block_Metadata]? = nil
    builtin.gc.own(heap, mutator, block, ref owned)
    let assigned: Ref[builtin.gc.Block_Metadata]? = block
    builtin.gc.bump_attach(mutator, ref mutator.small, assigned)
    require builtin.gc.bump_next_hole(ref mutator.small, 48)

    let probe: Ref[Twin]? = nil
    let option_row: Ref[builtin.abi.Type_Record]? = builtin.abi.type_for(
        typeof(probe))
    require option_row != nil
    let reference_index: i64 = builtin.abi.range_index(
        option_row.get().components, 0)
    require reference_index > 0
    let reference_row: Ref[builtin.abi.Type_Record]? = builtin.abi.type_at(
        cast[u32] reference_index)
    require reference_row != nil
    let index: i64 = builtin.abi.range_index(reference_row.get().components, 0)
    require index > 0
    let row: Ref[builtin.abi.Type_Record]? = builtin.abi.type_at(cast[u32] index)
    require row != nil
    let bytes: uint = builtin.abi.size_bytes(row.get())
    let alignment: uint = builtin.abi.alignment_bytes(row.get())
    let first: Ref[Twin]? = allocate_twin(mutator, cast[u32] index,
        bytes, alignment, 0)
    let second: Ref[Twin]? = allocate_twin(mutator, cast[u32] index,
        bytes, alignment, 1)
    require first != nil and second != nil
    let a: Ref[Twin] = first.get()
    let b: Ref[Twin] = second.get()
    a.other = b
    b.other = a

    var marker: builtin.gc.Marker
    builtin.gc.mark.marker_init(ref marker, heap, false)
    builtin.gc.sync.ticket_lock(ref heap.lock)
    builtin.gc.finalize.find_dead_locked(ref marker)
    builtin.gc.heap.unlock(heap)
    require heap.finq_n == 2
    require builtin.gc.finalize.run(heap, 0) == 2
    require finalized == 2
    require seen_first and seen_second

    builtin.gc.mutator.destroy(mutator)
    builtin.gc.heap.destroy(heap)
    __fd_write(2, "ok")
}
