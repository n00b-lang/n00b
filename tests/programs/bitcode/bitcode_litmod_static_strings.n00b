declare_litmod("bundle", "array", "identity")

func identity(items: Array[string]) -> Array[string] fail: string {
    return items
}

func values() -> Array[string] {
    return ["one", "a string longer than the inline capacity"]'bundle
}

func empty() -> Array[string] {
    return []'bundle
}

func observe(items: Array[string]) {
    require true
}

comptime {
    observe(["compile-time cached string"]'bundle)
} else {
    values()
    empty()
}
