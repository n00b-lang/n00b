import sys.abi

func square(n: int) -> int {
    return n * n
}

var index: u32 = 1
var summarized: u32 = 0
var total: u32 = 0
while true {
    let found = sys.abi.function_at(index)
    if found == nil {
        break
    }
    total += 1
    if found.get().summary_offset != 0 {
        summarized += 1
    }
    index += 1
}
require square(3) == 9
require total > 0
require summarized > 0
__fd_write(2, "ok")
