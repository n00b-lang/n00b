declare_litmod("bundle", "array", "identity")

func identity(items: Array[Array[string]]) -> Array[Array[string]] fail: string {
    return items
}

func values() -> Array[Array[string]] {
    return bundle[array["the first long string payload", "two"],
                  array["another long string payload"]]
}

func dynamic(text: string) -> Array[Array[string]] {
    return bundle[array["one", text], array["three"]]
}

func observe(items: Array[Array[string]]) {
    require true
}

comptime {
    observe(bundle[array["a comptime long string payload", "five"],
                   array["six"]])
} else {
    observe(values())
    observe(dynamic("a runtime long string payload"))
}
