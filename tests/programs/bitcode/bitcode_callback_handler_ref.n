callback Transform {
    call(value: int) -> int
    handler(value: int) -> int
}

func add_one(value: int) -> int {
    return value + 1
}

func make(handler: Ref[(int) -> int]) -> Transform {
    return callback[Transform](handler)
}

let cb = make(ref add_one)
require cb.call(41) == 42
__fd_write(2, "ok")
