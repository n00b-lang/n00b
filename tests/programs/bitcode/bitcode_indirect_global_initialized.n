var value: int
var through_ref: int

func read_value() -> int {
    return value
}

func read_ref_value() -> int {
    return ref_read(ref through_ref)
}

comptime {} else {
    value = 7
    ref_write(ref through_ref, 9)
    let reader: Ref[() -> int] = ref read_value
    require reader.call() == 7
    let ref_reader: Ref[() -> int] = ref read_ref_value
    require ref_reader.call() == 9
    __fd_write(2, "ok")
}
