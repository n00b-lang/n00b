
public func raw_repr(self: Array['T][], fd: i32) -> i32 {
    return __fd_write(fd, "array override\n")
}

public func raw_repr(self: Array[int][], fd: i32) -> i32 {
    return __fd_write(fd, "int array override\n")
}

func emit(value: Raw_Repr) -> i32 {
    return value.raw_repr(2)
}

emit([1, 2]'array)
emit(["a"]'array)
