record Counter {
    hits: Atomic[uint]
    name: string
}

record Node {
    value: int
}

var state: Atomic[uint] = 5
var pointer_state: Atomic[Ref[byte]?] = nil
var head: Atomic[Ref[Node]?] = nil

comptime {} else {
    require __atomic_load(ref pointer_state) == nil
    let old: uint = __atomic_exchange(ref state, 6)
    require old == 5
    require __atomic_load(ref state) == 6
    let counter: Counter = (hits = 3, name = "x")
    require __atomic_load(ref counter.hits) == 3
    require counter.name == "x"
    require __atomic_load(ref head) == nil
    var node: Node = (value = 7)
    __atomic_store(ref head, ref node)
    let stored = __atomic_load(ref head)
    require stored != nil
    require stored.get().value == 7
    __fd_write(2, "ok")
}
