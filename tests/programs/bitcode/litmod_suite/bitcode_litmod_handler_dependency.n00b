alias litmod outer_handler_dependency = make_outer_handler_dependency
quotes litmod make_outer_handler_dependency(raw: string) -> string fail: string {
    return "an inner long string payload"'inner_handler_dependency
}

alias litmod inner_handler_dependency = identity_handler_dependency
quotes litmod identity_handler_dependency(raw: string) -> string fail: string {
    return raw
}

func observe(value: string) {
    require true
}

when comptime() {
    observe("ignored"'outer_handler_dependency)
}

func run_test() {
    observe("ignored"'outer_handler_dependency)
}
