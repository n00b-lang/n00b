alias litmod bundle = identity
sequence litmod identity(items: Array[Tuple[bool, string]]) -> Array[Tuple[bool, string]] fail: string {
    return items
}

func values() -> Array[Tuple[bool, string]] {
    return [(true, "a long first string"),
                  (false, "a long second string")]'bundle
}

when comptime() {
    values()
}

func run_test() {
    values()
}
