public alias litmod bundle_nested_strings = identity_nested_strings
sequence litmod identity_nested_strings(items: Array[Array[string]]) -> Array[Array[string]] fail: string {
    return items
}

func values() -> Array[Array[string]] {
    return [["the first long string payload", "two"]'array,
                  ["another long string payload"]'array]'bundle_nested_strings
}

func dynamic(text: string) -> Array[Array[string]] {
    return [["one", text]'array, ["three"]'array]'bundle_nested_strings
}

func observe(items: Array[Array[string]]) {
    require true
}

when comptime() {
    observe([["a comptime long string payload", "five"]'array,
                   ["six"]'array]'bundle_nested_strings)
}

func run_test() {
    observe(values())
    observe(dynamic("a runtime long string payload"))
}
