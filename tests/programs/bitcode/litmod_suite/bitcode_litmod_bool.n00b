litmod<quotes> is_yes, yes(raw: string) -> bool fail: string {
    return true
}

litmod<quotes> is_no, no(raw: string) -> bool fail: string {
    return false
}

when comptime() {
    require "yes"'yes
    require "no"'no == false
}

func run_test() {
    require "yes"'yes
    require "no"'no == false
}
