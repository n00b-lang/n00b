litmod<dict> identity, string_mirror(items: Array[Tuple[string, int]]) -> Array[Tuple[string, int]] fail: string {
    return items
}

litmod<array> identity_pairs, pairs(items: Array[Tuple[string, string, int]]) -> Array[Tuple[string, string, int]] fail: string {
    return items
}

func values() -> Array[Tuple[string, int]] {
    return {"first": 1, "a longer string key requiring relocation": 2}'string_mirror
}

func empty() -> Array[Tuple[string, int]] {
    return {}'string_mirror
}

func many() -> Array[Tuple[string, string, int]] {
    return [("left", "right", 3)]'pairs
}

func observe(items: Array[Tuple[string, int]]) {
    require true
}

when comptime() {
    observe({"compile-time": 4}'string_mirror)
}

func run_test() {
    values()
    empty()
    many()
}
