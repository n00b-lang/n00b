public alias litmod ints = identity_ints
sequence litmod identity_ints(items: Array[int]) -> Array[int] fail: string {
    return items
}

func value(x: int) -> Array[int] {
    return [1, x]'ints
}

func caught(x: int) -> int {
    try {
        data = [1, x]'ints
        return 1
    } else err {
        return 0
    }
}


func run_test() {
    require caught(2) == 1
}
