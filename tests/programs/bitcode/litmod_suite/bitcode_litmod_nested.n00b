public alias litmod raw_nested = identity_string
quotes litmod identity_string(raw: string) -> string fail: string {
    return raw
}

public alias litmod bundle_nested = identity_array
sequence litmod identity_array(items: Array[string]) -> Array[string] fail: string {
    return items
}

func value(x: string) -> Array[string] {
    return ["static"'raw_nested, x]'bundle_nested
}


func run_test() {
    value("dynamic")
}
