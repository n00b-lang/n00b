litmod<array> identity, wrap(items: Array[char]) -> Array[char] fail: string {
    return items
}

func static_values() -> Array[char] {
    return ['a', 'b']'wrap
}

func dynamic_values(value: char) -> Array[char] {
    return ['a', value]'wrap
}

comptime {
    static_values()
}

func run_test() {
    static_values()
    dynamic_values('b')
}
