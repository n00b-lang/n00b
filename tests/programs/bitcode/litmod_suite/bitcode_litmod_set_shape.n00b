public alias litmod mirror = build_set
set litmod build_set(items: Array[int]) -> Array[int] fail: string {
    return items
}

func static_set() -> Array[int] {
    return {1, 2}'mirror
}

func dynamic_set(x: int) -> Array[int] {
    return {x, 2}'mirror
}

func empty_set() -> Array[int] {
    return {}'mirror
}


func run_test() {
    static_set()
    dynamic_set(3)
    empty_set()
}
