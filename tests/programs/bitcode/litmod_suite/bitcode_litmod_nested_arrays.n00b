public alias litmod bundle_nested_arrays = identity_nested_arrays
sequence litmod identity_nested_arrays(items: Array[Array[int]]) -> Array[Array[int]] fail: string {
    return items
}

func values() -> Array[Array[int]] {
    return [[1, 2]'array, [3]'array]'bundle_nested_arrays
}

func dynamic(x: int) -> Array[Array[int]] {
    return [[1, x]'array, [3]'array]'bundle_nested_arrays
}

func observe(items: Array[Array[int]]) {
    require true
}

when comptime() {
    observe([[4, 5]'array, [6]'array]'bundle_nested_arrays)
}

func run_test() {
    values()
    dynamic(6)
}
