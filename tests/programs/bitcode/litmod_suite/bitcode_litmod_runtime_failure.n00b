public alias litmod fault = always_fail
sequence litmod always_fail(items: Array[int]) -> Array[int] fail: string {
    fail "runtime literal failure"
}

func caught(x: int) -> int {
    try {
        values = [1, x]'fault
        return 0
    } else err {
        return 1
    }
}


func run_test() {
    require caught(2) == 1
}
