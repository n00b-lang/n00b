public alias litmod bundle = identity_scalar_tuple
quotes litmod identity_scalar_tuple(raw: string) -> Tuple[string, int] fail: string {
    return (raw, 7)
}

public alias litmod dynamic = from_items
sequence litmod from_items(items: Array[int]) -> Tuple[string, int] fail: string {
    return ("runtime", 9)
}

func value() -> Tuple[string, int] {
    return "static result with relocation"'bundle
}

func runtime_value(x: int) -> Tuple[string, int] {
    return [1, x]'dynamic
}

func static_container() -> Tuple[string, int] {
    return [1, 2]'dynamic
}

func observe(item: Tuple[string, int]) {
    require true
}

when comptime() {
    observe("comptime result"'bundle)
    observe([3, 4]'dynamic)
}

func run_test() {
    value()
    static_container()
    runtime_value(2)
}
