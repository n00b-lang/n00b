litmod<quotes> make_float, as_float(raw: string) -> float fail: string {
    return 1.5 + 2.0
}

litmod<array> identity, floats(items: Array[float]) -> Array[float] fail: string {
    return items
}

func scalar() -> float {
    return "one"'as_float
}

func array_values() -> Array[float] {
    return [1.5, 2.5]'floats
}

func dynamic(x: float) -> Array[float] {
    return [1.5, x]'floats
}

func observe(value: float) {
    require true
}

comptime {
    observe("compile-time"'as_float)
    require "checked at comptime"'as_float == 3.5
}

func run_test() {
    require scalar() == 3.5
    array_values()
    dynamic(3.5)
}
