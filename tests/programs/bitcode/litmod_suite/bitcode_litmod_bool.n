alias litmod yes = is_yes
quotes litmod is_yes(raw: string) -> bool fail: string {
    return true
}

alias litmod no = is_no
quotes litmod is_no(raw: string) -> bool fail: string {
    return false
}

when comptime() {
    require "yes"'yes
    require "no"'no == false
}

func run_test() {
    require "yes"'yes
    require "no"'no == false
}
