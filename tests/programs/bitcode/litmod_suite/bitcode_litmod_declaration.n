alias litmod e = echo
quotes litmod echo(raw: string) -> string fail: string {
    return raw
}

int litmod echo(repr: string) -> string fail: string {
    return repr
}

alias litmod ht = hex_text
hex litmod hex_text(digits: string) -> string fail: string {
    return digits
}

alias litmod ft = float_text
float litmod float_text(digits: string) -> string fail: string {
    return digits
}

quotes litmod solo(raw: string) -> string fail: string {
    return raw
}

func alias_quote() -> string {
    return "hello"'e
}

func primary_quote() -> string {
    return "world"'echo
}

func alias_int() -> string {
    return 123'e
}

func alias_hex() -> string {
    return 0x2a'ht
}

func alias_float() -> string {
    return 1.5'ft
}


func run_test() {
    raw_debug(alias_quote())
    raw_debug("|")
    raw_debug(primary_quote())
    raw_debug("|")
    raw_debug(alias_int())
    raw_debug("|")
    raw_debug(alias_hex())
    raw_debug("|")
    raw_debug(alias_float())
    raw_debug("|")
    raw_debug("last"'solo)
}
