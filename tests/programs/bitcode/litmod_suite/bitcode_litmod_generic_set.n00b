litmod<set> identity, wrap(items: Array[`T]) -> Array[`T] fail: string {
    return items
}

func static_values() -> Array[int] {
    return {1, 2}'wrap
}

func dynamic_values(x: int) -> Array[int] {
    return {x, 2}'wrap
}

