import litmod_import_dep


alias litmod forwarded = make_forwarded
quotes litmod make_forwarded(raw: string) -> int fail: string {
    return litmod_import_dep.value()
}

func forwarded_value() -> int {
    return "root"'forwarded
}

when comptime() {
    require litmod_import_dep.value() == 42
    require forwarded_value() == 42
}

func run_test() {
    require litmod_import_dep.value() == 42
    require forwarded_value() == 42
}
