
var value: int = 5

record Sample {
    ratio: f64
    count: int
}

func emit(value: Raw_Repr) -> i32 {
    return value.raw_repr(2)
}

func show(value) {
    value.raw_repr(2)
}

emit(true)
__fd_write(2, "\n")
emit(false)
__fd_write(2, "\n")
emit(42)
__fd_write(2, "\n")
emit(-17)
__fd_write(2, "\n")
emit(3.5)
__fd_write(2, "\n")
emit(-0.0)
__fd_write(2, "\n")
emit(1000000.0)
__fd_write(2, "\n")
emit(0.00001)
__fd_write(2, "\n")
emit([1, 2]'array)
__fd_write(2, "\n")
emit([1.25, 2.5]'array)
__fd_write(2, "\n")
emit(["a", "b"]'array)
__fd_write(2, "\n")
emit([[1, 2]'array, [3]'array]'array)
__fd_write(2, "\n")
let sample: Sample = (ratio = 0.5, count = 3)
sample.raw_repr(2)
__fd_write(2, "\n")
show(sample)
__fd_write(2, "\n")
show(2.5)
__fd_write(2, "\n")
(ref value).raw_repr(2)
__fd_write(2, "\n")
