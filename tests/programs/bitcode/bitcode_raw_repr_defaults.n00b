import builtin.io.raw

func emit(value: builtin.io.raw.Raw_Repr) -> i32 {
    return value.raw_repr(2)
}

comptime {
} else {
    emit(true)
    __fd_write(2, "\n")
    emit(false)
    __fd_write(2, "\n")
    emit(42)
    __fd_write(2, "\n")
    emit(-17)
    __fd_write(2, "\n")
    emit(3.5)
    __fd_write(2, "\n")
    emit(-0.0)
    __fd_write(2, "\n")
    emit(1000000.0)
    __fd_write(2, "\n")
    emit(0.00001)
    __fd_write(2, "\n")
    emit([1, 2]'array)
    __fd_write(2, "\n")
    emit([1.25, 2.5]'array)
    __fd_write(2, "\n")
    emit(["a", "b"]'array)
    __fd_write(2, "\n")
    emit([[1, 2]'array, [3]'array]'array)
    __fd_write(2, "\n")
}
