const HALF: f32 = 0.5

type Sample layout(c) {
    weight: f32
    total: f64
    count: i32
}

func scale(value: f32, factor: f32) -> f32 {
    return value * factor
}

func comptime_start() -> nil {
    var sample: Sample
    sample.weight = 1.25
    require sample.weight * 2.0 == 2.5
}

func start() -> nil {
    let x: f32 = 1.5
    let y = scale(x, 2.0)
    require y == 3.0
    require y > x
    require -x < 0.0
    require y / x == 2.0
    require y - x == x
    let wide = cast[f64] y
    require wide == 3.0
    require cast[f32] wide == y
    let tenth: f64 = 0.1
    require cast[f64] (cast[f32] tenth) != tenth
    let count = 7
    require cast[f32] count == 7.0
    require cast[int] y == 3
    require HALF + HALF == 1.0
    var sample: Sample
    sample.weight = 0.75
    sample.total = 2.5
    sample.count = 3
    require sample.weight * cast[f32] sample.count == 2.25
    let values: Array[f32][3] = [0.5, 1.5, 2.0]
    require values[0] + values[1] + values[2] == 4.0
    __fd_write(2, "ok")
}
