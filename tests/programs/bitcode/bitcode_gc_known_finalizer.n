import sys.abi

record Finalized_Record {
    payload: int
}

func __init(modify self: Finalized_Record, payload: int) {
    self.payload = payload
}

func __finalize(consume self: Ref[Finalized_Record]) {
    require self.payload == 42
}

func construct() -> Ref[Finalized_Record] {
    var value: Finalized_Record = new[Finalized_Record](42)
    return ref value
}

let value: Ref[Finalized_Record] = construct()
require value.payload == 42
let exemplar: Finalized_Record = new[Finalized_Record](42)
let row: Ref[sys.abi.Type_Record]? = sys.abi.type_for(
    typeof(exemplar))
require row != nil
require row.get().finalizer_function_index != 0
__fd_write(2, "ok")
