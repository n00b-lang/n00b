func right(x: uint) -> int {
    if x != 0 and debug_enabled() {
        return 1
    }
    return 0
}

func left(x: uint) -> int {
    if debug_enabled() and x != 0 {
        return 1
    }
    return 0
}

assert right(3) == 1
assert right(0) == 0
assert left(3) == 1
assert left(0) == 0
__fd_write(2, "ok")
