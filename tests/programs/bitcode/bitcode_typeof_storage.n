import builtin.abi

func check_type_only_probe() {
    let probe: Ref[byte]? = nil
    let target: Ref[builtin.abi.Type_Record]? = builtin.abi.optional_reference_target(
        typeof(probe))
    if target != nil {
        assert builtin.abi.size_bytes(target.get()) == 1
    } else { require false }
}

comptime {} else {
    check_type_only_probe()
    __fd_write(2, "ok")
}
