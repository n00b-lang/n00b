type Cell {
    public raw: uint
}

type Other_Cell {
    public raw: uint
}

type Handle = Ref[Cell]
alias Other = Ref[Other_Cell]

func make(raw: uint) -> Handle {
    var cell: Cell = (raw = raw)
    return cast[Handle](ref cell)
}

func other(raw: uint) -> Other {
    var cell: Other_Cell = (raw = raw)
    return ref cell
}

func shut(self: Handle) {
    self.raw = 0
}

func shut(self: Other) {
    self.raw = 1
}

func reset(modify self: Other) {
    self.raw = 2
}

func clear(modify self: Ref[Cell]) {
    self.raw = 3
}

let first = make(7)
let copy = first
assert copy.raw == 7
shut(copy)
assert first.raw == 0
let second = other(9)
shut(second)
assert second.raw == 1
var modified = other(5)
reset(modified)
assert modified.raw == 2
var cell: Cell = (raw = 0)
var direct: Ref[Cell] = ref cell
clear(direct)
assert cell.raw == 3
var i = 0
while i < 5000 {
    let made = make(cast[uint] i)
    assert made.raw == cast[uint] i
    i = i + 1
}
__fd_write(2, "ok")
