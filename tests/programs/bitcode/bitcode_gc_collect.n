import builtin.abi
import builtin.gc
import builtin.gc.alloc
import builtin.gc.collect
import builtin.gc.heap
import builtin.gc.los
import builtin.gc.mark
import builtin.gc.mutator
import builtin.gc.registry
import builtin.gc.roots
import builtin.os

var pause_count: uint = 0
var cycle_count: uint = 0
thread var tls_slot: Ref[byte]? = nil

type Stack_Cell {
    child: Ref[byte]?
}

func __init(modify self: Stack_Cell, child: Ref[byte]?) {
    self.child = child
}

func make_stack_cell(mutator: Ref[builtin.gc.Mutator]) -> Stack_Cell {
    let probe: byte = 0
    let child: Ref[byte]? = builtin.gc.alloc.allocate_large(mutator,
        cast[u32](typeof(probe)), builtin.gc.los.los_threshold,
        builtin.gc.granule_bytes, false)
    require child != nil
    let cell: Stack_Cell = new[Stack_Cell](child)
    return cell
}

func report_pause(ns: u64, user: Ref[byte]?) {
    pause_count += 1
}

func report_cycle(info: builtin.gc.Cycle_Info, user: Ref[byte]?) {
    assert info.kind == 0
    cycle_count += 1
}

comptime {} else {
    let frame: Ref[builtin.abi.Frame_Layout_Record]? = builtin.abi.frame_layout_at(1)
    require frame != nil
    require frame.get().function_index != 0
    require frame.get().frame_byte_extent >= cast[u64](builtin.abi.frame_root_offset)
    var frame_index: u32 = 1
    var found_typed_frame: bool = false
    var found_rootless_frame: bool = false
    var candidate: Ref[builtin.abi.Frame_Layout_Record]? =
        builtin.abi.frame_layout_at(frame_index)
    while candidate != nil {
        let layout: Ref[builtin.abi.Frame_Layout_Record] =
            candidate.get()
        if layout.shadow_frame_type_index != 0 {
            found_typed_frame = true
        }
        if layout.frame_byte_extent == cast[u64](builtin.abi.frame_root_offset) {
            found_rootless_frame = true
        }
        frame_index += 1
        candidate = builtin.abi.frame_layout_at(frame_index)
    }
    require found_typed_frame
    require found_rootless_frame
    var config: builtin.gc.Config
    builtin.gc.heap.config_default(ref config)
    config.on_pause = ref report_pause
    config.on_cycle = ref report_cycle
    let created: Ref[builtin.gc.Heap]? = builtin.gc.heap.create(ref config)
    if created != nil {
        let heap: Ref[builtin.gc.Heap] = created.get()
        let mapped: Ref[byte]? = builtin.os.map_zeroed(
            builtin.gc.block_bytes, builtin.gc.block_bytes)
        if mapped != nil {
            let base: Ref[byte] = mapped.get()
            let end: Ref[byte] = __gc_byte_offset(base, builtin.gc.block_bytes)
            require builtin.gc.registry.region_add(heap, base, end)
            let block: Ref[builtin.gc.Block_Metadata] = builtin.gc.block_metadata_at(base)
            builtin.gc.block_init(heap, block)
            let attached: Ref[builtin.gc.Mutator]? = builtin.gc.mutator.create(heap)
            if attached != nil {
                let mutator: Ref[builtin.gc.Mutator] = attached.get()
                var saw_tls_slot: bool = false
                var tls_index: uint = 0
                while tls_index < mutator.ntls_roots {
                    let entry: Ref[builtin.gc.roots.TLS_Root_Entry] = builtin.gc.roots.tls_root_at(mutator, tls_index)
                    if __abi_ref_address(entry.address) == __abi_ref_address(ref tls_slot) {
                        saw_tls_slot = true
                    }
                    tls_index += 1
                }
                require saw_tls_slot
                var owned: Ref[builtin.gc.Block_Metadata]? = nil
                builtin.gc.own(heap, mutator, block, ref owned)
                let assigned: Ref[builtin.gc.Block_Metadata]? = block
                builtin.gc.bump_attach(mutator, ref mutator.small, assigned)
                require builtin.gc.bump_next_hole(ref mutator.small, 48)
                let probe: byte = 0
                let type_index: u32 = cast[u32](typeof(probe))
                let first: Ref[byte]? = builtin.gc.alloc.allocate_reserved(
                    mutator, ref mutator.small, type_index, 8,
                    builtin.gc.granule_bytes, false)
                let second: Ref[byte]? = builtin.gc.alloc.allocate_reserved(
                    mutator, ref mutator.small, type_index, 8,
                    builtin.gc.granule_bytes, false)
                let third: Ref[byte]? = builtin.gc.alloc.allocate_reserved(
                    mutator, ref mutator.small, type_index, 8,
                    builtin.gc.granule_bytes, false)
                if first != nil and second != nil and third != nil {
                    var slot: Ref[byte]? = first
                    require builtin.gc.roots.push(mutator, ref slot)
                    tls_slot = third
                    let first_offset: uint = __abi_ref_address(
                        builtin.gc.header_of(first.get())) - __abi_ref_address(base)
                    let second_offset: uint = __abi_ref_address(
                        builtin.gc.header_of(second.get())) - __abi_ref_address(base)
                    let third_offset: uint = __abi_ref_address(
                        builtin.gc.header_of(third.get())) - __abi_ref_address(base)
                    builtin.gc.collect.collect(heap)
                    assert heap.collections == 1
                    let stats: builtin.gc.Stats = builtin.gc.heap.get_stats(heap)
                    assert stats.collections == 1
                    assert stats.objects_allocated >= 2
                    assert stats.blocks_total == heap.nblocks
                    assert stats.pauses == heap.pauses
                    assert stats.last_pause_ns == heap.last_pause_ns
                    assert stats.max_pause_ns >= stats.last_pause_ns
                    assert stats.total_pause_ns >= stats.last_pause_ns
                    assert stats.finalizers_pending == 0
                    assert builtin.gc.object_started(base, first_offset)
                    assert !builtin.gc.object_started(base, second_offset)
                    assert builtin.gc.object_started(base, third_offset)
                    tls_slot = nil
                    builtin.gc.roots.pop(mutator, 0)
                    builtin.gc.collect.collect_start(heap)
                    while builtin.gc.collect.collect_step(heap, 1) {}
                    builtin.gc.collect.collect_finish(heap)
                    assert heap.collections == 2
                    assert pause_count >= 2
                    assert cycle_count == 2
                } else { require false }
                builtin.gc.mutator.destroy(mutator)
            } else { require false }
            builtin.gc.heap.destroy(heap)
        } else { require false }
        config.scan_stacks = true
        let stack_heap: Ref[builtin.gc.Heap]? = builtin.gc.heap.create(ref config)
        if stack_heap != nil {
            let scanning: Ref[builtin.gc.Heap] = stack_heap.get()
            let attached: Ref[builtin.gc.Mutator]? = builtin.gc.mutator.create(scanning)
            if attached != nil {
                let cell: Stack_Cell = make_stack_cell(attached.get())
                builtin.gc.collect.collect(scanning)
                let rooted: Ref[byte]? = cell.child
                require rooted != nil
                require builtin.gc.mark.is_marked(scanning, rooted.get())
                let stats: builtin.gc.Stats = builtin.gc.heap.get_stats(scanning)
                assert stats.last_stack_words != 0
                builtin.gc.mutator.destroy(attached.get())
            } else { require false }
            builtin.gc.heap.destroy(scanning)
        } else { require false }
        __fd_write(2, "ok")
    } else { require false }
}
