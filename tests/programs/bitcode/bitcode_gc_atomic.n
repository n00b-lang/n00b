import builtin.os
import builtin.gc

comptime {
} else {
    let mapped: Ref[byte]? = builtin.os.map_zeroed(32768, 32768)
    if mapped != nil {
        let base: Ref[byte] = mapped.get()
        let word: Ref[Atomic[u64]] = builtin.gc.start_word_at(base, 0)
        assert __atomic_fetch_or(word, 1) == 0
        assert __atomic_fetch_or(word, 4) == 1
        assert __atomic_fetch_or(word, 0) == 5
        let missed: bool = __atomic_compare_exchange(word, 4, 8)
        assert !missed
        let changed: bool = __atomic_compare_exchange(word, 5, 9)
        assert changed
        assert __atomic_fetch_or_release(word, 2) == 9
        assert __atomic_fetch_or_relaxed(word, 4) == 11
        let current: u64 = __atomic_load(word)
        assert current == 15
        assert __atomic_load_relaxed(word) == current
        assert __atomic_load_acquire(word) == current
        __atomic_store_relaxed(word, current)
        __atomic_store_release(word, current)
        assert __atomic_load(word) == current
        assert __atomic_fetch_add_relaxed(word, 1) == 15
        assert __atomic_exchange_relaxed(word, 17) == 16
        assert __atomic_exchange_acquire(word, 18) == 17
        assert __atomic_load(word) == 18
        builtin.os.unmap(base, 32768)
        __fd_write(2, "ok")
    } else {
        assert false
    }
}
