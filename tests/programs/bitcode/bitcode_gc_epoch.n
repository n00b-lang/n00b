import sys.gc.core
import sys.gc.collect
import sys.gc.heap
import sys.gc.mutator
import sys.gc.registry
import sys.memory

func add_block(heap: Ref[sys.gc.core.Heap]) -> Ref[sys.gc.core.Block_Metadata] {
    let mapped: Ref[byte]? = sys.memory.map_zeroed(
        sys.gc.core.block_bytes, sys.gc.core.block_bytes)
    if mapped != nil {
        let base: Ref[byte] = mapped.get()
        let end: Ref[byte] = __gc_byte_offset(base, sys.gc.core.block_bytes)
        let registered: bool = sys.gc.registry.region_add(heap, base, end)
        require registered
        let block: Ref[sys.gc.core.Block_Metadata] = sys.gc.core.block_metadata_at(base)
        sys.gc.core.block_init(heap, block)
        return block
    }
    require false
}

let created: Ref[sys.gc.core.Heap]? = sys.gc.heap.create(nil)
if created != nil {
    let heap: Ref[sys.gc.core.Heap] = created.get()
    assert heap.epoch == 1
    assert heap.mark_epoch == 1
    heap.hs_rounds = 3
    heap.hs_stragglers = 2
    __atomic_store(ref heap.cnt_objects, 9)
    sys.gc.collect.begin_epoch_locked(heap)
    assert heap.epoch == 1
    assert heap.mark_epoch == 2
    assert __atomic_load(ref heap.cnt_objects) == 0
    assert heap.cycle.epoch == 2
    assert heap.cycle.rounds == 3
    assert heap.cycle.stragglers == 2
    assert heap.cycle_start != 0
    let block: Ref[sys.gc.core.Block_Metadata] = add_block(heap)
    let base: Ref[byte] = unsafe_cast[Ref[byte]] block
    let first: uint = sys.gc.core.header_lines()
    var bump: sys.gc.core.Bump
    bump.cursor = __gc_byte_offset(base,
        first * sys.gc.core.line_bytes + 64)
    bump.limit = __gc_byte_offset(base,
        (first + 2) * sys.gc.core.line_bytes)
    var marker: sys.gc.core.Marker
    marker.heap = heap
    sys.gc.collect.reserve_bump(ref marker, ref bump, false)
    assert sys.gc.core.line_marked_in(base, first, heap.mark_epoch)
    assert sys.gc.core.line_marked_in(base, first + 1, heap.mark_epoch)
    assert !sys.gc.core.line_marked_in(base, first + 2, heap.mark_epoch)
    let attached: Ref[sys.gc.core.Mutator]? = sys.gc.mutator.create(heap)
    if attached != nil {
        let mutator: Ref[sys.gc.core.Mutator] = attached.get()
        mutator.overflow.blk = block
        mutator.overflow.cursor = __gc_byte_offset(base,
            (first + 3) * sys.gc.core.line_bytes + 16)
        mutator.overflow.limit = __gc_byte_offset(base,
            (first + 5) * sys.gc.core.line_bytes)
        sys.gc.collect.reserve_bumps(ref marker)
        assert sys.gc.core.line_marked_in(base, first + 4, heap.mark_epoch)
        assert !sys.gc.core.line_marked_in(base, first + 5, heap.mark_epoch)
        mutator.write_buffer_epoch = heap.mark_epoch
        (ref mutator.write_buffer[0]).__value = nil
        mutator.write_buffer_count = 1
        sys.gc.collect.drain_barrier_buffers(ref marker)
        assert mutator.write_buffer_count == 0
        sys.gc.mutator.destroy(mutator)
    } else { require false }

    __atomic_store(ref heap.marking, true)
    heap.black_alloc = true
    __atomic_store(ref heap.cnt_objects, 4)
    __atomic_store(ref heap.cnt_bytes, 128)
    heap.alloc_since_gc = 256
    sys.gc.collect.end_epoch_locked(heap)
    assert heap.epoch == 2
    assert !__atomic_load(ref heap.marking)
    assert !heap.black_alloc
    assert heap.collections == 1
    assert heap.last_marked_objects == 4
    assert heap.last_marked_bytes == 128
    assert heap.cycle.marked_objects == 4
    assert heap.cycle.marked_bytes == 128
    assert heap.cycle.allocated_bytes == 256
    assert heap.live_bytes == 128
    assert heap.alloc_since_gc == 0
    assert __atomic_load(ref heap.nunswept) == 1
    let cursor: Ref[sys.gc.core.Block_Metadata]? = heap.sweep_cursor
    if cursor != nil { assert cursor.get() == block }
    else { require false }
    assert __atomic_load(ref heap.phase) == cast[u32](sys.gc.core.Phase.sweeping)
    sys.gc.collect.sweep_all(heap)
    assert __atomic_load(ref heap.phase) == cast[u32](sys.gc.core.Phase.idle)
    assert __atomic_load(ref heap.nunswept) == 0
    assert block.sweep_epoch == heap.epoch
    let previous_sweep: u32 = block.sweep_epoch
    block.sweep_epoch = 256
    sys.gc.core.mark_lines(base, first * sys.gc.core.line_bytes,
        sys.gc.core.line_bytes, 256)
    assert sys.gc.core.line_marked_in(base, first, 256)
    var wrap_bump: sys.gc.core.Bump
    wrap_bump.blk = block
    wrap_bump.seen_epoch = 256
    wrap_bump.line = first
    require sys.gc.core.bump_next_hole(ref wrap_bump, sys.gc.core.line_bytes)
    let next_cursor: Ref[byte]? = wrap_bump.cursor
    if next_cursor != nil {
        assert __abi_ref_address(next_cursor.get()) ==
            __abi_ref_address(base) + (first + 2) * sys.gc.core.line_bytes
    } else { require false }
    block.sweep_epoch = previous_sweep
    sys.gc.heap.destroy(heap)
    __fd_write(2, "ok")
} else { require false }
