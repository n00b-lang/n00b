import sys.abi
import sys.gc.core
import sys.gc.alloc
import sys.gc.handshake
import sys.gc.heap
import sys.gc.registry
import sys.memory

let created: Ref[sys.gc.core.Heap]? = sys.gc.heap.create(nil)
if created != nil {
    let heap: Ref[sys.gc.core.Heap] = created.get()
    let first_map: Ref[byte]? = sys.memory.map_zeroed(
        sys.gc.core.block_bytes, sys.gc.core.block_bytes)
    let cached_map: Ref[byte]? = sys.memory.map_zeroed(
        sys.gc.core.block_bytes, sys.gc.core.block_bytes)
    let probe: Ref[sys.gc.core.Mutator]? = nil
    let row: Ref[sys.abi.Type_Record]? = sys.abi.optional_reference_target(
        typeof(probe))
    if first_map != nil and cached_map != nil and row != nil {
        let first_base: Ref[byte] = first_map.get()
        let cached_base: Ref[byte] = cached_map.get()
        let first_end: Ref[byte] = __gc_byte_offset(first_base,
            sys.gc.core.block_bytes)
        let cached_end: Ref[byte] = __gc_byte_offset(cached_base,
            sys.gc.core.block_bytes)
        let first_added: bool = sys.gc.registry.region_add(
            heap, first_base, first_end)
        let cached_added: bool = sys.gc.registry.region_add(
            heap, cached_base, cached_end)
        assert first_added and cached_added
        let first: Ref[sys.gc.core.Block_Metadata] = sys.gc.core.block_metadata_at(
            first_base)
        let cached: Ref[sys.gc.core.Block_Metadata] = sys.gc.core.block_metadata_at(
            cached_base)
        sys.gc.core.block_init(heap, first)
        sys.gc.core.block_init(heap, cached)
        let mutator_map: Ref[byte]? = sys.memory.map_zeroed(
            sys.abi.size_bytes(row.get()),
            sys.abi.alignment_bytes(row.get()))
        if mutator_map != nil {
            let mutator: Ref[sys.gc.core.Mutator] = unsafe_cast[Ref[sys.gc.core.Mutator]] mutator_map.get()
            mutator.heap = heap
            sys.gc.core.set_block_state(heap, first, sys.gc.core.Block_State.owned)
            sys.gc.core.set_block_state(heap, cached, sys.gc.core.Block_State.owned)
            first.owner = mutator
            cached.owner = mutator
            mutator.small.blk = first
            let hole_start: uint = sys.gc.core.header_lines() * sys.gc.core.line_bytes
            mutator.small.cursor = __gc_byte_offset(first_base, hole_start)
            mutator.small.limit = __gc_byte_offset(first_base,
                hole_start + sys.gc.core.line_bytes)
            __atomic_store(ref mutator.small.cache, cached)
            heap.epoch += 1
            __atomic_store(ref heap.nunswept, 2)
            sys.gc.handshake.sweep_own_blocks(heap, mutator, heap.epoch)
            assert first.sweep_epoch == heap.epoch
            assert cached.sweep_epoch == heap.epoch
            assert __atomic_load(ref heap.nunswept) == 0
            assert sys.gc.core.line_marked_in(first_base,
                sys.gc.core.header_lines(), heap.epoch)
            let usable: uint = sys.gc.core.block_bytes / sys.gc.core.line_bytes - sys.gc.core.header_lines()
            assert cast[uint](first.free_lines) == usable - 2
            assert cast[uint](cached.free_lines) == usable
            sys.gc.handshake.sweep_own_blocks(heap, mutator, heap.epoch)
            assert __atomic_load(ref heap.nunswept) == 0

            heap.mark_epoch = heap.epoch + 1
            __atomic_store(ref heap.hs_kind,
                cast[u32](sys.gc.core.Handshake_Kind.on))
            __atomic_store(ref mutator.hs_state,
                cast[u32](sys.gc.core.Handshake_State.requested))
            __atomic_store(ref heap.hs_pending, 1)
            sys.gc.handshake.safepoint(mutator)
            assert mutator.black
            assert __atomic_load(ref first.black_epoch) == heap.mark_epoch
            assert __atomic_load(ref mutator.hs_state) == cast[u32](sys.gc.core.Handshake_State.done)
            assert __atomic_load(ref heap.hs_pending) == 0

            __atomic_store(ref heap.hs_kind,
                cast[u32](sys.gc.core.Handshake_Kind.scan))
            __atomic_store(ref mutator.hs_state,
                cast[u32](sys.gc.core.Handshake_State.requested))
            __atomic_store(ref heap.hs_pending, 1)
            sys.gc.handshake.safepoint(mutator)
            assert __atomic_load(ref mutator.hs_state) == cast[u32](sys.gc.core.Handshake_State.done)
            assert __atomic_load(ref heap.hs_pending) == 0

            __atomic_store(ref heap.hs_kind,
                cast[u32](sys.gc.core.Handshake_Kind.sweep))
            __atomic_store(ref mutator.hs_state,
                cast[u32](sys.gc.core.Handshake_State.requested))
            __atomic_store(ref heap.hs_pending, 1)
            sys.gc.handshake.safepoint(mutator)
            assert !mutator.black
            assert __atomic_load(ref mutator.hs_state) == cast[u32](sys.gc.core.Handshake_State.done)
            assert __atomic_load(ref heap.hs_pending) == 0
            assert __atomic_load(ref heap.hs_answered.seq) == 3
            sys.gc.alloc.block_release(heap, first)
            sys.gc.alloc.block_release(heap, cached)
            sys.memory.unmap(mutator, sys.abi.size_bytes(row.get()))
            sys.gc.heap.destroy(heap)
            __fd_write(2, "ok")
        } else { require false }
    } else { require false }
} else { require false }
