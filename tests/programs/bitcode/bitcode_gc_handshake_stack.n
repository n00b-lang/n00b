import builtin.gc
import builtin.gc.handshake
import builtin.gc.heap
import builtin.gc.mutator

comptime {} else {
    var config: builtin.gc.Config
    builtin.gc.heap.config_default(ref config)
    config.scan_stacks = true
    let created: Ref[builtin.gc.Heap]? = builtin.gc.heap.create(ref config)
    if created != nil {
        let heap: Ref[builtin.gc.Heap] = created.get()
        let active: Ref[builtin.gc.Mutator]? = builtin.gc.mutator.create(heap)
        if active != nil {
            let mutator: Ref[builtin.gc.Mutator] = active.get()
            __atomic_store(ref heap.hs_kind,
                cast[u32](builtin.gc.Handshake_Kind.scan))
            __atomic_store(ref mutator.hs_state,
                cast[u32](builtin.gc.Handshake_State.requested))
            __atomic_store(ref heap.hs_pending, 1)
            builtin.gc.handshake.safepoint(mutator)
            require __atomic_load(ref heap.hs_pending) == 0
            require __atomic_load(ref heap.cnt_stack_words) != 0
            builtin.gc.handshake.enter_blocking(mutator)
            require __atomic_load(ref mutator.blocking) == 1
            require mutator.blocked_sp != nil
            builtin.gc.handshake.run_handshake_cycle(heap)
            require heap.hs_cycles == 1
            require heap.collections == 1
            require __atomic_load(ref heap.hs_pending) == 0
            require __atomic_load(ref heap.phase) == cast[u32](builtin.gc.Phase.sweeping)
            builtin.gc.handshake.leave_blocking(mutator)
            require __atomic_load(ref mutator.blocking) == 0
            builtin.gc.mutator.destroy(mutator)
            builtin.gc.heap.destroy(heap)
            __fd_write(2, "ok")
        } else { require false }
    } else { require false }
}
