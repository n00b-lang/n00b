record Point {
    x: int
    y: int
    note: int
    spare: int
}

record Pair {
    a: int
    b: int
}

record Wire layout(c) {
    tag: u32
    unused: u32
}

record Stored {
    level: int
    archived: int
}

const stored: Stored = (level = 2, archived = 9)

func make(x: int) -> Point {
    var p: Point
    p.x = x
    p.y = x + 1
    p.note = 7
    return p
}

func pair(x: int) -> Pair {
    var p: Pair
    p.a = x
    p.b = x
    return p
}

var w: Wire
w.tag = 1
let p = make(3)
require p.x + p.y == 7
require w.tag == 1
require stored.level == 2
require pair(1) == pair(1)
__fd_write(2, "ok")
