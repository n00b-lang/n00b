func fill(out value: int, input: int) {
    value = input
}

func fill_pointer(out value: Ref[byte]?, input: Ref[byte]) {
    value = input
}

var value: int
fill(value, 42)
assert value == 42
var target: byte = 7
var pointer: Ref[byte]? = nil
fill_pointer(pointer, ref target)
assert pointer != nil
__fd_write(2, "ok")
