
func raw_repr(self: bool, fd: i32) -> i32 {
    return __fd_write(fd, "bool\n")
}

func raw_repr(self: u8, fd: i32) -> i32 {
    return __fd_write(fd, "item")
}

func raw_repr(self: Array[int][], fd: i32) -> i32 {
    return __fd_write(fd, "inner")
}

func emit(value: Raw_Repr) -> i32 {
    return value.raw_repr(2)
}

emit(true)
emit("string\n")
let bytes: Array[u8] = [1, 2]'array
emit(bytes)
__fd_write(2, "\n")
let nested: Array[Array[int]] = [[1, 2]'array, [3]'array]'array
emit(nested)
__fd_write(2, "\n")
