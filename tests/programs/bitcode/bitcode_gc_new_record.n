type Constructed_Record {
    payload: int
}

func __init(modify self: Constructed_Record, payload: int) {
    self.payload = payload
}

func construct(payload: int) -> Constructed_Record {
    return new[Constructed_Record](payload)
}

comptime {} else {
    let value: Constructed_Record = construct(42)
    assert value.payload == 42
    let second: Constructed_Record = construct(7)
    assert second.payload == 7
    __fd_write(2, "ok")
}
