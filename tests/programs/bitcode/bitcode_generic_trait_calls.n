trait Checker {
    func check(self: 'T) -> nil fail: string
}

trait Measured {
    func size(self: 'T) -> int
}

record Handle {
    fd: int
}

func check(self: Handle) -> nil fail: string {
    if self.fd < 0 {
        fail "negative"
    }
}

func fixup(modify self: Handle) -> nil fail: string {
    if self.fd < 0 {
        fail "unfixable"
    }
    self.fd = 7
}

func size(self: Handle) -> int {
    return self.fd
}

func verify(value: 'T) -> nil fail: string where 'T: Checker {
    value.check()!
}

func repair(modify value: 'T) -> nil fail: string where 'T: Fixup {
    value.fixup()!
}

func measure(value: 'T) -> int where 'T: Measured {
    return value.size()
}

func clear(modify value: 'T?) -> nil {
    value = nil
}

func start() -> nil {
    var handle: Handle = (fd = 0)
    try {
        verify(handle)!
        repair(handle)!
    } fail(failure) {
        require false
    }
    require handle.fd == 7
    require measure(handle) == 7
    var broken: Handle = (fd = -1)
    try {
        repair(broken)!
        require false
    } fail(failure) {
        require failure == "unfixable"
    }
    require broken.fd == -1
    var item: int? = 5
    clear(item)
    require item == nil
    __fd_write(2, "ok")
}
