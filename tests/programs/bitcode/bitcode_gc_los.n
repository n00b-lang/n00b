import sys.abi
import sys.gc.core
import sys.gc.los
import sys.gc.mark
import sys.gc.registry
import sys.memory

func mapped_heap() -> Ref[sys.gc.core.Heap] {
    let probe: Ref[sys.gc.core.Heap]? = nil
    let row: Ref[sys.abi.Type_Record]? = sys.abi.optional_reference_target(typeof(probe))
    if row != nil {
        let mapped: Ref[byte]? = sys.memory.map_zeroed(
            sys.abi.size_bytes(row.get()), sys.abi.alignment_bytes(row.get()))
        if mapped != nil { return unsafe_cast[Ref[sys.gc.core.Heap]] mapped.get() }
    }
    require false
}

func unmap_heap(heap: Ref[sys.gc.core.Heap]) {
    let probe: Ref[sys.gc.core.Heap]? = nil
    let row: Ref[sys.abi.Type_Record]? = sys.abi.optional_reference_target(typeof(probe))
    if row != nil {
        sys.memory.unmap(heap, sys.abi.size_bytes(row.get()))
        return
    }
    require false
}

comptime {
} else {
    let heap: Ref[sys.gc.core.Heap] = mapped_heap()
    heap.target_bytes = 8 * 1024 * 1024
    let total: uint = 16 * 1024
    let mapped: Ref[byte]? = sys.memory.map_zeroed(total, 16)
    if mapped != nil {
        let object: Ref[sys.gc.core.Los_Obj] = unsafe_cast[Ref[sys.gc.core.Los_Obj]] mapped.get()
        object.bytes = total
        object.mapping = mapped.get()
        object.mapped_bytes = total
        let header: Ref[sys.gc.core.Object_Header] = ref object.hdr
        assert sys.gc.core.los_of(header) == object
        assert sys.gc.core.header_of(sys.gc.core.payload_of(header)) == header
        header.meta = sys.gc.core.obj_large
        heap.mark_epoch = 1
        let payload: Ref[byte] = sys.gc.core.payload_of(header)
        assert !sys.gc.mark.is_marked(heap, payload)
        __atomic_store(ref object.marked, heap.mark_epoch)
        assert sys.gc.mark.is_marked(heap, payload)
        heap.los_count = 1
        heap.los_bytes = total
        assert sys.gc.registry.los_register(heap, object)
        sys.gc.los.release(heap, object)
        assert heap.los_count == 0
        assert heap.los_bytes == 0
        assert heap.los_cache_bytes == total

        let reused: Ref[sys.gc.core.Los_Obj]? = sys.gc.los.cache_take(heap, total)
        if reused != nil {
            assert reused.get() == object
            assert heap.los_cache_bytes == 0
            heap.los_count = 1
            heap.los_bytes = total
            sys.gc.los.release(heap, reused.get())
            sys.gc.los.cache_drain(heap)
            assert heap.los_cache_bytes == 0
        } else {
            require false
        }
        sys.gc.registry.regions_free(heap)
        unmap_heap(heap)
        __fd_write(2, "ok")
    } else {
        require false
    }
}
