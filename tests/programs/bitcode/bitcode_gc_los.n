import builtin.abi
import builtin.gc
import builtin.gc.los
import builtin.gc.mark
import builtin.gc.registry
import builtin.os

func mapped_heap() -> Ref[builtin.gc.Heap] {
    let probe: Ref[builtin.gc.Heap]? = nil
    let row: Ref[builtin.abi.Type_Record]? = builtin.abi.optional_reference_target(typeof(probe))
    if row != nil {
        let mapped: Ref[byte]? = builtin.os.map_zeroed(
            builtin.abi.size_bytes(row.get()), builtin.abi.alignment_bytes(row.get()))
        if mapped != nil { return unsafe_cast[Ref[builtin.gc.Heap]] mapped.get() }
    }
    require false
}

func unmap_heap(heap: Ref[builtin.gc.Heap]) {
    let probe: Ref[builtin.gc.Heap]? = nil
    let row: Ref[builtin.abi.Type_Record]? = builtin.abi.optional_reference_target(typeof(probe))
    if row != nil {
        builtin.os.unmap(heap, builtin.abi.size_bytes(row.get()))
        return
    }
    require false
}

comptime {
} else {
    let heap: Ref[builtin.gc.Heap] = mapped_heap()
    heap.target_bytes = 8 * 1024 * 1024
    let total: uint = 16 * 1024
    let mapped: Ref[byte]? = builtin.os.map_zeroed(total, 16)
    if mapped != nil {
        let object: Ref[builtin.gc.Los_Obj] = unsafe_cast[Ref[builtin.gc.Los_Obj]] mapped.get()
        object.bytes = total
        object.mapping = mapped.get()
        object.mapped_bytes = total
        let header: Ref[builtin.gc.Object_Header] = ref object.hdr
        assert builtin.gc.los_of(header) == object
        assert builtin.gc.header_of(builtin.gc.payload_of(header)) == header
        header.meta = builtin.gc.obj_large
        heap.mark_epoch = 1
        let payload: Ref[byte] = builtin.gc.payload_of(header)
        assert !builtin.gc.mark.is_marked(heap, payload)
        __atomic_store(ref object.marked, heap.mark_epoch)
        assert builtin.gc.mark.is_marked(heap, payload)
        heap.los_count = 1
        heap.los_bytes = total
        assert builtin.gc.registry.los_register(heap, object)
        builtin.gc.los.release(heap, object)
        assert heap.los_count == 0
        assert heap.los_bytes == 0
        assert heap.los_cache_bytes == total

        let reused: Ref[builtin.gc.Los_Obj]? = builtin.gc.los.cache_take(heap, total)
        if reused != nil {
            assert reused.get() == object
            assert heap.los_cache_bytes == 0
            heap.los_count = 1
            heap.los_bytes = total
            builtin.gc.los.release(heap, reused.get())
            builtin.gc.los.cache_drain(heap)
            assert heap.los_cache_bytes == 0
        } else {
            require false
        }
        builtin.gc.registry.regions_free(heap)
        unmap_heap(heap)
        __fd_write(2, "ok")
    } else {
        require false
    }
}
