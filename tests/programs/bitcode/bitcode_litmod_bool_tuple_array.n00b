litmod<array> identity, bundle(items: Array[Tuple[bool, int]]) -> Array[Tuple[bool, int]] fail: string {
    return items
}

func static_values() -> Array[Tuple[bool, int]] {
    return [(true, 7), (false, 8)]'bundle
}

func dynamic_values(value: int) -> Array[Tuple[bool, int]] {
    return [(true, value)]'bundle
}

comptime {
    static_values()
}

func run_test() {
    static_values()
    dynamic_values(9)
}
