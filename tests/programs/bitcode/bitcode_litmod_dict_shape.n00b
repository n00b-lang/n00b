litmod<dict> build_dict, mirror(items: Array[Tuple[int, int]]) -> Array[Tuple[int, int]] fail: string {
    return items
}

func static_dict() -> Array[Tuple[int, int]] {
    return {1: 2, 3: 4}'mirror
}

func dynamic_dict(x: int) -> Array[Tuple[int, int]] {
    return {x: 2, 3: 4}'mirror
}

func empty_dict() -> Array[Tuple[int, int]] {
    return {}'mirror
}

comptime {
} else {
