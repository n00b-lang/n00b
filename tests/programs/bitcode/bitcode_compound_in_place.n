record Tally {
    count: int
    calls: int
}

func __add_assign(modify self: Tally, other: int) {
    self.count += other
    self.calls += 1
}

record Pair {
    value: int
}

func __add(self: Pair, other: int) -> Pair {
    return (value = self.value + other)
}

comptime {} else {
    var tally: Tally = (count = 1, calls = 0)
    tally += 4
    tally += 5
    require tally.count == 10 and tally.calls == 2
    var pair: Pair = (value = 1)
    pair += 2
    require pair.value == 3
    __fd_write(2, "ok")
}
