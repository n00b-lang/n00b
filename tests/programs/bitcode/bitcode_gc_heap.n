import builtin.abi
import builtin.gc
import builtin.gc.heap
import builtin.gc.mutator
import builtin.gc.roots
import builtin.os

func u64_record() -> Ref[builtin.abi.Type_Record] {
    let probe: u64 = 0
    let row: Ref[builtin.abi.Type_Record]? = builtin.abi.type_for(typeof(probe))
    if row != nil { return row.get() }
    require false
}

comptime {
} else {
    let created: Ref[builtin.gc.Heap]? = builtin.gc.heap.create(nil)
    if created != nil {
        let heap: Ref[builtin.gc.Heap] = created.get()
        let expected_initial: uint = 4 * 1024 * 1024
        assert heap.cfg.initial_heap_bytes == expected_initial
        assert heap.cfg.growth_factor == 2.0
        assert heap.target_bytes == heap.cfg.initial_heap_bytes
        assert heap.alloc_budget == heap.cfg.initial_heap_bytes
        assert heap.epoch == 1
        assert heap.mark_epoch == 1
        let attached: Ref[builtin.gc.Mutator]? = builtin.gc.mutator.create(heap)
        if attached != nil {
            assert heap.nmutators == 1
            var slot: Ref[byte]? = nil
            assert builtin.gc.roots.push(attached.get(), ref slot)
            assert builtin.gc.roots.depth(attached.get()) == 1
        } else { require false }
        builtin.gc.heap.destroy(heap)
    } else {
        require false
    }

    let probe: Ref[builtin.gc.Config]? = nil
    let row: Ref[builtin.abi.Type_Record]? = builtin.abi.optional_reference_target(typeof(probe))
    if row != nil {
        let size: uint = builtin.abi.size_bytes(row.get())
        let mapping: Ref[byte]? = builtin.os.map_zeroed(size,
            builtin.abi.alignment_bytes(row.get()))
        if mapping != nil {
            let config: Ref[builtin.gc.Config] = unsafe_cast[Ref[builtin.gc.Config]] mapping.get()
            builtin.gc.heap.config_default(config)
            config.initial_heap_bytes = 1
            config.growth_factor = 0.5
            config.max_heap_bytes = builtin.gc.block_bytes * 2
            let custom: Ref[builtin.gc.Heap]? = builtin.gc.heap.create(config)
            if custom != nil {
                let heap: Ref[builtin.gc.Heap] = custom.get()
                assert heap.cfg.initial_heap_bytes == config.max_heap_bytes
                assert heap.cfg.growth_factor == 1.0
                assert heap.target_bytes == config.max_heap_bytes
                builtin.gc.heap.destroy(heap)
            } else { require false }
            builtin.os.unmap(config, size)
        } else { require false }
    } else { require false }

    let retained: u64 = 0x12345678
    let item: Ref[builtin.abi.Type_Record] = u64_record()
    let item_bytes: uint = builtin.abi.size_bytes(item)
    let item_alignment: uint = builtin.abi.alignment_bytes(item)
    var slots: Ref[byte]? = nil
    var capacity: uint = 0
    assert builtin.gc.heap.grow_array(ref slots, ref capacity,
                                      item_bytes, item_alignment, 0, 1)
    if slots != nil {
        let first: Ref[u64] = unsafe_cast[Ref[u64]] slots.get()
        ref_write(first, retained)
        assert builtin.gc.heap.grow_array(ref slots, ref capacity,
                                          item_bytes, item_alignment,
                                          1, capacity + 1)
        if slots != nil {
            let grown: Ref[u64] = unsafe_cast[Ref[u64]] slots.get()
            assert ref_read(grown) == retained
            builtin.os.unmap(grown, capacity * item_bytes)
        } else { require false }
    } else { require false }
    __fd_write(2, "ok")
}
