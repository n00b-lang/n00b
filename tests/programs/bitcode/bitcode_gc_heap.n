import sys.abi
import sys.gc.core
import sys.gc.heap
import sys.gc.mutator
import sys.gc.roots
import sys.memory

func u64_record() -> Ref[sys.abi.Type_Record] {
    let probe: u64 = 0
    let row: Ref[sys.abi.Type_Record]? = sys.abi.type_for(typeof(probe))
    if row != nil { return row.get() }
    require false
}

let created: Ref[sys.gc.core.Heap]? = sys.gc.heap.create(nil)
if created != nil {
    let heap: Ref[sys.gc.core.Heap] = created.get()
    let expected_initial: uint = 4 * 1024 * 1024
    assert heap.cfg.initial_heap_bytes == expected_initial
    assert heap.cfg.growth_factor == 2.0
    assert heap.target_bytes == heap.cfg.initial_heap_bytes
    assert heap.alloc_budget == heap.cfg.initial_heap_bytes
    assert heap.epoch == 1
    assert heap.mark_epoch == 1
    let attached: Ref[sys.gc.core.Mutator]? = sys.gc.mutator.create(heap)
    if attached != nil {
        assert heap.nmutators == 1
        var slot: Ref[byte]? = nil
        require sys.gc.roots.push(attached.get(), ref slot)
        assert sys.gc.roots.depth(attached.get()) == 1
    } else { require false }
    sys.gc.heap.destroy(heap)
} else {
    require false
}

let probe: Ref[sys.gc.core.Config]? = nil
let row: Ref[sys.abi.Type_Record]? = sys.abi.optional_reference_target(typeof(probe))
if row != nil {
    let size: uint = sys.abi.size_bytes(row.get())
    let mapping: Ref[byte]? = sys.memory.map_zeroed(size,
        sys.abi.alignment_bytes(row.get()))
    if mapping != nil {
        let config: Ref[sys.gc.core.Config] = unsafe_cast[Ref[sys.gc.core.Config]] mapping.get()
        sys.gc.heap.config_default(config)
        config.initial_heap_bytes = 1
        config.growth_factor = 0.5
        config.max_heap_bytes = sys.gc.core.block_bytes * 2
        let custom: Ref[sys.gc.core.Heap]? = sys.gc.heap.create(config)
        if custom != nil {
            let heap: Ref[sys.gc.core.Heap] = custom.get()
            assert heap.cfg.initial_heap_bytes == config.max_heap_bytes
            assert heap.cfg.growth_factor == 1.0
            assert heap.target_bytes == config.max_heap_bytes
            sys.gc.heap.destroy(heap)
        } else { require false }
        sys.memory.unmap(config, size)
    } else { require false }
} else { require false }

let retained: u64 = 0x12345678
let item: Ref[sys.abi.Type_Record] = u64_record()
let item_bytes: uint = sys.abi.size_bytes(item)
let item_alignment: uint = sys.abi.alignment_bytes(item)
var slots: Ref[byte]? = nil
var capacity: uint = 0
require sys.gc.heap.grow_array(ref slots, ref capacity,
                                  item_bytes, item_alignment, 0, 1)
if slots != nil {
    let first: Ref[u64] = unsafe_cast[Ref[u64]] slots.get()
    ref_write(first, retained)
    require sys.gc.heap.grow_array(ref slots, ref capacity,
                                      item_bytes, item_alignment,
                                      1, capacity + 1)
    if slots != nil {
        let grown: Ref[u64] = unsafe_cast[Ref[u64]] slots.get()
        assert ref_read(grown) == retained
        sys.memory.unmap(grown, capacity * item_bytes)
    } else { require false }
} else { require false }
__fd_write(2, "ok")
