import builtin.os

comptime {
} else {
    let page: uint = builtin.os.page_size()
    let source: Ref[byte]? = builtin.os.map_zeroed(page, page)
    let destination: Ref[byte]? = builtin.os.map_zeroed(page, page)
    if source != nil {
        if destination != nil {
            let src: Ref[byte] = source.get()
            let dst: Ref[byte] = destination.get()
            let pattern: byte = 0x5a
            __gc_memset(src, pattern, page)
            __gc_memcpy(dst, src, page)
            var word: u64 = 0
            __gc_memcpy(ref word, src, 8)
            assert word == 0x5a5a5a5a5a5a5a5a
            word = 0
            __gc_memcpy(dst, ref word, 8)
            assert ref_read(dst) == cast[byte](0)
            __gc_memcpy(dst, src, 8)
            let last: Ref[byte] = __gc_byte_offset(dst, page - 1)
            assert ref_read(dst) == pattern
            assert ref_read(last) == pattern
            builtin.os.unmap(src, page)
            builtin.os.unmap(dst, page)
            __fd_write(2, "ok")
        } else { require false }
    } else { require false }
}
