// A generic object type with a finalizer, named only by `typeof`: nothing
// makes one, so no finalizer is specialized for it and the build must not
// expect one. The static literal adds a build-time program, which names the
// type too.
import sys.abi

object Box {
    f: 'T
}

var finalized: int = 0

func __finalize(consume self: Ref[Box['T]]) {
    finalized += 1
}

let probe: Ref[Box[int]]? = nil
let sizes: List[int] = [1, 2]
require sys.abi.optional_reference_target(typeof(probe)) != nil
require finalized == 0 and sizes.len() == 2
