type State {
    count: int
}

callback Counter {
    call(value: int) -> int
    handler(modify state: State, value: int) -> int
    setup(handler: Ref[(modify state: State, value: int) -> int],
          state: Ref[State]) -> nil
}

func handle(modify state: State, value: int) -> int {
    state.count += value
    return state.count
}

func setup(handler: Ref[(modify state: State, value: int) -> int],
           state: Ref[State]) -> nil {
}

func make_from_ref(state: Ref[State]) -> Counter {
    return callback[Counter](ref handle, state)
}

func make(input: State) -> Counter {
    var state = input
    return make_from_ref(ref state)
}

var initial: State
initial.count = 0
let cb = make(initial)
require cb.call(2) == 2
require cb.call(3) == 5
__fd_write(2, "ok")
