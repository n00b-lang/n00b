record State {
    count: int
}

callback Counter {
    call(value: int) -> int fail: string
    handler(modify state: State, value: int) -> int fail: string
    setup(handler: Ref[(modify state: State, value: int) -> int fail: string],
          state: Ref[State]) -> nil fail: string
}

func handle(modify state: State, value: int) -> int fail: string {
    state.count += value
    if value < 0 {
        fail "negative"
    }
    return state.count
}

func setup(handler: Ref[(modify state: State, value: int) -> int fail: string],
           state: Ref[State]) -> nil fail: string {
}

func run(input: State) -> int fail: string {
    var state = input
    let counter = callback[Counter](ref handle, ref state)!
    try {
        let unused = counter.call(-1)!
        require false
    } fail(err) {
        require true
    }
    return counter.call(2)!
}

var initial: State
initial.count = 0
try {
    require run(initial)! == 2
} fail(err) {
    require false
}
__fd_write(2, "ok")
