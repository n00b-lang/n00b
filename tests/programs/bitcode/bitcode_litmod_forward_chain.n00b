declare_litmod("outer", "string", "make_outer")
declare_litmod("inner", "string", "make_inner")

func value() -> int {
    return "ignored"'outer
}

func make_outer(raw: string) fail: string {
    return "ignored"'inner
}

func make_inner(raw: string) -> int fail: string {
    return 42
}

comptime {
    require value() == 42
} else {
    require value() == 42
}
