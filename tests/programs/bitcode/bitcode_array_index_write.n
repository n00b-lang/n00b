func read_at(values: Array['T], index: uint) -> 'T {
    return values[index]
}

record Slots {
    values: Array[int][2]
}

var slots: Slots
slots.values[0] = 11
let index: uint = 1
slots.values[index] = 29
assert slots.values[index] == 29
var values: Array[int] = new[Array[int]](2)
values[index] = 29
assert read_at(values, index) == 29
assert ref_read(ref slots.values[0]) == 11
assert ref_read(ref slots.values[1]) == 29
__fd_write(2, "ok")
