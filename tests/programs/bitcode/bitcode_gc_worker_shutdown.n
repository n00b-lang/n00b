import builtin.gc
import builtin.gc.collect
import builtin.gc.heap

comptime {} else {
    let created: Ref[builtin.gc.Heap]? = builtin.gc.heap.create(nil)
    if created != nil {
        let heap: Ref[builtin.gc.Heap] = created.get()
        __atomic_store(ref heap.shutdown, true)
        builtin.gc.collect.worker(heap)
        require __atomic_load(ref heap.nworkers) == 0
        builtin.gc.heap.destroy(heap)
        __fd_write(2, "ok")
    } else { require false }
}
