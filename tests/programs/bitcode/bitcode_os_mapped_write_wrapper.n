import builtin.os

const stderr_fd: i32 = 2

func map_page(size: uint) -> Ref[byte]? {
    return builtin.os.map_zeroed(size, size)
}

comptime {
} else {
    let page: uint = builtin.os.page_size()
    let mapped: Ref[byte]? = map_page(page)
    if mapped != nil {
        let base: Ref[byte] = mapped.get()
        let cell: Ref[byte] = __gc_byte_offset(base, 3)
        let expected: byte = 42
        ref_write(cell, 42)
        if ref_read(cell) == expected {
            __fd_write(stderr_fd, "ok\n")
        } else {
            __fd_write(stderr_fd, "bad value\n")
        }
        builtin.os.unmap(base, page)
    } else {
        __fd_write(stderr_fd, "map failed\n")
    }
}
