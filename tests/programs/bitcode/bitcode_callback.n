callback Add_One {
    call(value: int) -> int
    handler(value: int) -> int
}

func add_one(value: int) -> int {
    return value + 1
}

func make_callback() -> Add_One {
    return callback[Add_One](ref add_one)
}

let callback_value = make_callback()
require callback_value.call(41) == 42
__fd_write(2, "ok")
