import sys.threads

var shared: int = 0
var counter: Atomic[int] = 0
var private_count: int = 0

func worker(argument: Ref[byte]) -> Ref[byte] {
    shared += 1
    __atomic_fetch_add(ref counter, 1)
    private_count += 1
    return argument
}

var seed: byte = 0
require sys.threads.thread_start(ref worker, ref seed)
shared += 1
__atomic_fetch_add(ref counter, 1)
__fd_write(2, "ok")
