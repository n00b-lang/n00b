import sys.threads

var shared: int = 0
var counter: Atomic[int] = 0
var private_count: int = 0

func worker() {
    shared += 1
    __atomic_fetch_add(ref counter, 1)
    private_count += 1
}

require sys.threads.thread_start(callback[sys.threads.Thread_Entry](ref worker))
shared += 1
__atomic_fetch_add(ref counter, 1)
__fd_write(2, "ok")
