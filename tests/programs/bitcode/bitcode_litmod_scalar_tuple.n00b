declare_litmod("bundle", "string", "identity")
declare_litmod("dynamic", "array", "from_items")

func identity(raw: string) -> Tuple[string, int] fail: string {
    return (raw, 7)
}

func from_items(items: Array[int]) -> Tuple[string, int] fail: string {
    return ("runtime", 9)
}

func value() -> Tuple[string, int] {
    return bundle"static result with relocation"
}

func runtime_value(x: int) -> Tuple[string, int] {
    return [1, x]'dynamic
}

func static_container() -> Tuple[string, int] {
    return [1, 2]'dynamic
}

func observe(item: Tuple[string, int]) {
    require true
}

comptime {
    observe(bundle"comptime result")
    observe([3, 4]'dynamic)
} else {
    value()
    static_container()
    runtime_value(2)
}
