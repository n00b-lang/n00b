import builtin.abi
import builtin.gc
import builtin.gc.handshake
import builtin.gc.los
import builtin.gc.mark
import builtin.os

func mapped_heap() -> Ref[builtin.gc.Heap] {
    let probe: Ref[builtin.gc.Heap]? = nil
    let row: Ref[builtin.abi.Type_Record]? = builtin.abi.optional_reference_target(typeof(probe))
    if row != nil {
        let mapped: Ref[byte]? = builtin.os.map_zeroed(
            builtin.abi.size_bytes(row.get()), builtin.abi.alignment_bytes(row.get()))
        if mapped != nil { return unsafe_cast[Ref[builtin.gc.Heap]] mapped.get() }
    }
    require false
}

func unmap_heap(heap: Ref[builtin.gc.Heap]) {
    let probe: Ref[builtin.gc.Heap]? = nil
    let row: Ref[builtin.abi.Type_Record]? = builtin.abi.optional_reference_target(typeof(probe))
    if row != nil {
        builtin.os.unmap(heap, builtin.abi.size_bytes(row.get()))
        return
    }
    require false
}

comptime {
} else {
    let block_bytes: uint = 32768
    let mapped: Ref[byte]? = builtin.os.map_zeroed(block_bytes, block_bytes)
    if mapped != nil {
        let base: Ref[byte] = mapped.get()
        let heap: Ref[builtin.gc.Heap] = mapped_heap()
        let heap_type: Ref[builtin.abi.Type_Record]? = builtin.abi.reference_target(typeof(heap))
        if heap_type != nil {
            assert heap_type.get().kind == cast[u32](builtin.abi.Type_Kind.record_type)
            let trace: Ref[builtin.abi.Trace_Record]? = builtin.abi.trace_at(heap_type.get().tracing_index)
            if trace != nil {
                var found_cache: bool = false
                var ordinal: u32 = 0
                while ordinal < trace.get().fixed_children.count {
                    let index: i64 = builtin.abi.range_index(
                        trace.get().fixed_children, ordinal)
                    assert index > 0
                    let child: Ref[builtin.abi.Trace_Child_Record]? = builtin.abi.trace_child_at(cast[u32] index)
                    if child != nil {
                        if child.get().repeat_count == cast[u64](builtin.gc.los_classes) {
                            let element: Ref[builtin.abi.Type_Record]? = builtin.abi.type_at(child.get().child_type_index)
                            if element != nil {
                                assert element.get().kind == cast[u32](builtin.abi.Type_Kind.option_type)
                                assert child.get().stride_bits == element.get().size_bits
                                found_cache = true
                            } else {
                                require false
                            }
                        }
                    } else {
                        require false
                    }
                    ordinal += 1
                }
                assert found_cache
            } else {
                require false
            }
        } else {
            require false
        }
        let epoch: u32 = 1
        heap.cfg.poison_free = false
        heap.epoch = epoch
        heap.mark_epoch = epoch
        heap.all_blocks = nil
        heap.nblocks = 0
        heap.los_bytes = 0
        heap.los_cache_bytes = 0
        heap.cfg.max_heap_bytes = 0
        assert builtin.gc.los.cache_take(heap, 10 * 1024) == nil
        builtin.gc.los.cache_drain(heap)
        let metadata: Ref[builtin.gc.Block_Metadata] = builtin.gc.block_metadata_at(base)
        builtin.gc.block_init(heap, metadata)
        assert heap.nblocks == 1
        assert builtin.gc.committed_bytes(heap) == block_bytes
        assert !builtin.gc.over_max(heap, 1)
        heap.cfg.max_heap_bytes = block_bytes
        assert builtin.gc.over_max(heap, 1)
        assert builtin.gc.over_max(heap, ~cast[uint](0))
        let linked: Ref[builtin.gc.Block_Metadata]? = heap.all_blocks
        if linked != nil {
            assert linked.get() == metadata
        } else {
            require false
        }
        assert metadata.magic == 0x6d616e69
        assert cast[u8] metadata.state == cast[u8] builtin.gc.Block_State.retired
        assert metadata.free_lines == 249
        assert metadata.sweep_epoch == epoch
        assert builtin.gc.read_epoch(metadata) == epoch
        let marked: u32 = __atomic_load(ref metadata.mark_epoch)
        let black: u32 = __atomic_load(ref metadata.black_epoch)
        assert marked == epoch
        assert black == 0
        builtin.gc.raise_black(metadata, 2)
        assert __atomic_load(ref metadata.black_epoch) == 2
        builtin.gc.raise_black(metadata, 1)
        assert __atomic_load(ref metadata.black_epoch) == 2
        assert !__atomic_load(ref metadata.in_final)
        __atomic_store(ref metadata.in_final, true)
        assert __atomic_load(ref metadata.in_final)
        __atomic_store(ref metadata.in_final, false)
        __gc_signal_fence()
        var bump: builtin.gc.Bump
        var mutator: builtin.gc.Mutator
        mutator.heap = heap
        mutator.black = false
        let attached: Ref[builtin.gc.Block_Metadata]? = metadata
        builtin.gc.bump_attach(ref mutator, ref bump, attached)
        let empty_cache: Ref[builtin.gc.Block_Metadata]? = nil
        __atomic_store(ref bump.cache, empty_cache)
        assert builtin.gc.bump_room(ref bump) == 0
        let found: bool = builtin.gc.bump_next_hole(ref bump, 32)
        assert found
        assert builtin.gc.bump_room(ref bump) == block_bytes - 896
        let cursor: Ref[byte]? = bump.cursor
        if cursor != nil {
            let expected: byte = 42
            ref_write(cursor.get(), 42)
            let cell: Ref[byte] = __gc_byte_offset(base, 896)
            assert __gc_byte_diff(cell, base) == 896
            assert __gc_byte_diff(base, cell) == -896
            assert ref_read(cell) == expected
            let header: Ref[builtin.gc.Object_Header] = unsafe_cast[Ref[builtin.gc.Object_Header]] cell
            header.meta = builtin.gc.meta_make(32, 0)
            assert builtin.gc.meta_payload_bytes(header.meta) == 32
            assert builtin.gc.object_bytes(header) == 48
            assert builtin.gc.block_of(header) == metadata
            let payload: Ref[byte] = builtin.gc.payload_of(header)
            assert !builtin.gc.mark.is_marked(heap, payload)
            let granule: uint = 896 / builtin.gc.granule_bytes
            let word: Ref[Atomic[u64]] = builtin.gc.mark_word_at(
                base, granule / builtin.gc.word_bits)
            let mask: u64 = cast[u64](1) << (granule % builtin.gc.word_bits)
            __atomic_fetch_or(word, mask)
            assert builtin.gc.mark.is_marked(heap, payload)
            heap.mark_epoch = epoch + 1
            assert !builtin.gc.mark.is_marked(heap, payload)
            heap.mark_epoch = epoch
        } else {
            assert false
        }
        let protected_end: Ref[byte] = __gc_byte_offset(base, 1024)
        bump.limit = protected_end
        builtin.gc.handshake.reserve_own_hole(ref bump, epoch)
        assert __atomic_load(ref metadata.line_marks[7]) == cast[u8](epoch)
        assert __gc_byte_diff(ref metadata.line_marks[8],
            ref metadata.line_marks[7]) == 1
        assert __atomic_load(ref metadata.line_marks[8]) != cast[u8](epoch)
        bump.cursor = __gc_byte_offset(base, 1000)
        bump.limit = __gc_byte_offset(base, 1200)
        builtin.gc.handshake.reserve_own_hole(ref bump, epoch)
        assert __atomic_load(ref metadata.line_marks[8]) == cast[u8](epoch)
        assert __atomic_load(ref metadata.line_marks[9]) == cast[u8](epoch)
        assert __atomic_load(ref metadata.line_marks[10]) != cast[u8](epoch)
        let exhausted: bool = builtin.gc.bump_next_hole(ref bump, block_bytes)
        assert !exhausted
        let cached: Ref[builtin.gc.Block_Metadata]? = metadata
        __atomic_store(ref bump.cache, cached)
        let popped: Ref[builtin.gc.Block_Metadata]? = builtin.gc.cache_pop(ref bump)
        assert popped != nil
        assert __atomic_load(ref bump.cache) == nil
        unmap_heap(heap)
        builtin.os.unmap(base, block_bytes)
        __fd_write(2, "ok")
    } else {
        assert false
    }
}
