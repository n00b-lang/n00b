const extent: uint = 4

record Deferred_Array {
    items: Array[int][extent]
}

record Pair layout(c) {
    left: int
    right: int
}

func comptime_start() -> nil {
    var pair: Pair
    pair.left = 3
    pair.right = 4
    require pair.left + pair.right == 7
}

func start() -> nil {
    __fd_write(2, "ok")
}
