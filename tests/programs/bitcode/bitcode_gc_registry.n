import sys.abi
import sys.memory
import sys.gc.core
import sys.gc.registry
import sys.gc.los
import sys.gc.alloc

let probe: Ref[sys.gc.core.Heap]? = nil
let row: Ref[sys.abi.Type_Record]? = sys.abi.optional_reference_target(typeof(probe))
let los_probe: Ref[sys.gc.core.Los_Obj]? = nil
let los_row: Ref[sys.abi.Type_Record]? = sys.abi.optional_reference_target(typeof(los_probe))
assert los_row != nil
if row != nil {
    let bytes: uint = sys.abi.size_bytes(row.get())
    let alignment: uint = sys.abi.alignment_bytes(row.get())
    let mapped: Ref[byte]? = sys.memory.map_zeroed(bytes, alignment)
    if mapped != nil {
        let heap: Ref[sys.gc.core.Heap] = unsafe_cast[Ref[sys.gc.core.Heap]] mapped.get()
        sys.gc.registry.registry_read_lock(heap)
        assert __atomic_load(ref heap.reg_rw) == 1
        sys.gc.registry.registry_read_unlock(heap)
        assert __atomic_load(ref heap.reg_rw) == 0
        sys.gc.los.cache_drain(heap)
        sys.gc.los.free_all(heap)
        sys.memory.unmap(mapped.get(), bytes)
        __fd_write(2, "ok")
    } else {
        assert false
    }
} else {
    assert false
}
