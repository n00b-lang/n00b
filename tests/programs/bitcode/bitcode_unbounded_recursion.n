func spin(n: int) -> int {
    return spin(n + 1)
}
func ping(n: int) -> int {
    return pong(n)
}
func pong(n: int) -> int {
    return ping(n)
}
func fact(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}
func serve() {
    __os_exit(0)
}
if fact(3) == 7 {
    require spin(1) == ping(1)
    serve()
}
