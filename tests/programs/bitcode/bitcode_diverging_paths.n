func die(code: int) {
    __os_exit(code)
}

func pick(flag: bool) -> int {
    if flag {
        return 1
    }
    die(2)
}

func direct(flag: bool) -> int {
    if flag {
        return 1
    }
    __os_exit(2)
}

func choose(flag: bool) -> int {
    let chosen: int
    if flag {
        chosen = 1
    } else {
        die(3)
    }
    return chosen
}

require pick(true) == 1
require direct(true) == 1
require choose(true) == 1
__fd_write(2, "ok")
