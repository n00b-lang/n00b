record First {
    raw: uint
}

record Second {
    raw: uint
}

func measure(value: int) -> int {
    return value + 1
}

func measure(value: int, scale: int) -> int {
    return value * scale
}

func shut(modify self: First) {
    self.raw = 1
}

func shut(modify self: Second) {
    self.raw = 2
}

assert measure(4) == 5
assert measure(4, 3) == 12
var first: First = (raw = 0)
var second: Second = (raw = 0)
shut(second)
shut(first)
assert first.raw == 1
assert second.raw == 2
__fd_write(2, "ok")
