litmod<set> build_set, mirror(items: Array[int]) -> Array[int] fail: string {
    return items
}

func static_set() -> Array[int] {
    return {1, 2}'mirror
}

func dynamic_set(x: int) -> Array[int] {
    return {x, 2}'mirror
}

func empty_set() -> Array[int] {
    return {}'mirror
}

comptime {
} else {
    static_set()
    dynamic_set(3)
    empty_set()
}
