declare_litmod("outer", "string", "make_outer")
declare_litmod("inner", "string", "identity")

func make_outer(raw: string) -> string fail: string {
    return "an inner long string payload"'inner
}

func identity(raw: string) -> string fail: string {
    return raw
}

func observe(value: string) {
    require true
}

comptime {
    observe("ignored"'outer)
} else {
    observe("ignored"'outer)
}
