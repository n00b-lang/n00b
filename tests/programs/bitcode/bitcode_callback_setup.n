type State {
    count: int
}

callback Counter {
    call(value: int) -> int
    handler(modify state: State, value: int) -> int
    setup(handler: Ref[(modify state: State, value: int) -> int],
          state: Ref[State], priority: int = 1) -> nil
}

func handle(modify state: State, value: int) -> int {
    state.count += value
    return state.count
}

func setup(handler: Ref[(modify state: State, value: int) -> int],
           state: Ref[State], priority: int = 1) -> nil {
    var current = ref_read(state)
    current.count = priority
    ref_write(state, current)
}

func with_default(input: State) -> Counter {
    var state: State = input
    return callback[Counter](ref handle, ref state)
}

func with_keyword(input: State) -> Counter {
    var state: State = input
    return callback[Counter](ref handle, ref state, priority = 5)
}

comptime {} else {
    var initial: State
    initial.count = 0
    let defaulted = with_default(initial)
    let named = with_keyword(initial)
    require defaulted.call(2) == 3
    require named.call(2) == 7
    __fd_write(2, "ok")
}
