import builtin.abi
import builtin.gc
import builtin.gc.alloc
import builtin.gc.collect
import builtin.gc.heap
import builtin.gc.handshake
import builtin.gc.mark
import builtin.gc.mutator
import builtin.gc.registry
import builtin.gc.roots
import builtin.os
import gc_root_support

variant Root_Variant {
    payload: Ref[byte]
    empty: nil
}

type Nested_Arm {
    child: Ref[byte]?
}

variant Nested_Root {
    data: Nested_Arm
    empty: nil
}

var static_root: Ref[byte]? = nil
var rooted_text: string = "this is a long static string root"
var variant_root: Root_Variant
var nested_root: Nested_Root

comptime {} else {
    variant_root = new[Root_Variant]()
    let created: Ref[builtin.gc.Heap]? = builtin.gc.heap.create(nil)
    if created != nil {
        let heap: Ref[builtin.gc.Heap] = created.get()
        let mapping: Ref[byte]? = builtin.os.map_zeroed(
            builtin.gc.block_bytes, builtin.gc.block_bytes)
        if mapping != nil {
            let base: Ref[byte] = mapping.get()
            let end: Ref[byte] = __gc_byte_offset(base, builtin.gc.block_bytes)
            require builtin.gc.registry.region_add(heap, base, end)
            let block: Ref[builtin.gc.Block_Metadata] = builtin.gc.block_metadata_at(base)
            builtin.gc.block_init(heap, block)
            let attached: Ref[builtin.gc.Mutator]? = builtin.gc.mutator.create(heap)
            if attached != nil {
                let mutator: Ref[builtin.gc.Mutator] = attached.get()
                var owned: Ref[builtin.gc.Block_Metadata]? = nil
                builtin.gc.own(heap, mutator, block, ref owned)
                let assigned: Ref[builtin.gc.Block_Metadata]? = block
                builtin.gc.bump_attach(mutator, ref mutator.small, assigned)
                require builtin.gc.bump_next_hole(ref mutator.small, 48)
                let sample: byte = 0
                let type_index: u32 = cast[u32](typeof(sample))
                let first: Ref[byte]? = builtin.gc.alloc.allocate_reserved(
                    mutator, ref mutator.small, type_index, 8,
                    builtin.gc.granule_bytes, false)
                let second: Ref[byte]? = builtin.gc.alloc.allocate_reserved(
                    mutator, ref mutator.small, type_index, 8,
                    builtin.gc.granule_bytes, false)
                let third: Ref[byte]? = builtin.gc.alloc.allocate_reserved(
                    mutator, ref mutator.small, type_index, 8,
                    builtin.gc.granule_bytes, false)
                if first != nil and second != nil and third != nil {
                    let slot_probe: Ref[byte]? = nil
                    let slot_row: Ref[builtin.abi.Type_Record]? = builtin.abi.type_for(typeof(slot_probe))
                    let marker_probe: Ref[builtin.gc.Marker]? = nil
                    let marker_row: Ref[builtin.abi.Type_Record]? = builtin.abi.optional_reference_target(typeof(marker_probe))
                    if slot_row != nil and marker_row != nil {
                        let slot_bytes: uint = builtin.abi.size_bytes(slot_row.get())
                        let marker_bytes: uint = builtin.abi.size_bytes(marker_row.get())
                        let slot_map: Ref[byte]? = builtin.os.map_zeroed(
                            slot_bytes, builtin.abi.alignment_bytes(slot_row.get()))
                        let marker_map: Ref[byte]? = builtin.os.map_zeroed(
                            marker_bytes, builtin.abi.alignment_bytes(marker_row.get()))
                        if slot_map != nil and marker_map != nil {
                            let slot: Ref[Ref[byte]?] = unsafe_cast[Ref[Ref[byte]?]] slot_map.get()
                            let marker: Ref[builtin.gc.Marker] = unsafe_cast[Ref[builtin.gc.Marker]] marker_map.get()
                            ref_write(slot, first)
                            require builtin.gc.roots.add_global(heap, slot)
                            builtin.gc.mark.marker_init(marker, heap, false)
                            builtin.gc.collect.mark_global_roots(marker)
                            assert builtin.gc.mark.is_marked(heap, first.get())
                            assert !builtin.gc.mark.is_marked(heap, second.get())
                            builtin.gc.roots.remove_global(heap, slot)
                            ref_write(slot, second)
                            require builtin.gc.roots.push(mutator, slot)
                            builtin.gc.collect.mark_roots(marker)
                            assert builtin.gc.mark.is_marked(heap, second.get())
                            builtin.gc.roots.pop(mutator, 0)
                            assert !builtin.gc.mark.is_marked(heap, third.get())
                            __atomic_store(ref heap.marking, true)
                            builtin.gc.mark.barrier_pointer(mutator, slot_map.get())
                            assert mutator.write_buffer_count == 0
                            builtin.gc.mark.barrier_pointer(mutator, third)
                            assert mutator.write_buffer_count == 1
                            __atomic_store(ref heap.hs_kind,
                                cast[u32](builtin.gc.Handshake_Kind.scan))
                            __atomic_store(ref mutator.hs_state,
                                cast[u32](builtin.gc.Handshake_State.requested))
                            __atomic_store(ref heap.hs_pending, 1)
                            builtin.gc.handshake.safepoint(mutator)
                            assert builtin.gc.mark.is_marked(heap, third.get())
                            assert mutator.write_buffer_count == 0
                            assert __atomic_load(ref heap.round_dirty)
                            let fourth: Ref[byte]? = builtin.gc.alloc.allocate_reserved(
                                mutator, ref mutator.small, type_index, 8,
                                builtin.gc.granule_bytes, false)
                            if fourth != nil {
                                var count: uint = 0
                                while count < builtin.gc.write_buffer_cap {
                                    builtin.gc.mark.write_barrier(mutator, fourth)
                                    count += 1
                                }
                                assert mutator.write_buffer_count == 0
                                assert heap.barrier_queue_count == builtin.gc.write_buffer_cap
                                builtin.gc.mark.barrier_queue_drain(marker)
                                assert heap.barrier_queue_count == 0
                                assert builtin.gc.mark.is_marked(heap, fourth.get())
                                let fifth: Ref[byte]? = builtin.gc.alloc.allocate_reserved(
                                    mutator, ref mutator.small, type_index, 8,
                                    builtin.gc.granule_bytes, false)
                                if fifth != nil {
                                    var word: uint = __abi_ref_address(fifth.get())
                                    let low: Ref[byte] = unsafe_cast[Ref[byte]] ref word
                                    let word_row: Ref[builtin.abi.Type_Record]? = builtin.abi.type_for(typeof(word))
                                    if word_row != nil {
                                        let high: Ref[byte] = __gc_byte_offset(low,
                                            builtin.abi.size_bytes(word_row.get()))
                                        assert !builtin.gc.mark.is_marked(heap, fifth.get())
                                        builtin.gc.collect.scan_words(marker, low, high)
                                        assert builtin.gc.mark.is_marked(heap, fifth.get())
                                    } else { require false }
                                } else { require false }
                            } else { require false }
                            let rooted: Ref[byte]? = builtin.gc.alloc.allocate_reserved(
                                mutator, ref mutator.small, type_index, 8,
                                builtin.gc.granule_bytes, false)
                            if rooted != nil {
                                assert !builtin.gc.mark.is_marked(heap, rooted.get())
                                static_root = rooted
                                builtin.gc.collect.mark_global_roots(marker)
                                assert builtin.gc.mark.is_marked(heap, rooted.get())
                                static_root = nil
                            } else { require false }
                            let imported: Ref[byte]? = builtin.gc.alloc.allocate_reserved(
                                mutator, ref mutator.small, type_index, 8,
                                builtin.gc.granule_bytes, false)
                            if imported != nil {
                                assert !builtin.gc.mark.is_marked(heap, imported.get())
                                gc_root_support.imported_root = imported
                                builtin.gc.collect.mark_global_roots(marker)
                                assert builtin.gc.mark.is_marked(heap, imported.get())
                                gc_root_support.imported_root = nil
                            } else { require false }
                            let variant_value: Ref[byte]? = builtin.gc.alloc.allocate_reserved(
                                mutator, ref mutator.small, type_index, 8,
                                builtin.gc.granule_bytes, false)
                            if variant_value != nil {
                                assert !builtin.gc.mark.is_marked(heap, variant_value.get())
                                variant_root.payload = variant_value.get()
                                switch variant_root {
                                    case payload {
                                        assert variant_root.payload == variant_value.get()
                                    }
                                    case empty { require false }
                                }
                                builtin.gc.collect.mark_global_roots(marker)
                                assert builtin.gc.mark.is_marked(heap, variant_value.get())
                                variant_root.empty = nil
                                switch variant_root {
                                    case payload { require false }
                                    case empty {}
                                }
                                variant_root = new[Root_Variant]()
                            } else { require false }
                            let nested_value: Ref[byte]? = builtin.gc.alloc.allocate_reserved(
                                mutator, ref mutator.small, type_index, 8,
                                builtin.gc.granule_bytes, false)
                            if nested_value != nil {
                                assert !builtin.gc.mark.is_marked(heap, nested_value.get())
                                nested_root.data = (child = nested_value)
                                builtin.gc.collect.mark_global_roots(marker)
                                assert builtin.gc.mark.is_marked(heap, nested_value.get())
                                nested_root.empty = nil
                            } else { require false }
                            let words_before: uint = marker.stack_words
                            heap.cfg.scan_stacks = true
                            builtin.gc.collect.mark_roots(marker)
                            assert marker.stack_words > words_before
                            heap.cfg.scan_stacks = false
                            builtin.os.unmap(marker, marker_bytes)
                            builtin.os.unmap(slot, slot_bytes)
                        } else { require false }
                    } else { require false }
                } else { require false }
                builtin.gc.mutator.destroy(mutator)
            } else { require false }
            builtin.gc.heap.destroy(heap)
            __fd_write(2, "ok")
        } else { require false }
    } else { require false }
}
