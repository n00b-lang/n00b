flagset Permissions {
    read,
    write,
    both = read +
        write,
}

comptime {} else {
    var value: uint =
        3 +
        4 *
        2
    value +=
        1
    require value ==
        12
    require (value &
        3) ==
        0
    require (1 <<
        2) ==
        4
    require true and
        true or
        false
    __fd_write(2, "ok")
}
