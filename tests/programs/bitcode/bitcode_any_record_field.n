type Entry {
    value: int
    other: any
}

var entries: List[Entry] = new[List[Entry]]()

func fill() {
    var i = 0
    while i < 64 {
        let text = "boxed text that is long enough to need heap storage " + "x"
        let e: Entry = (value = i, other = cast[any]text)
        entries.append(e)
        i = i + 1
    }
}

func check() -> int {
    var bad = 0
    var i = 0
    while i < 64 {
        let entry = entries[i]
        let other = entry.other
        let text = typecase other {
            case string { = other }
            else { = "" }
        }
        if text != "boxed text that is long enough to need heap storage x" {
            bad = bad + 1
        }
        i = i + 1
    }
    return bad
}

comptime {} else {
    fill()
    var junk: string = ""
    var j = 0
    while j < 2000000 {
        junk = "y" + "another piece of text long enough to need the heap"
        j = j + 1
    }
    require check() == 0
    __fd_write(2, "ok\n")
}
