import builtin.gc
import builtin.gc.alloc
import builtin.gc.hash
import builtin.gc.heap
import builtin.gc.registry
import builtin.os

comptime {
} else {
    let created: Ref[builtin.gc.Heap]? = builtin.gc.heap.create(nil)
    if created != nil {
        let heap: Ref[builtin.gc.Heap] = created.get()
        let mapped: Ref[byte]? = builtin.os.map_zeroed(
            builtin.gc.block_bytes, builtin.gc.block_bytes)
        if mapped != nil {
            let base: Ref[byte] = mapped.get()
            let end: Ref[byte] = __gc_byte_offset(base, builtin.gc.block_bytes)
            assert builtin.gc.registry.region_add(heap, base, end)
            let key: uint = __abi_ref_address(base) / builtin.gc.block_bytes
            let found: Ref[byte]? = builtin.gc.hash.tab_lookup(ref heap.blocks, key)
            if found != nil { assert found.get() == base } else { require false }
            assert heap.heap_lo <= __abi_ref_address(base)
            assert heap.heap_hi >= __abi_ref_address(end)
            let block: Ref[builtin.gc.Block_Metadata] = unsafe_cast[Ref[builtin.gc.Block_Metadata]] base
            builtin.gc.block_init(heap, block)
            let start: uint = builtin.gc.header_lines() * builtin.gc.line_bytes
            let header_base: Ref[byte] = __gc_byte_offset(base, start)
            let header: Ref[builtin.gc.Object_Header] = unsafe_cast[Ref[builtin.gc.Object_Header]] header_base
            header.type_index = 1
            header.meta = builtin.gc.meta_make(32, 0)
            let granule: uint = start / builtin.gc.granule_bytes
            let mask: u64 = cast[u64](1) << (granule % builtin.gc.word_bits)
            __atomic_fetch_or(builtin.gc.start_word_at(base,
                granule / builtin.gc.word_bits), mask)
            builtin.gc.registry.registry_read_lock(heap)
            assert builtin.gc.registry.find_object(heap, __abi_ref_address(base)) == nil
            let exact: Ref[builtin.gc.Object_Header]? = builtin.gc.registry.find_object(
                heap, __abi_ref_address(header_base))
            if exact != nil { assert exact.get() == header } else { require false }
            let interior: Ref[builtin.gc.Object_Header]? = builtin.gc.registry.find_object(
                heap, __abi_ref_address(header_base) + 47)
            if interior != nil { assert interior.get() == header } else { require false }
            assert builtin.gc.registry.find_object(heap, __abi_ref_address(header_base) + 48) == nil
            builtin.gc.registry.registry_read_unlock(heap)
            builtin.gc.alloc.block_release(heap, block)
            assert builtin.gc.hash.tab_lookup(ref heap.blocks, key) == nil
        } else { require false }
        builtin.gc.heap.destroy(heap)
        __fd_write(2, "ok")
    } else { require false }
}
