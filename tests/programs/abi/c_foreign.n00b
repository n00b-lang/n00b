record Item layout(c) {
    key: i32
    value: i32
}

record Holder layout(c) {
    items: Foreign[Item]? count total
    total: u64
    name: Foreign[i8]? until 0
    op: Foreign_Fn[(i64, i64) -> i64]?
    kind: i32
    v: union by kind {
        1 => number: i64
        2 => text: Foreign[i8]? until 0
        3 => _
    }
}
