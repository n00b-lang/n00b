public variant Choice {
    number: u64
    text: string
    empty: nil
}

public const number_choice: Choice = (number = 7)
public const text_choice: Choice = (text = "a long variant string value")
public const empty_choice: Choice = (empty = nil)
public const choices: Array[Choice] = [
    (number = 1),
    (empty = nil),
    (text = "a long variant string value")
]

public type Holder {
    choice: Choice
}

public const holder: Holder = (
    choice = (text = "a long variant string value")
)
