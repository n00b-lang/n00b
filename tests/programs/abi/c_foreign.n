[-
library c
struct item @size(8) @align(4) {
    key: i32 @0
    value: i32 @4
}

callback op_fn = fn(left: i64, right: i64) -> i64

struct holder @size(48) @align(8) {
    items: *[item; total] @0
    total: u64 @8
    name: *cstr @16
    op: op_fn @24
    kind: i32 @32
    v: union by kind @40 {
        1 => number: i64
        2 => text: *cstr
        3 => _
    }
}
-]'ffi
