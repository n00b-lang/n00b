flow_probe.inc: (int) -> int
  effects may_trap
  traps arithmetic
  output result data[x] control[]
flow_probe.choose: (bool, int) -> int
  effects none
  output result data[a] control[]
flow_probe.via_scalar: (int) -> int
  effects none
  output result data[x] control[]
flow_probe.via_local: (int, int) -> int
  effects none
  output result data[] control[]
flow_probe.via_array: (int) -> int
  effects may_trap may_allocate may_collect allocates_direct
  traps bounds arithmetic
  output result data[x] control[]
flow_probe.split: (modify Pair, int, int) -> int
  effects none
  output result data[] control[]
flow_probe.set_a: (modify Pair, int) -> nil
  effects none
  output result data[] control[]
flow_probe.heap_fields: (int, int) -> int
  effects may_trap may_allocate may_collect allocates_direct
  traps bounds arithmetic
  output result data[x y] control[]
flow_probe.heap_overwrite: (int, int) -> int
  effects may_trap may_allocate may_collect allocates_direct
  traps bounds arithmetic
  output result data[x y] control[]
flow_probe.param_fields: (modify Array[Pair], int, int) -> int
  effects may_trap
  reads arr[]
  reads+writes arr[].a
  writes arr[].b
  traps bounds
  output result data[x y] control[]
  output heap <any> data[] control[]
flow_probe.put: (modify Array[int], int) -> nil
  effects may_trap
  writes arr[]
  traps bounds
  output result data[] control[]
  output heap <any> data[] control[]
flow_probe.caller: (int) -> int
  effects may_trap may_allocate may_collect allocates_direct
  traps bounds arithmetic
  output result data[] control[]
