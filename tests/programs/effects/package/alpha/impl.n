func note(_entry: string) {
}

func flush() {
    note("batch")
}

effect Audited {
    from: note
    handled_by: flush
}

func trace(_entry: string) {
}

func traced() {
    trace("step")
}

func run() {
    traced()
}

effect Traced {
    from: trace
    scope: package
}

has_effect(run, Traced)
