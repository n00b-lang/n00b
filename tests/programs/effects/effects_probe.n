import sys.clock
import sys.env
import sys.fs
import sys.random
import text
import unicode

func probe() -> uint fail: int {
    var seen: uint = 0
    if __array_length(sys.fs.read_file("probe")!) != 0 {
        seen += 1
    }
    if sys.env.args().len() != 0 {
        seen += 1
    }
    if sys.clock.now_ns() != 0 {
        seen += 1
    }
    var buffer: Array[u8] = new[Array[u8]](4)
    sys.random.fill(buffer)!
    if buffer[0] != 0 {
        seen += 1
    }
    var seed: u64 = 0
    sys.random.fill(seed)!
    if seed != 0 {
        seen += 1
    }
    var table: Dict[string, int] = {}
    table.put("a", 1)
    if table.get("a") != nil and table.len() != 0 {
        seen += 1
    }
    for key, value in table {
        seen += 1
    }
    var items: List[int] = []
    items.append(1)
    for item in items {
        seen += items.len()
    }
    var spans: List[text.Style_Span] = new[List[text.Style_Span]]()
    if text.rich_string("probe", spans) == "probe" {
        seen += 1
    }
    if unicode.general_category('A') == unicode.Gc.lu {
        seen += 1
    }
    return seen
}

func start() -> nil {
    try {
        _ = probe()!
    } fail(code) {
    }
}
