const text = [-
library text
fn text_length(s: *cstr) -> usize
fn text_greeting() -> *cstr static
fn text_invalid() -> *cstr static
fn text_fill(dest: out *[u8; cap capacity, len ret], capacity: usize) -> usize
fn text_fill_invalid(dest: out *[u8; cap capacity, len ret], capacity: usize) -> usize

binding {
    string text_fill.dest as string
    string text_fill_invalid.dest as string
}
-]'ffi

const kept = [-
library kept

opaque stmt_state
handle Stmt = *stmt_state release stmt_release

callback text_free = fn(p: *void)

const TEXT_STATIC: text_free = 0

fn stmt_open() -> own ?Stmt release stmt_release
fn bind_text(
    stmt: Stmt,
    text: *[c_char; n] span by dtor,
    n:    c_int,
    dtor: text_free policy {
        TEXT_STATIC => text: keep until stmt_release(stmt)
        else        => text: for call
    },
) -> c_int
fn stmt_byte(stmt: Stmt, index: c_int) -> c_int
fn stmt_release(stmt: consume ?Stmt)

binding {
    policy bind_text.dtor use TEXT_STATIC
}
-]'ffi

const kw = [-
library keywords

opaque db_state
handle Db = *db_state release db_close

keywords OpenOpts presence mask(present) {
    present:    u32
    timeout_ms: u32  = 30000
    readonly:   bool = false
    cache_kb:   u32
}

keywords Limits presence sentinel {
    max_rows: i64 = -1 none -1
    min_rows: i64 none -1
}

keywords Sized presence size(size) {
    size:  u32
    flags: u32 = 4
}

keywords Plain presence always {
    depth: c_int = 3
}

fn db_open(path: *cstr, opts: ?OpenOpts) -> own ?Db release db_close
  pack keywords opts
fn db_present(db: Db) -> u32
fn db_timeout(db: Db) -> u32
fn db_cache(db: Db) -> u32
fn db_limit(db: Db, limits: *Limits) -> i64
  pack keywords limits
fn db_flags(db: Db, sized: *Sized) -> u32
  pack keywords sized
fn db_depth(db: Db, plain: *Plain) -> c_int
  pack keywords plain
fn db_close(db: consume ?Db)

binding {
    keywords Limits as record
}
-]'ffi

const cursor = [-
library cursor

opaque db_state
opaque iter_state
handle Source = *db_state release source_close
handle Iter = *iter_state release iter_close

fn source_open(seed: c_int) -> own ?Source release source_close
fn source_close(db: consume ?Source)
fn iter_new(db: Source) -> own ?Iter with db
fn iter_next(iter: Iter) -> c_int
fn iter_close(iter: consume ?Iter)
-]'ffi

const hooks = [-
library hooks

callback Hook = fn(context: *void userdata, value: c_int) -> c_int
  thread same

fn hook_subscribe(hook: keep Hook until hook_unsubscribe(ret), context: ?void userdata hook) -> u64
fn hook_fire(value: c_int) -> c_int
fn hook_context() -> u64
fn hook_unsubscribe(id: u64)
-]'ffi

const sorter = [-
library sorter

callback Compare = fn(a: *void, b: *void) -> c_int
  thread same

fn nth_sorted(items: *[u8; count], count: usize, n: usize, compare: Compare for call) -> c_int
fn byte_at(address: usize) -> u8

binding {
    provide nth_sorted.compare = "ffi_linked.descending"
    raw "byte_at"
}
-]'ffi

const guard = [-
library guard

callback Compute = fn(value: c_int) -> c_int
  thread same

fn guarded_call(compute: Compute for call, value: c_int) -> c_int

binding {
    provide guarded_call.compute = "ffi_linked.checked_double"
}
-]'ffi

const kv = [-
library kv

allocator kvheap alloc kv_malloc release kv_free

opaque kv_db
opaque kv_iter
handle Db   = *kv_db   release kv_close
handle Iter = *kv_iter release kv_iter_free

enum kv_status : c_int { KV_OK = 0, KV_NOTFOUND = 1, KV_ERR = 2 }

struct kv_entry @size(32) @align(8) {
    key:     *[u8; key_len]   with self   @0
    key_len: usize                        @8
    val:     *[u8; val_len]   with self   @16
    val_len: usize                        @24
}

fn kv_open(path: *cstr, out_db: out *Db) -> c_int as kv_status
  error ret != KV_OK via kv_errstr(ret)
  on error out_db: unset

fn kv_put(db: Db, key: *[u8; klen], klen: usize, val: *[u8; vlen], vlen: usize)
    -> c_int as kv_status
  error ret != KV_OK

fn kv_get(db: Db, key: *[u8; klen], klen: usize,
          out_val: out **[u8; *out_len] own release kv_free,
          out_len: out *usize)
    -> c_int as kv_status
  outcome failed failure when ret == KV_ERR
  outcome missing success when ret == KV_NOTFOUND
  outcome found success
  on failed out_val: unset
  on missing out_val: unset

fn kv_iter_new(db: Db, prefix: ?[u8; plen], plen: usize) -> own ?Iter with db
  error ret == null

fn kv_iter_next(it: Iter) -> ?kv_entry until next kv_iter_next(it), release(it)

fn kv_errstr(s: c_int) -> *cstr static

fn kv_live() -> c_int

binding {
    strip_prefix "kv_"
    method Db.put = kv_put
    method Db.get = kv_get
    method Db.iter = kv_iter_new
    method Iter.next = kv_iter_next
    static Db.open = kv_open
    hide "kv_errstr"
    raw "kv_live"
}
-]'ffi

const dispatch = [-
library dispatch
fn fire(handle: u64, value: c_int) -> c_int
fn read_int(address: usize) -> c_int
fn write_int(address: usize, value: c_int)
binding {
    raw "fire"
    raw "read_int"
    raw "write_int"
}
-]'ffi

callback Doubler {
    call(value: i32) -> i32
    handler(value: i32) -> i32
}

func twice(value: i32) -> i32 {
    return value * 2
}

var doublers: Ffi_Table[Doubler] = (slots = new[List[Doubler?]](), free = new[List[int]](),
                                    owners = new[List[uint]]())

func dispatch_doubler(handle: u64, arguments: uint, result: uint) -> i32 {
    let doubler = __ffi_table_get(doublers, handle)
    if doubler == nil {
        return -1
    }
    dispatch.write_int_raw(result, doubler.call(dispatch.read_int_raw(arguments)))
    return 0
}

func churn(rounds: i32) {
    var junk: string = ""
    var j = 0
    while j < rounds {
        junk = "x" + "a piece of text long enough to need the heap"
        j = j + 1
    }
}

func bind(statement: kept.Stmt) fail: kept.Error {
    let text = "kept text that is longer than the short form"
    kept.bind_text(statement, text)!
}

func open_iter(seed: i32) -> cursor.Iter {
    let db = cursor.source_open(seed)
    return cursor.iter_new(db)
}

func triple(value: i32) -> i32 {
    return value * 3
}

func descending(a: uint, b: uint) -> i32 {
    return cast[i32]sorter.byte_at_raw(b) - cast[i32]sorter.byte_at_raw(a)
}

func checked_double(value: i32) -> i32 {
    if value < 0 {
        panic("negative input")
    }
    return value * 2
}

try {
    require text.text_length("hello")! == 5
    require text.text_length("a string longer than the short form")! == 35
    require text.text_greeting()! == "héllo from C"
    require text.text_fill(64)! == "filled by C"
} fail(failure) {
    require false
}
try {
    text.text_invalid()!
    require false
} fail(failure) {
    require failure.code == -3
}
try {
    text.text_fill_invalid(64)!
    require false
} fail(failure) {
    require failure.code == -3
}

try {
    var statement = kept.stmt_open()
    bind(statement)!
    var i = 0
    var junk: string = ""
    while i < 2000 {
        junk = junk + "x"
        i = i + 1
    }
    require kept.stmt_byte(statement, 0) == 107
    require kept.stmt_byte(statement, 5) == 116
    kept.close(statement)!
} fail(failure) {
    require false
}
try {
    var closed = kept.stmt_open()
    kept.close(closed)!
    bind(closed)!
    require false
} fail(failure) {
    require failure.code == -1
    require failure.fn == "bind_text"
}

try {
    var defaults = kw.db_open("defaults")!
    require kw.db_present(defaults) == 0
    require kw.db_timeout(defaults) == 30000
    var tuned = kw.db_open("tuned", timeout_ms = 5, cache_kb = 64)!
    require kw.db_present(tuned) == 5
    require kw.db_timeout(tuned) == 5
    require kw.db_cache(tuned) == 64
    require kw.db_flags(tuned) == 804
    require kw.db_flags(tuned, flags = 9) == 809
    require kw.db_depth(tuned) == 3
    require kw.db_depth(tuned, depth = 7) == 7
    let limits: kw.Db_Limit_Options = (max_rows = 50, min_rows = nil)
    require kw.db_limit(tuned, limits) == 49999
    kw.close(defaults)!
    kw.close(tuned)!
} fail(failure) {
    require false
}

var k: i32 = 0
while k < 100 {
    var iter = open_iter(k)
    churn(100000)
    require cursor.iter_next(iter) == k
    require cursor.iter_next(iter) == k + 1
    try {
        cursor.close(iter)!
    } fail(failure) {
        require false
    }
    k = k + 1
}

let id = hooks.hook_subscribe(callback[hooks.Hook](ref triple))
let first = hooks.hook_context()
churn(200000)
try {
    require hooks.hook_fire(5) == 15
    require hooks.hook_fire(-2) == -6
    hooks.hook_unsubscribe(id)!
    require hooks.hook_fire(1) == -1
    let again = hooks.hook_subscribe(callback[hooks.Hook](ref triple))
    require hooks.hook_context() == first
    require hooks.hook_fire(2) == 6
    hooks.hook_unsubscribe(again)!
} fail(failure) {
    require false
}

let items: Array[u8] = [3, 9, 1, 7]
try {
    require sorter.nth_sorted(items, 0)! == 9
    require sorter.nth_sorted(items, 1)! == 7
    require sorter.nth_sorted(items, 3)! == 1
} fail(failure) {
    require false
}

require guard.guarded_call(21) == 42
require guard.guarded_call(-1) == -1000
require guard.guarded_call(5) == 10

try {
    let db = kv.db_open("store")!
    kv.put(db, [97, 49], [111, 110, 101])!
    kv.put(db, [97, 50], [116, 119, 111])!
    kv.put(db, [98, 49], [120])!
    let found = kv.get(db, [97, 50])!
    require found != nil
    if found != nil {
        require found.len() == 3
        require found[0] == 116
    }
    require kv.get(db, [122])! == nil
    require kv.live_raw() == 0
    let iter = kv.iter(db, [97])!
    var keys = 0
    var more = true
    while more {
        let entry = kv.next(iter)!
        if entry != nil {
            require entry.key.len() == 2
            require entry.val.len() == 3
            require entry.key[0] == 97
            keys = keys + 1
        } else {
            more = false
        }
    }
    require keys == 2
} fail(failure) {
    require false
}

let handle = __ffi_table_insert(doublers, callback[Doubler](ref twice))
require dispatch.fire_raw(handle, 21) == 42
__ffi_table_free(doublers, handle)
require dispatch.fire_raw(handle, 21) == -200
let reinserted = __ffi_table_insert(doublers, callback[Doubler](ref twice))
require reinserted == handle
require dispatch.fire_raw(reinserted, 5) == 10
__fd_write(2, "ok")
