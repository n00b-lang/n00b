# A contract that links "c" binds C code that may use libc's per-thread
# state (errno, stdio's locks). On Linux the threads the runtime starts have
# none, so a call from one fails at the shim instead of corrupting memory;
# elsewhere every thread is a libc thread and the call works.
import sys.threads

[-
library c
link "c"
header <stdlib.h>
fn abs(x: c_int) -> c_int
-]'ffi

var done: Atomic[int] = 0

func worker() {
    require abs(-3) == 3
    __atomic_store(ref done, 1)
}

require abs(-2) == 2
require sys.threads.thread_start(callback[sys.threads.Thread_Entry](ref worker))
while __atomic_load(ref done) == 0 {
    sys.threads.thread_yield()
}
