const dispatch = [-
library dispatch
fn fire(handle: u64, value: c_int) -> c_int
fn read_int(address: usize) -> c_int
fn write_int(address: usize, value: c_int)
binding {
    raw "fire"
    raw "read_int"
    raw "write_int"
}
-]'ffi

callback Doubler {
    call(value: i32) -> i32
    handler(value: i32) -> i32
}

func twice(value: i32) -> i32 {
    return value * 2
}

func invoke_doubler(value: Any, arguments: uint, result: uint) -> nil {
    typecase value {
        case Doubler {
            dispatch.write_int_raw(result, value.call(dispatch.read_int_raw(arguments)))
        }
        else {
            panic("wrong callback type")
        }
    }
}

comptime {} else {
    let handle = __ffi_callback_register(cast[Any]callback[Doubler](ref twice), ref invoke_doubler)
    require dispatch.fire_raw(handle, 21) == 42
    __ffi_callback_free(handle)
    require dispatch.fire_raw(handle, 21) == -200
    let again = __ffi_callback_register(cast[Any]callback[Doubler](ref twice), ref invoke_doubler)
    require again == handle
    require dispatch.fire_raw(again, 5) == 10
    __fd_write(2, "ok\n")
}
