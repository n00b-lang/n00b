const dispatch = [-
library dispatch
fn fire(handle: u64, value: c_int) -> c_int
fn read_int(address: usize) -> c_int
fn write_int(address: usize, value: c_int)
binding {
    raw "fire"
    raw "read_int"
    raw "write_int"
}
-]'ffi

callback Doubler {
    call(value: i32) -> i32
    handler(value: i32) -> i32
}

func twice(value: i32) -> i32 {
    return value * 2
}

var doublers: Ffi_Table[Doubler] = (slots = new[List[Doubler?]](), free = new[List[int]](),
                                    owners = new[List[uint]]())

func dispatch_doubler(handle: u64, arguments: uint, result: uint) -> i32 {
    let doubler = __ffi_table_get(doublers, handle)
    if doubler == nil {
        return -1
    }
    dispatch.write_int_raw(result, doubler.call(dispatch.read_int_raw(arguments)))
    return 0
}

comptime {} else {
    let handle = __ffi_table_insert(doublers, callback[Doubler](ref twice))
    require dispatch.fire_raw(handle, 21) == 42
    __ffi_table_free(doublers, handle)
    require dispatch.fire_raw(handle, 21) == -200
    let again = __ffi_table_insert(doublers, callback[Doubler](ref twice))
    require again == handle
    require dispatch.fire_raw(again, 5) == 10
    __fd_write(2, "ok\n")
}
