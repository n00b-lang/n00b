const hooks = [-
library hooks

callback Hook = fn(context: *void userdata, value: c_int) -> c_int
  thread same

fn hook_subscribe(hook: keep Hook until hook_unsubscribe(ret), context: ?void userdata hook) -> u64
fn hook_fire(value: c_int) -> c_int
fn hook_unsubscribe(id: u64)
-]'ffi

func triple(value: i32) -> i32 {
    return value * 3
}

comptime {} else {
    let id = hooks.hook_subscribe(callback[hooks.Hook](ref triple))
    try {
        require hooks.hook_fire(5) == 15
        require hooks.hook_fire(-2) == -6
        hooks.hook_unsubscribe(id)!
        require hooks.hook_fire(1) == -1
    } else failure {
        require false
    }
}
