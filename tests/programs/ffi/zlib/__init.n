[-
use <zlib.writ>

binding {
    name compress2 "compress"
    hide "zlibVersion"
    hide "deflateInit_"
    hide "inflateInit_"
    type z_stream as "Stream"
    method z_stream.deflate = deflate
    method z_stream.inflate = inflate
}
-]'ffi

package zlib {
    export Stream
    export Deflate_Outcome
    export Inflate_Outcome
    export ZLIB_VERSION
    export Z_OK
    export Z_STREAM_END
    export Z_BUF_ERROR
    export Z_FINISH
    export Z_NO_FLUSH
    export Z_DEFAULT_COMPRESSION
    export deflate
    export deflate_end
    export inflate
    export inflate_end
    export compress
    export compress_bound
    export uncompress
    export adler32
    export crc32
    export deflate_init
    export inflate_init
}
