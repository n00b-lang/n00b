func trip(depth: i32) -> i32 {
    if depth > 0 {
        panic("tripped")
    }
    return depth
}

[-
library trip

fn trip(depth: c_int) -> c_int
  symbol "trip_entry"
  thread main

binding export {
    provide trip = "trip_serve.trip"
    header "trip.h"
}
-]'ffi

[-
library client

fn trip_client_run() -> c_int

binding {
    raw "trip_client_run"
}
-]'ffi

require trip_client_run_raw() == 0
