const sorter = [-
library sorter

callback Compare = fn(a: *void, b: *void) -> c_int
  thread same

fn nth_sorted(items: *[u8; count], count: usize, n: usize, compare: Compare for call) -> c_int
fn byte_at(address: usize) -> u8

binding {
    provide nth_sorted.compare = "sort_calls.descending"
    raw "byte_at"
}
-]'ffi

func descending(a: uint, b: uint) -> i32 {
    return cast[i32]sorter.byte_at_raw(b) - cast[i32]sorter.byte_at_raw(a)
}

let items: Array[u8] = [3, 9, 1, 7]
try {
    require sorter.nth_sorted(items, 0)! == 9
    require sorter.nth_sorted(items, 1)! == 7
    require sorter.nth_sorted(items, 3)! == 1
} else failure {
    require false
}
