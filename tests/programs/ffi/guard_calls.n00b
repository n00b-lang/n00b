const guard = [-
library guard

callback Compute = fn(value: c_int) -> c_int
  thread same

fn guarded_call(compute: Compute for call, value: c_int) -> c_int

binding {
    provide guarded_call.compute = "guard_calls.checked_double"
}
-]'ffi

func checked_double(value: i32) -> i32 {
    if value < 0 {
        panic("negative input")
    }
    return value * 2
}

require guard.guarded_call(21) == 42
require guard.guarded_call(-1) == -1000
require guard.guarded_call(5) == 10
__fd_write(2, "recovered\n")
