const bake = [-
use <bake.writ>
-]'ffi

func fixup(modify self: bake.Bake_Root_T) -> nil fail: string {
    self.cache = 0
    let path: string? = foreign_text(self.path)
    if path == nil {
        fail "the baked graph has no path"
    }
    var fd: i32 = -1
    try {
        fd = bake.bake_open(path.get())!
    } else failure {
        fail "the baked spec file cannot be opened"
    }
    if fd < 0 {
        fail "the baked spec file cannot be reopened"
    }
    self.fd = fd
}

func build_graph() -> bake.Bake_Root {
    var root: bake.Bake_Root? = nil
    try {
        root = bake.bake_build("bake_spec.txt")!
    } else failure {
        panic("bake_build failed")
    }
    require root != nil
    require bake.bake_query(root.get(), 8) == 1
    require bake.bake_query(root.get(), 8) == 2
    return root.get()
}

const graph = build_graph()

func reopen() -> string? {
    try {
        let status = bake.bake_reopen(graph)!
    } else failure {
        return failure.text
    }
    return nil
}

func start() -> nil {
    let missing: string? = reopen()
    require missing != nil
    require missing.get() == "the baked spec file cannot be reopened"
    try {
        let written = bake.bake_touch("bake_spec.txt", "Zbake spec")!
    } else failure {
        panic("bake_touch failed")
    }
    require reopen() == nil
    require bake.bake_query(graph, 0) == 11
    require bake.bake_query(graph, 1) == 100
    require bake.bake_query(graph, 2) == 3
    require bake.bake_query(graph, 3) == 42
    require bake.bake_query(graph, 4) == 1
    require bake.bake_query(graph, 5) == 2
    require bake.bake_query(graph, 6) == 42
    require bake.bake_query(graph, 7) == 40
    require bake.bake_query(graph, 8) == 1
    require bake.bake_query(graph, 9) == 90
    var handle: bake.Bake_Root = graph
    try {
        bake.close(handle)!
        require false
    } else failure {
        require failure.text != nil
        require failure.text.get() == "a baked object cannot be released"
    }
    require bake.bake_query(graph, 8) == 2
    __fd_write(2, "baked ok\n")
}
