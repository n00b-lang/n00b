const bake = [-
use <bake.writ>
-]'ffi

func start() -> nil {
    var root: bake.Bake_Root? = nil
    try {
        root = bake.bake_build("bake_spec.txt")!
    } else failure {
        panic("bake_build failed")
    }
    require root != nil
    var graph: bake.Bake_Root = root.get()
    require bake.bake_query(graph, 0) == 11
    require bake.bake_query(graph, 1) == 100
    require bake.bake_query(graph, 2) == 3
    require bake.bake_query(graph, 3) == 42
    require bake.bake_query(graph, 4) == 1
    require bake.bake_query(graph, 5) == 2
    require bake.bake_query(graph, 6) == 42
    require bake.bake_query(graph, 7) == 40
    require bake.bake_query(graph, 8) == 1
    require bake.bake_query(graph, 9) == 90
    try {
        bake.close(graph)!
    } else failure {
        panic("closing a run-time graph failed")
    }
    __fd_write(2, "runtime ok\n")
}
