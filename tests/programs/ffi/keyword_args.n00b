const kw = [-
library keywords

opaque db_state
handle Db = *db_state release db_close

keywords OpenOpts presence mask(present) {
    present:    u32
    timeout_ms: u32  = 30000
    readonly:   bool = false
    cache_kb:   u32
}

keywords Limits presence sentinel {
    max_rows: i64 = -1 none -1
    min_rows: i64 none -1
}

keywords Sized presence size(size) {
    size:  u32
    flags: u32 = 4
}

keywords Plain presence always {
    depth: c_int = 3
}

fn db_open(path: *cstr, opts: ?OpenOpts) -> own ?Db release db_close
  pack keywords opts
fn db_present(db: Db) -> u32
fn db_timeout(db: Db) -> u32
fn db_cache(db: Db) -> u32
fn db_limit(db: Db, limits: *Limits) -> i64
  pack keywords limits
fn db_flags(db: Db, sized: *Sized) -> u32
  pack keywords sized
fn db_depth(db: Db, plain: *Plain) -> c_int
  pack keywords plain
fn db_close(db: consume ?Db)

binding {
    keywords Limits as record
}
-]'ffi

try {
    var defaults = kw.db_open("defaults")!
    require kw.db_present(defaults) == 0
    require kw.db_timeout(defaults) == 30000
    var tuned = kw.db_open("tuned", timeout_ms = 5, cache_kb = 64)!
    require kw.db_present(tuned) == 5
    require kw.db_timeout(tuned) == 5
    require kw.db_cache(tuned) == 64
    require kw.db_flags(tuned) == 804
    require kw.db_flags(tuned, flags = 9) == 809
    require kw.db_depth(tuned) == 3
    require kw.db_depth(tuned, depth = 7) == 7
    let limits: kw.Db_Limit_Options = (max_rows = 50, min_rows = nil)
    require kw.db_limit(tuned, limits) == 49999
    kw.close(defaults)!
    kw.close(tuned)!
} else failure {
    require false
}
