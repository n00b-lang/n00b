import zlib
import archive.zlib

let text: Array[u8] = [120, 121, 122, 120, 121, 122]
var packed: Array[u8] = []
try {
    packed = zlib.compress(text, 1)!
} fail(failure) {
    require false
}
try {
    let unpacked = archive.zlib.uncompress(16, packed)!
    require __array_length(unpacked) == 6
    require unpacked[0] == 120
    require unpacked[5] == 122
} fail(failure) {
    require false
}
try {
    packed = archive.zlib.compress(text, 9)!
} fail(failure) {
    require false
}
try {
    let unpacked = zlib.uncompress(64, packed)!
    require __array_length(unpacked) == __array_length(text)
    require unpacked[2] == 122
} fail(failure) {
    require false
}
try {
    zlib.uncompress(2, packed)!
    require false
} fail(failure) {
    require failure.code == -5
    require failure.fn == "uncompress"
}
