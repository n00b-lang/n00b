# Two 'ffi literals declare the C function `abs` with different effects. The
# analysis knows a C function by its symbol, so they must agree: this is
# rejected rather than taking whichever declaration came first.
[-
library c
link "c"
fn abs(x: c_int) -> c_int
  effects none
binding {
    raw "abs"
}
-]'ffi

[-
library c_again
link "c"
fn abs(x: c_int) -> c_int
  effects input
binding {
    raw "abs"
}
-]'ffi

require abs_raw(-1) == 1
