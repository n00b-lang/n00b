const base = 36
const tmin = 1
const tmax = 26
const width = 4
const height = 8
const area = width * height
const mask = (1 << 4) - 1

func threshold(d: i32) -> bool {
    return d > ((base - tmin) * tmax) / 2
}

func narrow(x: u8) -> u8 {
    return x
}

func signed16(x: i16) -> i16 {
    return x
}

func wide(x: u64) -> u64 {
    return x
}

func plain(x: int) -> int {
    return x
}

var d: i32 = 455
var small: u8 = 7
let sum: u8 = 200 + 55
let top: u16 = 1 << 15
let low: u32 = 0xff & 0x0f
let quotient: i32 = -7 / 2
let remainder: i32 = -7 % 2
let negated: i16 = -(3 * 100)
let unknown = 2 * 3
var cells: Array[u8][area] = new[Array[u8][area]]()

require !threshold(d)
require threshold(d + 1)
require d == (36 - 1) * 26 / 2
require d < base * tmax - tmin
require narrow(base - tmin) == 35
require narrow(small + 2 * 3) == 13
require signed16(-(tmax * 100)) == -2600
require wide((1 << 40) + base) == 1099511627812
require sum == 255
require top == 32768
require low == 15
require quotient == -3
require remainder == -1
require negated == -300
require plain(unknown) == 6
require narrow(area) == 32
require narrow(mask) == 15
require __array_length(cells) == 32
__fd_write(2, "ok")
