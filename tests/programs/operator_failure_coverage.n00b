type Box {
    value: int
}

var operator_state = 0

func __subtract(left: Box, right: int) -> Box fail: int {
    operator_state = right
    fail right
}
func __multiply(left: Box, right: int) -> Box fail: int { fail right }
func __divide(left: Box, right: int) -> Box fail: int { fail right }
func __remainder(left: Box, right: int) -> Box fail: int { fail right }
func __bit_and(left: Box, right: int) -> Box fail: int { fail right }
func __bit_or(left: Box, right: int) -> Box fail: int { fail right }
func __bit_xor(left: Box, right: int) -> Box fail: int { fail right }
func __shift_left(left: Box, right: int) -> Box fail: int { fail right }
func __shift_right(left: Box, right: int) -> Box fail: int { fail right }
func __negate(item: Box) -> Box fail: int { fail 1 }
func __not(item: Box) -> bool fail: int { fail 1 }
func __cmp(left: Box, right: Box) -> Comparison fail: int { fail 1 }

trait Index_Write {
    func __write(self: `T, index: int, item: int) -> int fail: int
}

func __write(self: Box, index: int, item: int) -> int fail: int { fail item }

func subtract(left: Box, right: int) -> Box fail: int { return left - right }
func multiply(left: Box, right: int) -> Box fail: int { return left * right }
func divide(left: Box, right: int) -> Box fail: int { return left / right }
func remainder(left: Box, right: int) -> Box fail: int { return left % right }
func bit_and(left: Box, right: int) -> Box fail: int { return left & right }
func bit_or(left: Box, right: int) -> Box fail: int { return left | right }
func bit_xor(left: Box, right: int) -> Box fail: int { return left ^ right }
func shift_left(left: Box, right: int) -> Box fail: int { return left << right }
func shift_right(left: Box, right: int) -> Box fail: int { return left >> right }
func negate(item: Box) -> Box fail: int { return -item }
func not(item: Box) -> bool fail: int { return !item }
func less(left: Box, right: Box) -> bool fail: int { return left < right }

func write(item: Box) -> nil fail: int {
    item [0] = 1
}
