import xform

func decode() -> string {
    var bytes: Array[u8] = [104, 195, 169, 108, 108, 111, 32, 116, 104, 101, 114, 101, 32, 108, 111, 110, 103]
    var text: string = ""
    require __string_from_utf8(ref bytes, ref text)
    return text
}

func counted(value: int) -> int {
    __fd_write(2, "")
    return value
}

assert decode() == "héllo there long"
let counted_value: int = xform.apply(callback[xform.Transform](ref counted), 3)
assert counted_value == 3
