# Regression checks for the medium punch-list fixes; run by
# tests/punch_list_medium.sh, which expects exactly `ok` on stderr.

# Assigning a present value to an option variable proves it present where
# only such assignments reach (#7).
func assigned() -> int {
    var x: int? = nil
    x = 9
    return x + 1
}
func assigned_on_both_paths(c: bool) -> int {
    var x: int? = nil
    if c { x = 1 } else { x = 2 }
    return x + 1
}
func assigned_from_parameter(p: int) -> int {
    var x: int? = nil
    x = p
    return x * 2
}
require assigned() == 10
require assigned_on_both_paths(true) == 2
require assigned_on_both_paths(false) == 3
require assigned_from_parameter(4) == 8

# An inferred option is narrowed by a `nil` test like an annotated one (#32).
func inferred_option() -> int {
    let d = {"a": 1}
    let w = d["a"]
    if w != nil {
        return w + 1
    }
    return 0
}
func inferred_option_var() -> int {
    let d = {"a": 1}
    var w = d["a"]
    if w != nil {
        return cast[int](w) + 1
    }
    return 0
}
require inferred_option() == 2 and inferred_option_var() == 2

# A string literal converts to `Array[byte]`, holding its UTF-8 bytes (#4).
let greeting: Array[byte] = "hi"
const hex_digits: Array[byte][16] = "0123456789abcdef"
func byte_count(x: Array[byte]) -> uint {
    return len(x)
}
func accented() -> uint {
    let e: Array[byte] = "é!"
    return len(e)
}
require len(greeting) == 2 and greeting[1] == 0x69
require byte_count("abc") == 3 and hex_digits[15] == 0x66
require accented() == 3

# A `P` passed where a `View[P]` is wanted is viewed in place, as `ref p`
# would be (#8): variables, fields and temporaries alike.
record Style {
    weight: int
}
record Boxed {
    style: Style
}
const plain_style: Style = (weight = 1)
func style_weight(s: View[Style]) -> int {
    return s.__value.weight
}
func make_style(n: int) -> Style {
    return (weight = n)
}
func viewed_local() -> int {
    var s: Style = (weight = 1)
    s.weight = 9
    return style_weight(s)
}
func viewed_field() -> int {
    let b: Boxed = (style = (weight = 4))
    return style_weight(b.style)
}
require style_weight(plain_style) == 1 and style_weight(ref plain_style) == 1
require viewed_local() == 9 and viewed_field() == 4
require style_weight(make_style(7)) == 7

# A value casts to a trait its type implements (#5); the cast checks the
# implementation and keeps the value.
trait Scales {
    func scale(self: 'S, by: int) -> int
}
record Scaled_Box {
    v: int
}
func scale(self: Scaled_Box, by: int) -> int {
    return self.v * by
}
let module_box: Scaled_Box = (v = 3)
let module_scales = cast[Scales](module_box)
func cast_in_function() -> int {
    let b: Scaled_Box = (v = 5)
    let s = cast[Scales](b)
    return s.scale(2)
}
require module_scales.scale(2) == 6 and cast_in_function() == 10

# `+=`, `-=`, `&=` and `|=` on an atomic are one atomic update (#17).
var atomic_total: Atomic[int] = 0
var atomic_flags: Atomic[u8] = 0
func atomic_updates() -> int {
    atomic_total += 10
    atomic_total -= 3
    var local: Atomic[int] = 5
    local += 1
    return __atomic_load(ref atomic_total) + __atomic_load(ref local)
}
func atomic_bits() -> u8 {
    atomic_flags |= 6
    atomic_flags &= 3
    return __atomic_load(ref atomic_flags)
}
require atomic_updates() == 13 and atomic_bits() == 2

# Chained operators in a generic function specialize to primitive
# operations, `i:N` and `u:N` included (#41).
func chained(a: 'T, b: 'T) -> 'T {
    return ((a * b + a - b) / b) % a
}
func flipped_sum(a: 'T, b: 'T) -> 'T {
    return ~(a + b)
}
let chain_i: i:10 = 3
let chain_j: i:10 = 4
let chain_u: u16 = 5
let chain_v: u16 = 2
require chained(chain_i, chain_j) == cast[i:10](2)
require chained(chain_u, chain_v) == 1
require flipped_sum(cast[u:10](1), cast[u:10](2)) == cast[u:10](1020)

# Every trait in `'T: A + B` lends its methods (#26).
trait Named {
    func name(self: 'N) -> string
}
trait Sized {
    func size(self: 'S) -> int
}
record Labeled {
    v: int
}
func name(self: Labeled) -> string {
    return "box"
}
func size(self: Labeled) -> int {
    return self.v
}
func describe(x: 'T) -> int where 'T: Named + Sized {
    return cast[int](len(x.name())) + x.size()
}
require describe(cast[Labeled]((v = 2))) == 5

# With a `__cmp` and no `__equal`, `==` follows `__cmp`; an `__equal` wins
# over it (#26).
record By_Value {
    v: int
    tag: int
}
func __cmp(view a: By_Value, view b: By_Value) -> Comparison {
    if a.v < b.v { return Comparison.less }
    if a.v > b.v { return Comparison.greater }
    return Comparison.equal
}
record By_Tag {
    v: int
    tag: int
}
func __cmp(view a: By_Tag, view b: By_Tag) -> Comparison {
    if a.v < b.v { return Comparison.less }
    if a.v > b.v { return Comparison.greater }
    return Comparison.equal
}
func __equal(view a: By_Tag, view b: By_Tag) -> bool {
    return a.tag == b.tag
}
let value_one: By_Value = (v = 1, tag = 1)
let value_two: By_Value = (v = 1, tag = 2)
require value_one == value_two and !(value_one != value_two)
let tag_one: By_Tag = (v = 1, tag = 1)
let tag_two: By_Tag = (v = 1, tag = 2)
let tag_three: By_Tag = (v = 5, tag = 1)
require !(tag_one == tag_two) and tag_one == tag_three and tag_one < tag_three

# With no `fail:` clause, a function's failure type is inferred from its
# body, mutual recursion included (#9).
func parsed(x: int) -> int {
    if x < 0 {
        fail "negative"
    }
    return x
}
func parsed_untyped(x: int) {
    if x < 0 {
        fail "negative"
    }
    return x
}
func count_down(n: int) -> int {
    if n < 0 {
        fail "below zero"
    }
    if n == 0 {
        return 0
    }
    return count_other(n - 2)!
}
func count_other(n: int) -> int {
    return count_down(n)!
}
func or_minus_one(x: int) -> int {
    return try { -> parsed(x)! } fail (e) { -> -1 }
}
func untyped_or_minus_one(x: int) -> int {
    return try { -> parsed_untyped(x)! } fail (e) { -> -1 }
}
func counted_or_minus_one(n: int) -> int {
    return try { -> count_other(n)! } fail (e) { -> -1 }
}
require or_minus_one(3) == 3 and or_minus_one(-1) == -1
require untyped_or_minus_one(3) == 3 and untyped_or_minus_one(-1) == -1
require counted_or_minus_one(4) == 0 and counted_or_minus_one(3) == -1

# Type testing (#16): `typecase` on an option tests whether it holds a
# value; a type named where a value goes is its `typespec`; `typeof`
# results compare, at module level too; `has_type` tests a value's type
# and narrows it in the `if` it guards.
func option_kind(x: int?) -> int {
    typecase x {
        case nil { return 0 }
        case int { return x * 2 }
    }
}
record Spot {
    x: int
}
let spec: typespec = int
let declared_int: int = 3
let a_spot: Spot = (x = 1)
require option_kind(2) == 4 and option_kind(nil) == 0
require typeof(declared_int) == spec and typeof(declared_int) != string
require typeof(a_spot) == Spot
func boxed_kind(v: Any) -> typespec {
    return typeof(v)
}
require boxed_kind(cast[Any] "s") == string
func plus_one(x: Any) -> int {
    if has_type(x, int) {
        return x + 1
    }
    return 0
}
func describe_any(x: Any) -> string {
    if has_type(x, string) {
        return x + "!"
    } elif has_type(x, int) {
        return "number"
    }
    return "other"
}
require plus_one(cast[Any] declared_int) == 4 and plus_one(cast[Any] "a") == 0
require describe_any(cast[Any] "hi") == "hi!"
require describe_any(cast[Any] declared_int) == "number"

# `typespec[T]` writes any type as a value; `has_type` also takes a
# `typespec` held in a variable, a trait included, and checks it at run
# time; assigning a narrowed variable ends its narrowing.
let maybe_int: int? = 3
let some_names: List[string] = ["a"]
require typeof(maybe_int) == typespec[int?]
require typeof(some_names) == typespec[List[string]]
require typespec[int] == int and typespec[int] != typespec[u8]
func matches(x: Any, t: typespec) -> bool {
    return has_type(x, t)
}
require matches(cast[Any] declared_int, int)
require !matches(cast[Any] declared_int, string)
require matches(cast[Any] module_box, Scaled_Box)
require matches(cast[Any] module_box, Scales)
require !matches(cast[Any] declared_int, Scales)
func reassigned(start: Any) -> string {
    var x: Any = start
    if has_type(x, int) {
        x = cast[Any] "changed"
        if has_type(x, string) {
            return x
        }
        return "stale"
    }
    return "not int"
}
require reassigned(cast[Any] declared_int) == "changed"

# A declared union return takes any of its members, literals included.
func int_or_string(flag: bool) -> int | string {
    if flag {
        return 3
    }
    return "three"
}
func union_kind(flag: bool) -> string {
    let x = int_or_string(flag)
    typecase x {
        case int { return "int" }
        case string { return x }
    }
}
require union_kind(true) == "int" and union_kind(false) == "three"

# A `case` naming several types matches a value of any of them, whether
# the subject is `Any`, a generic, or a union, and whether the named types
# are closed or generic.
func several_any(b: Any) -> string {
    typecase b {
        case string, int { return "several" }
        case float { return "float" }
        else { return "other" }
    }
}
func several_sequences(b: Any) -> int {
    return typecase b {
        case bool { -> 1 }
        case Array['T], List['T] { -> 2 }
        else { -> 0 }
    }
}
func several_generic(x: 'T) -> string {
    typecase x {
        case int, string { return "several" }
        else { return "other" }
    }
}
func three_way(n: int) -> int | string | float {
    if n == 0 { return 1 }
    if n == 1 { return "s" }
    return 1.5
}
func several_union(n: int) -> string {
    let x = three_way(n)
    typecase x {
        case int, string { return "several" }
        case float { return "float" }
    }
}
let several_float: float = 1.5
let several_array: Array[int] = [1, 2]
let several_list: List[int] = [1, 2]
require several_any(cast[Any] declared_int) == "several"
require several_any(cast[Any] "s") == "several"
require several_any(cast[Any] several_float) == "float"
require several_any(cast[Any] true) == "other"
require several_sequences(cast[Any] several_array) == 2
require several_sequences(cast[Any] several_list) == 2
require several_sequences(cast[Any] true) == 1
require several_sequences(cast[Any] declared_int) == 0
require several_generic(declared_int) == "several"
require several_generic("s") == "several"
require several_generic(several_float) == "other"
require several_union(0) == "several" and several_union(1) == "several"
require several_union(2) == "float"

# An `Any` holding an option matches a generic option arm, which narrows
# it to an option.
func option_arm(b: Any) -> string {
    typecase b {
        case Array['T] { return "array" }
        case List['T]? { return "list option" }
        case 'T? {
            if b == nil {
                return "nil"
            }
            return "some"
        }
        else { return "other" }
    }
}
let held_option: int? = 4
let empty_option: string? = nil
let listed_option: List[int]? = [1]
let small_option: bool? = true
let small_nil: u8? = nil
require option_arm(cast[Any] held_option) == "some"
require option_arm(cast[Any] small_option) == "some"
require option_arm(cast[Any] small_nil) == "nil"
require option_arm(cast[Any] empty_option) == "nil"
require option_arm(cast[Any] listed_option) == "list option"
require option_arm(cast[Any] several_array) == "array"
require option_arm(cast[Any] several_list) == "other"

# A module-scope `typecase` narrows a module variable in its arms, as one
# in a function does; an assignment in an arm writes the variable itself.
var module_held: Any = cast[Any] "hi"
var module_seen: string = ""
typecase module_held {
    case int { module_seen = "int" }
    case string { module_seen = module_held + "!" }
    else { module_seen = "other" }
}
require module_seen == "hi!"
module_held = cast[Any] declared_int
typecase module_held {
    case int {
        require module_held * 2 == 6
        module_held = cast[Any] "back"
    }
    else { require false }
}
func read_module_held() -> Any {
    return module_held
}
typecase module_held {
    case string {
        let again = read_module_held()
        typecase again {
            case string { require again == module_held }
            else { require false }
        }
    }
    else { require false }
}

# A module variable's declaration initializer reruns at run time, so a
# value comptime writes after it doesn't carry over (#13).
var comptime_counter: int = 0
if comptime() {
    comptime_counter = 42
}
var runtime_bumped: int = 0
runtime_bumped += 1
var rewritten_at_runtime: int = 0
if comptime() {
    rewritten_at_runtime = 5
}
rewritten_at_runtime += 1
func comptime_values() -> int {
    let tens: int = runtime_bumped * 10 + rewritten_at_runtime
    return comptime_counter * 100 + tens
}
if !comptime() {
    require comptime_values() == 0 + 10 + 1
}

# A trait method declared `fail: 'F` may be implemented by a method that
# can fail and by one that cannot; a generic caller works with either.
# Keyword parameters, generic ones included, pass through a trait call,
# given or omitted. A result typed by the trait (`'V`) takes the bound
# method's type.
trait Opener {
    func opened(self: 'T) -> 'V fail: 'F
    func closed(self: 'T, value: 'V, note: 'E? = nil) -> int fail: 'G
}
record Calm {
    n: int
}
func opened(self: Calm) -> int { return self.n }
func closed(self: Calm, value: int, note: 'E? = nil) -> int {
    if note == nil { return value }
    return value * 10
}
record Jumpy {
    n: int
}
func opened(self: Jumpy) -> int fail: string {
    if self.n > 5 { fail "jumpy" }
    return self.n
}
func closed(self: Jumpy, value: int, note: 'E? = nil) -> int
        fail: string {
    if value > 4 { fail "late" }
    if note == nil { return value }
    return value * 100
}
func open_and_close(o: 'O) -> int fail: string where 'O: Opener {
    let v = o.opened()!
    let note: string? = "x"
    return o.closed(v)! + o.closed(v, note = note)!
}
func opened_only(o: 'O) -> int fail: string where 'O: Opener {
    let v = o.opened()!
    return 0
}
// A plain value is passed where the trait's parameter is an option.
func closed_plainly(o: 'O) -> int fail: string where 'O: Opener {
    let note: int? = 4
    return o.closed(o.opened()!, note = note)!
}

if !comptime() {
    let calm: Calm = (n = 2)
    let jumpy: Jumpy = (n = 3)
    require (try { -> open_and_close(calm)! } fail (e) { -> -1 }) == 22
    require (try { -> open_and_close(jumpy)! } fail (e) { -> -1 }) == 303
    let wild: Jumpy = (n = 9)
    require (try { -> open_and_close(wild)! } fail (e) { -> -1 }) == -1
    require (try { -> opened_only(jumpy)! } fail (e) { -> -1 }) == 0
    require (try { -> closed_plainly(calm)! } fail (e) { -> -1 }) == 20
}

# `with` uses a manager's `Context_Manager` methods: `__enter` runs before the
# block and what it returns is bound; `__exit` runs on every way out of the
# block, given that value and, when the block failed, the failure as
# `failure`. An `__exit` that returns a `bool` drops the failure by returning
# `true`; one that returns nothing never drops one. Either hook may fail.
# Managers are entered left to right and left in reverse. The manager's
# type need not be known until typing.
var with_log: string = ""

record Tag {
    name: string
}
func tag_named(name: string) -> Tag { return (name = name) }
func __enter(self: Tag) -> string {
    with_log = with_log + "+" + self.name
    return self.name + "!"
}
func __exit(self: Tag, value: string, failure: 'E? = nil) {
    require value == self.name + "!"
    with_log = with_log + "-" + self.name
}

record Eater {
    name: string
}
func eater(name: string) -> Eater { return (name = name) }
func __enter(self: Eater) { with_log = with_log + "+" + self.name }
func __exit(self: Eater, value: nil, failure: 'E? = nil) -> bool {
    with_log = with_log + "-" + self.name
    return failure != nil
}

record Gate {
    name: string
    open: bool
}
func gate(name: string, open: bool) -> Gate {
    return (name = name, open = open)
}
func __enter(self: Gate) fail: string {
    if not self.open { fail "shut " + self.name }
    with_log = with_log + "+" + self.name
}
func __exit(self: Gate, value: nil, failure: 'E? = nil) fail: string {
    with_log = with_log + "-" + self.name
    if self.name == "bad" { fail "exit " + self.name }
}

record Held {
    item: 'T
}
func held(item: 'T) -> Held['T] { return (item = item) }
func __enter(self: Held['T]) -> 'T { return self.item }
func __exit(self: Held['T], value: 'T, failure: 'E? = nil) {
    with_log = with_log + "-box"
}

object Visits {
    n: int
}
func __enter(self: Visits) { self.n = self.n + 1 }
func __exit(self: Visits, value: nil, failure: 'E? = nil) {
    self.n = self.n + 10
}

func visits() {
    return new[Visits]()
}

func entered_twice(manager: 'C) where 'C: Context_Manager {
    with manager {
        with manager {
            with_log = with_log + "[]"
        }
    }
}

func with_bound() -> string {
    with t = tag_named("a"), tag_named("b") {
        with_log = with_log + "[" + t + "]"
    }
    return with_log
}
func with_return(x: int) -> int {
    with tag_named("r") {
        if x > 0 { return 1 }
    }
    return 0
}
func with_failing() -> int fail: string {
    with tag_named("f") {
        fail "boom"
    }
    return 0
}
func with_swallowed() -> int fail: string {
    with eater("eat") {
        fail "boom"
    }
    return 7
}
func with_enter_fails() -> int fail: string {
    with gate("a", true), gate("b", false) {
        with_log = with_log + "body"
    }
    return 0
}
func with_exit_fails() -> int fail: string {
    with gate("a", true), gate("bad", true) {
        with_log = with_log + "body"
    }
    return 0
}
func with_loop() -> int {
    var total = 0
    for i in [1, 2, 3] {
        with item = held(i) {
            if item == 2 { continue }
            total = total + item
        }
    }
    return total
}
// A `with` outside a `try` may fail, like a `!`: with no `fail:`, the
// function fails as its managers do. (`with_bound`, whose managers can't
// fail, is called plainly.)
func gated_value(open: bool) -> int {
    with gate("g", open) { return 1 }
    return 0
}
// Inside a `try`, the managers' failures are the `try`'s to handle.
func gated_or(open: bool) -> int {
    try {
        with gate("t", open) { return 1 }
    } fail (e) { return -1 }
    return 0
}

// A loop over a container calls `__cleanup` once on every way out.
record Countdown {
    from: int
}
record Countdown_Cursor {
    left: int
}
func countdown(from: int) -> Countdown { return (from = from) }
func __iterator(self: Countdown) -> Countdown_Cursor {
    return (left = self.from)
}
func __next(modify self: Countdown_Cursor) -> int? {
    if self.left == 0 { return nil }
    self.left = self.left - 1
    return self.left + 1
}
func __cleanup(consume self: Countdown_Cursor) {
    with_log = with_log + "c"
}
func loop_sum() -> int {
    var total = 0
    for i in countdown(3) {
        if i == 2 { continue }
        total = total + i
    }
    return total
}
func loop_break() -> int {
    var last = 0
    for i in countdown(5) {
        last = i
        if i == 3 { break }
    }
    return last
}
func loop_return() -> int {
    for i in countdown(5) {
        if i == 4 { return i * 10 }
    }
    return 0
}
func loop_fails() -> int fail: string {
    for i in countdown(3) {
        if i == 2 { fail "two" }
    }
    return 0
}
func loop_caught() -> int {
    try {
        for i in countdown(3) {
            if i == 1 { fail "one" }
        }
    } fail (e) { return -1 }
    return 0
}
func loop_managed() -> int {
    for i in countdown(3) {
        with tag_named("m") {
            if i == 2 { return i }
        }
    }
    return 0
}
func managed_loop() -> int fail: string {
    with tag_named("o") {
        for i in countdown(2) {
            fail "out"
        }
    }
    return 0
}
func switch_break(x: int) -> int {
    var seen = 0
    switch x {
        case 1 {
            with tag_named("s") {
                seen = 1
                break
            }
        }
    }
    return seen
}
// A `with` used as a value is its body's value, once `__exit` has run.
func with_value() -> int {
    let v = with t = tag_named("v") { -> t.byte_len() * 10 }
    return v
}
// A function with a `with` may fail as its managers do; these can't, so a
// call to it is a plain value, bound and used like any other.
func with_value_bound() -> int {
    let v = with_value()
    return v + 1
}
func with_values_in_block() -> string {
    let v = {
        with_log = with_log + "<"
        -> with a = tag_named("a"), b = tag_named("bb") { -> a + b }
    }
    return v
}
func with_value_looped() -> int {
    var total = 0
    for i in countdown(3) {
        total = total + with tag_named("l") { -> i }
    }
    return total
}
// When its body fails it has no value, and the failure goes on, after
// `__exit` has run.
func with_value_failing() -> int fail: string {
    return with tag_named("f") { -> risky(quiet_four())! }
}
func quiet_four() -> Quiet_Four { return (n = 4) }
record Quiet_Four {
    n: int
}
func risky(self: Quiet_Four) -> int fail: string {
    if self.n > 3 { fail "four" }
    return self.n
}
// A `break` leaves the innermost loop or `switch`, here the loop.
func loop_in_switch(x: int) -> int {
    var n = 0
    switch x {
        case 1 {
            for i in countdown(3) {
                if i == 2 { break }
                n = n + i
            }
            n = n + 100
        }
    }
    return n
}

