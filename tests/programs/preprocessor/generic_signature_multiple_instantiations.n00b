func generic_identity(item: `T) -> `T {
    return item
}

trait ReturnsArgument {
    func echo(self: `T, input_ref: `R) -> `R
}

func echo(self: int, input_ref) {
    return input_ref
}

func generic_echo(item: `T, input_ref: `R) -> `R where `T: ReturnsArgument {
    return item.echo(input_ref)
}

func use_two_instantiations() {
    var first = generic_identity(1)
    var second = generic_identity("text")
    var int_target = 1
    var string_target = "text"
    var first_reference = generic_echo(1, ref int_target)
    var second_reference = generic_echo(1, ref string_target)
}
