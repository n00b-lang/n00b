func lower_array_values() -> Array[int] {
    var values: Array[int] = [10, 20, 30]
    return values
}
func lower_empty_array() -> Array[int] {
    var values: Array[int] = []
    return values
}

func lower_tagged_array() -> Array[int] {
    var values: Array[int] = array[10, 20]
    return values
}

func lower_short_tagged_array() -> Array[int] {
    var values: Array[int] = a[30, 40]
    return values
}
