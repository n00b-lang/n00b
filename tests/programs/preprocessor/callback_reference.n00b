func increment(value: int) -> int {
    return value + 1
}

func invoke(function_ref: Ref[(int) -> int], value: int) -> int {
    return function_ref.call(value)
}

func exercise_callback(value: int) -> int {
    let function_ref: Ref[(int) -> int] = ref increment
    return function_ref.call(value)
}
