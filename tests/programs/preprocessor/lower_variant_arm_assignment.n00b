type NumberPayload {
    amount: int
}

func __init(modify self: NumberPayload, amount: int) {
    self.amount = amount
}

variant AssignmentValue {
    number: NumberPayload
    empty: nil
}

func construct_number() -> AssignmentValue {
    var item: AssignmentValue = new[AssignmentValue]()
    item.number = (amount = 42)
    return item
}

func construct_number_with_constructor() -> AssignmentValue {
    var item: AssignmentValue = new[AssignmentValue]()
    item.number = new[NumberPayload](42)
    return item
}

func construct_empty() -> AssignmentValue {
    var item: AssignmentValue = new[AssignmentValue]()
    item.empty = nil
    return item
}
