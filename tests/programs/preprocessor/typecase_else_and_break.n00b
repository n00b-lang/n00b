func typecase_else(item: any) -> int {
    typecase(item) {
        case int { return item }
        else { return 0 }
    }
}
func typecase_break(item: (int | string)) -> int {
    var result: int = 0
    typecase(item) {
        case int { result = 1; break }
        case string { result = 2 }
    }
    return result
}
