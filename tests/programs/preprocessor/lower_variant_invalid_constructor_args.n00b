type ConstructorPayload {
    amount: int
}

func __init(modify self: ConstructorPayload, amount: int) {
    self.amount = amount
}

variant InvalidConstructorValue {
    payload: ConstructorPayload
}

func invalid_constructor_args() -> InvalidConstructorValue {
    var item: InvalidConstructorValue = new[InvalidConstructorValue]()
    item.payload = new[ConstructorPayload]()
    return item
}
