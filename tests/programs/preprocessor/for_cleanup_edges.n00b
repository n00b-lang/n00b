var next_item: int?
public func iter(self: int) -> string { return "cursor" }
public func next(modify self: string) -> int? { return next_item }
public func cleanup(self: string) { }

public func iter(self: bool) -> bool { return self }
public func next(modify self: bool) -> int? fail: int {
    fail 7
}
public func cleanup(self: bool) { }

public func iter(self: float) -> float fail: int { fail 5 }
public func next(modify self: float) -> int? { return next_item }
public func cleanup(self: float) { }

func fail_body() -> nil fail: int { fail 9 }

context LoopRecorder() {
    enter() {}
    exit() {}
    ensure() {}
}

func break_loop(items: int) {
    for item in items { break }
}

func continue_loop(items: int) {
    for item in items { continue }
}

func return_loop(items: int) -> int {
    for item in items { return item }
    return 0
}

func body_failure(items: int) -> nil fail: int {
    for item in items { fail_body()! }
}

func next_failure(items: bool) -> nil fail: int {
    for item in items { item }
}

func iter_failure(items: float) -> nil fail: int {
    for item in items { item }
}

func nested_break(outer_items: int, inner_items: int) {
    outer: for outer_item in outer_items {
        for inner_item in inner_items { break outer }
    }
}

func nested_continue(outer_items: int, inner_items: int) {
    outer: for outer_item in outer_items {
        for inner_item in inner_items { continue outer }
    }
}

func context_inside_loop(items: int) -> int {
    for item in items {
        with LoopRecorder() { return item }
    }
    return 0
}

func loop_inside_context(items: int) -> int {
    with LoopRecorder() {
        for item in items { return item }
    }
    return 0
}

func context_inside_loop_failure(items: int) -> nil fail: int {
    for item in items {
        with LoopRecorder() { fail_body()! }
    }
}
