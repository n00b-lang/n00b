import return_alias_mismatch_b

public func from_a(first, second, again: bool) {
    if again { return return_alias_mismatch_b.from_b(first, second, false) }
    else { return first }
}

func use_mismatch() {
    var first_target: int = 1
    var second_target: int = 2
    var result = from_a(ref first_target, ref second_target, true)
}
