func context_default_pair(first: int, second: int) -> int {
    return first * 10 + second
}

func context_default_independent() -> int { return 2 }
func context_default_c(later: int) -> int { return later + 1 }
func context_default_d() -> int { return 4 }

context DepthFirstContext(
    first: int = context_default_pair(c, d),
    independent: int = context_default_independent(),
    c: int = context_default_c(d),
    d: int = context_default_d()) provides: int {
    enter() { return first + independent + c + d }
}

func context_default_depth_first() -> int {
    with result_value = DepthFirstContext() {
        return result_value
    }
}
