type Tiny {
    value: byte
}

variant Choice {
    first: byte
    second: bool
}

func atom_record(value: Atomic[Tiny]) -> Atomic[Tiny] {
    return value
}

func atom_variant(value: Atomic[Choice]) -> Atomic[Choice] {
    return value
}

type Wide {
    first: int
    second: int
}

type Holder {
    link: Ref[Wide]
}

func atom_holder(value: Atomic[Holder]) -> Atomic[Holder] {
    return value
}
