type AuditRecord {
    never_set: int
    read_only: int
    write_only: int
    used: int
}

func write_fields(item: AuditRecord) {
    item.write_only = 1
    item.used = 1
}

func read_used(item: AuditRecord) -> int {
    return item.used
}

func read_only_field(item: AuditRecord) -> int {
    return item.read_only
}

func called() {}

func root(item: AuditRecord) {
    write_fields(item)
    read_used(item)
    read_only_field(item)
    called()
}

func orphan() {}
