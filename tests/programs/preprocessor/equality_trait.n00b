type Meter {
    amount: int
}

type Length {
    amount: int
}

func __equal(left: Meter, right: Meter) -> bool {
    return true
}

func __cmp(left: Length, right: Length) -> Comparison {
    return Comparison.equal
}

func equal_meter(left: Meter, right: Meter) -> bool {
    return left == right
}

func unequal_meter(left: Meter, right: Meter) -> bool {
    return left != right
}

func equal_length(left: Length, right: Length) -> bool {
    return left == right
}

func unequal_length(left: Length, right: Length) -> bool {
    return left != right
}
