context DefaultedContext(base: int, middle: int = base + 1,
                         final: int = middle + 1) provides: int {
    enter() { return final }
    ensure(guard) {}
}

func context_default_chain() -> int {
    with result_value = DefaultedContext(10) {
        return result_value
    }
}

func context_default_override() -> int {
    with result_value = DefaultedContext(10, final = 20) {
        return result_value
    }
}

func context_default_a(item: int) -> int { return item }
func context_default_b() -> int { return 2 }
func context_default_c() -> int { return 3 }

context OrderedContext(a: int = context_default_a(b),
                       b: int = context_default_b(),
                       c: int = context_default_c()) provides: int {
    enter() { return a + b + c }
}

func context_default_order() -> int {
    with result_value = OrderedContext() {
        return result_value
    }
}
