type NamedItem {
    number: int
    label: string
}

var next_named: NamedItem?
var next_ordered: tuple[int, string]?

public func iter(self: int) -> string { return "named" }
public func next(modify self: string) -> NamedItem? { return next_named }
public func cleanup(self: string) { }

public func iter(self: bool) -> bool { return self }
public func next(modify self: bool) -> tuple[int, string]? { return next_ordered }
public func cleanup(self: bool) { }

func named_subset(items: int) {
    for number in items { number + 1 }
}

func named_whole(items: int) {
    for let entry: NamedItem in items { entry.number }
}

func named_implicit_whole(items: int) {
    for entry in items { entry.number }
}

func named_typed(items: int) {
    for let label: string in items { label + "!" }
}

func ordered_destructure(items: bool) {
    for number, label in items {
        number + 1
        label + "!"
    }
}

func explicit_range() {
    for let index: int from 0 until 2 { index + 1 }
}
