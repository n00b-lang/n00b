import generic_trait_specialization

func generic_render(item: 'T) -> int where 'T: generic_trait_specialization.Render {
    var measured = item.measure()
    return item.render()
}

func render_int(item: int) -> int {
    return generic_render(item)
}

func render_label(item: generic_trait_specialization.Label) -> int {
    return generic_render(item)
}
