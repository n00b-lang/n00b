import contract
import int_impl
import label_impl

func generic_render(item: `T) -> int where `T: contract.Render {
    var measured = item.measure()
    return item.render()
}

func render_int(item: int) -> int {
    return generic_render(item)
}

func render_label(item: label_impl.Label) -> int {
    return generic_render(item)
}
