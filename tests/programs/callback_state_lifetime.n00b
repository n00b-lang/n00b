type Callback_State {
    count: int
}

callback Stateful_Callback {
    call(value: int) -> int fail: string
    handler(modify state: Callback_State, value: int) -> int fail: string
    setup(handler: Ref[(modify state: Callback_State, value: int) -> int fail: string],
          state: Ref[Callback_State]) -> nil fail: string
}

func handle(modify state: Callback_State, value: int) -> int fail: string {
    state.count += value
    return state.count
}

func setup(handler: Ref[(modify state: Callback_State, value: int) -> int fail: string],
           state: Ref[Callback_State]) -> nil fail: string {
}

func construct_copy_and_invoke(input: Callback_State,
                               value: int) -> int fail: string {
    var state: Callback_State = input
    var original = callback[Stateful_Callback](ref handle, ref state)!
    var copied = original
    return copied.call(value)!
}
