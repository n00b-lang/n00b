func fill(n: uint) -> uint {
    var cells: Array[uint][n]
    var grid: Array[i32][2][3]
    var bytes: Array[u8][128]
    require cells[n - 1] == 0
    cells[0] = n
    grid[1][2] = 7
    bytes[127] = 1
    require grid[0][0] == 0
    return cells[0] + cast[uint](grid[1][2]) + cast[uint] bytes[127]
}

func assign_once() -> u8 {
    let bytes: Array[u8][4]
    bytes = new[Array[u8][4]]()
    return bytes[2]
}

require fill(4) == 12
require assign_once() == 0

var compound_counts: Array[u32] = new[Array[u32]](4)
var compound_bytes: Array[u8] = new[Array[u8]](4)
var compound_fixed: Array[i16][3] = new[Array[i16][3]]()
let compound_k: u8 = 2
let compound_i: u32 = 1
compound_counts[compound_k] += 1
compound_counts[2] += 4
compound_bytes[compound_i] += 3
compound_bytes[compound_i] |= 8
compound_fixed[0] -= 7
require compound_counts[2] == 5
require compound_bytes[1] == 11
require compound_fixed[0] == -7

record P {
    x: u32
}

var points: Array[P] = new[Array[P]](2)
var field_fixed: Array[P][2] = new[Array[P][2]]()
points[1] = (x = 3)
field_fixed[0] = (x = 1)
points[1].x += 4
points[0] = (x = 0)
points[0].x = 5
field_fixed[0].x *= 6
require points[1].x == 7
require points[0].x == 5
require field_fixed[0].x == 6

var shift_bytes: Array[u8] = new[Array[u8]](4)
var shift_words: Array[u32] = new[Array[u32]](2)
let shift_i: u32 = 1
shift_bytes[shift_i] = 1
shift_bytes[shift_i] = shift_bytes[shift_i] << 2
shift_bytes[shift_i] <<= 1
shift_words[0] = 256
shift_words[0] >>= 4
require shift_bytes[1] == 8
require shift_words[0] == 16

var store_counts: Array[u32] = new[Array[u32]](4)
var store_bytes: Array[u8] = new[Array[u8]](4)
var store_chars: Array[char] = new[Array[char]](4)
store_counts[2] = 1
store_bytes[store_counts[2]] = 9
store_bytes[store_counts[2]] += 1
store_chars[cast[uint] store_counts[2]] = 'x'
require store_bytes[1] == 10
require store_chars[1] == 'x'

func runtime_sized(n: uint) -> u8 {
    let bytes: Array[u8] = new[Array[u8]](n)
    bytes[2] = 3
    bytes[2] += 1
    return bytes[2]
}

func let_fixed() -> u32 {
    let words: Array[u32][4] = new[Array[u32][4]]()
    words[3] = 9
    return words[3]
}

func let_grid() -> i32 {
    let cells: Array[i32][2][3] = new[Array[i32][2][3]]()
    cells[1][2] = 7
    return cells[1][2]
}

func deferred() -> u8 {
    let bytes: Array[u8][4]
    bytes = new[Array[u8][4]]()
    bytes[1] = 5
    return bytes[1]
}

require runtime_sized(4) == 4
require let_fixed() == 9
require let_grid() == 7
require deferred() == 5

func at(value: 'V, index: int) -> byte {
    typecase value {
        case Array[byte] { return value[index] }
        else { return 0 }
    }
}

var typecase_bytes: Array[byte] = new[Array[byte]](2)
typecase_bytes[0] = cast[byte]7
typecase_bytes[1] = cast[byte]9
require at(typecase_bytes, 0) == 7
require at(typecase_bytes, 1) == 9
require at(42, 0) == 0

enum Tc { none = 0, upper }

const enum_fixed: Array[Tc] = [Tc.upper]

func update() -> bool {
    var cases: Array[Tc] = [Tc.none, Tc.upper, Tc.none]
    cases[2] = Tc.upper
    cases[1] = Tc.none
    var flags: Array[bool] = [true, false]
    flags[1] = true
    return cases[2] == Tc.upper and cases[1] == Tc.none and
        cases[0] != Tc.upper and flags[1]
}

require enum_fixed[0] == Tc.upper
require update()

var literal_bytes: List[byte] = []
literal_bytes.append(65)
require literal_bytes[0] == 65
literal_bytes[0] = 72
require literal_bytes[0] == 72

func literal_total(values: Array[u8]) -> uint {
    var sum: uint = 0
    for value in values {
        sum = sum + cast[uint]value
    }
    return sum
}

func listed(values: List[int]) -> uint {
    return values.len()
}

require literal_total([1, 2, 250]) == 253
require literal_total([]) == 0
require listed([1, 2]) == 2

func range_sum(n: uint, m: i32, items: Array[u8]) -> uint {
    var total: uint = 0
    for i from 0 until n step 2 {
        total += i
    }
    var k: i32 = 0
    for j from 0 to m {
        k += j
    }
    for i from 0 until items.len() {
        total += cast[uint] items[i]
    }
    var best: u8 = 0
    for i: u8 from 0 until 6 {
        best = i
    }
    return total + cast[uint](k) + cast[uint] best
}

require range_sum(5, 3, [1, 2]) == 6 + 6 + 3 + 5

func change(modify target: int) -> int {
    target = 10
    return 2
}

func compound() -> int {
    var value = 1
    value += change(value)
    return value
}

var order_total = 1

func order_change() -> int {
    order_total = 10
    return 2
}

func order_compound() -> int {
    order_total += order_change()
    return order_total
}

require compound() == 3
require order_compound() == 3

func shape_extent() -> int {
    return 4
}

record Shaped_Holder {
    cells: Array[int][shape_extent()]
}

var shaped_grid: Array[int][shape_extent()]

// Dimensions without a size are ragged: with no initializer, each of their
// arrays is zero-sized until one is assigned.
var ragged_rows: Array[int][2][]
require ragged_rows.len() == 2 and ragged_rows[0].len() == 0
ragged_rows[1] = [1, 2, 3]
require ragged_rows[1].len() == 3 and ragged_rows[1][2] == 3
require ragged_rows[0].len() == 0

// Rows the same length to start with still stay ragged.
var even_rows: Array[int][2][] = [[1], [2]]
even_rows[1] = [4, 5, 6]
require even_rows[1].len() == 3 and even_rows[0][0] == 1

func ragged_local() -> int {
    var rows: Array[int][2][][]
    let empty = rows[1].len()
    rows[0] = [[1], [2, 3]]
    return empty + rows[0][1][1] + rows[0].len()
}

require ragged_local() == 5

// A ragged array given a literal of rows, inside a function.
func ragged_literal() -> int {
    var rows: Array[int][2][] = [[1], [2]]
    rows[1] = [4, 5, 6]
    var uneven: Array[int][2][] = [[1], [2, 3]]
    return rows[1][2] + rows[0][0] + uneven[1][1] + cast[int](rows.len())
}

require ragged_literal() == 6 + 1 + 3 + 2

// A bounded `let` array gets its storage where it's declared; it is shared,
// so its elements may be set. One assignment may still replace it.
func let_storage() -> int {
    let cells: Array[int][3]
    cells[1] = 4
    let grid: Array[int][2][2]
    grid[1][0] = 2
    return cells[1] + cells[0] + grid[1][0]
}

func let_replaced() -> int {
    let cells: Array[int][3]
    cells = [1, 2, 3]
    return cells[1]
}

require let_storage() == 6
require let_replaced() == 2

// Without an initializer, an array's elements start zeroed, which is a value
// for these.
open enum Zero_Code: i32 { ok = 1, bad = 2 }
enum Zero_Color { red = 0, green = 1 }
flagset Zero_Perm { read, write }

record Zero_Point {
    x: int
    y: int
}

record Zero_Built {
    x: int
}

func __init(modify self: Zero_Built, x: int) {
    self.x = x + 1
}

object Zero_Node {
    v: int
    tags: Array[int][2]
    grid: Array[int][2][3]
}

var zero_codes: Array[Zero_Code][2]
var zero_colors: Array[Zero_Color][2]
var zero_perms: Array[Zero_Perm][2]
var zero_points: Array[Zero_Point][2]
var zero_built: Array[Zero_Built][2]
var zero_text: Array[string][2]
var zero_nodes: Array[Zero_Node][2]
var zero_optional: Array[Zero_Node?][2]
require cast[i32](zero_codes[0]) == 0 and zero_colors[1] == Zero_Color.red
require zero_perms[0] == zero_perms[1] and zero_points[1].y == 0
require zero_built[0].x == 0 and zero_text[1] == "" and zero_optional[0] == nil
zero_nodes[1].tags[0] = 4
require zero_nodes[0].v == 0 and zero_nodes[1].tags[0] == 4
require zero_nodes[0] != zero_nodes[1]

// Each zeroed object is a fresh one; its fixed-size array fields are inline.
func zero_objects() -> int {
    var nodes: Array[Zero_Node][3]
    nodes[1].v = 4
    nodes[2].grid[1][2] = 5
    let made = new[Zero_Node]()
    made.tags = [7, 8]
    let built: Zero_Node = (v = 1, tags = [1, 2],
                            grid = [[1, 2, 3], [4, 5, 6]])
    let tags = made.tags
    return nodes[0].v + nodes[1].v + nodes[2].grid[1][2] + tags[1] + cast[int](made.tags.len()) + built.grid[1][1] + cast[int](made.grid[1].len())
}

require zero_objects() == 0 + 4 + 5 + 8 + 2 + 5 + 3

// A module array sized when the program runs is allocated by its module's
// initializer.
func zero_extent() -> int {
    return 3
}

let runtime_cells: Array[int][zero_extent()]
runtime_cells[1] = 5
let runtime_replaced: Array[int][zero_extent()]
runtime_replaced = [7, 8, 9]
var runtime_grid: Array[int][zero_extent()][2]
runtime_grid[2][1] = 4
require runtime_cells.len() == 3 and runtime_cells[1] == 5
require runtime_replaced[2] == 9 and runtime_grid[2][1] == 4
require runtime_grid[0][0] == 0

// A `let` array without a size takes its length from its assignment; where
// that hasn't run, it holds that many zeroes.
func let_sized(c: bool) -> int {
    let arr: Array[int]
    if c {
        arr = [1, 2, 3]
    }
    return cast[int](arr.len()) + arr[0]
}

require let_sized(false) == 3 and let_sized(true) == 4

// Slices: `:` and `until` exclude the end and `to` includes it; either
// bound may be left out, and negative bounds count from the end. Bounds
// that meet, even at the end, give an empty slice.
var sliced: Array[int] = [10, 20, 30, 40, 50]
let cut = sliced[1:3]
let through = sliced[1 to 3]
let upto = sliced[1 until 3]
let front = sliced[:2]
let back = sliced[3:]
let last_two = sliced[-2:]
let inner = sliced[1:-1]
let from_end = sliced[-3 to -1]
let everything = sliced[:]
require cut.len() == 2 and cut[1] == 30 and through.len() == 3
require through[2] == 40 and upto.len() == 2 and front[1] == 20
require back[0] == 40 and last_two[0] == 40 and inner.len() == 3
require inner[2] == 40 and from_end.len() == 3 and from_end[0] == 30
require everything.len() == 5
require sliced[2:2].len() == 0 and sliced[5:5].len() == 0
// A slice is a copy.
sliced[1] = 99
require cut[0] == 20

func list_slices() -> int {
    var items: List[int] = [1, 2, 3, 4]
    let middle = items[1 to 2]
    let tail = items[-2:]
    items[1:3] = [9]
    items[:1] = [7, 8]
    items[-1:] = [5]
    items[0 to 0] = [6]
    return cast[int](items.len()) * 1000 + items[0] * 100 + items[1] * 10 + items[3] + middle[1] + tail[0]
}

require list_slices() == 4685 + 3 + 3

__fd_write(2, "ok")
