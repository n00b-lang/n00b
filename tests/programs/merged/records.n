record Point {
    x: int
    y: int
}

object Counter {
    count: int
    label: string
}

const ORIGIN: Point = (x = 0, y = 0)

func shift(p: Point) -> Point {
    var moved: Point = p
    moved.x = moved.x + 1
    return moved
}

func bump(c: Counter) {
    c.count = c.count + 1
}

func peek(view c: Counter) -> int {
    return c.count
}

func label_of(view c: Counter) -> string {
    let text: string = c.label
    return text
}

func double_peek(view c: Counter) -> int {
    return peek(c) * 2
}

func pass_back(view c: Counter) -> Counter {
    return c
}

var copied: int = 0

func copy_out(view c: Counter) {
    copied = c.count
}

func grow(modify p: Point) {
    p.y = p.y + 10
}

func replace(modify c: Counter) {
    c = (count = 100, label = "replaced")
}

func make_point(out p: Point) {
    p = (x = 7, y = 8)
}

func take(consume c: Counter) -> int {
    c = (count = c.count + 1000, label = c.label)
    return c.count
}

var first: Point = (x = 1, y = 2)
var second: Point = first
second.x = 50
require first.x == 1 and second.x == 50

let fixed: Point = (x = 3, y = 4)
require shift(fixed).x == 4 and fixed.x == 3

let counter: Counter = (count = 1, label = "c")
let alias_of_counter: Counter = counter
alias_of_counter.count = 5
require counter.count == 5
bump(counter)
require counter.count == 6 and alias_of_counter.count == 6

require peek(counter) == 6 and double_peek(counter) == 12
require label_of(counter) == "c"
require pass_back(counter) == counter
copy_out(counter)
require copied == 6

grow(first)
require first.y == 12

var slot: Counter = counter
replace(slot)
require slot.count == 100 and counter.count == 6

var made: Point
make_point(made)
require made.x == 7 and made.y == 8

let given: Counter = (count = 1, label = "given")
require take(given) == 1001

require ORIGIN.x == 0 and peek(counter) == 6

let items: List[int] = [1, 2]
let shared_items = items
shared_items.append(3)
items[0] = 9
require len(items) == 3 and shared_items[0] == 9

enum Mode {
    a = 0, b = 1, c = 2
}

flagset Perm {
    read, write, exec
}

record Inner {
    on:   bool
    mode: Mode
}

record Packed {
    name:  string
    x:     bool
    mode:  Mode
    small: u:3
    perm:  Perm
    maybe: bool?
    count: int
    inner: Inner
    y:     bool
}

const base: Packed = (name = "base", x = true, mode = Mode.c, small = 5,
                      perm = Perm.write, maybe = false, count = 7,
                      inner = (on = true, mode = Mode.b), y = false)

func flip(modify v: bool) {
    v = !v
}

func set_mode(modify m: Mode) {
    m = Mode.a
}

func check(packed_p: Packed?) -> int {
    if packed_p == nil {
        return 0
    }
    return packed_p.count
}

var packed_p: Packed = base
require packed_p.x
require packed_p.mode == Mode.c
require packed_p.small == 5
require packed_p.perm == Perm.write
require packed_p.maybe != nil
require packed_p.count == 7
require packed_p.inner.on
require packed_p.inner.mode == Mode.b
require !packed_p.y
require packed_p.name == "base"
packed_p.y = true
packed_p.mode = Mode.b
packed_p.small = 6
packed_p.inner.mode = Mode.c
packed_p.maybe = nil
require packed_p.y and packed_p.x
require packed_p.mode == Mode.b
require packed_p.small == 6
require packed_p.inner.mode == Mode.c
require packed_p.maybe == nil
flip(packed_p.x)
require !packed_p.x
set_mode(packed_p.mode)
require packed_p.mode == Mode.a
require check(packed_p) == 7
require check(nil) == 0
var ps: Array[Packed] = new[Array[Packed]](3)
ps[1] = packed_p
require ps[1].small == 6
require !ps[0].y
var modes: Array[Mode] = new[Array[Mode]](5)
modes[3] = Mode.c
require modes[3] == Mode.c
require modes[2] == Mode.a
var smalls: Array[u:3] = new[Array[u:3]](4)
smalls[2] = 7
require smalls[2] == 7
var perms: Array[Perm] = new[Array[Perm]](2)
perms[1] = Perm.read + Perm.exec
require perms[1] == Perm.read + Perm.exec
let q: Packed = (name = "q", x = false, mode = Mode.a, small = 1,
                 perm = Perm.exec, maybe = true, count = 3,
                 inner = (on = false, mode = Mode.a), y = true)
require q.y and !q.x and q.small == 1

flagset Access { see, edit, run, admin, rw = see + edit, every = ~nil }

func access_class(a: Access) -> int {
    switch a {
        case is nil { return 0 }
        case is see { return 1 }
        case has rw { return 2 }
        case has run, is edit { return 3 }
        else { return 9 }
    }
}

func access_kind(a: Access) -> int {
    return switch a {
        case is every { -> 1 }
        case has admin { -> 2 }
        case is rw { -> 3 }
        else { -> 4 }
    }
}

func access_full(a: Access) -> int {
    switch a {
        case has see { return 1 }
        case has edit { return 2 }
        case has run + admin { return 3 }
        case has run { return 4 }
        case has admin { return 5 }
        case is nil { return 6 }
    }
}

flagset Wide { w0, w1, w2, w3, w4, w5, w6, w7, w8, w9 }

func wide_class(w: Wide) -> int {
    switch w {
        case is w0 + w1 + w2 + w3 + w4 + w5 + w6 + w7 + w8 { return 1 }
        case has w9 + w0 { return 2 }
        case has w9 { return 3 }
        case is nil { return 4 }
        else { return 5 }
    }
}

require access_class(Access.see - Access.see) == 0
require access_class(Access.see) == 1
require access_class(Access.see + Access.admin) == 9
require access_class(Access.rw) == 2
require access_class(Access.rw + Access.run) == 2
require access_class(Access.run + Access.admin) == 3
require access_class(Access.edit) == 3
require access_class(Access.edit + Access.admin) == 9
require access_class(Access.admin) == 9
require access_kind(Access.every) == 1
require access_kind(Access.admin + Access.see) == 2
require access_kind(Access.rw) == 3
require access_kind(Access.rw + Access.run) == 4
require access_full(Access.see + Access.admin) == 1
require access_full(Access.edit + Access.run) == 2
require access_full(Access.run + Access.admin) == 3
require access_full(Access.run) == 4
require access_full(Access.admin) == 5
require access_full(Access.see - Access.see) == 6
require wide_class(Wide.w0 + Wide.w1 + Wide.w2 + Wide.w3 + Wide.w4 + Wide.w5
    + Wide.w6 + Wide.w7 + Wide.w8) == 1
require wide_class(Wide.w9 + Wide.w0 + Wide.w2) == 2
require wide_class(Wide.w9) == 3
require wide_class(Wide.w0 - Wide.w0) == 4
require wide_class(Wide.w1) == 5

// Every operand of `and` and `or` is a condition, the last one too, also
// where the result is a value: a flagset is true when any flag is set.
func both_set(a: Access) -> bool {
    return a.see and a.edit
}

func either_set(a: Access) -> bool {
    let found: bool = a.run or a.admin
    return found
}

require both_set(Access.rw) and !both_set(Access.see)
require either_set(Access.admin) and !either_set(Access.rw)

func access_slice(a: Access) -> int {
    switch a.rw {
        case is nil { return 0 }
        case is see { return 1 }
        case is edit { return 2 }
        case is rw { return 3 }
    }
}

let some_access = Access.see + Access.run
let read_part: Access = some_access.rw
require read_part == Access.see
require some_access.rw == Access.see
require some_access.see and some_access.run
require some_access.rw
require !some_access.edit
let run_only = Access.run
require !run_only.rw
if run_only.rw {
    require false
}
let held = run_only.rw
if held {
    require false
}
require access_slice(Access.run) == 0 and access_slice(some_access) == 1
require access_slice(Access.edit + Access.admin) == 2
require access_slice(Access.every) == 3
let bare_access: Access = see + run
require bare_access.rw == see and bare_access.rw != rw
require access_slice(edit) == 2 and access_slice(every) == 3
let bare_mode: Mode = b
require bare_mode == Mode.b and bare_mode != c
record Pair {
    lo:   char
    hi:   char
    prev: Mode
    last: Mode
}
const max_char: char = cast[char](0x10ffff)
var pair: Pair = (lo = 'a', hi = max_char, prev = Mode.b, last = Mode.c)
require pair.lo == 'a' and pair.hi == max_char
require pair.prev == Mode.b and pair.last == Mode.c
pair.last = Mode.a
pair.hi = 'z'
require pair.prev == Mode.b and pair.last == Mode.a and pair.hi == 'z'

record Cell {
    width: u8
    label: string
}

func weight(c: Cell) -> int {
    return cast[int](c.width) + cast[int] byte_len(c.label)
}

func cell_total() -> int {
    var cells: List[Cell] = new[List[Cell]]()
    cells.append((width = 3, label = "ab"))
    return weight((width = 1, label = "x")) + weight(cells[0])
}

require cell_total() == 7

record Nil_Failure {
    code: i64
    text: string?
    origin: string
}

func make_failure(c: i32) -> Nil_Failure {
    let nil_failure: Nil_Failure = (code = cast[i64]c, text = nil, origin = "x")
    return nil_failure
}

let nil_failure = make_failure(3)
require nil_failure.code == 3
require nil_failure.text == nil

record Handle {
    raw: uint
}

func make_handle(raw: uint) -> Handle {
    return (raw = raw)
}

func checked(raw: uint) -> Handle fail: string {
    if raw == 0 {
        fail "zero"
    }
    return (raw = raw + 1)
}

require make_handle(5).raw == 5
try {
    require checked(1)!.raw == 2
} fail(failure) {
    require false
}

record Box {
    cap: u32
    low: u8
    limit: i16?
}

func __init(modify self: Box, cap: u32, low: u8 = 1, limit: i16? = nil) {
    self.cap = cap
    self.low = low
    self.limit = limit
}

var box_plain: Box = new[Box](64)
var named: Box = new[Box](70000, low = 200, limit = -3)
require box_plain.cap == 64
require box_plain.low == 1
require named.cap == 70000
require named.low == 200
require named.limit.get_or_else(0) == -3

record Failure {
    code: i64
    text: string?
    limit: u32?
}

func __init(modify self: Failure, code: i64, text: string?, limit: u32? = nil) {
    self.code = code
    self.text = text
    self.limit = limit
}

func risky(code: i64) -> nil fail: Failure {
    fail new[Failure](code, nil)
}

func limit_of(failure: Failure) -> u32 {
    let limit = failure.limit
    if limit == nil {
        return 0
    }
    return limit
}

let failure_plain = new[Failure](cast[i64]1, "named", limit = 7)
require failure_plain.text != nil
require limit_of(failure_plain) == 7
let empty = new[Failure](cast[i64]2, nil, limit = 9)
require empty.text == nil
require limit_of(empty) == 9
try {
    risky(3)!
} fail(failure) {
    require failure.code == 3
    require limit_of(failure) == 0
}

let bytes: Ffi_Bytes = (data = cast[uint]0, length = cast[uint]3)
require bytes.length == 3

record R {
    types: u8
    io: u8
}

var r: R = (types = 3, io = 4)
r.io += 1
require r.types == 3
require r.io == 5

record Node {
    value: int
}

var width: Atomic[u32] = 5
var small: Atomic[i8] = -3
var flag: Atomic[bool] = false
var ratio: Atomic[f64] = 1.5
var head: Atomic[Ref[Node]?] = nil

func same(x: u32) -> u32 {
    return x
}

func atomic_bump(modify c: Atomic[u32]) {
    c = c + 1
}

func loads() -> bool {
    flag = !flag
    let w: u32 = width
    let total: u32 = w + same(width) + width
    var node: Node = (value = 7)
    head = ref node
    let h: Ref[Node]? = head
    var copy: Atomic[u32] = width
    atomic_bump(copy)
    return flag and total == 15 and width == 5 and small == -3 and
        ratio * 2.0 == 3.0 and h != nil and h.__value.value == 7 and
        copy == 6
}

require loads()

// Only an object has a finalizer. An object whose storage stays in the frame
// is finalized when the frame returns or fails, latest first; one whose
// storage moves to the heap is finalized by the collector.
object Fin_Value {
    v: int
}

func __init(self: Fin_Value, v: int) {
    self.v = v
}

record Fin_Holder {
    tag: int
    f: Fin_Value
}

object Fin_Outer {
    inner: Fin_Value
}

func __init(self: Fin_Outer, v: int) {
    self.inner = new[Fin_Value](v)
}

object Fin_Wrap {
    item: 'T
}

func __init(self: Fin_Wrap['T], item: 'T) {
    self.item = item
}

var fin_count: int = 0
var fin_order: int = 0
var fin_outer_done: bool = false

func __finalize(consume self: Ref[Fin_Value]) {
    fin_count += 1
    fin_order = fin_order * 10 + self.__value.v
}

func __finalize(consume self: Ref[Fin_Outer]) {
    fin_outer_done = true
}

func __finalize(consume self: Ref[Fin_Wrap['T]]) {
    fin_order = fin_order * 10 + 8
}

func fin_reset() {
    fin_count = 0
    fin_order = 0
}

func fin_peek(f: Fin_Value) -> int {
    return f.v
}

func fin_scoped() -> int {
    let f = new[Fin_Value](1)
    return 0
}

func fin_passed() -> int {
    let f = new[Fin_Value](2)
    require fin_peek(f) == 2 and fin_count == 0
    return fin_peek(f)
}

func fin_early(flag: bool) -> int {
    let f = new[Fin_Value](3)
    if flag {
        return 1
    }
    return f.v
}

func fin_failing(flag: bool) -> int fail: string {
    let f = new[Fin_Value](7)
    if flag {
        fail "no"
    }
    return f.v
}

func fin_caught() -> int {
    try {
        return fin_failing(true)!
    } fail(message) {
        return -1
    }
}

// Copying a handle shares the object, so it is still finalized once.
func fin_shared() -> int {
    let f = new[Fin_Value](1)
    let g = f
    return g.v + f.v
}

func fin_held() -> int {
    let h: Fin_Holder = (tag = 7, f = new[Fin_Value](1))
    let copy = h
    return copy.tag + h.f.v
}

func fin_paired() -> int {
    let a = new[Fin_Value](2)
    let b = new[Fin_Value](3)
    return a.v + b.v
}

func fin_sometimes(flag: bool) -> int {
    if flag {
        let f = new[Fin_Value](4)
        return f.v
    }
    return 0
}

func fin_generic() -> int {
    let w = new[Fin_Wrap[int]](6)
    return w.item
}

// The outer object stays in the frame; the inner one escapes into its field,
// so the collector finalizes it.
func fin_nested() -> int {
    let o = new[Fin_Outer](5)
    return o.inner.v
}

func fin_returned() -> Fin_Value {
    return new[Fin_Value](5)
}

record Ref_Slot {
    value: int
}

object Ref_Handle {
    target: Ref[Ref_Slot]
}

object Ref_Store {
    slot:           Ref_Slot
    private handed: int
}

object Ref_Lent {
    owner: Ref_Store
}

func __init(self: Ref_Handle, target: Ref[Ref_Slot]) {
    self.target = target
}

func __init(self: Ref_Store, value: int) {
    self.slot = (value = value)
    self.handed = 0
}

func __init(self: Ref_Lent, owner: Ref_Store) {
    self.owner = owner
}

func __ref_address(self: Ref_Handle) -> Ref[Ref_Slot] {
    return self.target
}

func __ref_address_mut(self: Ref_Handle) -> Ref[Ref_Slot] {
    return self.target
}

func __ref_create(self: Ref_Store) -> Ref_Lent {
    self.handed += 1
    return new[Ref_Lent](self)
}

func __ref_address(self: Ref_Lent) -> Ref[Ref_Slot] {
    return ref self.owner.slot
}

func ref_bump(r: Ref[Ref_Slot]) {
    r.__value.value += 100
}

func ref_double(modify s: Ref_Slot) {
    s.value *= 2
}

func ref_through_handle() -> int {
    var slot: Ref_Slot = (value = 1)
    let h: Ref_Handle = new[Ref_Handle](ref slot)
    h.__value = (value = 2)
    h.__value.value += 3
    ref_bump(ref h.__value)
    ref_double(h.__value)
    let copy: Ref_Slot = h.__value
    return copy.value + slot.value
}

func ref_generic_read(r: 'R) -> 'T where 'R : Reference['T] {
    return r.__value
}

func ref_generic_write(r: 'R, value: 'T)
    where 'R : Mutable_Reference['T] {
    r.__value = value
}

func ref_generic() -> int {
    var slot: Ref_Slot = (value = 1)
    let h: Ref_Handle = new[Ref_Handle](ref slot)
    let plain: Ref[Ref_Slot] = ref slot
    let replacement: Ref_Slot = (value = 30)
    ref_generic_write(h, replacement)
    let through_handle: Ref_Slot = ref_generic_read(h)
    let through_ref: Ref_Slot = ref_generic_read(plain)
    return through_handle.value + through_ref.value
}

func ref_viewed(view store: Ref_Store) -> int {
    let lent: Ref_Lent = ref store
    return lent.__value.value
}

func ref_created() -> int {
    let store: Ref_Store = new[Ref_Store](4)
    let lent: Ref_Lent = ref store
    let again: Ref_Lent = ref store
    return lent.__value.value * 10 + again.__value.value + store.handed
}

func lease_store() -> int {
    var items: Array[int] = new[Array[int]](3)
    items[0] = 1
    items[1] = 2
    items[2] = 3
    var store: Leasable[int] = new[Leasable[int]](items)
    store[1] = 20
    {
        let lease: Lease[int] = ref store
        require leased(store)
        store[2] = 30
        require lease.__value[2] == 3 and store[2] == 30
    }
    require !leased(store)
    return store[1] + cast[int]len(store)
}

func lease_list_append() -> int {
    var items: List[int] = [1, 2, 3]
    var total: int = 0
    for value in items {
        require value != 1 or leased(items.items)
        items.append(value * 10)
        total += value
    }
    require !leased(items.items) and items.len() == 6 and items[5] == 30
    return total
}

func lease_list_break() -> bool {
    var items: List[int] = [1, 2, 3]
    for value in items {
        if value == 2 {
            break
        }
    }
    return !leased(items.items)
}

func lease_list_find(items: List[int], wanted: int) -> int {
    for value in items {
        if value == wanted {
            return value
        }
    }
    return 0
}

func lease_list_cursor() -> int {
    var items: List[int] = [4, 5]
    var walk: Lease_Cursor[int] = items.__iterator()
    var total: int = 0
    var item: int? = walk.__next()
    while item != nil {
        total += item
        item = walk.__next()
    }
    require !leased(items.items)
    return total
}

func lease_rows_append() -> int {
    var rows: List[Array[int]] = new[List[Array[int]]]()
    var first: Array[int] = [1, 2]
    rows.append(first)
    for row in rows {
        rows.append(row)
    }
    return rows.len() + rows[1][1]
}

func lease_dict_writes() -> int {
    var table: Dict[int, int] = {1: 10, 2: 20, 3: 30}
    var total: int = 0
    for key, value in table {
        table[key + 100] = value
        _ = table.remove(2)
        total += value
    }
    require table.len() == 5
    return total
}

require fin_scoped() == 0
require fin_count == 1 and fin_order == 1
fin_reset()
require fin_passed() == 2
require fin_count == 1 and fin_order == 2
fin_reset()
require fin_early(true) == 1 and fin_early(false) == 3
require fin_count == 2 and fin_order == 33
fin_reset()
require fin_caught() == -1
require fin_count == 1 and fin_order == 7
fin_reset()
require fin_shared() == 2
require fin_count == 1
fin_reset()
require fin_held() == 8
require fin_count == 1
fin_reset()
require fin_paired() == 5
require fin_count == 2 and fin_order == 32
fin_reset()
require fin_sometimes(false) == 0 and fin_count == 0
require fin_sometimes(true) == 4 and fin_count == 1
fin_reset()
require fin_generic() == 6
require fin_order == 8
fin_reset()
require ref_through_handle() == 420
require ref_created() == 46
require ref_viewed(new[Ref_Store](8)) == 8
require ref_generic() == 60
// These leave objects on the heap, for the collector to finalize whenever it
// runs, so they come last and check only what the frame finalized.
require fin_nested() == 5 and fin_outer_done
let fin_kept: Fin_Value = fin_returned()
require fin_kept.v == 5
fin_reset()
var lease_probe: List[int] = [3, 4]
require lease_list_find(lease_probe, 4) == 4 and !leased(lease_probe.items)
require lease_store() == 23
require lease_list_append() == 6
require lease_list_break()
require lease_list_cursor() == 9
require lease_rows_append() == 4
require lease_dict_writes() == 60
__fd_write(2, "ok")
