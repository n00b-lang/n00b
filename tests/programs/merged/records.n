record Point {
    x: int
    y: int
}

object Counter {
    count: int
    label: string
}

const ORIGIN: Point = (x = 0, y = 0)

func shift(p: Point) -> Point {
    var moved: Point = p
    moved.x = moved.x + 1
    return moved
}

func bump(c: Counter) {
    c.count = c.count + 1
}

func peek(view c: Counter) -> int {
    return c.count
}

func label_of(view c: Counter) -> string {
    let text: string = c.label
    return text
}

func double_peek(view c: Counter) -> int {
    return peek(c) * 2
}

func pass_back(view c: Counter) -> Counter {
    return c
}

var copied: int = 0

func copy_out(view c: Counter) {
    copied = c.count
}

func grow(modify p: Point) {
    p.y = p.y + 10
}

func replace(modify c: Counter) {
    c = (count = 100, label = "replaced")
}

func make_point(out p: Point) {
    p = (x = 7, y = 8)
}

func take(consume c: Counter) -> int {
    c = (count = c.count + 1000, label = c.label)
    return c.count
}

var first: Point = (x = 1, y = 2)
var second: Point = first
second.x = 50
require first.x == 1 and second.x == 50

let fixed: Point = (x = 3, y = 4)
require shift(fixed).x == 4 and fixed.x == 3

let counter: Counter = (count = 1, label = "c")
let alias_of_counter: Counter = counter
alias_of_counter.count = 5
require counter.count == 5
bump(counter)
require counter.count == 6 and alias_of_counter.count == 6

require peek(counter) == 6 and double_peek(counter) == 12
require label_of(counter) == "c"
require pass_back(counter) == counter
copy_out(counter)
require copied == 6

grow(first)
require first.y == 12

var slot: Counter = counter
replace(slot)
require slot.count == 100 and counter.count == 6

var made: Point
make_point(made)
require made.x == 7 and made.y == 8

let given: Counter = (count = 1, label = "given")
require take(given) == 1001

require ORIGIN.x == 0 and peek(counter) == 6

let items: List[int] = [1, 2]
let shared_items = items
shared_items.append(3)
items[0] = 9
require len(items) == 3 and shared_items[0] == 9

enum Mode {
    a = 0, b = 1, c = 2
}

flagset Perm {
    read, write, exec
}

record Inner {
    on:   bool
    mode: Mode
}

record Packed {
    name:  string
    x:     bool
    mode:  Mode
    small: u:3
    perm:  Perm
    maybe: bool?
    count: int
    inner: Inner
    y:     bool
}

const base: Packed = (name = "base", x = true, mode = Mode.c, small = 5,
                      perm = Perm.write, maybe = false, count = 7,
                      inner = (on = true, mode = Mode.b), y = false)

func flip(modify v: bool) {
    v = !v
}

func set_mode(modify m: Mode) {
    m = Mode.a
}

func check(packed_p: Packed?) -> int {
    if packed_p == nil {
        return 0
    }
    return packed_p.get().count
}

var packed_p: Packed = base
require packed_p.x
require packed_p.mode == Mode.c
require packed_p.small == 5
require packed_p.perm == Perm.write
require packed_p.maybe != nil
require packed_p.count == 7
require packed_p.inner.on
require packed_p.inner.mode == Mode.b
require !packed_p.y
require packed_p.name == "base"
packed_p.y = true
packed_p.mode = Mode.b
packed_p.small = 6
packed_p.inner.mode = Mode.c
packed_p.maybe = nil
require packed_p.y and packed_p.x
require packed_p.mode == Mode.b
require packed_p.small == 6
require packed_p.inner.mode == Mode.c
require packed_p.maybe == nil
flip(packed_p.x)
require !packed_p.x
set_mode(packed_p.mode)
require packed_p.mode == Mode.a
require check(packed_p) == 7
require check(nil) == 0
var ps: Array[Packed] = new[Array[Packed]](3)
ps[1] = packed_p
require ps[1].small == 6
require !ps[0].y
var modes: Array[Mode] = new[Array[Mode]](5)
modes[3] = Mode.c
require modes[3] == Mode.c
require modes[2] == Mode.a
var smalls: Array[u:3] = new[Array[u:3]](4)
smalls[2] = 7
require smalls[2] == 7
var perms: Array[Perm] = new[Array[Perm]](2)
perms[1] = Perm.read + Perm.exec
require perms[1] == Perm.read + Perm.exec
let q: Packed = (name = "q", x = false, mode = Mode.a, small = 1,
                 perm = Perm.exec, maybe = true, count = 3,
                 inner = (on = false, mode = Mode.a), y = true)
require q.y and !q.x and q.small == 1
record Pair {
    lo:   char
    hi:   char
    prev: Mode
    last: Mode
}
const max_char: char = cast[char](0x10ffff)
var pair: Pair = (lo = 'a', hi = max_char, prev = Mode.b, last = Mode.c)
require pair.lo == 'a' and pair.hi == max_char
require pair.prev == Mode.b and pair.last == Mode.c
pair.last = Mode.a
pair.hi = 'z'
require pair.prev == Mode.b and pair.last == Mode.a and pair.hi == 'z'

record Cell {
    width: u8
    label: string
}

func weight(c: Cell) -> int {
    return cast[int](c.width) + cast[int] byte_len(c.label)
}

func cell_total() -> int {
    var cells: List[Cell] = new[List[Cell]]()
    cells.append((width = 3, label = "ab"))
    return weight((width = 1, label = "x")) + weight(cells[0])
}

require cell_total() == 7

record Nil_Failure {
    code: i64
    text: string?
    origin: string
}

func make_failure(c: i32) -> Nil_Failure {
    let nil_failure: Nil_Failure = (code = cast[i64]c, text = nil, origin = "x")
    return nil_failure
}

let nil_failure = make_failure(3)
require nil_failure.code == 3
require nil_failure.text == nil

record Handle {
    raw: uint
}

func make_handle(raw: uint) -> Handle {
    return (raw = raw)
}

func checked(raw: uint) -> Handle fail: string {
    if raw == 0 {
        fail "zero"
    }
    return (raw = raw + 1)
}

require make_handle(5).raw == 5
try {
    require checked(1)!.raw == 2
} fail(failure) {
    require false
}

record Box {
    cap: u32
    low: u8
    limit: i16?
}

func __init(modify self: Box, cap: u32, low: u8 = 1, limit: i16? = nil) {
    self.cap = cap
    self.low = low
    self.limit = limit
}

var box_plain: Box = new[Box](64)
var named: Box = new[Box](70000, low = 200, limit = -3)
require box_plain.cap == 64
require box_plain.low == 1
require named.cap == 70000
require named.low == 200
require named.limit.get_or_else(0) == -3

record Failure {
    code: i64
    text: string?
    limit: u32?
}

func __init(modify self: Failure, code: i64, text: string?, limit: u32? = nil) {
    self.code = code
    self.text = text
    self.limit = limit
}

func risky(code: i64) -> nil fail: Failure {
    fail new[Failure](code, nil)
}

func limit_of(failure: Failure) -> u32 {
    let limit = failure.limit
    if limit == nil {
        return 0
    }
    return limit.get()
}

let failure_plain = new[Failure](cast[i64]1, "named", limit = 7)
require failure_plain.text != nil
require limit_of(failure_plain) == 7
let empty = new[Failure](cast[i64]2, nil, limit = 9)
require empty.text == nil
require limit_of(empty) == 9
try {
    risky(3)!
} fail(failure) {
    require failure.code == 3
    require limit_of(failure) == 0
}

let bytes: Ffi_Bytes = (data = cast[uint]0, length = cast[uint]3)
require bytes.length == 3

record R {
    types: u8
    io: u8
}

var r: R = (types = 3, io = 4)
r.io += 1
require r.types == 3
require r.io == 5

record Node {
    value: int
}

var width: Atomic[u32] = 5
var small: Atomic[i8] = -3
var flag: Atomic[bool] = false
var ratio: Atomic[f64] = 1.5
var head: Atomic[Ref[Node]?] = nil

func same(x: u32) -> u32 {
    return x
}

func atomic_bump(modify c: Atomic[u32]) {
    c = c + 1
}

func loads() -> bool {
    flag = !flag
    let w: u32 = width
    let total: u32 = w + same(width) + width
    var node: Node = (value = 7)
    head = ref node
    let h: Ref[Node]? = head
    var copy: Atomic[u32] = width
    atomic_bump(copy)
    return flag and total == 15 and width == 5 and small == -3 and
        ratio * 2.0 == 3.0 and h != nil and h.get().__value.value == 7 and
        copy == 6
}

require loads()

record Fin_Value {
    v: int
}

record Fin_Holder {
    tag: int
    f: Fin_Value
}

record Fin_Outer {
    h: Fin_Holder
    g: Fin_Value
}

object Fin_Box {
    f: Fin_Value
}

var fin_count: int = 0
var fin_order: int = 0

func __finalize(consume self: Ref[Fin_Value]) {
    fin_count += 1
    fin_order = fin_order * 10 + self.__value.v
}

func __finalize(consume self: Ref[Fin_Outer]) {
    fin_order = fin_order * 10 + 9
}

func fin_reset() {
    fin_count = 0
    fin_order = 0
}

func fin_make(v: int) -> Fin_Value {
    let f: Fin_Value = (v = v)
    return f
}

func fin_take(consume f: Fin_Value) -> int {
    return f.v
}

func fin_peek(f: Fin_Value) -> int {
    return f.v
}

func fin_peek_ref(f: Ref[Fin_Value]) -> int {
    return f.__value.v
}

func fin_scoped() -> int {
    var f: Fin_Value = (v = 1)
    return 0
}

func fin_moved_to_callee() -> int {
    var f: Fin_Value = (v = 2)
    return fin_take(f)
}

func fin_early(flag: bool) -> int {
    var f: Fin_Value = (v = 3)
    if flag {
        return 1
    }
    return f.v
}

func fin_looped() -> int {
    var total: int = 0
    var i: int = 0
    while i < 3 {
        let f: Fin_Value = (v = i + 1)
        total += f.v
        i += 1
    }
    return total
}

func fin_broken() -> int {
    var i: int = 0
    while true {
        let f: Fin_Value = (v = 4)
        if i == 2 {
            break
        }
        i += 1
    }
    return i
}

func fin_reassigned() -> int {
    var f: Fin_Value = (v = 5)
    f = (v = 6)
    return f.v
}

func fin_failing(flag: bool) -> int fail: string {
    let f: Fin_Value = (v = 7)
    if flag {
        fail "no"
    }
    return f.v
}

func fin_caught() -> int {
    try {
        return fin_failing(true)!
    } fail(message) {
        return -1
    }
}

func fin_moved_local() -> int {
    let f: Fin_Value = (v = 1)
    let g: Fin_Value = f
    return g.v
}

func fin_held() -> int {
    let f: Fin_Value = (v = 1)
    let h: Fin_Holder = (tag = 7, f = f)
    return h.tag
}

func fin_nested() -> int {
    let h: Fin_Holder = (tag = 1, f = (v = 2))
    let o: Fin_Outer = (h = h, g = (v = 3))
    return o.h.tag
}

func fin_present() -> int {
    let f: Fin_Value? = (v = 1)
    return 0
}

func fin_absent() -> int {
    let f: Fin_Value? = nil
    return 0
}

func fin_paired() -> int {
    let a: Fin_Value = (v = 2)
    let b: Fin_Value = (v = 3)
    let pair: Tuple[Fin_Value, int, Fin_Value] = (a, 5, b)
    return pair[1]
}

func fin_addressed() -> int {
    var f: Fin_Value = (v = 4)
    return fin_peek_ref(ref f)
}

func fin_borrowed_temporary() -> int {
    return fin_peek(fin_make(1))
}

func fin_field_of_temporary() -> int {
    return fin_make(2).v
}

func fin_condition_temporary() -> int {
    var n: int = 0
    while fin_make(n).v < 3 {
        n += 1
    }
    return n
}

func fin_returned_temporary() -> Fin_Value {
    return fin_make(5)
}

func fin_block_value() -> int {
    let n: int = {
        let f: Fin_Value = (v = 1)
        -> f.v + 10
    }
    return n
}

func fin_block_moved() -> int {
    let g: Fin_Value = {
        let f: Fin_Value = (v = 2)
        -> f
    }
    return g.v
}

func fin_array_literal() -> int {
    let items: Array[Fin_Value] = [(v = 1), (v = 2)]
    return fin_count
}

func fin_short_circuit() -> int {
    if fin_make(1).v == 0 or fin_make(2).v == 2 {
        return 1
    }
    return 0
}

func fin_generic_sink(consume x: 'T) -> int {
    return 1
}

func fin_generic_pass(consume x: 'T) -> 'T {
    return x
}

func fin_generic_local(consume x: 'T) -> int {
    var y: 'T = x
    return 2
}

func fin_generic_chain(consume x: 'T) -> int {
    return fin_generic_sink(fin_generic_pass(x))
}

record Fin_Wrap {
    item: 'T
    tag:  int
}

func __finalize(consume self: Ref[Fin_Wrap['T]]) {
    fin_order = fin_order * 10 + 8
}

func fin_generic_tuple() -> int {
    let t: Tuple[Fin_Value, int, Fin_Value] = (fin_make(1), 5, fin_make(2))
    return fin_generic_sink(t)
}

func fin_generic_wrapped() -> int {
    let w: Fin_Wrap[Fin_Value] = (item = fin_make(3), tag = 1)
    return fin_generic_sink(w)
}

object Fin_Init_Box {
    f: Fin_Value
}

func __init(self: Fin_Init_Box, consume f: Fin_Value, twice: bool) {
    self.f = f
    if twice {
        self.f = (v = 7)
    }
}

func fin_field_overwrite() -> int {
    var h: Fin_Holder = (tag = 1, f = (v = 1))
    h.f = fin_make(2)
    return fin_count
}

func fin_store_through(r: Ref[Fin_Value]) {
    r.__value = fin_make(4)
}

func fin_reference_overwrite() -> int {
    var f: Fin_Value = (v = 3)
    fin_store_through(ref f)
    return f.v
}

func fin_initialized_once() -> int {
    let b: Fin_Init_Box = new[Fin_Init_Box](fin_make(5), false)
    require fin_count == 0
    let c: Fin_Init_Box = new[Fin_Init_Box](fin_make(6), true)
    require fin_count == 1 and fin_order == 6
    return b.f.v + c.f.v
}

record Ref_Slot {
    value: int
}

object Ref_Handle {
    target: Ref[Ref_Slot]
}

object Ref_Store {
    slot:   Ref_Slot
    handed: int
}

object Ref_Lent {
    owner: Ref_Store
}

func __init(self: Ref_Handle, target: Ref[Ref_Slot]) {
    self.target = target
}

func __init(self: Ref_Store, value: int) {
    self.slot = (value = value)
    self.handed = 0
}

func __init(self: Ref_Lent, owner: Ref_Store) {
    self.owner = owner
}

func __ref_address(self: Ref_Handle) -> Ref[Ref_Slot] {
    return self.target
}

func __ref_address_mut(self: Ref_Handle) -> Ref[Ref_Slot] {
    return self.target
}

func __ref_create(self: Ref_Store) -> Ref_Lent {
    self.handed += 1
    return new[Ref_Lent](self)
}

func __ref_address(self: Ref_Lent) -> Ref[Ref_Slot] {
    return ref self.owner.slot
}

func ref_bump(r: Ref[Ref_Slot]) {
    r.__value.value += 100
}

func ref_double(modify s: Ref_Slot) {
    s.value *= 2
}

func ref_through_handle() -> int {
    var slot: Ref_Slot = (value = 1)
    let h: Ref_Handle = new[Ref_Handle](ref slot)
    h.__value = (value = 2)
    h.__value.value += 3
    ref_bump(ref h.__value)
    ref_double(h.__value)
    let copy: Ref_Slot = h.__value
    return copy.value + slot.value
}

func ref_generic_read(r: 'R) -> 'T where 'R : Reference['T] {
    return r.__value
}

func ref_generic_write(r: 'R, value: 'T)
    where 'R : Mutable_Reference['T] {
    r.__value = value
}

func ref_generic() -> int {
    var slot: Ref_Slot = (value = 1)
    let h: Ref_Handle = new[Ref_Handle](ref slot)
    let plain: Ref[Ref_Slot] = ref slot
    let replacement: Ref_Slot = (value = 30)
    ref_generic_write(h, replacement)
    let through_handle: Ref_Slot = ref_generic_read(h)
    let through_ref: Ref_Slot = ref_generic_read(plain)
    return through_handle.value + through_ref.value
}

func ref_created() -> int {
    let store: Ref_Store = new[Ref_Store](4)
    let lent: Ref_Lent = ref store
    let again: Ref_Lent = ref store
    return lent.__value.value * 10 + again.__value.value + store.handed
}

require fin_scoped() == 0
require fin_count == 1 and fin_order == 1
fin_reset()
require fin_moved_to_callee() == 2
require fin_count == 1 and fin_order == 2
fin_reset()
require fin_early(true) == 1 and fin_early(false) == 3
require fin_count == 2 and fin_order == 33
fin_reset()
require fin_looped() == 6
require fin_count == 3 and fin_order == 123
fin_reset()
require fin_broken() == 2
require fin_count == 3 and fin_order == 444
fin_reset()
require fin_reassigned() == 6
require fin_count == 2 and fin_order == 56
fin_reset()
require fin_caught() == -1
require fin_count == 1 and fin_order == 7
fin_reset()
require fin_moved_local() == 1
require fin_count == 1
fin_reset()
require fin_held() == 7
require fin_count == 1
fin_reset()
require fin_nested() == 1
require fin_count == 2 and fin_order == 923
fin_reset()
require fin_present() == 0 and fin_absent() == 0
require fin_count == 1
fin_reset()
require fin_paired() == 5
require fin_count == 2 and fin_order == 23
fin_reset()
require fin_addressed() == 4
require fin_count == 1
fin_reset()
require fin_borrowed_temporary() == 1
require fin_field_of_temporary() == 2
require fin_count == 2
fin_reset()
require fin_condition_temporary() == 3
require fin_count == 4
fin_reset()
require fin_block_value() == 11
require fin_count == 1
fin_reset()
require fin_block_moved() == 2
require fin_count == 1
fin_reset()
require fin_array_literal() == 0
fin_reset()
require fin_short_circuit() == 1
require fin_count == 2 and fin_order == 12
fin_reset()
require fin_generic_sink(fin_make(4)) == 1
require fin_count == 1 and fin_order == 4
fin_reset()
require fin_generic_local(fin_make(5)) == 2
require fin_count == 1 and fin_order == 5
fin_reset()
require fin_generic_chain(fin_make(6)) == 1
require fin_count == 1 and fin_order == 6
fin_reset()
require fin_generic_pass(fin_make(7)).v == 7
require fin_count == 1
fin_reset()
require fin_generic_tuple() == 1
require fin_count == 2 and fin_order == 12
fin_reset()
require fin_generic_wrapped() == 1
require fin_count == 1 and fin_order == 83
fin_reset()
require fin_generic_sink(3) == 1
require fin_field_overwrite() == 1
require fin_count == 2 and fin_order == 12
fin_reset()
require fin_reference_overwrite() == 4
require fin_count == 2 and fin_order == 34
fin_reset()
require fin_initialized_once() == 12
fin_reset()
require ref_through_handle() == 420
require ref_created() == 46
require ref_generic() == 60
let fin_kept: Fin_Value = fin_returned_temporary()
require fin_kept.v == 5 and fin_count == 0
fin_reset()
__fd_write(2, "ok")
