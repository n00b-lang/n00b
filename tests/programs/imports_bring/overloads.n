import pick_alpha
import pick_beta
bring pick from pick_beta
bring pick from pick_gamma
bring same from pick_beta

func pick(x: f64) -> int {
    return 1
}

func same(x: int) -> int {
    return 2
}

require pick(1) == 20 and pick("s") == 21 and pick(true) == 30
require pick(1.5) == 1 and same(1) == 2

require pick_alpha.pick(1) == 10 and pick_beta.pick(1) == 20
require pick_beta.pick("s") == 21
__fd_write(2, "ok")
