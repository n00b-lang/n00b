func rhs(value: bool) -> bool {
    return value
}

func logical_and(left: bool, right: bool) -> bool {
    return left and rhs(right)
}

func logical_or(left: bool, right: bool) -> bool {
    return left or rhs(right)
}

func logical_nested(a: bool, b: bool, c: bool) -> bool {
    return a or b and rhs(c)
}
