declare_litmod("mirror", "set", "build_set")

func build_set(items: Array[int]) -> Set[int] fail: string {
    return s{1, 2}
}

func static_set() -> Set[int] {
    return mirror{1, 2}
}

func dynamic_set(x: int) -> Set[int] {
    return mirror{x, 2}
}

func empty_set() -> Set[int] {
    return mirror{}
}
