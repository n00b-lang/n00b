// A cached generic's `where` clause holds at its call sites, as when it is
// compiled from source.
import bounded
import shapes

let dot: shapes.Dot = (x = 7)
require bounded.needs_render(dot) == 1
require bounded.rendered(dot) == 7
require bounded.not_string("s") == 2
require bounded.needs_integer(2.5) == 3
