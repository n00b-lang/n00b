enum Status {
    ready =
        1,
}

flagset Permissions {
    read,
    write,
    both =
        read +
        write,
    neither =
        read -
        write,
    either =
        read |
        write,
    changed =
        read ^
        write,
    shared =
        read &
        write,
}

func sample(x: uint =
    2) -> uint {
    var value: uint =
        x +
        1
    value =
        value -
        1
    value +=
        2
    value -=
        1
    value *=
        3
    value /=
        2
    value %=
        2
    value &=
        1
    value |=
        2
    value ^=
        1
    value <<=
        1
    value >>=
        1
    let product = 2 *
        3
    let quotient = 6 /
        2
    let remainder = 6 %
        2
    let masked = 3 &
        1
    let merged = 1 |
        2
    let toggled = 1 ^
        2
    let shifted_left = 1 <<
        2
    let shifted_right = 4 >>
        1
    let same = 1 ==
        1
    let different = 1 !=
        2
    let below = 1 <
        2
    let at_most = 1 <=
        2
    let above = 2 >
        1
    let at_least = 2 >=
        1
    let logical = true and
        false or
        true
    for index from 1 to
        3 {
        value +=
            index
    }
    for index from 1 until
        3 {
        value +=
            index
    }
    for index from 1 :
        3 {
        value +=
            index
    }
    let with_keyword = sample(x =
        3)
    return value
}

