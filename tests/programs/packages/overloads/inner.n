public record First {
    public raw: uint
}

public record Second {
    public raw: uint
}

public func measure(value: int) -> int {
    return value + 1
}

public func measure(value: int, scale: int) -> int {
    return value * scale
}

public func shut(modify self: First) {
    self.raw = 1
}

public func shut(modify self: Second) {
    self.raw = 2
}

public func span(self: First, other: First) -> uint {
    return self.raw + other.raw
}

public func span(self: string, scale: uint = 1) -> string {
    return byte_slice(self, 0, cast[int] scale)
}

public func second() -> Second {
    return (raw = 0)
}

public func poke(modify self: Second) {
    self.raw = 3
}

public func first() -> First {
    return (raw = 0)
}

public record Opts {
    public a: i64?
    public b: i64?
}

public func find_first(raw: uint) -> Ref[First]? {
    var found: First = (raw = raw)
    return ref found
}
