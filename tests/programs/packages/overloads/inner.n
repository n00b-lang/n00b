record First {
    raw: uint
}

record Second {
    raw: uint
}

func measure(value: int) -> int {
    return value + 1
}

func measure(value: int, scale: int) -> int {
    return value * scale
}

func shut(modify self: First) {
    self.raw = 1
}

func shut(modify self: Second) {
    self.raw = 2
}

func span(self: First, other: First) -> uint {
    return self.raw + other.raw
}

func span(self: string, scale: uint = 1) -> string {
    return byte_slice(self, 0, cast[int] scale)
}

func second() -> Second {
    return (raw = 0)
}

func poke(modify self: Second) {
    self.raw = 3
}

func first() -> First {
    return (raw = 0)
}

record Opts {
    a: i64?
    b: i64?
}

func find_first(raw: uint) -> Ref[First]? {
    var found: First = (raw = raw)
    return ref found
}
