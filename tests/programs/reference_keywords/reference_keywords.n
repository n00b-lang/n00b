# Calls through function references pass keyword parameters by name, or
# omit them; an omitted one's default is evaluated by the function, in its
# own scope. A function's type names its keyword parameters, in no
# particular order.
import keyword_lib
import keyword_refs

func scaled(a: int, scale: int = 2) -> int {
    return a * scale
}

# Defaults that use a positional parameter and an earlier keyword one.
func digits(a: int, b: int = 10, c: int = b + a) -> int {
    return a * 100 + b * 10 + c
}

# Declared in an order other than the one its type lists them in.
func ordered(a: int, zz: int = 1, b: int = 2) -> int {
    return a * 100 + zz * 10 + b
}

func summed(a: int, *rest: int, scale: int = 2) -> int {
    var total = a
    for item in rest {
        total += item
    }
    return total * scale
}

func limited(a: int, limit: int = 5) -> int fail: string {
    if a > limit {
        fail "too big"
    }
    return a
}

let by_type: Ref[(int, scale: int) -> int] = ref scaled
require by_type.call(3) == 6
require by_type.call(3, scale = 4) == 12
require by_type.call(scale = 5, 3) == 15

let starred: Ref[(int, **scale: int) -> int] = ref scaled
require starred.call(3, scale = 3) == 9

let inferred = ref digits
require inferred.call(1) == 211
require inferred.call(1, c = 7) == 207
require inferred.call(1, b = 2) == 123

let reordered = ref ordered
require reordered.call(5) == 512
require reordered.call(5, b = 7) == 517
require reordered.call(5, zz = 3) == 532
require reordered.call(5, b = 4, zz = 3) == 534

let listed: Ref[(int, b: int, zz: int) -> int] = ref ordered
require listed.call(1, zz = 9) == 192

let varargs: Ref[(int, *int, scale: int) -> int] = ref summed
require varargs.call(1) == 2
require varargs.call(1, 2, 3) == 12
require varargs.call(1, 2, 3, scale = 3) == 18

func twice(f: Ref[(int, scale: int) -> int]) -> int {
    return f.call(7) + f.call(1, scale = 100)
}
require twice(ref scaled) == 114

let failing: Ref[(int, limit: int) -> int fail: string] = ref limited
let imported_join = ref keyword_lib.joined
let imported_check = ref keyword_lib.checked
# Every module's `ref` of a function is the same reference, however its
# keyword parameters are declared.
require imported_check == keyword_refs.checked_ref()
let local_order: Ref[(int, b: int, zz: int) -> int] = ref ordered
require local_order == reordered

func failures() -> int fail: string {
    require failing.call(3)! == 3
    require failing.call(9, limit = 20)! == 9
    var caught = false
    try {
        require failing.call(9)! == 0
    } fail(problem) {
        caught = problem == "too big"
    }
    require caught
    require imported_check.call(5)! == 512
    require imported_check.call(5, b = 7)! == 517
    caught = false
    try {
        require imported_check.call(-1, zz = 3)! == 0
    } fail(problem) {
        caught = problem == "negative"
    }
    require caught
    return 1
}

try {
    require failures()! == 1
} fail(problem) {
    require false
}

# A generic function's references are instances of it.
func either(a: 'T, other: 'T = a) -> 'T {
    return other
}
func counted(first: 'T, *rest: 'T, extra: int = 0) -> int {
    return len(rest) + 1 + extra
}
func both(f: Ref[(string, other: string) -> string]) -> string {
    return f.call("x") + f.call("x", other = "y")
}
let either_int: Ref[(int, other: int) -> int] = ref either
let either_text: Ref[(string, other: string) -> string] = ref either
require either_int.call(1) == 1
require either_int.call(1, other = 5) == 5
require either_text.call("a") == "a"
require either_text.call("a", other = "b") == "b"
require both(ref either) == "xy"
let counted_flags: Ref[(bool, *bool, extra: int) -> int] = ref counted
require counted_flags.call(true, false, true) == 3
require counted_flags.call(true, extra = 10) == 11

# A function reference remembers its function's passing modes, which are no
# part of its type: a call through it passes the caller's place to a
# `modify` or `out` parameter.
record Tally {
    count: int
}
func tally_add(modify tally: Tally, by: int) -> int {
    tally.count += by
    return tally.count
}
func tally_step(modify tally: Tally, by: int = 1) -> int {
    tally.count += by
    return tally.count
}
func tally_set(out tally: Tally, value: int) -> int {
    tally.count = value
    return value
}
let module_add: Ref[(Tally, int) -> int] = ref tally_add
func remembered_modes() {
    var tally: Tally
    tally.count = 1
    let add: Ref[(Tally, int) -> int] = ref tally_add
    require add.call(tally, 2) == 3
    require tally.count == 3
    let inferred = ref tally_add
    require inferred.call(tally, 1) == 4
    require tally.count == 4
    let step: Ref[(Tally, by: int) -> int] = ref tally_step
    require step.call(tally) == 5
    require step.call(tally, by = 5) == 10
    require tally.count == 10
    require module_add.call(tally, 1) == 11
    require tally.count == 11
    # A `let` bound to one remembers what that one does.
    let again = module_add
    require again.call(tally, 1) == 12
    let added = add
    require added.call(tally, 1) == 13
    require tally.count == 13
    var fresh: Tally
    let set: Ref[(Tally, int) -> int] = ref tally_set
    require set.call(fresh, 7) == 7
    require fresh.count == 7
}
remembered_modes()

# A callback's `setup` is given a reference to the handler, which
# remembers the `handler` role's modes: calling it passes the state's place.
callback Tally_Counter {
    call(value: int) -> int
    handler(modify tally: Tally, value: int) -> int
    setup(handler: Ref[(Tally, int) -> int], state: Ref[Tally]) -> nil
}
func setup(handler: Ref[(Tally, int) -> int], state: Ref[Tally]) -> nil {
    var started = state.__value
    _ = handler.call(started, 100)
    state.__value = started
}
func make_counter() -> Tally_Counter {
    var tally: Tally
    tally.count = 0
    return callback[Tally_Counter](ref tally_add, ref tally)
}
require make_counter().call(1) == 101

require imported_join.call("a") == "a,."
require imported_join.call("a", "b", "c") == "a,b,c,."
require imported_join.call("a", "b", zsep = "-") == "a-b-."
require imported_join.call("a", "b", aend = "!") == "a,b!"

__fd_write(2, "ok")
