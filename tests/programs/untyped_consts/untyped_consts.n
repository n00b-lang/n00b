import table_consts

const width = 32
const offset = -5

func takes(x: u32) -> u32 {
    return x
}

func wide(x: u64) -> u64 {
    return x
}

let index: u32 = 3
let size: u64 = table_consts.table_size
let slot: u32 = table_consts.empty_slot
let shifted: i16 = offset
let plain = width
var cells: Array[u8][width] = new[Array[u8][width]]()
var items: Array[char][table_consts.max_items] =
    new[Array[char][table_consts.max_items]]()

require takes(width) == 32
require wide(table_consts.table_size) == 2048
require index < width
require index < table_consts.max_items
require index + width == 35
require index + table_consts.max_items == 21
require (index & width) == 0
require size == 2048
require slot == 0xFFFFFFFF
require shifted == -5
require plain == 32
require __array_length(cells) == 32
require __array_length(items) == 18
__fd_write(2, "ok")
