import sys.os

# sys.os on Linux: file descriptors through direct syscalls, failures as
# sys.os.Errno.

func bytes_of(text: string) -> Array[u8] {
    let length: uint = text.len()
    let bytes: Array[u8] = new[Array[u8]](cast[int](length))
    var i: uint = 0
    while i < length {
        bytes[i] = text.byte_at(i)
        i += 1
    }
    return bytes
}

func round_trip() -> bool fail: sys.os.Errno {
    let pipe: sys.os.Pipe = sys.os.pipe()!
    let sent: Array[u8] = bytes_of("hello, pipe")
    # A partial range: only "pipe" goes through.
    require sys.os.write(pipe.write, sent, 7, 11)! == 4
    let got: Array[u8] = new[Array[u8]](8)
    let count: uint = sys.os.read(pipe.read, got, 2, 8)!
    require count == 4
    require got[2] == sent[7] and got[5] == sent[10]
    sys.os.close(pipe.write)!
    # End of file once the write end is closed.
    require sys.os.read(pipe.read, got, 0, 8)! == 0
    sys.os.close(pipe.read)!
    return true
}

func seek_on_pipe() -> sys.os.Errno? {
    var seen: sys.os.Errno? = nil
    try {
        let pipe: sys.os.Pipe = sys.os.pipe()!
        let position: uint = sys.os.seek(pipe.read, 0, sys.os.Whence.start)!
        require position == 12345
    } fail(e) {
        seen = e
    }
    return seen
}

func write_closed() -> sys.os.Errno? {
    var seen: sys.os.Errno? = nil
    try {
        let pipe: sys.os.Pipe = sys.os.pipe()!
        sys.os.close(pipe.write)!
        let wrote: uint = sys.os.write(pipe.write, bytes_of("x"), 0, 1)!
        require wrote == 12345
    } fail(e) {
        seen = e
    }
    return seen
}

# open: create, write, reopen, read back, and the errors on either side.
func file_round_trip(path: string) -> bool fail: sys.os.Errno {
    let fd: i32 = sys.os.open(path, sys.os.Access.write_only, create = true,
                              truncate = true)!
    let sent: Array[u8] = bytes_of("on disk")
    require sys.os.write(fd, sent, 0, 7)! == 7
    sys.os.close(fd)!
    let again: i32 = sys.os.open(path, sys.os.Access.read_only)!
    let got: Array[u8] = new[Array[u8]](16)
    require sys.os.read(again, got, 0, 16)! == 7
    require got[0] == sent[0] and got[6] == sent[6]
    # The offset can be moved back to the start.
    require sys.os.seek(again, 0, sys.os.Whence.start)! == 0
    sys.os.close(again)!
    return true
}

func open_error(path: string, exclusive: bool) -> sys.os.Errno? {
    var seen: sys.os.Errno? = nil
    try {
        let fd: i32 = sys.os.open(path, sys.os.Access.read_only,
                                  create = exclusive, exclusive = exclusive)!
        require fd == -12345
    } fail(e) {
        seen = e
    }
    return seen
}

# A pipe is not a terminal: is_terminal says so, terminal_size fails.
func terminal_checks() -> bool fail: sys.os.Errno {
    let pipe: sys.os.Pipe = sys.os.pipe()!
    require !sys.os.is_terminal(pipe.read)!
    var seen: sys.os.Errno? = nil
    try {
        let size: sys.os.Terminal_Size = sys.os.terminal_size(pipe.read)!
        require size.rows == 12345
    } fail(e) {
        seen = e
    }
    sys.os.close(pipe.read)!
    sys.os.close(pipe.write)!
    return seen != nil and seen == sys.os.Errno.ENOTTY
}

# random_bytes fills the whole range, past macOS's 256-byte chunks.
func random_checks() -> bool fail: sys.os.Errno {
    let bytes: Array[u8] = new[Array[u8]](1002)
    sys.os.random_bytes(bytes, 1, 1001)!
    var nonzero: uint = 0
    var i: uint = 1
    while i < 1001 {
        if bytes[i] != 0 {
            nonzero += 1
        }
        i += 1
    }
    # 1000 random bytes are all but certain to hold many nonzero ones; the
    # bytes outside the range are untouched.
    return nonzero > 900 and bytes[0] == 0 and bytes[1001] == 0
}

try {
    require round_trip()!
    require file_round_trip("os_io.scratch")!
    require terminal_checks()!
    require random_checks()!
} fail(e) {
    require false
}
let missing: sys.os.Errno? = open_error("no/such/dir/file", false)
require missing != nil and missing == sys.os.Errno.ENOENT
let exists: sys.os.Errno? = open_error("os_io.scratch", true)
require exists != nil and exists == sys.os.Errno.EEXIST
let seek_error: sys.os.Errno? = seek_on_pipe()
require seek_error != nil and seek_error == sys.os.Errno.ESPIPE
let write_error: sys.os.Errno? = write_closed()
require write_error != nil and write_error == sys.os.Errno.EBADF
__fd_write(2, "ok")
