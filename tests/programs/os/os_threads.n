import sys.os
import sys.threads

# sys.os thread control, which stops the world for the collector: a running
# thread is suspended, its registers read, and resumed.

const timeout_ns: u64 = 2_000_000_000

var worker_control: Atomic[uint] = 0
var worker_ticks: Atomic[u64] = 0
var worker_done: Atomic[bool] = false

func worker() {
    __atomic_store(ref worker_control, sys.os.thread_control_self())
    while !__atomic_load(ref worker_done) {
        __atomic_fetch_add(ref worker_ticks, 1)
    }
}

func wait_for_ticks(past: u64) {
    let started: u64 = sys.os.now_ns()
    while __atomic_load(ref worker_ticks) <= past {
        require sys.os.now_ns() - started < timeout_ns
    }
}

func check_suspend() {
    require sys.threads.thread_start(
        callback[sys.threads.Thread_Entry](ref worker))
    let started: u64 = sys.os.now_ns()
    while __atomic_load(ref worker_control) == 0 {
        require sys.os.now_ns() - started < timeout_ns
    }
    wait_for_ticks(1000)
    let control: uint = __atomic_load(ref worker_control)

    var snapshot: sys.threads.Thread_Context
    require sys.os.thread_suspend(control, ref snapshot, timeout_ns) == 0
    require snapshot.sp != nil and snapshot.pc != nil and snapshot.nregs != 0

    # Suspended, the worker counts nothing.
    let stopped: u64 = __atomic_load(ref worker_ticks)
    let paused: u64 = sys.os.now_ns()
    while sys.os.now_ns() - paused < 1_000_000 {
        require sys.os.now_ns() >= paused
    }
    require __atomic_load(ref worker_ticks) == stopped

    require sys.os.thread_resume(control, ref snapshot) == 0
    wait_for_ticks(stopped)
    __atomic_store(ref worker_done, true)
}

check_suspend()
__fd_write(2, "ok")
