import sys.os

# sys.os memory, clock and wait calls, which the collector runs on.

func check_mapping() {
    let page: uint = sys.os.page_size()
    require page >= 4096 and (page & (page - 1)) == 0

    let mapped: Ref[byte]? = sys.os.map_zeroed(page, 0)
    require mapped != nil
    let base: Ref[byte] = mapped
    require __abi_ref_address(base) & (page - 1) == 0
    var i: uint = 0
    while i < page {
        require __gc_byte_offset(base, cast[int](i)).__value == 0
        i += 1
    }
    base.__value = 42
    # Read-only, then read-write again.
    require sys.os.protect(base, page, 1) == 0
    require base.__value == 42
    require sys.os.protect(base, page, 3) == 0
    base.__value = 7
    require sys.os.unmap(base, page) == 0

    # Alignment past the page size.
    var alignment: uint = 65536
    if page > alignment {
        alignment = page
    }
    let wide: Ref[byte]? = sys.os.map_zeroed(alignment * 2, alignment)
    require wide != nil
    let start: Ref[byte] = wide
    require __abi_ref_address(start) & (alignment - 1) == 0
    require sys.os.unmap(start, alignment * 2) == 0

    # Nothing to map, and an alignment that isn't a power of two.
    require sys.os.map_zeroed(0, 0) == nil
    require sys.os.map_zeroed(page, 3) == nil
}

func check_clock() {
    let before: u64 = sys.os.now_ns()
    let after: u64 = sys.os.now_ns()
    require before != 0 and after >= before
    let memory: uint = sys.os.physical_memory()
    require memory != 0 and memory != ~cast[uint](0)
}

func check_wait() {
    let mapped: Ref[byte]? = sys.os.map_zeroed(sys.os.page_size(), 0)
    require mapped != nil
    let base: Ref[byte] = mapped
    let word: Ref[Atomic[u32]] = unsafe_cast[Ref[Atomic[u32]]] base
    # The word isn't 1, so this returns at once.
    _ = sys.os.futex_wait(word, 1, 0)
    # The word is 0: this waits until the 10 ms timeout.
    let started: u64 = sys.os.now_ns()
    _ = sys.os.futex_wait(word, 0, 10000000)
    require sys.os.now_ns() - started >= 1000000
    # Waking with no waiters is fine.
    _ = sys.os.futex_wake_all(word)
    require sys.os.unmap(base, sys.os.page_size()) == 0
}

check_mapping()
check_clock()
check_wait()
__fd_write(2, "ok")
