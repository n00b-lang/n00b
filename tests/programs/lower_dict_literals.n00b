func lower_dict_values() -> Dict[string, int] {
    var values: Dict[string, int] = {"one": 1}
    return values
}

func lower_tagged_dict_values() -> Dict[string, int] {
    var values: Dict[string, int] = {"two": 2}'dict
    return values
}

func lower_empty_tagged_dict() -> Dict[string, int] {
    var values: Dict[string, int] = {}'d
    return values
}
