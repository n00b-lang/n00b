import helper

object Point {
    x: int
}

func __init(self: Point, x: int) {
    self.x = x
}

func __equal(self: Point, other: Point) -> bool {
    return self.x == other.x
}

var points: List[Point] = new[List[Point]]()
points.append(new[Point](1))
require len(points) == 1
require helper.helper_value() == 42
