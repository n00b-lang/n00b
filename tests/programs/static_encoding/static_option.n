record Flags {
    bold: bool?
    width: i16?
    name: string?
}

const set_flags: Flags = (bold = true, width = -4, name = "tag")
const empty_flags: Flags = (bold = nil, width = nil, name = nil)
const limit: u32? = 9

require set_flags.bold.get_or_else(false)
require set_flags.width.get_or_else(0) == -4
require set_flags.name.get_or_else("") == "tag"
require empty_flags.bold == nil and empty_flags.width == nil
require limit.get_or_else(0) == 9
__fd_write(2, "ok")
