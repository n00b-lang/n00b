import static_records

enum Kind {
    none = 0, other, last = 7
}

record Tagged {
    kind: Kind
    count: u8
}

const chosen: Kind = Kind.last
const tagged: Tagged = (kind = Kind.other, count = 3)
const tags: Array[Kind] = [Kind.none, Kind.last]

require chosen == Kind.last
require tagged.kind == Kind.other and tagged.count == 3
require tags[1] == Kind.last

record Outer {
    inner: static_records.Inner
    flag: bool
}

const literal: Outer = (inner = (x = 5, y = false), flag = true)
const referenced: Outer = (inner = static_records.base_inner, flag = false)

require literal.inner.x == 5 and !literal.inner.y and literal.flag
require referenced.inner.x == -1 and referenced.inner.y

record Flags {
    bold: bool?
    width: i16?
    name: string?
}

const set_flags: Flags = (bold = true, width = -4, name = "tag")
const empty_flags: Flags = (bold = nil, width = nil, name = nil)
const limit: u32? = 9

require set_flags.bold.get_or_else(false)
require set_flags.width.get_or_else(0) == -4
require set_flags.name.get_or_else("") == "tag"
require empty_flags.bold == nil and empty_flags.width == nil
require limit.get_or_else(0) == 9
__fd_write(2, "ok")
