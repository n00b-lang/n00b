enum Kind {
    none = 0, other, last = 7
}

record Tagged {
    kind: Kind
    count: u8
}

const chosen: Kind = Kind.last
const tagged: Tagged = (kind = Kind.other, count = 3)
const tags: Array[Kind] = [Kind.none, Kind.last]

require chosen == Kind.last
require tagged.kind == Kind.other and tagged.count == 3
require tags[1] == Kind.last
__fd_write(2, "ok")
