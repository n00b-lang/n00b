type Callback_State {
    count: int
}

callback IO_Callback {
    call(event: int) -> int fail: string
    handler(modify state: Callback_State, event: int) -> int fail: string
    setup(handler: Ref[(modify state: Callback_State, event: int) -> int fail: string],
          state: Ref[Callback_State]) fail: string
}

callback Event_Callback {
    call(event: int) -> int
    handler(event: int) -> int
}

callback Transform_Callback {
    call(value: `T) -> `U fail: `E
    handler(modify state: `S, value: `T) -> `U fail: `E
    setup(handler: Ref[(modify state: `S, value: `T) -> `U fail: `E],
          state: Ref[`S]) -> nil
}

func handle_event(modify state: Callback_State, event: int) -> int fail: string {
    state.count += event
    return state.count
}

func setup(handler: Ref[(modify state: Callback_State, event: int) -> int fail: string],
           state: Ref[Callback_State]) -> nil fail: string {
}

func handle_stateless(event: int) -> int {
    return event
}

func make_callback(modify state: Callback_State) -> IO_Callback fail: string {
    return callback[IO_Callback](ref handle_event, ref state)!
}

func make_local_callback(input: Callback_State) -> IO_Callback fail: string {
    var state: Callback_State = input
    return callback[IO_Callback](ref handle_event, ref state)!
}

func make_stateless() -> Event_Callback {
    return callback[Event_Callback](ref handle_stateless)
}

func invoke_callback(cb: IO_Callback, event: int) -> int fail: string {
    return cb.call(event)!
}

func invoke_stateless(cb: Event_Callback, event: int) -> int {
    return cb.call(event)
}

func copy_and_invoke(cb: Event_Callback, event: int) -> int {
    copy = cb
    return copy.call(event)
}
