record Box {
    value: int
}

var sink: Ref[Box]? = nil

func churn(count: int) -> int {
    var sum = 0
    var i = 0
    while i < count {
        var made: Box = (value = i)
        sink = ref made
        sum += i
        i += 1
    }
    return sum
}

func descend(depth: int, kept: Ref[Box]) -> int {
    var mine: Box = (value = depth)
    let held: Ref[Box] = ref mine
    if depth == 0 {
        return churn(100000) + kept.value
    }
    return descend(depth - 1, held) + held.value
}

func run(rounds: int, depth: int) -> int {
    var total = 0
    var round = 0
    while round < rounds {
        var root: Box = (value = 1)
        total += descend(depth, ref root)
        round += 1
    }
    return total
}

let scale = cast[int](__os_arg_count())
require run(300 * scale, 3000) > 0
