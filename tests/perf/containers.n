func run(rounds: int, size: int) -> int {
    var total = 0
    var round = 0
    while round < rounds {
        var xs: List[int] = []
        var table: Dict[int, int] = {}
        var i = 0
        while i < size {
            xs.append(i)
            table[i] = i * 2
            i += 1
        }
        for x in xs {
            let found = table[x]
            if found != nil {
                total += found.get()
            }
        }
        round += 1
    }
    return total
}

let scale = cast[int](__os_arg_count())
require run(100 * scale, 50000) == 100 * scale * 2499950000
