import sys.os

func run(rounds: int, size: int) -> int {
    var total = 0
    var round = 0
    while round < rounds {
        var items: List[int] = []
        var table: Dict[int, int] = {}
        var i = 0
        while i < size {
            items.append(i)
            table[i] = i * 2
            i += 1
        }
        for item in items {
            let found = table[item]
            if found != nil {
                total += found
            }
        }
        round += 1
    }
    return total
}

let scale = cast[int](sys.os.arg_count())
require run(50 * scale, 200000) == 1999990000000
