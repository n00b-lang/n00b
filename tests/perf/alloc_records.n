record Node {
    value: int
    next:  Ref[Node]?
}

func push(head: Ref[Node]?, value: int) -> Ref[Node] {
    var node: Node = (value = value, next = head)
    return ref node
}

func run(rounds: int, length: int) -> int {
    var total = 0
    var round = 0
    while round < rounds {
        var head: Ref[Node]? = nil
        var i = 0
        while i < length {
            head = push(head, i)
            i += 1
        }
        var cursor: Ref[Node]? = head
        while cursor != nil {
            let node: Ref[Node] = cursor.get()
            total += node.value
            cursor = node.next
        }
        round += 1
    }
    return total
}

let scale = cast[int](__os_arg_count())
require run(2000 * scale, 20000) == 2000 * scale * 199990000
