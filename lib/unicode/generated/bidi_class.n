import sys.fs
import internal.blob

public const bidi_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/bidi_class_stage1.bin")

public inline func bidi_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(bidi_stage1_bytes, i)
}

public const bidi_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/bidi_class_stage2.bin")
