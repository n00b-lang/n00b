import sys.fs
import internal.blob

public const comp_table_size = 2048
public const comp_empty = 0xFFFFFFFF

public const comp_starter_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/comp_starter.bin")

public inline func comp_starter(i: u32) -> u32 {
    return internal.blob.u32_at(comp_starter_bytes, i)
}

public const comp_combining_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/comp_combining.bin")

public inline func comp_combining(i: u32) -> u32 {
    return internal.blob.u32_at(comp_combining_bytes, i)
}

public const comp_result_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/comp_result.bin")

public inline func comp_result(i: u32) -> u32 {
    return internal.blob.u32_at(comp_result_bytes, i)
}

