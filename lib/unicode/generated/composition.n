import internal.blob

const comp_table_size = 2048
const comp_empty = 0xFFFFFFFF

const comp_starter_values: Array[u32] = [- comp_starter.bin -]'embed

inline func comp_starter(i: u32) -> u32 {
    return comp_starter_values[i]
}

const comp_combining_values: Array[u32] = [- comp_combining.bin -]'embed

inline func comp_combining(i: u32) -> u32 {
    return comp_combining_values[i]
}

const comp_result_values: Array[u32] = [- comp_result.bin -]'embed

inline func comp_result(i: u32) -> u32 {
    return comp_result_values[i]
}

