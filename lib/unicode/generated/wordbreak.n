import sys.fs
import internal.blob

public const wb_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/wordbreak_stage1.bin")

public inline func wb_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(wb_stage1_bytes, i)
}

public const wb_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/wordbreak_stage2.bin")
