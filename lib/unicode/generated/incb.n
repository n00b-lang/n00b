import sys.fs
import internal.blob

public const incb_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/incb_stage1.bin")

public inline func incb_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(incb_stage1_bytes, i)
}

public const incb_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/incb_stage2.bin")
