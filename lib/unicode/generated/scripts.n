import sys.fs
import internal.blob

public const script_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/scripts_stage1.bin")

public inline func script_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(script_stage1_bytes, i)
}

public const script_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/scripts_stage2.bin")

public const script_recommended: Array[u8] = sys.fs.data_file(source_dir() + "/scripts_recommended.bin")

public const script_names_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/script_names.bin")

public func script_names(i: u32) -> string {
    return internal.blob.str_at(ref script_names_bytes, i)
}

public const script_count: u32 = 178
