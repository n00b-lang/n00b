import sys.fs
import internal.blob

public const id_status_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/identifiers_stage1.bin")

public inline func id_status_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(id_status_stage1_bytes, i)
}

public const id_status_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/identifiers_stage2.bin")
