import sys.fs
import internal.blob

public const canon_decomp_index_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/canon_decomp_index.bin")

public inline func canon_decomp_index(row: u32, col: u32) -> u32 {
    return internal.blob.u32_at(canon_decomp_index_bytes, row * 2 + col)
}

public const canon_decomp_index_len: u32 = 2081

public const canon_decomp_data_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/canon_decomp_data.bin")

public inline func canon_decomp_data(i: u32) -> u32 {
    return internal.blob.u32_at(canon_decomp_data_bytes, i)
}

public const compat_decomp_index_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/compat_decomp_index.bin")

public inline func compat_decomp_index(row: u32, col: u32) -> u32 {
    return internal.blob.u32_at(compat_decomp_index_bytes, row * 2 + col)
}

public const compat_decomp_index_len: u32 = 5982

public const compat_decomp_data_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/compat_decomp_data.bin")

public inline func compat_decomp_data(i: u32) -> u32 {
    return internal.blob.u32_at(compat_decomp_data_bytes, i)
}

public const max_decomp = 18
