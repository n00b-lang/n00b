import sys.fs
import internal.blob

public const ccc_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/combining_stage1.bin")

public inline func ccc_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(ccc_stage1_bytes, i)
}

public const ccc_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/combining_stage2.bin")
