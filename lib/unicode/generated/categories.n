import sys.fs
import internal.blob

public const gc_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/categories_stage1.bin")

public inline func gc_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(gc_stage1_bytes, i)
}

public const gc_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/categories_stage2.bin")
