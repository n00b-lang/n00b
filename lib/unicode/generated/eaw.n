import sys.fs
import internal.blob

public const eaw_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/eaw_stage1.bin")

public inline func eaw_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(eaw_stage1_bytes, i)
}

public const eaw_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/eaw_stage2.bin")
