import internal.blob

const block_ranges_values: Array[u32] = [- block_ranges.bin -]'embed

inline func block_ranges(row: u32, col: u32) -> u32 {
    return block_ranges_values[row * 2 + col]
}

const block_ids_values: Array[u16] = [- block_ids.bin -]'embed

inline func block_ids(i: u32) -> u16 {
    return block_ids_values[i]
}

const block_count: u32 = 353

const block_names_bytes: Array[u8] = [- block_names.bin -]'embed

func block_names(i: u32) -> string {
    return internal.blob.str_at(ref block_names_bytes, i)
}

