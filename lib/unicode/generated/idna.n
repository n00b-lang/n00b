import sys.fs
import internal.blob

public const idna_status_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/idna_stage1.bin")

public inline func idna_status_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(idna_status_stage1_bytes, i)
}

public const idna_status_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/idna_stage2.bin")
public const idna_map_index_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/idna_map_index.bin")

public inline func idna_map_index(row: u32, col: u32) -> u32 {
    return internal.blob.u32_at(idna_map_index_bytes, row * 2 + col)
}

public const idna_map_index_len: u32 = 6467

public const idna_map_data_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/idna_map_data.bin")

public inline func idna_map_data(i: u32) -> u32 {
    return internal.blob.u32_at(idna_map_data_bytes, i)
}

