import sys.fs
import internal.blob

public const bidi_bracket_index_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/bidi_bracket_index.bin")

public inline func bidi_bracket_index(row: u32, col: u32) -> u32 {
    return internal.blob.u32_at(bidi_bracket_index_bytes, row * 2 + col)
}

public const bidi_bracket_index_len: u32 = 130

public const bidi_bracket_data_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/bidi_bracket_data.bin")

public inline func bidi_bracket_data(i: u32) -> u32 {
    return internal.blob.u32_at(bidi_bracket_data_bytes, i)
}

