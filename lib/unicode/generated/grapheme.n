import sys.fs
import internal.blob

public const gcb_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/grapheme_stage1.bin")

public inline func gcb_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(gcb_stage1_bytes, i)
}

public const gcb_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/grapheme_stage2.bin")
