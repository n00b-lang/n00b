import sys.fs
import internal.blob

public const age_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/age_stage1.bin")

public inline func age_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(age_stage1_bytes, i)
}

public const age_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/age_stage2.bin")

public const age_names_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/age_names.bin")

public func age_names(i: u32) -> string {
    return internal.blob.str_at(ref age_names_bytes, i)
}

public const age_count: u32 = 30
