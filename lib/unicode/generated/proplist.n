import sys.fs
import internal.blob

public const props_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/proplist_stage1.bin")

public inline func props_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(props_stage1_bytes, i)
}

public const props_stage2_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/proplist_stage2.bin")

public inline func props_stage2(i: u32) -> u64 {
    return internal.blob.u64_at(props_stage2_bytes, i)
}

