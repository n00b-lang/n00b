import sys.fs
import internal.blob

public const sb_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/sentbreak_stage1.bin")

public inline func sb_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(sb_stage1_bytes, i)
}

public const sb_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/sentbreak_stage2.bin")
