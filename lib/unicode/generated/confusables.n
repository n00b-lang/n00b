import internal.blob

const confusable_index_values: Array[u32] = [- confusable_index.bin -]'embed

inline func confusable_index(row: u32, col: u32) -> u32 {
    return confusable_index_values[row * 2 + col]
}

const confusable_index_len: u32 = 6712

const confusable_data_values: Array[u32] = [- confusable_data.bin -]'embed

inline func confusable_data(i: u32) -> u32 {
    return confusable_data_values[i]
}

