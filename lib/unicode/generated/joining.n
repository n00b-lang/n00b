import sys.fs
import internal.blob

public const jt_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/joining_stage1.bin")

public inline func jt_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(jt_stage1_bytes, i)
}

public const jt_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/joining_stage2.bin")
