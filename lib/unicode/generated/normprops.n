import sys.fs
import internal.blob

public const nqc_stage1_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/normprops_stage1.bin")

public inline func nqc_stage1(i: u32) -> u16 {
    return internal.blob.u16_at(nqc_stage1_bytes, i)
}

public const nqc_stage2: Array[u8] = sys.fs.data_file(source_dir() + "/normprops_stage2.bin")
