import sys.fs
import internal.blob

public const simple_upper_index_bytes: Array[u8] = sys.fs.data_file(source_dir() + "/simple_upper_index.bin")

public inline func simple_upper_index(row: u32, col: u32) -> u32 {
    return internal.blob.u32_at(simple_upper_index_bytes, row * 2 + col)
}

public const simple_upper_index_len: u32 = 1525

