import internal.types
import internal.encoding
import internal.blob
import generated.categories
import generated.combining
import generated.eaw
import generated.proplist

public const max_cp = 0x110000

func general_category(cp: char) -> internal.types.Gc {
    if cast[u32] cp >= max_cp {
        return internal.types.Gc.cn
    }

    return cast[internal.types.Gc] generated.categories.gc_stage2[
        internal.blob.stage_index(generated.categories.gc_stage1_values, cp)]
}

func combining_class(cp: char) -> u8 {
    if cast[u32] cp >= max_cp {
        return 0
    }

    return generated.combining.ccc_stage2[
        internal.blob.stage_index(generated.combining.ccc_stage1_values, cp)]
}

func east_asian_width(cp: char) -> internal.types.Eaw {
    if cast[u32] cp >= max_cp {
        return internal.types.Eaw.n
    }

    return cast[internal.types.Eaw] generated.eaw.eaw_stage2[
        internal.blob.stage_index(generated.eaw.eaw_stage1_values, cp)]
}

func has_property(cp: char, prop: internal.types.Property) -> bool {
    if cast[u32] cp >= max_cp {
        return false
    }

    let bits: u64 = generated.proplist.props_stage2(
        internal.blob.stage_index(generated.proplist.props_stage1_values, cp))

    return (bits >> cast[u64] prop) & 1 != 0
}

func char_width(cp: char) -> i32 {
    let v: u32 = cast[u32] cp
    if v == 0 {
        return 0
    }

    if v == 0x00ad {
        return 1
    }

    let gc: internal.types.Gc = general_category(cp)

    if gc == internal.types.Gc.cc or gc == internal.types.Gc.cf or
        gc == internal.types.Gc.mn or gc == internal.types.Gc.me or
        gc == internal.types.Gc.mc {
        return 0
    }

    let width: internal.types.Eaw = east_asian_width(cp)

    if width == internal.types.Eaw.w or width == internal.types.Eaw.f {
        return 2
    }

    return 1
}

func display_width(s: string) -> i32 {
    let len: uint = byte_len(s)

    if len == 0 or !is_text(s) {
        return 0
    }

    var width: i32 = 0
    var pos: u32 = 0

    while cast[uint] pos < len {
        try {
            width += char_width(internal.encoding.utf8_decode(s, pos)!)
        } fail(failure) {
            pos = cast[u32] len
        }
    }

    return width
}
