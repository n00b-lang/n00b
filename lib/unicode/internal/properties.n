import internal.types
import internal.encoding
import generated.categories
import generated.combining
import generated.scripts
import generated.blocks
import generated.bidi_class
import generated.eaw
import generated.joining
import generated.proplist
import generated.age
import generated.script_extensions

public const max_cp = 0x110000

private inline func stage_ix(stage1: Array[u16], cp: char) -> u32 {
    let v: u32 = cast[u32] cp
    return cast[u32] stage1[v >> 8] * 256 + (v & 0xff)
}

func general_category(cp: char) -> internal.types.Gc {
    if cast[u32] cp >= max_cp {
        return internal.types.Gc.cn
    }

    return cast[internal.types.Gc] generated.categories.gc_stage2[
        stage_ix(generated.categories.gc_stage1, cp)]
}

func combining_class(cp: char) -> u8 {
    if cast[u32] cp >= max_cp {
        return 0
    }

    return generated.combining.ccc_stage2[
        stage_ix(generated.combining.ccc_stage1, cp)]
}

func script(cp: char) -> internal.types.Script {
    if cast[u32] cp >= max_cp {
        return 0
    }

    return cast[internal.types.Script] generated.scripts.script_stage2[
        stage_ix(generated.scripts.script_stage1, cp)]
}

func script_name(s: internal.types.Script) -> string {
    if cast[u32] s >= generated.scripts.script_count {
        return "Unknown"
    }

    return generated.scripts.script_names[s]
}

func block(cp: char) -> internal.types.Block {
    let v: u32 = cast[u32] cp
    var lo: u32 = 0
    var hi: u32 = generated.blocks.block_count

    while lo < hi {
        let mid: u32 = lo + (hi - lo) / 2

        if v < generated.blocks.block_ranges[mid][0] {
            hi = mid
        }
        else {
            if v > generated.blocks.block_ranges[mid][1] {
                lo = mid + 1
            }
            else {
                return cast[internal.types.Block] generated.blocks.block_ids[mid]
            }
        }
    }

    return 0
}

func block_name(b: internal.types.Block) -> string {
    if cast[u32] b > generated.blocks.block_count {
        return "No_Block"
    }

    return generated.blocks.block_names[b]
}

func bidi_class(cp: char) -> internal.types.Bidi_Class {
    if cast[u32] cp >= max_cp {
        return internal.types.Bidi_Class.l
    }

    return cast[internal.types.Bidi_Class] generated.bidi_class.bidi_stage2[
        stage_ix(generated.bidi_class.bidi_stage1, cp)]
}

func east_asian_width(cp: char) -> internal.types.Eaw {
    if cast[u32] cp >= max_cp {
        return internal.types.Eaw.n
    }

    return cast[internal.types.Eaw] generated.eaw.eaw_stage2[
        stage_ix(generated.eaw.eaw_stage1, cp)]
}

func joining_type(cp: char) -> internal.types.Joining_Type {
    if cast[u32] cp >= max_cp {
        return internal.types.Joining_Type.u
    }

    return cast[internal.types.Joining_Type] generated.joining.jt_stage2[
        stage_ix(generated.joining.jt_stage1, cp)]
}

func has_property(cp: char, prop: internal.types.Property) -> bool {
    if cast[u32] cp >= max_cp {
        return false
    }

    let bits: u64 = generated.proplist.props_stage2[
        stage_ix(generated.proplist.props_stage1, cp)]

    return (bits >> cast[u64] prop) & 1 != 0
}

func age(cp: char) -> internal.types.Age {
    if cast[u32] cp >= max_cp {
        return 0
    }

    return cast[internal.types.Age] generated.age.age_stage2[
        stage_ix(generated.age.age_stage1, cp)]
}

func age_name(a: internal.types.Age) -> string {
    if cast[u32] a >= generated.age.age_count {
        return "Unassigned"
    }

    return generated.age.age_names[a]
}

func char_width(cp: char) -> i32 {
    let v: u32 = cast[u32] cp
    if v == 0 {
        return 0
    }

    if v == 0x00ad {
        return 1
    }

    let gc: internal.types.Gc = general_category(cp)

    if gc == internal.types.Gc.cc or gc == internal.types.Gc.cf or
        gc == internal.types.Gc.mn or gc == internal.types.Gc.me or
        gc == internal.types.Gc.mc {
        return 0
    }

    let width: internal.types.Eaw = east_asian_width(cp)

    if width == internal.types.Eaw.w or width == internal.types.Eaw.f {
        return 2
    }

    return 1
}

func display_width(s: string) -> i32 {
    let len: uint = byte_len(s)

    if len == 0 or !is_text(s) {
        return 0
    }

    var width: i32 = 0
    var pos: u32 = 0

    while cast[uint] pos < len {
        try {
            width += char_width(internal.encoding.utf8_decode(s, pos)!)
        } else failure {
            pos = cast[u32] len
        }
    }

    return width
}

private func sparse_lookup(index: Array[Array[u32]], index_len: u32,
                           cp: char) -> u32? {
    let v: u32 = cast[u32] cp
    var lo: u32 = 0
    var hi: u32 = index_len

    while lo < hi {
        let mid: u32 = lo + (hi - lo) / 2

        if index[mid][0] < v {
            lo = mid + 1
        }
        else {
            if index[mid][0] > v {
                hi = mid
            }
            else {
                return index[mid][1]
            }
        }
    }

    return nil
}

func script_extensions(cp: char, modify scripts: Array[internal.types.Script],
                       max_scripts: i32) -> i32 {
    if cast[u32] cp >= max_cp or max_scripts <= 0 {
        return 0
    }

    let off: u32? = sparse_lookup(generated.script_extensions.script_ext_index,
        generated.script_extensions.script_ext_index_len, cp)

    if off == nil {
        scripts[0] = script(cp)
        return 1
    }

    let at: u32 = off.get()
    let count: i32 = cast[i32] generated.script_extensions.script_ext_data[at]
    var n: i32 = max_scripts
    if count < max_scripts {
        n = count
    }

    var i: i32 = 0
    while i < n {
        let entry: u32 = generated.script_extensions.script_ext_data[
            at + 1 + cast[u32] i]
        scripts[cast[uint] i] = cast[internal.types.Script] entry
        i += 1
    }

    return n
}
