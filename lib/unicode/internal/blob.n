inline func u32_at(data: Array[u8], i: u32) -> u32 {
    let b: u32 = i * 4
    return cast[u32] data[b] | (cast[u32] data[b + 1] << 8) |
        (cast[u32] data[b + 2] << 16) | (cast[u32] data[b + 3] << 24)
}

inline func stage_index(stage1: Array[u16], cp: char) -> u32 {
    let v: u32 = cast[u32] cp
    return cast[u32] stage1[v >> 8] * 256 + (v & 0xff)
}

func sparse_lookup(index: Array[u32], index_len: u32, cp: char) -> u32? {
    let v: u32 = cast[u32] cp
    var lo: u32 = 0
    var hi: u32 = index_len

    while lo < hi {
        let mid: u32 = lo + (hi - lo) / 2

        if index[mid * 2] < v {
            lo = mid + 1
        }
        else {
            if index[mid * 2] > v {
                hi = mid
            }
            else {
                return index[mid * 2 + 1]
            }
        }
    }

    return nil
}

func str_at(data: Ref[Array[u8]], i: u32) -> string {
    let start: u32 = u32_at(data.__value, i)
    let end: u32 = u32_at(data.__value, i + 1)
    return from_raw(data, cast[int] (end - start), at = cast[uint] start,
                    copy = false, encoding = Str_Encoding.utf8)
}
