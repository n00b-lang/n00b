import builtin.gc
import builtin.gc.collect
import builtin.gc.finalize
import builtin.gc.hash
import builtin.gc.mark
import builtin.gc.registry
import builtin.gc.sync
import builtin.os

enum Response_Mode { self, stopped, blocked }
const max_rounds: u32 = 8

public func reserve_own_hole(bump: Ref[builtin.gc.Bump], epoch: u32) {
    let candidate: Ref[builtin.gc.Block_Metadata]? = bump.blk
    let cursor: Ref[byte]? = bump.cursor
    let limit: Ref[byte]? = bump.limit
    if candidate != nil {
        let base: Ref[byte] = builtin.gc.block_base(candidate.get())
        if cursor != nil {
            let start: Ref[byte] = cursor.get()
            if limit != nil {
                let end: Ref[byte] = limit.get()
                if __gc_byte_diff(end, start) <= 0 { return }
                let first: uint = cast[uint](__gc_byte_diff(start, base)) / builtin.gc.line_bytes
                let last: uint = cast[uint](__gc_byte_diff(end, base) - 1) / builtin.gc.line_bytes
                builtin.gc.mark_lines(base, first * builtin.gc.line_bytes,
                                      (last - first + 1) * builtin.gc.line_bytes, epoch)
            }
        }
    }
}

func sweep_if_stale(heap: Ref[builtin.gc.Heap],
                    candidate: Ref[builtin.gc.Block_Metadata]?, epoch: u32) {
    if candidate != nil {
        let block: Ref[builtin.gc.Block_Metadata] = candidate.get()
        if block.state == cast[u8](builtin.gc.Block_State.owned) and
            block.sweep_epoch != epoch {
            builtin.gc.collect.sweep_block(heap, block, epoch)
        }
    }
}

func sweep_bump(heap: Ref[builtin.gc.Heap], bump: Ref[builtin.gc.Bump],
                epoch: u32) {
    sweep_if_stale(heap, bump.blk, epoch)
    var candidate: Ref[builtin.gc.Block_Metadata]? = __atomic_load(ref bump.cache)
    while candidate != nil {
        let block: Ref[builtin.gc.Block_Metadata] = candidate.get()
        sweep_if_stale(heap, candidate, epoch)
        candidate = block.next
    }
}

public func sweep_own_blocks(heap: Ref[builtin.gc.Heap],
                             mutator: Ref[builtin.gc.Mutator], epoch: u32) {
    reserve_own_hole(ref mutator.small, epoch)
    reserve_own_hole(ref mutator.overflow, epoch)
    sweep_bump(heap, ref mutator.small, epoch)
    sweep_bump(heap, ref mutator.overflow, epoch)
}

func sweep_stopped_blocks(heap: Ref[builtin.gc.Heap],
                          mutator: Ref[builtin.gc.Mutator],
                          marker: Ref[builtin.gc.Marker], epoch: u32) {
    builtin.gc.collect.reserve_bump(marker, ref mutator.small, true)
    builtin.gc.collect.reserve_bump(marker, ref mutator.overflow, true)
    var current: Ref[builtin.gc.Block_Metadata]? = heap.owned
    while current != nil {
        let block: Ref[builtin.gc.Block_Metadata] = current.get()
        let owner: Ref[builtin.gc.Mutator]? = block.owner
        if owner != nil {
            if owner.get() == mutator { sweep_if_stale(heap, current, epoch) }
        }
        current = block.own_next
    }
}

func respond(heap: Ref[builtin.gc.Heap], mutator: Ref[builtin.gc.Mutator],
             kind: u32, mode: Response_Mode) {
    var marker: builtin.gc.Marker
    builtin.gc.mark.marker_init(ref marker, heap, false)
    let stopped: bool = mode == Response_Mode.stopped

    if kind == cast[u32](builtin.gc.Handshake_Kind.on) {
        mutator.black = true
        let small: Ref[builtin.gc.Block_Metadata]? = mutator.small.blk
        if small != nil {
            builtin.gc.raise_black(small.get(),
                heap.mark_epoch)
        }
        let overflow: Ref[builtin.gc.Block_Metadata]? = mutator.overflow.blk
        if overflow != nil {
            builtin.gc.raise_black(overflow.get(),
                heap.mark_epoch)
        }
        if stopped { builtin.gc.collect.mark_thread_roots(ref marker, mutator, true) }
    } elif kind == cast[u32](builtin.gc.Handshake_Kind.scan) {
        if mutator.write_buffer_epoch == heap.mark_epoch {
            var index: uint = 0
            while index < mutator.write_buffer_count {
                builtin.gc.mark.mark_object(ref marker,
                    ref_read(ref mutator.write_buffer[cast[int](index)]))
                index += 1
            }
        }
        mutator.write_buffer_count = 0
        if stopped {
            builtin.gc.collect.reserve_bump(ref marker, ref mutator.small, true)
            builtin.gc.collect.reserve_bump(ref marker, ref mutator.overflow, true)
        }
        if mode == Response_Mode.self and heap.cfg.scan_stacks {
            builtin.gc.registry.registry_read_lock(heap)
            builtin.gc.collect.mark_thread_roots(ref marker, mutator, false)
            builtin.gc.registry.registry_read_unlock(heap)
        } else {
            builtin.gc.collect.mark_thread_roots(ref marker, mutator, stopped)
        }
    } elif kind == cast[u32](builtin.gc.Handshake_Kind.sweep) {
        if stopped {
            sweep_stopped_blocks(heap, mutator, ref marker, heap.epoch)
        } else {
            sweep_own_blocks(heap, mutator, heap.epoch)
        }
        mutator.black = false
        mutator.write_buffer_count = 0
    } else {
        require false
    }

    builtin.gc.mark.marker_flush(ref marker)
    if marker.marked != 0 and
        kind == cast[u32](builtin.gc.Handshake_Kind.scan) {
        __atomic_store(ref heap.round_dirty, true)
    }
    builtin.gc.mark.marker_stats(ref marker)
}

public func safepoint(mutator: Ref[builtin.gc.Mutator]) {
    let requested: u32 = cast[u32](builtin.gc.Handshake_State.requested)
    let busy: u32 = cast[u32](builtin.gc.Handshake_State.busy)
    if __atomic_load(ref mutator.hs_state) != requested or
        !__atomic_compare_exchange(ref mutator.hs_state, requested, busy) {
        return
    }
    let heap: Ref[builtin.gc.Heap] = mutator.heap
    respond(heap, mutator, __atomic_load(ref heap.hs_kind), Response_Mode.self)
    __atomic_store(ref mutator.hs_state,
        cast[u32](builtin.gc.Handshake_State.done))
    __atomic_fetch_sub(ref heap.hs_pending, 1)
    builtin.gc.sync.event_signal(ref heap.hs_answered)
}

public func enter_blocking(mutator: Ref[builtin.gc.Mutator]) {
    builtin.os.thread_capture_self(ref mutator.captured)
    mutator.blocked_sp = mutator.captured.sp
    __atomic_store(ref mutator.blocking, 1)
    safepoint(mutator)
}

public func leave_blocking(mutator: Ref[builtin.gc.Mutator]) {
    while true {
        let seq: u32 = builtin.gc.sync.event_enter(ref mutator.unblocked)
        if __atomic_compare_exchange(ref mutator.blocking, 1, 0) {
            builtin.gc.sync.event_leave(ref mutator.unblocked)
            break
        }
        builtin.gc.sync.event_sleep(ref mutator.unblocked, seq)
        builtin.gc.sync.event_leave(ref mutator.unblocked)
    }
    safepoint(mutator)
}

func cycle_pending(heap: Ref[builtin.gc.Heap]) -> bool {
    return __atomic_load(ref heap.cycle_active) or
        (__atomic_load(ref heap.cycle_requested) and
         __atomic_load(ref heap.nworkers) != 0)
}

public func wait_for_cycle(heap: Ref[builtin.gc.Heap]) {
    builtin.gc.sync.ticket_lock(ref heap.lock)
    let found: Ref[byte]? = builtin.gc.hash.tab_lookup(
        ref heap.threads, builtin.os.thread_id())
    builtin.gc.sync.ticket_unlock(ref heap.lock)

    var mine: Ref[builtin.gc.Mutator]? = nil
    if found != nil {
        let first: Ref[builtin.gc.Mutator] = builtin.gc.thread_index_mutator(
            found.get(), builtin.os.thread_id())
        var current: Ref[builtin.gc.Mutator] = first
        while true {
            if __atomic_load(ref current.blocking) == 0 {
                current.wait_next = mine
                mine = current
            }
            let next: Ref[builtin.gc.Mutator]? = current.thread_next
            if next == nil { break }
            if next.get() == first { break }
            current = next.get()
        }
    }

    var current: Ref[builtin.gc.Mutator]? = mine
    while current != nil {
        let mutator: Ref[builtin.gc.Mutator] = current.get()
        enter_blocking(mutator)
        current = mutator.wait_next
    }
    while true {
        let seq: u32 = builtin.gc.sync.event_enter(ref heap.cycle_ended)
        if !cycle_pending(heap) {
            builtin.gc.sync.event_leave(ref heap.cycle_ended)
            break
        }
        builtin.gc.sync.event_sleep(ref heap.cycle_ended, seq)
        builtin.gc.sync.event_leave(ref heap.cycle_ended)
    }
    current = mine
    while current != nil {
        let mutator: Ref[builtin.gc.Mutator] = current.get()
        leave_blocking(mutator)
        current = mutator.wait_next
    }
}

func any_pending(heap: Ref[builtin.gc.Heap]) -> bool {
    return __atomic_load(ref heap.hs_pending) != 0
}

public func handshake(heap: Ref[builtin.gc.Heap], kind: builtin.gc.Handshake_Kind) {
    let started: u64 = builtin.os.now_ns()
    var claimed: uint = 0

    builtin.gc.sync.ticket_lock(ref heap.lock)
    __atomic_store(ref heap.hs_kind, cast[u32](kind))
    heap.hs_active = true
    __atomic_store(ref heap.hs_pending, cast[u32](heap.nmutators))
    var current: Ref[builtin.gc.Mutator]? = heap.mutators
    while current != nil {
        let mutator: Ref[builtin.gc.Mutator] = current.get()
        __atomic_store(ref mutator.hs_state,
            cast[u32](builtin.gc.Handshake_State.requested))
        current = mutator.next
    }
    current = heap.mutators
    while current != nil {
        let mutator: Ref[builtin.gc.Mutator] = current.get()
        if __atomic_compare_exchange(ref mutator.blocking, 1, 2) {
            let requested: u32 = cast[u32](builtin.gc.Handshake_State.requested)
            if __atomic_compare_exchange(ref mutator.hs_state, requested,
                cast[u32](builtin.gc.Handshake_State.claimed)) {
                respond(heap, mutator, cast[u32](kind), Response_Mode.blocked)
                __atomic_store(ref mutator.hs_state,
                    cast[u32](builtin.gc.Handshake_State.done))
                __atomic_fetch_sub(ref heap.hs_pending, 1)
                heap.hs_blocking += 1
            }
            __atomic_store(ref mutator.blocking, 1)
            builtin.gc.sync.event_signal(ref mutator.unblocked)
        }
        current = mutator.next
    }
    builtin.gc.sync.ticket_unlock(ref heap.lock)

    let limit: u64 = cast[u64](heap.cfg.handshake_timeout_us) * 1000
    while true {
        let seq: u32 = builtin.gc.sync.event_enter(ref heap.hs_answered)
        let waited: u64 = builtin.os.now_ns() - started
        if !any_pending(heap) or waited >= limit {
            builtin.gc.sync.event_leave(ref heap.hs_answered)
            break
        }
        builtin.gc.sync.event_sleep(ref heap.hs_answered, seq)
        builtin.gc.sync.event_leave(ref heap.hs_answered)
    }

    builtin.gc.sync.ticket_lock(ref heap.lock)
    current = heap.mutators
    while current != nil {
        let mutator: Ref[builtin.gc.Mutator] = current.get()
        if __atomic_compare_exchange(ref mutator.hs_state,
            cast[u32](builtin.gc.Handshake_State.requested),
            cast[u32](builtin.gc.Handshake_State.claimed)) {
            claimed += 1
        }
        current = mutator.next
    }
    current = heap.mutators
    while current != nil {
        let mutator: Ref[builtin.gc.Mutator] = current.get()
        while __atomic_load(ref mutator.hs_state) == cast[u32](builtin.gc.Handshake_State.busy) {
            let seq: u32 = builtin.gc.sync.event_enter(ref heap.hs_answered)
            if __atomic_load(ref mutator.hs_state) == cast[u32](builtin.gc.Handshake_State.busy) {
                builtin.gc.sync.event_sleep(ref heap.hs_answered, seq)
            }
            builtin.gc.sync.event_leave(ref heap.hs_answered)
        }
        current = mutator.next
    }
    if claimed != 0 {
        builtin.gc.collect.stop_world(heap)
        current = heap.mutators
        while current != nil {
            let mutator: Ref[builtin.gc.Mutator] = current.get()
            if __atomic_load(ref mutator.hs_state) == cast[u32](builtin.gc.Handshake_State.claimed) {
                respond(heap, mutator, cast[u32](kind), Response_Mode.stopped)
                __atomic_store(ref mutator.hs_state,
                    cast[u32](builtin.gc.Handshake_State.done))
                __atomic_fetch_sub(ref heap.hs_pending, 1)
            }
            current = mutator.next
        }
        builtin.gc.collect.start_world(heap)
        heap.hs_stragglers += cast[u64](claimed)
    }
    require __atomic_load(ref heap.hs_pending) == 0
    current = heap.mutators
    while current != nil {
        let mutator: Ref[builtin.gc.Mutator] = current.get()
        __atomic_store(ref mutator.hs_state,
            cast[u32](builtin.gc.Handshake_State.idle))
        current = mutator.next
    }
    heap.hs_active = false
    builtin.gc.sync.ticket_unlock(ref heap.lock)
}

func help_until_quiescent(heap: Ref[builtin.gc.Heap]) {
    var marker: builtin.gc.Marker
    builtin.gc.mark.marker_init(ref marker, heap, false)
    builtin.gc.mark.drain_to_termination(ref marker)
    builtin.gc.mark.marker_stats(ref marker)
}

public func run_handshake_cycle(heap: Ref[builtin.gc.Heap]) {
    builtin.gc.sync.ticket_lock(ref heap.lock)
    if __atomic_load(ref heap.phase) == cast[u32](builtin.gc.Phase.marking) {
        builtin.gc.sync.ticket_unlock(ref heap.lock)
        return
    }
    builtin.gc.collect.begin_epoch_locked(heap)
    var owned: Ref[builtin.gc.Block_Metadata]? = heap.owned
    while owned != nil {
        let block: Ref[builtin.gc.Block_Metadata] = owned.get()
        if block.state == cast[u8](builtin.gc.Block_State.owned) {
            builtin.gc.ensure_mark_epoch(
                builtin.gc.block_base(block), heap.mark_epoch)
        }
        owned = block.own_next
    }
    heap.black_alloc = true
    __atomic_store(ref heap.marking, true)
    __atomic_store(ref heap.phase, cast[u32](builtin.gc.Phase.marking))
    builtin.gc.sync.ticket_unlock(ref heap.lock)

    handshake(heap, builtin.gc.Handshake_Kind.on)
    var marker: builtin.gc.Marker
    builtin.gc.mark.marker_init(ref marker, heap, false)
    builtin.gc.sync.ticket_lock(ref heap.lock)
    builtin.gc.collect.mark_global_roots(ref marker)
    builtin.gc.finalize.mark_locked(ref marker)
    builtin.gc.sync.ticket_unlock(ref heap.lock)
    builtin.gc.mark.marker_flush(ref marker)
    builtin.gc.mark.marker_stats(ref marker)

    var round: u32 = 0
    while true {
        help_until_quiescent(heap)
        if round >= max_rounds {
            builtin.gc.sync.ticket_lock(ref heap.lock)
            heap.cycle.kind = 2
            builtin.gc.collect.finish_cycle(heap, false)
            heap.hs_fallbacks += 1
            builtin.gc.sync.ticket_unlock(ref heap.lock)
            heap.hs_cycles += 1
            return
        }
        __atomic_store(ref heap.round_dirty, false)
        handshake(heap, builtin.gc.Handshake_Kind.scan)

        builtin.gc.mark.marker_init(ref marker, heap, false)
        builtin.gc.sync.ticket_lock(ref heap.lock)
        builtin.gc.collect.mark_global_roots(ref marker)
        builtin.gc.mark.barrier_queue_drain(ref marker)
        builtin.gc.finalize.mark_locked(ref marker)
        builtin.gc.sync.ticket_unlock(ref heap.lock)
        builtin.gc.mark.marker_flush(ref marker)
        if marker.marked != 0 {
            __atomic_store(ref heap.round_dirty, true)
        }
        builtin.gc.mark.marker_stats(ref marker)
        help_until_quiescent(heap)
        heap.hs_rounds += 1
        if !__atomic_load(ref heap.round_dirty) { break }
        round += 1
    }

    builtin.gc.mark.marker_init(ref marker, heap, false)
    builtin.gc.sync.ticket_lock(ref heap.lock)
    builtin.gc.finalize.find_dead_locked(ref marker)
    builtin.gc.sync.ticket_unlock(ref heap.lock)
    builtin.gc.mark.marker_flush(ref marker)
    builtin.gc.mark.marker_stats(ref marker)
    help_until_quiescent(heap)

    builtin.gc.sync.ticket_lock(ref heap.lock)
    heap.sweep_ready = false
    builtin.gc.collect.end_epoch_locked(heap)
    builtin.gc.sync.ticket_unlock(ref heap.lock)

    handshake(heap, builtin.gc.Handshake_Kind.sweep)

    builtin.gc.sync.ticket_lock(ref heap.lock)
    builtin.gc.collect.prune_owned(heap, false)
    heap.sweep_ready = true
    heap.cycle.kind = 1
    heap.cycle.duration_ns = builtin.os.now_ns() - heap.cycle_start
    heap.cycle.rounds = cast[u32](heap.hs_rounds) - heap.cycle.rounds
    heap.cycle.stragglers = cast[u32](heap.hs_stragglers) - heap.cycle.stragglers
    builtin.gc.sync.ticket_unlock(ref heap.lock)

    heap.hs_cycles += 1
    builtin.gc.sync.event_signal(ref heap.work_progress)
}
