import builtin.abi
import builtin.gc
import builtin.gc.hash
import builtin.gc.sync

const reg_writer: u32 = 1 << 31
const los_min_level: u32 = 12
const los_scaled_from: u32 = 20
const los_level_bits: uint = 6

public func registry_read_lock(heap: Ref[builtin.gc.Heap]) {
    while true {
        let seq: u32 = builtin.gc.sync.event_enter(ref heap.reg_changed)
        let state: u32 = __atomic_load(ref heap.reg_rw)
        if (state & reg_writer) == 0 {
            if __atomic_compare_exchange(ref heap.reg_rw, state, state + 1) {
                builtin.gc.sync.event_leave(ref heap.reg_changed)
                return
            }
            builtin.gc.sync.event_leave(ref heap.reg_changed)
        } else {
            builtin.gc.sync.event_sleep(ref heap.reg_changed, seq)
            builtin.gc.sync.event_leave(ref heap.reg_changed)
        }
    }
}

public func registry_read_unlock(heap: Ref[builtin.gc.Heap]) {
    if __atomic_fetch_sub(ref heap.reg_rw, 1) == (reg_writer | 1) {
        builtin.gc.sync.event_signal(ref heap.reg_changed)
    }
}

func write_lock(heap: Ref[builtin.gc.Heap]) {
    __atomic_fetch_or(ref heap.reg_rw, reg_writer)
    while true {
        let seq: u32 = builtin.gc.sync.event_enter(ref heap.reg_changed)
        if __atomic_load(ref heap.reg_rw) == reg_writer {
            builtin.gc.sync.event_leave(ref heap.reg_changed)
            return
        }
        builtin.gc.sync.event_sleep(ref heap.reg_changed, seq)
        builtin.gc.sync.event_leave(ref heap.reg_changed)
    }
}

func write_unlock(heap: Ref[builtin.gc.Heap]) {
    __atomic_fetch_and(ref heap.reg_rw, ~reg_writer)
    builtin.gc.sync.event_signal(ref heap.reg_changed)
}

func widen_bounds(heap: Ref[builtin.gc.Heap], start: uint, end: uint) {
    if heap.heap_lo == 0 or start < heap.heap_lo { heap.heap_lo = start }
    if end > heap.heap_hi { heap.heap_hi = end }
}

public func region_add(heap: Ref[builtin.gc.Heap], start: Ref[byte],
                       end: Ref[byte]) -> bool {
    let start_address: uint = __abi_ref_address(start)
    let end_address: uint = __abi_ref_address(end)
    let n: uint = (end_address - start_address) / builtin.gc.block_bytes
    write_lock(heap)
    if !builtin.gc.hash.tab_reserve(ref heap.blocks, n) {
        write_unlock(heap)
        return false
    }
    var address: uint = start_address
    while address < end_address {
        assert builtin.gc.hash.tab_lookup(ref heap.blocks,
                                          address / builtin.gc.block_bytes) == nil
        let block: Ref[byte] = __gc_byte_offset(start, address - start_address)
        builtin.gc.hash.tab_insert(ref heap.blocks,
                                   address / builtin.gc.block_bytes, block)
        address += builtin.gc.block_bytes
    }
    widen_bounds(heap, start_address, end_address)
    write_unlock(heap)
    return true
}

public func region_release_block(heap: Ref[builtin.gc.Heap],
                                 block: Ref[builtin.gc.Block_Metadata]) {
    let address: uint = __abi_ref_address(block)
    write_lock(heap)
    builtin.gc.hash.tab_delete(ref heap.blocks,
        address / builtin.gc.block_bytes, builtin.gc.block_base(block))
    write_unlock(heap)
}

public func region_set_type(heap: Ref[builtin.gc.Heap],
                            header: Ref[builtin.gc.Object_Header],
                            type_index: u32) {
    write_lock(heap)
    header.type_index = type_index
    write_unlock(heap)
}

public func regions_free(heap: Ref[builtin.gc.Heap]) {
    builtin.gc.hash.tab_free(ref heap.blocks)
    builtin.gc.hash.tab_free(ref heap.large)
}

func highest_bit(value: uint) -> u32 {
    require value != 0
    return cast[u32](builtin.gc.word_bits - 1) - __count_leading_zeros(value)
}

func los_level(bytes: uint) -> u32 {
    let level: u32 = highest_bit(bytes)
    if level < los_scaled_from { return los_min_level }
    return level - 4
}

func los_key(address: uint, level: u32) -> uint {
    return ((address >> level) << los_level_bits) | cast[uint] level
}

func los_table_value(object: Ref[builtin.gc.Los_Obj]) -> Ref[byte] {
    require (object.hdr.meta & builtin.gc.obj_large) != 0
    return unsafe_cast[Ref[byte]] object
}

public func los_register(heap: Ref[builtin.gc.Heap],
                         object: Ref[builtin.gc.Los_Obj]) -> bool {
    let level: u32 = los_level(object.bytes)
    let start: uint = __abi_ref_address(object)
    let last: uint = start + object.bytes - 1
    write_lock(heap)
    if !builtin.gc.hash.tab_reserve(ref heap.large,
                                    (last >> level) - (start >> level) + 1) {
        write_unlock(heap)
        return false
    }
    var granule: uint = start >> level
    while granule <= last >> level {
        builtin.gc.hash.tab_insert(ref heap.large,
            los_key(granule << level, level),
            los_table_value(object))
        granule += 1
    }
    let index: int = cast[int] level
    let count_cell: Ref[uint] = ref heap.los_level_n[index]
    var count: uint = ref_read(count_cell)
    count += 1
    ref_write(count_cell, count)
    let bit: uint = 1
    heap.los_levels = heap.los_levels | (bit << level)
    widen_bounds(heap, start, start + object.bytes)
    write_unlock(heap)
    return true
}

public func los_unregister(heap: Ref[builtin.gc.Heap],
                           object: Ref[builtin.gc.Los_Obj]) {
    let level: u32 = los_level(object.bytes)
    let start: uint = __abi_ref_address(object)
    let last: uint = start + object.bytes - 1
    write_lock(heap)
    var granule: uint = start >> level
    while granule <= last >> level {
        builtin.gc.hash.tab_delete(ref heap.large,
            los_key(granule << level, level),
            los_table_value(object))
        granule += 1
    }
    let index: int = cast[int] level
    let count_cell: Ref[uint] = ref heap.los_level_n[index]
    var count: uint = ref_read(count_cell)
    count -= 1
    ref_write(count_cell, count)
    if count == 0 {
        let bit: uint = 1
        heap.los_levels = heap.los_levels & ~(bit << level)
    }
    write_unlock(heap)
}

public func los_find(heap: Ref[builtin.gc.Heap], address: uint) -> Ref[builtin.gc.Los_Obj]? {
    let table: Ref[builtin.gc.hash.Hash_Tab] = ref heap.large
    var levels: uint = heap.los_levels
    if levels == 0 { return nil }
    let slots: Ref[builtin.gc.hash.Hash_Slot] = builtin.gc.hash.tab_slots(table)
    let stride: uint = builtin.abi.size_bytes(builtin.gc.hash.hash_slot_record())
    let bit: uint = 1
    let mask: uint = (bit << table.bits) - 1
    while levels != 0 {
        let level: u32 = __count_trailing_zeros(levels)
        let key: uint = los_key(address, level)
        var index: uint = builtin.gc.hash.tab_home(table, key)
        while true {
            let slot: Ref[builtin.gc.hash.Hash_Slot] = builtin.gc.hash.hash_slot_at(slots, index, stride)
            let candidate: Ref[byte]? = slot.val
            if candidate != nil {
                if slot.key == key {
                    let object: Ref[builtin.gc.Los_Obj] = unsafe_cast[Ref[builtin.gc.Los_Obj]] candidate.get()
                    let start: uint = __abi_ref_address(object)
                    if address >= start and address - start < object.bytes {
                        return object
                    }
                }
                index = (index + 1) & mask
            } else { break }
        }
        levels = levels & (levels - 1)
    }
    return nil
}

func find_block_object(base: Ref[byte], address: uint) -> Ref[builtin.gc.Object_Header]? {
    let offset: uint = address - __abi_ref_address(base)
    let header_bytes: uint = builtin.gc.header_lines() * builtin.gc.line_bytes
    let header_granules: uint = header_bytes / builtin.gc.granule_bytes
    if offset < header_granules * builtin.gc.granule_bytes { return nil }

    let granule: uint = offset / builtin.gc.granule_bytes
    var word: uint = granule / builtin.gc.word_bits
    var bits: u64 = __atomic_load_relaxed(builtin.gc.start_word_at(base, word))
    let bit: uint = granule % builtin.gc.word_bits
    if bit != builtin.gc.word_bits - 1 {
        bits = bits & ((cast[u64](1) << (bit + 1)) - 1)
    }
    while bits == 0 {
        if word == header_granules / builtin.gc.word_bits { return nil }
        word -= 1
        bits = __atomic_load_relaxed(builtin.gc.start_word_at(base, word))
    }

    let start: uint = word * builtin.gc.word_bits + cast[uint](highest_bit(cast[uint](bits)))
    if start < header_granules { return nil }
    let header: Ref[builtin.gc.Object_Header] = builtin.gc.block_object_header_at(
        base, start * builtin.gc.granule_bytes)
    let bytes: uint = builtin.gc.object_bytes(header)
    let granule_bytes: uint = builtin.gc.granule_bytes
    let rounded: uint = (bytes + granule_bytes - 1) / granule_bytes * granule_bytes
    if offset >= start * builtin.gc.granule_bytes + rounded { return nil }
    return header
}

public func find_object(heap: Ref[builtin.gc.Heap], address: uint) -> Ref[builtin.gc.Object_Header]? {
    if address < heap.heap_lo or address >= heap.heap_hi { return nil }

    let key: uint = address / builtin.gc.block_bytes
    let candidate: Ref[byte]? = builtin.gc.hash.tab_lookup(ref heap.blocks, key)
    if candidate != nil { return find_block_object(candidate.get(), address) }

    let large: Ref[builtin.gc.Los_Obj]? = los_find(heap, address)
    if large != nil {
        let object: Ref[builtin.gc.Los_Obj] = large.get()
        if object.hdr.type_index != 0 { return ref object.hdr }
    }
    return nil
}
