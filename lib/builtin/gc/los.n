import builtin.abi
import builtin.gc
import builtin.gc.registry
import builtin.os

public const los_threshold: uint = 8 * 1024
const los_cache_object: uint = 256 * 1024
const los_cache_min: uint = 8 * 1024 * 1024

public func mapping_bytes(payload_bytes: uint, alignment: uint) -> uint {
    if alignment == 0 or (alignment & (alignment - 1)) != 0 or
        payload_bytes > (~cast[uint](0) >> builtin.gc.meta_flag_bits) {
        return 0
    }
    let prefix: uint = builtin.gc.los_header_offset()
    let header_bytes: uint = builtin.gc.object_header_bytes()
    let granule: uint = builtin.gc.granule_bytes
    let maximum: uint = ~cast[uint](0)
    if header_bytes > maximum - granule + 1 or
        payload_bytes > maximum - header_bytes - granule + 1 {
        return 0
    }
    let object_bytes: uint = (header_bytes + payload_bytes + granule - 1) / granule * granule
    if object_bytes > maximum - prefix { return 0 }
    let total: uint = prefix + object_bytes
    var map_alignment: uint = alignment
    if map_alignment < granule { map_alignment = granule }
    let payload_offset: uint = prefix + header_bytes
    let pad: uint = (map_alignment - payload_offset % map_alignment) % map_alignment
    if pad > maximum - total { return 0 }
    return total + pad
}

func size_class(bytes: uint) -> uint {
    require bytes > los_threshold
    let highest: uint = builtin.gc.word_bits - 1 - cast[uint](__count_leading_zeros(bytes))
    return highest * 4 + ((bytes >> (highest - 2)) & 3)
}

public func cache_take(heap: Ref[builtin.gc.Heap], total: uint) -> Ref[builtin.gc.Los_Obj]? {
    let first: uint = size_class(total)
    var index: uint = first
    while index <= first + 1 and index < builtin.gc.los_classes {
        let slot: Ref[Ref[builtin.gc.Los_Obj]?] = ref heap.los_cache[index]
        let candidate: Ref[builtin.gc.Los_Obj]? = ref_read(slot)
        if candidate != nil {
            let object: Ref[builtin.gc.Los_Obj] = candidate.get()
            if object.bytes >= total {
                ref_write(slot, object.next)
                heap.los_cache_bytes -= object.mapped_bytes
                return object
            }
        }
        index += 1
    }
    return nil
}

public func cache_drain(heap: Ref[builtin.gc.Heap]) {
    var index: uint = 0
    while index < builtin.gc.los_classes {
        let slot: Ref[Ref[builtin.gc.Los_Obj]?] = ref heap.los_cache[index]
        var candidate: Ref[builtin.gc.Los_Obj]? = ref_read(slot)
        while candidate != nil {
            let object: Ref[builtin.gc.Los_Obj] = candidate.get()
            ref_write(slot, object.next)
            builtin.gc.registry.los_unregister(heap, object)
            builtin.os.unmap(object.mapping, object.mapped_bytes)
            candidate = ref_read(slot)
        }
        index += 1
    }
    heap.los_cache_bytes = 0
}

public func release(heap: Ref[builtin.gc.Heap], object: Ref[builtin.gc.Los_Obj]) {
    assert (object.hdr.meta & builtin.gc.obj_final) == 0
    heap.los_count -= 1
    heap.los_bytes -= object.mapped_bytes

    var limit: uint = heap.target_bytes / 8
    if limit < los_cache_min { limit = los_cache_min }
    if __abi_ref_address(object.mapping) == __abi_ref_address(object) and
        object.mapped_bytes == object.bytes and
        object.bytes <= los_cache_object and
        heap.los_cache_bytes + object.mapped_bytes <= limit {
        let index: uint = size_class(object.bytes)
        builtin.gc.registry.region_set_type(heap, ref object.hdr, 0)
        if heap.cfg.poison_free {
            let row: Ref[builtin.abi.Type_Record]? = builtin.abi.reference_target(typeof(ref object.hdr))
            if row != nil {
                let payload: Ref[byte] = __gc_byte_offset(object.mapping,
                    builtin.gc.los_header_offset() + builtin.abi.size_bytes(row.get()))
                let end: Ref[byte] = __gc_byte_offset(object.mapping, object.bytes)
                let bytes: int = __gc_byte_diff(end, payload)
                require bytes >= 0
                __gc_memset(payload, 0xdb, cast[uint](bytes))
            } else {
                require false
            }
        }
        let slot: Ref[Ref[builtin.gc.Los_Obj]?] = ref heap.los_cache[index]
        object.next = ref_read(slot)
        let cached: Ref[builtin.gc.Los_Obj]? = object
        ref_write(slot, cached)
        heap.los_cache_bytes += object.mapped_bytes
        return
    }
    builtin.gc.registry.los_unregister(heap, object)
    builtin.os.unmap(object.mapping, object.mapped_bytes)
}

public func allocate_locked(heap: Ref[builtin.gc.Heap],
                            mutator: Ref[builtin.gc.Mutator],
                            type_index: u32, payload_bytes: uint,
                            alignment: uint, finalizable: bool,
                            instance_descriptor: Ref[builtin.abi.Array_Descriptor_Header]? = nil,
                            slot: Ref[Ref[byte]?]? = nil) -> Ref[byte]? {
    if type_index == 0 { return nil }
    let row: Ref[builtin.abi.Type_Record]? = builtin.abi.type_at(type_index)
    if row == nil { return nil }
    let mapped_bytes: uint = mapping_bytes(payload_bytes, alignment)
    if mapped_bytes == 0 { return nil }
    let prefix: uint = builtin.gc.los_header_offset()
    let header_bytes: uint = builtin.gc.object_header_bytes()
    let granule: uint = builtin.gc.granule_bytes
    let unrounded: uint = header_bytes + payload_bytes
    let object_bytes: uint = (unrounded + granule - 1) / granule * granule
    let total: uint = prefix + object_bytes
    require object_bytes > los_threshold or alignment > granule

    var map_alignment: uint = alignment
    if map_alignment < builtin.gc.granule_bytes {
        map_alignment = builtin.gc.granule_bytes
    }
    let pad: uint = mapped_bytes - total
    var flags: u32 = cast[u32](builtin.gc.obj_large)
    if finalizable { flags = flags | cast[u32](builtin.gc.obj_final) }
    if instance_descriptor != nil {
        flags = flags | cast[u32](builtin.gc.obj_array_backing)
    }
    var epoch: u32 = heap.epoch
    if __atomic_load(ref heap.marking) or mutator.black {
        epoch = heap.mark_epoch
    }
    var object: Ref[builtin.gc.Los_Obj]? = nil
    if alignment <= builtin.gc.granule_bytes and pad == 0 {
        object = cache_take(heap, total)
    }
    if object != nil {
        let reused: Ref[builtin.gc.Los_Obj] = object.get()
        let header: Ref[builtin.gc.Object_Header] = ref reused.hdr
        __gc_memset(header, 0, object_bytes)
        if instance_descriptor != nil {
            require builtin.gc.initialize_array_backing(
                builtin.gc.payload_of(header), payload_bytes, type_index,
                instance_descriptor.get())
        }
        header.meta = builtin.gc.meta_make(payload_bytes, flags)
        __atomic_store(ref reused.marked, epoch)
        builtin.gc.registry.region_set_type(heap, header, type_index)
    } elif !builtin.gc.over_max(heap, mapped_bytes) {
        let mapped: Ref[byte]? = builtin.os.map_zeroed(mapped_bytes,
            map_alignment)
        if mapped != nil {
            let base: Ref[byte] = __gc_byte_offset(mapped.get(), pad)
            let fresh: Ref[builtin.gc.Los_Obj] = unsafe_cast[Ref[builtin.gc.Los_Obj]] base
            fresh.mapping = mapped.get()
            fresh.mapped_bytes = mapped_bytes
            fresh.bytes = total
            fresh.hdr.type_index = type_index
            if instance_descriptor != nil {
                require builtin.gc.initialize_array_backing(
                    builtin.gc.payload_of(ref fresh.hdr), payload_bytes,
                    type_index, instance_descriptor.get())
            }
            fresh.hdr.meta = builtin.gc.meta_make(payload_bytes,
                flags)
            __atomic_store(ref fresh.marked, epoch)
            if builtin.gc.registry.los_register(heap, fresh) {
                object = fresh
            } else {
                builtin.os.unmap(mapped.get(), mapped_bytes)
            }
        }
    }
    if object != nil {
        let allocated: Ref[builtin.gc.Los_Obj] = object.get()
        allocated.next = heap.los
        heap.los = allocated
        if finalizable {
            allocated.final_next = heap.final_los
            heap.final_los = allocated
        }
        heap.los_count += 1
        heap.los_bytes += allocated.mapped_bytes
        heap.alloc_since_gc += allocated.mapped_bytes
        let payload: Ref[byte] = builtin.gc.payload_of(ref allocated.hdr)
        if slot != nil {
            let published: Ref[byte]? = payload
            ref_write(slot.get(), published)
            mutator.last_alloc = nil
        } else {
            mutator.last_alloc = payload
        }
        mutator.objects_allocated += 1
        mutator.bytes_allocated += cast[u64](object_bytes)
        return payload
    }
    return nil
}

public func free_all(heap: Ref[builtin.gc.Heap]) {
    var candidate: Ref[builtin.gc.Los_Obj]? = heap.los
    while candidate != nil {
        let object: Ref[builtin.gc.Los_Obj] = candidate.get()
        let next: Ref[builtin.gc.Los_Obj]? = object.next
        builtin.os.unmap(object.mapping, object.mapped_bytes)
        candidate = next
    }
    heap.los = nil
    heap.los_count = 0
    heap.los_bytes = 0
    cache_drain(heap)
}
