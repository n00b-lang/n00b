import builtin.abi
import builtin.gc
import builtin.gc.alloc
import builtin.gc.hash
import builtin.gc.handshake
import builtin.gc.mark
import builtin.gc.roots
import builtin.gc.sync
import builtin.os

func mutator_record() -> Ref[builtin.abi.Type_Record] {
    let probe: Ref[builtin.gc.Mutator]? = nil
    let row: Ref[builtin.abi.Type_Record]? = builtin.abi.optional_reference_target(typeof(probe))
    if row != nil { return row.get() }
    require false
}

public func create(heap: Ref[builtin.gc.Heap]) -> Ref[builtin.gc.Mutator]? {
    let thread_id: uint = builtin.os.thread_id()
    if thread_id == 0 { return nil }
    let thread_control: uint = builtin.os.thread_control_self()
    if thread_control == 0 { return nil }
    let stack_hi: Ref[byte]? = builtin.os.thread_stack_high_self()
    if heap.cfg.scan_stacks and stack_hi == nil { return nil }
    let row: Ref[builtin.abi.Type_Record] = mutator_record()
    let mapped: Ref[byte]? = builtin.os.map_zeroed(
        builtin.abi.size_bytes(row), builtin.abi.alignment_bytes(row))
    if mapped != nil {
        let mutator: Ref[builtin.gc.Mutator] = unsafe_cast[Ref[builtin.gc.Mutator]] mapped.get()
        mutator.heap = heap
        mutator.thread_id = thread_id
        mutator.thread_control = thread_control
        mutator.stack_hi = stack_hi
        builtin.gc.sync.ticket_lock(ref heap.lock)
        let found: Ref[byte]? = builtin.gc.hash.tab_lookup(ref heap.threads, thread_id)
        if found != nil {
            let primary: Ref[builtin.gc.Mutator] = builtin.gc.thread_index_mutator(found.get(), thread_id)
            let next: Ref[builtin.gc.Mutator]? = primary.thread_next
            if next != nil {
                mutator.thread_next = next
                mutator.thread_prev = primary
                next.get().thread_prev = mutator
                primary.thread_next = mutator
            } else { require false }
        } else {
            if !builtin.gc.hash.tab_reserve(ref heap.threads, 1) {
                builtin.gc.sync.ticket_unlock(ref heap.lock)
                builtin.os.unmap(mutator, builtin.abi.size_bytes(row))
                return nil
            }
            builtin.gc.hash.tab_insert(ref heap.threads, thread_id,
                builtin.gc.thread_index_value(mutator))
            mutator.thread_primary = true
            mutator.thread_next = mutator
            mutator.thread_prev = mutator
        }
        mutator.black = heap.black_alloc
        if heap.hs_active {
            __atomic_store(ref mutator.hs_state,
                cast[u32](builtin.gc.Handshake_State.requested))
            __atomic_fetch_add(ref heap.hs_pending, 1)
        } else {
            __atomic_store(ref mutator.hs_state,
                cast[u32](builtin.gc.Handshake_State.idle))
        }
        let old: Ref[builtin.gc.Mutator]? = heap.mutators
        mutator.next = old
        if old != nil { old.get().prev = mutator }
        heap.mutators = mutator
        heap.nmutators += 1
        builtin.gc.sync.ticket_unlock(ref heap.lock)
        return mutator
    }
    return nil
}

public func set_stack_hi(mutator: Ref[builtin.gc.Mutator], stack_hi: Ref[byte]) {
    mutator.stack_hi = stack_hi
}

func lock_answered(mutator: Ref[builtin.gc.Mutator]) {
    let heap: Ref[builtin.gc.Heap] = mutator.heap
    while true {
        builtin.gc.handshake.safepoint(mutator)
        builtin.gc.sync.ticket_lock(ref heap.lock)
        if __atomic_load(ref mutator.hs_state) != cast[u32](builtin.gc.Handshake_State.requested) {
            return
        }
        builtin.gc.sync.ticket_unlock(ref heap.lock)
    }
}

public func park(mutator: Ref[builtin.gc.Mutator]) {
    let heap: Ref[builtin.gc.Heap] = mutator.heap
    lock_answered(mutator)
    builtin.gc.alloc.bump_release(heap, ref mutator.small)
    builtin.gc.alloc.bump_release(heap, ref mutator.overflow)
    mutator.last_alloc = nil
    builtin.gc.sync.ticket_unlock(ref heap.lock)
}

public func destroy(mutator: Ref[builtin.gc.Mutator]) {
    let heap: Ref[builtin.gc.Heap] = mutator.heap
    lock_answered(mutator)

    let previous: Ref[builtin.gc.Mutator]? = mutator.prev
    let next: Ref[builtin.gc.Mutator]? = mutator.next
    if previous != nil { previous.get().next = next }
    else { heap.mutators = next }
    if next != nil { next.get().prev = previous }
    heap.nmutators -= 1

    let following: Ref[builtin.gc.Mutator]? = mutator.thread_next
    let preceding: Ref[builtin.gc.Mutator]? = mutator.thread_prev
    if following != nil {
        if preceding != nil {
            if following.get() == mutator {
                builtin.gc.hash.tab_delete(ref heap.threads, mutator.thread_id,
                    builtin.gc.thread_index_value(mutator))
            } else {
                if mutator.thread_primary {
                    let successor: Ref[builtin.gc.Mutator] = following.get()
                    successor.thread_primary = true
                    let slot: Ref[builtin.gc.hash.Hash_Slot] = builtin.gc.hash.tab_find(
                        ref heap.threads, mutator.thread_id,
                        builtin.gc.thread_index_value(mutator))
                    slot.val = builtin.gc.thread_index_value(successor)
                }
                preceding.get().thread_next = following
                following.get().thread_prev = preceding
            }
        } else { require false }
    } else { require false }

    builtin.gc.alloc.bump_release(heap, ref mutator.small)
    builtin.gc.alloc.bump_release(heap, ref mutator.overflow)
    builtin.gc.mark.barrier_flush_locked(mutator)
    heap.retired_objects += mutator.objects_allocated
    heap.retired_bytes += mutator.bytes_allocated
    heap.retired_refills += mutator.refills
    heap.retired_locked_refills += mutator.locked_refills
    builtin.gc.sync.ticket_unlock(ref heap.lock)

    builtin.gc.roots.free(mutator)
    builtin.os.unmap(mutator, builtin.abi.size_bytes(mutator_record()))
}
