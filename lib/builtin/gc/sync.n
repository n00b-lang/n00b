import builtin.os
import builtin.gc

const near_spins: u32 = 2000
const far_spins: u32 = 100
const max_ticket: u32 = 0xffffffff

public func event_enter(event: Ref[builtin.gc.Event]) -> u32 {
    __atomic_fetch_add(ref event.sleepers, 1)
    return __atomic_load(ref event.seq)
}

public func event_leave(event: Ref[builtin.gc.Event]) {
    __atomic_fetch_sub(ref event.sleepers, 1)
}

public func event_sleep(event: Ref[builtin.gc.Event], seq: u32) {
    if __atomic_load(ref event.seq) == seq { builtin.os.thread_yield() }
}

public func event_signal(event: Ref[builtin.gc.Event]) {
    __atomic_fetch_add(ref event.seq, 1)
}

func ticket_next(value: u32) -> u32 {
    if value == max_ticket { return 0 }
    return value + 1
}

public func ticket_lock(lock: Ref[builtin.gc.Ticket_Lock]) {
    let ticket: u32 = __atomic_fetch_add(ref lock.next, 1)
    var spins: u32 = 0
    while true {
        let owner: u32 = __atomic_load(ref lock.owner)
        if owner == ticket { return }
        spins += 1
        var limit: u32 = far_spins
        if ticket_next(owner) == ticket { limit = near_spins }
        if spins < limit {
            builtin.os.cpu_relax()
            continue
        }
        spins = 0
        let index: int = cast[int](ticket % builtin.gc.lock_slots)
        let event: Ref[builtin.gc.Event] = ref lock.slot[index]
        let seq: u32 = event_enter(event)
        if __atomic_load(ref lock.owner) != ticket { event_sleep(event, seq) }
        event_leave(event)
    }
}

public func ticket_trylock(lock: Ref[builtin.gc.Ticket_Lock]) -> bool {
    let owner: u32 = __atomic_load(ref lock.owner)
    return __atomic_compare_exchange(ref lock.next, owner,
        ticket_next(owner))
}

public func ticket_unlock(lock: Ref[builtin.gc.Ticket_Lock]) {
    let owner: u32 = ticket_next(__atomic_load(ref lock.owner))
    __atomic_store(ref lock.owner, owner)
    if __atomic_load(ref lock.next) == owner { return }
    let index: int = cast[int](owner % builtin.gc.lock_slots)
    event_signal(ref lock.slot[index])
}
