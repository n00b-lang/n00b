import abi
import string.core
import sys.ffi
import sys.gc.alloc
import sys.threads

record Ffi_Error {
    code: i64
    text: string?
    fn:   string
}

record Ffi_Bytes layout(c) {
    data: uint
    length: uint
}

trait Fixup {
    func fixup(modify self: 'T) -> nil fail: string
}

record Ffi_Table {
    slots: Array['T?]
    owners: Array[uint]
    next_free: Array[uint]
    count: uint
    free_head: uint
}

func fixup(modify self: 'T) -> nil fail: string {
}

func ffi_run_fixup(modify value: 'T) -> string? where 'T : Fixup {
    try {
        value.fixup()!
    } fail(failure) {
        return failure
    }
    return nil
}

func foreign_text(pointer: Foreign[i8]?) -> string? {
    if pointer == nil {
        return nil
    }
    let base: Ref[byte] = unsafe_cast[Ref[byte]] pointer
    var length: uint = 0
    while true {
        let value: byte = __gc_byte_offset(base, length).__value
        if value == 0 {
            break
        }
        length += 1
    }
    var bytes: Array[u8] = new[Array[u8]](length)
    var position: uint = 0
    while position < length {
        let value: byte = __gc_byte_offset(base, position).__value
        bytes[cast[int]position] = cast[u8]value
        position += 1
    }
    return string.core.from_raw(ref bytes, cast[int]length, copy = false)
}

func __ffi_fixup(pointer: Foreign['T]?) -> string? where 'T : Fixup {
    if pointer == nil {
        return nil
    }
    let address: uint = unsafe_cast[uint] pointer
    if !__abi_baked_address(address) or sys.ffi.ffi_is_fixed(address) {
        return nil
    }
    let target: Ref['T] = unsafe_cast[Ref['T]] pointer
    var value: 'T = target.__value
    let problem: string? = ffi_run_fixup(value)
    if problem != nil {
        return problem
    }
    target.__value = value
    sys.ffi.ffi_note_fixed(address)
    return nil
}

fence litmod ffi(source: string) -> nil fail: string {
    fail "an 'ffi literal is bound by the compiler"
}

func __ffi_enter(buffer: uint) -> uint {
    sys.gc.alloc.note_stack_entry(buffer)
    abi.tls_relocate()
    return sys.ffi.ffi_swap_unwind_top(buffer)
}

func __ffi_leave(previous: uint) {
    sys.ffi.ffi_swap_unwind_top(previous)
}

func __ffi_panic_hook() {
    let target = sys.ffi.ffi_unwind_target()
    if target != 0 {
        __ffi_unwind_jump(target)
    }
}

func ffi_table_grow(modify table: Ffi_Table['T]) {
    let capacity: uint = table.count * 2 + 8
    var slots: Array['T?] = new[Array['T?]](cast[int]capacity)
    var owners: Array[uint] = new[Array[uint]](cast[int]capacity)
    var next_free: Array[uint] = new[Array[uint]](cast[int]capacity)
    var position: uint = 0
    while position < table.count {
        slots[position] = table.slots[position]
        owners[position] = table.owners[position]
        next_free[position] = table.next_free[position]
        position += 1
    }
    table.slots = slots
    table.owners = owners
    table.next_free = next_free
}

func __ffi_thread_id() -> uint {
    return sys.threads.thread_id()
}

func __ffi_on_main_thread() -> bool {
    return sys.threads.thread_is_main()
}

func __ffi_table_insert(modify table: Ffi_Table['T], value: 'T) -> u64 {
    sys.ffi.ffi_acquire()
    let handle: u64 = ffi_table_insert(table, value)
    sys.ffi.ffi_release()
    return handle
}

func ffi_table_insert(modify table: Ffi_Table['T], value: 'T) -> u64 {
    var index: uint = table.count
    if table.free_head != 0 {
        index = table.free_head - 1
        table.free_head = table.next_free[index]
    } else {
        if table.count == __array_length(table.slots) {
            ffi_table_grow(table)
        }
        table.count += 1
    }
    table.slots[index] = value
    table.owners[index] = sys.threads.thread_id()
    return cast[u64](index + 1)
}

func __ffi_table_owner(table: Ffi_Table['T], handle: u64) -> uint {
    sys.ffi.ffi_acquire()
    var owner: uint = 0
    if handle != 0 and handle <= cast[u64]table.count {
        owner = table.owners[cast[uint](handle - 1)]
    }
    sys.ffi.ffi_release()
    return owner
}

func __ffi_check_owner(table: Ffi_Table['T], handle: u64) {
    when debug_enabled() {
        let owner: uint = __ffi_table_owner(table, handle)
        assert owner == __ffi_thread_id()
    }
}

func __ffi_table_get(table: Ffi_Table['T], handle: u64) -> 'T? {
    sys.ffi.ffi_acquire()
    var found: 'T? = nil
    if handle != 0 and handle <= cast[u64]table.count {
        found = table.slots[cast[uint](handle - 1)]
    }
    sys.ffi.ffi_release()
    return found
}

func __ffi_table_free(modify table: Ffi_Table['T], handle: u64) {
    sys.ffi.ffi_acquire()
    if handle != 0 and handle <= cast[u64]table.count {
        let index = cast[uint](handle - 1)
        if table.slots[index] != nil {
            table.slots[index] = nil
            table.next_free[index] = table.free_head
            table.free_head = index + 1
        }
    }
    sys.ffi.ffi_release()
}

func __ffi_hold_group() -> u64 {
    return sys.ffi.ffi_next_hold_group()
}

func __ffi_hold(group: u64, token: u64, release: Ref[(u64) -> nil], event: string,
                consume keys: Array[u64], thread_id: uint) {
    sys.ffi.ffi_hold(group, token, release, event, keys, thread_id)
}

func __ffi_event(event: string, keys: Array[u64], thread_id: uint) {
    sys.ffi.ffi_release_holds(event, keys, 0, thread_id)
}

func __ffi_event_key(event: string, key: u64, thread_id: uint) {
    sys.ffi.ffi_release_holds(event, nil, key, thread_id)
}

func ffi_store(modify storage: Array[u8], at: uint, value: 'T) {
    let place: Ref['T] = unsafe_cast[Ref['T]] (ref storage[at])
    place.__value = value
}

func __ffi_read_u8(view storage: Array[u8], at: uint) -> u8 {
    return (unsafe_cast[Ref[u8]] (ref storage[at])).__value
}
func __ffi_read_u16(view storage: Array[u8], at: uint) -> u16 {
    return (unsafe_cast[Ref[u16]] (ref storage[at])).__value
}
func __ffi_read_u32(view storage: Array[u8], at: uint) -> u32 {
    return (unsafe_cast[Ref[u32]] (ref storage[at])).__value
}
func __ffi_read_u64(view storage: Array[u8], at: uint) -> u64 {
    return (unsafe_cast[Ref[u64]] (ref storage[at])).__value
}
func __ffi_read_i8(view storage: Array[u8], at: uint) -> i8 {
    return (unsafe_cast[Ref[i8]] (ref storage[at])).__value
}
func __ffi_read_i16(view storage: Array[u8], at: uint) -> i16 {
    return (unsafe_cast[Ref[i16]] (ref storage[at])).__value
}
func __ffi_read_i32(view storage: Array[u8], at: uint) -> i32 {
    return (unsafe_cast[Ref[i32]] (ref storage[at])).__value
}
func __ffi_read_i64(view storage: Array[u8], at: uint) -> i64 {
    return (unsafe_cast[Ref[i64]] (ref storage[at])).__value
}
func __ffi_read_f32(view storage: Array[u8], at: uint) -> f32 {
    return (unsafe_cast[Ref[f32]] (ref storage[at])).__value
}
func __ffi_read_f64(view storage: Array[u8], at: uint) -> f64 {
    return (unsafe_cast[Ref[f64]] (ref storage[at])).__value
}

func __ffi_write_u8(modify storage: Array[u8], at: uint, value: u8) {
    ffi_store(storage, at, value)
}
func __ffi_write_u16(modify storage: Array[u8], at: uint, value: u16) {
    ffi_store(storage, at, value)
}
func __ffi_write_u32(modify storage: Array[u8], at: uint, value: u32) {
    ffi_store(storage, at, value)
}
func __ffi_write_u64(modify storage: Array[u8], at: uint, value: u64) {
    ffi_store(storage, at, value)
}
func __ffi_write_i8(modify storage: Array[u8], at: uint, value: i8) {
    ffi_store(storage, at, value)
}
func __ffi_write_i16(modify storage: Array[u8], at: uint, value: i16) {
    ffi_store(storage, at, value)
}
func __ffi_write_i32(modify storage: Array[u8], at: uint, value: i32) {
    ffi_store(storage, at, value)
}
func __ffi_write_i64(modify storage: Array[u8], at: uint, value: i64) {
    ffi_store(storage, at, value)
}
func __ffi_write_f32(modify storage: Array[u8], at: uint, value: f32) {
    ffi_store(storage, at, value)
}
func __ffi_write_f64(modify storage: Array[u8], at: uint, value: f64) {
    ffi_store(storage, at, value)
}
