import containers.list
import string.core

type Ffi_Bytes layout(c) {
    public data: uint
    public length: uint
}

record Ffi_Table {
    public slots: List[`T?]
    public free: List[int]
    public owners: List[uint]
}

type Ffi_Hold {
    group: u64
    token: u64
    release: Ref[(u64) -> nil]?
    event: string
    keys: Array[u64]
    thread_id: uint
}

var ffi_holds: List[Ffi_Hold] = new[List[Ffi_Hold]]()
var ffi_hold_groups: u64 = 0
thread var ffi_unwind_top: uint = 0

litmod<fence> ffi(source: string) -> nil fail: string {
    fail "an 'ffi literal is bound by the compiler"
}

func __ffi_enter(buffer: uint) -> uint {
    let previous = ffi_unwind_top
    ffi_unwind_top = buffer
    return previous
}

func __ffi_leave(previous: uint) {
    ffi_unwind_top = previous
}

func __ffi_panic_hook() {
    let target = ffi_unwind_top
    if target != 0 {
        __ffi_unwind_jump(target)
    }
}

func __ffi_table_insert(modify table: Ffi_Table[`T], value: `T) -> u64 {
    let reused = table.free.pop()
    if reused != nil {
        let index = reused.get()
        table.slots[index] = value
        table.owners[index] = __os_thread_id()
        return cast[u64](index + 1)
    }
    table.slots.append(value)
    table.owners.append(__os_thread_id())
    return cast[u64]table.slots.len()
}

func __ffi_table_owner(table: Ffi_Table[`T], handle: u64) -> uint {
    let index = cast[int]handle - 1
    if handle == 0 or index >= cast[int]table.owners.len() {
        return 0
    }
    return table.owners[index]
}

func __ffi_table_get(table: Ffi_Table[`T], handle: u64) -> `T? {
    let index = cast[int]handle - 1
    if handle == 0 or index >= cast[int]table.slots.len() {
        return nil
    }
    return table.slots[index]
}

func __ffi_table_free(modify table: Ffi_Table[`T], handle: u64) {
    let index = cast[int]handle - 1
    if handle == 0 or index >= cast[int]table.slots.len() or table.slots[index] == nil {
        return
    }
    table.slots[index] = nil
    table.free.append(index)
}

func __ffi_hold_group() -> u64 {
    ffi_hold_groups += 1
    return ffi_hold_groups
}

func __ffi_hold(group: u64, token: u64, release: Ref[(u64) -> nil], event: string,
                keys: Array[u64], thread_id: uint) {
    let hold: Ffi_Hold = (group = group, token = token, release = release, event = event,
                          keys = keys, thread_id = thread_id)
    ffi_holds.append(hold)
}

func ffi_drop_group(group: u64) {
    var kept: List[Ffi_Hold] = new[List[Ffi_Hold]]()
    var position = 0
    while position < cast[int]ffi_holds.len() {
        let hold = ffi_holds[position]
        if hold.group != group {
            kept.append(hold)
        }
        position += 1
    }
    ffi_holds = kept
}

func ffi_keys_match(expected: Array[u64], actual: Array[u64]) -> bool {
    if __array_length(expected) > __array_length(actual) {
        return false
    }
    var position: uint = 0
    while position < __array_length(expected) {
        if expected[cast[int]position] != actual[cast[int]position] {
            return false
        }
        position += 1
    }
    return true
}

func __ffi_event(event: string, keys: Array[u64], thread_id: uint) {
    var position = 0
    while position < cast[int]ffi_holds.len() {
        let hold = ffi_holds[position]
        if hold.event == event and (hold.thread_id == 0 or hold.thread_id == thread_id) and ffi_keys_match(hold.keys, keys) {
            ffi_drop_group(hold.group)
            if hold.release != nil {
                let release: Ref[(u64) -> nil] = hold.release.get()
                release.call(hold.token)
            }
            position = 0
        } else {
            position += 1
        }
    }
}
