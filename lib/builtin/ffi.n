import abi
import containers.list
import string.core
import sys.locks
import sys.threads

# The failure of a function an 'ffi literal binds, unless the binding
# chooses its own error type.
record Ffi_Error {
    code: i64        # the contract's `via` value, or the status itself
    text: string?    # the error channel's text, when there is one
    fn:   string     # the contract function that failed
}

record Ffi_Bytes layout(c) {
    data: uint
    length: uint
}

trait Fixup {
    func fixup(modify self: 'T) -> nil fail: string
}

record Ffi_Table {
    slots: Array['T?]
    owners: Array[uint]
    next_free: Array[uint]
    count: uint
    free_head: uint
}

record Ffi_Hold {
    group: u64
    token: u64
    release: Ref[(u64) -> nil]?
    event: string
    keys: Array[u64]
    thread_id: uint
}

var ffi_holds: Array[Ffi_Hold] = new[Array[Ffi_Hold]](0)
var ffi_hold_count: uint = 0
var ffi_hold_groups: u64 = 0
var ffi_fixed: List[uint] = new[List[uint]]()
thread var ffi_unwind_top: uint = 0

func fixup(modify self: 'T) -> nil fail: string {
}

func ffi_run_fixup(modify value: 'T) -> string? where 'T : Fixup {
    try {
        value.fixup()!
    } fail(failure) {
        return failure
    }
    return nil
}

func ffi_is_fixed(address: uint) -> bool {
    var position = 0
    while position < cast[int]ffi_fixed.len() {
        if ffi_fixed[position] == address {
            return true
        }
        position += 1
    }
    return false
}

func foreign_text(pointer: Foreign[i8]?) -> string? {
    if pointer == nil {
        return nil
    }
    let base: Ref[byte] = unsafe_cast[Ref[byte]] pointer
    var length: uint = 0
    while true {
        let value: byte = __gc_byte_offset(base, length).__value
        if value == 0 {
            break
        }
        length += 1
    }
    var bytes: Array[u8] = new[Array[u8]](length)
    var position: uint = 0
    while position < length {
        let value: byte = __gc_byte_offset(base, position).__value
        bytes[cast[int]position] = cast[u8]value
        position += 1
    }
    return string.core.from_raw(ref bytes, cast[int]length, copy = false)
}

func __ffi_fixup(pointer: Foreign['T]?) -> string? where 'T : Fixup {
    if pointer == nil {
        return nil
    }
    let address: uint = unsafe_cast[uint] pointer
    if !__abi_baked_address(address) or ffi_is_fixed(address) {
        return nil
    }
    let target: Ref['T] = unsafe_cast[Ref['T]] pointer
    var value: 'T = target.__value
    let problem: string? = ffi_run_fixup(value)
    if problem != nil {
        return problem
    }
    target.__value = value
    ffi_fixed.append(address)
    return nil
}

fence litmod ffi(source: string) -> nil fail: string {
    fail "an 'ffi literal is bound by the compiler"
}

func __ffi_enter(buffer: uint) -> uint {
    abi.tls_relocate()
    let previous = ffi_unwind_top
    ffi_unwind_top = buffer
    return previous
}

func __ffi_leave(previous: uint) {
    ffi_unwind_top = previous
}

func __ffi_panic_hook() {
    let target = ffi_unwind_top
    if target != 0 {
        __ffi_unwind_jump(target)
    }
}

func ffi_table_grow(modify table: Ffi_Table['T]) {
    let capacity: uint = table.count * 2 + 8
    var slots: Array['T?] = new[Array['T?]](cast[int]capacity)
    var owners: Array[uint] = new[Array[uint]](cast[int]capacity)
    var next_free: Array[uint] = new[Array[uint]](cast[int]capacity)
    var position: uint = 0
    while position < table.count {
        slots[position] = table.slots[position]
        owners[position] = table.owners[position]
        next_free[position] = table.next_free[position]
        position += 1
    }
    table.slots = slots
    table.owners = owners
    table.next_free = next_free
}

# The calling thread, for the thread rules generated bindings check.
func __ffi_thread_id() -> uint {
    return sys.threads.thread_id()
}

func __ffi_on_main_thread() -> bool {
    return sys.threads.thread_is_main()
}

# Guards every callback table and the holds: a callback C may call on any
# thread is registered on one thread and dispatched or freed on another.
# Recursive, since a release run under it can free a table entry.
var ffi_lock: sys.locks.Mutex = (state = 0, should_wake = 0, owner = 0,
                                 nesting = 0, collector = false)

func __ffi_table_insert(modify table: Ffi_Table['T], value: 'T) -> u64 {
    sys.locks.mutex_lock(ref ffi_lock)
    let handle: u64 = ffi_table_insert(table, value)
    sys.locks.mutex_unlock(ref ffi_lock)
    return handle
}

func ffi_table_insert(modify table: Ffi_Table['T], value: 'T) -> u64 {
    var index: uint = table.count
    if table.free_head != 0 {
        index = table.free_head - 1
        table.free_head = table.next_free[index]
    } else {
        if table.count == __array_length(table.slots) {
            ffi_table_grow(table)
        }
        table.count += 1
    }
    table.slots[index] = value
    table.owners[index] = sys.threads.thread_id()
    return cast[u64](index + 1)
}

func __ffi_table_owner(table: Ffi_Table['T], handle: u64) -> uint {
    sys.locks.mutex_lock(ref ffi_lock)
    var owner: uint = 0
    if handle != 0 and handle <= cast[u64]table.count {
        owner = table.owners[cast[uint](handle - 1)]
    }
    sys.locks.mutex_unlock(ref ffi_lock)
    return owner
}

# A thread_affine handle is used only on the thread that made it. Checked in
# debug builds; reading the owner takes the table's lock, so it's read
# before the assertion rather than in it.
func __ffi_check_owner(table: Ffi_Table['T], handle: u64) {
    when debug_enabled() {
        let owner: uint = __ffi_table_owner(table, handle)
        assert owner == __ffi_thread_id()
    }
}

func __ffi_table_get(table: Ffi_Table['T], handle: u64) -> 'T? {
    sys.locks.mutex_lock(ref ffi_lock)
    var found: 'T? = nil
    if handle != 0 and handle <= cast[u64]table.count {
        found = table.slots[cast[uint](handle - 1)]
    }
    sys.locks.mutex_unlock(ref ffi_lock)
    return found
}

func __ffi_table_free(modify table: Ffi_Table['T], handle: u64) {
    sys.locks.mutex_lock(ref ffi_lock)
    if handle != 0 and handle <= cast[u64]table.count {
        let index = cast[uint](handle - 1)
        if table.slots[index] != nil {
            table.slots[index] = nil
            table.next_free[index] = table.free_head
            table.free_head = index + 1
        }
    }
    sys.locks.mutex_unlock(ref ffi_lock)
}

func __ffi_hold_group() -> u64 {
    sys.locks.mutex_lock(ref ffi_lock)
    ffi_hold_groups += 1
    let group: u64 = ffi_hold_groups
    sys.locks.mutex_unlock(ref ffi_lock)
    return group
}

func __ffi_hold(group: u64, token: u64, release: Ref[(u64) -> nil], event: string,
                consume keys: Array[u64], thread_id: uint) {
    let hold: Ffi_Hold = (group = group, token = token, release = release, event = event,
                          keys = keys, thread_id = thread_id)
    sys.locks.mutex_lock(ref ffi_lock)
    if ffi_hold_count == __array_length(ffi_holds) {
        var grown: Array[Ffi_Hold] = new[Array[Ffi_Hold]](cast[int](ffi_hold_count * 2 + 8))
        var position: uint = 0
        while position < ffi_hold_count {
            grown[position] = ffi_holds[position]
            position += 1
        }
        ffi_holds = grown
    }
    ffi_holds[ffi_hold_count] = hold
    ffi_hold_count += 1
    sys.locks.mutex_unlock(ref ffi_lock)
}

func ffi_drop_group(group: u64) {
    var kept: uint = 0
    var position: uint = 0
    while position < ffi_hold_count {
        let hold = ffi_holds[position]
        if hold.group != group {
            ffi_holds[kept] = hold
            kept += 1
        }
        position += 1
    }
    ffi_hold_count = kept
    __array_clear(ref ffi_holds, kept)
}

func ffi_key_matches(expected: Array[u64], key: u64) -> bool {
    let length = __array_length(expected)
    return length == 0 or (length == 1 and expected[0] == key)
}

func ffi_keys_match(expected: Array[u64], actual: Array[u64]) -> bool {
    if __array_length(expected) > __array_length(actual) {
        return false
    }
    var position: uint = 0
    while position < __array_length(expected) {
        if expected[cast[int]position] != actual[cast[int]position] {
            return false
        }
        position += 1
    }
    return true
}

func ffi_release_holds(event: string, keys: Array[u64]?, key: u64, thread_id: uint) {
    sys.locks.mutex_lock(ref ffi_lock)
    ffi_release_holds_locked(event, keys, key, thread_id)
    sys.locks.mutex_unlock(ref ffi_lock)
}

func ffi_release_holds_locked(event: string, keys: Array[u64]?, key: u64,
                              thread_id: uint) {
    var position: uint = 0
    while position < ffi_hold_count {
        let hold = ffi_holds[position]
        var matched = false
        if hold.event == event and (hold.thread_id == 0 or hold.thread_id == thread_id) {
            if keys != nil {
                let all: Array[u64] = keys
                matched = ffi_keys_match(hold.keys, all)
            } else {
                matched = ffi_key_matches(hold.keys, key)
            }
        }
        if matched {
            ffi_drop_group(hold.group)
            if hold.release != nil {
                let release: Ref[(u64) -> nil] = hold.release
                release.call(hold.token)
            }
            position = 0
        } else {
            position += 1
        }
    }
}

func __ffi_event(event: string, keys: Array[u64], thread_id: uint) {
    ffi_release_holds(event, keys, 0, thread_id)
}

func __ffi_event_key(event: string, key: u64, thread_id: uint) {
    ffi_release_holds(event, nil, key, thread_id)
}
