import containers.list
import string.core

type Ffi_Bytes layout(c) {
    public data: uint
    public length: uint
}

type Ffi_Callback_Entry {
    value: Any?
    invoke: Ref[(Any, uint, uint) -> nil]?
    once: bool
}

type Ffi_Hold {
    group: u64
    token: u64
    release: Ref[(u64) -> nil]?
    event: string
    keys: Array[u64]
    thread_id: uint
}

var ffi_callbacks: List[Ffi_Callback_Entry] = new[List[Ffi_Callback_Entry]]()
var ffi_free_callbacks: List[int] = new[List[int]]()
var ffi_holds: List[Ffi_Hold] = new[List[Ffi_Hold]]()
var ffi_hold_groups: u64 = 0

litmod<fence> ffi(source: string) -> nil fail: string {
    fail "an 'ffi literal is bound by the compiler"
}

func __ffi_callback_register(value: Any, invoke: Ref[(Any, uint, uint) -> nil],
                             once: bool) -> u64 {
    let entry: Ffi_Callback_Entry = (value = value, invoke = invoke, once = once)
    let reused = ffi_free_callbacks.pop()
    if reused != nil {
        let index = reused.get()
        ffi_callbacks[index] = entry
        return cast[u64](index + 1)
    }
    ffi_callbacks.append(entry)
    return cast[u64]ffi_callbacks.len()
}

func __ffi_callback_free(handle: u64) {
    let index = cast[int]handle - 1
    if handle == 0 or index >= cast[int]ffi_callbacks.len() {
        return
    }
    let entry = ffi_callbacks[index]
    if entry.value == nil {
        return
    }
    let empty: Ffi_Callback_Entry = (value = nil, invoke = nil, once = false)
    ffi_callbacks[index] = empty
    ffi_free_callbacks.append(index)
}

func __ffi_hold_group() -> u64 {
    ffi_hold_groups += 1
    return ffi_hold_groups
}

func __ffi_hold(group: u64, token: u64, release: Ref[(u64) -> nil], event: string,
                keys: Array[u64], thread_id: uint) {
    let hold: Ffi_Hold = (group = group, token = token, release = release, event = event,
                          keys = keys, thread_id = thread_id)
    ffi_holds.append(hold)
}

func ffi_drop_group(group: u64) {
    var kept: List[Ffi_Hold] = new[List[Ffi_Hold]]()
    var position = 0
    while position < cast[int]ffi_holds.len() {
        let hold = ffi_holds[position]
        if hold.group != group {
            kept.append(hold)
        }
        position += 1
    }
    ffi_holds = kept
}

func ffi_keys_match(expected: Array[u64], actual: Array[u64]) -> bool {
    if __array_length(expected) > __array_length(actual) {
        return false
    }
    var position: uint = 0
    while position < __array_length(expected) {
        if expected[cast[int]position] != actual[cast[int]position] {
            return false
        }
        position += 1
    }
    return true
}

func __ffi_event(event: string, keys: Array[u64], thread_id: uint) {
    var position = 0
    while position < cast[int]ffi_holds.len() {
        let hold = ffi_holds[position]
        if hold.event == event and (hold.thread_id == 0 or hold.thread_id == thread_id) and ffi_keys_match(hold.keys, keys) {
            ffi_drop_group(hold.group)
            if hold.release != nil {
                let release: Ref[(u64) -> nil] = hold.release.get()
                release.call(hold.token)
            }
            position = 0
        } else {
            position += 1
        }
    }
}

func __ffi_dispatch(handle: u64, arguments: uint, result: uint) -> i32 {
    let index = cast[int]handle - 1
    if handle == 0 or index >= cast[int]ffi_callbacks.len() {
        return -1
    }
    let entry = ffi_callbacks[index]
    if entry.value == nil or entry.invoke == nil {
        return -1
    }
    let invoke: Ref[(Any, uint, uint) -> nil] = entry.invoke.get()
    invoke.call(entry.value.get(), arguments, result)
    if entry.once {
        __ffi_callback_free(handle)
    }
    return 0
}
