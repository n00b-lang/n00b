record Bitptr layout(c) {
    base:       Ref[byte]
    type_index: u32
    start_bit:  u16
    end_bit:    u16
}

func bitptr(r: Ref['T]) -> Bitptr {
    return __bitptr(r)
}

inline func bit_width(self: 'T) -> uint {
    var copy: 'T = self
    let place: Bitptr = bitptr(ref copy)
    return cast[uint](place.end_bit) - cast[uint] place.start_bit
}

inline func load_bits(self: 'T) -> u128 {
    var copy: 'T = self
    let place: Bitptr = bitptr(ref copy)
    let start: uint = cast[uint] place.start_bit
    let width: uint = cast[uint](place.end_bit) - start
    require width > 0 and width <= 128
    var bits: u128 = 0
    var i: uint = 0
    while 8 * i < start + width {
        let b: byte = __gc_byte_offset(place.base, cast[int] i).__value
        let wide: u128 = cast[u128] b
        if 8 * i >= start {
            bits = bits | unsafe_shl(wide, 8 * i - start)
        }
        else {
            bits = bits | (wide >> start)
        }
        i += 1
    }
    if width < 128 {
        bits = bits & (unsafe_shl(cast[u128] 1, width) - 1)
    }
    return bits
}
