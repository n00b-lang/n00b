import string.core

enum Type_Kind {
    nil_type = 0, primitive_type = 1, record_type, variant_type, enum_type,
    flagset_type,reference_type, option_type,array_type, view_type,
    string_type, box_type, callback_type, function_type, trait_type,
    wrapper_type, union_type,atomic_type, variable_type,named_type,
    tuple_type, foreign_type, object_type
}

record Range layout(c) {
    first: u32
    count: u32
}

record String_Bits layout(c) {
    low:  u64
    high: u64
}

record Type_Record layout(c) {
    typehash:                         u64
    size_bits:                        u64
    canonical_name:                   String_Bits
    kind:                             u32
    flags:                            u32
    alignment_bytes:                  u32
    layout_index:                     u32
    owner_module_index:               u32
    tracing_index:                    u32
    components:                       Range
    fields_or_arms:                   Range
    constraints:                      Range
    semantic_width_bits:              u32
    unpacked_storage_bits:            u32
    call_signature_index:             u32
    typevar_owner_scope_index:        u32
    typevar_ordinal:                  u32
    specialization_start_ix:          u32
    specialization_end_ix:            u32
    typevar_import_requirement_index: u32
    named_constructor:                String_Bits
    named_arguments:                  Range
    finalizer_function_index:         u32
}

record Field_Record layout(c) {
    name:                       String_Bits
    parent_type_index:          u32
    child_type_index:           u32
    declaration_ordinal:        u32
    visibility:                 u32
    symbol_index:               u32
    reserved_zero:              u32
    logical_bit_offset:         u64
    packed_runs:                Range
    physical_runs:              Range
    inline_element_type_index:  u32
    inline_reserved_zero:       u32
    inline_element_count:       u64
    inline_element_stride_bits: u64
}

record Arm_Record layout(c) {
    field:         Field_Record
    tag_value:     u32
    reserved_zero: u32
}

record Physical_Run_Record layout(c) {
    byte_offset: u64
    bit_offset:  u32
    width_bits:  u32
}

record Trace_Record layout(c) {
    type_index:          u32
    reserved_zero:       u32
    child_trace_index:   u32
    tag_extractor_index: u32
    fixed_children:      Range
    arms:                Range
    option_bit_offset:   u64
}

record Trace_Child_Record layout(c) {
    byte_offset:        u64
    child_type_index:   u32
    extent_form:        u32
    repeat_count:       u64
    stride_bits:        u64
    count_field_offset: u64
    count_field_bits:   u32
    reserved_zero:      u32
    sentinel:           u64
}

record Trace_Arm_Record layout(c) {
    tag_value:         u32
    child_trace_index: u32
    children:          Range
}

record Tag_Extractor_Record layout(c) {
    unit_byte_offset: u64
    mask:             u64
    unit_width_bits:  u32
    lsb_position:     u32
    tag_width_bits:   u32
    kind:             u32
}

const tag_direct_bits: u32 = 1

record Layout_Record layout(c) {
    type_index:          u32
    policy:              u32
    occupied_runs:       Range
    reserved_runs:       Range
    tag_extractor_index: u32
    reserved_zero:       u32
}

record Box_Record layout(c) {
    array_extent:       u16
    cached_byte_stride: u16
    type_field:         u32
    payload:            u64
}

record Frame_Layout_Record layout(c) {
    function_index:          u32
    shadow_frame_type_index: u32
    pointer_bitmap_bytes:    Range
    frame_byte_extent:       u64
}

record Native_Frame_Record layout(c) {
    function:        Ref[byte]?
    sentinel_offset: i32
    root_count:      u32
    first_root:      u32
    reserved_zero:   u32
}

record Storage_Record layout(c) {
    module_index:         u32
    symbol_index:         u32
    type_index:           u32
    segment_kind:         u32
    segment_index:        u32
    instance_shape_index: u32
    byte_offset:          u64
    byte_length:          u64
    tls_relocations:      Range
}

record Tls_Relocation_Record layout(c) {
    template_storage_index:   u32
    referenced_storage_index: u32
    write_byte_offset:        u64
    addend_bytes:             i64
    target_kind:              u32
    reserved_zero:            u32
}

record Symbol_Record layout(c) {
    name:                       String_Bits
    kind:                       u32
    type_index:                 u32
    module_index:               u32
    scope_index:                u32
    visibility:                 u32
    flags:                      u32
    binding_kind:               u32
    storage_duration:           u32
    storage_class_name:         String_Bits
    declaration_location_index: u32
    native_binding_index:       u32
    definitions:                Range
    uses:                       Range
}

record Module_Record layout(c) {
    full_path:            String_Bits
    package_index:        u32
    scc_index:            u32
    initializer:          u32
    imports:              Range
    static_storage:       Range
    tls_storage:          Range
    runtime_config_index: u32
    source_file_index:    u32
}

record Function_Record layout(c) {
    name:                String_Bits
    module_index:        u32
    scope_index:         u32
    symbol_index:        u32
    success_type_index:  u32
    failure_type_index:  u32
    parameters:          Range
    keywords:            Range
    constraints:         Range
    code_ranges:         Range
    frame_layouts:       Range
    flags:               u32
    variadic_type_index: u32
    summary_offset:      u32
    valid_keyword_bits:  u64
}

record Baked_Node_Record layout(c) {
    module_index:  u32
    type_index:    u32
    segment_kind:  u32
    segment_index: u32
    flags:         u32
    reserved_zero: u32
    byte_offset:   u64
    byte_length:   u64
}

func string_backing_at(s: string) -> uint {
    return string.core.string_backing_at(s)
}

private const tls_segment: u32 = 3

thread var tls_relocated: bool = false

func relocate_thread_storage(index: u32, row: Ref[Storage_Record]) {
    var ordinal: u32 = 0
    while ordinal < row.tls_relocations.count {
        let at: i64 = __abi_range_index(row.tls_relocations.first,
                                        row.tls_relocations.count, ordinal)
        require at > 0
        let relocation: Ref[Tls_Relocation_Record]? =
            __abi_tls_relocation(cast[u32]at)
        require relocation != nil
        let fixup: Ref[Tls_Relocation_Record] = relocation.get()
        if fixup.target_kind == tls_segment {
            let base: Ref[byte]? = __abi_storage_address(index)
            let target: Ref[byte]? =
                __abi_storage_address(fixup.referenced_storage_index)
            require base != nil
            require target != nil
            let slot: Ref[byte] = __gc_byte_offset(base.get(),
                cast[int]fixup.write_byte_offset)
            (unsafe_cast[Ref[uint]] slot).__value =
                __abi_ref_address(target.get()) + cast[uint]fixup.addend_bytes
        }
        ordinal += 1
    }
}

func tls_relocate() {
    if tls_relocated {
        return
    }
    tls_relocated = true
    var index: u32 = 1
    while index < __abi_storage_count() {
        let row: Ref[Storage_Record]? = __abi_storage(index)
        if row != nil {
            if row.get().segment_kind == tls_segment {
                relocate_thread_storage(index, row.get())
            }
        }
        index += 1
    }
}

func __type_has_kind(type_field: u32, kind: u32) -> i32 {
    let row: Ref[Type_Record]? = __abi_type(type_field & 0x7fffffff)
    if row == nil {
        return 0
    }
    if row.get().kind == kind {
        return 1
    }
    return 0
}

func __box_value_address(box: Ref[Box_Record], size_bits: u64) -> Ref[byte] {
    let payload: Ref[byte] = __gc_byte_offset(unsafe_cast[Ref[byte]] box, 8)
    if size_bits <= 64 {
        return payload
    }
    let slot: Ref[Ref[byte]?] = unsafe_cast[Ref[Ref[byte]?]] payload
    let stored: Ref[byte]? = slot.__value
    require stored != nil
    return stored.get()
}

func __tag_unit(unit: Ref[byte], width_bits: u32) -> u64 {
    if width_bits == 8 {
        let word: Ref[u8] = unsafe_cast[Ref[u8]] unit
        return cast[u64] word.__value
    }
    if width_bits == 16 {
        let word: Ref[u16] = unsafe_cast[Ref[u16]] unit
        return cast[u64] word.__value
    }
    if width_bits == 32 {
        let word: Ref[u32] = unsafe_cast[Ref[u32]] unit
        return cast[u64] word.__value
    }
    require width_bits == 64
    let word: Ref[u64] = unsafe_cast[Ref[u64]] unit
    return word.__value
}

func __set_tag_unit(unit: Ref[byte], width_bits: u32, bits: u64) {
    if width_bits == 8 {
        (unsafe_cast[Ref[u8]] unit).__value = cast[u8] bits
        return
    }
    if width_bits == 16 {
        (unsafe_cast[Ref[u16]] unit).__value = cast[u16] bits
        return
    }
    if width_bits == 32 {
        (unsafe_cast[Ref[u32]] unit).__value = cast[u32] bits
        return
    }
    require width_bits == 64
    (unsafe_cast[Ref[u64]] unit).__value = bits
}

func __type_tag_extractor(type_index: u32) -> Ref[Tag_Extractor_Record] {
    let row: Ref[Type_Record]? = __abi_type(type_index)
    require row != nil
    let layout: Ref[Layout_Record]? = __abi_layout(row.get().layout_index)
    require layout != nil
    let found: Ref[Tag_Extractor_Record]? = __abi_tag_extractor(
        layout.get().tag_extractor_index)
    require found != nil
    return found.get()
}

func __tag_at(type_index: u32, value: Ref[byte]) -> u64 {
    let tag: Ref[Tag_Extractor_Record] = __type_tag_extractor(type_index)
    let unit: Ref[byte] = __gc_byte_offset(value,
                                           cast[int] tag.unit_byte_offset)
    let bits: u64 = __tag_unit(unit, tag.unit_width_bits)
    if tag.kind != tag_direct_bits {
        if bits == 0 {
            return 0
        }
        return 1
    }
    return (bits >> tag.lsb_position) & tag.mask
}

func __set_tag_at(type_index: u32, value: Ref[byte], physical: u64) {
    let tag: Ref[Tag_Extractor_Record] = __type_tag_extractor(type_index)
    if tag.kind != tag_direct_bits {
        return
    }
    let unit: Ref[byte] = __gc_byte_offset(value,
                                           cast[int] tag.unit_byte_offset)
    let cleared: u64 = 0xffffffffffffffff ^ (tag.mask << tag.lsb_position)
    let kept: u64 = __tag_unit(unit, tag.unit_width_bits) & cleared
    __set_tag_unit(unit, tag.unit_width_bits,
                   kept | ((physical & tag.mask) << tag.lsb_position))
}

func __box_tag(box: Ref[Box_Record]) -> u64 {
    let index: u32 = box.type_field & 0x7fffffff
    let row: Ref[Type_Record]? = __abi_type(index)
    require row != nil
    return __tag_at(index, __box_value_address(box, row.get().size_bits))
}

func __box_set_tag(box: Ref[Box_Record], physical: u64) {
    let index: u32 = box.type_field & 0x7fffffff
    let row: Ref[Type_Record]? = __abi_type(index)
    require row != nil
    __set_tag_at(index, __box_value_address(box, row.get().size_bits),
                 physical)
}

func __box_address(box: Ref[Box_Record]) -> Ref[byte] {
    let row: Ref[Type_Record]? = __abi_type(box.type_field & 0x7fffffff)
    require row != nil
    return __box_value_address(box, row.get().size_bits)
}

func __box_component(box: Ref[Box_Record], ordinal: u32) -> u32 {
    let row: Ref[Type_Record]? = __abi_type(box.type_field & 0x7fffffff)
    require row != nil
    let index: i64 = __abi_range_index(row.get().components.first,
                                       row.get().components.count, ordinal)
    require index >= 0
    return cast[u32] index
}
