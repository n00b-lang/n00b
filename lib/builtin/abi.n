import string.core

enum Type_Kind {
    nil_type = 0, primitive_type = 1, record_type, variant_type, enum_type,
    flagset_type,reference_type, option_type,array_type, view_type,
    string_type, box_type, callback_type, function_type, trait_type,
    wrapper_type, union_type,atomic_type, variable_type,named_type,
    tuple_type, foreign_type
}

record Range layout(c) {
    public first: u32
    public count: u32
}

record String_Bits layout(c) {
    public low:  u64
    public high: u64
}

record Type_Record layout(c) {
    public typehash:                         u64
    public size_bits:                        u64
    public canonical_name:                   String_Bits
    public kind:                             u32
    public flags:                            u32
    public alignment_bytes:                  u32
    public layout_index:                     u32
    public owner_module_index:               u32
    public tracing_index:                    u32
    public components:                       Range
    public fields_or_arms:                   Range
    public constraints:                      Range
    public semantic_width_bits:              u32
    public unpacked_storage_bits:            u32
    public call_signature_index:             u32
    public typevar_owner_scope_index:        u32
    public typevar_ordinal:                  u32
    public specialization_start_ix:          u32
    public specialization_end_ix:            u32
    public typevar_import_requirement_index: u32
    public named_constructor:                String_Bits
    public named_arguments:                  Range
    public finalizer_function_index:         u32
}

record Field_Record layout(c) {
    public name:                       String_Bits
    public parent_type_index:          u32
    public child_type_index:           u32
    public declaration_ordinal:        u32
    public visibility:                 u32
    public symbol_index:               u32
    public reserved_zero:              u32
    public logical_bit_offset:         u64
    public packed_runs:                Range
    public physical_runs:              Range
    public inline_element_type_index:  u32
    public inline_reserved_zero:       u32
    public inline_element_count:       u64
    public inline_element_stride_bits: u64
}

record Arm_Record layout(c) {
    public field:         Field_Record
    public tag_value:     u32
    public reserved_zero: u32
}

record Physical_Run_Record layout(c) {
    public byte_offset: u64
    public bit_offset:  u32
    public width_bits:  u32
}

record Trace_Record layout(c) {
    public type_index:          u32
    public reserved_zero:       u32
    public child_trace_index:   u32
    public tag_extractor_index: u32
    public fixed_children:      Range
    public arms:                Range
    public option_bit_offset:   u64
}

record Trace_Child_Record layout(c) {
    public byte_offset:        u64
    public child_type_index:   u32
    public extent_form:        u32
    public repeat_count:       u64
    public stride_bits:        u64
    public count_field_offset: u64
    public count_field_bits:   u32
    public reserved_zero:      u32
    public sentinel:           u64
}

record Trace_Arm_Record layout(c) {
    public tag_value:         u32
    public child_trace_index: u32
    public children:          Range
}

record Tag_Extractor_Record layout(c) {
    public unit_byte_offset: u64
    public mask:             u64
    public unit_width_bits:  u32
    public lsb_position:     u32
    public tag_width_bits:   u32
    public kind:             u32
}

const tag_direct_bits: u32 = 1

record Layout_Record layout(c) {
    public type_index:          u32
    public policy:              u32
    public occupied_runs:       Range
    public reserved_runs:       Range
    public tag_extractor_index: u32
    public reserved_zero:       u32
}

record Box_Record layout(c) {
    public array_extent:       u16
    public cached_byte_stride: u16
    public type_field:         u32
    public payload:            u64
}

record Frame_Layout_Record layout(c) {
    public function_index:          u32
    public shadow_frame_type_index: u32
    public pointer_bitmap_bytes:    Range
    public frame_byte_extent:       u64
}

record Native_Frame_Record layout(c) {
    public function:        Ref[byte]?
    public sentinel_offset: i32
    public root_count:      u32
    public first_root:      u32
    public reserved_zero:   u32
}

record Storage_Record layout(c) {
    public module_index:         u32
    public symbol_index:         u32
    public type_index:           u32
    public segment_kind:         u32
    public segment_index:        u32
    public instance_shape_index: u32
    public byte_offset:          u64
    public byte_length:          u64
    public tls_relocations:      Range
}

record Tls_Relocation_Record layout(c) {
    public template_storage_index:   u32
    public referenced_storage_index: u32
    public write_byte_offset:        u64
    public addend_bytes:             i64
    public target_kind:              u32
    public reserved_zero:            u32
}

record Symbol_Record layout(c) {
    public name:                       String_Bits
    public kind:                       u32
    public type_index:                 u32
    public module_index:               u32
    public scope_index:                u32
    public visibility:                 u32
    public flags:                      u32
    public binding_kind:               u32
    public storage_duration:           u32
    public storage_class_name:         String_Bits
    public declaration_location_index: u32
    public native_binding_index:       u32
    public definitions:                Range
    public uses:                       Range
}

record Module_Record layout(c) {
    public full_path:            String_Bits
    public package_index:        u32
    public scc_index:            u32
    public initializer:          u32
    public imports:              Range
    public static_storage:       Range
    public tls_storage:          Range
    public runtime_config_index: u32
    public source_file_index:    u32
}

record Function_Record layout(c) {
    public name:                String_Bits
    public module_index:        u32
    public scope_index:         u32
    public symbol_index:        u32
    public success_type_index:  u32
    public failure_type_index:  u32
    public parameters:          Range
    public keywords:            Range
    public constraints:         Range
    public code_ranges:         Range
    public frame_layouts:       Range
    public flags:               u32
    public variadic_type_index: u32
    public summary_offset:      u32
    public valid_keyword_bits:  u64
}

record Baked_Node_Record layout(c) {
    public module_index:  u32
    public type_index:    u32
    public segment_kind:  u32
    public segment_index: u32
    public flags:         u32
    public reserved_zero: u32
    public byte_offset:   u64
    public byte_length:   u64
}

func string_backing_at(s: string) -> uint {
    return string.core.string_backing_at(s)
}

private const tls_segment: u32 = 3

thread var tls_relocated: bool = false

func relocate_thread_storage(index: u32, row: Ref[Storage_Record]) {
    var ordinal: u32 = 0
    while ordinal < row.tls_relocations.count {
        let at: i64 = __abi_range_index(row.tls_relocations.first,
                                        row.tls_relocations.count, ordinal)
        require at > 0
        let relocation: Ref[Tls_Relocation_Record]? =
            __abi_tls_relocation(cast[u32]at)
        require relocation != nil
        let fixup: Ref[Tls_Relocation_Record] = relocation.get()
        if fixup.target_kind == tls_segment {
            let base: Ref[byte]? = __abi_storage_address(index)
            let target: Ref[byte]? =
                __abi_storage_address(fixup.referenced_storage_index)
            require base != nil
            require target != nil
            let slot: Ref[byte] = __gc_byte_offset(base.get(),
                cast[int]fixup.write_byte_offset)
            ref_write(unsafe_cast[Ref[uint]] slot,
                __abi_ref_address(target.get()) + cast[uint]fixup.addend_bytes)
        }
        ordinal += 1
    }
}

public func tls_relocate() {
    if tls_relocated {
        return
    }
    tls_relocated = true
    var index: u32 = 1
    while index < __abi_storage_count() {
        let row: Ref[Storage_Record]? = __abi_storage(index)
        if row != nil {
            if row.get().segment_kind == tls_segment {
                relocate_thread_storage(index, row.get())
            }
        }
        index += 1
    }
}

func __type_has_kind(type_field: u32, kind: u32) -> i32 {
    let row: Ref[Type_Record]? = __abi_type(type_field & 0x7fffffff)
    if row == nil {
        return 0
    }
    if row.get().kind == kind {
        return 1
    }
    return 0
}

func __box_value_address(box: Ref[Box_Record], size_bits: u64) -> Ref[byte] {
    let payload: Ref[byte] = __gc_byte_offset(unsafe_cast[Ref[byte]] box, 8)
    if size_bits <= 64 {
        return payload
    }
    let slot: Ref[Ref[byte]?] = unsafe_cast[Ref[Ref[byte]?]] payload
    let stored: Ref[byte]? = slot
    require stored != nil
    return stored.get()
}

func __tag_unit(unit: Ref[byte], width_bits: u32) -> u64 {
    if width_bits == 8 {
        let word: Ref[u8] = unsafe_cast[Ref[u8]] unit
        let value: u8 = word
        return cast[u64] value
    }
    if width_bits == 16 {
        let word: Ref[u16] = unsafe_cast[Ref[u16]] unit
        let value: u16 = word
        return cast[u64] value
    }
    if width_bits == 32 {
        let word: Ref[u32] = unsafe_cast[Ref[u32]] unit
        let value: u32 = word
        return cast[u64] value
    }
    require width_bits == 64
    let word: Ref[u64] = unsafe_cast[Ref[u64]] unit
    return word
}

func __set_tag_unit(unit: Ref[byte], width_bits: u32, bits: u64) {
    if width_bits == 8 {
        ref_write(unsafe_cast[Ref[u8]] unit, cast[u8] bits)
        return
    }
    if width_bits == 16 {
        ref_write(unsafe_cast[Ref[u16]] unit, cast[u16] bits)
        return
    }
    if width_bits == 32 {
        ref_write(unsafe_cast[Ref[u32]] unit, cast[u32] bits)
        return
    }
    require width_bits == 64
    ref_write(unsafe_cast[Ref[u64]] unit, bits)
}

func __type_tag_extractor(type_index: u32) -> Ref[Tag_Extractor_Record] {
    let row: Ref[Type_Record]? = __abi_type(type_index)
    require row != nil
    let layout: Ref[Layout_Record]? = __abi_layout(row.get().layout_index)
    require layout != nil
    let found: Ref[Tag_Extractor_Record]? = __abi_tag_extractor(
        layout.get().tag_extractor_index)
    require found != nil
    return found.get()
}

func __tag_at(type_index: u32, value: Ref[byte]) -> u64 {
    let tag: Ref[Tag_Extractor_Record] = __type_tag_extractor(type_index)
    let unit: Ref[byte] = __gc_byte_offset(value,
                                           cast[int] tag.unit_byte_offset)
    let bits: u64 = __tag_unit(unit, tag.unit_width_bits)
    if tag.kind != tag_direct_bits {
        if bits == 0 {
            return 0
        }
        return 1
    }
    return (bits >> tag.lsb_position) & tag.mask
}

func __set_tag_at(type_index: u32, value: Ref[byte], physical: u64) {
    let tag: Ref[Tag_Extractor_Record] = __type_tag_extractor(type_index)
    if tag.kind != tag_direct_bits {
        return
    }
    let unit: Ref[byte] = __gc_byte_offset(value,
                                           cast[int] tag.unit_byte_offset)
    let cleared: u64 = 0xffffffffffffffff ^ (tag.mask << tag.lsb_position)
    let kept: u64 = __tag_unit(unit, tag.unit_width_bits) & cleared
    __set_tag_unit(unit, tag.unit_width_bits,
                   kept | ((physical & tag.mask) << tag.lsb_position))
}

func __box_tag(box: Ref[Box_Record]) -> u64 {
    let index: u32 = box.type_field & 0x7fffffff
    let row: Ref[Type_Record]? = __abi_type(index)
    require row != nil
    return __tag_at(index, __box_value_address(box, row.get().size_bits))
}

func __box_set_tag(box: Ref[Box_Record], physical: u64) {
    let index: u32 = box.type_field & 0x7fffffff
    let row: Ref[Type_Record]? = __abi_type(index)
    require row != nil
    __set_tag_at(index, __box_value_address(box, row.get().size_bits),
                 physical)
}

func __box_address(box: Ref[Box_Record]) -> Ref[byte] {
    let row: Ref[Type_Record]? = __abi_type(box.type_field & 0x7fffffff)
    require row != nil
    return __box_value_address(box, row.get().size_bits)
}

func __box_component(box: Ref[Box_Record], ordinal: u32) -> u32 {
    let row: Ref[Type_Record]? = __abi_type(box.type_field & 0x7fffffff)
    require row != nil
    let index: i64 = __abi_range_index(row.get().components.first,
                                       row.get().components.count, ordinal)
    require index >= 0
    return cast[u32] index
}
