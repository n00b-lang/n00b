const group_slots: uint = 8
const ctrl_empty:  u64  = 0x80
const ctrl_dead:   u64  = 0xfe
const byte_lsbs:   u64  = 0x0101010101010101
const byte_msbs:   u64  = 0x8080808080808080
const byte_bit1:   u64  = 0x0202020202020202
const empty_group: u64  = 0x8080808080808080

record Hash_Index {
    ctrl:        Array[u64]
    slots:       Array[u32]
    hashes:      Array[u128]
    dead:        Array[u64]
    used:        uint
    live:        uint
    growth_left: uint
}

func __init(modify self: Hash_Index) {
    self.ctrl = new[Array[u64]](0)
    self.slots = new[Array[u32]](0)
    self.hashes = new[Array[u128]](0)
    self.dead = new[Array[u64]](0)
    self.used = 0
    self.live = 0
    self.growth_left = 0
}

inline func mix(hash: u128) -> u64 {
    return cast[u64](hash & 0xffffffffffffffff) ^ cast[u64](hash >> 64)
}

inline func tag_of(mixed: u64) -> u64 {
    return mixed & 0x7f
}

inline func match_tag(word: u64, tag: u64) -> u64 {
    let x: u64 = word ^ (tag * byte_lsbs)
    return unsafe_sub(x, byte_lsbs) & ~x & byte_msbs
}

inline func match_empty(word: u64) -> u64 {
    return word & byte_msbs & ~((word & byte_bit1) << 6)
}

inline func match_free(word: u64) -> u64 {
    return word & byte_msbs
}

inline func first_lane(bits: u64) -> uint {
    return cast[uint](__count_trailing_zeros(bits)) >> 3
}

inline func set_ctrl(self: Ref[Hash_Index], slot: uint, value: u64) {
    let group: uint = slot / group_slots
    let shift: u64  = cast[u64]((slot % group_slots) * 8)
    let word:  u64  = self.ctrl[group]
    self.ctrl[group] = (word & ~(cast[u64](0xff) << shift)) | (value << shift)
}

inline func ctrl_at(self: Ref[Hash_Index], slot: uint) -> u64 {
    let shift: u64 = cast[u64]((slot % group_slots) * 8)
    return (self.ctrl[slot / group_slots] >> shift) & 0xff
}

inline func entry_at(self: Ref[Hash_Index], slot: uint) -> uint {
    return cast[uint](self.slots[slot])
}

inline func is_dead(self: Ref[Hash_Index], entry: uint) -> bool {
    if __array_length(self.dead) == 0 {
        return false
    }
    return ((self.dead[entry >> 6] >> cast[u64](entry & 63)) & 1) != 0
}

inline func find_slot(self: Ref[Hash_Index], hash: u128) -> uint? {
    let groups: uint = __array_length(self.ctrl)
    if groups == 0 {
        return nil
    }
    let mixed: u64  = mix(hash)
    let tag:   u64  = tag_of(mixed)
    let mask:  uint = groups - 1
    var group: uint = cast[uint](mixed >> 7) & mask
    var step:  uint = 0
    while true {
        let word: u64 = self.ctrl[group]
        var bits: u64 = match_tag(word, tag)
        while bits != 0 {
            let slot: uint = group * group_slots + first_lane(bits)
            if self.hashes[cast[uint](self.slots[slot])] == hash {
                return slot
            }
            bits = bits & (bits - 1)
        }
        if match_empty(word) != 0 {
            return nil
        }
        step += 1
        group = (group + step) & mask
    }
    require false
}

inline func find(self: Ref[Hash_Index], hash: u128) -> uint? {
    let slot: uint? = find_slot(self, hash)
    if slot == nil {
        return nil
    }
    return cast[uint](self.slots[slot.get()])
}

inline func place(self: Ref[Hash_Index], mixed: u64, entry: uint) -> bool {
    let mask:  uint = __array_length(self.ctrl) - 1
    var group: uint = cast[uint](mixed >> 7) & mask
    var step:  uint = 0
    while true {
        let free: u64 = match_free(self.ctrl[group])
        if free != 0 {
            let slot:  uint = group * group_slots + first_lane(free)
            let fresh: bool = ctrl_at(self, slot) == ctrl_empty
            set_ctrl(self, slot, tag_of(mixed))
            self.slots[slot] = cast[u32] entry
            return fresh
        }
        step += 1
        group = (group + step) & mask
    }
    require false
}

inline func insert(self: Ref[Hash_Index], hash: u128) -> uint? {
    require self.growth_left > 0 and self.used < __array_length(self.hashes)
    let existing: uint? = find(self, hash)
    if existing != nil {
        return existing
    }
    let entry: uint = self.used
    if place(self, mix(hash), entry) {
        self.growth_left -= 1
    }
    self.hashes[entry] = hash
    self.used = entry + 1
    self.live += 1
    return nil
}

func rebuild(self: Ref[Hash_Index], wanted: uint) {
    var slots: uint = group_slots
    while slots - slots / 8 < wanted {
        slots *= 2
    }
    let groups: uint = slots / group_slots
    self.ctrl = new[Array[u64]](cast[int] groups)
    self.slots = new[Array[u32]](cast[int] slots)
    var group: uint = 0
    while group < groups {
        self.ctrl[group] = empty_group
        group += 1
    }
    var entry: uint = 0
    while entry < self.used {
        if !is_dead(self, entry) {
            _ = place(self, mix(self.hashes[entry]), entry)
        }
        entry += 1
    }
    self.growth_left = slots - slots / 8 - self.live
}

func reserve(self: Ref[Hash_Index], additional: uint) {
    let needed: uint = self.used + additional
    let stored: uint = __array_length(self.hashes)
    if needed > stored {
        var next_stored: uint = 16
        while next_stored < needed {
            next_stored *= 2
        }
        require next_stored <= 0xffffffff
        var hashes: Array[u128] = new[Array[u128]](cast[int] next_stored)
        var at: uint = 0
        while at < self.used {
            hashes[at] = self.hashes[at]
            at += 1
        }
        self.hashes = hashes
        if __array_length(self.dead) != 0 {
            var dead: Array[u64] = new[Array[u64]](cast[int]((next_stored + 63) / 64))
            var word: uint = 0
            while word < __array_length(self.dead) {
                dead[word] = self.dead[word]
                word += 1
            }
            self.dead = dead
        }
    }
    if self.growth_left < additional {
        rebuild(self, self.live + additional + self.live / 2)
    }
}

func compact(self: Ref[Hash_Index]) {
    var write: uint = 0
    var read:  uint = 0
    while read < self.used {
        if !is_dead(self, read) {
            self.hashes[write] = self.hashes[read]
            write += 1
        }
        read += 1
    }
    self.used = write
    self.dead = new[Array[u64]](0)
    rebuild(self, self.live + 1 + self.live / 2)
}

inline func should_compact(self: Ref[Hash_Index]) -> bool {
    let removed: uint = self.used - self.live
    return removed != 0 and removed * 4 >= self.used
}

inline func remove_at(self: Ref[Hash_Index], slot: uint) -> uint {
    let entry: uint = cast[uint](self.slots[slot])
    if match_empty(self.ctrl[slot / group_slots]) != 0 {
        set_ctrl(self, slot, ctrl_empty)
        self.growth_left += 1
    } else {
        set_ctrl(self, slot, ctrl_dead)
    }
    if __array_length(self.dead) == 0 {
        self.dead = new[Array[u64]](cast[int]((__array_length(self.hashes) + 63) / 64))
    }
    self.dead[entry >> 6] = self.dead[entry >> 6] | (cast[u64](1) << cast[u64](entry & 63))
    self.live -= 1
    return entry
}
