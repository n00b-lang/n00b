trait Has_Length {
    func len(self: 'C) -> uint
}

trait Appendable {
    func append(self: 'L, value: 'T) -> nil
}

trait TreeLike {
    func parent(self: 'T) -> 'T?
    func child_count(self: 'T) -> uint
    func child(self: 'T, index: int) -> 'T?
}

trait Copy {
    func __copy(self: 'T) -> 'T
}
