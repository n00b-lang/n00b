import hashing
import containers.hash_index
import containers.view
import cursor
import sort
import panic

enum Sort_Order { none, insertion, key, value }

record Item {
    key:   'K
    value: 'V
}

record Entry {
    key:     'K
    value:   'V
    ordinal: uint
}

object Dict {
    entries:      Array[Entry['K, 'V]]
    count:        uint
    index:        containers.hash_index.Hash_Index
    next_ordinal: uint
}

func key_hash(key: 'K) -> u128 where 'K : hashing . Hash {
    return key.hash()
}

func ensure_entries(self: Dict['K, 'V], needed: uint) {
    let capacity: uint = __array_length(self.entries)
    if needed <= capacity {
        return
    }
    var next_capacity: uint = 16
    if capacity != 0 {
        next_capacity = capacity * 2
    }
    while next_capacity < needed {
        next_capacity *= 2
    }
    var next: Array[Entry['K, 'V]] =
        new[Array[Entry['K, 'V]]](cast[int]next_capacity)
    var at: uint = 0
    while at < self.count {
        next[at] = self.entries[at]
        at += 1
    }
    self.entries = next
}

func __init(self: Dict['K, 'V], pairs : Array[Tuple['K, 'V]] = [])
           where 'K : hashing . Hash {
    self.entries = new[Array[Entry['K, 'V]]](0)
    self.count = 0
    self.index = new[containers.hash_index.Hash_Index]()
    self.next_ordinal = 0
    for key, value in pairs {
        _ = put(self, key, value)
    }
}

func len(self: Dict['K, 'V]) -> uint {
    return self.count
}

inline func get(self: Dict['K, 'V], key: 'K) -> 'V? where 'K : hashing . Hash {
    let index: Ref[containers.hash_index.Hash_Index] = ref self.index
    let slot:  uint? = containers.hash_index.find_slot(index, key_hash(key))
    if slot == nil {
        return nil
    }
    return self.entries[containers.hash_index.entry_at(index, slot.get())].value
}

func contains(self: Dict['K, 'V], key: 'K) -> bool where 'K : hashing . Hash {
    return containers.hash_index.find_slot(ref self.index, key_hash(key)) != nil
}

func insert_entry(self: Dict['K, 'V], key: 'K, value: 'V, hash: u128)
                 -> uint? {
    ensure_entries(self, self.count + 1)
    containers.hash_index.ensure_capacity(ref self.index, 1)
    let existing: uint? =
        containers.hash_index.insert_or_find(ref self.index, hash, self.count)
    if existing != nil {
        return existing
    }
    let inserted: Entry['K, 'V] =
        (key = key, value = value, ordinal = self.next_ordinal)
    self.entries[self.count] = inserted
    self.count += 1
    self.next_ordinal += 1
    return nil
}

func replace_at(self: Dict['K, 'V], slot: uint, value: 'V) -> 'V {
    let at:    uint          = containers.hash_index.entry_at(ref self.index, slot)
    let prior: Entry['K, 'V] = self.entries[at]
    self.entries[at] =
        (key = prior.key, value = value, ordinal = prior.ordinal)
    return prior.value
}

func put(self: Dict['K, 'V], key: 'K, value: 'V)
        -> 'V? where 'K : hashing . Hash {
    let existing: uint? = insert_entry(self, key, value, key_hash(key))
    if existing != nil {
        return replace_at(self, existing.get(), value)
    }
    return nil
}

inline func add(self: Dict['K, 'V], key: 'K, value: 'V)
               -> bool where 'K : hashing . Hash {
    return insert_entry(self, key, value, key_hash(key)) == nil
}

func replace(self: Dict['K, 'V], key: 'K, value: 'V)
            -> bool where 'K : hashing . Hash {
    let found: uint? = containers.hash_index.find_slot(ref self.index, key_hash(key))
    if found == nil {
        return false
    }
    _ = replace_at(self, found.get(), value)
    return true
}

inline func remove(self: Dict['K, 'V], key: 'K)
                  -> bool where 'K : hashing . Hash {
    let hash:  u128  = key_hash(key)
    let found: uint? = containers.hash_index.find_slot(ref self.index, hash)
    if found == nil {
        return false
    }
    let removed: uint =
        containers.hash_index.entry_at(ref self.index, found.get())
    containers.hash_index.remove_at(ref self.index, found.get())
    let last: uint = self.count - 1
    if removed != last {
        let moved: Entry['K, 'V] = self.entries[last]
        self.entries[removed] = moved
        containers.hash_index.replace_entry(ref self.index, last, removed)
    }
    __array_clear(ref self.entries, last)
    self.count = last
    return true
}

func clear(self: Dict['K, 'V]) {
    self.entries = new[Array[Entry['K, 'V]]](0)
    self.count = 0
    self.index = new[containers.hash_index.Hash_Index]()
    self.next_ordinal = 0
}

func __read(self: Dict['K, 'V], key: 'K) -> 'V? where 'K : hashing . Hash {
    return get(self, key)
}

func __write(self: Dict['K, 'V], key: 'K, value: 'V)
            where 'K : hashing . Hash {
    _ = put(self, key, value)
}

func iter(self: Dict['K, 'V]) -> cursor.Cursor[Item['K, 'V]] {
    let count: int                 = cast[int]self.count
    var pairs: Array[Item['K, 'V]] = new[Array[Item['K, 'V]]](count)
    var at:    int                 = 0
    while at < count {
        let entry: Entry['K, 'V] = self.entries[at]
        pairs[at] = (key = entry.key, value = entry.value)
        at += 1
    }
    return cursor.iter(pairs)
}

func snapshot_entries(self: Dict['K, 'V]) -> Array[Entry['K, 'V]] {
    let count:   int                  = cast[int]self.count
    var entries: Array[Entry['K, 'V]] = new[Array[Entry['K, 'V]]](count)
    var at:      int                  = 0
    while at < count {
        entries[at] = self.entries[at]
        at += 1
    }
    return entries
}

func compare_insertion(left: Entry['K, 'V], right: Entry['K, 'V]) -> Comparison {
    if left.ordinal < right.ordinal {
        return Comparison.less
    }
    if left.ordinal > right.ordinal {
        return Comparison.greater
    }
    return Comparison.equal
}

func compare_key(left: Entry['K, 'V], right: Entry['K, 'V]) -> Comparison {
    let key: 'K = left.key
    typecase key {
        case Comparable {
        return key.__cmp(right.key)
    }
        else {
        panic.panic("cannot sort a dictionary by key: its key type is not " +
            "`Comparable`")
        require false
    }
    }
}

func compare_value(left: Entry['K, 'V], right: Entry['K, 'V]) -> Comparison {
    let value: 'V = left.value
    typecase value {
        case Comparable {
        return value.__cmp(right.value)
    }
        else {
        panic.panic("cannot sort a dictionary by value: its value type is " +
            "not `Comparable`")
        require false
    }
    }
}

func entries_in_insertion_order(self: Dict['K, 'V]) -> Array[Entry['K, 'V]] {
    var entries: Array[Entry['K, 'V]]                   = snapshot_entries(self)
    let by:      sort.Comparator[Entry['K, 'V]] =
        callback[sort.Comparator](ref compare_insertion)
    sort.sort_by(entries, by)
    return entries
}

func entries_in_key_order(self: Dict['K, 'V]) -> Array[Entry['K, 'V]] {
    var entries: Array[Entry['K, 'V]]                   = snapshot_entries(self)
    let by:      sort.Comparator[Entry['K, 'V]] =
        callback[sort.Comparator](ref compare_key)
    sort.sort_by(entries, by)
    return entries
}

func entries_in_value_order(self: Dict['K, 'V]) -> Array[Entry['K, 'V]] {
    var entries: Array[Entry['K, 'V]]                   = snapshot_entries(self)
    let by:      sort.Comparator[Entry['K, 'V]] =
        callback[sort.Comparator](ref compare_value)
    sort.sort_by(entries, by)
    return entries
}

func ordered_entries(self: Dict['K, 'V], order: Sort_Order) -> Array[Entry['K, 'V]] {
    if order == Sort_Order.none {
        return snapshot_entries(self)
    }
    if order == Sort_Order.insertion {
        return entries_in_insertion_order(self)
    }
    if order == Sort_Order.key {
        return entries_in_key_order(self)
    }
    return entries_in_value_order(self)
}

func key_view(entries: Array[Entry['K, 'V]], count: int)
             -> containers.view.View['K] {
    var items: Array['K] = new[Array['K]](count)
    var at:    int       = 0
    while at < count {
        items[at] = entries[at].key
        at += 1
    }
    return new[containers.view.View['K]](items, 0, count)
}

func value_view(entries: Array[Entry['K, 'V]], count: int)
               -> containers.view.View['V] {
    var items: Array['V] = new[Array['V]](count)
    var at:    int       = 0
    while at < count {
        items[at] = entries[at].value
        at += 1
    }
    return new[containers.view.View['V]](items, 0, count)
}

func keys(self: Dict['K, 'V],
                 sort_order : Sort_Order = Sort_Order.none)
         -> containers.view.View['K] {
    if sort_order == Sort_Order.none {
        return key_view(self.entries, cast[int]self.count)
    }
    return key_view(ordered_entries(self, sort_order),
                    cast[int]self.count)
}

func values(self: Dict['K, 'V],
                   sort_order : Sort_Order = Sort_Order.none)
           -> containers.view.View['V] {
    if sort_order == Sort_Order.none {
        return value_view(self.entries, cast[int]self.count)
    }
    return value_view(ordered_entries(self, sort_order),
                      cast[int]self.count)
}

alias litmod d = dict
dict litmod dict(pairs: Array[Tuple['K, 'V]]) -> Dict['K, 'V] fail: string {
    return new[Dict['K, 'V]](pairs = pairs)
}
