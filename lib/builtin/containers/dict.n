import hashing
import containers.hash_index
import containers.slice
import containers.lease
import cursor
import sort
import panic

enum Sort_Order { none, insertion, key, value }

record Item {
    key:   'K
    value: 'V
}

record Entry {
    key:   'K
    value: 'V
    live:  bool
}

object Dict {
    entries: containers.lease.Leasable[Entry['K, 'V]]
    index:   containers.hash_index.Hash_Index
}

record Dict_Cursor {
    lease: containers.lease.Lease[Entry['K, 'V]]
    end:   uint
    index: uint
}

func key_hash(key: 'K) -> u128 where 'K : hashing . Hash {
    return key.hash()
}

func ensure_entries(self: Dict['K, 'V], needed: uint) {
    let capacity: uint = containers.lease.len(self.entries)
    if needed <= capacity {
        return
    }
    var next_capacity: uint = 16
    if capacity != 0 {
        next_capacity = capacity * 2
    }
    while next_capacity < needed {
        next_capacity *= 2
    }
    var next: Array[Entry['K, 'V]] =
        new[Array[Entry['K, 'V]]](cast[int]next_capacity)
    var at: uint = 0
    while at < self.index.used {
        next[at] = self.entries[cast[int]at]
        at += 1
    }
    containers.lease.replace_storage(self.entries, next)
}

func compact(self: Dict['K, 'V]) {
    let used:  uint = self.index.used
    var write: uint = 0
    var read:  uint = 0
    while read < used {
        if !containers.hash_index.is_dead(ref self.index, read) {
            if write != read {
                self.entries[cast[int]write] = self.entries[cast[int]read]
            }
            write += 1
        }
        read += 1
    }
    while read > write {
        read -= 1
        __array_clear(containers.lease.writable(self.entries), read)
    }
    containers.hash_index.compact(ref self.index)
}

inline func prepare(self: Dict['K, 'V]) {
    if self.index.used == containers.lease.len(self.entries) {
        if containers.hash_index.should_compact(ref self.index) {
            compact(self)
        } else {
            ensure_entries(self, self.index.used + 1)
        }
    }
    containers.hash_index.reserve(ref self.index, 1)
}

func __init(self: Dict['K, 'V], pairs : Array[Tuple['K, 'V]] = [])
           where 'K : hashing . Hash {
    self.entries = new[containers.lease.Leasable[Entry['K, 'V]]](
        new[Array[Entry['K, 'V]]](0))
    self.index = new[containers.hash_index.Hash_Index]()
    for key, value in pairs {
        _ = put(self, key, value)
    }
}

func len(self: Dict['K, 'V]) -> uint {
    return self.index.live
}

inline func get(self: Dict['K, 'V], key: 'K) -> 'V? where 'K : hashing . Hash {
    let entry: uint? = containers.hash_index.find(ref self.index, key_hash(key))
    if entry == nil {
        return nil
    }
    return self.entries[cast[int]entry].value
}

func contains(self: Dict['K, 'V], key: 'K) -> bool where 'K : hashing . Hash {
    return containers.hash_index.find(ref self.index, key_hash(key)) != nil
}

inline func insert_entry(self: Dict['K, 'V], key: 'K, value: 'V, hash: u128)
                        -> uint? {
    prepare(self)
    let existing: uint? = containers.hash_index.insert(ref self.index, hash)
    if existing != nil {
        return existing
    }
    let entry: Entry['K, 'V] = (key = key, value = value, live = true)
    self.entries[cast[int](self.index.used - 1)] = entry
    return nil
}

inline func replace_at(self: Dict['K, 'V], entry: uint, value: 'V) -> 'V {
    let prior: Entry['K, 'V] = self.entries[cast[int]entry]
    let replaced: Entry['K, 'V] = (key = prior.key, value = value,
                                   live = true)
    self.entries[cast[int]entry] = replaced
    return prior.value
}

func put(self: Dict['K, 'V], key: 'K, value: 'V)
        -> 'V? where 'K : hashing . Hash {
    let existing: uint? = insert_entry(self, key, value, key_hash(key))
    if existing != nil {
        return replace_at(self, existing, value)
    }
    return nil
}

inline func add(self: Dict['K, 'V], key: 'K, value: 'V)
               -> bool where 'K : hashing . Hash {
    return insert_entry(self, key, value, key_hash(key)) == nil
}

func replace(self: Dict['K, 'V], key: 'K, value: 'V)
            -> bool where 'K : hashing . Hash {
    let found: uint? = containers.hash_index.find(ref self.index, key_hash(key))
    if found == nil {
        return false
    }
    _ = replace_at(self, found, value)
    return true
}

inline func remove(self: Dict['K, 'V], key: 'K)
                  -> bool where 'K : hashing . Hash {
    let found: uint? = containers.hash_index.find_slot(ref self.index,
                                                       key_hash(key))
    if found == nil {
        return false
    }
    let removed: uint = containers.hash_index.remove_at(ref self.index,
                                                        found)
    __array_clear(containers.lease.writable(self.entries), removed)
    return true
}

func clear(self: Dict['K, 'V]) {
    containers.lease.replace_storage(self.entries,
                                     new[Array[Entry['K, 'V]]](0))
    self.index = new[containers.hash_index.Hash_Index]()
}

func __read(self: Dict['K, 'V], key: 'K) -> 'V? where 'K : hashing . Hash {
    return get(self, key)
}

func __write(self: Dict['K, 'V], key: 'K, value: 'V)
            where 'K : hashing . Hash {
    _ = put(self, key, value)
}

func __iterator(self: Dict['K, 'V]) -> Dict_Cursor['K, 'V] {
    return new[Dict_Cursor['K, 'V]](ref self.entries, self.index.used)
}

func __init(modify self: Dict_Cursor['K, 'V],
            consume lease: containers.lease.Lease[Entry['K, 'V]], end: uint) {
    self.lease = lease
    self.end = end
    self.index = 0
}

func __next(modify self: Dict_Cursor['K, 'V]) -> Tuple['K, 'V]? {
    while self.index < self.end {
        let entry: Entry['K, 'V] = self.lease.__value[self.index]
        self.index += 1
        if entry.live {
            return (entry.key, entry.value)
        }
    }
    containers.lease.release(self.lease)
    return nil
}

func __cleanup(consume self: Dict_Cursor['K, 'V]) {
    containers.lease.release(self.lease)
}

func snapshot_entries(self: Dict['K, 'V]) -> Array[Entry['K, 'V]] {
    var entries: Array[Entry['K, 'V]] =
        new[Array[Entry['K, 'V]]](cast[int]self.index.live)
    var write: uint = 0
    var read:  uint = 0
    while read < self.index.used {
        if !containers.hash_index.is_dead(ref self.index, read) {
            entries[write] = self.entries[cast[int]read]
            write += 1
        }
        read += 1
    }
    return entries
}

func compare_key(left: Entry['K, 'V], right: Entry['K, 'V]) -> Comparison {
    let key: 'K = left.key
    typecase key {
        case Comparable {
        return key.__cmp(right.key)
    }
        else {
        panic.panic("cannot sort a dictionary by key: its key type is not " +
            "`Comparable`")
        require false
    }
    }
}

func compare_value(left: Entry['K, 'V], right: Entry['K, 'V]) -> Comparison {
    let value: 'V = left.value
    typecase value {
        case Comparable {
        return value.__cmp(right.value)
    }
        else {
        panic.panic("cannot sort a dictionary by value: its value type is " +
            "not `Comparable`")
        require false
    }
    }
}

func entries_in_key_order(self: Dict['K, 'V]) -> Array[Entry['K, 'V]] {
    var entries: Array[Entry['K, 'V]]                   = snapshot_entries(self)
    let by:      sort.Comparator[Entry['K, 'V]] =
        callback[sort.Comparator](ref compare_key)
    sort.sort_by(entries, by)
    return entries
}

func entries_in_value_order(self: Dict['K, 'V]) -> Array[Entry['K, 'V]] {
    var entries: Array[Entry['K, 'V]]                   = snapshot_entries(self)
    let by:      sort.Comparator[Entry['K, 'V]] =
        callback[sort.Comparator](ref compare_value)
    sort.sort_by(entries, by)
    return entries
}

func ordered_entries(self: Dict['K, 'V], order: Sort_Order) -> Array[Entry['K, 'V]] {
    if order == Sort_Order.none or order == Sort_Order.insertion {
        return snapshot_entries(self)
    }
    if order == Sort_Order.key {
        return entries_in_key_order(self)
    }
    return entries_in_value_order(self)
}

func key_slice(entries: Array[Entry['K, 'V]], count: int)
              -> containers.slice.Slice['K] {
    var items: Array['K] = new[Array['K]](count)
    var at:    int       = 0
    while at < count {
        items[at] = entries[at].key
        at += 1
    }
    return new[containers.slice.Slice['K]](items, 0, count)
}

func value_slice(entries: Array[Entry['K, 'V]], count: int)
                -> containers.slice.Slice['V] {
    var items: Array['V] = new[Array['V]](count)
    var at:    int       = 0
    while at < count {
        items[at] = entries[at].value
        at += 1
    }
    return new[containers.slice.Slice['V]](items, 0, count)
}

func insertion_keys(self: Dict['K, 'V]) -> containers.slice.Slice['K] {
    return key_slice(snapshot_entries(self), cast[int]self.index.live)
}

func keys(self: Dict['K, 'V],
                 sort_order : Sort_Order = Sort_Order.none)
         -> containers.slice.Slice['K] {
    if sort_order == Sort_Order.none {
        return insertion_keys(self)
    }
    return key_slice(ordered_entries(self, sort_order),
                     cast[int]self.index.live)
}

func values(self: Dict['K, 'V],
                   sort_order : Sort_Order = Sort_Order.none)
           -> containers.slice.Slice['V] {
    return value_slice(ordered_entries(self, sort_order),
                       cast[int]self.index.live)
}

alias litmod d = dict
dict litmod dict(pairs: Array[Tuple['K, 'V]]) -> Dict['K, 'V] fail: string
    where 'K : hashing . Hash {
    return new[Dict['K, 'V]](pairs = pairs)
}

func is_subset(left: Dict['K, nil], right: Dict['K, nil])
              -> bool where 'K : hashing . Hash {
    for value in insertion_keys(left) {
        if !contains(right, value) {
            return false
        }
    }
    return true
}

func is_superset(left: Dict['K, nil], right: Dict['K, nil])
                -> bool where 'K : hashing . Hash {
    return is_subset(right, left)
}

func is_disjoint(left: Dict['K, nil], right: Dict['K, nil])
                -> bool where 'K : hashing . Hash {
    for value in insertion_keys(left) {
        if contains(right, value) {
            return false
        }
    }
    return true
}

func __equal(view self: Dict['K, nil], view other: Dict['K, nil])
            -> bool where 'K : hashing . Hash {
    return len(self) == len(other) and is_subset(self, other)
}

func hash(self: Dict['K, nil]) -> u128 where 'K : hashing . Hash {
    result = len(self)
    for value in insertion_keys(self) {
        result = result ^ value.hash()
    }
    return result
}

func __add(view left: Dict['K, nil], view right: Dict['K, nil])
          -> Dict['K, nil] where 'K : hashing . Hash {
    result = new[Dict['K, nil]]()
    for value in insertion_keys(left) {
        _ = add(result, value, nil)
    }
    for value in insertion_keys(right) {
        _ = add(result, value, nil)
    }
    return result
}

func __subtract(view left: Dict['K, nil], view right: Dict['K, nil])
               -> Dict['K, nil] where 'K : hashing . Hash {
    result = new[Dict['K, nil]]()
    for value in insertion_keys(left) {
        if !contains(right, value) {
            _ = add(result, value, nil)
        }
    }
    return result
}

func __bit_and(view left: Dict['K, nil], view right: Dict['K, nil])
              -> Dict['K, nil] where 'K : hashing . Hash {
    result = new[Dict['K, nil]]()
    for value in insertion_keys(left) {
        if contains(right, value) {
            _ = add(result, value, nil)
        }
    }
    return result
}

func __bit_xor(view left: Dict['K, nil], view right: Dict['K, nil])
              -> Dict['K, nil] where 'K : hashing . Hash {
    result = new[Dict['K, nil]]()
    for value in insertion_keys(left) {
        if !contains(right, value) {
            _ = add(result, value, nil)
        }
    }
    for value in insertion_keys(right) {
        if !contains(left, value) {
            _ = add(result, value, nil)
        }
    }
    return result
}

alias litmod s = set
set litmod set(items: Array['K]) -> Dict['K, nil] fail: string
    where 'K : hashing . Hash {
    result = new[Dict['K, nil]]()
    for value in items {
        _ = add(result, value, nil)
    }
    return result
}
