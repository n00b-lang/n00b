import containers.traits
import containers.view
import cursor
import panic

object List {
    items: Array['T]
    count: uint
}

func __init(self: List['T], items : Array['T] = []) {
    self.items = items
    self.count = __array_length(items)
}

func len(self: List['T]) -> uint {
    return self.count
}

func list_with_length(items: Array['T], n: uint) -> List['T] {
    let list: List['T] = new[List['T]](items = items)
    list.count = n
    return list
}

func checked_index(self: List['T], index: int) -> int {
    var at: int = index
    if at < 0 {
        at += cast[int]self.count
    }
    if at < 0 or cast[uint](at) >= self.count {
        panic.index_out_of_range(index, self.count, "a list")
    }
    return at
}

private func check_range(self: List['T], start: int, end: int) {
    if start < 0 or end < start or cast[uint](end) > self.count {
        panic.range_out_of_bounds(start, end, self.count, "a list")
    }
}

func __read(self: List['T], index: int) -> 'T {
    return self.items[checked_index(self, index)]
}

func __write(self: List['T], index: int, value: 'T) {
    self.items[checked_index(self, index)] = value
}

func __slice(self: List['T], start_ix: int,
                    end_ix: int) -> containers.view.View['T] {
    check_range(self, start_ix, end_ix)
    let length: int       = end_ix - start_ix
    var items:  Array['T] = new[Array['T]](length)
    var at:     int       = 0
    while at < length {
        items[at] = self.items[start_ix + at]
        at += 1
    }
    return containers.view.__slice(items, 0, length)
}

func __write_slice(self: List['T], start_ix: int?,
                          end_ix: int?, inclusive: bool,
                          values: List['T]) {
    var start: int = 0
    if start_ix != nil {
        start = start_ix.get()
    }
    var end: int = cast[int]self.count
    if end_ix != nil {
        end = end_ix.get()
        if end < 0 {
            end += cast[int]self.count
        }
        if inclusive {
            end += 1
        }
    }
    if start < 0 {
        start += cast[int]self.count
    }
    check_range(self, start, end)

    let incoming: uint      = values.count
    var snapshot: Array['T] = new[Array['T]](cast[int]incoming)
    var at:       int       = 0
    while at < incoming {
        snapshot[at] = values.items[at]
        at += 1
    }
    let removed: uint = cast[uint](end - start)
    let length:  uint = self.count - removed + incoming
    ensure_capacity(self, length)
    if incoming > removed {
        let growth: uint = incoming - removed
        var tail:   uint = self.count
        while tail > cast[uint]end {
            tail -= 1
            self.items[tail + growth] = self.items[tail]
        }
    } elif incoming < removed {
        let shrink: uint = removed - incoming
        var tail:   uint = cast[uint]end
        while tail < self.count {
            self.items[tail - shrink] = self.items[tail]
            tail += 1
        }
    }
    at = 0
    while at < incoming {
        self.items[start + at] = snapshot[at]
        at += 1
    }
    if length < self.count {
        var stale: uint = length
        while stale < self.count {
            __array_clear(ref self.items, stale)
            stale += 1
        }
    }
    self.count = length
}

func ensure_capacity(self: List['T], needed: uint) {
    let capacity: uint = __array_length(self.items)
    if needed <= capacity {
        return
    }
    var next_capacity: uint = 16
    while next_capacity < needed {
        next_capacity *= 2
    }
    var next:  Array['T] = new[Array['T]](cast[int]next_capacity)
    var index: uint      = 0
    while index < self.count {
        let value: 'T = self.items[index]
        next[index] = value
        index += 1
    }
    self.items = next
}

func append(self: List['T], value: 'T,
                   front : bool = false) {
    ensure_capacity(self, self.count + 1)
    if front {
        var index: uint = self.count
        while index > 0 {
            self.items[index] = self.items[index - 1]
            index -= 1
        }
        self.items[0] = value
    } else {
        self.items[self.count] = value
    }
    self.count += 1
}

func insert(self: List['T], index: int, value: 'T) {
    if index < 0 or cast[uint](index) > self.count {
        panic.index_out_of_range(index, self.count + 1,
                                 "an insertion into a list")
    }
    ensure_capacity(self, self.count + 1)
    var at: uint = self.count
    while at > cast[uint]index {
        self.items[at] = self.items[at - 1]
        at -= 1
    }
    self.items[index] = value
    self.count += 1
}

func pop(self: List['T], front : bool = false) -> 'T? {
    if self.count == 0 {
        return nil
    }
    var index: uint = self.count - 1
    if front {
        index = 0
    }
    let value: 'T = self.items[index]
    if front {
        while index + 1 < self.count {
            self.items[index] = self.items[index + 1]
            index += 1
        }
    }
    self.count -= 1
    __array_clear(ref self.items, self.count)
    return value
}

func find(self: List['T], value: 'T) -> int? where 'T : Equal {
    var at: uint = 0
    while at < self.count {
        if self.items[at] == value {
            return cast[int]at
        }
        at += 1
    }
    return nil
}

func remove(self: List['T], value: 'T,
                   all : bool = true) -> uint where 'T : Equal {
    var read:    uint = 0
    var write:   uint = 0
    var removed: uint = 0
    while read < self.count {
        let item: 'T = self.items[read]
        if (all or removed == 0) and item == value {
            removed += 1
        } else {
            if write != read {
                self.items[write] = item
            }
            write += 1
        }
        read += 1
    }
    var stale: uint = write
    while stale < self.count {
        __array_clear(ref self.items, stale)
        stale += 1
    }
    self.count = write
    return removed
}

func clear(self: List['T]) {
    self.items = new[Array['T]](0)
    self.count = 0
}

func to_array(consume self: List['T]) -> Array['T] {
    return __array_prefix(self.items, self.count)
}

func __add(self: List['T], other: List['T]) -> List['T] {
    let size:  uint      = self.count + other.count
    var items: Array['T] = new[Array['T]](cast[int]size)
    var at:    uint      = 0
    while at < self.count {
        items[at] = self.items[at]
        at += 1
    }
    var right: uint = 0
    while right < other.count {
        items[at] = other.items[right]
        at += 1
        right += 1
    }
    return new[List['T]](items = items)
}

func iter(self: List['T]) -> cursor.Cursor['T] {
    var items: Array['T] = new[Array['T]](cast[int]self.count)
    var at:    uint      = 0
    while at < self.count {
        items[at] = self.items[at]
        at += 1
    }
    let view: containers.view.View['T] =
        containers.view.__slice(items, 0, cast[int]self.count)
    return new[cursor.Cursor['T]](view)
}

alias litmod l = list
sequence litmod list(items: Array['T]) -> List['T] fail: string {
    return new[List['T]](items = items)
}
