import containers.list

private variant Tree_Contents {
    node_value: Ref['N]
    leaf_value: Ref['L]
}

object Tree {
    parent:           Tree['N, 'L]?
    private contents: Tree_Contents['N, 'L]?
    children:         List[Tree['N, 'L]]
}

func __init(self: Tree['N, 'L]) {
    self.parent = nil
    self.contents = nil
    self.children = new[List[Tree['N, 'L]]]()
}

func is_leaf(self: Tree['N, 'L]) -> bool {
    let maybe: Tree_Contents['N, 'L]? = self.contents
    if maybe == nil {
        return false
    }
    let contents: Tree_Contents['N, 'L] = maybe.get()
    switch contents {
        case node_value {
            return false
        }
        case leaf_value {
            return true
        }
    }
}

func set_node(self: Tree['N, 'L], value: 'N) {
    var owned:    'N                    = value
    var contents: Tree_Contents['N, 'L] = new[Tree_Contents['N, 'L]]()
    contents.node_value = ref owned
    self.contents = contents
}

func set_leaf(self: Tree['N, 'L], value: 'L) {
    var owned:    'L                    = value
    var contents: Tree_Contents['N, 'L] = new[Tree_Contents['N, 'L]]()
    contents.leaf_value = ref owned
    self.contents = contents
}

func node(self: Tree['N, 'L]) -> Ref['N]? {
    let maybe: Tree_Contents['N, 'L]? = self.contents
    if maybe == nil {
        return nil
    }
    let contents: Tree_Contents['N, 'L] = maybe.get()
    switch contents {
        case node_value {
            let found: Ref['N]? = contents.node_value
            return found
        }
        case leaf_value {
            return nil
        }
    }
}

func leaf(self: Tree['N, 'L]) -> Ref['L]? {
    let maybe: Tree_Contents['N, 'L]? = self.contents
    if maybe == nil {
        return nil
    }
    let contents: Tree_Contents['N, 'L] = maybe.get()
    switch contents {
        case node_value {
            return nil
        }
        case leaf_value {
            let found: Ref['L]? = contents.leaf_value
            return found
        }
    }
}

func child_count(self: Tree['N, 'L]) -> uint {
    return self.children.count
}

func child(self: Tree['N, 'L], index: int) -> Tree['N, 'L]? {
    let count: int = cast[int]self.children.count
    if index < -count or index >= count {
        return nil
    }
    var at: int = index
    if at < 0 {
        at += count
    }
    return self.children.items[at]
}

private func can_attach(self: Tree['N, 'L], child: Tree['N, 'L]) -> bool {
    if child.parent != nil {
        return false
    }
    var current: Tree['N, 'L] = self
    while true {
        if current == child {
            return false
        }
        let next: Tree['N, 'L]? = current.parent
        if next == nil {
            return true
        }
        current = next.get()
    }
}

func add_child(self: Tree['N, 'L], child: Tree['N, 'L]) -> bool {
    if !can_attach(self, child) {
        return false
    }
    containers.list.append(self.children, child)
    child.parent = self
    return true
}

func insert_child(self: Tree['N, 'L], index: int,
                  child: Tree['N, 'L]) -> bool {
    if index < 0 or index > cast[int](self.children.count) or
       !can_attach(self, child) {
        return false
    }
    containers.list.insert(self.children, index, child)
    child.parent = self
    return true
}

func remove_child(self: Tree['N, 'L], index: int) -> Tree['N, 'L]? {
    let found: Tree['N, 'L]? = child(self, index)
    if found == nil {
        return nil
    }
    let count: int = cast[int]self.children.count
    var at:    int = index
    if at < 0 {
        at += count
    }
    while at + 1 < count {
        self.children.items[at] = self.children.items[at + 1]
        at += 1
    }
    _ = containers.list.pop(self.children)
    let removed: Tree['N, 'L] = found.get()
    removed.parent = nil
    return removed
}

func parent(self: Tree['N, 'L]) -> Tree['N, 'L]? {
    return self.parent
}

func root(self: Tree['N, 'L]) -> Tree['N, 'L] {
    var current: Tree['N, 'L]  = self
    var next:    Tree['N, 'L]? = current.parent
    while next != nil {
        current = next.get()
        next = current.parent
    }
    return current
}

func depth(self: Tree['N, 'L]) -> uint {
    var result:  uint          = 0
    var current: Tree['N, 'L]  = self
    var next:    Tree['N, 'L]? = current.parent
    while next != nil {
        current = next.get()
        result += 1
        next = current.parent
    }
    return result
}
