import containers.list

private variant Tree_Contents {
    node_value: Ref['N]
    leaf_value: Ref['L]
}

record Tree {
    parent:           Ref[Tree['N, 'L]]?
    private contents: Tree_Contents['N, 'L]?
    children:         List[Ref[Tree['N, 'L]]]
}

func __init(modify self: Tree['N, 'L]) {
    self.parent = nil
    self.contents = nil
    self.children = new[List[Ref[Tree['N, 'L]]]]()
}

func is_leaf(self: Ref[Tree['N, 'L]]) -> bool {
    let maybe: Tree_Contents['N, 'L]? = self.contents
    if maybe == nil {
        return false
    }
    let contents: Tree_Contents['N, 'L] = maybe.get()
    switch contents {
        case node_value {
            return false
        }
        case leaf_value {
            return true
        }
    }
}

func set_node(self: Ref[Tree['N, 'L]], value: 'N) {
    var owned:    'N                    = value
    var tree:     Tree['N, 'L]          = ref_read(self)
    var contents: Tree_Contents['N, 'L] = new[Tree_Contents['N, 'L]]()
    contents.node_value = ref owned
    tree.contents = contents
    ref_write(self, tree)
}

func set_leaf(self: Ref[Tree['N, 'L]], value: 'L) {
    var owned:    'L                    = value
    var tree:     Tree['N, 'L]          = ref_read(self)
    var contents: Tree_Contents['N, 'L] = new[Tree_Contents['N, 'L]]()
    contents.leaf_value = ref owned
    tree.contents = contents
    ref_write(self, tree)
}

func node(self: Ref[Tree['N, 'L]]) -> Ref['N]? {
    let maybe: Tree_Contents['N, 'L]? = self.contents
    if maybe == nil {
        return nil
    }
    let contents: Tree_Contents['N, 'L] = maybe.get()
    switch contents {
        case node_value {
            let found: Ref['N]? = contents.node_value
            return found
        }
        case leaf_value {
            return nil
        }
    }
}

func leaf(self: Ref[Tree['N, 'L]]) -> Ref['L]? {
    let maybe: Tree_Contents['N, 'L]? = self.contents
    if maybe == nil {
        return nil
    }
    let contents: Tree_Contents['N, 'L] = maybe.get()
    switch contents {
        case node_value {
            return nil
        }
        case leaf_value {
            let found: Ref['L]? = contents.leaf_value
            return found
        }
    }
}

func child_count(self: Ref[Tree['N, 'L]]) -> uint {
    return self.children.count
}

func child(self: Ref[Tree['N, 'L]], index: int) -> Ref[Tree['N, 'L]]? {
    let count: int = cast[int]self.children.count
    if index < -count or index >= count {
        return nil
    }
    var at: int = index
    if at < 0 {
        at += count
    }
    return self.children.items[at]
}

private func can_attach(self : Ref[Tree['N, 'L]],
                        child: Ref[Tree['N, 'L]]) -> bool {
    if child.parent != nil {
        return false
    }
    var current: Ref[Tree['N, 'L]] = self
    while true {
        if current == child {
            return false
        }
        let next: Ref[Tree['N, 'L]]? = current.parent
        if next == nil {
            return true
        }
        current = next.get()
    }
}

private func set_parent(self : Ref[Tree['N, 'L]],
                        value: Ref[Tree['N, 'L]]?) {
    var tree: Tree['N, 'L] = ref_read(self)
    tree.parent = value
    ref_write(self, tree)
}

func add_child(self : Ref[Tree['N, 'L]],
               child: Ref[Tree['N, 'L]]) -> bool {
    if !can_attach(self, child) {
        return false
    }
    var tree: Tree['N, 'L] = ref_read(self)
    containers.list.append(tree.children, child)
    ref_write(self, tree)
    set_parent(child, self)
    return true
}

func insert_child(self : Ref[Tree['N, 'L]], index: int,
                  child: Ref[Tree['N, 'L]]) -> bool {
    if index < 0 or index > cast[int]self.children.count or
       !can_attach(self, child) {
        return false
    }
    var tree: Tree['N, 'L] = ref_read(self)
    containers.list.insert(tree.children, index, child)
    ref_write(self, tree)
    set_parent(child, self)
    return true
}

func remove_child(self: Ref[Tree['N, 'L]], index: int) -> Ref[Tree['N, 'L]]? {
    let found: Ref[Tree['N, 'L]]? = child(self, index)
    if found == nil {
        return nil
    }
    var tree:  Tree['N, 'L] = ref_read(self)
    let count: int          = cast[int]tree.children.count
    var at:    int          = index
    if at < 0 {
        at += count
    }
    while at + 1 < count {
        tree.children.items[at] = tree.children.items[at + 1]
        at += 1
    }
    _ = containers.list.pop(tree.children)
    ref_write(self, tree)
    let removed: Ref[Tree['N, 'L]] = found.get()
    set_parent(removed, nil)
    return removed
}

func parent(self: Ref[Tree['N, 'L]]) -> Ref[Tree['N, 'L]]? {
    return self.parent
}

func root(self: Ref[Tree['N, 'L]]) -> Ref[Tree['N, 'L]] {
    var current: Ref[Tree['N, 'L]]  = self
    var next:    Ref[Tree['N, 'L]]? = current.parent
    while next != nil {
        current = next.get()
        next = current.parent
    }
    return current
}

func depth(self: Ref[Tree['N, 'L]]) -> uint {
    var result:  uint               = 0
    var current: Ref[Tree['N, 'L]]  = self
    var next:    Ref[Tree['N, 'L]]? = current.parent
    while next != nil {
        current = next.get()
        result += 1
        next = current.parent
    }
    return result
}
