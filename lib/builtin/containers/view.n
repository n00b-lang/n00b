import panic

record View {
    private target: Ref['T]
    private items:  Array['T]?
    private start:  uint
    private count:  uint
}

func __init(modify self: View['T], target: Ref['T],
            items: Array['T]? = nil, start: uint = 0, count: uint = 1) {
    self.target = target
    self.items = items
    self.start = start
    self.count = count
}

func __ref_address(self: View['T]) -> Ref['T] {
    return self.target
}

inline func __read(self: View['T], index: int) -> 'T {
    if index < 0 or (cast[uint] index) >= self.count {
        panic.index_out_of_range(index, self.count, "a view")
    }
    let backing: Array['T]? = self.items
    if backing != nil {
        return backing[self.start + cast[uint] index]
    }
    return self.target.__value
}

inline func len(self: View['T]) -> uint {
    return self.count
}

func __equal(view self: View['T], view other: View['T]) -> bool {
    return self.target == other.target and self.count == other.count
}

func view(items: Array['T], start_ix: int, end_ix: int) -> View['T] {
    let available: uint = __array_length(items)
    if start_ix < 0 or start_ix >= end_ix
        or (cast[uint] end_ix) > available {
        panic.index_out_of_range(end_ix, available, "an array")
    }
    return new[View['T]](ref items[start_ix], items, cast[uint] start_ix,
                         cast[uint](end_ix - start_ix))
}
