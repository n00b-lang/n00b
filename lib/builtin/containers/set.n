import hashing
import containers.dict
import cursor

object Set {
    items: Dict['T, nil]
}

func __init(self: Set['T], items : Array['T] = [])
           where 'T : hashing . Hash {
    self.items = new[Dict['T, nil]]()
    for value in items {
        _ = add(self, value)
    }
}

func len(self: Set['T]) -> uint {
    return self.items.len()
}

func contains(self: Set['T], value: 'T) -> bool where 'T : hashing . Hash {
    return self.items.contains(value)
}

func add(self: Set['T], value: 'T) -> bool where 'T : hashing . Hash {
    return self.items.add(value, nil)
}

func remove(self: Set['T], value: 'T) -> bool where 'T : hashing . Hash {
    return self.items.remove(value)
}

func clear(self: Set['T]) {
    containers.dict.clear(self.items)
}

func iter(self: Set['T]) -> cursor.Cursor['T] {
    return cursor.iter(containers.dict.insertion_keys(self.items))
}

func is_subset(left: Set['T], right: Set['T]) -> bool where 'T : hashing . Hash {
    for value in left {
        if !contains(right, value) {
            return false
        }
    }
    return true
}

func is_superset(left: Set['T], right: Set['T])
                -> bool where 'T : hashing . Hash {
    return is_subset(right, left)
}

func is_disjoint(left: Set['T], right: Set['T])
                -> bool where 'T : hashing . Hash {
    for value in left {
        if contains(right, value) {
            return false
        }
    }
    return true
}

func __equal(self: Set['T], other: Set['T]) -> bool where 'T : hashing . Hash {
    return len(self) == len(other) and is_subset(self, other)
}

func hash(self: Set['T]) -> u128 where 'T : hashing . Hash {
    var result: u128 = len(self)
    for value in self {
        result = result ^ value.hash()
    }
    return result
}

func __add(left: Set['T], right: Set['T]) -> Set['T] where 'T : hashing . Hash {
    let result: Set['T] = new[Set['T]]()
    for value in left {
        _ = add(result, value)
    }
    for value in right {
        _ = add(result, value)
    }
    return result
}

func __subtract(left: Set['T], right: Set['T])
               -> Set['T] where 'T : hashing . Hash {
    let result: Set['T] = new[Set['T]]()
    for value in left {
        if !contains(right, value) {
            _ = add(result, value)
        }
    }
    return result
}

func __bit_and(left: Set['T], right: Set['T])
              -> Set['T] where 'T : hashing . Hash {
    let result: Set['T] = new[Set['T]]()
    for value in left {
        if contains(right, value) {
            _ = add(result, value)
        }
    }
    return result
}

func __bit_xor(left: Set['T], right: Set['T])
              -> Set['T] where 'T : hashing . Hash {
    let result: Set['T] = new[Set['T]]()
    for value in left {
        if !contains(right, value) {
            _ = add(result, value)
        }
    }
    for value in right {
        if !contains(left, value) {
            _ = add(result, value)
        }
    }
    return result
}

alias litmod s = set
set litmod set(items: Array['T]) -> Set['T] fail: string {
    return new[Set['T]](items = items)
}
