import hashing
import containers.hash_index
import cursor

object Set {
    keys:  Array['T]
    index: containers.hash_index.Hash_Index
}

func ensure_keys(self: Set['T], needed: uint) {
    let capacity: uint = __array_length(self.keys)
    if needed <= capacity {
        return
    }
    var next_capacity: uint = 16
    if capacity != 0 {
        next_capacity = capacity * 2
    }
    while next_capacity < needed {
        next_capacity *= 2
    }
    var next: Array['T] = new[Array['T]](cast[int]next_capacity)
    var at:   uint      = 0
    while at < self.index.used {
        next[at] = self.keys[at]
        at += 1
    }
    self.keys = next
}

func compact(self: Set['T]) {
    let used:  uint = self.index.used
    var write: uint = 0
    var read:  uint = 0
    while read < used {
        if !containers.hash_index.is_dead(ref self.index, read) {
            if write != read {
                self.keys[write] = self.keys[read]
            }
            write += 1
        }
        read += 1
    }
    while read > write {
        read -= 1
        __array_clear(ref self.keys, read)
    }
    containers.hash_index.compact(ref self.index)
}

inline func prepare(self: Set['T]) {
    if self.index.used == __array_length(self.keys) {
        if containers.hash_index.should_compact(ref self.index) {
            compact(self)
        } else {
            ensure_keys(self, self.index.used + 1)
        }
    }
    containers.hash_index.reserve(ref self.index, 1)
}

func __init(self: Set['T], items : Array['T] = [])
           where 'T : hashing . Hash {
    self.keys = new[Array['T]](0)
    self.index = new[containers.hash_index.Hash_Index]()
    for value in items {
        _ = add(self, value)
    }
}

func len(self: Set['T]) -> uint {
    return self.index.live
}

inline func contains(self: Set['T], value: 'T) -> bool where 'T : hashing . Hash {
    return containers.hash_index.find(ref self.index, value.hash()) != nil
}

inline func add(self: Set['T], value: 'T)
               -> bool where 'T : hashing . Hash {
    prepare(self)
    if containers.hash_index.insert(ref self.index, value.hash()) != nil {
        return false
    }
    self.keys[self.index.used - 1] = value
    return true
}

inline func remove(self: Set['T], value: 'T)
                  -> bool where 'T : hashing . Hash {
    let found: uint? = containers.hash_index.find_slot(ref self.index,
                                                       value.hash())
    if found == nil {
        return false
    }
    let removed: uint = containers.hash_index.remove_at(ref self.index,
                                                        found.get())
    __array_clear(ref self.keys, removed)
    return true
}

func clear(self: Set['T]) {
    self.keys = new[Array['T]](0)
    self.index = new[containers.hash_index.Hash_Index]()
}

func iter(self: Set['T]) -> cursor.Cursor['T] {
    var items: Array['T] = new[Array['T]](cast[int]self.index.live)
    var write: uint      = 0
    var read:  uint      = 0
    while read < self.index.used {
        if !containers.hash_index.is_dead(ref self.index, read) {
            items[write] = self.keys[read]
            write += 1
        }
        read += 1
    }
    return cursor.iter(items)
}

func is_subset(left: Set['T], right: Set['T]) -> bool where 'T : hashing . Hash {
    for value in left {
        if !contains(right, value) {
            return false
        }
    }
    return true
}

func is_superset(left: Set['T], right: Set['T])
                -> bool where 'T : hashing . Hash {
    return is_subset(right, left)
}

func is_disjoint(left: Set['T], right: Set['T])
                -> bool where 'T : hashing . Hash {
    for value in left {
        if contains(right, value) {
            return false
        }
    }
    return true
}

func __equal(self: Set['T], other: Set['T]) -> bool where 'T : hashing . Hash {
    return len(self) == len(other) and is_subset(self, other)
}

func hash(self: Set['T]) -> u128 where 'T : hashing . Hash {
    var result: u128 = len(self)
    for value in self {
        result = result ^ value.hash()
    }
    return result
}

func __add(left: Set['T], right: Set['T]) -> Set['T] where 'T : hashing . Hash {
    let result: Set['T] = new[Set['T]]()
    for value in left {
        _ = add(result, value)
    }
    for value in right {
        _ = add(result, value)
    }
    return result
}

func __subtract(left: Set['T], right: Set['T])
               -> Set['T] where 'T : hashing . Hash {
    let result: Set['T] = new[Set['T]]()
    for value in left {
        if !contains(right, value) {
            _ = add(result, value)
        }
    }
    return result
}

func __bit_and(left: Set['T], right: Set['T])
              -> Set['T] where 'T : hashing . Hash {
    let result: Set['T] = new[Set['T]]()
    for value in left {
        if contains(right, value) {
            _ = add(result, value)
        }
    }
    return result
}

func __bit_xor(left: Set['T], right: Set['T])
              -> Set['T] where 'T : hashing . Hash {
    let result: Set['T] = new[Set['T]]()
    for value in left {
        if !contains(right, value) {
            _ = add(result, value)
        }
    }
    for value in right {
        if !contains(left, value) {
            _ = add(result, value)
        }
    }
    return result
}

alias litmod s = set
set litmod set(items: Array['T]) -> Set['T] fail: string {
    return new[Set['T]](items = items)
}
