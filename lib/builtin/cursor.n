import containers.view
import containers.lease

record Cursor {
    view:  containers.view.View['T]
    index: int
}

func __init(modify self: Cursor['T], view: containers.view.View['T]) {
    self.view = view
    self.index = 0
}

func iter(self: containers.view.View['T]) -> Cursor['T] {
    return new[Cursor['T]](self)
}

func iter(self: Array['T]) -> Cursor['T] {
    let count: int                              = cast[int]__array_length(self)
    let view:  containers.view.View['T] =
        containers.view.__slice(self, 0, count)
    return new[Cursor['T]](view)
}

inline func next(modify self: Cursor['T]) -> 'T? {
    if self.index >= cast[int]containers.view.len(self.view) {
        return nil
    }
    let value: 'T = self.view[self.index]
    self.index += 1
    return value
}

func cleanup(consume self: Cursor['T]) {
}

record Lease_Cursor {
    lease: containers.lease.Lease['T]
    end:   uint
    index: uint
}

func __init(modify self: Lease_Cursor['T],
            consume lease: containers.lease.Lease['T], end: uint) {
    self.lease = lease
    self.end = end
    self.index = 0
}

inline func next(modify self: Lease_Cursor['T]) -> 'T? {
    if self.index >= self.end {
        containers.lease.release(self.lease)
        return nil
    }
    let value: 'T = self.lease.__value[self.index]
    self.index += 1
    return value
}

func cleanup(consume self: Lease_Cursor['T]) {
    containers.lease.release(self.lease)
}
