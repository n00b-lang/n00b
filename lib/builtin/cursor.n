import containers.slice
import containers.lease

record Cursor {
    slice: containers.slice.Slice['T]
    index: int
}

func __init(modify self: Cursor['T], slice: containers.slice.Slice['T]) {
    self.slice = slice
    self.index = 0
}

func __iterator(self: containers.slice.Slice['T]) -> Cursor['T] {
    return new[Cursor['T]](self)
}

func __iterator(self: Array['T]) -> Cursor['T] {
    let count:    int       = cast[int]__array_length(self)
    var snapshot: Array['T] = self
    return new[Cursor['T]](
        new[containers.slice.Slice['T]](snapshot, 0, count))
}

inline func __next(modify self: Cursor['T]) -> 'T? {
    if self.index >= cast[int]containers.slice.len(self.slice) {
        return nil
    }
    let value: 'T = self.slice[self.index]
    self.index += 1
    return value
}

func __cleanup(consume self: Cursor['T]) {
}

record Lease_Cursor {
    lease: containers.lease.Lease['T]
    end:   uint
    index: uint
}

func __init(modify self: Lease_Cursor['T],
            consume lease: containers.lease.Lease['T], end: uint) {
    self.lease = lease
    self.end = end
    self.index = 0
}

inline func __next(modify self: Lease_Cursor['T]) -> 'T? {
    if self.index >= self.end {
        containers.lease.__finalize(ref self.lease)
        return nil
    }
    let value: 'T = self.lease.__value[self.index]
    self.index += 1
    return value
}

func __cleanup(consume self: Lease_Cursor['T]) {
    containers.lease.__finalize(ref self.lease)
}
