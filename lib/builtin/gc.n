}

public type Event layout(c) {
    public seq: Atomic[u32]
    public sleepers: Atomic[u32]
}

public const packet_cap: uint = 500
public const packet_chunk: uint = 64
public const write_buffer_cap: uint = 128

public type Packet_Entry layout(c) {
    public header: Ref[Object_Header]?
    public value_address: Ref[byte]?
    public type_index: u32
    public reserved_zero: u32
    public start_index: u64
}

public type Packet layout(c) {
    public next: Ref[Packet]?
