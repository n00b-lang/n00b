    public free_blocks: Ref[Block_Metadata]?
    public nfree: uint
    public recyclable_blocks: Ref[Block_Metadata]?
    public nrecyclable: uint
    public nfull: uint
    public nowned: Atomic[uint]
    public nunswept: Atomic[uint]
