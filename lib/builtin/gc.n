public type Mutator layout(c) {
    public heap: Ref[Heap]
    public next: Ref[Mutator]?
    public prev: Ref[Mutator]?
    public thread_id: uint
    public thread_control: uint
    public thread_primary: bool
    public thread_next: Ref[Mutator]?
    public thread_prev: Ref[Mutator]?
    public small: Bump
    public overflow: Bump
