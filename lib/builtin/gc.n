    public duration_ns: u64
    public pause_ns: u64
    public pauses: u32
    public rounds: u32
    public stragglers: u32
    public marked_objects: uint
    public marked_bytes: uint
    public allocated_bytes: uint
}

public type Final_Entry layout(c) {
    public payload: Ref[byte]
}

public type Final_Batch layout(c) {
    public objects: Ref[byte]
    public n: uint
    public next: Ref[Final_Batch]?
    public prev: Ref[Final_Batch]?
}

public type Global_Root_Entry layout(c) {
    public slot: Ref[Ref[byte]?]
