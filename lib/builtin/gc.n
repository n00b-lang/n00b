import builtin.os
import builtin.abi
import builtin.gc.hash

public const granule_bytes: uint = 16
public const line_bytes: uint = 128
public const block_bytes: uint = 32768
public const word_bits: uint = 64
const lines_per_block: uint = block_bytes / line_bytes
const granules_per_block: uint = block_bytes / granule_bytes
const bitmap_words: uint = granules_per_block / 64
public const block_magic: u32 = 0x6d616e69
public const cache_max: uint = 8
public const los_classes: uint = 256
public const obj_large: u64 = 1 << 0
public const obj_final: u64 = 1 << 3
const empty_word: u64 = 0
const mark_clearing: u32 = 0x80000000
public const meta_flag_bits: u64 = 8
const meta_flag_mask: u64 = 0xff

public type Object_Header layout(c) {
    public type_index: u32
    public reserved_zero: u32
    public meta: u64
}

public func meta_make(payload_bytes: u64, flags: u32) -> u64 {
    require payload_bytes <= (~cast[u64](0) >> meta_flag_bits)
    return (payload_bytes << meta_flag_bits) | (cast[u64](flags) & meta_flag_mask)
}

public func meta_payload_bytes(meta: u64) -> u64 {
    return meta >> meta_flag_bits
}

public enum Block_State { owned, retired, free, recyclable, full }
public enum Phase { idle, marking, sweeping }
public enum Handshake_State { idle, requested, busy, claimed, done }
public enum Handshake_Kind { on, scan, sweep }

public type Block_Metadata layout(c) {
    public magic: u32
    public state: u8
    public on_owned: bool
    public free_lines: u16
    public sweep_epoch: u32
    public mark_epoch: Atomic[u32]
    public black_epoch: Atomic[u32]
    public nfinal: Atomic[u32]
    public in_final: Atomic[bool]
    public final_next: Ref[Block_Metadata]?
    public owner: Ref[Mutator]?
    public next: Ref[Block_Metadata]?
    public all_next: Ref[Block_Metadata]?
    public all_prev: Ref[Block_Metadata]?
    public own_next: Ref[Block_Metadata]?
    public line_marks: Atomic[u8][lines_per_block]
    public mark_bits: Atomic[u64][bitmap_words]
    public start_bits: Atomic[u64][bitmap_words]
}

public type Bump layout(c) {
    public cursor: Ref[byte]?
    public limit: Ref[byte]?
    public blk: Ref[Block_Metadata]?
    public line: uint
    public seen_epoch: u32
    public cache: Atomic[Ref[Block_Metadata]?]
}

public type Los_Obj layout(c) {
    public next: Ref[Los_Obj]?
    public final_next: Ref[Los_Obj]?
    public bytes: uint
    public marked: Atomic[u32]
    public mapping: Ref[byte]
    public mapped_bytes: uint
    public hdr: Object_Header
}

public func object_header_bytes() -> uint {
    let probe: Ref[Object_Header]? = nil
    let row: Ref[builtin.abi.Type_Record]? = builtin.abi.optional_reference_target(typeof(probe))
    if row != nil { return builtin.abi.size_bytes(row.get()) }
    require false
}

public func object_bytes(header: Ref[Object_Header]) -> uint {
    return object_header_bytes() + cast[uint](meta_payload_bytes(header.meta))
}

public func payload_of(header: Ref[Object_Header]) -> Ref[byte] {
    return __gc_byte_offset(unsafe_cast[Ref[byte]] header, object_header_bytes())
}

public func header_of(payload: Ref[byte]) -> Ref[Object_Header] {
    let distance: i128 = cast[i128](object_header_bytes())
    let base: Ref[byte] = __gc_byte_offset(payload, -distance)
    return unsafe_cast[Ref[Object_Header]] base
}

public func block_of_bytes(address_in_block: Ref[byte]) -> Ref[Block_Metadata] {
    let address: uint = __abi_ref_address(address_in_block)
    let distance: i128 = cast[i128](address % block_bytes)
    let base: Ref[byte] = __gc_byte_offset(address_in_block, -distance)
    return block_metadata_at(base)
}

public func block_of(header: Ref[Object_Header]) -> Ref[Block_Metadata] {
    return block_of_bytes(unsafe_cast[Ref[byte]] header)
}

public func los_header_offset() -> uint {
    let los_probe: Ref[Los_Obj]? = nil
    let los_type: Ref[builtin.abi.Type_Record]? = builtin.abi.optional_reference_target(typeof(los_probe))
    let header_probe: Ref[Object_Header]? = nil
    let header_type: Ref[builtin.abi.Type_Record]? = builtin.abi.optional_reference_target(typeof(header_probe))
    if los_type != nil {
        let los_row: Ref[builtin.abi.Type_Record] = los_type.get()
        if header_type != nil {
            let header_row: Ref[builtin.abi.Type_Record] = header_type.get()
            let fields: builtin.abi.Range = los_row.fields_or_arms
            require fields.count != 0
            let field_index: i64 = builtin.abi.range_index(fields, fields.count - 1)
            if field_index >= 0 {
                let field: Ref[builtin.abi.Field_Record]? = builtin.abi.field_at(cast[u32](field_index))
                if field != nil {
                    let field_row: Ref[builtin.abi.Field_Record] = field.get()
                    let child: Ref[builtin.abi.Type_Record]? = builtin.abi.type_at(field_row.child_type_index)
                    if child != nil {
                        require child.get().typehash == header_row.typehash
                        require field_row.logical_bit_offset % 8 == 0
                        return cast[uint](field_row.logical_bit_offset / 8)
                    }
                }
            }
        }
    }
    require false
}

public func los_of(header: Ref[Object_Header]) -> Ref[Los_Obj] {
    let distance: i128 = cast[i128](los_header_offset())
    let base: Ref[byte] = __gc_byte_offset(unsafe_cast[Ref[byte]] header, -distance)
    return unsafe_cast[Ref[Los_Obj]] base
}

