public func committed_bytes(heap: Ref[Heap]) -> uint {
    return heap.nblocks * block_bytes + heap.los_bytes + heap.los_cache_bytes
}

public func over_max(heap: Ref[Heap], request: uint) -> bool {
    if heap.cfg.max_heap_bytes == 0 { return false }
    let used: uint = committed_bytes(heap)
    return used > heap.cfg.max_heap_bytes or
        request > heap.cfg.max_heap_bytes - used
}

public func bump_room(b: Ref[Bump]) -> uint {
    let cursor: Ref[byte]? = b.cursor
    let limit: Ref[byte]? = b.limit
    if cursor != nil {
        if limit != nil {
            let distance: int = __gc_byte_diff(limit.get(), cursor.get())
            require distance >= 0
            return cast[uint](distance)
        }
        require false
    }
    return 0
}

public func cache_pop(b: Ref[Bump]) -> Ref[Block_Metadata]? {
    let empty: Ref[Block_Metadata]? = nil
    let list: Ref[Block_Metadata]? = __atomic_exchange(ref b.cache, empty)
    if list != nil {
        let block: Ref[Block_Metadata] = list.get()
        __atomic_store(ref b.cache, block.next)
    }
    return list
}

public func block_metadata_at(base: Ref[byte]) -> Ref[Block_Metadata] {
    require __abi_ref_address(base) % block_bytes == 0
    return unsafe_cast[Ref[Block_Metadata]] base
}

public func block_base(block: Ref[Block_Metadata]) -> Ref[byte] {
    require __abi_ref_address(block) % block_bytes == 0
    return unsafe_cast[Ref[byte]] block
}

public func block_object_header_at(base: Ref[byte], offset: uint) -> Ref[Object_Header] {
    require __abi_ref_address(base) % block_bytes == 0
    require offset >= header_lines() * line_bytes
    require offset % granule_bytes == 0
    require offset <= block_bytes - object_header_bytes()
    return unsafe_cast[Ref[Object_Header]] __gc_byte_offset(base, offset)
}

public func thread_index_value(mutator: Ref[Mutator]) -> Ref[byte] {
    return unsafe_cast[Ref[byte]] mutator
}

public func thread_index_mutator(value: Ref[byte], thread_id: uint) -> Ref[Mutator] {
    let mutator: Ref[Mutator] = unsafe_cast[Ref[Mutator]] value
    require mutator.thread_id == thread_id
    return mutator
}

public func read_epoch(blk: Ref[Block_Metadata]) -> u32 {
    return __volatile_load(ref blk.sweep_epoch)
}

public func capacity(blk: Ref[Block_Metadata]) -> uint {
    return cast[uint](blk.free_lines) * line_bytes
}

func pop_list(head: Ref[Ref[Block_Metadata]?], count: Ref[uint]) -> Ref[Block_Metadata]? {
    let first: Ref[Block_Metadata]? = ref_read(head)
    if first != nil {
        let blk: Ref[Block_Metadata] = first.get()
        ref_write(head, blk.next)
        let current_count: uint = ref_read(count)
        ref_write(count, current_count - 1)
    }
    return first
}

public func set_block_state(heap: Ref[Heap], blk: Ref[Block_Metadata], state: Block_State) {
    let was_owned: bool = blk.state == cast[u8](Block_State.owned)
    let now_owned: bool = state == Block_State.owned
    if was_owned != now_owned {
        if was_owned {
            __atomic_fetch_sub(ref heap.nowned, 1)
        } else {
            __atomic_fetch_add(ref heap.nowned, 1)
        }
    }
    blk.state = cast[u8](state)
}

public func push_free(heap: Ref[Heap], blk: Ref[Block_Metadata]) {
    set_block_state(heap, blk, Block_State.free)
    blk.next = heap.free_blocks
    heap.free_blocks = blk
    heap.nfree += 1
}

func take_block(heap: Ref[Heap], prefer_free: bool) -> Ref[Block_Metadata]? {
    if !prefer_free and heap.recyclable_blocks != nil {
        return pop_list(ref heap.recyclable_blocks, ref heap.nrecyclable)
    }
    if heap.free_blocks != nil {
        return pop_list(ref heap.free_blocks, ref heap.nfree)
    }
    return pop_list(ref heap.recyclable_blocks, ref heap.nrecyclable)
}

func batch_size(heap: Ref[Heap]) -> uint {
    var mutators: uint = heap.nmutators
    if mutators == 0 { mutators = 1 }
    let share: uint = (heap.nfree + heap.nrecyclable) / (2 * mutators)
    if share < 1 { return 1 }
    if share > cache_max { return cache_max }
    return share
}

public func own(heap: Ref[Heap], mutator: Ref[Mutator], blk: Ref[Block_Metadata],
         list: Ref[Ref[Block_Metadata]?]) {
    if heap.black_alloc {
        ensure_mark_epoch(block_base(blk), heap.mark_epoch)
    }
    set_block_state(heap, blk, Block_State.owned)
    blk.owner = mutator
    blk.next = ref_read(list)
    let owned: Ref[Block_Metadata]? = blk
    ref_write(list, owned)
    if !blk.on_owned {
        blk.on_owned = true
        blk.own_next = heap.owned
        heap.owned = blk
    }
    heap.alloc_since_gc += capacity(blk)
}

public func take_batch(heap: Ref[Heap], mutator: Ref[Mutator],
                prefer_free: bool) -> Ref[Block_Metadata]? {
    var list: Ref[Block_Metadata]? = nil
    let count: uint = batch_size(heap)
    var index: uint = 0
    while index < count {
        let candidate: Ref[Block_Metadata]? = take_block(heap, prefer_free)
        if candidate != nil {
            own(heap, mutator, candidate.get(), ref list)
            index += 1
        } else {
            break
        }
    }
    return list
}

public func header_lines() -> uint {
    let probe: Ref[Block_Metadata]? = nil
    let row: Ref[builtin.abi.Type_Record]? = builtin.abi.optional_reference_target(typeof(probe))
    if row != nil {
        let metadata_bytes: uint = builtin.abi.size_bytes(row.get())
        return (metadata_bytes + line_bytes - 1) / line_bytes
    }
    require false
}

public func bump_attach(mutator: Ref[Mutator], bump: Ref[Bump],
                        blk: Ref[Block_Metadata]?) {
    bump.cursor = nil
    bump.limit = nil
    bump.line = header_lines()
    var seen: u32 = 0
    if blk != nil { seen = read_epoch(blk.get()) }
    bump.seen_epoch = seen
    bump.blk = blk
    if blk != nil {
        if mutator.black {
            raise_black(blk.get(), mutator.heap.mark_epoch)
        }
    }
}

public func block_init(heap: Ref[Heap], blk: Ref[Block_Metadata]) {
    let base: Ref[byte] = block_base(blk)
    let first_payload: uint = header_lines() * line_bytes
    blk.magic = block_magic
    blk.free_lines = cast[u16]((block_bytes - first_payload)
        / line_bytes)
    blk.sweep_epoch = heap.epoch
    blk.state = cast[u8](Block_State.retired)
    __atomic_store(ref blk.mark_epoch, heap.mark_epoch)
    __atomic_store(ref blk.black_epoch, 0)
    __atomic_store(ref blk.nfinal, 0)
    __atomic_store(ref blk.in_final, false)
    let invalid_mark: u8 = cast[u8]((cast[uint] heap.epoch + 128) % 256)
    __gc_memset(ref blk.line_marks [0], cast[byte](invalid_mark),
                lines_per_block)
    if heap.cfg.poison_free {
        let payload: Ref[byte] = __gc_byte_offset(base, first_payload)
        __gc_memset(payload, cast[byte](0xdb), block_bytes - first_payload)
    }
    blk.all_prev = nil
    blk.all_next = heap.all_blocks
    let previous: Ref[Block_Metadata]? = heap.all_blocks
    if previous != nil { previous.get().all_prev = blk }
    heap.all_blocks = blk
    heap.nblocks += 1
}

public func block_mark_word(block: Ref[Block_Metadata], index: uint) -> Ref[Atomic[u64]] {
    require index < bitmap_words
    return ref block.mark_bits [index]
}

public func block_start_word(block: Ref[Block_Metadata], index: uint) -> Ref[Atomic[u64]] {
    require index < bitmap_words
    return ref block.start_bits [index]
}

public func mark_word_at(base: Ref[byte], index: uint) -> Ref[Atomic[u64]] {
    return block_mark_word(block_metadata_at(base), index)
}

public func start_word_at(base: Ref[byte], index: uint) -> Ref[Atomic[u64]] {
    return block_start_word(block_metadata_at(base), index)
}

func bitmap_contains(word: Ref[Atomic[u64]], bit: uint) -> bool {
    let mask: u64 = cast[u64](1) << bit
    let bits: u64 = __atomic_load(word)
    return (bits & mask) != empty_word
}

public func object_started(base: Ref[byte], offset: uint) -> bool {
    require offset % granule_bytes == 0
    let granule: uint = offset / granule_bytes
    return bitmap_contains(start_word_at(base, granule / 64), granule % 64)
}

public func clear_mark_word(base: Ref[byte], index: uint) {
    __atomic_store(mark_word_at(base, index), empty_word)
}

public func ensure_mark_epoch(base: Ref[byte], epoch: u32) {
    require (epoch & mark_clearing) == 0
    let metadata: Ref[Block_Metadata] = block_metadata_at(base)
    let word: Ref[Atomic[u32]] = ref metadata.mark_epoch
    var seen: u32 = __atomic_load(word)
    while seen != epoch {
        if (seen & mark_clearing) == 0 {
            if __atomic_compare_exchange(word, seen,
                                         epoch | mark_clearing) {
                let words: uint = (block_bytes / granule_bytes) / 64
                var index: uint = 0
                while index < words {
                    clear_mark_word(base, index)
                    index += 1
                }
                __atomic_store(word, epoch)
                return
            }
        }
        seen = __atomic_load(word)
    }
}

public func raise_black(metadata: Ref[Block_Metadata], epoch: u32) {
    let word: Ref[Atomic[u32]] = ref metadata.black_epoch
    var current: u32 = __atomic_load(word)
    while current < epoch {
        if __atomic_compare_exchange(word, current, epoch) { return }
        current = __atomic_load(word)
    }
}

func line_mark_at(base: Ref[byte], line: uint) -> Ref[Atomic[u8]] {
    require line < block_bytes / line_bytes
    let metadata: Ref[Block_Metadata] = block_metadata_at(base)
    return ref metadata.line_marks [line]
}

public func line_marked_in(base: Ref[byte], line: uint, epoch: u32) -> bool {
    let mark: u8 = __atomic_load(line_mark_at(base, line))
    return mark == cast[u8](cast[uint](epoch) % 256)
}

public func mark_lines(base: Ref[byte], offset: uint, bytes: uint,
                       epoch: u32) {
    let first: uint = offset / line_bytes
    var last: uint = first
    if bytes > line_bytes {
        last = (offset + bytes - 1) / line_bytes
    }
    var line: uint = first
    while line <= last {
        __atomic_store(line_mark_at(base, line), cast[u8](epoch))
        line += 1
    }
}

func line_live(base: Ref[byte], line: uint) -> bool {
    let metadata: Ref[Block_Metadata] = block_metadata_at(base)
    let mark: u8 = __atomic_load(line_mark_at(base, line))
    let sweep: u8 = cast[u8](metadata.sweep_epoch)
    return mark == sweep or mark == cast[u8](
        (cast[uint](sweep) + 1) % 256)
}

func line_used(base: Ref[byte], line: uint) -> bool {
    if line_live(base, line) { return true }
    if line > header_lines() {
        return line_live(base, line - 1)
    }
    return false
}

func scan_for_hole(bump: Ref[Bump], blk: Ref[Block_Metadata],
                   bytes: uint) -> bool {
    let base: Ref[byte] = block_base(blk)
    let lines: uint = block_bytes / line_bytes
    var line: uint = bump.line
    while line < lines {
        while line < lines and line_used(base, line) {
            line += 1
        }
        if line == lines { break }
        var end: uint = line
        while end < lines and !line_used(base, end) {
            end += 1
        }
        if (end - line) * line_bytes >= bytes {
            let limit: Ref[byte] = __gc_byte_offset(base, end * line_bytes)
            bump.limit = limit
            __gc_signal_fence()
            let cursor: Ref[byte] = __gc_byte_offset(base, line * line_bytes)
            bump.cursor = cursor
            bump.line = end
            __gc_signal_fence()
            let clear: byte = 0
            let distance: int = __gc_byte_diff(limit, cursor)
            require distance >= 0
            __gc_memset(cursor, clear, cast[uint](distance))
            return true
        }
        line = end
    }
    bump.line = lines
    return false
}

public func bump_next_hole(bump: Ref[Bump], bytes: uint) -> bool {
    let candidate: Ref[Block_Metadata]? = bump.blk
    if candidate != nil {
        let blk: Ref[Block_Metadata] = candidate.get()
        while true {
            let epoch: u32 = read_epoch(blk)
            if epoch != bump.seen_epoch {
                bump.seen_epoch = epoch
                bump.line = header_lines()
            }
            let found: bool = scan_for_hole(bump, blk, bytes)
            __gc_signal_fence()
            if read_epoch(blk) == epoch { return found }
        }
    }
    return false
}
