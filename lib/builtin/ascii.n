import string.core

func is_ascii_digit(c: char) -> bool {
    let v: u32 = cast[u32] c
    return v >= 0x30 and v <= 0x39
}

func is_ascii_letter(c: char) -> bool {
    let v: u32 = cast[u32] c
    return (v >= 0x61 and v <= 0x7a) or (v >= 0x41 and v <= 0x5a)
}

func hex_digit_value(c: char) -> u32? {
    let v: u32 = cast[u32] c
    if v >= 0x30 and v <= 0x39 {
        return v - 0x30
    }
    if v >= 0x61 and v <= 0x66 {
        return v - 0x61 + 10
    }
    if v >= 0x41 and v <= 0x46 {
        return v - 0x41 + 10
    }
    return nil
}

func decimal_value(s: string) -> u64? {
    let n: uint = string.core.byte_len(s)
    if n == 0 {
        return nil
    }
    var value: u64 = 0
    for i: uint from 0 until n {
        let b: u8 = string.core.byte_at(s, i)
        if b < 0x30 or b > 0x39 {
            return nil
        }
        let digit: u64 = cast[u64](b - 0x30)
        if value > (0xffffffffffffffff - digit) / 10 {
            return nil
        }
        value = value * 10 + digit
    }
    return value
}
