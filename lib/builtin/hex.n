func hex_map_lower() -> Array[u8] {
    let table: Array[u8] = [
    0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37,
    0x38, 0x39, 0x61, 0x62, 0x63, 0x64, 0x65, 0x66,
]'array
    return table
}

func hex_map_upper() -> Array[u8] {
    let table: Array[u8] = [
    0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37,
    0x38, 0x39, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46,
]'array
    return table
}
