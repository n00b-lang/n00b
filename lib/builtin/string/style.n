func intrinsic_tag_style(tag: string) -> Text_Style {
    var i: uint = 0
    while i < __array_length(intrinsic_tags) {
        if cmp_text(tag, intrinsic_tags[i].name) == 0 {
            return intrinsic_tags[i].style
        }
        i += 1
    }
    return empty_style
}

private enum Markup_Kind {
    prop_on = 0, prop_off, case_on, case_off, style_on, style_off, reset,
    subst
}

private record Markup_Segment {
    kind:        Markup_Kind
    at:          u32
    name:        string
    prop:        Text_Style
    sub_index:   u64?
    raw_tag:     string
    format_spec: string?
}

private record Pending_Style {
    kind:       Markup_Kind
    name:       string
    prop:       Text_Style
    raw_tag:    string
    start_byte: u32
}

private func segment(kind: Markup_Kind, at: u32, raw_tag: string,
                     name: string = "", prop: Text_Style = empty_style,
                     sub_index: u64? = nil, format_spec: string? = nil)
    -> Markup_Segment {
    return (kind = kind, at = at, name = name, prop = prop,
            sub_index = sub_index, raw_tag = raw_tag,
            format_spec = format_spec)
}

// Adds an on (`[name]`) or off (`[/name]`) segment for a style tag whose
// name has already been checked to be an identifier.
private func add_style_tag(modify segments: List[Markup_Segment],
                           name: string, closing: bool, at: u32) {
    var raw_tag: string = name
    if closing {
        raw_tag = "/" + name
    }
    let prop: Text_Style = intrinsic_tag_style(name)
    if prop.text_case != Text_Case.none {
        var kind: Markup_Kind = Markup_Kind.case_on
        if closing {
            kind = Markup_Kind.case_off
        }
        segments.append(segment(kind, at, raw_tag, prop = prop))
        return
    }
    if !is_empty(prop) {
        var kind: Markup_Kind = Markup_Kind.prop_on
        if closing {
            kind = Markup_Kind.prop_off
        }
        segments.append(segment(kind, at, raw_tag, prop = prop))
        return
    }
    var kind: Markup_Kind = Markup_Kind.style_on
    if closing {
        kind = Markup_Kind.style_off
    }
    segments.append(segment(kind, at, raw_tag, name = name))
}

private func escape_length(raw: string, at: uint) -> uint {
    let n: uint = string.core.byte_len(raw)
    if at + 1 >= n {
        return n - at
    }
    var digits: uint
    switch string.core.byte_at(raw, at + 1) {
        case 0x78 {
            digits = 2
        }
        case 0x75 {
            digits = 4
        }
        case 0x55 {
            digits = 8
        }
        else {
            digits = 0
        }
    }
    var len: uint = 2 + digits
    if at + len > n {
        len = n - at
    }
    return len
}

// Decodes the escape sequence at `at` into `out`, returning its raw length.
// `\[` and `\]` decode to the bracket itself, like every other escape.
private func put_escape(out: containers.buffer.Buffer, raw: string, at: uint)
    -> uint fail: string {
    let len: uint = escape_length(raw, at)
    containers.buffer.put_string(out, string.core.decode_escapes(
        string.core.byte_slice(raw, cast[int] at, cast[int] (at + len)))!)
    return len
}

private func is_digit_byte(b: u8) -> bool {
    return b >= 0x30 and b <= 0x39
}

// The byte length of the identifier character at `at`, or 0 when there is
// none. Tag and slot names follow n00b's identifier rule exactly:
// `(_|XID_Start)(_|XID_Continue)*`.
private func id_char_len(raw: string, at: uint, first: bool) -> uint {
    let b: u8 = string.core.byte_at(raw, at)
    if b < 0x80 {
        let ok: bool = b == 0x5f or (b >= 0x41 and b <= 0x5a) or
            (b >= 0x61 and b <= 0x7a) or (!first and is_digit_byte(b))
        if ok {
            return 1
        }
        return 0
    }
    let step: string.core.Utf8_Step =
        string.core.utf8_decode_step(raw, cast[u32] at)
    if step.adv <= 0 {
        return 0
    }
    let cp: u32 = cast[u32] step.cp
    var ok: bool = string.xid.is_xid_continue(cp)
    if first {
        ok = string.xid.is_xid_start(cp)
    }
    if ok {
        return cast[uint] step.adv
    }
    return 0
}

// Returns the index just past the identifier starting at `at`, or `at`
// itself when no identifier starts there.
private func scan_id(raw: string, at: uint) -> uint {
    let n: uint = string.core.byte_len(raw)
    if at >= n {
        return at
    }
    var j: uint = at + id_char_len(raw, at, true)
    if j == at {
        return at
    }
    while j < n {
        let step: uint = id_char_len(raw, j, false)
        if step == 0 {
            break
        }
        j += step
    }
    return j
}

// Reads a substitution's format spec starting at `k` (just past its `:`),
// decoding escapes, up to the first unescaped `]`. On success `k` is left on
// that `]`; nil means the spec is unterminated.
private func scan_spec(raw: string, modify k: uint) -> string? fail: string {
    let n: uint = string.core.byte_len(raw)
    var spec: containers.buffer.Buffer = new[containers.buffer.Buffer](length = 0)
    while k < n {
        let c: u8 = string.core.byte_at(raw, k)
        if c == 0x5d {
            return containers.buffer.to_string(spec)
        }
        if c == 0x5c {
            k += put_escape(spec, raw, k)!
            continue
        }
        containers.buffer.put_u8(spec, c)
        k += 1
    }
    return nil
}

// Tries to read a markup tag at the `[` at index `at`. On success the tag's
// segment is appended and the index just past its closing `]` is returned;
// when the text is not a tag, nothing is appended and 0 is returned, so the
// `[` is literal text. The tag forms are:
//   [ID]  [/ID]  [/]  [#]  [#N]  [#ID]
// where each `#` form may carry `:spec`, which runs to the first unescaped
// `]` and has its escapes decoded.
private func scan_tag(modify segments: List[Markup_Segment],
                      raw: string,
                      at: uint, text_at: u32) -> uint fail: string {
    let n: uint = string.core.byte_len(raw)
    let j: uint = at + 1
    if j >= n {
        return 0
    }
    let first: u8 = string.core.byte_at(raw, j)
    if first == 0x2f {
        if j + 1 < n and string.core.byte_at(raw, j + 1) == 0x5d {
            segments.append(segment(Markup_Kind.reset, text_at, "/"))
            return j + 2
        }
        let e: uint = scan_id(raw, j + 1)
        if e == j + 1 or e >= n or string.core.byte_at(raw, e) != 0x5d {
            return 0
        }
        add_style_tag(segments,
            string.core.byte_slice(raw, cast[int](j) + 1, cast[int] e),
            true, text_at)
        return e + 1
    }
    if first != 0x23 {
        let e: uint = scan_id(raw, j)
        if e == j or e >= n or string.core.byte_at(raw, e) != 0x5d {
            return 0
        }
        add_style_tag(segments,
            string.core.byte_slice(raw, cast[int] j, cast[int] e), false,
            text_at)
        return e + 1
    }
    let name_at: uint = j + 1
    var k: uint = name_at
    var explicit: bool = false
    if k < n and is_digit_byte(string.core.byte_at(raw, k)) {
        explicit = true
        while k < n and is_digit_byte(string.core.byte_at(raw, k)) {
            k += 1
        }
    }
    else {
        k = scan_id(raw, k)
    }
    let name_end: uint = k
    if k >= n {
        return 0
    }
    var format_spec: string? = nil
    let after: u8 = string.core.byte_at(raw, k)
    if after == 0x3a {
        k += 1
        format_spec = scan_spec(raw, k)!
        if format_spec == nil {
            return 0
        }
    }
    elif after != 0x5d {
        return 0
    }
    let raw_tag: string = string.core.byte_slice(raw, cast[int] j,
                                                 cast[int] k)
    if name_end == name_at {
        // An auto slot is not numbered here: `format()` numbers auto slots
        // in order of appearance in the final string, so numbering keeps
        // working after concatenation. It may sit alongside explicit ones.
        segments.append(segment(Markup_Kind.subst, text_at, raw_tag,
                                format_spec = format_spec))
        return k + 1
    }
    if explicit {
        var ix: u64 = 0
        var d: uint = name_at
        while d < name_end {
            ix = ix * 10 + cast[u64] (string.core.byte_at(raw, d) - 0x30)
            if ix > 0xffffffff {
                fail "rich string substitution index is too large"
            }
            d += 1
        }
        segments.append(segment(Markup_Kind.subst, text_at, raw_tag,
                                sub_index = ix, format_spec = format_spec))
        return k + 1
    }
    segments.append(segment(Markup_Kind.subst, text_at, raw_tag,
        name = string.core.byte_slice(raw, cast[int] name_at,
                                      cast[int] name_end),
        format_spec = format_spec))
    return k + 1
}

// Splits a rich literal's raw (still escaped) body into its text and markup
// segments. A `[` that does not begin a well-formed tag is literal text, and
// `\[` / `\]` always produce literal brackets.
private func parse_rich_markup(raw: string,
                               modify segments: List[Markup_Segment])
    -> string fail: string {
    var text: containers.buffer.Buffer = new[containers.buffer.Buffer](length = 0)
    let n: uint = string.core.byte_len(raw)
    var i: uint = 0
    while i < n {
        let c: u8 = string.core.byte_at(raw, i)
        if c == 0x5c {
            i += put_escape(text, raw, i)!
            continue
        }
        if c == 0x5b {
            let end: uint = scan_tag(segments, raw, i,
                cast[u32] string.core.byte_len(text))!
            if end != 0 {
                i = end
                continue
            }
        }
        containers.buffer.put_u8(text, c)
        i += 1
    }
    return containers.buffer.to_string(text)
}

private func span_record(pending: Pending_Style, end: u32?) -> Style_Record {
    return (start_ix = pending.start_byte, end_ix = end,
            style_tag = pending.raw_tag, format_spec = nil,
            substitution = (none = nil))
}

private func without(pending: List[Pending_Style], index: int)
    -> List[Pending_Style] {
    var kept: List[Pending_Style] = new[List[Pending_Style]]()
    var k: int = 0
    while k < cast[int] pending.len() {
        if k != index {
            kept.append(pending[k])
        }
        k += 1
    }
    return kept
}

private func closes_pending(open: Pending_Style, close: Markup_Segment)
    -> bool {
    switch close.kind {
        case Markup_Kind.prop_off {
            return open.kind == Markup_Kind.prop_on and open.prop == close.prop
        }
        case Markup_Kind.case_off {
            return open.kind == Markup_Kind.case_on
        }
        case Markup_Kind.style_off {
            return open.kind == Markup_Kind.style_on and
                cmp_text(open.name, close.name) == 0
        }
        else {
            return false
        }
    }
}

private func build_style_records(segments: List[Markup_Segment])
    -> List[Style_Record] {
    var records: List[Style_Record] = new[List[Style_Record]]()
    var pending: List[Pending_Style] = new[List[Pending_Style]]()
    var s: int = 0
    while s < cast[int] segments.len() {
        let seg: Markup_Segment = segments[s]
        s += 1
        switch seg.kind {
            case Markup_Kind.prop_on, Markup_Kind.case_on, Markup_Kind.style_on {
                let opened: Pending_Style = (kind = seg.kind, name = seg.name,
                                             prop = seg.prop,
                                             raw_tag = seg.raw_tag,
                                             start_byte = seg.at)
                pending.append(opened)
            }
            case Markup_Kind.prop_off, Markup_Kind.case_off, Markup_Kind.style_off {
                var j: int = cast[int](pending.len()) - 1
                while j >= 0 {
                    if closes_pending(pending[j], seg) {
                        records.append(span_record(pending[j], seg.at))
                        pending = without(pending, j)
                        break
                    }
                    j -= 1
                }
            }
            case Markup_Kind.reset {
                var j: int = 0
                while j < cast[int] pending.len() {
                    records.append(span_record(pending[j], seg.at))
                    j += 1
                }
                containers.list.clear(pending)
            }
            case Markup_Kind.subst {
                var substitution: Sub_Spec = (argname = seg.name)
                if seg.sub_index != nil {
                    substitution = (position = seg.sub_index)
                }
                elif string.core.byte_len(seg.name) == 0 {
                    substitution = (auto = nil)
                }
                let slot: Style_Record = (start_ix = seg.at, end_ix = nil,
                                          style_tag = nil,
                                          format_spec = seg.format_spec,
                                          substitution = substitution)
                records.append(slot)
            }
        }
    }
    var j: int = 0
    while j < cast[int] pending.len() {
        records.append(span_record(pending[j], index_extends))
        j += 1
    }
    return records
}

alias litmod r = rich
quotes litmod rich(raw: string) -> string fail: string {
    var segments: List[Markup_Segment] = new[List[Markup_Segment]]()
    let text: string = parse_rich_markup(raw, segments)!
    var body: Rich_Body = (s = text, style_info = build_style_records(segments),
                           base_style = nil, opaque = false)
    return string.core.__string_make_rich(ref body)
}
