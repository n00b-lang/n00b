import string.core
import string.xid
import containers.list
import containers.buffer
import io.format
import hashing

const index_extends: u32 = 0xffffffff

private const sub_arm_none: u64 = 0
private const sub_arm_position: u64 = 1
private const sub_arm_argname: u64 = 2
private const sub_arm_auto: u64 = 3

enum Text_Case {
    none = 0, upper, lower, title, caps
}

enum Font_Hint {
    default = 0, mono, serif, sans
}

alias type Color = i32

record Text_Style {
    bold:             bool?
    italic:           bool?
    underline:        bool?
    double_underline: bool?
    strikethrough:    bool?
    reverse:          bool?
    dim:              bool?
    blink:            bool?
    text_case:        Text_Case
    font_hint:        Font_Hint
    font_index:       i8?
    fg_palette_ix:    i8?
    bg_palette_ix:    i8?
    fg_rgb:           Color?
    bg_rgb:           Color?
    font_size:        i16?
}

// What a substitution slot names: an explicit position (`[#N]`), a keyword
// argument (`[#name]`), or the next argument in order (`[#]`), which
// `format()` numbers by order of appearance in the final string. `none`
// marks a record that is a style span, not a slot.
variant Sub_Spec {
    argname:  string
    position: u64
    none:     nil
    auto:     nil
}

// One markup event list entry. A style span has `style_tag` and both
// offsets (`end_ix == index_extends` when it was never closed: it flows
// right onto whatever is concatenated after it). A substitution slot has
// a `substitution` other than `none` and no `end_ix`. A reset (`[/]`) has
// `style_tag == "/"` and no `end_ix`.
//
// Several zero-width events can share an offset: a span closing, a slot,
// a reset, a span opening. `start_order` (for a span, its open) and
// `end_order` (its close) give each event's place among all the events at
// its offset, numbered from 0, so `[b]a[/b][#]` (close, then slot) and
// `[b]a[#][/b]` (slot, then close) stay different. The list is kept
// canonical by settle_records: orders are dense per offset, and records
// are sorted by where their first event falls.
record Style_Record {
    start_ix:     u32?
    end_ix:       u32?
    style_tag:    string?
    format_spec:  string?
    substitution: Sub_Spec
    start_order:  u32
    end_order:    u32
}

record Rich_Body layout(ordered) {
    s:          string
    style_info: List[Style_Record]
}

private record Intrinsic_Tag {
    name:  string
    style: Text_Style
}

private const default_string_format: io.format.String_Repr = (
    common = io.format.default_repr_options, hex = false)

private const empty_style: Text_Style = (
    bold = nil, italic = nil, underline = nil, double_underline = nil,
    strikethrough = nil, reverse = nil, dim = nil, blink = nil,
    text_case = Text_Case.none, font_hint = Font_Hint.default,
    font_index = nil, fg_palette_ix = nil, bg_palette_ix = nil,
    fg_rgb = nil, bg_rgb = nil, font_size = nil)

private func tri_rank(v: bool?) -> u64 {
    if v == nil {
        return 0
    }
    if v {
        return 2
    }
    return 1
}

private func sub_arm(sub: Sub_Spec) -> u64 {
    switch sub {
        case argname {
            return sub_arm_argname
        }
        case position {
            return sub_arm_position
        }
        case none {
            return sub_arm_none
        }
        case auto {
            return sub_arm_auto
        }
    }
    return sub_arm_none
}

private func cmp_bytes(left: string, right: string) -> int {
    let left_len: uint = string.core.byte_len(left)
    let right_len: uint = string.core.byte_len(right)
    var cmp_len: uint = left_len
    if right_len < cmp_len {
        cmp_len = right_len
    }
    var i: uint = 0
    while i < cmp_len {
        let a: u8 = string.core.byte_at(left, i)
        let b: u8 = string.core.byte_at(right, i)
        if a != b {
            if a < b {
                return -1
            }
            return 1
        }
        i += 1
    }
    if left_len > right_len {
        return 1
    }
    if left_len < right_len {
        return -1
    }
    return 0
}

private func cmp_text(left: string, right: string) -> int {
    return cmp_bytes(left, right)
}

private func cmp_words(left: u64, right: u64) -> int {
    if left > right {
        return 1
    }
    if left < right {
        return -1
    }
    return 0
}

private func cmp_opt_u32(left: u32?, right: u32?) -> int {
    let left_set: bool = left != nil
    let right_set: bool = right != nil
    if left_set != right_set {
        if left_set {
            return 1
        }
        return -1
    }
    if left == nil or right == nil {
        return 0
    }
    return cmp_words(cast[u64] left, cast[u64] right)
}

private func cmp_opt_string(left: string?, right: string?) -> int {
    let left_set: bool = left != nil
    let right_set: bool = right != nil
    if left_set != right_set {
        if left_set {
            return 1
        }
        return -1
    }
    if left == nil or right == nil {
        return 0
    }
    return cmp_text(left, right)
}

private func cmp_sub_spec(left: Sub_Spec, right: Sub_Spec) -> int {
    let left_arm: u64 = sub_arm(left)
    let right_arm: u64 = sub_arm(right)
    if left_arm != right_arm {
        return cmp_words(left_arm, right_arm)
    }
    switch left {
        case position {
            let a: u64 = left.position
            switch right {
                case position {
                    return cmp_words(a, right.position)
                }
                else {
                    return 0
                }
            }
        }
        case argname {
            let a: string = left.argname
            switch right {
                case argname {
                    return cmp_text(a, right.argname)
                }
                else {
                    return 0
                }
            }
        }
        case none {
            return 0
        }
        case auto {
            return 0
        }
    }
}

private func cmp_style_record(left: Style_Record, right: Style_Record) -> int {
    result = cmp_opt_u32(left.start_ix, right.start_ix)
    if result != 0 {
        return result
    }
    result = cmp_opt_u32(left.end_ix, right.end_ix)
    if result != 0 {
        return result
    }
    result = cmp_opt_string(left.style_tag, right.style_tag)
    if result != 0 {
        return result
    }
    result = cmp_opt_string(left.format_spec, right.format_spec)
    if result != 0 {
        return result
    }
    result = cmp_words(cast[u64] left.start_order, cast[u64] right.start_order)
    if result != 0 {
        return result
    }
    result = cmp_words(cast[u64] left.end_order, cast[u64] right.end_order)
    if result != 0 {
        return result
    }
    return cmp_sub_spec(left.substitution, right.substitution)
}

private func is_rich(s: string) -> bool {
    return cast[u64](string.core.tag(s)) == string.core.str_tag_rich
}

private func rich_body(s: string) -> Ref[Rich_Body] {
    return string.core.__string_rich_body(s)
}

private func cmp_rich_bodies(left: Ref[Rich_Body], right: Ref[Rich_Body])
    -> int {
    let left_rich: bool = is_rich(left.__value.s)
    let right_rich: bool = is_rich(right.__value.s)
    if left_rich != right_rich {
        if left_rich {
            return 1
        }
        return -1
    }
    if left_rich {
        result = cmp_rich_bodies(rich_body(left.__value.s), rich_body(right.__value.s))
    }
    else {
        result = cmp_text(left.__value.s, right.__value.s)
    }
    if result != 0 {
        return result
    }
    let count: int = cast[int] left.__value.style_info.len()
    result = cmp_words(left.__value.style_info.len(), right.__value.style_info.len())
    if result != 0 {
        return result
    }
    var i: int = 0
    while i < count {
        result = cmp_style_record(left.__value.style_info[i], right.__value.style_info[i])
        if result != 0 {
            return result
        }
        i += 1
    }
    return 0
}

// A style span: a tag and both ends (an end of `index_extends` when it
// flows right).
func record_is_span(r: Style_Record) -> bool {
    return r.start_ix != nil and r.end_ix != nil and r.style_tag != nil
}

private func record_is_reset(r: Style_Record) -> bool {
    return r.end_ix == nil and r.style_tag != nil and
        string.core.byte_len(r.style_tag) == 1 and
        string.core.byte_at(r.style_tag, 0) == 0x2f
}

private func record_is_slot(r: Style_Record) -> bool {
    return sub_arm(r.substitution) != sub_arm_none
}

// One zero-width markup event: a record's start (a span's open, a slot, a
// reset) or a span's close.
private record Markup_Event {
    offset:  u32
    order:   u32
    rec:     int
    closing: bool
}

private func event_before(a: Markup_Event, b: Markup_Event) -> bool {
    if a.offset != b.offset {
        return a.offset < b.offset
    }
    if a.order != b.order {
        return a.order < b.order
    }
    if a.rec != b.rec {
        return a.rec < b.rec
    }
    return !a.closing and b.closing
}

private func record_events(records: List[Style_Record]) -> List[Markup_Event] {
    var events: List[Markup_Event] = new[List[Markup_Event]]()
    var i: int = 0
    while i < cast[int] records.len() {
        let r: Style_Record = records[i]
        if r.start_ix != nil {
            let open: Markup_Event = (offset = r.start_ix, order = r.start_order,
                                      rec = i, closing = false)
            events.append(open)
            let end: u32 = r.end_ix.get_or_else(index_extends)
            if record_is_span(r) and end != index_extends {
                let close: Markup_Event = (offset = end,
                                           order = r.end_order, rec = i,
                                           closing = true)
                events.append(close)
            }
        }
        i += 1
    }
    var k: int = 1
    while k < cast[int] events.len() {
        let key: Markup_Event = events[k]
        var j: int = k - 1
        while j >= 0 and event_before(key, events[j]) {
            events[j + 1] = events[j]
            j -= 1
        }
        events[j + 1] = key
        k += 1
    }
    return events
}

private func record_before(a: Style_Record, b: Style_Record) -> bool {
    if (a.start_ix == nil) != (b.start_ix == nil) {
        return a.start_ix == nil
    }
    if a.start_ix == nil or b.start_ix == nil {
        return false
    }
    let sa: u32 = a.start_ix
    let sb: u32 = b.start_ix
    if sa != sb {
        return sa < sb
    }
    return a.start_order < b.start_order
}

// Puts a markup record list in canonical form: the events at each offset
// keep their relative order but are numbered 0, 1, 2, ..., and the records
// are sorted by offset and order of their first event. Equal markup then
// has equal records, whatever built it.
func settle_records(records: List[Style_Record]) -> List[Style_Record] {
    var out: List[Style_Record] = new[List[Style_Record]]()
    var i: int = 0
    while i < cast[int] records.len() {
        var r: Style_Record = records[i]
        // Only a closed span has a close event to order.
        if !record_is_span(r) or
            r.end_ix.get_or_else(0) == index_extends {
            r.end_order = 0
        }
        out.append(r)
        i += 1
    }
    let events: List[Markup_Event] = record_events(out)
    var at: u32 = 0
    var next: u32 = 0
    var e: int = 0
    while e < cast[int] events.len() {
        let ev: Markup_Event = events[e]
        if e == 0 or ev.offset != at {
            at = ev.offset
            next = 0
        }
        var r: Style_Record = out[ev.rec]
        if ev.closing {
            r.end_order = next
        }
        else {
            r.start_order = next
        }
        out[ev.rec] = r
        next += 1
        e += 1
    }
    var k: int = 1
    while k < cast[int] out.len() {
        let key: Style_Record = out[k]
        var j: int = k - 1
        while j >= 0 and record_before(key, out[j]) {
            out[j + 1] = out[j]
            j -= 1
        }
        out[j + 1] = key
        k += 1
    }
    return out
}

// Orders used while joining two record lists, before settle_records
// renumbers them: the left side's orders are dense from 0, so anything
// from the right side at the join offset is placed after them all.
private const right_first_order: u32 = 0x40000000

private func shifted(at: u32?, by: u64) -> u32? {
    if at == nil {
        return nil
    }
    let v: u32 = at
    if v == index_extends {
        return v
    }
    let moved: u64 = cast[u64](v) + by
    return cast[u32] moved
}

// A right-side event order: at the join offset, placed after every left
// event there. An event of the left side given the same order still sorts
// first, since the left side's records come first (event_before).
private func right_order(order: u32, at_join: bool) -> u32 {
    if at_join {
        return order + right_first_order
    }
    return order
}

// The right side's first reset, which ends every span flowing in from the
// left, in every layer: its offset in the right side, its order there,
// and the layer (0 = outermost) it is in.
private record Reset_Point {
    found: bool
    at:    u32
    order: u32
    layer: int
}

private func first_reset(s: string) -> Reset_Point {
    var point: Reset_Point = (found = false, at = 0, order = 0, layer = 0)
    var cur: string = s
    var layer: int = 0
    while is_rich(cur) {
        let body: Ref[Rich_Body] = rich_body(cur)
        var i: int = 0
        // Records are in event order, so a layer's first reset is its
        // earliest.
        while i < cast[int] body.__value.style_info.len() {
            let r: Style_Record = body.__value.style_info[i]
            i += 1
            if !record_is_reset(r) {
                continue
            }
            let at: u32 = r.start_ix.get_or_else(0)
            if !point.found or at < point.at {
                point = (found = true, at = at, order = r.start_order,
                         layer = layer)
            }
            break
        }
        cur = body.__value.s
        layer += 1
    }
    return point
}

// Joins two strings, at least one of them rich, keeping every layer's
// style spans and substitution slots. The right side's records move by the
// left side's byte length, and its events at the join come after the left
// side's. A left span that was never closed flows right over the right
// side, until the right side's first reset (`[/]`, which may sit at its
// very start, in any layer) ends it: a reset clears all styling before it,
// in every layer. Layers pair up from the outside in.
func concat_rich(left: string, right: string) -> string {
    return concat_layers(left, right, first_reset(right), 0)
}

private func concat_layers(left: string, right: string, reset: Reset_Point,
                           layer: int) -> string {
    let left_rich: bool = is_rich(left)
    let right_rich: bool = is_rich(right)
    if !left_rich and !right_rich {
        return left + right
    }
    let left_len: u64 = cast[u64] string.core.byte_len(left)
    var inner_left: string = left
    var inner_right: string = right
    var body: Rich_Body = (s = "", style_info = new[List[Style_Record]]())
    var right_records: List[Style_Record] = new[List[Style_Record]]()
    var reset_at: u32? = nil
    var reset_order: u32 = 0
    if reset.found {
        reset_at = cast[u32](cast[u64](reset.at) + left_len)
        // Left spans close with the reset's order in its own layer, so
        // just before it, and in the others with the first right order
        // there, so after the left side's events at that offset and before
        // the right side's.
        var order: u32 = 0
        if layer == reset.layer and right_rich {
            order = reset.order
        }
        reset_order = right_order(order, reset.at == 0)
    }
    if right_rich {
        let rb: Ref[Rich_Body] = rich_body(right)
        inner_right = rb.__value.s
        var i: int = 0
        while i < cast[int] rb.__value.style_info.len() {
            var rec: Style_Record = rb.__value.style_info[i]
            rec.start_order = right_order(rec.start_order,
                                          rec.start_ix.get_or_else(1) == 0)
            rec.end_order = right_order(rec.end_order,
                                        rec.end_ix.get_or_else(1) == 0)
            rec.start_ix = shifted(rec.start_ix, left_len)
            rec.end_ix = shifted(rec.end_ix, left_len)
            right_records.append(rec)
            i += 1
        }
    }
    if left_rich {
        let lb: Ref[Rich_Body] = rich_body(left)
        inner_left = lb.__value.s
        var i: int = 0
        while i < cast[int] lb.__value.style_info.len() {
            var rec: Style_Record = lb.__value.style_info[i]
            if reset_at != nil and record_is_span(rec) and
                rec.end_ix.get_or_else(0) == index_extends {
                rec.end_ix = reset_at
                rec.end_order = reset_order
            }
            body.style_info.append(rec)
            i += 1
        }
    }
    var r: int = 0
    while r < cast[int] right_records.len() {
        body.style_info.append(right_records[r])
        r += 1
    }
    body.style_info = settle_records(body.style_info)
    body.s = concat_layers(inner_left, inner_right, reset, layer + 1)
    return string.core.__string_make_rich(ref body)
}

func cmp_string_value(left: string, right: string) -> int {
    let left_rich: bool = is_rich(left)
    let right_rich: bool = is_rich(right)
    if left_rich != right_rich {
        if left_rich {
            return 1
        }
        return -1
    }
    if !left_rich {
        return cmp_text(left, right)
    }
    return cmp_rich_bodies(rich_body(left), rich_body(right))
}

private func hash_chain(acc: u128, next: u128) -> u128 {
    var words: Array[u64] = new[Array[u64]](4)
    words[0] = unsafe_cast[u64] acc
    words[1] = unsafe_cast[u64] (acc >> 64)
    words[2] = unsafe_cast[u64] next
    words[3] = unsafe_cast[u64] (next >> 64)
    return words.hash()
}

private func hash_text(s: string) -> u128 {
    return s.hash()
}

private func hash_opt_u32(o: u32?) -> u128 {
    var words: Array[u64] = new[Array[u64]](2)
    if o != nil {
        words[0] = 1
        words[1] = cast[u64] o
    }
    return words.hash()
}

private func hash_opt_string(o: string?) -> u128 {
    var is_set: u64 = 0
    if o != nil {
        is_set = 1
    }
    let acc: u128 = is_set.hash()
    if o == nil {
        return acc
    }
    return hash_chain(acc, hash_text(o))
}

private func hash_sub_spec(sub: Sub_Spec) -> u128 {
    let arm: u64 = sub_arm(sub)
    let acc: u128 = arm.hash()
    switch sub {
        case position {
            return hash_chain(acc, sub.position.hash())
        }
        case argname {
            return hash_chain(acc, hash_text(sub.argname))
        }
        case none {
            return acc
        }
        case auto {
            return acc
        }
    }
}

private func hash_rich_body(body: Ref[Rich_Body]) -> u128 {
    var acc: u128
    if is_rich(body.__value.s) {
        acc = hash_rich_body(rich_body(body.__value.s))
    }
    else {
        acc = hash_text(body.__value.s)
    }
    let nrec: u64 = body.__value.style_info.len()
    acc = hash_chain(acc, nrec.hash())
    var i: int = 0
    while i < cast[int] nrec {
        let r: Style_Record = body.__value.style_info[i]
        acc = hash_chain(acc, hash_opt_u32(r.start_ix))
        acc = hash_chain(acc, hash_opt_u32(r.end_ix))
        acc = hash_chain(acc, hash_opt_string(r.style_tag))
        acc = hash_chain(acc, hash_opt_string(r.format_spec))
        acc = hash_chain(acc, hash_sub_spec(r.substitution))
        let orders: u64 = (cast[u64](r.start_order) << 32) |
            cast[u64](r.end_order)
        acc = hash_chain(acc, orders.hash())
        i += 1
    }
    return acc
}

func string_hash(s: string) -> u128 {
    if is_rich(s) {
        return hash_rich_body(rich_body(s))
    }
    if string.core.byte_len(s) == 0 {
        let zero: u64 = 0
        return zero.hash()
    }
    return hash_text(s)
}

private func format_style_tag(fd: int, tag: string, closing: bool)
    -> uint fail: int {
    var out: uint = 0
    out += io.format.format_byte(fd, 0x5b)!
    if closing {
        out += io.format.format_byte(fd, 0x2f)!
    }
    out += io.format.format_string(fd, tag)!
    out += io.format.format_byte(fd, 0x5d)!
    return out
}

private func format_substitution(fd: int, r: Style_Record) -> uint fail: int {
    var out: uint = 0
    out += io.format.format_string(fd, "[#")!
    let sub: Sub_Spec = r.substitution
    switch sub {
        case argname {
            out += io.format.format_string(fd, sub.argname)!
        }
        case position {
            let ix_fmt: io.format.Int_Format = (
                common = io.format.default_repr_options,
                sep_policy = io.format.Format_Num_Sep.none,
                plus_policy = io.format.Format_Plus.never,
                is_signed = false, hex = false, add_prefix = false)
            out += io.format.format_uint(cast[u128] sub.position, ix_fmt,
                                         fd)!
        }
        case none {
        }
        case auto {
        }
    }
    if r.format_spec != nil {
        out += io.format.format_byte(fd, 0x3a)!
        let spec: string = r.format_spec
        var k: uint = 0
        while k < string.core.byte_len(spec) {
            let c: u8 = string.core.byte_at(spec, k)
            if c == 0x5d {
                out += io.format.format_byte(fd, 0x5c)!
            }
            out += io.format.format_byte(fd, c)!
            k += 1
        }
    }
    out += io.format.format_byte(fd, 0x5d)!
    return out
}

// The layers of a rich string, outermost first.
private func rich_layers(s: string) -> List[string] {
    var layers: List[string] = new[List[string]]()
    var cur: string = s
    while is_rich(cur) {
        layers.append(cur)
        cur = rich_body(cur).__value.s
    }
    return layers
}

private func print_event(fd: int, body: Ref[Rich_Body],
                         events: List[Markup_Event], at: int)
    -> uint fail: int {
    let ev: Markup_Event = events[at]
    let r: Style_Record = body.__value.style_info[ev.rec]
    if ev.closing {
        return format_style_tag(fd, r.style_tag.get_or_else(""), true)!
    }
    if record_is_reset(r) {
        return io.format.format_string(fd, "[/]")!
    }
    if record_is_slot(r) {
        return format_substitution(fd, r)!
    }
    return format_style_tag(fd, r.style_tag.get_or_else(""), false)!
}

// Prints every layer's markup events at offset `pos`, each layer's in its
// own order. Across layers, the closes that come first in a layer print
// inner layer first, then the rest of each layer's events print outer
// layer first, so an outer span wraps an inner one that starts or ends with
// it.
private func print_events_at(fd: int, layers: List[string],
                             events: List[List[Markup_Event]],
                             modify cursors: Array[int], pos: u64)
    -> uint fail: int {
    var out: uint = 0
    let count: int = cast[int] layers.len()
    var k: int = count - 1
    while k >= 0 {
        let body: Ref[Rich_Body] = rich_body(layers[k])
        let evs: List[Markup_Event] = events[k]
        while cursors[k] < cast[int](evs.len()) and
            cast[u64](evs[cursors[k]].offset) == pos and
            evs[cursors[k]].closing {
            out += print_event(fd, body, evs, cursors[k])!
            cursors[k] += 1
        }
        k -= 1
    }
    k = 0
    while k < count {
        let body: Ref[Rich_Body] = rich_body(layers[k])
        let evs: List[Markup_Event] = events[k]
        while cursors[k] < cast[int](evs.len()) and
            cast[u64](evs[cursors[k]].offset) == pos {
            out += print_event(fd, body, evs, cursors[k])!
            cursors[k] += 1
        }
        k += 1
    }
    return out
}

// Prints the markup events exactly as recorded, so `[b]a[/b][#]` and
// `[b]a[#][/b]` stay apart. A span that flows right (never closed) shows
// no close.
private func repr_rich_string(s: string, fd: int) -> uint fail: int {
    let base: string = string.core.text(s)
    let n: u64 = cast[u64] string.core.byte_len(base)
    let layers: List[string] = rich_layers(s)
    var events: List[List[Markup_Event]] = new[List[List[Markup_Event]]]()
    var cursors: Array[int] = new[Array[int]](cast[int] layers.len())
    var k: int = 0
    while k < cast[int] layers.len() {
        events.append(record_events(rich_body(layers[k]).__value.style_info))
        cursors[k] = 0
        k += 1
    }
    var out: uint = 0
    out += io.format.format_string(fd, "r\"")!
    var i: u64 = 0
    while i <= n {
        out += print_events_at(fd, layers, events, cursors, i)!
        if i >= n {
            i += 1
            continue
        }
        let c: u8 = string.core.byte_at(base, i)
        if c == 0x5b {
            out += io.format.format_byte(fd, 0x5c)!
        }
        out += io.format.format_byte(fd, c)!
        i += 1
    }
    out += io.format.format_byte(fd, 0x22)!
    return out
}

func raw_repr_string(s: string, fd: int, common: io.format.Repr_Options?)
    -> uint fail: int {
    var fmt: io.format.String_Repr = default_string_format
    if common != nil {
        fmt.common = common
    }
    if is_rich(s) {
        return repr_rich_string(s, fd)!
    }
    let len: uint = string.core.byte_len(s)
    if len != 0 and !string.core.is_text(s) {
        fmt.hex = true
    }
    var bytes: Array[u8] = string.core.__text_byte_array(s)
    return io.format.format_bytes(fd, ref bytes, len, common = fmt.common,
                                  byte_literal = fmt.hex,
                                  force_hex = fmt.hex)!
}

private func merge_tri(base: bool?, overlay: bool?) -> bool? {
    if overlay != nil {
        return overlay
    }
    return base
}

private func merge_opt_i8(base: i8?, overlay: i8?) -> i8? {
    if overlay != nil {
        return overlay
    }
    return base
}

private func merge_opt_i16(base: i16?, overlay: i16?) -> i16? {
    if overlay != nil {
        return overlay
    }
    return base
}

private func merge_opt_color(base: Color?, overlay: Color?) -> Color? {
    if overlay != nil {
        return overlay
    }
    return base
}

func merge(self: Text_Style, overlay: Text_Style) -> Text_Style {
    var r: Text_Style = empty_style
    r.bold = merge_tri(self.bold, overlay.bold)
    r.italic = merge_tri(self.italic, overlay.italic)
    r.underline = merge_tri(self.underline, overlay.underline)
    r.double_underline = merge_tri(self.double_underline,
                                   overlay.double_underline)
    r.strikethrough = merge_tri(self.strikethrough, overlay.strikethrough)
    r.reverse = merge_tri(self.reverse, overlay.reverse)
    r.dim = merge_tri(self.dim, overlay.dim)
    r.blink = merge_tri(self.blink, overlay.blink)
    r.text_case = self.text_case
    if overlay.text_case != Text_Case.none {
        r.text_case = overlay.text_case
    }
    r.font_hint = self.font_hint
    if overlay.font_hint != Font_Hint.default {
        r.font_hint = overlay.font_hint
    }
    r.font_index = merge_opt_i8(self.font_index, overlay.font_index)
    r.fg_palette_ix = merge_opt_i8(self.fg_palette_ix, overlay.fg_palette_ix)
    r.bg_palette_ix = merge_opt_i8(self.bg_palette_ix, overlay.bg_palette_ix)
    r.fg_rgb = merge_opt_color(self.fg_rgb, overlay.fg_rgb)
    r.bg_rgb = merge_opt_color(self.bg_rgb, overlay.bg_rgb)
    r.font_size = merge_opt_i16(self.font_size, overlay.font_size)
    return r
}

private func opt_i8_eq(a: i8?, b: i8?) -> bool {
    if (a != nil) != (b != nil) {
        return false
    }
    if a == nil or b == nil {
        return true
    }
    return a == b
}

private func opt_i16_eq(a: i16?, b: i16?) -> bool {
    if (a != nil) != (b != nil) {
        return false
    }
    if a == nil or b == nil {
        return true
    }
    return a == b
}

private func opt_color_eq(a: Color?, b: Color?) -> bool {
    if (a != nil) != (b != nil) {
        return false
    }
    if a == nil or b == nil {
        return true
    }
    return a == b
}

func __equal(view self: Text_Style, view other: Text_Style) -> bool {
    return tri_rank(self.bold) == tri_rank(other.bold) and
        tri_rank(self.italic) == tri_rank(other.italic) and
        tri_rank(self.underline) == tri_rank(other.underline) and
        tri_rank(self.double_underline) == tri_rank(other.double_underline) and
        tri_rank(self.strikethrough) == tri_rank(other.strikethrough) and
        tri_rank(self.reverse) == tri_rank(other.reverse) and
        tri_rank(self.dim) == tri_rank(other.dim) and
        tri_rank(self.blink) == tri_rank(other.blink) and
        self.text_case == other.text_case and
        self.font_hint == other.font_hint and
        opt_i8_eq(self.font_index, other.font_index) and
        opt_i8_eq(self.fg_palette_ix, other.fg_palette_ix) and
        opt_i8_eq(self.bg_palette_ix, other.bg_palette_ix) and
        opt_color_eq(self.fg_rgb, other.fg_rgb) and
        opt_color_eq(self.bg_rgb, other.bg_rgb) and
        opt_i16_eq(self.font_size, other.font_size)
}

func is_empty(self: Text_Style) -> bool {
    return self == empty_style
}

