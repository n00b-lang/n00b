private record String_Words layout(c) {
    data:     Ref[byte]
    selector: u64
}

private record Byte_Array_Value layout(c) {
    data:       Ref[byte]
    descriptor: Ref[Byte_Array_Shape]
}

private record Byte_Array_Shape layout(c) {
    total_count:   u64
    rank:          u32
    flat_rank:     u32
    flags:         u32
    reserved_zero: u32
    extent:        u64
}

private const tag_shift:      u64 = 62
private const encoding_shift: u64 = 60
private const length_mask:    u64 = 0x0fffffffffffffff
private const short_capacity: uint = 14
private const short_selector: uint = 15
private const tag_long:       u64 = 1
private const tag_span:       u64 = 2
private const tag_rich:       u64 = 3

private func words(self: Ref[string]) -> Ref[String_Words] {
    return unsafe_cast[Ref[String_Words]] self
}

private func long_selector(n: uint, encoding: u8, tag: u64) -> u64 {
    return cast[u64] n | (cast[u64] encoding << encoding_shift) |
        (tag << tag_shift)
}

private func __string_tag(s: string) -> u8 {
    return cast[u8](words(ref s).selector >> tag_shift)
}

private func __string_encoding_bits(s: string) -> u8 {
    return cast[u8]((words(ref s).selector >> encoding_shift) & 3)
}

private func __string_byte_len(s: string) -> uint {
    let selector: u64 = words(ref s).selector
    if selector >> tag_shift == 0 {
        return cast[uint]((selector >> 56) & 0xf)
    }
    return cast[uint](selector & length_mask)
}

private func __string_byte(s: string, i: uint) -> u8 {
    let view: Ref[String_Words] = words(ref s)
    if view.selector >> tag_shift == 0 {
        let cell: byte = __gc_byte_offset(unsafe_cast[Ref[byte]] view,
                                          cast[int] i)
        return cast[u8] cell
    }
    let stored: byte = __gc_byte_offset(view.data, cast[int] i)
    return cast[u8] stored
}

private func __string_make(bytes: Array[u8], at: uint, n: uint, encoding: u8,
                           share: bool) -> string {
    var text: string = ""
    let view: Ref[String_Words] = words(ref text)
    if n <= short_capacity {
        let cells: Ref[byte] = unsafe_cast[Ref[byte]] view
        var i: uint = 0
        while i < n {
            ref_write(__gc_byte_offset(cells, cast[int] i),
                      cast[byte] bytes[at + i])
            i += 1
        }
        ref_write(__gc_byte_offset(cells, cast[int] short_selector),
                  cast[byte](n | (cast[uint] encoding << 4)))
        return text
    }
    if share {
        view.data = unsafe_cast[Ref[byte]] ref bytes[at]
        view.selector = long_selector(n, encoding, tag_span)
        return text
    }
    var copy: Array[u8] = new[Array[u8]](cast[int] n)
    var i: uint = 0
    while i < n {
        copy[i] = bytes[at + i]
        i += 1
    }
    view.data = unsafe_cast[Ref[byte]] ref copy[0]
    view.selector = long_selector(n, encoding, tag_long)
    return text
}

private func __string_span(s: string, at: uint, n: uint,
                           encoding: u8) -> string {
    var text: string = ""
    let view: Ref[String_Words] = words(ref text)
    view.data = __gc_byte_offset(words(ref s).data, cast[int] at)
    view.selector = long_selector(n, encoding, tag_span)
    return text
}

private func __string_rich_body(s: string) -> Ref[`T] {
    return unsafe_cast[Ref[`T]] words(ref s).data
}

private func __string_make_rich(body: Ref[`T]) -> string {
    var text: string = ""
    let view: Ref[String_Words] = words(ref text)
    view.data = unsafe_cast[Ref[byte]] body
    view.selector = tag_rich << tag_shift
    return text
}

private func base_text(self: string) -> string {
    var text: string = self
    while __string_tag(text) == cast[u8] tag_rich {
        let body: Ref[string] = unsafe_cast[Ref[string]] words(ref text).data
        text = body
    }
    return text
}

private func joined_encoding(left: u8, right: u8) -> u8 {
    if left == 0 or right == 0 {
        return 0
    }
    if left == 2 or right == 2 {
        return 2
    }
    return 1
}

private func adopt_bytes(bytes: Array[u8], n: uint, encoding: u8) -> string {
    if n <= short_capacity {
        return __string_make(bytes, 0, n, encoding, false)
    }
    var text: string = ""
    let view: Ref[String_Words] = words(ref text)
    view.data = unsafe_cast[Ref[byte]] ref bytes[0]
    view.selector = long_selector(n, encoding, tag_long)
    return text
}

func __add(self: string, other: string) -> string {
    let left: string = base_text(self)
    let right: string = base_text(other)
    let left_length: uint = __string_byte_len(left)
    let right_length: uint = __string_byte_len(right)
    let n: uint = left_length + right_length
    var bytes: Array[u8] = new[Array[u8]](cast[int] n)
    var i: uint = 0
    while i < left_length {
        bytes[i] = __string_byte(left, i)
        i += 1
    }
    var j: uint = 0
    while j < right_length {
        bytes[left_length + j] = __string_byte(right, j)
        j += 1
    }
    return adopt_bytes(bytes, n, joined_encoding(
        __string_encoding_bits(left), __string_encoding_bits(right)))
}

func __equal(self: string, other: string) -> bool {
    let left: string = base_text(self)
    let right: string = base_text(other)
    let n: uint = __string_byte_len(left)
    if n != __string_byte_len(right) {
        return false
    }
    var i: uint = 0
    while i < n {
        if __string_byte(left, i) != __string_byte(right, i) {
            return false
        }
        i += 1
    }
    return true
}

func __cmp(self: string, other: string) -> Comparison {
    let left: string = base_text(self)
    let right: string = base_text(other)
    let left_length: uint = __string_byte_len(left)
    let right_length: uint = __string_byte_len(right)
    var common: uint = left_length
    if right_length < common {
        common = right_length
    }
    var i: uint = 0
    while i < common {
        let a: u8 = __string_byte(left, i)
        let b: u8 = __string_byte(right, i)
        if a < b {
            return Comparison.less
        }
        if a > b {
            return Comparison.greater
        }
        i += 1
    }
    if left_length < right_length {
        return Comparison.less
    }
    if left_length > right_length {
        return Comparison.greater
    }
    return Comparison.equal
}

private func utf8_sequence(bytes: Array[u8], at: uint, remaining: uint)
    -> uint {
    let lead: u8 = bytes[at]
    if lead < 0x80 {
        return 1
    }
    var length: uint = 0
    if lead >= 0xc2 and lead <= 0xdf {
        length = 2
    }
    elif lead >= 0xe0 and lead <= 0xef {
        length = 3
    }
    elif lead >= 0xf0 and lead <= 0xf4 {
        length = 4
    }
    if length == 0 or length > remaining {
        return 0
    }
    var i: uint = 1
    while i < length {
        if (bytes[at + i] & 0xc0) != 0x80 {
            return 0
        }
        i += 1
    }
    let second: u8 = bytes[at + 1]
    if (lead == 0xe0 and second < 0xa0) or (lead == 0xed and second > 0x9f) or
        (lead == 0xf0 and second < 0x90) or (lead == 0xf4 and second > 0x8f) {
        return 0
    }
    return length
}

func __string_from_utf8(bytes: Array[u8], result: Ref[string]) -> bool {
    let length: uint = __array_length(bytes)
    var ascii: bool = true
    var at: uint = 0
    while at < length {
        let advance: uint = utf8_sequence(bytes, at, length - at)
        if advance == 0 {
            return false
        }
        ascii = ascii and advance == 1
        at += advance
    }
    var encoding: u8 = 2
    if ascii {
        encoding = 1
    }
    ref_write(result, __string_make(bytes, 0, length, encoding, false))
    return true
}

private func __string_storage(s: string) -> Array[u8]? {
    let view: Ref[String_Words] = words(ref s)
    if view.selector >> tag_shift != tag_long {
        return nil
    }
    let length: u64 = view.selector & length_mask
    var shape: Byte_Array_Shape = (total_count = length, rank = 1,
        flat_rank = 1, flags = 0, reserved_zero = 0, extent = length)
    var value: Byte_Array_Value = (data = view.data, descriptor = ref shape)
    let storage: Ref[Array[u8]] = unsafe_cast[Ref[Array[u8]]] ref value
    return storage
}
