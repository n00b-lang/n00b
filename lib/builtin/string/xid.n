private func xid_bit(cp: u32, word: uint) -> bool {
    let block: u32 = cp >> 8
    if block >= cast[u32] __array_length(xid_block) {
        return false
    }
    let base: uint = cast[uint](xid_block[block]) * 8
    let k: u32 = cp & 0xff
    let bits: u64 = xid_words[base + word + cast[uint](k >> 6)]
    return (bits >> cast[u64](k & 63)) & 1 != 0
}

func is_xid_start(cp: u32) -> bool {
    return xid_bit(cp, 0)
}

func is_xid_continue(cp: u32) -> bool {
    return xid_bit(cp, 4)
}
