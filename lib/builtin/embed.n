import abi
import integer
import string.core
import litmod_site
import sys.fs

private const bits_flag: u32 = 1 << 4

private func blank(b: u8) -> bool {
    return b == 0x20 or b == 0x09 or b == 0x0a or b == 0x0d
}

private func trimmed(text: string) -> string {
    var start: int = 0
    var end: int = cast[int] string.core.byte_len(text)
    while start < end and blank(string.core.byte_at(text, cast[u64] start)) {
        start += 1
    }
    while end > start and blank(string.core.byte_at(text, cast[u64] (end - 1))) {
        end -= 1
    }
    return string.core.byte_slice(text, start, end)
}

private func resolved_path(contents: string, site: litmod_site.Literal_Site)
    -> string {
    let path: string = trimmed(contents)
    if string.core.byte_len(path) > 0
        and string.core.byte_at(path, 0) == 0x2f {
        return path
    }
    var slash: int = cast[int](string.core.byte_len(site.path)) - 1
    while slash >= 0 and string.core.byte_at(site.path, cast[u64] slash) != 0x2f {
        slash -= 1
    }
    if slash < 0 {
        return path
    }
    return string.core.byte_slice(site.path, 0, slash) + "/" + path
}

private func element_row(probe: Array['E]) -> Ref[abi.Type_Record]? {
    let array_row: Ref[abi.Type_Record]? = __abi_type_for(typeof(probe))
    if array_row == nil {
        return nil
    }
    let components: abi.Range = array_row.__value.components
    let index: i64 = __abi_range_index(components.first, components.count, 0)
    if index < 0 {
        return nil
    }
    return __abi_type(cast[u32] index)
}

private func stride_bytes(row: Ref[abi.Type_Record]) -> uint {
    let alignment: uint = row.__value.alignment_bytes
    if alignment == 0 {
        return 0
    }
    var bytes: uint = row.__value.size_bits / 8
    if row.__value.size_bits % 8 != 0 {
        bytes += 1
    }
    return ((bytes + alignment - 1) / alignment) * alignment
}

private func plain_data(row: Ref[abi.Type_Record]) -> bool {
    let boolean: Ref[abi.Type_Record]? = __abi_type_for(typeof(false))
    let is_bool: bool = boolean != nil
        and boolean.__value.typehash == row.__value.typehash
    return row.__value.tracing_index == 0 and row.__value.flags & bits_flag == 0 and !is_bool
}

fence litmod embed(contents: string, site: litmod_site.Literal_Site)
    -> Array['E] fail: string {
    let path: string = resolved_path(contents, site)
    var items: Array['E] = []
    let found: Ref[abi.Type_Record]? = element_row(items)
    if found == nil {
        fail "'embed needs a concrete element type"
    }
    let row: Ref[abi.Type_Record] = found
    let name: string = (unsafe_cast[Ref[string]] (ref row.__value.canonical_name)).__value
    let stride: uint = stride_bytes(row)
    if !plain_data(row) or stride == 0 {
        fail "'embed cannot fill " + name +
            ": elements must be fixed-size plain data with no references"
    }
    var bytes: Array[u8] = []
    try {
        bytes = sys.fs.read_file(path)!
    } fail(failure) {
        fail "'embed cannot read " + path
    }
    let size: uint = __array_length(bytes)
    if size % stride != 0 {
        fail path + " is " + integer.decimal(size) +
            " bytes, not a whole number of " + integer.decimal(stride) +
            "-byte " + name + " elements"
    }
    items = new[Array['E]](size / stride)
    if size > 0 {
        __gc_memcpy(unsafe_cast[Ref[byte]] ref items[0],
                    unsafe_cast[Ref[byte]] ref bytes[0], size)
    }
    return items
}
