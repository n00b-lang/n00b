import diag
import grammar
import ebnf_scan

record Use {
    index: uint
    span:  diag.Span
}

object Ebnf_Parser {
    sc:              ebnf_scan.Ebnf_Scanner
    tok:             ebnf_scan.Ebnf_Token
    g:               grammar.Grammar
    rule_uses:       List[Use]
    class_uses:      List[Use]
    declared:        List[bool]
    decl_order:      List[uint]
    first_rule:      uint?
    start_use:       Use?
    start_name:      string
    identifier_use:  Use?
}

func __init(self: Ebnf_Parser, text: string, source_name: string) {
    self.sc = new[ebnf_scan.Ebnf_Scanner](text)
    self.tok = (kind = ebnf_scan.Tok_Kind.eof, text = "",
                span = new[diag.Span]())
    self.g = new[grammar.Grammar](source_name)
    self.rule_uses = new[List[Use]]()
    self.class_uses = new[List[Use]]()
    self.declared = new[List[bool]]()
    self.decl_order = new[List[uint]]()
    self.first_rule = nil
    self.start_use = nil
    self.start_name = ""
    self.identifier_use = nil
}

private func advance(p: Ebnf_Parser) {
    p.tok = ebnf_scan.next_token(p.sc)
}

private func at(p: Ebnf_Parser, kind: ebnf_scan.Tok_Kind) -> bool {
    return p.tok.kind == kind
}

private func at_line_end(p: Ebnf_Parser) -> bool {
    return at(p, ebnf_scan.Tok_Kind.newline) or at(p, ebnf_scan.Tok_Kind.eof)
}

private func report(p: Ebnf_Parser, d: diag.Diagnostic) {
    ebnf_scan.report(p.sc, d)
}

private func skip_line(p: Ebnf_Parser) {
    while !at_line_end(p) {
        advance(p)
    }
    if at(p, ebnf_scan.Tok_Kind.newline) {
        advance(p)
    }
}

private func describe(tok: ebnf_scan.Ebnf_Token) -> string {
    switch tok.kind {
        case ebnf_scan.Tok_Kind.eof { return "the end of the grammar" }
        case ebnf_scan.Tok_Kind.newline { return "the end of the line" }
        case ebnf_scan.Tok_Kind.directive { return "`" + tok.text + ":`" }
        case ebnf_scan.Tok_Kind.rule_name { return "`<" + tok.text + ">`" }
        case ebnf_scan.Tok_Kind.class_ref { return "`%" + tok.text + "`" }
        case ebnf_scan.Tok_Kind.hard_lit { return "`%\"" + tok.text + "\"`" }
        case ebnf_scan.Tok_Kind.lit { return "`\"" + tok.text + "\"`" }
        else { return "`" + tok.text + "`" }
    }
}

private func unexpected(p: Ebnf_Parser, expected: string) {
    report(p, new[diag.Diagnostic]("ebnf/unexpected-token",
        "expected " + expected + ", found " + describe(p.tok), p.tok.span))
}

private func rule_slot(p: Ebnf_Parser, name: string) -> uint {
    let found: uint? = p.g.rule_index[name]
    if found != nil {
        return found.get()
    }
    let at: uint = p.g.rules.len()
    p.g.rules.append(new[grammar.Rule](name))
    p.g.rule_index[name] = at
    return at
}

private func class_slot(p: Ebnf_Parser, name: string, span: diag.Span)
    -> uint {
    let found: uint? = p.g.class_index[name]
    if found != nil {
        return found.get()
    }
    let at: uint = p.g.classes.len()
    p.g.classes.append(new[grammar.Token_Class](name, span))
    p.g.class_index[name] = at
    p.declared.append(false)
    return at
}

private func literal_slot(p: Ebnf_Parser, text: string, hard: bool,
                          span: diag.Span) -> uint {
    let found: uint? = p.g.literal_index[text]
    if found != nil {
        if hard {
            p.g.literals[found.get()].hard = true
        }
        return found.get()
    }
    let at: uint = p.g.literals.len()
    p.g.literals.append(new[grammar.Literal](text, hard, span))
    p.g.literal_index[text] = at
    return at
}

private func quantifier(kind: ebnf_scan.Tok_Kind) -> grammar.Quant? {
    switch kind {
        case ebnf_scan.Tok_Kind.question { return grammar.Quant.opt }
        case ebnf_scan.Tok_Kind.star { return grammar.Quant.star }
        case ebnf_scan.Tok_Kind.plus { return grammar.Quant.plus }
        else { return nil }
    }
}

private func delete_fix(span: diag.Span) -> diag.Fix {
    return ebnf_scan.fix("delete it", span, "")
}

private func misplaced_quantifier(p: Ebnf_Parser, message: string) {
    var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/misplaced-quantifier", message,
                                   p.tok.span)
    d.fixes.append(delete_fix(p.tok.span))
    report(p, d)
    advance(p)
}

private func item(p: Ebnf_Parser) -> grammar.Item? {
    let start: diag.Span = p.tok.span
    var span: diag.Span = start
    var atom: grammar.Atom? = nil
    switch p.tok.kind {
        case ebnf_scan.Tok_Kind.rule_name {
            let slot: uint = rule_slot(p, p.tok.text)
            p.rule_uses.append((index = slot, span = start))
            atom = (rule = slot)
            advance(p)
        }
        case ebnf_scan.Tok_Kind.class_ref {
            let slot: uint = class_slot(p, p.tok.text, start)
            p.class_uses.append((index = slot, span = start))
            atom = (class = slot)
            advance(p)
        }
        case ebnf_scan.Tok_Kind.hard_lit, ebnf_scan.Tok_Kind.lit {
            let hard: bool = at(p, ebnf_scan.Tok_Kind.hard_lit)
            atom = (literal = literal_slot(p, p.tok.text, hard, start))
            advance(p)
        }
        case ebnf_scan.Tok_Kind.lparen {
            advance(p)
            let alts: List[grammar.Alt] = alternatives(p, "`(`")
            if at(p, ebnf_scan.Tok_Kind.rparen) {
                span = ebnf_scan.join_spans(start, p.tok.span)
                advance(p)
            }
            else {
                var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/unbalanced-paren",
                    "this `(` is never closed", start)
                d.fixes.append(ebnf_scan.fix("close the group",
                    ebnf_scan.end_point(span), ")"))
                report(p, d)
            }
            if alts.len() > 0 {
                atom = (group = alts)
            }
        }
        else {
            return nil
        }
    }
    var quant: grammar.Quant = grammar.Quant.one
    let q: grammar.Quant? = quantifier(p.tok.kind)
    if q != nil {
        quant = q.get()
        span = ebnf_scan.join_spans(start, p.tok.span)
        advance(p)
        while quantifier(p.tok.kind) != nil {
            misplaced_quantifier(p, "an item takes at most one quantifier")
        }
    }
    if atom == nil {
        return nil
    }
    return (atom = atom.get(), quant = quant, span = span)
}

private func starts_item(kind: ebnf_scan.Tok_Kind) -> bool {
    return kind == ebnf_scan.Tok_Kind.rule_name or
        kind == ebnf_scan.Tok_Kind.class_ref or
        kind == ebnf_scan.Tok_Kind.hard_lit or
        kind == ebnf_scan.Tok_Kind.lit or kind == ebnf_scan.Tok_Kind.lparen
}

private func sequence(p: Ebnf_Parser) -> List[grammar.Item] {
    var items: List[grammar.Item] = new[List[grammar.Item]]()
    while !p.sc.halted {
        if quantifier(p.tok.kind) != nil {
            misplaced_quantifier(p, "`" + describe_quant(p.tok.kind) +
                                 "` has nothing to apply to")
            continue
        }
        if !starts_item(p.tok.kind) {
            break
        }
        let one: grammar.Item? = item(p)
        if one != nil {
            items.append(one.get())
        }
    }
    return items
}

private func describe_quant(kind: ebnf_scan.Tok_Kind) -> string {
    switch kind {
        case ebnf_scan.Tok_Kind.question { return "?" }
        case ebnf_scan.Tok_Kind.star { return "*" }
        else { return "+" }
    }
}

private func alternatives(p: Ebnf_Parser, after: string) -> List[grammar.Alt] {
    var alts: List[grammar.Alt] = new[List[grammar.Alt]]()
    var pipe: diag.Span? = nil
    while !p.sc.halted {
        let items: List[grammar.Item] = sequence(p)
        if items.len() > 0 {
            let alt: grammar.Alt = (items = items)
            alts.append(alt)
        }
        elif pipe != nil {
            var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/empty-alternative",
                "nothing follows this `|`", pipe.get())
            d.help = "to make something optional, write it as `( ... )?`"
            d.fixes.append(delete_fix(pipe.get()))
            report(p, d)
        }
        else {
            var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/empty-alternative",
                "expected a definition after " + after, p.tok.span)
            d.help = "to make something optional, write it as `( ... )?`"
            report(p, d)
        }
        if !at(p, ebnf_scan.Tok_Kind.pipe) {
            break
        }
        pipe = p.tok.span
        advance(p)
    }
    return alts
}

private func finish_line(p: Ebnf_Parser) {
    if at_line_end(p) {
        if at(p, ebnf_scan.Tok_Kind.newline) {
            advance(p)
        }
        return
    }
    if at(p, ebnf_scan.Tok_Kind.rparen) {
        var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/unbalanced-paren",
            "this `)` has no matching `(`", p.tok.span)
        d.fixes.append(delete_fix(p.tok.span))
        report(p, d)
    }
    else {
        unexpected(p, "the end of the line")
    }
    skip_line(p)
}

private func rule(p: Ebnf_Parser) {
    let name: ebnf_scan.Ebnf_Token = p.tok
    let slot: uint = rule_slot(p, name.text)
    p.g.rules[slot].defs.append(name.span)
    if p.first_rule == nil {
        p.first_rule = slot
    }
    advance(p)
    if !at(p, ebnf_scan.Tok_Kind.assign) {
        var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/expected-assign",
            "expected `::=` after `<" + name.text + ">`", p.tok.span)
        d.fixes.append(ebnf_scan.fix("add `::=`",
            ebnf_scan.end_point(name.span), " ::="))
        report(p, d)
        skip_line(p)
        return
    }
    advance(p)
    let alts: List[grammar.Alt] = alternatives(p, "`::=`")
    for let alt in alts {
        p.g.rules[slot].alts.append(alt)
    }
    finish_line(p)
}

private const directive_names: Array[string] = ["start", "identifier",
    "tokens", "trivia", "elastic"]

private func expect_class(p: Ebnf_Parser) -> Use? {
    if !at(p, ebnf_scan.Tok_Kind.class_ref) {
        unexpected(p, "a token class `%NAME`")
        return nil
    }
    let use: Use = (index = class_slot(p, p.tok.text, p.tok.span),
                    span = p.tok.span)
    advance(p)
    return use
}

private func duplicate_directive(p: Ebnf_Parser, word: string,
                                 here: diag.Span, first: diag.Span) {
    var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/duplicate-directive",
        "`" + word + ":` may appear only once", here)
    d.related.append((message = "first given here", span = first))
    report(p, d)
}

private func declare(p: Ebnf_Parser, use: Use, policy: grammar.Token_Policy) {
    let at: uint = use.index
    let class: grammar.Token_Class = p.g.classes[at]
    if p.declared[at] {
        var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/duplicate-token-class",
            "`%" + class.name + "` is already declared", use.span)
        if class.policy != policy {
            d = new[diag.Diagnostic]("ebnf/conflicting-token-policy",
                "`%" + class.name + "` is declared with two policies",
                use.span)
        }
        d.related.append((message = "first declared here", span = class.decl))
        report(p, d)
        return
    }
    p.declared[at] = true
    p.g.classes[at].policy = policy
    p.g.classes[at].decl = use.span
    p.decl_order.append(use.index)
}

private func directive(p: Ebnf_Parser) {
    let word: string = p.tok.text
    let here: diag.Span = p.tok.span
    advance(p)
    if word == "start" {
        if !at(p, ebnf_scan.Tok_Kind.rule_name) {
            unexpected(p, "a rule name `<name>`")
            skip_line(p)
            return
        }
        let first: Use? = p.start_use
        if first != nil {
            duplicate_directive(p, word, here, first.get().span)
        }
        else {
            p.start_use = (index = 0, span = p.tok.span)
            p.start_name = p.tok.text
        }
        advance(p)
    }
    elif word == "identifier" {
        let use: Use? = expect_class(p)
        if use == nil {
            skip_line(p)
            return
        }
        let first: Use? = p.identifier_use
        if first != nil {
            duplicate_directive(p, word, here, first.get().span)
        }
        else {
            p.identifier_use = use
        }
    }
    elif word == "tokens" or word == "trivia" or word == "elastic" {
        var policy: grammar.Token_Policy = grammar.Token_Policy.normal
        if word == "trivia" {
            policy = grammar.Token_Policy.trivia
        }
        elif word == "elastic" {
            policy = grammar.Token_Policy.elastic
        }
        while true {
            let use: Use? = expect_class(p)
            if use == nil {
                skip_line(p)
                return
            }
            declare(p, use.get(), policy)
            if at_line_end(p) {
                break
            }
            if at(p, ebnf_scan.Tok_Kind.comma) {
                advance(p)
            }
            elif at(p, ebnf_scan.Tok_Kind.class_ref) {
                var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/unexpected-token",
                    "expected `,` between token classes", p.tok.span)
                d.fixes.append(ebnf_scan.fix("add `,`",
                    ebnf_scan.end_point(use.get().span), ","))
                report(p, d)
            }
            else {
                break
            }
        }
    }
    else {
        var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/unknown-directive",
            "unknown directive `" + word + ":`", here)
        var names: List[string] = new[List[string]](items = directive_names)
        let guess: string? = diag.closest_match(word, names)
        if guess != nil {
            d.fixes.append(ebnf_scan.fix("did you mean `" + guess.get() + ":`?",
                here, guess.get() + ":"))
        }
        else {
            d.help = "directives are `start:`, `identifier:`, `tokens:`, " +
                "`trivia:` and `elastic:`"
        }
        report(p, d)
        skip_line(p)
        return
    }
    finish_line(p)
}

private func parse(p: Ebnf_Parser) {
    advance(p)
    while !p.sc.halted and !at(p, ebnf_scan.Tok_Kind.eof) {
        switch p.tok.kind {
            case ebnf_scan.Tok_Kind.newline { advance(p) }
            case ebnf_scan.Tok_Kind.rule_name { rule(p) }
            case ebnf_scan.Tok_Kind.directive { directive(p) }
            else {
                unexpected(p, "a rule `<name> ::= ...` or a directive")
                skip_line(p)
            }
        }
    }
}

private record Unknown_Name {
    index:    uint
    sites:    List[diag.Span]
}

private func group_unknown(uses: List[Use], unknown: List[bool])
    -> List[Unknown_Name] {
    var groups: List[Unknown_Name] = new[List[Unknown_Name]]()
    var group_of: Dict[uint, uint] = new[Dict[uint, uint]]()
    for let use in uses {
        if !unknown[use.index] {
            continue
        }
        let at: uint? = group_of[use.index]
        if at != nil {
            groups[at.get()].sites.append(use.span)
            continue
        }
        var sites: List[diag.Span] = new[List[diag.Span]]()
        sites.append(use.span)
        group_of[use.index] = groups.len()
        groups.append((index = use.index, sites = sites))
    }
    return groups
}

private func resolve_rules(p: Ebnf_Parser) {
    var unknown: List[bool] = new[List[bool]]()
    var defined: List[string] = new[List[string]]()
    for let rule in p.g.rules {
        unknown.append(rule.defs.len() == 0)
        if rule.defs.len() > 0 {
            defined.append(rule.name)
        }
    }
    let groups: List[Unknown_Name] = group_unknown(p.rule_uses, unknown)
    for let group in groups {
        let name: string = p.g.rules[group.index].name
        var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/undefined-rule",
            "`<" + name + ">` is never defined", group.sites[0])
        let guess: string? = diag.closest_match(name, defined)
        if guess != nil {
            for let site in group.sites {
                d.fixes.append(ebnf_scan.fix(
                    "did you mean `<" + guess.get() + ">`?", site,
                    "<" + guess.get() + ">"))
            }
        }
        report(p, d)
    }
    let start_use: Use? = p.start_use
    let first_rule: uint? = p.first_rule
    if start_use != nil {
        let use: Use = start_use.get()
        let at: uint? = p.g.rule_index[p.start_name]
        if at == nil or unknown[at.get()] {
            var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/undefined-start",
                "the start rule `<" + p.start_name + ">` is never defined",
                use.span)
            let guess: string? = diag.closest_match(p.start_name, defined)
            if guess != nil {
                d.fixes.append(ebnf_scan.fix(
                    "did you mean `<" + guess.get() + ">`?", use.span,
                    "<" + guess.get() + ">"))
            }
            report(p, d)
        }
        else {
            p.g.start = at.get()
        }
    }
    elif first_rule != nil {
        p.g.start = first_rule.get()
    }
    else {
        report(p, new[diag.Diagnostic]("ebnf/no-rules", "the grammar defines no rules",
                        new[diag.Span]()))
    }
}

private func resolve_classes(p: Ebnf_Parser) {
    let identifier_use: Use? = p.identifier_use
    var identifier: uint = 0
    if identifier_use != nil {
        identifier = identifier_use.get().index
    }
    else {
        identifier = class_slot(p, "IDENTIFIER", new[diag.Span]())
    }
    p.g.identifier = identifier
    let ident: uint = identifier
    p.g.classes[ident].id = grammar.token_id(grammar.identifier_token_id)
    if p.declared[ident] {
        var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/duplicate-token-class",
            "`%" + p.g.classes[ident].name +
            "` is the identifier class, so it cannot also be declared",
            p.g.classes[ident].decl)
        if identifier_use != nil {
            d.related.append((message = "made the identifier class here",
                              span = identifier_use.get().span))
        }
        report(p, d)
    }
    for i: uint from 0 until p.decl_order.len() {
        let slot: uint = p.decl_order[i]
        p.g.classes[slot].id = grammar.class_token_id(i)
    }

    var unknown: List[bool] = new[List[bool]]()
    var trivia: List[bool] = new[List[bool]]()
    var known: List[string] = new[List[string]]()
    for i: uint from 0 until p.g.classes.len() {
        let class: grammar.Token_Class = p.g.classes[i]
        let declared: bool = p.declared[i] or i == identifier
        unknown.append(!declared)
        trivia.append(declared and
                      class.policy == grammar.Token_Policy.trivia)
        if declared {
            known.append(class.name)
        }
    }
    let undeclared: List[Unknown_Name] = group_unknown(p.class_uses, unknown)
    for let group in undeclared {
        let name: string = p.g.classes[group.index].name
        var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/undeclared-token-class",
            "`%" + name + "` is not a declared token class", group.sites[0])
        let guess: string? = diag.closest_match(name, known)
        if guess != nil {
            for let site in group.sites {
                d.fixes.append(ebnf_scan.fix(
                    "did you mean `%" + guess.get() + "`?", site,
                    "%" + guess.get()))
            }
        }
        else {
            d.fixes.append(ebnf_scan.fix("declare it", new[diag.Span](),
                                         "tokens: %" + name + "\n"))
        }
        report(p, d)
    }
    let misused: List[Unknown_Name] = group_unknown(p.class_uses, trivia)
    for let group in misused {
        let trivia_class: grammar.Token_Class = p.g.classes[group.index]
        var d: diag.Diagnostic = new[diag.Diagnostic]("ebnf/trivia-in-rule",
            "`%" + trivia_class.name +
            "` is trivia, which never reaches the parser", group.sites[0])
        let note: diag.Related = (message = "declared as trivia here",
                                  span = trivia_class.decl)
        d.related.append(note)
        report(p, d)
    }

    let limit: u128 = grammar.identifier_token_id + 1 +
        cast[u128] p.decl_order.len()
    for let lit in p.g.literals {
        let raw: u128 = grammar.raw_token_id(lit.id)
        if raw >= grammar.identifier_token_id and raw < limit {
            panic("the hash of " + lit.text + " collides with a class id")
        }
    }
}

func load_ebnf(text: string, source_name: string = "<string>")
    -> grammar.Grammar fail: List[diag.Diagnostic] {
    var p: Ebnf_Parser = new[Ebnf_Parser](text, source_name)
    parse(p)
    if !p.sc.halted {
        resolve_classes(p)
        resolve_rules(p)
    }
    if p.sc.diags.len() > 0 {
        var diags: List[diag.Diagnostic] = p.sc.diags
        var last: diag.Diagnostic? = nil
        if p.sc.halted {
            last = diags.pop()
        }
        var sorted: List[diag.Diagnostic] = diag.sorted_by_position(diags)
        if last != nil {
            sorted.append(last.get())
        }
        fail sorted
    }
    return p.g
}
