import diag
import grammar
import ebnf_parse

fence litmod bnf(contents: string, site: Literal_Site)
    -> grammar.Grammar fail: string {
    try {
        return ebnf_parse.load_ebnf(contents, source_name = site.path)!
    } fail(diags) {
        let offset: u32 = cast[u32](site.line)
        var shifted: List[diag.Diagnostic] = new[List[diag.Diagnostic]]()
        for let d in diags {
            var moved: diag.Diagnostic = d
            moved.span.start_line += offset
            moved.span.end_line += offset
            shifted.append(moved)
        }
        let src: diag.Source = (name = site.path, text = contents)
        fail diag.render_all(shifted, src)
    }
}
