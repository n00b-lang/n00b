import grammar

flagset Token_Flags {
    trivia, elastic,
    none = nil
}

record Token {
    id:     grammar.Token_Id
    alt_id: grammar.Token_Id?
    start:  uint
    end:    uint
    flags:  Token_Flags
}

object Lex_Context {
    g:        grammar.Grammar
    source:   string
    classes:  Dict[string, grammar.Token_Id]
    policies: List[grammar.Token_Policy]
}

func __init(self: Lex_Context, g: grammar.Grammar, source: string) {
    self.g = g
    self.source = source
    self.classes = new[Dict[string, grammar.Token_Id]]()
    self.policies = new[List[grammar.Token_Policy]]()
    for i : uint from 0 until g.classes.len() {
        self.policies.append(grammar.Token_Policy.normal)
    }
    for class in g.classes {
        self.classes[class.name] = class.id
        let slot: u128 = grammar.raw_token_id(class.id) -
            grammar.identifier_token_id
        self.policies[cast[uint](slot)] = class.policy
    }
}

private func flags_of(ctx: Lex_Context, raw: u128) -> Token_Flags {
    if raw < grammar.identifier_token_id or
        raw - grammar.identifier_token_id >= cast[u128](ctx.policies.len()) {
        return Token_Flags.none
    }
    switch ctx.policies[cast[uint](raw - grammar.identifier_token_id)] {
        case grammar.Token_Policy.trivia {
            return Token_Flags.trivia
        }
        case grammar.Token_Policy.elastic {
            return Token_Flags.elastic
        }
        else {
            return Token_Flags.none
        }
    }
}

func emit(ctx  : Lex_Context, start: uint, end: uint,
          class: grammar.Token_Id? = nil) -> Token {
    let spelling: string = byte_slice(ctx.source, start, end)
    if class == nil {
        return (id = grammar.literal_token_id(spelling), alt_id = nil,
                start = start, end = end, flags = Token_Flags.none)
    }
    var id:     grammar.Token_Id  = class
    var alt_id: grammar.Token_Id? = nil
    let raw:    u128              = grammar.raw_token_id(id)
    if raw == grammar.identifier_token_id {
        let lit: grammar.Literal? = grammar.find_literal(ctx.g, spelling)
        if lit != nil and lit.identifier {
            if lit.hard {
                id = lit.id
            }
            else {
                alt_id = lit.id
            }
        }
    }
    return (id = id, alt_id = alt_id, start = start, end = end,
            flags = flags_of(ctx, raw))
}
