import internal.diag
import internal.scan
import internal.lex.spec

enum Item_Kind { word = 0, text, class, dots, arrow, set_name, end_rule, eof }

record Item {
    kind: Item_Kind
    text: string
    span: internal.diag.Span
}

object Loader {
    sc:      internal.scan.Ebnf_Scanner
    spec:    internal.lex.spec.Spec
    schemas: Dict[string, internal.lex.spec.Rule_Schema]
    ahead:   Item?
}

func __init(self: Loader, text: string, source_name: string) {
    self.sc = new[internal.scan.Ebnf_Scanner](text)
    self.spec = new[internal.lex.spec.Spec](source_name)
    self.schemas = internal.lex.spec.schema_table()
    self.ahead = nil
}

private func diagnostic(l: Loader, code: string, message: string,
                        span: internal.diag.Span) -> internal.diag.Diagnostic {
    let d: internal.diag.Diagnostic = new[internal.diag.Diagnostic]("lex/" + code, message, span)
    return d
}

private func item(l: Loader, kind: Item_Kind, text: string,
                  from: internal.scan.Mark) -> Item {
    return (kind = kind, text = text, span = internal.scan.span_from(l.sc, from))
}

private func is_word_char(c: char) -> bool {
    return internal.scan.is_word_char(c) or c == '-'
}

private func skip_to_content(l: Loader) -> bool {
    let sc: internal.scan.Ebnf_Scanner = l.sc
    while !internal.scan.at_end(sc) {
        let start: uint = sc.pos
        internal.scan.skip_blanks(sc)
        let c: char = internal.scan.peek(sc)
        if c == '#' {
            internal.scan.skip_comment(sc)
        }
        if internal.scan.at_end(sc) {
            return false
        }
        if internal.scan.peek(sc) != '\n' {
            return sc.pos > start
        }
        internal.scan.step(sc)
    }
    return false
}

private func scan(l: Loader) -> Item {
    let sc: internal.scan.Ebnf_Scanner = l.sc
    while true {
        internal.scan.skip_blanks(sc)
        let from: internal.scan.Mark = internal.scan.mark(sc)
        if internal.scan.at_end(sc) {
            return item(l, Item_Kind.eof, "", from)
        }
        let c: char = internal.scan.peek(sc)
        if c == '#' {
            internal.scan.skip_comment(sc)
            continue
        }
        if c == '\n' {
            internal.scan.step(sc)
            if skip_to_content(l) {
                continue
            }
            return item(l, Item_Kind.end_rule, "", from)
        }
        if c == '"' or c == '\'' {
            let text: string = internal.scan.literal(sc, from)
            return item(l, Item_Kind.text, text, from)
        }
        if c == '%' {
            internal.scan.step(sc)
            let name_start: uint = sc.pos
            while !internal.scan.at_end(sc) and is_word_char(internal.scan.peek(sc)) {
                internal.scan.step(sc)
            }
            return item(l, Item_Kind.class, internal.scan.slice(sc, name_start),
                        from)
        }
        if c == '.' and internal.scan.peek(sc, ahead = 1) == '.' {
            internal.scan.step(sc)
            internal.scan.step(sc)
            return item(l, Item_Kind.dots, "..", from)
        }
        if c == '-' and internal.scan.peek(sc, ahead = 1) == '>' {
            internal.scan.step(sc)
            internal.scan.step(sc)
            return item(l, Item_Kind.arrow, "->", from)
        }
        if internal.scan.is_word_char(c) {
            while !internal.scan.at_end(sc) and is_word_char(internal.scan.peek(sc)) {
                internal.scan.step(sc)
            }
            let text: string = internal.scan.slice(sc, from.byte)
            if internal.scan.peek(sc) == ':' {
                internal.scan.step(sc)
                return item(l, Item_Kind.set_name, text, from)
            }
            return item(l, Item_Kind.word, text, from)
        }
        internal.scan.step_char(sc)
        var d: internal.diag.Diagnostic = diagnostic(l,"unexpected-character",
            "unexpected `" + internal.scan.slice(sc, from.byte) + "`",
            internal.scan.span_from(sc, from))
        d.fixes.append(internal.scan.fix("delete it", d.span, ""))
        internal.scan.report(sc, d)
    }
    return item(l, Item_Kind.eof, "", internal.scan.mark(sc))
}

private func next(l: Loader) -> Item {
    let held: Item? = l.ahead
    if held != nil {
        l.ahead = nil
        return held.get()
    }
    return scan(l)
}

private func peek(l: Loader) -> Item {
    let held: Item? = l.ahead
    if held != nil {
        return held.get()
    }
    let fresh: Item = scan(l)
    l.ahead = fresh
    return fresh
}

private func skip_rule(l: Loader) {
    while true {
        let it: Item = next(l)
        if it.kind == Item_Kind.end_rule or it.kind == Item_Kind.eof {
            return
        }
    }
}

private func names_of(schema: internal.lex.spec.Rule_Schema) -> List[string] {
    var names: List[string] = new[List[string]]()
    for n in schema.options {
        names.append(n)
    }
    for n in schema.flags {
        names.append(n)
    }
    return names
}

private func unknown_word(l: Loader, it: Item, what: string,
                          candidates: List[string]) {
    var d: internal.diag.Diagnostic = diagnostic(l,"unknown-" + what,
        "unknown " + what + " `" + it.text + "`", it.span)
    let guess: string? = internal.diag.closest_match(it.text, candidates)
    if guess != nil {
        d.fixes.append(internal.scan.fix("did you mean `" + guess.get() + "`?",
                                     it.span, guess.get()))
    }
    internal.scan.report(l.sc, d)
}

private func value_of(l: Loader, it: Item) -> internal.lex.spec.Value {
    var kind: internal.lex.spec.Value_Kind = internal.lex.spec.Value_Kind.word
    if it.kind == Item_Kind.text {
        kind = internal.lex.spec.Value_Kind.text
    }
    elif it.kind == Item_Kind.class {
        kind = internal.lex.spec.Value_Kind.class
    }
    if it.kind == Item_Kind.text and peek(l).kind == Item_Kind.dots {
        let dots: Item = next(l)
        let close: Item = next(l)
        if close.kind != Item_Kind.text {
            internal.scan.report(l.sc, diagnostic(l,"expected-close",
                "`..` must be followed by a quoted closing delimiter",
                close.span))
            l.ahead = close
            return (kind = kind, text = it.text, close = "", span = it.span)
        }
        return (kind = internal.lex.spec.Value_Kind.pair, text = it.text,
                close = close.text,
                span = internal.scan.join_spans(it.span, close.span))
    }
    return (kind = kind, text = it.text, close = "", span = it.span)
}

private func parse_rule(l: Loader, head: Item) {
    let schema_found: internal.lex.spec.Rule_Schema? = l.schemas[head.text]
    if schema_found == nil {
        var kinds: List[string] = new[List[string]]()
        for let entry in l.schemas {
            kinds.append(entry.key)
        }
        unknown_word(l, head, "rule", kinds)
        skip_rule(l)
        return
    }
    let schema: internal.lex.spec.Rule_Schema = schema_found.get()
    var rule: internal.lex.spec.Rule = new[internal.lex.spec.Rule](head.text, head.span)
    if schema.named {
        let name: Item = next(l)
        if name.kind != Item_Kind.set_name {
            internal.scan.report(l.sc, diagnostic(l,"expected-set-name",
                "`" + head.text + "` defines a named set: write `" +
                head.text + " name: ...`", name.span))
            l.ahead = name
        }
        else {
            rule.name = name.text
        }
    }
    let names: List[string] = names_of(schema)
    var current: uint? = nil
    var outputs: bool = false
    while true {
        let it: Item = next(l)
        if it.kind == Item_Kind.end_rule or it.kind == Item_Kind.eof {
            break
        }
        if it.kind == Item_Kind.arrow {
            outputs = true
            current = nil
            continue
        }
        if it.kind == Item_Kind.dots or it.kind == Item_Kind.set_name {
            internal.scan.report(l.sc, diagnostic(l,"unexpected-token",
                "unexpected `" + it.text + "`", it.span))
            continue
        }
        if it.kind == Item_Kind.word and internal.lex.spec.listed(schema.flags,
                                                         it.text) {
            rule.flags.append(it.text)
            current = nil
            outputs = false
            continue
        }
        if it.kind == Item_Kind.word and internal.lex.spec.listed(schema.options,
                                                         it.text) {
            rule.options.append((name = it.text,
                                 values = new[List[internal.lex.spec.Value]](),
                                 span = it.span))
            current = rule.options.len() - 1
            outputs = false
            continue
        }
        let value: internal.lex.spec.Value = value_of(l, it)
        if outputs {
            if value.kind != internal.lex.spec.Value_Kind.class {
                internal.scan.report(l.sc, diagnostic(l,"expected-class",
                    "outputs after `->` are token classes like `%NAME`",
                    value.span))
                continue
            }
            rule.outputs.append(value)
            continue
        }
        let slot: uint? = current
        if slot != nil {
            rule.options[slot.get()].values.append(value)
            continue
        }
        if rule.options.len() == 0 and rule.head.len() < schema.head {
            rule.head.append(value)
            continue
        }
        if it.kind == Item_Kind.word {
            unknown_word(l, it, "option", names)
        }
        else {
            internal.scan.report(l.sc, diagnostic(l,"unexpected-value",
                "`" + head.text + "` takes no value here", value.span))
        }
    }
    check_rule(l, schema, rule)
    let at: uint = l.spec.rules.len()
    l.spec.rules.append(rule)
    if !schema.named or rule.name == "" {
        return
    }
    let key: string = internal.lex.spec.set_key(rule.kind, rule.name)
    let first: uint? = l.spec.sets[key]
    if first != nil {
        var d: internal.diag.Diagnostic = diagnostic(l,"duplicate-set",
            "`" + rule.kind + " " + rule.name + ":` is already defined",
            rule.span)
        d.related.append((message = "first defined here",
                          span = l.spec.rules[first.get()].span))
        internal.scan.report(l.sc, d)
        return
    }
    l.spec.sets[key] = at
}

private const optional_heads: Array[string] = ["string", "suffixes"]

private func check_rule(l: Loader, schema: internal.lex.spec.Rule_Schema,
                        rule: internal.lex.spec.Rule) {
    if schema.head > 0 and !internal.lex.spec.listed(optional_heads, rule.kind)
        and rule.head.len() == 0 {
        internal.scan.report(l.sc, diagnostic(l,"missing-value",
            "`" + rule.kind + "` needs a delimiter or value first", rule.span))
    }
    if rule.outputs.len() > schema.outputs {
        internal.scan.report(l.sc, diagnostic(l,"too-many-outputs",
            "`" + rule.kind + "` produces at most " +
            decimal(schema.outputs) + " token class(es)", rule.span))
    }
    for let option in rule.options {
        if option.values.len() == 0 {
            internal.scan.report(l.sc, diagnostic(l,"missing-value",
                "`" + option.name + "` needs a value", option.span))
        }
    }
}

private const set_references: Array[string] = ["escapes", "suffixes",
    "profile", "header"]

private func check_references(l: Loader) {
    for let rule in l.spec.rules {
        for let option in rule.options {
            if !internal.lex.spec.listed(set_references, option.name) {
                continue
            }
            let kind: string = option.name
            for let value in option.values {
                if internal.lex.spec.find_set(l.spec, kind, value.text) != nil {
                    continue
                }
                var known: List[string] = new[List[string]]()
                for let other in l.spec.rules {
                    if other.kind == kind and other.name != "" {
                        known.append(other.name)
                    }
                }
                var d: internal.diag.Diagnostic = diagnostic(l, "undefined-set",
                    "no `" + kind + "` set is named `" + value.text + "`",
                    value.span)
                let guess: string? = internal.diag.closest_match(value.text, known)
                if guess != nil {
                    d.fixes.append(internal.scan.fix(
                        "did you mean `" + guess.get() + "`?", value.span,
                        guess.get()))
                }
                internal.scan.report(l.sc, d)
            }
        }
    }
}

func load(text: string, source_name: string = "<string>")
    -> internal.lex.spec.Spec fail: List[internal.diag.Diagnostic] {
    var l: Loader = new[Loader](text, source_name)
    skip_to_content(l)
    while !l.sc.halted {
        let head: Item = next(l)
        if head.kind == Item_Kind.eof {
            break
        }
        if head.kind == Item_Kind.end_rule {
            continue
        }
        if head.kind != Item_Kind.word {
            internal.scan.report(l.sc, diagnostic(l,"expected-rule",
                "expected a rule name such as `comment` or `string`",
                head.span))
            skip_rule(l)
            continue
        }
        parse_rule(l, head)
    }
    if !l.sc.halted {
        check_references(l)
    }
    if l.sc.diags.len() > 0 {
        var renamed: List[internal.diag.Diagnostic] = new[List[internal.diag.Diagnostic]]()
        for let d in l.sc.diags {
            var moved: internal.diag.Diagnostic = d
            if byte_len(moved.code) > 5
                and byte_slice(moved.code, 0, 5) == "ebnf/" {
                moved.code = "lex/" + byte_slice(moved.code, 5,
                                                 byte_len(moved.code))
            }
            renamed.append(moved)
        }
        fail internal.diag.sorted_by_position(renamed)
    }
    return l.spec
}
