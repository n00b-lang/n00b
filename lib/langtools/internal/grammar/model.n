import unicode
import internal.diag
import internal.scan

type Token_Id = u128

const identifier_token_id: u128 = 0x110000

enum Token_Policy { normal = 0, trivia, elastic, trailing }

func is_trivia(policy: Token_Policy) -> bool {
    return policy == Token_Policy.trivia or policy == Token_Policy.trailing
}

record Token_Class {
    name:   string
    id:     Token_Id
    policy: Token_Policy
    decl:   internal.diag.Span
}

func __init(modify self: Token_Class, name: string, decl: internal.diag.Span) {
    self.name = name
    self.id = token_id(0)
    self.policy = Token_Policy.normal
    self.decl = decl
}

enum Quant { one = 0, opt, star, plus }

variant Atom {
    rule:    uint
    class:   uint
    literal: uint
    group:   List[Alt]
}

record Item {
    atom:  Atom
    quant: Quant
    span:  internal.diag.Span
}

record Alt {
    items: List[Item]
}

record Rule {
    name: string
    alts: List[Alt]
    defs: List[internal.diag.Span]
}

func __init(modify self: Rule, name: string) {
    self.name = name
    self.alts = []
    self.defs = []
}

record Literal {
    text:       string
    id:         Token_Id
    hard:       bool
    identifier: bool
    first_use:  internal.diag.Span
}

func __init(modify self: Literal, text: string, hard: bool,
            first_use: internal.diag.Span) {
    self.text = text
    self.id = literal_token_id(text)
    self.hard = hard
    self.identifier = is_identifier_shaped(text)
    self.first_use = first_use
}

record Grammar {
    source_name:   string
    rules:         List[Rule]
    rule_index:    Dict[string, uint]
    classes:       List[Token_Class]
    class_index:   Dict[string, uint]
    literals:      List[Literal]
    literal_index: Dict[string, uint]
    start:         uint
    identifier:    uint
}

func __init(modify self: Grammar, source_name: string) {
    self.source_name = source_name
    self.rules = []
    self.rule_index = new[Dict[string, uint]]()
    self.classes = []
    self.class_index = new[Dict[string, uint]]()
    self.literals = []
    self.literal_index = new[Dict[string, uint]]()
    self.start = 0
    self.identifier = 0
}

func token_id(raw: u128) -> Token_Id {
    return cast[Token_Id] raw
}

func raw_token_id(id: Token_Id) -> u128 {
    return cast[u128] id
}

func __equal(view left: Token_Id, view right: Token_Id) -> bool {
    return raw_token_id(left) == raw_token_id(right)
}

func class_token_id(declared: uint) -> Token_Id {
    return token_id(identifier_token_id + 1 + cast[u128] declared)
}

func literal_token_id(spelling: string) -> Token_Id {
    let plain: string = text(spelling)
    let n: uint = byte_len(plain)
    if n > 0 and n <= 4 and len(plain) == 1 {
        return token_id(cast[u128] internal.scan.decode_at(plain, 0))
    }
    return token_id(plain.hash())
}

func is_identifier_start(c: char) -> bool {
    return c == '_' or unicode.is_xid_start(c)
}

func is_identifier_continue(c: char) -> bool {
    return unicode.is_xid_continue(c)
}

func is_identifier_shaped(spelling: string) -> bool {
    let n: uint = byte_len(spelling)
    var at: uint = 0
    while at < n {
        let c: char = internal.scan.decode_at(spelling, at)
        if at == 0 and !is_identifier_start(c) {
            return false
        }
        if at > 0 and !is_identifier_continue(c) {
            return false
        }
        at += internal.scan.char_width(spelling, at)
    }
    return n > 0
}

func is_soft(lit: Literal) -> bool {
    return lit.identifier and !lit.hard
}

func find_rule(g: Grammar, name: string) -> Rule? {
    let at: uint? = g.rule_index[name]
    if at == nil {
        return nil
    }
    return g.rules[at]
}

func find_class(g: Grammar, name: string) -> Token_Class? {
    let at: uint? = g.class_index[name]
    if at == nil {
        return nil
    }
    return g.classes[at]
}

func find_literal(g: Grammar, spelling: string) -> Literal? {
    let at: uint? = g.literal_index[spelling]
    if at == nil {
        return nil
    }
    return g.literals[at]
}

func start_rule(g: Grammar) -> Rule {
    return g.rules[g.start]
}

func identifier_class(g: Grammar) -> Token_Class {
    return g.classes[g.identifier]
}

func is_hard_keyword(g: Grammar, spelling: string) -> bool {
    let lit: Literal? = find_literal(g, spelling)
    return lit != nil and lit.hard and lit.identifier
}

func is_soft_keyword(g: Grammar, spelling: string) -> bool {
    let lit: Literal? = find_literal(g, spelling)
    return lit != nil and is_soft(lit)
}
