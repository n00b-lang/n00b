record Border_Theme {
    horizontal:  char
    vertical:    char
    upper_left:  char
    upper_right: char
    lower_left:  char
    lower_right: char
    cross:       char
    top_t:       char
    bottom_t:    char
    left_t:      char
    right_t:     char
}

flagset Border_Set {
    top, bottom, left, right, interior_h, interior_v,
    sides = left + right,
    all = top + bottom + left + right + interior_h + interior_v,
    none = nil
}

const border_plain: Border_Theme = (
    horizontal  = cast[char] 0x2500,
    vertical    = cast[char] 0x2502,
    upper_left  = cast[char] 0x250c,
    upper_right = cast[char] 0x2510,
    lower_left  = cast[char] 0x2514,
    lower_right = cast[char] 0x2518,
    cross       = cast[char] 0x253c,
    top_t       = cast[char] 0x252c,
    bottom_t    = cast[char] 0x2534,
    left_t      = cast[char] 0x251c,
    right_t     = cast[char] 0x2524)

