import sys.abi

enum Palette_Ix {
    background = 0,
    surface = 1,
    surface_light = 2,
    surface_dark = 3,
    text_primary = 4,
    text_secondary = 5,
    text_disabled = 6,
    text_inverse = 7,
    primary = 8,
    primary_light = 9,
    primary_dark = 10,
    secondary = 11,
    accent = 12,
    success = 13,
    warning = 14,
    error_tone = 15,
    info = 16,
    focus = 17,
    hover = 18,
    active = 19,
    selected = 20,
    border = 21,
    border_light = 22,
    border_dark = 23,
    selection_bg = 24,
    selection_fg = 25,
    cursor = 26,
    scrollbar_track = 27,
    scrollbar_thumb = 28,
    scrollbar_thumb_hover = 29,
    placeholder = 30,
    palette_size = 31
}

record Style_Binding {
    name:  string
    style: Text_Style
    fg_ix: i8
    bg_ix: i8
}

record Theme {
    name:        string
    description: string
    palette:     Array[Color][31]
    styles:      List[Style_Binding]?
    roles:       List[Style_Binding]?
}

