        text_case = Text_Case.none, font_hint = Font_Hint.default,
        font_index = nil, fg_palette_ix = nil, bg_palette_ix = nil,
        fg_rgb = nil, bg_rgb = nil, font_size = nil
    ), fg_ix = cast[i8] Palette_Ix.success, bg_ix = -1),
    (name = "@muted", style = (
        bold = nil, italic = nil, underline = nil, double_underline = nil,
        strikethrough = nil, reverse = nil, dim = true, blink = nil,
        text_case = Text_Case.none, font_hint = Font_Hint.default,
        font_index = nil, fg_palette_ix = nil, bg_palette_ix = nil,
        fg_rgb = nil, bg_rgb = nil, font_size = nil
    ), fg_ix = cast[i8] Palette_Ix.text_disabled, bg_ix = -1),
    (name = "@link", style = (
        bold = nil, italic = nil, underline = true, double_underline = nil,
        strikethrough = nil, reverse = nil, dim = nil, blink = nil,
        text_case = Text_Case.none, font_hint = Font_Hint.default,
        font_index = nil, fg_palette_ix = nil, bg_palette_ix = nil,
        fg_rgb = nil, bg_rgb = nil, font_size = nil
    ), fg_ix = cast[i8] Palette_Ix.info, bg_ix = -1),
    (name = "@label", style = (
        bold = true, italic = nil, underline = nil, double_underline = nil,
        strikethrough = nil, reverse = nil, dim = nil, blink = nil,
        text_case = Text_Case.none, font_hint = Font_Hint.default,
        font_index = nil, fg_palette_ix = nil, bg_palette_ix = nil,
        fg_rgb = nil, bg_rgb = nil, font_size = nil
    ), fg_ix = cast[i8] Palette_Ix.text_secondary, bg_ix = -1),
    (name = "@button", style = (
        bold = true, italic = nil, underline = nil, double_underline = nil,
        strikethrough = nil, reverse = nil, dim = nil, blink = nil,
        text_case = Text_Case.none, font_hint = Font_Hint.default,
        font_index = nil, fg_palette_ix = nil, bg_palette_ix = nil,
        fg_rgb = nil, bg_rgb = nil, font_size = nil
    ), fg_ix = cast[i8] Palette_Ix.text_inverse,
    bg_ix = cast[i8] Palette_Ix.primary),
    (name = "@input", style = (
        bold = nil, italic = nil, underline = true, double_underline = nil,
        strikethrough = nil, reverse = nil, dim = nil, blink = nil,
        text_case = Text_Case.none, font_hint = Font_Hint.default,
        font_index = nil, fg_palette_ix = nil, bg_palette_ix = nil,
        fg_rgb = nil, bg_rgb = nil, font_size = nil
    ), fg_ix = cast[i8] Palette_Ix.text_primary,
    bg_ix = cast[i8] Palette_Ix.surface_light)
]

private var registered_themes: Dict[string, Ref[Theme]] = {:}
private var themes_lock: Atomic[u32] = 0
private var current: Atomic[Ref[Theme]?] = nil

private const themes_writer_bit: u32 = 0x8000_0000

private func themes_spin_wait(modify attempt: u32) {
    if attempt < 64 {
        __os_cpu_relax()
        attempt += 1
        return
    }
    __gc_enter_blocking()
    __os_thread_yield()
    __gc_leave_blocking()
    attempt = 0
}

private func themes_read_lock() {
    var attempt: u32 = 0
    while true {
        let seen: u32 = themes_lock
        if seen & themes_writer_bit == 0 and
            __atomic_compare_exchange(ref themes_lock, seen, seen + 1) {
            return
        }
        themes_spin_wait(attempt)
    }
}

private func themes_read_unlock() {
    __atomic_fetch_sub(ref themes_lock, 1)
}

private func themes_write_lock() {
    var attempt: u32 = 0
    while !__atomic_compare_exchange(ref themes_lock, 0, themes_writer_bit) {
        themes_spin_wait(attempt)
    }
}

private func themes_write_unlock() {
    themes_lock = 0
}

private func name_eq(a: string, b: string) -> bool {
    let n: u64 = byte_len(a)
    if n != byte_len(b) {
        return false
    }
    var i: u64 = 0
    while i < n {
        if byte_at(a, i) != byte_at(b, i) {
            return false
        }
        i += 1
    }
    return true
}

func install(theme: Ref[Theme]) {
    themes_write_lock()
    registered_themes[theme.name] = theme
    themes_write_unlock()
}

func theme_lookup(name: string) -> Ref[Theme]? {
    var hit: Ref[Theme]? = nil
    themes_read_lock()
    hit = registered_themes[name]
    themes_read_unlock()
    if hit != nil {
        return hit
    }
    var i: uint = 0
    while i < builtin_themes.len() {
        if name_eq(builtin_themes[i].name, name) {
            return builtin_themes[i]
        }
        i += 1
    }
    return nil
}

func theme_current() -> Ref[Theme] {
    let pinned: Ref[Theme]? = current
    if pinned != nil {
        return pinned.get()
    }
    let fallback: Ref[Theme]? = theme_lookup("n00b-classic")
    if fallback != nil {
        return fallback.get()
    }
    return builtin_themes[0]
}

func theme_set_current(name: string) -> bool {
    let hit: Ref[Theme]? = theme_lookup(name)
    if hit == nil {
        return false
    }
    current = hit.get()
    return true
}

func theme_builtin_count() -> uint {
    return builtin_themes.len()
}

func theme_builtin(i: uint) -> Ref[Theme] {
    if i >= builtin_themes.len() {
        return builtin_themes[0]
    }
    return builtin_themes[i]
}

private func theme_is_builtin(theme: Ref[Theme]) -> bool {
    var i: uint = 0
    while i < builtin_themes.len() {
        if builtin_themes[i] == theme {
            return true
        }
        i += 1
    }
    return false
}

func palette(self: Theme, ix: Palette_Ix) -> Color? {
    let at: int = cast[int] ix
    if at < 0 or at >= cast[int] Palette_Ix.palette_size {
        return nil
    }
    return self.palette[cast[uint] at]
}

private func binding_style(b: Style_Binding) -> Text_Style {
    var s: Text_Style = b.style
    if b.fg_ix >= 0 {
        s.fg_palette_ix = b.fg_ix
    }
    if b.bg_ix >= 0 {
        s.bg_palette_ix = b.bg_ix
    }
    return s
}

private func clone_bindings(src: List[Style_Binding], n: uint,
                            extra: uint) -> Array[Style_Binding] {
    var out: Array[Style_Binding] =
        new[Array[Style_Binding]](cast[int](n + extra))
    var i: uint = 0
    while i < n {
        out[i] = src[cast[int] i]
        i += 1
    }
    return out
}

private func put_binding(modify tbl: List[Style_Binding]?, is_role: bool,
                         name: string, style: Text_Style) {
    var src: List[Style_Binding]
    if tbl != nil {
        src = tbl.get()
    }
    elif is_role {
        src = sys.abi.list_with_length(default_roles, default_roles.len())
    }
    else {
        src = sys.abi.list_with_length(default_styles, default_styles.len())
    }
    let src_n: uint = src.len()
    var at: uint = src_n
    var i: uint = 0
    while i < src_n {
        if name_eq(src[cast[int] i].name, name) {
            at = i
            break
        }
        i += 1
    }
    let total: uint = if at == src_n { = src_n + 1 } else { = src_n }
    var extra: uint = 0
    if at == src_n {
        extra = 1
    }
    var out: Array[Style_Binding] = clone_bindings(src, src_n, extra)
    out[at] = (name = name, style = style, fg_ix = -1, bg_ix = -1)
    tbl = sys.abi.list_with_length(out, total)
}

func copy(self: Theme, name: string) -> Ref[Theme] {
    var out: Theme = self
    out.name = name
    let base_styles: List[Style_Binding]? = self.styles
    let base_roles: List[Style_Binding]? = self.roles
    var styles: List[Style_Binding]
    if base_styles != nil {
        styles = base_styles.get()
    }
    else {
        styles = sys.abi.list_with_length(default_styles,
                                          default_styles.len())
    }
    let ns: uint = styles.len()
    var roles: List[Style_Binding]
    if base_roles != nil {
        roles = base_roles.get()
    }
    else {
        roles = sys.abi.list_with_length(default_roles, default_roles.len())
    }
    let nr: uint = roles.len()
    out.styles = sys.abi.list_with_length(clone_bindings(styles, ns, 0), ns)
    out.roles = sys.abi.list_with_length(clone_bindings(roles, nr, 0), nr)
    return ref out
}

func set_role(self: Ref[Theme], role: string, style: Text_Style) {
    if theme_is_builtin(self) {
        panic("builtin themes are immutable; copy the theme first")
    }
    put_binding(self.roles, true, role, style)
}

func set_style(self: Ref[Theme], name: string, style: Text_Style) {
    if theme_is_builtin(self) {
        panic("builtin themes are immutable; copy the theme first")
    }
    put_binding(self.styles, false, name, style)
}

func style_for_tag(self: Theme, tag: string) -> Text_Style {
    let intrinsic: Text_Style = intrinsic_tag_style(tag)
    if !is_empty(intrinsic) {
        return intrinsic
    }
    if byte_len(tag) == 0 {
        return (bold = nil, italic = nil, underline = nil,
                double_underline = nil, strikethrough = nil, reverse = nil,
                dim = nil, blink = nil, text_case = Text_Case.none,
                font_hint = Font_Hint.default, font_index = nil,
                fg_palette_ix = nil, bg_palette_ix = nil, fg_rgb = nil,
                bg_rgb = nil, font_size = nil)
    }
    let is_role: bool = byte_at(tag, 0) == 0x40
    let own: List[Style_Binding]? = if is_role { = self.roles }
                                    else { = self.styles }
    var tbl: List[Style_Binding]
    if own != nil {
        tbl = own.get()
    }
    elif is_role {
        tbl = sys.abi.list_with_length(default_roles, default_roles.len())
    }
    else {
        tbl = sys.abi.list_with_length(default_styles, default_styles.len())
    }
    let n: uint = tbl.len()
    var i: uint = 0
    while i < n {
        if name_eq(tbl[cast[int] i].name, tag) {
            return binding_style(tbl[cast[int] i])
        }
        i += 1
    }
    return (bold = nil, italic = nil, underline = nil, double_underline = nil,
            strikethrough = nil, reverse = nil, dim = nil, blink = nil,
            text_case = Text_Case.none, font_hint = Font_Hint.default,
            font_index = nil, fg_palette_ix = nil, bg_palette_ix = nil,
            fg_rgb = nil, bg_rgb = nil, font_size = nil)
}
