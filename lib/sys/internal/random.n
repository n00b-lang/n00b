import internal.errno
import internal.os

func fill(modify buffer: Array[u8]) fail: internal.errno.Errno {
    internal.os.random_bytes(buffer, 0, __array_length(buffer))!
}

func fill(modify value: 'T) fail: internal.errno.Errno where 'T : Integer {
    var bytes: Array[u8] = new[Array[u8]](16)
    fill(bytes)!
    var bits: u128 = 0
    var at: uint = 0
    while at < 16 {
        bits = (bits << 8) | cast[u128](bytes[at])
        at += 1
    }
    value = value.from_bits(bits)
}
