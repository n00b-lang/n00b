const may_fail:            u64 = 0x1
const may_trap:            u64 = 0x2
const may_allocate:        u64 = 0x4
const may_block:           u64 = 0x8
const diverges:            u64 = 0x10
const calls_unknown:       u64 = 0x20
const may_io:              u64 = 0x40
const no_return:           u64 = 0x80
const may_collect:         u64 = 0x100
const allocates_direct:    u64 = 0x200
const unbounded_recursion: u64 = 0x400
const calls_finalizers:    u64 = 0x800
const starts_threads:      u64 = 0x1000
const calls_callbacks:     u64 = 0x2000
const reinterprets:        u64 = 0x4000
const traps_explicit:      u64 = 0x10000
const traps_bounds:        u64 = 0x20000
const traps_unwrap:        u64 = 0x40000
const traps_arithmetic:    u64 = 0x80000
const reads_nonlocal:      u64 = 0x1000000
const writes_nonlocal:     u64 = 0x2000000

func reads_parameter(index: u64) -> u64 {
    return cast[u64](1) << (32 + index)
}

func writes_parameter(index: u64) -> u64 {
    return cast[u64](1) << (48 + index)
}

func has_effect(effects: u64, effect: u64) -> bool {
    return effects & effect != 0
}
