import internal.os.exit
import internal.os.process

func count() -> uint {
    return internal.os.process.env_count()
}

func at(index: uint) -> string? {
    return internal.os.process.env_at(index)
}

func args() -> List[string] {
    var out: List[string] = []
    for i from 0 until internal.os.process.arg_count() {
        let entry: string? = internal.os.process.arg_at(i)
        if entry != nil {
            out.append(entry)
        }
    }
    return out
}

func exit(code: int) {
    internal.os.exit.exit(cast[i32](code))
}
