import internal.os

# The number of `NAME=value` environment entries.
func count() -> uint {
    return internal.os.env_count()
}

# Environment entry `index`, as `NAME=value`, or nil past the last.
func at(index: uint) -> string? {
    return internal.os.env_at(index)
}

# The command-line arguments, the program's name first.
func args() -> List[string] {
    var out: List[string] = []
    for i from 0 until internal.os.arg_count() {
        let entry: string? = internal.os.arg_at(i)
        if entry != nil {
            out.append(entry)
        }
    }
    return out
}

func exit(code: int) {
    internal.os.exit(cast[i32](code))
}
