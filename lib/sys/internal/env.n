func count() -> uint {
    return __os_env_count()
}

func at(index: uint) -> string? {
    let entry: Ref[byte]? = __os_env_at(index)
    if entry == nil {
        return nil
    }
    let base: Ref[byte] = entry.get()
    var length: uint = 0
    while true {
        let b: byte = __gc_byte_offset(base, cast[int] length)
        if b == 0 {
            break
        }
        length += 1
    }
    var bytes: Array[u8] = new[Array[u8]](cast[int] length)
    var i: uint = 0
    while i < length {
        let b: byte = __gc_byte_offset(base, cast[int] i)
        bytes[i] = cast[u8] b
        i += 1
    }
    return from_raw(bytes, cast[int] length, copy = false)
}
