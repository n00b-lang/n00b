func count() -> uint {
    return __os_env_count()
}

private func c_string(base: Ref[byte]) -> string {
    var length: uint = 0
    while true {
        let b: byte = __gc_byte_offset(base, cast[int] length).__value
        if b == 0 {
            break
        }
        length += 1
    }
    var bytes: Array[u8] = new[Array[u8]](cast[int] length)
    var i: uint = 0
    while i < length {
        let b: byte = __gc_byte_offset(base, cast[int] i).__value
        bytes[i] = cast[u8] b
        i += 1
    }
    return from_raw(ref bytes, cast[int] length, copy = false)
}

func at(index: uint) -> string? {
    let entry: Ref[byte]? = __os_env_at(index)
    if entry == nil {
        return nil
    }
    return c_string(entry.get())
}

func args() -> List[string] {
    var out: List[string] = []
    for i from 0 until __os_arg_count() {
        let entry: Ref[byte]? = __os_arg_at(i)
        if entry != nil {
            out.append(c_string(entry.get()))
        }
    }
    return out
}

func exit(code: int) {
    __os_exit(code)
}
