enum Type_Kind {
    nil_type = 0, primitive_type = 1, record_type, variant_type, enum_type,
    flagset_type,reference_type, option_type,array_type, view_type,
    string_type, box_type, callback_type, function_type, trait_type,
    wrapper_type, union_type,atomic_type, variable_type,named_type,
    tuple_type, foreign_type
}

enum Tag_Kind {
    invalid = 0, direct_bits = 1, pointer_null = 2, bitptr_depth = 3
}

enum Storage_Kind {
    read_only = 1, writable = 2, tls = 3
}

public const type_flag_bits: u32 = 1 << 4

record Range layout(c) {
    first: u32
    count: u32
}

record Array_Descriptor_Header layout(c) {
    total_count:   u64
    rank:          u32
    flat_rank:     u32
    flags:         u32
    reserved_zero: u32
}

record Array_Value layout(c) {
    data:       Ref[byte]?
    descriptor: Ref[Array_Descriptor_Header]?
}

record String_Bits layout(c) {
    low:  u64
    high: u64
}

record Box_Value layout(c) {
    extent:     u16
    stride:     u16
    type_field: u32
    payload:    Ref[byte]?
}

record Callback_Value layout(c) {
    handler_function_index: u32
    callback_type_index:    u32
    environment:            Ref[byte]?
}

record Type_Record layout(c) {
    typehash:                         u64
    size_bits:                        u64
    canonical_name:                   String_Bits
    kind:                             u32
    flags:                            u32
    alignment_bytes:                  u32
    layout_index:                     u32
    owner_module_index:               u32
    tracing_index:                    u32
    components:                       Range
    fields_or_arms:                   Range
    constraints:                      Range
    semantic_width_bits:              u32
    unpacked_storage_bits:            u32
    call_signature_index:             u32
    typevar_owner_scope_index:        u32
    typevar_ordinal:                  u32
    specialization_start_ix:          u32
    specialization_end_ix:            u32
    typevar_import_requirement_index: u32
    named_constructor:                String_Bits
    named_arguments:                  Range
    finalizer_function_index:         u32
}

record Field_Record layout(c) {
    name:                       String_Bits
    parent_type_index:          u32
    child_type_index:           u32
    declaration_ordinal:        u32
    visibility:                 u32
    symbol_index:               u32
    reserved_zero:              u32
    logical_bit_offset:         u64
    packed_runs:                Range
    physical_runs:              Range
    inline_element_type_index:  u32
    inline_reserved_zero:       u32
    inline_element_count:       u64
    inline_element_stride_bits: u64
}

record Trace_Record layout(c) {
    type_index:          u32
    reserved_zero:       u32
    child_trace_index:   u32
    tag_extractor_index: u32
    fixed_children:      Range
    arms:                Range
    option_bit_offset:   u64
}

record Trace_Child_Record layout(c) {
    byte_offset:        u64
    child_type_index:   u32
    extent_form:        u32
    repeat_count:       u64
    stride_bits:        u64
    count_field_offset: u64
    count_field_bits:   u32
    reserved_zero:      u32
    sentinel:           u64
}

record Trace_Arm_Record layout(c) {
    tag_value:         u32
    child_trace_index: u32
    children:          Range
}

record Tag_Extractor_Record layout(c) {
    unit_byte_offset: u64
    mask:             u64
    unit_width_bits:  u32
    lsb_position:     u32
    tag_width_bits:   u32
    kind:             u32
}

record Frame_Layout_Record layout(c) {
    function_index:          u32
    shadow_frame_type_index: u32
    pointer_bitmap_bytes:    Range
    frame_byte_extent:       u64
}

record Native_Frame_Record layout(c) {
    function:        Ref[byte]?
    sentinel_offset: i32
    root_count:      u32
    first_root:      u32
    reserved_zero:   u32
}

public const frame_sentinel:    u32  = 0x4230304e
public const frame_root_offset: uint = 8

record Storage_Record layout(c) {
    module_index:         u32
    symbol_index:         u32
    type_index:           u32
    segment_kind:         u32
    segment_index:        u32
    instance_shape_index: u32
    byte_offset:          u64
    byte_length:          u64
    tls_relocations:      Range
}

record Symbol_Record layout(c) {
    name:                       String_Bits
    kind:                       u32
    type_index:                 u32
    module_index:               u32
    scope_index:                u32
    visibility:                 u32
    flags:                      u32
    binding_kind:               u32
    storage_duration:           u32
    storage_class_name:         String_Bits
    declaration_location_index: u32
    native_binding_index:       u32
    definitions:                Range
    uses:                       Range
}

record Module_Record layout(c) {
    full_path:            String_Bits
    package_index:        u32
    scc_index:            u32
    initializer:          u32
    imports:              Range
    static_storage:       Range
    tls_storage:          Range
    runtime_config_index: u32
    source_file_index:    u32
}

record Function_Record layout(c) {
    name:                String_Bits
    module_index:        u32
    scope_index:         u32
    symbol_index:        u32
    success_type_index:  u32
    failure_type_index:  u32
    parameters:          Range
    keywords:            Range
    constraints:         Range
    code_ranges:         Range
    frame_layouts:       Range
    flags:               u32
    variadic_type_index: u32
    reserved_zero:       u32
    valid_keyword_bits:  u64
}

record Baked_Node_Record layout(c) {
    module_index:  u32
    type_index:    u32
    segment_kind:  u32
    segment_index: u32
    flags:         u32
    reserved_zero: u32
    byte_offset:   u64
    byte_length:   u64
}

public const type_flag_type_index: u32 = 1 << 6
public const table_type:          u32 = 4
public const table_function:      u32 = 14
public const patch_index:         u32 = 1
public const patch_box_type:      u32 = 2
public const binding_const:       u32 = 3
public const baked_immutable:     u32 = 1
public const baked_array_backing: u32 = 2
public const baked_foreign:       u32 = 4
public const table_native:        u32 = 19
public const type_flag_opaque:    u32 = 1 << 1
public const extent_count_field:  u32 = 1
public const extent_sentinel:     u32 = 2

func type_at(index: u32) -> Ref[Type_Record]? {
    return __abi_type(index)
}

func type_for(descriptor: typespec) -> Ref[Type_Record]? {
    return __abi_type_for(descriptor)
}

func field_at(index: u32) -> Ref[Field_Record]? {
    return __abi_field(index)
}

func trace_at(index: u32) -> Ref[Trace_Record]? {
    return __abi_trace(index)
}

func trace_child_at(index: u32) -> Ref[Trace_Child_Record]? {
    return __abi_trace_child(index)
}

func trace_arm_at(index: u32) -> Ref[Trace_Arm_Record]? {
    return __abi_trace_arm(index)
}

func tag_extractor_at(index: u32) -> Ref[Tag_Extractor_Record]? {
    return __abi_tag_extractor(index)
}

func frame_layout_at(index: u32) -> Ref[Frame_Layout_Record]? {
    return __abi_frame_layout(index)
}

func native_frame_at(fp: Ref[byte], low: Ref[byte],
                            high: Ref[byte]) -> Ref[Native_Frame_Record]? {
    return __abi_native_frame_at(fp, low, high)
}

func native_frame_root_offset(frame: Ref[Native_Frame_Record],
                                     ordinal: u32) -> i32 {
    return __abi_native_frame_root_offset(frame, ordinal)
}

func storage_count() -> u32 {
    return __abi_storage_count()
}

func storage_at(index: u32) -> Ref[Storage_Record]? {
    return __abi_storage(index)
}

func symbol_at(index: u32) -> Ref[Symbol_Record]? {
    return __abi_symbol(index)
}

func module_at(index: u32) -> Ref[Module_Record]? {
    return __abi_module(index)
}

func function_at(index: u32) -> Ref[Function_Record]? {
    return __abi_function(index)
}

func baked_node_count() -> u32 {
    return __abi_baked_node_count()
}

func baked_node_at(index: u32) -> Ref[Baked_Node_Record]? {
    return __abi_baked_node(index)
}

func baked_node_address(index: u32) -> Ref[byte]? {
    return __abi_baked_node_address(index)
}

func baked_address(address: uint) -> bool {
    var index: u32 = 1
    while index < baked_node_count() {
        let row: Ref[Baked_Node_Record]? = baked_node_at(index)
        let base: Ref[byte]? = baked_node_address(index)
        if row != nil and base != nil {
            let start: uint = __abi_ref_address(base.get())
            if address >= start and address < start + cast[uint]row.get().byte_length {
                return true
            }
        }
        index += 1
    }
    return false
}

func storage_address(index: u32) -> Ref[byte]? {
    return __abi_storage_address(index)
}

func string_backing_at(address: Ref[byte]) -> Ref[byte]? {
    return __abi_string_backing_at(address)
}

func bytes(range: Range) -> Ref[byte]? {
    return __abi_bytes(range.first, range.count)
}

func range_index(range: Range, ordinal: u32) -> i64 {
    return __abi_range_index(range.first, range.count, ordinal)
}

func first_component(row: Ref[Type_Record]) -> Ref[Type_Record]? {
    let index: i64 = range_index(row.components, 0)
    if index < 0 {
        return nil
    }
    return type_at(cast[u32]index)
}

func reference_target(descriptor: typespec) -> Ref[Type_Record]? {
    let reference: Ref[Type_Record]? = type_for(descriptor)
    if reference != nil {
        return first_component(reference.get())
    }
    return nil
}

func optional_reference_target(descriptor: typespec) -> Ref[Type_Record]? {
    let option: Ref[Type_Record]? = type_for(descriptor)
    if option != nil {
        let reference: Ref[Type_Record]? = first_component(option.get())
        if reference != nil {
            return first_component(reference.get())
        }
    }
    return nil
}

func size_bytes(row: Ref[Type_Record]) -> uint {
    let alignment: uint = row.alignment_bytes
    require alignment != 0
    let whole: uint = row.size_bits / 8
    var bytes: uint = whole
    if row.size_bits % 8 != 0 {
        bytes += 1
    }
    return (bytes + alignment - 1) / alignment * alignment
}

func alignment_bytes(row: Ref[Type_Record]) -> uint {
    return row.alignment_bytes
}

func packed_array_stride_bits(row: Ref[Type_Record]) -> uint {
    if row.flags & type_flag_bits != 0 {
        return row.semantic_width_bits
    }
    let boolean: Ref[Type_Record]? = type_for(typeof(false))
    if boolean != nil {
        if boolean.get().typehash == row.typehash {
            return 1
        }
    }
    return 0
}
