alias type Type_Kind = builtin.Type_Kind
alias type Range = builtin.Range
alias type String_Bits = builtin.String_Bits
alias type Type_Record = builtin.Type_Record
alias type Field_Record = builtin.Field_Record
alias type Trace_Record = builtin.Trace_Record
alias type Trace_Child_Record = builtin.Trace_Child_Record
alias type Trace_Arm_Record = builtin.Trace_Arm_Record
alias type Tag_Extractor_Record = builtin.Tag_Extractor_Record
alias type Frame_Layout_Record = builtin.Frame_Layout_Record
alias type Native_Frame_Record = builtin.Native_Frame_Record
alias type Native_Frame_Root = builtin.Native_Frame_Root
alias type Storage_Record = builtin.Storage_Record
alias type Symbol_Record = builtin.Symbol_Record
alias type Module_Record = builtin.Module_Record
alias type Function_Record = builtin.Function_Record
alias type Baked_Node_Record = builtin.Baked_Node_Record
alias type Arm_Record = builtin.Arm_Record
alias type Physical_Run_Record = builtin.Physical_Run_Record

enum Tag_Kind {
    invalid = 0, direct_bits = 1, pointer_null = 2, bitptr_depth = 3
}

enum Storage_Kind {
    read_only = 1, writable = 2, tls = 3
}

const type_flag_bits: u32 = 1 << 4
const type_flag_bool: u32 = 1 << 7

record Array_Descriptor_Header layout(c) {
    total_count:   u64
    rank:          u32
    flat_rank:     u32
    flags:         u32
    reserved_zero: u32
}

record Array_Value layout(c) {
    data:       Ref[byte]?
    descriptor: Ref[Array_Descriptor_Header]?
}

record Box_Value layout(c) {
    extent:     u16
    stride:     u16
    type_field: u32
    payload:    Ref[byte]?
}

record Bitptr_Value layout(c) {
    base:       Ref[byte]?
    type_index: u32
    start_bit:  u16
    end_bit:    u16
}

record Callback_Value layout(c) {
    handler_function_index: u32
    callback_type_index:    u32
    environment:            Ref[byte]?
}

const frame_sentinel:    u32  = 0x4230304e
const frame_root_offset: uint = 8

const type_flag_type_index: u32 = 1 << 6
const table_type:          u32 = 4
const table_function:      u32 = 14
const patch_index:         u32 = 1
const patch_box_type:      u32 = 2
const binding_const:       u32 = 3
const baked_immutable:     u32 = 1
const baked_array_backing: u32 = 2
const baked_foreign:       u32 = 4
const table_native:        u32 = 19
const type_flag_opaque:    u32 = 1 << 1
const extent_count_field:  u32 = 1
const extent_sentinel:     u32 = 2
const table_trace:         u32 = 10
const table_trace_child:   u32 = 11
const table_tag_extractor: u32 = 13
const table_u32_stream:    u32 = 32

var type_rows:               Ref[byte]? = nil
var type_row_bytes:          uint       = 0
var type_row_count:          u32        = 0
var trace_rows:              Ref[byte]? = nil
var trace_row_bytes:         uint       = 0
var trace_row_count:         u32        = 0
var trace_child_rows:        Ref[byte]? = nil
var trace_child_row_bytes:   uint       = 0
var trace_child_row_count:   u32        = 0
var tag_extractor_rows:      Ref[byte]? = nil
var tag_extractor_row_bytes: uint       = 0
var tag_extractor_row_count: u32        = 0
var u32_rows:                Ref[byte]? = nil
var u32_row_count:           u32        = 0

func cache_tables() {
    type_rows = __abi_table_base(table_type)
    type_row_bytes = cast[uint](__abi_table_record_bytes(table_type))
    type_row_count = __abi_table_count(table_type)
    trace_rows = __abi_table_base(table_trace)
    trace_row_bytes = cast[uint](__abi_table_record_bytes(table_trace))
    trace_row_count = __abi_table_count(table_trace)
    trace_child_rows = __abi_table_base(table_trace_child)
    trace_child_row_bytes = cast[uint](__abi_table_record_bytes(table_trace_child))
    trace_child_row_count = __abi_table_count(table_trace_child)
    tag_extractor_rows = __abi_table_base(table_tag_extractor)
    tag_extractor_row_bytes = cast[uint](__abi_table_record_bytes(table_tag_extractor))
    tag_extractor_row_count = __abi_table_count(table_tag_extractor)
    u32_rows = __abi_table_base(table_u32_stream)
    u32_row_count = __abi_table_count(table_u32_stream)
}

inline func type_at(index: u32) -> Ref[Type_Record]? {
    let rows: Ref[byte]? = type_rows
    if index < type_row_count and rows != nil {
        return unsafe_cast[Ref[Type_Record]] __gc_byte_offset(rows.get(),
            cast[uint](index) * type_row_bytes)
    }
    return __abi_type(index)
}

func type_for(descriptor: typespec) -> Ref[Type_Record]? {
    return __abi_type_for(descriptor)
}

func field_at(index: u32) -> Ref[Field_Record]? {
    return __abi_field(index)
}

func arm_at(index: u32) -> Ref[Arm_Record]? {
    return __abi_arm(index)
}

func physical_run_at(index: u32) -> Ref[Physical_Run_Record]? {
    return __abi_physical_run(index)
}

inline func trace_at(index: u32) -> Ref[Trace_Record]? {
    let rows: Ref[byte]? = trace_rows
    if index < trace_row_count and rows != nil {
        return unsafe_cast[Ref[Trace_Record]] __gc_byte_offset(rows.get(),
            cast[uint](index) * trace_row_bytes)
    }
    return __abi_trace(index)
}

inline func trace_child_at(index: u32) -> Ref[Trace_Child_Record]? {
    let rows: Ref[byte]? = trace_child_rows
    if index < trace_child_row_count and rows != nil {
        return unsafe_cast[Ref[Trace_Child_Record]] __gc_byte_offset(rows.get(),
            cast[uint](index) * trace_child_row_bytes)
    }
    return __abi_trace_child(index)
}

func trace_arm_at(index: u32) -> Ref[Trace_Arm_Record]? {
    return __abi_trace_arm(index)
}

inline func tag_extractor_at(index: u32) -> Ref[Tag_Extractor_Record]? {
    let rows: Ref[byte]? = tag_extractor_rows
    if index < tag_extractor_row_count and rows != nil {
        return unsafe_cast[Ref[Tag_Extractor_Record]] __gc_byte_offset(
            rows.get(), cast[uint](index) * tag_extractor_row_bytes)
    }
    return __abi_tag_extractor(index)
}

func frame_layout_at(index: u32) -> Ref[Frame_Layout_Record]? {
    return __abi_frame_layout(index)
}

func native_frame_count() -> u32 {
    return __abi_native_frame_count()
}

func native_frame(index: u32) -> Ref[Native_Frame_Record]? {
    return __abi_native_frame(index)
}

func native_frame_root(frame: Ref[Native_Frame_Record],
                       ordinal: u32) -> Ref[Native_Frame_Root] {
    return __abi_native_frame_root(frame, ordinal)
}

func storage_count() -> u32 {
    return __abi_storage_count()
}

func storage_at(index: u32) -> Ref[Storage_Record]? {
    return __abi_storage(index)
}


func symbol_at(index: u32) -> Ref[Symbol_Record]? {
    return __abi_symbol(index)
}

func module_at(index: u32) -> Ref[Module_Record]? {
    return __abi_module(index)
}

func function_at(index: u32) -> Ref[Function_Record]? {
    return __abi_function(index)
}

func baked_node_count() -> u32 {
    return __abi_baked_node_count()
}

func baked_node_at(index: u32) -> Ref[Baked_Node_Record]? {
    return __abi_baked_node(index)
}

func baked_node_address(index: u32) -> Ref[byte]? {
    return __abi_baked_node_address(index)
}

func baked_address(address: uint) -> bool {
    var index: u32 = 1
    while index < baked_node_count() {
        let row: Ref[Baked_Node_Record]? = baked_node_at(index)
        let base: Ref[byte]? = baked_node_address(index)
        if row != nil and base != nil {
            let start: uint = __abi_ref_address(base.get())
            if address >= start and address < start + cast[uint]row.get().byte_length {
                return true
            }
        }
        index += 1
    }
    return false
}

func storage_address(index: u32) -> Ref[byte]? {
    return __abi_storage_address(index)
}

func string_backing_at(address: Ref[byte]) -> Ref[byte]? {
    return __abi_string_backing_at(address)
}

func bytes(range: Range) -> Ref[byte]? {
    return __abi_bytes(range.first, range.count)
}

func string_tag(address: Ref[byte]) -> u64 {
    let bits: Ref[String_Bits] = unsafe_cast[Ref[String_Bits]] address
    return bits.high >> 62
}

func string_length(address: Ref[byte]) -> uint {
    let bits: Ref[String_Bits] = unsafe_cast[Ref[String_Bits]] address
    if string_tag(address) == 0 {
        return cast[uint](bits.high >> 56) & 15
    }
    return cast[uint](bits.high & 0x0fffffffffffffff)
}

func string_bytes(address: Ref[byte]) -> Ref[byte]? {
    if string_tag(address) == 0 {
        return address
    }
    return string_backing_at(address)
}

inline func range_index(range: Range, ordinal: u32) -> i64 {
    let rows: Ref[byte]? = u32_rows
    if ordinal < range.count and rows != nil and
        cast[u64](range.first) + cast[u64](range.count) <= cast[u64](u32_row_count) {
        let at: uint = (cast[uint](range.first) + cast[uint](ordinal)) * 4
        return cast[i64]((unsafe_cast[Ref[u32]] __gc_byte_offset(rows.get(), at)).__value)
    }
    return __abi_range_index(range.first, range.count, ordinal)
}

func first_component(row: Ref[Type_Record]) -> Ref[Type_Record]? {
    let index: i64 = range_index(row.components, 0)
    if index < 0 {
        return nil
    }
    return type_at(cast[u32]index)
}

func reference_target(descriptor: typespec) -> Ref[Type_Record]? {
    let reference: Ref[Type_Record]? = type_for(descriptor)
    if reference != nil {
        return first_component(reference.get())
    }
    return nil
}

func optional_reference_target(descriptor: typespec) -> Ref[Type_Record]? {
    let option: Ref[Type_Record]? = type_for(descriptor)
    if option != nil {
        let reference: Ref[Type_Record]? = first_component(option.get())
        if reference != nil {
            return first_component(reference.get())
        }
    }
    return nil
}

func size_bytes(row: Ref[Type_Record]) -> uint {
    let alignment: uint = row.alignment_bytes
    require alignment != 0
    let whole: uint = row.size_bits / 8
    var bytes: uint = whole
    if row.size_bits % 8 != 0 {
        bytes += 1
    }
    return ((bytes + alignment - 1) / alignment) * alignment
}

func alignment_bytes(row: Ref[Type_Record]) -> uint {
    return row.alignment_bytes
}

inline func packed_array_stride_bits(row: Ref[Type_Record]) -> uint {
    if row.flags & type_flag_bits != 0 {
        return row.semantic_width_bits
    }
    if row.flags & type_flag_bool != 0 {
        return 1
    }
    return 0
}
