import internal.abi
import internal.gc.core
import internal.gc.registry
import internal.gc.alloc
import internal.gc.mark

const capture_fd: i32 = 3

type Graph_Node {
    base:       Ref[byte]
    size:       uint
    alignment:  u32
    typehash:   u64
    type_index: u32
    flags:      u32
    copy:       Ref[byte]?
    count:         u64
    merged_into: i64
    merged_offset:  uint
    parent:        i64
    parent_offset: uint
}

type Graph_Edge {
    source:        u32
    source_offset: uint
    target:        u32
    target_offset: uint
}

type Graph_Root {
    module_path: Ref[byte]
    name:        Ref[byte]
    node:        u32
}

type Graph_Slot {
    node:   u32
    offset: uint
    table:  u32
    kind:   u32
    index:  u32
    native: Ref[byte]?
}

type Capture_Failure {
    node:    u32
    offset:  uint
    message: string
}

type Graph {
    heap:    Ref[internal.gc.core.Heap]
    copying: bool
    nodes:   List[Graph_Node]
    edges:   List[Graph_Edge]
    roots:   List[Graph_Root]
    slots:   List[Graph_Slot]
    pending: List[u32]
    failure: Capture_Failure?
}

func type_row(type_index: u32) -> Ref[internal.abi.Type_Record] {
    let row: Ref[internal.abi.Type_Record]? = internal.abi.type_at(type_index)
    require row != nil
    return row.get()
}

func new_graph(copying: bool) -> Graph {
    let mutator: Ref[internal.gc.core.Mutator]? = internal.gc.alloc.mutator_for_native()
    require mutator != nil
    return (heap = mutator.get().heap, copying = copying,
            nodes = new[List[Graph_Node]](), edges = new[List[Graph_Edge]](),
            roots = new[List[Graph_Root]](), slots = new[List[Graph_Slot]](),
            pending = new[List[u32]](), failure = nil)
}

func node_containing(graph: Ref[Graph], address: uint) -> i64 {
    var index: int = 0
    while index < cast[int]graph.nodes.len() {
        let node: Graph_Node = graph.nodes[index]
        let base: uint       = __abi_ref_address(node.base)
        if address >= base and address < base + node.size {
            return cast[i64]index
        }
        index += 1
    }
    return -1
}

func add_node(graph: Ref[Graph], base: Ref[byte], size: uint, alignment: u32,
              type_index: u32, flags: u32, trace: bool) -> u32 {
    let index: u32 = cast[u32]graph.nodes.len()
    var typehash: u64 = 0
    if type_index != 0 {
        typehash = type_row(type_index).typehash
    }
    var copy: Ref[byte]? = nil
    if graph.copying and (flags & internal.abi.baked_immutable) == 0 {
        var descriptor: Ref[internal.abi.Array_Descriptor_Header]? = nil
        if (flags & internal.abi.baked_array_backing) != 0 {
            descriptor = internal.gc.core.array_descriptor_at(base)
        }
        copy = internal.gc.alloc.allocate_runtime(type_index, cast[u64]size,
            alignment, descriptor)
        require copy != nil
        __gc_memcpy(copy.get(), base, size)
    }
    let node: Graph_Node = (base = base, size = size, alignment = alignment,
                            typehash = typehash, type_index = type_index,
                            flags = flags, copy = copy, count = 1, merged_into = -1,
                            merged_offset = 0, parent = -1, parent_offset = 0)
    graph.nodes.append(node)
    if trace and (!graph.copying or copy != nil) {
        graph.pending.append(index)
    }
    return index
}

func heap_node(graph: Ref[Graph], address: uint) -> i64 {
    internal.gc.registry.registry_read_lock(graph.heap)
    let header: Ref[internal.gc.core.Object_Header]? = internal.gc.registry.find_object(
        graph.heap, address)
    internal.gc.registry.registry_read_unlock(graph.heap)
    if header == nil {
        return -1
    }
    var flags: u32 = 0
    if (header.get().meta & internal.gc.core.obj_array_backing) != 0 {
        flags = internal.abi.baked_array_backing
    }
    return cast[i64]add_node(graph, internal.gc.core.payload_of(header.get()),
        cast[uint]internal.gc.core.meta_payload_bytes(header.get().meta),
        cast[u32]internal.gc.core.granule_bytes, header.get().type_index,
        flags, true)
}

func baked_node(graph: Ref[Graph], address: uint) -> i64 {
    var index: u32 = 1
    while index < internal.abi.baked_node_count() {
        let row: Ref[internal.abi.Baked_Node_Record]? = internal.abi.baked_node_at(index)
        let base: Ref[byte]? = internal.abi.baked_node_address(index)
        require row != nil and base != nil
        let start: uint = __abi_ref_address(base.get())
        if address >= start and address < start + cast[uint]row.get().byte_length {
            var alignment: u32 = 1
            if row.get().type_index != 0 {
                alignment = cast[u32]internal.abi.alignment_bytes(
                    type_row(row.get().type_index))
            }
            return cast[i64]add_node(graph, base.get(),
                cast[uint]row.get().byte_length, alignment,
                row.get().type_index, row.get().flags, true)
        }
        index += 1
    }
    return -1
}

func target_node(graph: Ref[Graph], pointer: Ref[byte]) -> i64 {
    let address: uint = __abi_ref_address(pointer)
    let existing: i64 = node_containing(graph, address)
    if existing >= 0 {
        return existing
    }
    let heap: i64 = heap_node(graph, address)
    if heap >= 0 {
        return heap
    }
    return baked_node(graph, address)
}

func string_tag(address: Ref[byte]) -> u64 {
    let bits: Ref[internal.abi.String_Bits] = unsafe_cast[Ref[internal.abi.String_Bits]] address
    return bits.high >> 62
}

func string_length(address: Ref[byte]) -> uint {
    let bits: Ref[internal.abi.String_Bits] = unsafe_cast[Ref[internal.abi.String_Bits]] address
    if string_tag(address) == 0 {
        return cast[uint](bits.high >> 56) & 15
    }
    return cast[uint](bits.high & 0x0fffffffffffffff)
}

func string_bytes(address: Ref[byte]) -> Ref[byte]? {
    if string_tag(address) == 0 {
        return address
    }
    return internal.abi.string_backing_at(address)
}

func add_edge(graph: Ref[Graph], source: u32, slot: Ref[byte], target: u32,
              pointer: Ref[byte]) {
    let source_base: uint = __abi_ref_address(graph.nodes[cast[int]source].base)
    let target_base: uint = __abi_ref_address(graph.nodes[cast[int]target].base)
    let edge: Graph_Edge = (source = source,
                            source_offset = __abi_ref_address(slot) - source_base,
                            target = target,
                            target_offset = __abi_ref_address(pointer) - target_base)
    graph.edges.append(edge)
}

func u32_at(address: Ref[byte]) -> u32 {
    let word: Ref[u32] = unsafe_cast[Ref[u32]] address
    return word
}

func add_slot(graph: Ref[Graph], source: u32, address: Ref[byte],
              table: u32, kind: u32, index: u32) {
    if graph.copying {
        return
    }
    let base: uint = __abi_ref_address(graph.nodes[cast[int]source].base)
    let slot: Graph_Slot = (node = source,
                            offset = __abi_ref_address(address) - base,
                            table = table, kind = kind, index = index,
                            native = nil)
    graph.slots.append(slot)
}

func visit_box(graph: Ref[Graph], source: u32, address: Ref[byte]) {
    let box: Ref[internal.abi.Box_Value] = unsafe_cast[Ref[internal.abi.Box_Value]] address
    let item_index: u32 = box.type_field & 0x7fffffff
    if item_index == 0 {
        return
    }
    add_slot(graph, source, __gc_byte_offset(address, 4),
             internal.abi.table_type, internal.abi.patch_box_type, item_index)
    let item: Ref[internal.abi.Type_Record] = type_row(item_index)
    if item.size_bits > 64 {
        visit_pointer(graph, source, __gc_byte_offset(address, 8),
                      box.payload)
    } else {
        visit_value(graph, source, __gc_byte_offset(address, 8), item_index)
    }
}

func visit_callback(graph: Ref[Graph], source: u32, address: Ref[byte]) {
    let handler: Ref[internal.abi.Callback_Value] = unsafe_cast[Ref[internal.abi.Callback_Value]] address
    if handler.handler_function_index != 0 {
        add_slot(graph, source, address, internal.abi.table_function,
                 internal.abi.patch_index, handler.handler_function_index)
    }
    add_slot(graph, source, __gc_byte_offset(address, 4),
             internal.abi.table_type, internal.abi.patch_index,
             handler.callback_type_index)
    visit_pointer(graph, source, __gc_byte_offset(address, 8),
                  handler.environment)
}

func redirect(graph: Ref[Graph], slot: Ref[byte], target: u32,
              pointer: Ref[byte]) {
    let node: Graph_Node = graph.nodes[cast[int]target]
    if node.copy == nil {
        return
    }
    let offset: uint = __abi_ref_address(pointer) - __abi_ref_address(node.base)
    let moved: Ref[byte] = __gc_byte_offset(node.copy.get(), offset)
    __atomic_store(internal.gc.mark.pointer_word_at(slot), moved)
    internal.gc.alloc.barrier_pointer_runtime(moved)
}

func node_offset(graph: Ref[Graph], node: u32, address: Ref[byte]) -> uint {
    return __abi_ref_address(address) - __abi_ref_address(graph.nodes[cast[int]node].base)
}

func set_origin(graph: Ref[Graph], node: u32, parent: u32, slot: Ref[byte]) {
    var entry: Graph_Node = graph.nodes[cast[int]node]
    entry.parent = cast[i64]parent
    entry.parent_offset = node_offset(graph, parent, slot)
    graph.nodes[cast[int]node] = entry
}

func fail_capture(graph: Ref[Graph], source: u32, slot: Ref[byte],
                  message: string) {
    if graph.failure == nil {
        graph.failure = (node = source, offset = node_offset(graph, source, slot),
                         message = message)
    }
}

func foreign_target(type_index: u32) -> u32 {
    let row: Ref[internal.abi.Type_Record] = type_row(type_index)
    if row.kind == cast[u32](internal.abi.Type_Kind.foreign_type) {
        return type_index
    }
    if row.kind == cast[u32](internal.abi.Type_Kind.option_type) {
        let inner: i64 = internal.abi.range_index(row.components, 0)
        if inner > 0 and type_row(cast[u32]inner).kind ==
            cast[u32](internal.abi.Type_Kind.foreign_type) {
            return cast[u32]inner
        }
    }
    return 0
}

func scalar_width(row: Ref[internal.abi.Type_Record]) -> u32 {
    if row.kind != cast[u32](internal.abi.Type_Kind.primitive_type) and
        row.kind != cast[u32](internal.abi.Type_Kind.enum_type) {
        return 0
    }
    let width: u32 = cast[u32]row.size_bits
    if width == 8 or width == 16 or width == 32 or width == 64 {
        return width
    }
    return 0
}

func sentinel_count(pointer: Ref[byte], element: Ref[internal.abi.Type_Record],
                    sentinel: u64) -> u64 {
    let width: u32 = scalar_width(element)
    if width == 0 {
        return 0
    }
    var mask: u64 = 0xffffffffffffffff
    if width < 64 {
        mask = (cast[u64]1 << cast[u64]width) - 1
    }
    let stride: uint = internal.abi.size_bytes(element)
    var count: u64 = 0
    while true {
        let value: u64 = internal.gc.mark.trace_unit(
            __gc_byte_offset(pointer, cast[uint]count * stride), width)
        count += 1
        if value == (sentinel & mask) {
            return count
        }
    }
    return 0
}

func foreign_node(graph: Ref[Graph], source: u32, slot: Ref[byte],
                  pointer: Ref[byte], size: uint, element_index: u32) -> i64 {
    let start: uint = __abi_ref_address(pointer)
    let end:   uint = start + size
    var low: uint = start
    var high: uint = end
    var low_base: Ref[byte] = pointer
    var overlaps: List[u32] = new[List[u32]]()
    var index: int = 0
    while index < cast[int]graph.nodes.len() {
        let node: Graph_Node = graph.nodes[index]
        if (node.flags & internal.abi.baked_foreign) != 0 and node.merged_into < 0 {
            let base: uint = __abi_ref_address(node.base)
            let top:  uint = base + node.size
            if start < top and base < end {
                if base <= start and end <= top {
                    return cast[i64]index
                }
                overlaps.append(cast[u32]index)
                if base < low {
                    low = base
                    low_base = node.base
                }
                if top > high {
                    high = top
                }
            }
        }
        index += 1
    }
    let element: Ref[internal.abi.Type_Record] = type_row(element_index)
    let stride: uint = internal.abi.size_bytes(element)
    var ordinal: int = 0
    while ordinal < cast[int]overlaps.len() {
        let other: Graph_Node = graph.nodes[cast[int]overlaps[ordinal]]
        if other.type_index != element_index or
            (__abi_ref_address(other.base) - low) % stride != 0 {
            fail_capture(graph, source, slot,
                "points into a block that another pointer reaches as a different type")
            return -1
        }
        ordinal += 1
    }
    let created: u32 = add_node(graph, low_base, high - low,
        cast[u32]internal.abi.alignment_bytes(element), element_index,
        internal.abi.baked_foreign, true)
    var entry: Graph_Node = graph.nodes[cast[int]created]
    entry.count = cast[u64]((high - low) / stride)
    graph.nodes[cast[int]created] = entry
    set_origin(graph, created, source, slot)
    ordinal = 0
    while ordinal < cast[int]overlaps.len() {
        absorb(graph, overlaps[ordinal], created)
        ordinal += 1
    }
    return cast[i64]created
}

func absorb(graph: Ref[Graph], node: u32, into: u32) {
    var entry: Graph_Node = graph.nodes[cast[int]node]
    entry.merged_into = cast[i64]into
    entry.merged_offset = __abi_ref_address(entry.base) -
        __abi_ref_address(graph.nodes[cast[int]into].base)
    graph.nodes[cast[int]node] = entry
    var edges: List[Graph_Edge] = new[List[Graph_Edge]]()
    var index: int = 0
    while index < cast[int]graph.edges.len() {
        let edge: Graph_Edge = graph.edges[index]
        if edge.source != node {
            edges.append(edge)
        }
        index += 1
    }
    graph.edges = edges
    var slots: List[Graph_Slot] = new[List[Graph_Slot]]()
    index = 0
    while index < cast[int]graph.slots.len() {
        let slot: Graph_Slot = graph.slots[index]
        if slot.node != node {
            slots.append(slot)
        }
        index += 1
    }
    graph.slots = slots
}

func visit_foreign(graph: Ref[Graph], source: u32, parent: Ref[byte],
                   slot: Ref[byte], foreign_index: u32,
                   child: Ref[internal.abi.Trace_Child_Record]?) {
    if graph.copying {
        return
    }
    let found: Ref[byte]? = __atomic_load(internal.gc.mark.pointer_word_at(slot))
    if found == nil {
        return
    }
    let pointer: Ref[byte] = found.get()
    let element_index: i64 = internal.abi.range_index(
        type_row(foreign_index).components, 0)
    if element_index <= 0 {
        fail_capture(graph, source, slot,
            "points to memory that has no description")
        return
    }
    let element: Ref[internal.abi.Type_Record] = type_row(cast[u32]element_index)
    if element.kind == cast[u32](internal.abi.Type_Kind.function_type) {
        let name: Ref[byte]? = __native_symbol_name(__abi_ref_address(pointer))
        if name == nil {
            fail_capture(graph, source, slot,
                "points to a function that has no exported symbol")
            return
        }
        let entry: Graph_Slot = (node = source,
                                 offset = node_offset(graph, source, slot),
                                 table = internal.abi.table_native, kind = 0,
                                 index = 0, native = name)
        graph.slots.append(entry)
        return
    }
    if element.alignment_bytes == 0 or element.size_bits == 0 or
        (element.flags & internal.abi.type_flag_opaque) != 0 {
        fail_capture(graph, source, slot,
            "points to memory that has no description")
        return
    }
    var count: u64 = 1
    if child != nil {
        let extent: Ref[internal.abi.Trace_Child_Record] = child.get()
        if extent.extent_form == internal.abi.extent_count_field {
            count = internal.gc.mark.trace_unit(
                __gc_byte_offset(parent, cast[uint]extent.count_field_offset),
                extent.count_field_bits)
        }
        if extent.extent_form == internal.abi.extent_sentinel {
            count = sentinel_count(pointer, element, extent.sentinel)
            if count == 0 {
                fail_capture(graph, source, slot,
                    "has an 'until' sentinel on elements that are not integers")
                return
            }
        }
    }
    if count == 0 {
        fail_capture(graph, source, slot,
            "points to an empty array, which cannot be baked")
        return
    }
    let target: i64 = foreign_node(graph, source, slot, pointer,
        cast[uint]count * internal.abi.size_bytes(element),
        cast[u32]element_index)
    if target >= 0 {
        add_edge(graph, source, slot, cast[u32]target, pointer)
    }
}

func visit_record_arm(graph: Ref[Graph], source: u32, address: Ref[byte],
                      trace: Ref[internal.abi.Trace_Record]) {
    let found: Ref[internal.abi.Tag_Extractor_Record]? = internal.abi.tag_extractor_at(
        trace.tag_extractor_index)
    require found != nil
    let tag: Ref[internal.abi.Tag_Extractor_Record] = found.get()
    let active: u64 = (internal.gc.mark.trace_unit(
        __gc_byte_offset(address, tag.unit_byte_offset), tag.unit_width_bits)
        & tag.mask) >> tag.lsb_position
    var ordinal: u32 = 0
    while ordinal < trace.arms.count {
        let index: i64 = internal.abi.range_index(trace.arms, ordinal)
        require index > 0
        let arm: Ref[internal.abi.Trace_Arm_Record]? = internal.abi.trace_arm_at(
            cast[u32]index)
        require arm != nil
        if cast[u64](arm.get().tag_value) == active {
            visit_children(graph, source, address, arm.get().children)
            return
        }
        ordinal += 1
    }
}

func visit_pointer(graph: Ref[Graph], source: u32, slot: Ref[byte],
                   pointer: Ref[byte]?) {
    if pointer == nil {
        return
    }
    let known: int = cast[int]graph.nodes.len()
    let target: i64 = target_node(graph, pointer.get())
    if target >= cast[i64]known {
        set_origin(graph, cast[u32]target, source, slot)
    }
    if graph.copying {
        if target >= 0 {
            redirect(graph, slot, cast[u32]target, pointer.get())
        }
        return
    }
    require target >= 0
    add_edge(graph, source, slot, cast[u32]target, pointer.get())
}

func visit_string(graph: Ref[Graph], source: u32, address: Ref[byte]) {
    let tag: u64 = string_tag(address)
    if tag == 3 {
        visit_pointer(graph, source, address,
                      internal.abi.string_backing_at(address))
        return
    }
    if tag == 0 or graph.copying {
        return
    }
    require tag == 1 or tag == 2
    let backing: Ref[byte]? = internal.abi.string_backing_at(address)
    if backing == nil {
        return
    }
    let target_address: uint = __abi_ref_address(backing.get())
    var target: i64 = node_containing(graph, target_address)
    if target < 0 {
        target = heap_node(graph, target_address)
    }
    if target < 0 {
        target = cast[i64]add_node(graph, backing.get(),
            string_length(address), 1, 0, internal.abi.baked_immutable, false)
    }
    add_edge(graph, source, address, cast[u32]target, backing.get())
}

func visit_children(graph: Ref[Graph], source: u32, address: Ref[byte],
                    children: internal.abi.Range) {
    var ordinal: u32 = 0
    while ordinal < children.count {
        let index: i64 = internal.abi.range_index(children, ordinal)
        require index > 0
        let entry: Ref[internal.abi.Trace_Child_Record]? = internal.abi.trace_child_at(
            cast[u32]index)
        require entry != nil
        let child: Ref[internal.abi.Trace_Child_Record] = entry.get()
        var count: u64 = child.repeat_count
        if count == 0 {
            count = 1
        }
        let foreign: u32 = foreign_target(child.child_type_index)
        var repetition: u64 = 0
        while repetition < count {
            let offset: uint = cast[uint](child.byte_offset +
                repetition * (child.stride_bits / 8))
            if foreign != 0 {
                visit_foreign(graph, source, address,
                              __gc_byte_offset(address, offset), foreign, child)
            } else {
                visit_value(graph, source, __gc_byte_offset(address, offset),
                            child.child_type_index)
            }
            repetition += 1
        }
        ordinal += 1
    }
}

func visit_elements(graph: Ref[Graph], source: u32, data: Ref[byte],
                    shape: Ref[internal.abi.Array_Descriptor_Header],
                    type_index: u32) {
    let child_type: u32 = internal.gc.core.array_flat_element_index(
        type_index, shape.flat_rank)
    let element: Ref[internal.abi.Type_Record] = type_row(child_type)
    if element.tracing_index == 0 {
        return
    }
    let alignment:     uint = internal.abi.alignment_bytes(element)
    let element_bytes: uint = internal.abi.size_bytes(element)
    let stride:        uint = (element_bytes + alignment - 1) / alignment * alignment
    var index: u64 = 0
    while index < shape.total_count {
        visit_value(graph, source,
            __gc_byte_offset(data, cast[uint]index * stride), child_type)
        index += 1
    }
}

func static_node(graph: Ref[Graph], base: Ref[byte], size: uint,
                 alignment: u32) -> u32 {
    let existing: i64 = node_containing(graph, __abi_ref_address(base))
    if existing >= 0 {
        return cast[u32]existing
    }
    return add_node(graph, base, size, alignment, 0,
                    internal.abi.baked_immutable, false)
}

func visit_static_array(graph: Ref[Graph], source: u32, address: Ref[byte],
                        data: Ref[byte],
                        shape: Ref[internal.abi.Array_Descriptor_Header],
                        type_index: u32) {
    let element: Ref[internal.abi.Type_Record] = type_row(
        internal.gc.core.array_flat_element_index(type_index, shape.flat_rank))
    let alignment:     uint = internal.abi.alignment_bytes(element)
    let element_bytes: uint = internal.abi.size_bytes(element)
    let stride:        uint = (element_bytes + alignment - 1) / alignment * alignment
    let known: bool = node_containing(graph, __abi_ref_address(data)) >= 0
    let data_node: u32 = static_node(graph, data,
        cast[uint]shape.total_count * stride, cast[u32]alignment)
    let descriptor: Ref[byte] = unsafe_cast[Ref[byte]] shape
    let descriptor_node: u32 = static_node(graph, descriptor,
        internal.gc.core.array_descriptor_bytes(shape), 8)
    add_edge(graph, source, address, data_node, data)
    add_edge(graph, source, __gc_byte_offset(address, 8), descriptor_node,
             descriptor)
    if !known {
        visit_elements(graph, data_node, data, shape, type_index)
    }
}

func visit_array(graph: Ref[Graph], source: u32, address: Ref[byte],
                 type_index: u32) {
    let value: Ref[internal.abi.Array_Value] = unsafe_cast[Ref[internal.abi.Array_Value]] address
    let data: Ref[byte]? = value.data
    let descriptor: Ref[internal.abi.Array_Descriptor_Header]? = value.descriptor
    if data == nil or descriptor == nil {
        require data == nil and descriptor == nil
        return
    }
    if !graph.copying and target_node(graph, data.get()) < 0 {
        visit_static_array(graph, source, address, data.get(),
                           descriptor.get(), type_index)
        return
    }
    visit_pointer(graph, source, address, data)
    visit_pointer(graph, source, __gc_byte_offset(address, 8),
                  unsafe_cast[Ref[byte]] descriptor.get())
}

func visit_variant(graph: Ref[Graph], source: u32, address: Ref[byte],
                   trace: Ref[internal.abi.Trace_Record]) {
    let found: Ref[internal.abi.Tag_Extractor_Record]? = internal.abi.tag_extractor_at(
        trace.tag_extractor_index)
    require found != nil
    let tag: Ref[internal.abi.Tag_Extractor_Record] = found.get()
    require tag.kind == cast[u32](internal.abi.Tag_Kind.direct_bits)
    let unit: Ref[byte] = __gc_byte_offset(address, tag.unit_byte_offset)
    let active: u64 = (internal.gc.mark.trace_unit(unit, tag.unit_width_bits)
        & tag.mask) >> tag.lsb_position
    if active == 0 {
        return
    }
    var ordinal: u32 = 0
    while ordinal < trace.arms.count {
        let index: i64 = internal.abi.range_index(trace.arms, ordinal)
        require index > 0
        let arm: Ref[internal.abi.Trace_Arm_Record]? = internal.abi.trace_arm_at(
            cast[u32]index)
        require arm != nil
        if cast[u64](arm.get().tag_value) == active {
            visit_children(graph, source, address, arm.get().children)
            return
        }
        ordinal += 1
    }
    require false
}

func visit_value(graph: Ref[Graph], source: u32, address: Ref[byte],
                 type_index: u32) {
    let row: Ref[internal.abi.Type_Record] = type_row(type_index)
    if row.tracing_index == 0 {
        return
    }
    let foreign: u32 = foreign_target(type_index)
    if foreign != 0 {
        visit_foreign(graph, source, address, address, foreign, nil)
        return
    }
    if (row.flags & internal.abi.type_flag_type_index) != 0 {
        add_slot(graph, source, address, internal.abi.table_type,
                 internal.abi.patch_index, u32_at(address))
        return
    }
    if row.kind == cast[u32](internal.abi.Type_Kind.box_type) or
        row.kind == cast[u32](internal.abi.Type_Kind.union_type) {
        visit_box(graph, source, address)
        return
    }
    if row.kind == cast[u32](internal.abi.Type_Kind.callback_type) {
        visit_callback(graph, source, address)
        return
    }
    if row.kind == cast[u32](internal.abi.Type_Kind.array_type) {
        visit_array(graph, source, address, type_index)
        return
    }
    if row.kind == cast[u32](internal.abi.Type_Kind.string_type) {
        visit_string(graph, source, address)
        return
    }
    if row.kind == cast[u32](internal.abi.Type_Kind.reference_type) {
        visit_pointer(graph, source, address,
            __atomic_load(internal.gc.mark.pointer_word_at(address)))
        return
    }
    let trace: Ref[internal.abi.Trace_Record]? = internal.abi.trace_at(
        row.tracing_index)
    require trace != nil
    if row.kind == cast[u32](internal.abi.Type_Kind.record_type) or
        row.kind == cast[u32](internal.abi.Type_Kind.tuple_type) {
        visit_children(graph, source, address, trace.get().fixed_children)
        if trace.get().tag_extractor_index != 0 {
            visit_record_arm(graph, source, address, trace.get())
        }
        return
    }
    if row.kind == cast[u32](internal.abi.Type_Kind.variant_type) {
        visit_variant(graph, source, address, trace.get())
        return
    }
    if row.kind == cast[u32](internal.abi.Type_Kind.option_type) or
        row.kind == cast[u32](internal.abi.Type_Kind.wrapper_type) or
        row.kind == cast[u32](internal.abi.Type_Kind.atomic_type) {
        if row.kind == cast[u32](internal.abi.Type_Kind.option_type) and
            !internal.gc.mark.option_is_set(address, trace.get(), type_index) {
            return
        }
        let child: Ref[internal.abi.Trace_Record]? = internal.abi.trace_at(
            trace.get().child_trace_index)
        require child != nil
        visit_value(graph, source, address, child.get().type_index)
        return
    }
    require false
}

func trace_node(graph: Ref[Graph], index: u32) {
    let node: Graph_Node = graph.nodes[cast[int]index]
    var base: Ref[byte] = node.base
    if node.copy != nil {
        base = node.copy.get()
    }
    if (node.flags & internal.abi.baked_foreign) != 0 {
        let element: Ref[internal.abi.Type_Record] = type_row(node.type_index)
        if node.merged_into >= 0 or element.tracing_index == 0 {
            return
        }
        let stride: uint = internal.abi.size_bytes(element)
        var ordinal: u64 = 0
        while ordinal < node.count {
            visit_value(graph, index,
                __gc_byte_offset(base, cast[uint]ordinal * stride),
                node.type_index)
            ordinal += 1
        }
        return
    }
    if (node.flags & internal.abi.baked_array_backing) != 0 {
        let shape: Ref[internal.abi.Array_Descriptor_Header] = internal.gc.core.array_descriptor_at(base)
        let offset: uint = internal.gc.core.array_backing_offset(
            node.type_index, shape)
        visit_elements(graph, index, __gc_byte_offset(base, offset), shape,
                       node.type_index)
        return
    }
    visit_value(graph, index, base, node.type_index)
}

func drain(graph: Ref[Graph]) {
    while graph.pending.len() != 0 {
        let index: u32? = graph.pending.pop()
        require index != nil
        trace_node(graph, index.get())
    }
}

func copy_literal(source: Ref[byte], destination: Ref[byte], type_index: u32) {
    let row: Ref[internal.abi.Type_Record] = type_row(type_index)
    __gc_memcpy(destination, source, internal.abi.size_bytes(row))
    if row.tracing_index == 0 {
        return
    }
    var graph: Graph = new_graph(true)
    visit_value(ref graph, 0, destination, type_index)
    drain(ref graph)
}

func write_word(value: u64, bytes: u32) {
    var buffer: u64 = value
    require __write_bytes(capture_fd, unsafe_cast[Ref[byte]] (ref buffer),
        bytes) == cast[i32]bytes
}

func write_block(base: Ref[byte], size: uint) {
    if size != 0 {
        require __write_bytes(capture_fd, base, cast[u32]size) == cast[i32]size
    }
}

func write_string(address: Ref[byte]) {
    let length: uint = string_length(address)
    write_word(cast[u64]length, 8)
    let bytes: Ref[byte]? = string_bytes(address)
    if bytes != nil {
        write_block(bytes.get(), length)
    }
}

func resolved_node(graph: Ref[Graph], node: u32) -> u32 {
    var current: u32 = node
    while graph.nodes[cast[int]current].merged_into >= 0 {
        current = cast[u32]graph.nodes[cast[int]current].merged_into
    }
    return current
}

func resolved_offset(graph: Ref[Graph], node: u32, offset: uint) -> uint {
    var current: u32 = node
    var total: uint = offset
    while graph.nodes[cast[int]current].merged_into >= 0 {
        total += graph.nodes[cast[int]current].merged_offset
        current = cast[u32]graph.nodes[cast[int]current].merged_into
    }
    return total
}

func write_graph(graph: Ref[Graph]) {
    var numbers: List[u32] = new[List[u32]]()
    var kept: u32 = 0
    var index: int = 0
    while index < cast[int]graph.nodes.len() {
        numbers.append(kept)
        if graph.nodes[index].merged_into < 0 {
            kept += 1
        }
        index += 1
    }
    write_word(cast[u64]kept, 8)
    index = 0
    while index < cast[int]graph.nodes.len() {
        let node: Graph_Node = graph.nodes[index]
        if node.merged_into < 0 {
            write_word(cast[u64]node.size, 8)
            write_word(cast[u64]node.alignment, 4)
            write_word(node.typehash, 8)
            write_type_name(node.type_index)
            write_word(cast[u64]node.flags, 4)
            write_block(node.base, node.size)
        }
        index += 1
    }
    write_word(cast[u64]graph.edges.len(), 8)
    index = 0
    while index < cast[int]graph.edges.len() {
        let edge: Graph_Edge = graph.edges[index]
        write_word(cast[u64]numbers[cast[int]resolved_node(graph, edge.source)], 4)
        write_word(cast[u64]resolved_offset(graph, edge.source, edge.source_offset), 8)
        write_word(cast[u64]numbers[cast[int]resolved_node(graph, edge.target)], 4)
        write_word(cast[u64]resolved_offset(graph, edge.target, edge.target_offset), 8)
        index += 1
    }
    write_word(cast[u64]graph.roots.len(), 8)
    index = 0
    while index < cast[int]graph.roots.len() {
        let root: Graph_Root = graph.roots[index]
        write_string(root.module_path)
        write_string(root.name)
        write_word(cast[u64]numbers[cast[int]resolved_node(graph, root.node)], 4)
        index += 1
    }
    write_word(cast[u64]graph.slots.len(), 8)
    index = 0
    while index < cast[int]graph.slots.len() {
        var slot: Graph_Slot = graph.slots[index]
        slot.offset = resolved_offset(graph, slot.node, slot.offset)
        slot.node = numbers[cast[int]resolved_node(graph, slot.node)]
        write_slot(slot)
        index += 1
    }
}

func write_c_string(text: Ref[byte]) {
    var length: uint = 0
    while true {
        let value: byte = __gc_byte_offset(text, length)
        if value == 0 {
            write_word(cast[u64]length, 8)
            write_block(text, length)
            return
        }
        length += 1
    }
}

func write_field_path(type_index: u32, offset: uint) {
    var current: u32 = type_index
    var at: uint = offset
    while true {
        let row: Ref[internal.abi.Type_Record] = type_row(current)
        if row.kind == cast[u32](internal.abi.Type_Kind.option_type) or
            row.kind == cast[u32](internal.abi.Type_Kind.wrapper_type) or
            row.kind == cast[u32](internal.abi.Type_Kind.atomic_type) {
            let inner: i64 = internal.abi.range_index(row.components, 0)
            if inner <= 0 {
                return
            }
            current = cast[u32]inner
        } elif row.kind == cast[u32](internal.abi.Type_Kind.record_type) or
            row.kind == cast[u32](internal.abi.Type_Kind.tuple_type) {
            var found: Ref[internal.abi.Field_Record]? = nil
            var ordinal: u32 = 0
            while found == nil and ordinal < row.fields_or_arms.count {
                let field_index: i64 = internal.abi.range_index(row.fields_or_arms, ordinal)
                let field: Ref[internal.abi.Field_Record]? = internal.abi.field_at(
                    cast[u32]field_index)
                if field != nil {
                    let start: uint = cast[uint](field.get().logical_bit_offset / 8)
                    var extent: uint
                    if field.get().inline_element_count != 0 {
                        extent = cast[uint](field.get().inline_element_count *
                            field.get().inline_element_stride_bits / 8)
                    } else {
                        extent = internal.abi.size_bytes(type_row(field.get().child_type_index))
                    }
                    if at >= start and at < start + extent {
                        found = field
                    }
                }
                ordinal += 1
            }
            if found == nil {
                return
            }
            let field: Ref[internal.abi.Field_Record] = found.get()
            write_word(1, 4)
            write_string(unsafe_cast[Ref[byte]] (ref field.name))
            at -= cast[uint](field.logical_bit_offset / 8)
            if field.inline_element_count != 0 {
                let stride: uint = cast[uint](field.inline_element_stride_bits / 8)
                write_word(2, 4)
                write_word(cast[u64](at / stride), 8)
                at = at % stride
                current = field.inline_element_type_index
            } else {
                current = field.child_type_index
            }
        } else {
            return
        }
    }
}

func write_failure(graph: Ref[Graph]) {
    let recorded: Capture_Failure? = graph.failure
    require recorded != nil
    let failure: Capture_Failure = recorded.get()
    var hops: List[u32] = new[List[u32]]()
    var offsets: List[uint] = new[List[uint]]()
    var node: u32 = failure.node
    var offset: uint = failure.offset
    while true {
        let entry: Graph_Node = graph.nodes[cast[int]node]
        hops.append(node)
        offsets.append(offset)
        if entry.parent < 0 {
            break
        }
        offset = entry.parent_offset
        node = cast[u32]entry.parent
    }
    write_word(0xffffffffffffffff, 8)
    var root_index: int = 0
    while root_index < cast[int]graph.roots.len() and
        graph.roots[root_index].node != node {
        root_index += 1
    }
    require root_index < cast[int]graph.roots.len()
    write_string(graph.roots[root_index].module_path)
    write_string(graph.roots[root_index].name)
    var hop: int = cast[int]hops.len() - 1
    while hop >= 0 {
        let entry: Graph_Node = graph.nodes[cast[int]hops[hop]]
        var at: uint = offsets[hop]
        if (entry.flags & internal.abi.baked_foreign) != 0 and entry.count > 1 {
            let stride: uint = internal.abi.size_bytes(type_row(entry.type_index))
            write_word(2, 4)
            write_word(cast[u64](at / stride), 8)
            at = at % stride
        }
        if entry.type_index != 0 and (entry.flags & internal.abi.baked_array_backing) == 0 {
            write_field_path(entry.type_index, at)
        }
        hop -= 1
    }
    write_word(0, 4)
    write_string(unsafe_cast[Ref[byte]] (ref failure.message))
}

func write_type_name(type_index: u32) {
    if type_index == 0 {
        write_word(0, 8)
        return
    }
    write_string(unsafe_cast[Ref[byte]] (ref type_row(type_index).canonical_name))
}

func write_slot(slot: Graph_Slot) {
    write_word(cast[u64]slot.node, 4)
    write_word(cast[u64]slot.offset, 8)
    write_word(cast[u64]slot.table, 4)
    write_word(cast[u64]slot.kind, 4)
    if slot.table == internal.abi.table_native {
        let text: Ref[byte]? = slot.native
        require text != nil
        write_c_string(text.get())
        return
    }
    if slot.table == internal.abi.table_type {
        write_word(type_row(slot.index).typehash, 8)
        write_type_name(slot.index)
        return
    }
    let found: Ref[internal.abi.Function_Record]? = internal.abi.function_at(
        slot.index)
    require found != nil
    let function: Ref[internal.abi.Function_Record] = found.get()
    let module: Ref[internal.abi.Module_Record]? = internal.abi.module_at(
        function.module_index)
    require module != nil
    write_string(unsafe_cast[Ref[byte]] (ref module.get().full_path))
    write_string(unsafe_cast[Ref[byte]] (ref function.name))
}

func capture_consts() {
    var graph: Graph = new_graph(false)
    var storage_index: u32 = 1
    while storage_index < internal.abi.storage_count() {
        let row: Ref[internal.abi.Storage_Record]? = internal.abi.storage_at(
            storage_index)
        require row != nil
        let symbol: Ref[internal.abi.Symbol_Record]? = internal.abi.symbol_at(
            row.get().symbol_index)
        let address: Ref[byte]? = internal.abi.storage_address(storage_index)
        if symbol != nil and address != nil and
            symbol.get().binding_kind == internal.abi.binding_const {
            let module: Ref[internal.abi.Module_Record]? = internal.abi.module_at(
                row.get().module_index)
            require module != nil
            let type_record: Ref[internal.abi.Type_Record] = type_row(
                row.get().type_index)
            let node: u32 = add_node(ref graph, address.get(),
                cast[uint]row.get().byte_length,
                cast[u32]internal.abi.alignment_bytes(type_record),
                row.get().type_index, 0, false)
            visit_value(ref graph, node, address.get(), row.get().type_index)
            let root: Graph_Root = (module_path = unsafe_cast[Ref[byte]] (ref module.get().full_path),
                                    name = unsafe_cast[Ref[byte]] (ref symbol.get().name),
                                    node = node)
            graph.roots.append(root)
        }
        storage_index += 1
    }
    drain(ref graph)
    if graph.failure != nil {
        write_failure(ref graph)
        return
    }
    write_graph(ref graph)
}
