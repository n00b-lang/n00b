import internal.errno

func errno_of(failure: Ffi_Error) -> internal.errno.Errno {
    return cast[internal.errno.Errno](failure.code)
}

func address_at(address: uint) -> Ref[byte] {
    return unsafe_cast[Ref[byte]](unsafe_cast[Foreign[byte]](address))
}

func address_ref(address: uint) -> Ref[byte]? {
    if address == 0 {
        return nil
    }
    return address_at(address)
}

when target_os() == "linux" {
    record Timespec layout(c) {
        seconds:     i64
        nanoseconds: i64
    }
}

when target_os() == "windows" {
    const chunk_limit: uint = 0x40000000

    func chunk(count: uint) -> uint {
        if count > chunk_limit {
            return chunk_limit
        }
        return count
    }
}
