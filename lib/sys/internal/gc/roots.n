import internal.abi
import internal.gc.core
import internal.gc.heap
import internal.gc.hash
import internal.gc.sync
import internal.memory

record Root_Entry layout(c) {
    slot: Ref[Ref[byte]?]
}

record TLS_Root_Entry layout(c) {
    address:    Ref[byte]
    type_index: u32
}

func tls_root_record() -> Ref[internal.abi.Type_Record] {
    let probe: Ref[TLS_Root_Entry]?          = nil
    let row:   Ref[internal.abi.Type_Record]? = internal.abi.optional_reference_target(typeof(probe))
    if row != nil {
        return row.get()
    }
    require false
}

func tls_root_entry_at(base: Ref[byte], index: uint) -> Ref[TLS_Root_Entry] {
    let stride: uint = internal.abi.size_bytes(tls_root_record())
    return unsafe_cast[Ref[TLS_Root_Entry]] __gc_byte_offset(base, index * stride)
}

func capture_tls(mutator: Ref[internal.gc.core.Mutator]) -> bool {
    var count: uint = 0
    var index: u32  = 1
    while index < internal.abi.storage_count() {
        let row: Ref[internal.abi.Storage_Record]? = internal.abi.storage_at(index)
        if row != nil {
            if row.get().segment_kind == cast[u32](internal.abi.Storage_Kind.tls) {
                count += 1
            }
        }
        index += 1
    }
    if count == 0 {
        return true
    }
    let row:    Ref[internal.abi.Type_Record] = tls_root_record()
    let stride: uint                         = internal.abi.size_bytes(row)
    if stride == 0 or count > ~cast[uint](0) / stride {
        return false
    }
    let mapped: Ref[byte]? = internal.memory.map_zeroed(count * stride,
        internal.abi.alignment_bytes(row))
    if mapped != nil {
        let base: Ref[byte] = mapped.get()
        var used: uint      = 0
        index = 1
        while index < internal.abi.storage_count() {
            let storage: Ref[internal.abi.Storage_Record]? = internal.abi.storage_at(index)
            if storage != nil {
                if storage.get().segment_kind == cast[u32](internal.abi.Storage_Kind.tls) {
                    let address: Ref[byte]? = internal.abi.storage_address(index)
                    if address != nil {
                        let entry: Ref[TLS_Root_Entry] = tls_root_entry_at(base, used)
                        entry.address = address.get()
                        entry.type_index = storage.get().type_index
                        used += 1
                    } else {
                        internal.memory.unmap(base, count * stride)
                        return false
                    }
                }
            }
            index += 1
        }
        require used == count
        mutator.tls_roots = base
        mutator.ntls_roots = count
        return true
    }
    return false
}

func tls_root_at(mutator: Ref[internal.gc.core.Mutator], index: uint) -> Ref[TLS_Root_Entry] {
    require index < mutator.ntls_roots
    let storage: Ref[byte]? = mutator.tls_roots
    if storage != nil {
        return tls_root_entry_at(storage.get(), index)
    }
    require false
}

func free_tls(mutator: Ref[internal.gc.core.Mutator]) {
    let storage: Ref[byte]? = mutator.tls_roots
    if storage != nil {
        internal.memory.unmap(storage.get(), mutator.ntls_roots
            * internal.abi.size_bytes(tls_root_record()))
    }
    mutator.tls_roots = nil
    mutator.ntls_roots = 0
}

func root_entry_record() -> Ref[internal.abi.Type_Record] {
    let probe: Ref[Root_Entry]?              = nil
    let row:   Ref[internal.abi.Type_Record]? = internal.abi.optional_reference_target(typeof(probe))
    if row != nil {
        return row.get()
    }
    require false
}

func root_entry_at(base: Ref[byte], index: uint, stride: uint) -> Ref[Root_Entry] {
    let address: Ref[byte] = __gc_byte_offset(base, index * stride)
    return unsafe_cast[Ref[Root_Entry]] address
}

func depth(mutator: Ref[internal.gc.core.Mutator]) -> uint {
    return mutator.nroots
}

func push(mutator: Ref[internal.gc.core.Mutator], slot: Ref[Ref[byte]?]) -> bool {
    let row:    Ref[internal.abi.Type_Record] = root_entry_record()
    let stride: uint                         = internal.abi.size_bytes(row)
    if !internal.gc.heap.grow_array(ref mutator.roots, ref mutator.cap_roots,
                                    stride, internal.abi.alignment_bytes(row),
                                    mutator.nroots, mutator.nroots + 1) {
        return false
    }
    let storage: Ref[byte]? = mutator.roots
    if storage != nil {
        let entry: Ref[Root_Entry] = root_entry_at(storage.get(),
                                                   mutator.nroots, stride)
        entry.slot = slot
        __gc_signal_fence()
        mutator.nroots += 1
        return true
    }
    require false
}

func slot_at(mutator: Ref[internal.gc.core.Mutator], index: uint) -> Ref[Ref[byte]?] {
    require index < mutator.nroots
    let storage: Ref[byte]? = mutator.roots
    if storage != nil {
        let stride: uint = internal.abi.size_bytes(root_entry_record())
        return root_entry_at(storage.get(), index, stride).slot
    }
    require false
}

func pop(mutator: Ref[internal.gc.core.Mutator], target_depth: uint) {
    require target_depth <= mutator.nroots
    __gc_signal_fence()
    mutator.nroots = target_depth
}

func free(mutator: Ref[internal.gc.core.Mutator]) {
    let storage: Ref[byte]? = mutator.roots
    if storage != nil {
        let stride: uint = internal.abi.size_bytes(root_entry_record())
        internal.memory.unmap(storage.get(), mutator.cap_roots * stride)
    }
    mutator.roots = nil
    mutator.nroots = 0
    mutator.cap_roots = 0
}

func global_pointer_record() -> Ref[internal.abi.Type_Record] {
    let probe: Ref[Ref[byte]?]?              = nil
    let row:   Ref[internal.abi.Type_Record]? = internal.abi.type_for(typeof(probe))
    if row != nil {
        return row.get()
    }
    require false
}

func global_pointer_at(heap: Ref[internal.gc.core.Heap], index: uint) -> Ref[Ref[Ref[byte]?]] {
    let storage: Ref[byte]? = heap.globals
    if storage != nil {
        let stride:  uint      = internal.abi.size_bytes(global_pointer_record())
        let address: Ref[byte] = __gc_byte_offset(storage.get(), index * stride)
        return unsafe_cast[Ref[Ref[Ref[byte]?]]] address
    }
    require false
}

func global_slot_at(heap: Ref[internal.gc.core.Heap], index: uint) -> Ref[Ref[byte]?] {
    require index < heap.nglobals
    return global_pointer_at(heap, index).__value
}

func add_global(heap: Ref[internal.gc.core.Heap], slot: Ref[Ref[byte]?]) -> bool {
    internal.gc.sync.ticket_lock(ref heap.lock)
    let key:     uint                         = __abi_ref_address(slot)
    let pointer: Ref[internal.abi.Type_Record] = global_pointer_record()
    let grown:   bool                         = internal.gc.heap.grow_array(ref heap.globals,
        ref heap.cap_globals, internal.abi.size_bytes(pointer),
        internal.abi.alignment_bytes(pointer), heap.nglobals,
        heap.nglobals + 1)
    var added: bool = false
    if grown and internal.gc.hash.index_tab_reserve(ref heap.global_index, 1) {
        global_pointer_at(heap, heap.nglobals).__value = slot
        internal.gc.hash.index_tab_insert(ref heap.global_index, key,
            heap.nglobals + 1)
        heap.nglobals += 1
        added = true
    }
    internal.gc.heap.unlock(heap)
    return added
}

func remove_global(heap: Ref[internal.gc.core.Heap], slot: Ref[Ref[byte]?]) {
    internal.gc.sync.ticket_lock(ref heap.lock)
    let key:     uint = __abi_ref_address(slot)
    let indexed: uint = internal.gc.hash.index_tab_lookup(ref heap.global_index, key)
    if indexed != 0 {
        let index: uint = indexed - 1
        let last:  uint = heap.nglobals - 1
        internal.gc.hash.index_tab_delete(ref heap.global_index, key, indexed)
        if index != last {
            let moved: Ref[Ref[byte]?] = global_pointer_at(heap, last).__value
            global_pointer_at(heap, index).__value = moved
            internal.gc.hash.index_tab_find(ref heap.global_index,
                __abi_ref_address(moved), last + 1).val = index + 1
        }
        heap.nglobals = last
    }
    internal.gc.heap.unlock(heap)
}
