import internal.abi
import internal.box
import internal.gc.alloc
import internal.threads

func payload_in_current_stack(address: uint) -> bool {
    let high: Ref[byte]? = internal.threads.thread_stack_high_self()
    if high == nil {
        return false
    }
    return address >= internal.threads.stack_address()
        and address < __abi_ref_address(high)
}

func escape_box(slot: Ref[Any]) {
    let view: Ref[internal.abi.Box_Value] = internal.box.box_view(slot)
    let bytes: uint = internal.box.payload_bytes(view.__value.type_field)
    let storage: Ref[byte]? = view.__value.payload
    if bytes == 0 or storage == nil {
        return
    }
    let origin: Ref[byte] = storage
    if payload_in_current_stack(__abi_ref_address(origin)) {
        let index: u32 = view.__value.type_field & 0x7fffffff
        let copy: Ref[byte]? = internal.gc.alloc.allocate_runtime(index,
            bytes, internal.box.type_row(index).__value.alignment_bytes, nil)
        require copy != nil
        __gc_memcpy(copy, origin, bytes)
        view.__value.payload = copy
    }
    escape_box_inner(slot)
}

func escape_box_inner(slot: Ref[Any]) {
    let view: Ref[internal.abi.Box_Value] = internal.box.box_view(slot)
    let index: u32 = view.__value.type_field & 0x7fffffff
    let row: Ref[internal.abi.Type_Record] = internal.box.type_row(index)
    if row.__value.kind == cast[u32](internal.abi.Type_Kind.box_type) {
        let storage: Ref[byte]? = view.__value.payload
        if storage != nil {
            escape_box(unsafe_cast[Ref[Any]] storage)
        }
        return
    }
    if row.__value.kind != cast[u32](internal.abi.Type_Kind.record_type)
        and row.__value.kind != cast[u32](internal.abi.Type_Kind.tuple_type) {
        return
    }
    if row.__value.size_bits <= 64 {
        escape_fields(__gc_byte_offset(unsafe_cast[Ref[byte]] slot, 8), row)
        return
    }
    let storage: Ref[byte]? = view.__value.payload
    if storage != nil {
        escape_fields(storage, row)
    }
}

func escape_nested(address: Ref[byte], type_index: u32) {
    let row: Ref[internal.abi.Type_Record] = internal.box.type_row(type_index)
    if row.__value.kind == cast[u32](internal.abi.Type_Kind.box_type) {
        escape_box(unsafe_cast[Ref[Any]] address)
    }
    elif row.__value.kind == cast[u32](internal.abi.Type_Kind.record_type)
        or row.__value.kind == cast[u32](internal.abi.Type_Kind.tuple_type) {
        escape_fields(address, row)
    }
}

func escape_fields(address: Ref[byte], row: Ref[internal.abi.Type_Record]) {
    var at: u32 = 0
    while at < row.__value.fields_or_arms.count {
        let field: Ref[internal.abi.Field_Record] = internal.box.field_row(
            row, at)
        at += 1
        if field.__value.physical_runs.count != 1 {
            continue
        }
        let run: Ref[internal.abi.Physical_Run_Record] = internal.box.run_at(
            field.__value.physical_runs, 0)
        if run.__value.bit_offset != 0 {
            continue
        }
        escape_nested(__gc_byte_offset(address, run.__value.byte_offset),
                      field.__value.child_type_index)
    }
}

func value_bytes(value: Ref[Any],
                row: Ref[internal.abi.Type_Record]) -> Ref[byte] {
    if row.__value.size_bits <= 64 {
        return __gc_byte_offset(unsafe_cast[Ref[byte]] value, 8)
    }
    let storage: Ref[byte]? = internal.box.box_view(value).__value.payload
    require storage != nil
    return storage
}

func store_known(address: Ref[byte], value: Ref[Any], index: u32,
                        row: Ref[internal.abi.Type_Record]) {
    let source: Ref[byte] = value_bytes(value, row)
    internal.gc.alloc.barrier_runtime(source, index)
    __gc_memcpy(address, source, (row.__value.size_bits + 7) / 8)
}

func array_leaf(type_index: u32, depth: u32) -> u32 {
    var leaf: u32 = type_index
    var level: u32 = 0
    while level < depth {
        leaf = internal.box.component_of(leaf,
                                         internal.abi.Type_Kind.array_type)
        level += 1
    }
    return leaf
}

func array_alignment(leaf: Ref[internal.abi.Type_Record]) -> u64 {
    let alignment: u64 = cast[u64](leaf.__value.alignment_bytes)
    require alignment != 0 and alignment & (alignment - 1) == 0
    if alignment < 8 {
        return 8
    }
    return alignment
}

func array_data_bytes(leaf: Ref[internal.abi.Type_Record], count: u64,
                      origin_bits: u64, alignment: u64) -> u64 {
    let packed: u64 = cast[u64](internal.abi.packed_array_stride_bits(leaf))
    if packed != 0 {
        return (count * packed + origin_bits + 7) / 8
    }
    let alignment_bits: u64 = alignment * 8
    return count * (((leaf.__value.size_bits + alignment_bits - 1) / alignment_bits)
                    * alignment)
}

func set_array_value(slot: Ref[Any], data: Ref[byte],
                     descriptor: Ref[byte]) {
    let storage: Ref[byte]? = internal.box.box_view(slot).__value.payload
    require storage != nil
    let value: Ref[internal.abi.Array_Value] =
        unsafe_cast[Ref[internal.abi.Array_Value]] storage
    value.__value.data = data
    value.__value.descriptor =
        unsafe_cast[Ref[internal.abi.Array_Descriptor_Header]] descriptor
}

func new_array(type_index: u32, count: u64, rank: u32, flat_rank: u32,
               extents: Ref[byte], shape: Ref[byte], slot: Ref[Any]) {
    require rank != 0 and flat_rank != 0 and flat_rank <= rank
    let leaf: Ref[internal.abi.Type_Record] = internal.box.type_row(
        array_leaf(type_index, flat_rank))
    let alignment: u64 = array_alignment(leaf)
    let descriptor_bytes: u64 = 24 + cast[u64](rank) * 8
    let data_offset: u64 = (descriptor_bytes + alignment - 1)
        & ~(alignment - 1)
    let data_bytes: u64 = array_data_bytes(leaf, count, 0, alignment)
    var reserved: u64 = data_bytes
    if reserved == 0 {
        reserved = 1
    }
    let header: Ref[internal.abi.Array_Descriptor_Header] =
        unsafe_cast[Ref[internal.abi.Array_Descriptor_Header]] shape
    header.__value.total_count = count
    header.__value.rank = rank
    header.__value.flat_rank = flat_rank
    header.__value.flags = 0
    header.__value.reserved_zero = 0
    var level: u32 = 0
    while level < rank {
        var extent: u64 = 0
        if level < flat_rank {
            extent = (unsafe_cast[Ref[u64]] __gc_byte_offset(extents,
                cast[uint](level) * 8)).__value
        }
        (unsafe_cast[Ref[u64]] __gc_byte_offset(shape,
            24 + cast[uint](level) * 8)).__value = extent
        level += 1
    }
    let storage: Ref[byte]? = internal.gc.alloc.allocate_runtime(type_index,
        data_offset + reserved, cast[u32] alignment, header)
    require storage != nil
    set_array_value(slot, __gc_byte_offset(storage, data_offset),
                    storage)
}

func copy_array(source: Ref[Any], slot: Ref[Any]) {
    let view: Ref[internal.abi.Box_Value] = internal.box.box_view(source)
    let type_index: u32 = view.__value.type_field & 0x7fffffff
    require internal.box.type_row(type_index).__value.kind
        == cast[u32](internal.abi.Type_Kind.array_type)
    let storage: Ref[byte]? = view.__value.payload
    require storage != nil
    let array: Ref[internal.abi.Array_Value] =
        unsafe_cast[Ref[internal.abi.Array_Value]] storage
    let header: Ref[internal.abi.Array_Descriptor_Header]? = array.__value.descriptor
    require header != nil
    let descriptor: Ref[internal.abi.Array_Descriptor_Header] = header
    require descriptor.__value.rank != 0 and descriptor.__value.flat_rank != 0
        and descriptor.__value.flat_rank <= descriptor.__value.rank
        and descriptor.__value.flags & 0xfffffff8 == 0
    let leaf: Ref[internal.abi.Type_Record] = internal.box.type_row(
        array_leaf(type_index, descriptor.__value.flat_rank))
    let alignment: u64 = array_alignment(leaf)
    let header_bytes: u64 = 24 + cast[u64](descriptor.__value.rank) * 8
    let data_offset: u64 = (header_bytes + alignment - 1) & ~(alignment - 1)
    let data_bytes: u64 = array_data_bytes(leaf, descriptor.__value.total_count,
        cast[u64](descriptor.__value.flags), alignment)
    var reserved: u64 = data_bytes
    if reserved == 0 {
        reserved = 1
    }
    let backing: Ref[byte]? = internal.gc.alloc.allocate_runtime(type_index,
        data_offset + reserved, cast[u32] alignment, descriptor)
    require backing != nil
    __gc_memcpy(backing, unsafe_cast[Ref[byte]] descriptor,
                header_bytes)
    let data: Ref[byte] = __gc_byte_offset(backing, data_offset)
    if data_bytes != 0 {
        let old: Ref[byte]? = array.__value.data
        require old != nil
        __gc_memcpy(data, old, data_bytes)
    }
    set_array_value(slot, data, backing)
}

func array_prefix(source: Ref[Any], count: u64, slot: Ref[Any]) {
    let view: Ref[internal.abi.Box_Value] = internal.box.box_view(source)
    let type_index: u32 = view.__value.type_field & 0x7fffffff
    require internal.box.type_row(type_index).__value.kind
        == cast[u32](internal.abi.Type_Kind.array_type)
    let storage: Ref[byte]? = view.__value.payload
    require storage != nil
    let value: Ref[internal.abi.Array_Value] =
        unsafe_cast[Ref[internal.abi.Array_Value]] storage
    let header: Ref[internal.abi.Array_Descriptor_Header]? = value.__value.descriptor
    require header != nil
    let descriptor: Ref[internal.abi.Array_Descriptor_Header] = header
    let length: u64 = (unsafe_cast[Ref[u64]] __gc_byte_offset(
        unsafe_cast[Ref[byte]] descriptor, 24)).__value
    require descriptor.__value.rank == 1 and descriptor.__value.flat_rank == 1
        and descriptor.__value.reserved_zero == 0 and count <= descriptor.__value.total_count
        and count <= length
    let block: Ref[byte]? = internal.gc.alloc.allocate_runtime(type_index,
        48, 8, nil)
    require block != nil
    let prefix: Ref[internal.abi.Array_Value] =
        unsafe_cast[Ref[internal.abi.Array_Value]] block
    let shape: Ref[byte] = __gc_byte_offset(block, 16)
    __gc_memcpy(shape, unsafe_cast[Ref[byte]] descriptor, 24)
    let shape_header: Ref[internal.abi.Array_Descriptor_Header] =
        unsafe_cast[Ref[internal.abi.Array_Descriptor_Header]] shape
    shape_header.__value.total_count = count
    (unsafe_cast[Ref[u64]] __gc_byte_offset(shape, 24)).__value = count
    prefix.__value.data = value.__value.data
    prefix.__value.descriptor = shape_header
    let slot_view = internal.box.box_view(slot)
    slot_view.__value.extent = 0
    slot_view.__value.stride = 0
    slot_view.__value.type_field = type_index
    slot_view.__value.payload = block
}

func row_item_bits(leaf: Ref[internal.abi.Type_Record]) -> u64 {
    let packed: u64 = cast[u64](internal.abi.packed_array_stride_bits(leaf))
    if packed != 0 {
        return packed
    }
    let alignment_bits: u64 = cast[u64](leaf.__value.alignment_bytes) * 8
    require alignment_bits != 0
    return ((leaf.__value.size_bits + alignment_bits - 1) / alignment_bits) *
        alignment_bits
}

func extent_at(descriptor: Ref[internal.abi.Array_Descriptor_Header],
               level: u32) -> u64 {
    return (unsafe_cast[Ref[u64]] __gc_byte_offset(
        unsafe_cast[Ref[byte]] descriptor, 24 + cast[uint](level) * 8)).__value
}

func array_row(source: Ref[Any], index: i64, slot: Ref[Any]) {
    var array_type: u32 = 0
    let array: Ref[internal.abi.Array_Value] = internal.box.array_value_of(
        source, ref array_type)
    let header: Ref[internal.abi.Array_Descriptor_Header]? = array.__value.descriptor
    let data: Ref[byte]? = array.__value.data
    require header != nil and data != nil
    let descriptor: Ref[internal.abi.Array_Descriptor_Header] = header
    let position: u64 = internal.box.array_position(descriptor, index)
    let child: u32 = internal.box.component_of(array_type,
        internal.abi.Type_Kind.array_type)
    var rank: u32 = 1
    var leaf_index: u32 = child
    while internal.box.type_row(leaf_index).__value.kind
        == cast[u32](internal.abi.Type_Kind.array_type) {
        leaf_index = internal.box.component_of(leaf_index,
            internal.abi.Type_Kind.array_type)
        rank += 1
    }
    let leaf: Ref[internal.abi.Type_Record] = internal.box.type_row(
        leaf_index)
    let first_extent: u64 = extent_at(descriptor, 0)
    require rank == descriptor.__value.rank and rank >= 2
        and descriptor.__value.flat_rank >= 2 and descriptor.__value.flat_rank <= rank
        and leaf.__value.alignment_bytes != 0 and first_extent != 0
        and descriptor.__value.total_count % first_extent == 0
    let row_count: u64 = descriptor.__value.total_count / first_extent
    let packed: bool = internal.abi.packed_array_stride_bits(leaf) != 0
    let bit_offset: u64 = position * row_count * row_item_bits(leaf) +
        cast[u64](descriptor.__value.flags)
    var origin: u32 = 0
    if packed {
        origin = cast[u32](bit_offset & 7)
    }
    else {
        require bit_offset & 7 == 0
    }
    let block: Ref[byte]? = internal.gc.alloc.allocate_runtime(child,
        40 + cast[uint](rank - 1) * 8, 8, nil)
    require block != nil
    let shape: Ref[byte] = __gc_byte_offset(block, 16)
    let suffix: Ref[internal.abi.Array_Descriptor_Header] =
        unsafe_cast[Ref[internal.abi.Array_Descriptor_Header]] shape
    suffix.__value.total_count = row_count
    suffix.__value.rank = rank - 1
    suffix.__value.flat_rank = descriptor.__value.flat_rank - 1
    suffix.__value.flags = origin
    suffix.__value.reserved_zero = 0
    var level: u32 = 1
    while level < rank {
        (unsafe_cast[Ref[u64]] __gc_byte_offset(shape,
            24 + cast[uint](level - 1) * 8)).__value =
            extent_at(descriptor, level)
        level += 1
    }
    let value: Ref[internal.abi.Array_Value] =
        unsafe_cast[Ref[internal.abi.Array_Value]] block
    value.__value.data = __gc_byte_offset(data, bit_offset / 8)
    value.__value.descriptor = suffix
    let slot_view = internal.box.box_view(slot)
    slot_view.__value.extent = 0
    slot_view.__value.stride = 0
    slot_view.__value.type_field = child
    slot_view.__value.payload = block
}

func copy_bit(source: Ref[byte], source_bit: u64, target: Ref[byte],
              target_bit: u64) {
    let from: byte = __gc_byte_offset(source, source_bit / 8).__value
    let into: Ref[byte] = __gc_byte_offset(target, target_bit / 8)
    let existing: byte = into.__value
    let mask: u32 = 1 << cast[u32](target_bit & 7)
    var next: u32 = cast[u32](existing) & ~mask
    if (cast[u32](from) >> cast[u32](source_bit & 7)) & 1 != 0 {
        next = cast[u32](existing) | mask
    }
    into.__value = cast[byte](next & 0xff)
}

func array_replace_row(destination: Ref[Any], index: i64,
                       value: Ref[Any]) {
    var array_type: u32 = 0
    let target_array: Ref[internal.abi.Array_Value] =
        internal.box.array_value_of(destination, ref array_type)
    let header: Ref[internal.abi.Array_Descriptor_Header]? =
        target_array.__value.descriptor
    let target: Ref[byte]? = target_array.__value.data
    let source_storage: Ref[byte]? = internal.box.box_view(value).__value.payload
    require header != nil and target != nil and source_storage != nil
    let descriptor: Ref[internal.abi.Array_Descriptor_Header] = header
    let position: u64 = internal.box.array_position(descriptor, index)
    require descriptor.__value.flat_rank >= 2
        and descriptor.__value.flat_rank <= descriptor.__value.rank
    let source_array: Ref[internal.abi.Array_Value] =
        unsafe_cast[Ref[internal.abi.Array_Value]] source_storage
    let source_header: Ref[internal.abi.Array_Descriptor_Header]? =
        source_array.__value.descriptor
    let from: Ref[byte]? = source_array.__value.data
    require source_header != nil and from != nil
    let source_descriptor: Ref[internal.abi.Array_Descriptor_Header] =
        source_header
    let first_extent: u64 = extent_at(descriptor, 0)
    require first_extent != 0 and descriptor.__value.total_count % first_extent == 0
        and source_descriptor.__value.rank == descriptor.__value.rank - 1
        and source_descriptor.__value.flat_rank == descriptor.__value.flat_rank - 1
        and source_descriptor.__value.flags & 0xfffffff8 == 0
    let row_count: u64 = descriptor.__value.total_count / first_extent
    require source_descriptor.__value.total_count == row_count
    var level: u32 = 1
    while level < descriptor.__value.rank {
        require extent_at(source_descriptor, level - 1)
            == extent_at(descriptor, level)
        level += 1
    }
    var leaf_index: u32 = internal.box.component_of(array_type,
        internal.abi.Type_Kind.array_type)
    level = 1
    while level < descriptor.__value.flat_rank {
        leaf_index = internal.box.component_of(leaf_index,
            internal.abi.Type_Kind.array_type)
        level += 1
    }
    let leaf: Ref[internal.abi.Type_Record] = internal.box.type_row(
        leaf_index)
    let packed: bool = internal.abi.packed_array_stride_bits(leaf) != 0
    let item_bits: u64 = row_item_bits(leaf)
    let row_bits: u64 = row_count * item_bits
    let destination_start: u64 = position * row_bits +
        cast[u64](descriptor.__value.flags)
    let source_start: u64 = cast[u64](source_descriptor.__value.flags)
    let target_byte: uint = __abi_ref_address(target) +
        destination_start / 8
    let source_byte: uint = __abi_ref_address(from) + source_start / 8
    let reverse: bool = target_byte > source_byte
        or (target_byte == source_byte
            and destination_start & 7 > source_start & 7)
    if !packed {
        require destination_start & 7 == 0 and source_start & 7 == 0
            and row_bits & 7 == 0
        let stride: u64 = item_bits / 8
        var item: u64 = 0
        while item < row_count {
            internal.gc.alloc.barrier_runtime(__gc_byte_offset(from,
                source_start / 8 + item * stride), leaf_index)
            item += 1
        }
        let bytes: u64 = row_bits / 8
        var at: u64 = 0
        while at < bytes {
            var offset: u64 = at
            if reverse {
                offset = bytes - 1 - at
            }
            let source_at: byte = __gc_byte_offset(from,
                source_start / 8 + offset).__value
            __gc_byte_offset(target,
                destination_start / 8 + offset).__value = source_at
            at += 1
        }
        return
    }
    var bit: u64 = 0
    while bit < row_bits {
        var offset: u64 = bit
        if reverse {
            offset = row_bits - 1 - bit
        }
        copy_bit(from, source_start + offset, target,
                 destination_start + offset)
        bit += 1
    }
}

func empty_location() -> internal.box.Location {
    return (address = nil, type_index = 0, reserved = 0, bit_offset = 0,
            width = 0)
}

func ref_set(target: Ref['T], value: 'T) {
    var location: internal.box.Location = empty_location()
    internal.box.reference_locate(__box_of(target), ref location)
    let slot: Ref[Any] = __box_of(value)
    escape_box_inner(slot)
    write_at(ref location, slot)
}

func option_set(target: Ref['T?], value: 'T?) {
    let reference: Ref[Any] = __box_of(target)
    let location: internal.box.Location = internal.box.option_storage(
        reference)
    let stored: Ref[byte]? = location.address
    require stored != nil
    let address: Ref[byte] = stored
    if value == nil {
        __gc_memset(address, 0, cast[uint]((location.width + 7) / 8))
        return
    }
    ref_set(internal.box.option_payload(target), value)
    builtin.__set_tag_at(location.type_index, address, 1)
}

func array_set_option(items: Ref[Array['T?]], index: i64,
                             value: 'T?) {
    let target: Ref[Any] = __box_of(items)
    let location: internal.box.Location = internal.box.element_storage(
        target, index)
    let stored: Ref[byte]? = location.address
    require stored != nil
    if value == nil {
        __gc_memset(stored, 0, cast[uint]((location.width + 7) / 8))
        return
    }
    ref_set(internal.box.element_payload_at(items, index), value)
    builtin.__set_tag_at(location.type_index, stored, 1)
}

func array_set_option_unsigned(items: Ref[Array['T?]], index: u64,
                                      value: 'T?) {
    require index <= 0x7fffffffffffffff
    array_set_option(items, cast[i64] index, value)
}

func array_get(items: Array['T], index: i64) -> 'T {
    var location: internal.box.Location = empty_location()
    let source: Ref[Any] = __box_of(items)
    if internal.box.array_locate(source, index, ref location) {
        internal.box.read_at(ref location, __result_box())
    }
    else {
        array_row(source, index, __result_box())
    }
    return __box_as(__result_box())
}

func array_get_unsigned(items: Array['T], index: u64) -> 'T {
    require index <= 0x7fffffffffffffff
    return array_get(items, cast[i64] index)
}

func record_new() -> 'R {
    return __box_as(__result_box())
}

func variant_new(physical: u64) -> 'V {
    let slot: Ref[Any] = __result_box()
    builtin.__box_set_tag(unsafe_cast[Ref[builtin.Box_Record]] slot,
                          physical)
    return __box_as(slot)
}

func field_put(owner: 'R, ordinal: u32, value: 'F) {
    var location: internal.box.Location = empty_location()
    internal.box.field_locate(__box_of(owner), nil, 0, ordinal,
                              ref location)
    let slot: Ref[Any] = __box_of(value)
    escape_box_inner(slot)
    write_at(ref location, slot)
}

record Single_Shape layout(c) {
    total_count:   u64
    rank:          u32
    flat_rank:     u32
    flags:         u32
    reserved_zero: u32
    extent:        u64
}

func array_with_length(count: uint) -> Array['T] {
    let slot: Ref[Any] = __result_box()
    var extent: u64 = count
    var shape: Single_Shape = (total_count = 0, rank = 0, flat_rank = 0,
                               flags = 0, reserved_zero = 0, extent = 0)
    new_array(internal.box.box_view(slot).__value.type_field & 0x7fffffff, count, 1,
              1, unsafe_cast[Ref[byte]] ref extent,
              unsafe_cast[Ref[byte]] ref shape, slot)
    return __box_as(slot)
}

func array_with_shape(count: uint, rank: u32, flat_rank: u32,
                             scratch: Ref['S]) -> Array['T] {
    let slot: Ref[Any] = __result_box()
    let shape: Ref[byte] = internal.box.reference_address(__box_of(scratch))
    new_array(internal.box.box_view(slot).__value.type_field & 0x7fffffff, count,
              rank, flat_rank,
              __gc_byte_offset(shape, 24 + cast[uint](rank) * 8), shape, slot)
    return __box_as(slot)
}

func array_copy(items: Array['T]) -> Array['T] {
    copy_array(__box_of(items), __result_box())
    return __box_as(__result_box())
}

func array_put(items: Array['T], index: i64, value: 'T) {
    var location: internal.box.Location = empty_location()
    let slot: Ref[Any] = __box_of(value)
    escape_box_inner(slot)
    require internal.box.array_locate(__box_of(items), index, ref location)
    write_at(ref location, slot)
}

func array_prefix_of(items: Array['T], count: uint) -> Array['T] {
    array_prefix(__box_of(items), count, __result_box())
    return __box_as(__result_box())
}

func array_clear_at(items: Ref[Array['T]], index: uint) {
    var array_type: u32 = 0
    let value: Ref[internal.abi.Array_Value] = internal.box.array_value_of(
        __box_of(items), ref array_type)
    internal.box.array_clear_slot(unsafe_cast[Ref[byte]] value, array_type,
                                  index)
}

func new_storage() -> Ref['T] {
    let slot: Ref[Any] = __result_box()
    new_reference(internal.box.component_of(
        internal.box.box_view(slot).__value.type_field,
        internal.abi.Type_Kind.reference_type), slot)
    return __box_as(slot)
}

func array_ref(items: Ref[Array['T]], index: i64) -> Ref['T] {
    var location: internal.box.Location = empty_location()
    require internal.box.array_locate(__box_of(items), index, ref location)
    internal.box.reference_at(ref location, __result_box())
    return __box_as(__result_box())
}

func array_ref_unsigned(items: Ref[Array['T]],
                               index: u64) -> Ref['T] {
    require index <= 0x7fffffffffffffff
    return array_ref(items, cast[i64] index)
}

func array_set(items: Ref[Array['T]], index: i64, value: 'T) {
    var location: internal.box.Location = empty_location()
    let target: Ref[Any] = __box_of(items)
    let slot: Ref[Any] = __box_of(value)
    escape_box_inner(slot)
    if internal.box.array_locate(target, index, ref location) {
        write_at(ref location, slot)
    }
    else {
        array_replace_row(target, index, slot)
    }
}

func array_set_unsigned(items: Ref[Array['T]], index: u64,
                               value: 'T) {
    require index <= 0x7fffffffffffffff
    array_set(items, cast[i64] index, value)
}

func new_reference(type_index: u32, slot: Ref[Any]) {
    let row: Ref[internal.abi.Type_Record] = internal.box.type_row(type_index)
    var bytes: uint = (row.__value.size_bits + 7) / 8
    if bytes == 0 {
        bytes = 1
    }
    let target: Ref[byte]? = internal.gc.alloc.allocate_runtime(type_index,
        bytes, row.__value.alignment_bytes, nil)
    require target != nil
    let view: Ref[internal.abi.Box_Value] = internal.box.box_view(slot)
    let reference: Ref[internal.abi.Type_Record] = internal.box.type_row(
        view.__value.type_field & 0x7fffffff)
    if reference.__value.size_bits == 64 {
        view.__value.payload = target
        return
    }
    let storage: Ref[byte]? = view.__value.payload
    require reference.__value.size_bits == 128 and storage != nil
        and row.__value.semantic_width_bits != 0
        and row.__value.semantic_width_bits <= 0xffff
    let bits: Ref[internal.abi.Bitptr_Value] =
        unsafe_cast[Ref[internal.abi.Bitptr_Value]] storage
    bits.__value.base = target
    bits.__value.type_index = type_index
    bits.__value.start_bit = 0
    bits.__value.end_bit = cast[u16](row.__value.semantic_width_bits)
}

func barrier_box(value: Ref[Any]) {
    let view: Ref[internal.abi.Box_Value] = internal.box.box_view(value)
    let index: u32 = view.__value.type_field & 0x7fffffff
    let row: Ref[internal.abi.Type_Record] = internal.box.type_row(index)
    if view.__value.type_field & 0x80000000 != 0 or row.__value.size_bits > 64 {
        let storage: Ref[byte]? = view.__value.payload
        require storage != nil
        internal.gc.alloc.barrier_runtime(storage, index)
        return
    }
    internal.gc.alloc.barrier_runtime(
        __gc_byte_offset(unsafe_cast[Ref[byte]] value, 8), index)
}

func store(address: Ref[byte], value: Ref[Any]) {
    let index: u32 = internal.box.box_view(value).__value.type_field & 0x7fffffff
    store_known(address, value, index, internal.box.type_row(index))
}

func write_at(location: Ref[internal.box.Location], value: Ref[Any]) {
    let index: u32 = internal.box.box_view(value).__value.type_field & 0x7fffffff
    require index == location.__value.type_index
    let child: Ref[internal.abi.Type_Record] = internal.box.type_row(index)
    let address: Ref[byte]? = location.__value.address
    require address != nil
    if location.__value.bit_offset == 0 and location.__value.width == child.__value.size_bits
        and location.__value.width & 7 == 0 {
        store_known(address, value, index, child)
        return
    }
    let source: Ref[byte] = value_bytes(value, child)
    var bit: uint = 0
    while bit < location.__value.width {
        let target_bit: uint = location.__value.bit_offset + bit
        let from: byte = __gc_byte_offset(source, bit / 8).__value
        let into: Ref[byte] = __gc_byte_offset(address, target_bit / 8)
        let existing: byte = into.__value
        let current: u32 = cast[u32](existing)
        let mask: u32 = 1 << cast[u32](target_bit & 7)
        var next: u32 = current & ~mask
        if (cast[u32](from) >> cast[u32](bit & 7)) & 1 != 0 {
            next = current | mask
        }
        into.__value = cast[byte](next & 0xff)
        bit += 1
    }
}
