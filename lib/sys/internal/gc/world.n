import internal.gc.core
import internal.threads

var world_owner: Atomic[uint] = 0

func stop(heap: Ref[internal.gc.core.Heap]) {
    let owner: uint = internal.threads.thread_id()
    require owner != 0
    while !__atomic_compare_exchange(ref world_owner, 0, owner) {
        internal.threads.cpu_relax()
    }

    let timeout_ns: u64                      = cast[u64](heap.cfg.world_timeout_ms) * 1000000
    var current:    Ref[internal.gc.core.Mutator]? = heap.mutators
    while current != nil {
        let mutator: Ref[internal.gc.core.Mutator] = current.get()
        if mutator.thread_primary and mutator.thread_id != owner {
            require internal.threads.thread_suspend(mutator.thread_control,
                                              ref mutator.captured,
                                              timeout_ns) == 0
            mutator.ctx_valid = true
        }
        current = mutator.next
    }
    internal.threads.thread_fence()
}

func start(heap: Ref[internal.gc.core.Heap]) {
    let owner: uint = internal.threads.thread_id()
    require __atomic_load(ref world_owner) == owner
    internal.threads.thread_fence()
    var current: Ref[internal.gc.core.Mutator]? = heap.mutators
    while current != nil {
        let mutator: Ref[internal.gc.core.Mutator] = current.get()
        if mutator.thread_primary and mutator.thread_id != owner {
            require mutator.ctx_valid
            require internal.threads.thread_resume(mutator.thread_control,
                                             ref mutator.captured) == 0
        }
        current = mutator.next
    }
    __atomic_store(ref world_owner, 0)
}
