import internal.abi
import internal.gc.core
import internal.gc.heap
import internal.gc.mark
import internal.gc.sync
import internal.gc.handshake

func notify(heap: Ref[internal.gc.core.Heap]) {
    if !__atomic_exchange(ref heap.fin_notify, false) {
        return
    }
    let ready: Ref[(Ref[byte]?) -> nil]? = heap.cfg.finalizers_ready
    if ready != nil {
        let handler: Ref[(Ref[byte]?) -> nil] = ready.get()
        handler.call(heap.cfg.telemetry_user)
    }
}

func list_push(heap: Ref[internal.gc.core.Heap], block: Ref[internal.gc.core.Block_Metadata]) {
    var head: Ref[internal.gc.core.Block_Metadata]? = __atomic_load(ref heap.final_blocks)
    let item: Ref[internal.gc.core.Block_Metadata]? = block
    while true {
        block.final_next = head
        if __atomic_compare_exchange(ref heap.final_blocks, head, item) {
            return
        }
        head = __atomic_load(ref heap.final_blocks)
    }
}

func note_block(heap: Ref[internal.gc.core.Heap],
                       block: Ref[internal.gc.core.Block_Metadata]) {
    if !__atomic_load(ref block.in_final) and
        __atomic_compare_exchange(ref block.in_final, false, true) {
        list_push(heap, block)
    }
}

func final_entry_record() -> Ref[internal.abi.Type_Record] {
    let probe: Ref[internal.gc.core.Final_Entry]?  = nil
    let row:   Ref[internal.abi.Type_Record]? = internal.abi.optional_reference_target(typeof(probe))
    if row != nil {
        return row.get()
    }
    require false
}

func final_entry_at(base: Ref[byte], index: uint) -> Ref[internal.gc.core.Final_Entry] {
    let stride: uint = internal.abi.size_bytes(final_entry_record())
    return unsafe_cast[Ref[internal.gc.core.Final_Entry]] __gc_byte_offset(base, index * stride)
}

func collector_fin_lock(heap: Ref[internal.gc.core.Heap]) -> bool {
    if heap.fin_held {
        return false
    }
    internal.gc.sync.ticket_lock(ref heap.fin)
    return true
}

func enqueue(heap: Ref[internal.gc.core.Heap], payload: Ref[byte]) {
    let row:   Ref[internal.abi.Type_Record] = final_entry_record()
    let grown: bool                         = internal.gc.heap.grow_array(ref heap.finq, ref heap.finq_cap,
        internal.abi.size_bytes(row), internal.abi.alignment_bytes(row),
        heap.finq_n, heap.finq_n + 1)
    require grown
    let storage: Ref[byte]? = heap.finq
    if storage != nil {
        final_entry_at(storage.get(), heap.finq_n).payload = payload
        heap.finq_n += 1
        if heap.finq_n == 1 and heap.cfg.finalizers_ready != nil {
            __atomic_store(ref heap.fin_notify, true)
        }
        return
    }
    require false
}

func dead_in_block(marker: Ref[internal.gc.core.Marker],
                   block: Ref[internal.gc.core.Block_Metadata]) {
    let heap:       Ref[internal.gc.core.Heap] = marker.heap
    let epoch:      u32                  = heap.mark_epoch
    let have_marks: bool                 = __atomic_load(ref block.mark_epoch) == epoch
    let first:      uint                 = internal.gc.core.header_lines() * internal.gc.core.line_bytes / internal.gc.core.granule_bytes / internal.gc.core.word_bits
    let words:      uint                 = internal.gc.core.block_bytes / internal.gc.core.granule_bytes / internal.gc.core.word_bits
    let base:       Ref[byte]            = internal.gc.core.block_base(block)
    var index:      uint                 = first
    while index < words {
        let starts: Ref[Atomic[u64]] = internal.gc.core.start_word_at(base, index)
        var dead:   u64              = __atomic_load_acquire(starts)
        if have_marks {
            let marks: Ref[Atomic[u64]] = internal.gc.core.mark_word_at(base, index)
            dead = dead & ~__atomic_load_relaxed(marks)
        }
        while dead != 0 {
            let bit: uint = __count_trailing_zeros(cast[uint](dead))
            dead = dead & (dead - 1)
            let offset: uint                          = (index * internal.gc.core.word_bits + bit) * internal.gc.core.granule_bytes
            let header: Ref[internal.gc.core.Object_Header] = internal.gc.core.block_object_header_at(base, offset)
            if (header.meta & internal.gc.core.obj_final) != 0 {
                header.meta = header.meta & ~internal.gc.core.obj_final
                __atomic_fetch_sub(ref block.nfinal, 1)
                enqueue(heap, internal.gc.core.payload_of(header))
            }
        }
        index += 1
    }
}

func find_dead_locked(marker: Ref[internal.gc.core.Marker]) {
    let heap:   Ref[internal.gc.core.Heap]            = marker.heap
    let locked: bool                            = collector_fin_lock(heap)
    let empty:  Ref[internal.gc.core.Block_Metadata]? = nil
    var blocks: Ref[internal.gc.core.Block_Metadata]? = __atomic_exchange(ref heap.final_blocks, empty)
    let first:  uint                            = heap.finq_n
    while blocks != nil {
        let block: Ref[internal.gc.core.Block_Metadata] = blocks.get()
        blocks = block.final_next
        dead_in_block(marker, block)
        if __atomic_load(ref block.nfinal) != 0 {
            list_push(heap, block)
        } else {
            __atomic_store(ref block.in_final, false)
            if __atomic_load(ref block.nfinal) != 0 {
                note_block(heap, block)
            }
        }
    }

    var link:      Ref[Ref[internal.gc.core.Los_Obj]?] = ref heap.final_los
    var candidate: Ref[internal.gc.core.Los_Obj]?      = ref_read(link)
    while candidate != nil {
        let object: Ref[internal.gc.core.Los_Obj] = candidate.get()
        if (object.hdr.meta & internal.gc.core.obj_final) == 0 {
            ref_write(link, object.final_next)
        } elif __atomic_load(ref object.marked) != heap.mark_epoch {
            object.hdr.meta = object.hdr.meta & ~internal.gc.core.obj_final
            enqueue(heap, internal.gc.core.payload_of(ref object.hdr))
            ref_write(link, object.final_next)
        } else {
            link = ref object.final_next
        }
        candidate = ref_read(link)
    }

    let storage: Ref[byte]? = heap.finq
    if storage != nil {
        var index: uint = first
        while index < heap.finq_n {
            internal.gc.mark.mark_object(marker,
                final_entry_at(storage.get(), index).payload)
            index += 1
        }
    }
    if locked {
        internal.gc.sync.ticket_unlock(ref heap.fin)
    }
}

func mark_locked(marker: Ref[internal.gc.core.Marker]) {
    let heap:    Ref[internal.gc.core.Heap] = marker.heap
    let before:  uint                 = marker.bytes
    let locked:  bool                 = collector_fin_lock(heap)
    let storage: Ref[byte]?           = heap.finq
    if storage != nil {
        var index: uint = 0
        while index < heap.finq_n {
            internal.gc.mark.mark_object(marker,
                final_entry_at(storage.get(), index).payload)
            index += 1
        }
    }
    var running: Ref[internal.gc.core.Final_Batch]? = heap.running
    while running != nil {
        let batch: Ref[internal.gc.core.Final_Batch] = running.get()
        var index: uint                        = 0
        while index < batch.n {
            let payload: Ref[byte]? = batch.objects[index]
            if payload != nil {
                internal.gc.mark.mark_object(marker, payload.get())
            } else {
                require false
            }
            index += 1
        }
        running = batch.next
    }
    if locked {
        internal.gc.sync.ticket_unlock(ref heap.fin)
    }
    marker.bytes = before
}

func run(heap: Ref[internal.gc.core.Heap], maximum: uint) -> uint {
    var batch: internal.gc.core.Final_Batch
    var done:  uint = 0
    while maximum == 0 or done < maximum {
        var count: uint = internal.gc.core.final_batch
        if maximum != 0 and maximum - done < count {
            count = maximum - done
        }
        internal.gc.sync.ticket_lock(ref heap.fin)
        if count > heap.finq_n {
            count = heap.finq_n
        }
        var index: uint = 0
        while index < count {
            let storage: Ref[byte]? = heap.finq
            if storage != nil {
                heap.finq_n -= 1
                let payload: Ref[byte]? = final_entry_at(storage.get(), heap.finq_n).payload
                batch.objects[index] = payload
            } else {
                require false
            }
            index += 1
        }
        if count != 0 {
            batch.n = count
            batch.prev = nil
            let previous: Ref[internal.gc.core.Final_Batch]? = heap.running
            batch.next = previous
            if previous != nil {
                previous.get().prev = ref batch
            }
            heap.running = ref batch
            heap.running_n += count
        }
        internal.gc.sync.ticket_unlock(ref heap.fin)
        if count == 0 {
            break
        }

        internal.gc.sync.event_signal(ref heap.fin_progress)
        index = 0
        while index < count {
            let payload: Ref[byte]? = batch.objects[index]
            if payload != nil {
                let address: Ref[byte] = payload.get()
                __gc_invoke_finalizer(internal.gc.core.header_of(address).type_index,
                                      address)
            } else {
                require false
            }
            index += 1
        }

        internal.gc.sync.ticket_lock(ref heap.fin)
        let previous:  Ref[internal.gc.core.Final_Batch]? = batch.prev
        let following: Ref[internal.gc.core.Final_Batch]? = batch.next
        if previous != nil {
            previous.get().next = following
        } else {
            heap.running = following
        }
        if following != nil {
            following.get().prev = previous
        }
        heap.running_n -= count
        heap.finalizers_run += cast[u64]count
        internal.gc.sync.ticket_unlock(ref heap.fin)
        done += count
    }
    return done
}

func pending(heap: Ref[internal.gc.core.Heap]) -> uint {
    internal.gc.sync.ticket_lock(ref heap.fin)
    let count: uint = heap.finq_n
    internal.gc.sync.ticket_unlock(ref heap.fin)
    return count
}

func backpressure(mutator: Ref[internal.gc.core.Mutator]) {
    let heap:  Ref[internal.gc.core.Heap] = mutator.heap
    let limit: uint                 = heap.cfg.finalizer_backlog_limit
    if limit == 0 or mutator.in_finalizers or pending(heap) <= limit {
        return
    }

    let assist:  bool = heap.cfg.finalizer_assist
    let maximum: uint = ~cast[uint](0)
    var target:  uint = limit / 2
    if assist {
        target = maximum
        if limit <= maximum / 2 {
            target = 2 * limit
        }
    }

    if !assist {
        let ready: Ref[(Ref[byte]?) -> nil]? = heap.cfg.finalizers_ready
        if ready != nil {
            let handler: Ref[(Ref[byte]?) -> nil] = ready.get()
            handler.call(heap.cfg.telemetry_user)
        }
    }

    while true {
        if assist and !__atomic_exchange(ref heap.fin_assisting, true) {
            mutator.in_finalizers = true
            while pending(heap) > limit / 2 and run(heap, internal.gc.core.final_batch) != 0 {
            }
            mutator.in_finalizers = false
            __atomic_store(ref heap.fin_assisting, false)
            internal.gc.sync.event_signal(ref heap.fin_progress)
            return
        }
        if pending(heap) <= target {
            return
        }

        internal.gc.handshake.enter_blocking(mutator)
        while true {
            let seq: u32 = internal.gc.sync.event_enter(ref heap.fin_progress)
            if pending(heap) <= target or
                (assist and !__atomic_load(ref heap.fin_assisting)) {
                internal.gc.sync.event_leave(ref heap.fin_progress)
                break
            }
            internal.gc.sync.event_sleep(ref heap.fin_progress, seq)
            internal.gc.sync.event_leave(ref heap.fin_progress)
        }
        internal.gc.handshake.leave_blocking(mutator)
    }
}
