import internal.memory
import internal.abi

record Hash_Slot layout(c) {
    key: uint
    val: Ref[byte]?
}

record Hash_Tab layout(c) {
    slots: Ref[Hash_Slot]?
    bits:  uint
    n:     uint
}

record Index_Slot layout(c) {
    key: uint
    val: uint
}

record Index_Tab layout(c) {
    slots: Ref[Index_Slot]?
    bits:  uint
    n:     uint
}

func hash_slot_record() -> Ref[internal.abi.Type_Record] {
    let probe: Ref[Hash_Slot]?               = nil
    let row:   Ref[internal.abi.Type_Record]? = internal.abi.optional_reference_target(typeof(probe))
    if row != nil {
        return row.get()
    }
    require false
}

func hash_slot_at(slots: Ref[Hash_Slot], index: uint, stride: uint) -> Ref[Hash_Slot] {
    return __gc_byte_offset(slots, index * stride)
}

func tab_slots(tab: Ref[Hash_Tab]) -> Ref[Hash_Slot] {
    let slots: Ref[Hash_Slot]? = tab.slots
    if slots != nil {
        return slots.get()
    }
    require false
}

inline func tab_home(tab: Ref[Hash_Tab], key: uint) -> uint {
    let mixed: uint = unsafe_mul(key, 0x9e3779b97f4a7c15)
    return mixed >> (64 - tab.bits)
}

inline func tab_lookup(tab: Ref[Hash_Tab], key: uint) -> Ref[byte]? {
    let slots: Ref[Hash_Slot]? = tab.slots
    if slots == nil {
        return nil
    }
    let allocated: Ref[Hash_Slot] = tab_slots(tab)
    let stride:    uint           = internal.abi.size_bytes(hash_slot_record())
    let mask:      uint           = (1 << tab.bits) - 1
    var index:     uint           = tab_home(tab, key)
    while true {
        let slot: Ref[Hash_Slot] = hash_slot_at(allocated, index, stride)
        if slot.val == nil {
            return nil
        }
        if slot.key == key {
            return slot.val
        }
        index = (index + 1) & mask
    }
}

func tab_insert(tab: Ref[Hash_Tab], key: uint, val: Ref[byte]) {
    let slots:  Ref[Hash_Slot] = tab_slots(tab)
    let stride: uint           = internal.abi.size_bytes(hash_slot_record())
    let mask:   uint           = (1 << tab.bits) - 1
    var index:  uint           = tab_home(tab, key)
    while true {
        let slot: Ref[Hash_Slot] = hash_slot_at(slots, index, stride)
        if slot.val == nil {
            slot.key = key
            slot.val = val
            tab.n += 1
            return
        }
        index = (index + 1) & mask
    }
}

func tab_reserve(tab: Ref[Hash_Tab], more: uint) -> bool {
    let stride: uint = internal.abi.size_bytes(hash_slot_record())
    while tab.slots == nil or (tab.n + more) * 2 > (1 << tab.bits) {
        let old:   Ref[Hash_Slot]? = tab.slots
        var count: uint            = 0
        var bits:  uint            = 10
        if old != nil {
            count = 1 << tab.bits
            bits = tab.bits + 1
        }
        let new_count: uint       = 1 << bits
        let alignment: uint       = internal.abi.alignment_bytes(hash_slot_record())
        let mapped:    Ref[byte]? = internal.memory.map_zeroed(new_count * stride, alignment)
        if mapped != nil {
            tab.slots = unsafe_cast[Ref[Hash_Slot]] mapped.get()
            tab.bits = bits
            tab.n = 0
            if old != nil {
                let old_slots: Ref[Hash_Slot] = old.get()
                var index:     uint           = 0
                while index < count {
                    let slot:  Ref[Hash_Slot] = hash_slot_at(old_slots, index, stride)
                    let value: Ref[byte]?     = slot.val
                    if value != nil {
                        tab_insert(tab, slot.key, value.get())
                    }
                    index += 1
                }
                internal.memory.unmap(old_slots, count * stride)
            }
        } else {
            return false
        }
    }
    return true
}

func tab_find(tab: Ref[Hash_Tab], key: uint, val: Ref[byte]) -> Ref[Hash_Slot] {
    let slots:  Ref[Hash_Slot] = tab_slots(tab)
    let stride: uint           = internal.abi.size_bytes(hash_slot_record())
    let mask:   uint           = (1 << tab.bits) - 1
    var index:  uint           = tab_home(tab, key)
    while true {
        let slot:   Ref[Hash_Slot] = hash_slot_at(slots, index, stride)
        let stored: Ref[byte]?     = slot.val
        if stored != nil {
            if slot.key == key and stored.get() == val {
                return slot
            }
        } else {
            require false
        }
        index = (index + 1) & mask
    }
}

func tab_delete(tab: Ref[Hash_Tab], key: uint, val: Ref[byte]) {
    let slots:        Ref[Hash_Slot] = tab_slots(tab)
    let stride:       uint           = internal.abi.size_bytes(hash_slot_record())
    let first:        Ref[Hash_Slot] = tab_find(tab, key, val)
    let displacement: int            = __gc_byte_diff(first, slots)
    require displacement >= 0
    var hole:  uint = cast[uint](displacement) / stride
    let mask:  uint = (1 << tab.bits) - 1
    var index: uint = (hole + 1) & mask
    while true {
        let source: Ref[Hash_Slot] = hash_slot_at(slots, index, stride)
        if source.val == nil {
            break
        }
        let home:       uint = tab_home(tab, source.key)
        var after_hole: bool
        if hole <= index {
            after_hole = hole < home and home <= index
        } else {
            after_hole = hole < home or home <= index
        }
        if !after_hole {
            let destination: Ref[Hash_Slot] = hash_slot_at(slots, hole, stride)
            destination.key = source.key
            destination.val = source.val
            hole = index
        }
        index = (index + 1) & mask
    }
    let last: Ref[Hash_Slot] = hash_slot_at(slots, hole, stride)
    last.key = 0
    last.val = nil
    tab.n -= 1
    when debug_enabled() {
        var probe_index: uint = (hole + 1) & mask
        while true {
            let occupied: Ref[Hash_Slot] = hash_slot_at(slots, probe_index, stride)
            if occupied.val == nil {
                break
            }
            var path: uint = tab_home(tab, occupied.key)
            while path != probe_index {
                let prior: Ref[Hash_Slot] = hash_slot_at(slots, path, stride)
                assert prior.val != nil
                path = (path + 1) & mask
            }
            probe_index = (probe_index + 1) & mask
        }
    }
}

func tab_free(tab: Ref[Hash_Tab]) {
    let slots: Ref[Hash_Slot]? = tab.slots
    if slots != nil {
        let stride: uint = internal.abi.size_bytes(hash_slot_record())
        internal.memory.unmap(slots.get(), (1 << tab.bits) * stride)
    }
    tab.slots = nil
    tab.bits = 0
    tab.n = 0
}

func index_slot_record() -> Ref[internal.abi.Type_Record] {
    let probe: Ref[Index_Slot]?              = nil
    let row:   Ref[internal.abi.Type_Record]? = internal.abi.optional_reference_target(typeof(probe))
    if row != nil {
        return row.get()
    }
    require false
}

func index_slot_at(slots: Ref[Index_Slot], index: uint, stride: uint) -> Ref[Index_Slot] {
    return __gc_byte_offset(slots, index * stride)
}

func index_tab_slots(tab: Ref[Index_Tab]) -> Ref[Index_Slot] {
    let slots: Ref[Index_Slot]? = tab.slots
    if slots != nil {
        return slots.get()
    }
    require false
}

func index_tab_home(tab: Ref[Index_Tab], key: uint) -> uint {
    let mixed: uint = unsafe_mul(key, 0x9e3779b97f4a7c15)
    return mixed >> (64 - tab.bits)
}

func index_tab_lookup(tab: Ref[Index_Tab], key: uint) -> uint {
    let slots: Ref[Index_Slot]? = tab.slots
    if slots == nil {
        return 0
    }
    let allocated: Ref[Index_Slot] = index_tab_slots(tab)
    let stride:    uint            = internal.abi.size_bytes(index_slot_record())
    let mask:      uint            = (1 << tab.bits) - 1
    var index:     uint            = index_tab_home(tab, key)
    while true {
        let slot: Ref[Index_Slot] = index_slot_at(allocated, index, stride)
        if slot.val == 0 {
            return 0
        }
        if slot.key == key {
            return slot.val
        }
        index = (index + 1) & mask
    }
}

func index_tab_insert(tab: Ref[Index_Tab], key: uint, val: uint) {
    require val != 0
    let slots:  Ref[Index_Slot] = index_tab_slots(tab)
    let stride: uint            = internal.abi.size_bytes(index_slot_record())
    let mask:   uint            = (1 << tab.bits) - 1
    var index:  uint            = index_tab_home(tab, key)
    while true {
        let slot: Ref[Index_Slot] = index_slot_at(slots, index, stride)
        if slot.val == 0 {
            slot.key = key
            slot.val = val
            tab.n += 1
            return
        }
        index = (index + 1) & mask
    }
}

func index_tab_reserve(tab: Ref[Index_Tab], more: uint) -> bool {
    let stride: uint = internal.abi.size_bytes(index_slot_record())
    while tab.slots == nil or (tab.n + more) * 2 > (1 << tab.bits) {
        let old:   Ref[Index_Slot]? = tab.slots
        var count: uint             = 0
        var bits:  uint             = 10
        if old != nil {
            count = 1 << tab.bits
            bits = tab.bits + 1
        }
        let new_count: uint       = 1 << bits
        let alignment: uint       = internal.abi.alignment_bytes(index_slot_record())
        let mapped:    Ref[byte]? = internal.memory.map_zeroed(new_count * stride, alignment)
        if mapped != nil {
            tab.slots = unsafe_cast[Ref[Index_Slot]] mapped.get()
            tab.bits = bits
            tab.n = 0
            if old != nil {
                let old_slots: Ref[Index_Slot] = old.get()
                var index:     uint            = 0
                while index < count {
                    let slot: Ref[Index_Slot] = index_slot_at(old_slots, index, stride)
                    if slot.val != 0 {
                        index_tab_insert(tab, slot.key, slot.val)
                    }
                    index += 1
                }
                internal.memory.unmap(old_slots, count * stride)
            }
        } else {
            return false
        }
    }
    return true
}

func index_tab_find(tab: Ref[Index_Tab], key: uint, val: uint) -> Ref[Index_Slot] {
    require val != 0
    let slots:  Ref[Index_Slot] = index_tab_slots(tab)
    let stride: uint            = internal.abi.size_bytes(index_slot_record())
    let mask:   uint            = (1 << tab.bits) - 1
    var index:  uint            = index_tab_home(tab, key)
    while true {
        let slot: Ref[Index_Slot] = index_slot_at(slots, index, stride)
        if slot.val == 0 {
            require false
        }
        if slot.key == key and slot.val == val {
            return slot
        }
        index = (index + 1) & mask
    }
}

func index_tab_delete(tab: Ref[Index_Tab], key: uint, val: uint) {
    let slots:        Ref[Index_Slot] = index_tab_slots(tab)
    let stride:       uint            = internal.abi.size_bytes(index_slot_record())
    let first:        Ref[Index_Slot] = index_tab_find(tab, key, val)
    let displacement: int             = __gc_byte_diff(first, slots)
    require displacement >= 0
    var hole:  uint = cast[uint](displacement) / stride
    let mask:  uint = (1 << tab.bits) - 1
    var index: uint = (hole + 1) & mask
    while true {
        let source: Ref[Index_Slot] = index_slot_at(slots, index, stride)
        if source.val == 0 {
            break
        }
        let home:       uint = index_tab_home(tab, source.key)
        var after_hole: bool
        if hole <= index {
            after_hole = hole < home and home <= index
        } else {
            after_hole = hole < home or home <= index
        }
        if !after_hole {
            let destination: Ref[Index_Slot] = index_slot_at(slots, hole, stride)
            destination.key = source.key
            destination.val = source.val
            hole = index
        }
        index = (index + 1) & mask
    }
    let last: Ref[Index_Slot] = index_slot_at(slots, hole, stride)
    last.key = 0
    last.val = 0
    tab.n -= 1
    when debug_enabled() {
        var probe_index: uint = (hole + 1) & mask
        while true {
            let occupied: Ref[Index_Slot] = index_slot_at(slots, probe_index, stride)
            if occupied.val == 0 {
                break
            }
            var path: uint = index_tab_home(tab, occupied.key)
            while path != probe_index {
                let prior: Ref[Index_Slot] = index_slot_at(slots, path, stride)
                assert prior.val != 0
                path = (path + 1) & mask
            }
            probe_index = (probe_index + 1) & mask
        }
    }
}

func index_tab_free(tab: Ref[Index_Tab]) {
    let slots: Ref[Index_Slot]? = tab.slots
    if slots != nil {
        let stride: uint = internal.abi.size_bytes(index_slot_record())
        internal.memory.unmap(slots.get(), (1 << tab.bits) * stride)
    }
    tab.slots = nil
    tab.bits = 0
    tab.n = 0
}
