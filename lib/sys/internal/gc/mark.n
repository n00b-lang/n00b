import internal.abi
import internal.gc.core
import internal.gc.handshake
import internal.gc.heap
import internal.gc.registry
import internal.locks
import internal.threads
import internal.memory

const pause_spins:    u32  = 100
const scan_chunk:     u64  = 512
const prefetch_ahead: uint = 8

func packet_record() -> Ref[internal.abi.Type_Record] {
    let probe: Ref[internal.gc.core.Packet]?       = nil
    let row:   Ref[internal.abi.Type_Record]? = internal.abi.optional_reference_target(typeof(probe))
    if row != nil {
        return row
    }
    require false
}

func chunk_record() -> Ref[internal.abi.Type_Record] {
    let probe: Ref[internal.gc.core.Packet_Chunk]? = nil
    let row:   Ref[internal.abi.Type_Record]? = internal.abi.optional_reference_target(typeof(probe))
    if row != nil {
        return row
    }
    require false
}

func pool_lock(heap: Ref[internal.gc.core.Heap]) {
    internal.locks.mutex_lock(ref heap.__value.pool)
}

func pool_unlock(heap: Ref[internal.gc.core.Heap]) {
    internal.locks.mutex_unlock(ref heap.__value.pool)
}

func wake_workers(heap: Ref[internal.gc.core.Heap]) {
    internal.gc.core.signal(ref heap.__value.work_progress)
}

func mark_progressed(heap: Ref[internal.gc.core.Heap]) {
    internal.gc.core.signal(ref heap.__value.mark_progress)
}

inline func is_marked(heap: Ref[internal.gc.core.Heap], payload: Ref[byte]) -> bool {
    let header: Ref[internal.gc.core.Object_Header] = internal.gc.core.header_of(payload)
    let epoch:  u32                           = heap.__value.mark_epoch
    if (header.__value.meta & internal.gc.core.obj_large) != 0 {
        let obj: Ref[internal.gc.core.Los_Obj] = internal.gc.core.los_of(header)
        return __atomic_load_relaxed(ref obj.__value.marked) == epoch
    }
    let block:   Ref[internal.gc.core.Block_Metadata] = internal.gc.core.block_of(header)
    let offset:  uint                           = __abi_ref_address(header) - __abi_ref_address(block)
    let granule: uint                           = offset / internal.gc.core.granule_bytes
    if __atomic_load_acquire(ref block.__value.mark_epoch) != epoch {
        return false
    }
    let bits: u64 = __atomic_load_relaxed(internal.gc.core.block_mark_word(block,
        granule / internal.gc.core.word_bits))
    let mask: u64 = cast[u64](1) << (granule % internal.gc.core.word_bits)
    return (bits & mask) != 0
}

inline func mark_object(marker: Ref[internal.gc.core.Marker], payload: Ref[byte]?) {
    if payload != nil {
        let header:        Ref[internal.gc.core.Object_Header] = internal.gc.core.header_of(payload)
        let granule_bytes: uint                          = internal.gc.core.granule_bytes
        let extent:        uint                          = internal.gc.core.object_bytes(header)
        let bytes:         uint                          = ((extent + granule_bytes - 1) / granule_bytes) * granule_bytes
        let heap:          Ref[internal.gc.core.Heap]          = marker.__value.heap
        let epoch:         u32                           = heap.__value.mark_epoch

        if (header.__value.meta & internal.gc.core.obj_large) != 0 {
            let large: Ref[internal.gc.core.Los_Obj] = internal.gc.core.los_of(header)
            if __atomic_exchange_relaxed(ref large.__value.marked, epoch) == epoch {
                return
            }
        } else {
            let block:   Ref[internal.gc.core.Block_Metadata] = internal.gc.core.block_of(header)
            let base:    Ref[byte]                      = internal.gc.core.block_base(block)
            let offset:  uint                           = __abi_ref_address(header) - __abi_ref_address(base)
            let granule: uint                           = offset / granule_bytes
            let mask:    u64                            = cast[u64](1) << (granule % internal.gc.core.word_bits)
            assert block.__value.magic == internal.gc.core.block_magic
            assert offset >= internal.gc.core.header_lines() * internal.gc.core.line_bytes
            if __atomic_load_acquire(ref block.__value.mark_epoch) != epoch {
                internal.gc.core.ensure_mark_epoch(base, epoch)
            }
            let word: Ref[Atomic[u64]] = internal.gc.core.mark_word_at(
                base, granule / internal.gc.core.word_bits)
            if (__atomic_fetch_or_relaxed(word, mask) & mask) != 0 {
                return
            }
            internal.gc.core.mark_lines(base, offset, bytes, epoch)
        }

        marker.__value.marked += 1
        marker.__value.objects += 1
        marker.__value.bytes += bytes
        let row: Ref[internal.abi.Type_Record]? = internal.abi.type_at(header.__value.type_index)
        if row != nil {
            if row.__value.tracing_index != 0 {
                push(marker, header)
            }
        } else {
            require false
        }
    }
}

func mark_ambiguous(marker: Ref[internal.gc.core.Marker], address: uint) {
    let header: Ref[internal.gc.core.Object_Header]? = internal.gc.registry.find_object(
        marker.__value.heap, address)
    if header != nil {
        marker.__value.hits += 1
        mark_object(marker, internal.gc.core.payload_of(header))
    }
}

func barrier_slot_record() -> Ref[internal.abi.Type_Record] {
    let probe: Ref[byte]?                    = nil
    let row:   Ref[internal.abi.Type_Record]? = internal.abi.type_for(typeof(probe))
    if row != nil {
        return row
    }
    require false
}

func barrier_flush_locked(mutator: Ref[internal.gc.core.Mutator]) {
    let heap:  Ref[internal.gc.core.Heap] = mutator.__value.heap
    let count: uint                 = mutator.__value.write_buffer_count
    if count == 0 or mutator.__value.write_buffer_epoch != heap.__value.mark_epoch {
        mutator.__value.write_buffer_count = 0
        return
    }
    let slot:       Ref[internal.abi.Type_Record] = barrier_slot_record()
    let slot_bytes: uint                         = internal.abi.size_bytes(slot)
    if !internal.gc.heap.grow_array(ref heap.__value.barrier_queue,
        ref heap.__value.barrier_queue_capacity, slot_bytes,
        internal.abi.alignment_bytes(slot), heap.__value.barrier_queue_count,
        heap.__value.barrier_queue_count + count) {
        require false
    }
    let queue: Ref[byte]? = heap.__value.barrier_queue
    if queue != nil {
        let source: Ref[Ref[byte]?] = ref mutator.__value.write_buffer[0]
        __gc_memcpy(__gc_byte_offset(queue,
            heap.__value.barrier_queue_count * slot_bytes),
            source, count * slot_bytes)
        heap.__value.barrier_queue_count += count
        __gc_signal_fence()
        mutator.__value.write_buffer_count = 0
        return
    }
    require false
}

func flush_write_buffer(mutator: Ref[internal.gc.core.Mutator]) {
    internal.gc.handshake.safepoint(mutator)
    if mutator.__value.write_buffer_count == 0 {
        return
    }
    let heap: Ref[internal.gc.core.Heap] = mutator.__value.heap
    internal.gc.heap.lock(heap)
    barrier_flush_locked(mutator)
    internal.gc.heap.unlock(heap)
    wake_workers(heap)
}

func write_barrier(mutator: Ref[internal.gc.core.Mutator],
                          value: Ref[byte]?) {
    let heap: Ref[internal.gc.core.Heap] = mutator.__value.heap
    if value != nil {
        if !__atomic_load_relaxed(ref heap.__value.marking) or
            is_marked(heap, value) {
            return
        }

        if mutator.__value.write_buffer_epoch != heap.__value.mark_epoch {
            mutator.__value.write_buffer_count = 0
            mutator.__value.write_buffer_epoch = heap.__value.mark_epoch
        }
        let index: uint = mutator.__value.write_buffer_count
        assert index < internal.gc.core.write_buffer_cap
        mutator.__value.write_buffer[index] = value
        __gc_signal_fence()
        mutator.__value.write_buffer_count = index + 1
        if mutator.__value.write_buffer_count == internal.gc.core.write_buffer_cap {
            flush_write_buffer(mutator)
        }
    }
}

func barrier_queue_drain(marker: Ref[internal.gc.core.Marker]) {
    let heap:  Ref[internal.gc.core.Heap] = marker.__value.heap
    let queue: Ref[byte]?           = heap.__value.barrier_queue
    if heap.__value.barrier_queue_count == 0 {
        return
    }
    if queue != nil {
        let slot_bytes: uint = internal.abi.size_bytes(barrier_slot_record())
        var index:      uint = 0
        while index < heap.__value.barrier_queue_count {
            let address: Ref[byte] = __gc_byte_offset(queue,
                index * slot_bytes)
            mark_object(marker, __atomic_load(pointer_word_at(address)))
            index += 1
        }
        heap.__value.barrier_queue_count = 0
        return
    }
    require false
}

inline func managed_header(marker: Ref[internal.gc.core.Marker]?,
                    mutator: Ref[internal.gc.core.Mutator]?,
                    pointer: Ref[byte]) -> Ref[internal.gc.core.Object_Header]? {
    var heap: Ref[internal.gc.core.Heap]
    if marker != nil {
        heap = marker.__value.heap
    }
    elif mutator != nil {
        heap = mutator.__value.heap
    }
    else {
        require false
    }
    internal.gc.registry.registry_read_lock(heap)
    let header: Ref[internal.gc.core.Object_Header]? = internal.gc.registry.find_object(
        heap, __abi_ref_address(pointer))
    internal.gc.registry.registry_read_unlock(heap)
    return header
}

func visit_managed_pointer(marker: Ref[internal.gc.core.Marker]?,
                           mutator: Ref[internal.gc.core.Mutator]?,
                           pointer: Ref[byte]?) {
    if pointer != nil {
        let header: Ref[internal.gc.core.Object_Header]? =
            managed_header(marker, mutator, pointer)
        if header != nil {
            let payload: Ref[byte] = internal.gc.core.payload_of(header)
            if marker != nil {
                mark_object(marker, payload)
            }
            elif mutator != nil {
                write_barrier(mutator, payload)
            }
        }
    }
}

func barrier_pointer(mutator: Ref[internal.gc.core.Mutator],
                            pointer: Ref[byte]?) {
    visit_managed_pointer(nil, mutator, pointer)
}

func trace_children(marker: Ref[internal.gc.core.Marker]?,
                    mutator: Ref[internal.gc.core.Mutator]?,
                    owner: Ref[internal.gc.core.Object_Header]?, address: Ref[byte],
                    type_index: u32, children: internal.abi.Range,
                    start_index: u64) {
    var skip:    u64 = start_index
    var scanned: u64 = 0
    var ordinal: u32 = 0
    while ordinal < children.count {
        let index: i64 = internal.abi.range_index(children, ordinal)
        require index > 0
        let entry: Ref[internal.abi.Trace_Child_Record]? = internal.abi.trace_child_at(
            cast[u32]index)
        if entry != nil {
            let child: Ref[internal.abi.Trace_Child_Record] = entry
            var count: u64                                 = child.__value.repeat_count
            if count == 0 {
                count = 1
            }
            require child.__value.stride_bits % 8 == 0
            if skip >= count {
                skip -= count
                ordinal += 1
                continue
            }
            var repetition: u64 = skip
            skip = 0
            while repetition < count {
                if scanned == scan_chunk and marker != nil {
                    push_continuation(marker, owner, address, type_index,
                                      start_index + scanned)
                    return
                }
                let offset: uint = cast[uint](child.__value.byte_offset +
                    repetition * (child.__value.stride_bits / 8))
                trace_value(marker, mutator, owner,
                            __gc_byte_offset(address, offset),
                            child.__value.child_type_index, 0)
                repetition += 1
                scanned += 1
            }
        } else {
            require false
        }
        ordinal += 1
    }
    require skip == 0
}

func trace_fixed_children(marker: Ref[internal.gc.core.Marker]?,
                          mutator: Ref[internal.gc.core.Mutator]?,
                          owner: Ref[internal.gc.core.Object_Header]?,
                          address: Ref[byte], type_index: u32,
                          trace_index: u32, start_index: u64) {
    let found: Ref[internal.abi.Trace_Record]? = internal.abi.trace_at(trace_index)
    if found != nil {
        trace_children(marker, mutator, owner, address, type_index,
                       found.__value.fixed_children, start_index)
        return
    }
    require false
}

func pointer_word_at(address: Ref[byte]) -> Ref[Atomic[Ref[byte]?]] {
    require __abi_ref_address(address) % (internal.gc.core.word_bits / 8) == 0
    return unsafe_cast[Ref[Atomic[Ref[byte]?]]] address
}

func trace_unit(address: Ref[byte], bits: u32) -> u64 {
    if bits == 8 {
        return __atomic_load(unsafe_cast[Ref[Atomic[u8]]] address)
    }
    if bits == 16 {
        return __atomic_load(unsafe_cast[Ref[Atomic[u16]]] address)
    }
    if bits == 32 {
        return __atomic_load(unsafe_cast[Ref[Atomic[u32]]] address)
    }
    if bits == 64 {
        return __atomic_load(unsafe_cast[Ref[Atomic[u64]]] address)
    }
    require false
}

func option_depth(type_index: u32) -> u64 {
    var depth:   u64 = 0
    var current: u32 = type_index
    while true {
        let row: Ref[internal.abi.Type_Record]? = internal.abi.type_at(current)
        if row != nil {
            if row.__value.kind != cast[u32](internal.abi.Type_Kind.option_type) {
                return depth
            }
            depth += 1
            let child: i64 = internal.abi.range_index(row.__value.components, 0)
            require child > 0
            current = cast[u32]child
        } else {
            require false
        }
    }
}

func option_is_set(address: Ref[byte], trace: Ref[internal.abi.Trace_Record],
                   type_index: u32) -> bool {
    let found: Ref[internal.abi.Tag_Extractor_Record]? = internal.abi.tag_extractor_at(
        trace.__value.tag_extractor_index)
    if found != nil {
        let tag:  Ref[internal.abi.Tag_Extractor_Record] = found
        let unit: Ref[byte]                             = __gc_byte_offset(address,
            tag.__value.unit_byte_offset)
        if tag.__value.kind == cast[u32](internal.abi.Tag_Kind.direct_bits) {
            return (trace_unit(unit, tag.__value.unit_width_bits) & tag.__value.mask) != 0
        }
        if tag.__value.kind == cast[u32](internal.abi.Tag_Kind.pointer_null) {
            return __atomic_load(pointer_word_at(unit)) != nil
        }
        if tag.__value.kind == cast[u32](internal.abi.Tag_Kind.bitptr_depth) {
            let base: Ref[byte]? = __atomic_load(pointer_word_at(address))
            if base != nil {
                return true
            }
            let depth: u64 = option_depth(type_index)
            let code:  u64 = trace_unit(unit, tag.__value.unit_width_bits)
            require depth != 0 and code < depth
            return code < depth - 1
        }
    }
    require false
}

func trace_variant(marker: Ref[internal.gc.core.Marker]?,
                   mutator: Ref[internal.gc.core.Mutator]?,
                   owner: Ref[internal.gc.core.Object_Header]?, address: Ref[byte],
                   type_index: u32, trace: Ref[internal.abi.Trace_Record],
                   start_index: u64) {
    let found: Ref[internal.abi.Tag_Extractor_Record]? = internal.abi.tag_extractor_at(
        trace.__value.tag_extractor_index)
    if found != nil {
        let tag: Ref[internal.abi.Tag_Extractor_Record] = found
        require tag.__value.kind == cast[u32](internal.abi.Tag_Kind.direct_bits)
        let unit: Ref[byte] = __gc_byte_offset(address,
            tag.__value.unit_byte_offset)
        let active: u64 = (trace_unit(unit, tag.__value.unit_width_bits) & tag.__value.mask) >> tag.__value.lsb_position
        if active == 0 {
            return
        }
        var ordinal: u32 = 0
        while ordinal < trace.__value.arms.count {
            let index: i64 = internal.abi.range_index(trace.__value.arms, ordinal)
            require index > 0
            let arm: Ref[internal.abi.Trace_Arm_Record]? = internal.abi.trace_arm_at(
                cast[u32]index)
            if arm != nil {
                if cast[u64](arm.__value.tag_value) == active {
                    trace_children(marker, mutator, owner, address, type_index,
                                   arm.__value.children, start_index)
                    return
                }
            } else {
                require false
            }
            ordinal += 1
        }
    }
    require false
}

func trace_array_elements(marker: Ref[internal.gc.core.Marker]?,
                          mutator: Ref[internal.gc.core.Mutator]?,
                          owner: Ref[internal.gc.core.Object_Header]?,
                          address: Ref[byte], data: Ref[byte],
                          backing: Ref[internal.gc.core.Array_Backing],
                          type_index: u32, start_index: u64) {
    require start_index <= backing.__value.shape.__value.total_count
    if backing.__value.element.__value.tracing_index == 0 {
        return
    }
    var end_index: u64 = backing.__value.shape.__value.total_count
    if end_index - start_index > scan_chunk and marker != nil {
        end_index = start_index + scan_chunk
        push_continuation(marker, owner, address, type_index,
                          end_index)
    }
    var index: u64 = start_index
    while index < end_index {
        trace_value(marker, mutator, owner,
            __gc_byte_offset(data, cast[uint](index) * backing.__value.stride),
            backing.__value.element_index, 0)
        index += 1
    }
}

func trace_array(marker: Ref[internal.gc.core.Marker]?,
                 mutator: Ref[internal.gc.core.Mutator]?,
                 owner: Ref[internal.gc.core.Object_Header]?, address: Ref[byte],
                 type_index: u32, start_index: u64) {
    let value:      Ref[internal.abi.Array_Value]              = unsafe_cast[Ref[internal.abi.Array_Value]] address
    let data:       Ref[byte]?                                = value.__value.data
    let descriptor: Ref[internal.abi.Array_Descriptor_Header]? = value.__value.descriptor
    if data != nil and descriptor != nil {
        visit_managed_pointer(marker, mutator, data)
        visit_managed_pointer(marker, mutator,
                              unsafe_cast[Ref[byte]] descriptor)
        let resolved: internal.gc.core.Array_Backing? =
            internal.gc.core.resolve_array_backing(type_index, descriptor)
        require resolved != nil
        var backing: internal.gc.core.Array_Backing = resolved
        trace_array_elements(marker, mutator, owner, address, data,
                             ref backing, type_index, start_index)
        return
    }
    require data == nil and descriptor == nil
}

func trace_array_backing(marker: Ref[internal.gc.core.Marker]?,
                         mutator: Ref[internal.gc.core.Mutator]?,
                         owner: Ref[internal.gc.core.Object_Header],
                         address: Ref[byte], type_index: u32,
                         start_index: u64) {
    let resolved: internal.gc.core.Array_Backing? =
        internal.gc.core.resolve_array_backing(type_index,
            internal.gc.core.array_descriptor_at(address))
    require resolved != nil
    var backing: internal.gc.core.Array_Backing = resolved
    require cast[u64](backing.data_offset) <= internal.gc.core.meta_payload_bytes(owner.__value.meta)
    trace_array_elements(marker, mutator, owner, address,
        __gc_byte_offset(address, backing.data_offset), ref backing,
        type_index, start_index)
}

func trace_value(marker: Ref[internal.gc.core.Marker]?,
                 mutator: Ref[internal.gc.core.Mutator]?,
                 owner: Ref[internal.gc.core.Object_Header]?, address: Ref[byte],
                 type_index: u32, start_index: u64) {
    let found: Ref[internal.abi.Type_Record]? = internal.abi.type_at(type_index)
    if found != nil {
        let row: Ref[internal.abi.Type_Record] = found
        if row.__value.tracing_index == 0 or
            row.__value.kind == cast[u32](internal.abi.Type_Kind.foreign_type) {
            return
        }
        if start_index == 0 {
            let flat: Ref[internal.abi.Trace_Record]? = internal.abi.trace_at(row.__value.tracing_index)
            if flat != nil {
                let words: internal.abi.Range = flat.__value.pointer_words
                if words.count != 0 {
                    var word: u32 = 0
                    while word < words.count {
                        let at: Ref[byte] = __gc_byte_offset(address,
                            cast[uint](internal.abi.range_index(words, word)))
                        visit_managed_pointer(marker, mutator, __atomic_load(pointer_word_at(at)))
                        word += 1
                    }
                    return
                }
            }
        }
        if row.__value.kind == cast[u32](internal.abi.Type_Kind.array_type) {
            if owner != nil {
                if address == internal.gc.core.payload_of(owner) and
                    (owner.__value.meta & internal.gc.core.obj_array_backing) != 0 {
                    trace_array_backing(marker, mutator, owner, address,
                                        type_index, start_index)
                    return
                }
            }
            trace_array(marker, mutator, owner, address, type_index,
                        start_index)
            return
        }
        if row.__value.kind == cast[u32](internal.abi.Type_Kind.string_type) {
            require start_index == 0
            visit_managed_pointer(marker, mutator,
                                  internal.abi.string_backing_at(address))
            return
        }
        if row.__value.kind == cast[u32](internal.abi.Type_Kind.box_type) or
            row.__value.kind == cast[u32](internal.abi.Type_Kind.union_type) {
            require start_index == 0
            let box:        Ref[internal.abi.Box_Value]    = unsafe_cast[Ref[internal.abi.Box_Value]] address
            let item_index: u32                           = box.__value.type_field & 0x7fffffff
            let item:       Ref[internal.abi.Type_Record]? = internal.abi.type_at(item_index)
            require item != nil
            let payload: Ref[byte]? = box.__value.payload
            if item.__value.size_bits > 64 and payload != nil
                and managed_header(marker, mutator, payload) == nil {
                trace_value(marker, mutator, owner, payload,
                            item_index, 0)
            } elif item.__value.size_bits > 64 {
                visit_managed_pointer(marker, mutator, payload)
            } else {
                trace_value(marker, mutator, owner,
                            __gc_byte_offset(address, 8), item_index, 0)
            }
            return
        }
        if row.__value.kind == cast[u32](internal.abi.Type_Kind.callback_type) {
            require start_index == 0
            let callback_value: Ref[internal.abi.Callback_Value] = unsafe_cast[Ref[internal.abi.Callback_Value]] address
            visit_managed_pointer(marker, mutator,
                                  callback_value.__value.environment)
            return
        }
        if row.__value.kind == cast[u32](internal.abi.Type_Kind.reference_type) or
            row.__value.kind == cast[u32](internal.abi.Type_Kind.object_type) {
            require start_index == 0
            let target: Ref[byte]? = __atomic_load(pointer_word_at(address))
            visit_managed_pointer(marker, mutator, target)
            return
        }
        if row.__value.kind == cast[u32](internal.abi.Type_Kind.record_type) or
            row.__value.kind == cast[u32](internal.abi.Type_Kind.tuple_type) {
            trace_fixed_children(marker, mutator, owner, address, type_index,
                                 row.__value.tracing_index, start_index)
            return
        }
        if row.__value.kind == cast[u32](internal.abi.Type_Kind.variant_type) {
            let trace: Ref[internal.abi.Trace_Record]? = internal.abi.trace_at(
                row.__value.tracing_index)
            if trace != nil {
                trace_variant(marker, mutator, owner, address, type_index,
                              trace, start_index)
                return
            }
        }
        require start_index == 0
        if row.__value.kind == cast[u32](internal.abi.Type_Kind.option_type) or
            row.__value.kind == cast[u32](internal.abi.Type_Kind.wrapper_type) or
            row.__value.kind == cast[u32](internal.abi.Type_Kind.atomic_type) {
            let trace_found: Ref[internal.abi.Trace_Record]? = internal.abi.trace_at(
                row.__value.tracing_index)
            if trace_found != nil {
                let trace: Ref[internal.abi.Trace_Record] = trace_found
                if row.__value.kind != cast[u32](internal.abi.Type_Kind.option_type) or
                    option_is_set(address, trace, type_index) {
                    let child: Ref[internal.abi.Trace_Record]? = internal.abi.trace_at(
                        trace.__value.child_trace_index)
                    if child != nil {
                        trace_value(marker, mutator, owner, address,
                                    child.__value.type_index, 0)
                        return
                    }
                } else {
                    return
                }
            }
        }
    }
    require false
}

func packet_at(chunk: Ref[internal.gc.core.Packet_Chunk], index: uint,
               header_bytes: uint, packet_bytes: uint) -> Ref[internal.gc.core.Packet] {
    let base: Ref[byte] = unsafe_cast[Ref[byte]] chunk
    let addr: Ref[byte] = __gc_byte_offset(base, header_bytes + index * packet_bytes)
    return unsafe_cast[Ref[internal.gc.core.Packet]] addr
}

func packet_get_locked(heap: Ref[internal.gc.core.Heap]) -> Ref[internal.gc.core.Packet] {
    if heap.__value.pool_empty == nil {
        let header_bytes: uint       = internal.abi.size_bytes(chunk_record())
        let packet_bytes: uint       = internal.abi.size_bytes(packet_record())
        let alignment:    uint       = internal.abi.alignment_bytes(packet_record())
        let bytes:        uint       = header_bytes + internal.gc.core.packet_chunk * packet_bytes
        let mapping:      Ref[byte]? = internal.memory.map_zeroed(bytes, alignment)
        if mapping != nil {
            let chunk: Ref[internal.gc.core.Packet_Chunk] = unsafe_cast[Ref[internal.gc.core.Packet_Chunk]] mapping
            chunk.__value.bytes = bytes
            chunk.__value.next = heap.__value.pool_chunks
            heap.__value.pool_chunks = chunk

            var index: uint = 0
            while index < internal.gc.core.packet_chunk {
                let packet: Ref[internal.gc.core.Packet] = packet_at(chunk, index,
                    header_bytes, packet_bytes)
                packet.__value.next = heap.__value.pool_empty
                heap.__value.pool_empty = packet
                index += 1
            }
        } else {
            require false
        }
    }

    let candidate: Ref[internal.gc.core.Packet]? = heap.__value.pool_empty
    if candidate != nil {
        let packet: Ref[internal.gc.core.Packet] = candidate
        heap.__value.pool_empty = packet.__value.next
        packet.__value.next = nil
        packet.__value.n = 0
        return packet
    }
    require false
}

func packet_put_locked(heap: Ref[internal.gc.core.Heap], packet: Ref[internal.gc.core.Packet]) {
    if packet.__value.n != 0 {
        packet.__value.next = heap.__value.pool_full
        heap.__value.pool_full = packet
    } else {
        packet.__value.next = heap.__value.pool_empty
        heap.__value.pool_empty = packet
    }
}

func pool_free_all(heap: Ref[internal.gc.core.Heap]) {
    var current: Ref[internal.gc.core.Packet_Chunk]? = heap.__value.pool_chunks
    while current != nil {
        let chunk: Ref[internal.gc.core.Packet_Chunk] = current
        current = chunk.__value.next
        internal.memory.unmap(chunk, chunk.__value.bytes)
    }
    heap.__value.pool_chunks = nil
    heap.__value.pool_full = nil
    heap.__value.pool_empty = nil
}

func mark_quiescent(heap: Ref[internal.gc.core.Heap]) -> bool {
    pool_lock(heap)
    let quiescent: bool = heap.__value.pool_full == nil and heap.__value.pool_active == 0
    pool_unlock(heap)
    return quiescent
}

func marker_init(out marker: internal.gc.core.Marker,
                 heap: Ref[internal.gc.core.Heap], worker: bool) {
    marker = (heap = heap, input = nil, output = nil, holding = false,
              worker = worker, marked = 0, objects = 0, bytes = 0,
              stack_words = 0, frame_slots = 0, hits = 0)
}

func marker_stats(marker: Ref[internal.gc.core.Marker]) {
    let heap: Ref[internal.gc.core.Heap] = marker.__value.heap
    __atomic_fetch_add_relaxed(ref heap.__value.cnt_objects, marker.__value.objects)
    __atomic_fetch_add_relaxed(ref heap.__value.cnt_bytes, marker.__value.bytes)
    if marker.__value.worker {
        __atomic_fetch_add_relaxed(ref heap.__value.cnt_worker_objects, marker.__value.objects)
    }
    __atomic_fetch_add_relaxed(ref heap.__value.cnt_stack_words, marker.__value.stack_words)
    __atomic_fetch_add_relaxed(ref heap.__value.cnt_frame_slots, marker.__value.frame_slots)
    __atomic_fetch_add_relaxed(ref heap.__value.cnt_hits, marker.__value.hits)
    marker.__value.objects = 0
    marker.__value.bytes = 0
    marker.__value.stack_words = 0
    marker.__value.frame_slots = 0
    marker.__value.hits = 0
}

func reserve_out(marker: Ref[internal.gc.core.Marker], need: uint) {
    let heap:      Ref[internal.gc.core.Heap] = marker.__value.heap
    var published: bool                 = false
    pool_lock(heap)
    if !marker.__value.holding {
        heap.__value.pool_active += 1
        marker.__value.holding = true
    }
    let output: Ref[internal.gc.core.Packet]? = marker.__value.output
    if output != nil {
        if output.__value.n + need > internal.gc.core.packet_cap {
            packet_put_locked(heap, output)
            marker.__value.output = nil
            published = true
        }
    }
    if marker.__value.output == nil {
        marker.__value.output = packet_get_locked(heap)
    }
    pool_unlock(heap)
    if published {
        wake_workers(heap)
        mark_progressed(heap)
    }
}

inline func out_has_room(marker: Ref[internal.gc.core.Marker], need: uint) -> bool {
    if !marker.__value.holding {
        return false
    }
    let output: Ref[internal.gc.core.Packet]? = marker.__value.output
    if output != nil {
        return output.__value.n + need <= internal.gc.core.packet_cap
    }
    return false
}

inline func push(marker: Ref[internal.gc.core.Marker], header: Ref[internal.gc.core.Object_Header]) {
    if !out_has_room(marker, 1) {
        reserve_out(marker, 1)
    }
    let output: Ref[internal.gc.core.Packet]? = marker.__value.output
    if output != nil {
        let packet: Ref[internal.gc.core.Packet]       = output
        let entry:  Ref[internal.gc.core.Packet_Entry] = ref packet.__value.entries[packet.__value.n]
        entry.__value.header = header
        entry.__value.value_address = internal.gc.core.payload_of(header)
        entry.__value.type_index = header.__value.type_index
        entry.__value.start_index = 0
        packet.__value.n += 1
        return
    }
    require false
}

func push_continuation(marker: Ref[internal.gc.core.Marker],
                       header: Ref[internal.gc.core.Object_Header]?, address: Ref[byte],
                       type_index: u32, start_index: u64) {
    require start_index != 0
    if !out_has_room(marker, 1) {
        reserve_out(marker, 1)
    }
    let output: Ref[internal.gc.core.Packet]? = marker.__value.output
    if output != nil {
        let packet: Ref[internal.gc.core.Packet]       = output
        let entry:  Ref[internal.gc.core.Packet_Entry] = ref packet.__value.entries[packet.__value.n]
        entry.__value.header = header
        entry.__value.value_address = address
        entry.__value.type_index = type_index
        entry.__value.start_index = start_index
        packet.__value.n += 1
        return
    }
    require false
}

func marker_flush(marker: Ref[internal.gc.core.Marker]) {
    let heap:   Ref[internal.gc.core.Heap]    = marker.__value.heap
    let input:  Ref[internal.gc.core.Packet]? = marker.__value.input
    let output: Ref[internal.gc.core.Packet]? = marker.__value.output
    var any:    bool                    = false
    if input != nil {
        any = input.__value.n != 0
    }
    if output != nil {
        any = any or output.__value.n != 0
    }
    marker_stats(marker)
    pool_lock(heap)
    if input != nil {
        packet_put_locked(heap, input)
    }
    if output != nil {
        packet_put_locked(heap, output)
    }
    marker.__value.input = nil
    marker.__value.output = nil
    if marker.__value.holding {
        heap.__value.pool_active -= 1
        marker.__value.holding = false
    }
    pool_unlock(heap)
    if any {
        wake_workers(heap)
    }
    mark_progressed(heap)
}

func take(marker: Ref[internal.gc.core.Marker]) -> bool {
    let heap: Ref[internal.gc.core.Heap] = marker.__value.heap
    pool_lock(heap)
    let full: Ref[internal.gc.core.Packet]? = heap.__value.pool_full
    if full != nil {
        let packet: Ref[internal.gc.core.Packet] = full
        heap.__value.pool_full = packet.__value.next
        let input: Ref[internal.gc.core.Packet]? = marker.__value.input
        if input != nil {
            packet_put_locked(heap, input)
        }
        marker.__value.input = packet
        if !marker.__value.holding {
            heap.__value.pool_active += 1
            marker.__value.holding = true
        }
    }
    pool_unlock(heap)
    return full != nil
}

func trace_root(marker: Ref[internal.gc.core.Marker], address: Ref[byte],
                       type_index: u32) {
    trace_value(marker, nil, nil, address, type_index, 0)
}

func barrier_value(mutator: Ref[internal.gc.core.Mutator],
                          address: Ref[byte], type_index: u32) {
    trace_value(nil, mutator, nil, address, type_index, 0)
}

func marker_drain(marker: Ref[internal.gc.core.Marker], budget: uint) -> uint {
    var done: uint = 0
    while true {
        let input: Ref[internal.gc.core.Packet]? = marker.__value.input
        if input != nil {
            let packet: Ref[internal.gc.core.Packet] = input
            if packet.__value.n != 0 {
                if budget != 0 and done >= budget {
                    marker_flush(marker)
                    return done
                }
                if packet.__value.n > prefetch_ahead {
                    let ahead: Ref[internal.gc.core.Packet_Entry] =
                        ref packet.__value.entries[packet.__value.n - 1 - prefetch_ahead]
                    let header: Ref[internal.gc.core.Object_Header]? = ahead.__value.header
                    if header != nil {
                        __gc_prefetch(header)
                    } else {
                        let address: Ref[byte]? = ahead.__value.value_address
                        if address != nil {
                            __gc_prefetch(address)
                        }
                    }
                }
                packet.__value.n -= 1
                let entry: Ref[internal.gc.core.Packet_Entry] = ref packet.__value.entries[
                    packet.__value.n]
                let header:  Ref[internal.gc.core.Object_Header]? = entry.__value.header
                let address: Ref[byte]?                     = entry.__value.value_address
                if address != nil {
                    trace_value(marker, nil, header, address,
                                entry.__value.type_index, entry.__value.start_index)
                } else {
                    require false
                }
                done += 1
                continue
            }
        }
        let output: Ref[internal.gc.core.Packet]? = marker.__value.output
        if output != nil {
            if output.__value.n != 0 {
                marker.__value.input = output
                marker.__value.output = input
                continue
            }
        }
        if take(marker) {
            continue
        }
        marker_flush(marker)
        return done
    }
}

func drain_to_termination(marker: Ref[internal.gc.core.Marker]) {
    let heap:  Ref[internal.gc.core.Heap] = marker.__value.heap
    var spins: u32                  = 0
    while true {
        marker_drain(marker, 0)
        if mark_quiescent(heap) {
            return
        }
        let full: Ref[internal.gc.core.Packet]? = __volatile_load(ref heap.__value.pool_full)
        spins += 1
        if full != nil or spins < pause_spins {
            internal.threads.cpu_relax()
            continue
        }
        spins = 0
        internal.locks.condition_lock(ref heap.__value.mark_progress)
        if !mark_quiescent(heap)
            and __volatile_load(ref heap.__value.pool_full) == nil {
            internal.locks.condition_wait(ref heap.__value.mark_progress,
                timeout_ns = internal.gc.core.wait_slice_ns, unlock = false)
        }
        internal.locks.condition_unlock(ref heap.__value.mark_progress)
    }
}
