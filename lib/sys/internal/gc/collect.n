import internal.abi
import internal.gc.core
import internal.gc.alloc
import internal.gc.finalize
import internal.gc.frames
import internal.gc.handshake
import internal.gc.heap
import internal.gc.los
import internal.gc.mark
import internal.gc.registry
import internal.gc.roots
import internal.gc.world
import internal.locks
import internal.threads
import internal.memory

const min_budget:           uint = 8 * internal.gc.core.block_bytes
const concurrent_start_pct: uint = 70
const concurrent_force_pct: uint = 200
const sweep_batch:          uint = 16

func stop_world(heap: Ref[internal.gc.core.Heap]) {
    internal.gc.mark.wake_workers(heap)
    internal.locks.mutex_lock(ref heap.__value.fin)
    internal.gc.registry.write_lock(heap)
    internal.gc.mark.pool_lock(heap)
    __atomic_store(ref heap.__value.stw, true)
    heap.__value.pause_start = __unobserved(__os_now_ns())
    internal.gc.world.stop(heap)
    internal.gc.mark.pool_unlock(heap)
    internal.gc.registry.write_unlock(heap)
}

func start_world(heap: Ref[internal.gc.core.Heap]) {
    internal.gc.world.start(heap)
    var current: Ref[internal.gc.core.Mutator]? = heap.__value.mutators
    while current != nil {
        let mutator: Ref[internal.gc.core.Mutator] = current
        mutator.__value.ctx_valid = false
        current = mutator.__value.next
    }
    __atomic_store(ref heap.__value.stw, false)
    internal.locks.mutex_unlock(ref heap.__value.fin)
    heap.__value.last_pause_ns = __unobserved(__os_now_ns()) - heap.__value.pause_start
    heap.__value.pauses += 1
    heap.__value.total_pause_ns += heap.__value.last_pause_ns
    if heap.__value.last_pause_ns > heap.__value.max_pause_ns {
        heap.__value.max_pause_ns = heap.__value.last_pause_ns
    }
    heap.__value.cycle.pause_ns += heap.__value.last_pause_ns
    heap.__value.cycle.pauses += 1
    let ready: Ref[(u64, Ref[byte]?) -> nil]? = heap.__value.cfg.on_pause
    if ready != nil {
        let handler: Ref[(u64, Ref[byte]?) -> nil] = ready
        handler.call(heap.__value.last_pause_ns, heap.__value.cfg.telemetry_user)
    }
    internal.gc.mark.wake_workers(heap)
}

func emit_cycle(heap: Ref[internal.gc.core.Heap], kind: i32) {
    var info: internal.gc.core.Cycle_Info = heap.__value.cycle
    info.kind = kind
    info.duration_ns = __unobserved(__os_now_ns()) - heap.__value.cycle_start
    info.rounds = cast[u32](heap.__value.hs_rounds) - info.rounds
    info.stragglers = cast[u32](heap.__value.hs_stragglers) - info.stragglers
    let ready: Ref[(internal.gc.core.Cycle_Info, Ref[byte]?) -> nil]? = heap.__value.cfg.on_cycle
    if ready != nil {
        let handler: Ref[(internal.gc.core.Cycle_Info, Ref[byte]?) -> nil] = ready
        handler.call(info, heap.__value.cfg.telemetry_user)
    }
}

func stack_word_at(address: Ref[byte]) -> uint {
    let word: Ref[uint] = unsafe_cast[Ref[uint]] address
    return __volatile_load(word)
}

func stack_word_width() -> uint {
    let probe: uint                          = 0
    let row:   Ref[internal.abi.Type_Record]? = internal.abi.type_for(typeof(probe))
    if row != nil {
        let width: uint = internal.abi.size_bytes(row)
        require width != 0
        return width
    }
    require false
}

func scan_words(marker: Ref[internal.gc.core.Marker], low: Ref[byte],
                       high: Ref[byte]) {
    let width: uint = stack_word_width()
    let start: uint = __abi_ref_address(low)
    let end:   uint = __abi_ref_address(high)
    if end <= start {
        return
    }
    let remainder:  uint = start % width
    var adjustment: uint = 0
    if remainder != 0 {
        adjustment = width - remainder
    }
    if end - start < adjustment {
        return
    }
    let available: uint = end - start - adjustment
    var offset:    uint = 0
    while available - offset >= width {
        let address: Ref[byte] = __gc_byte_offset(low, adjustment + offset)
        marker.__value.stack_words += 1
        internal.gc.mark.mark_ambiguous(marker, stack_word_at(address))
        offset += width
    }
}

const frame_record_words: uint = 2
const frame_row_whole:    u32  = 1

func context_pc(snapshot: Ref[internal.threads.Thread_Context]) -> uint {
    let pc: Ref[byte]? = snapshot.__value.pc
    if pc != nil {
        return __abi_ref_address(pc)
    }
    return 0
}

func scan_stack(marker: Ref[internal.gc.core.Marker], sp: Ref[byte],
                       fp: Ref[byte]?, pc: uint, high: Ref[byte],
                       interrupted: bool) {
    var low: Ref[byte] = sp
    if interrupted {
        let red_zone: uint = internal.threads.stack_red_zone_bytes()
        if red_zone != 0 and __abi_ref_address(sp) > red_zone {
            low = __gc_byte_offset(sp, -cast[i128](red_zone))
        }
    }
    let limit:          uint       = __abi_ref_address(high)
    let width:          uint       = stack_word_width()
    let chained:        bool       = internal.threads.frame_pointer_chain()
    var start:          Ref[byte]  = low
    var frame:          Ref[byte]? = fp
    var return_address: uint       = pc
    var callee_mapped:  bool       = false
    while frame != nil {
        let address: uint = __abi_ref_address(frame)
        let frame_info: Ref[internal.abi.Native_Frame_Record]? =
            internal.gc.frames.frame_for(return_address)
        var record_offset: i128 = 0
        if frame_info != nil {
            record_offset = cast[i128](frame_info.__value.record_offset)
        } elif !chained {
            break
        }
        let record_end: i128 = cast[i128](address) + record_offset +
            cast[i128](frame_record_words * width)
        if address < __abi_ref_address(start) or address >= limit or
            address % width != 0 or record_offset < 0 or
            record_offset % cast[i128](width) != 0 or
            record_end > cast[i128](limit) {
            break
        }
        let frame_record: Ref[byte] = __gc_byte_offset(frame, record_offset)
        let caller:       uint      = stack_word_at(frame_record)
        var ceiling:      uint      = limit
        if caller > address and caller < limit {
            ceiling = caller
        }
        var mapped: bool = false
        if frame_info != nil and (frame_info.__value.flags & frame_row_whole) == 0 {
            mapped = scan_native_frame(marker, start, frame, frame_record,
                                       ceiling, frame_info)
        }
        if !mapped or !callee_mapped {
            scan_words(marker, start, frame)
        }
        callee_mapped = mapped
        start = frame
        return_address = stack_word_at(__gc_byte_offset(frame_record, width))
        if caller <= address or caller >= limit {
            break
        }
        frame = __gc_byte_offset(frame, caller - address)
    }
    if limit > __abi_ref_address(start) {
        scan_words(marker, start, high)
    }
}

func scan_native_frame(marker: Ref[internal.gc.core.Marker], low: Ref[byte],
                       fp: Ref[byte], frame_record: Ref[byte], ceiling: uint,
                       frame_info: Ref[internal.abi.Native_Frame_Record]) -> bool {
    let base:       i128 = cast[i128](__abi_ref_address(fp))
    let floor:      i128 = cast[i128](__abi_ref_address(low))
    let saved:      i128 = cast[i128](__abi_ref_address(frame_record))
    let saved_end:  i128 = saved + cast[i128](frame_record_words * stack_word_width())
    var index:      u32  = 0
    while index < frame_info.__value.root_count {
        let root:  Ref[internal.abi.Native_Frame_Root] = internal.abi.native_frame_root(frame_info, index)
        let first: i128 = base + cast[i128](root.__value.offset)
        let last:  i128 = first + cast[i128](root.__value.bytes)
        if first < floor or last > cast[i128](ceiling) or
            (first < saved_end and last > saved) {
            return false
        }
        let slot: Ref[byte] = __gc_byte_offset(fp, root.__value.offset)
        scan_words(marker, slot, __gc_byte_offset(slot, cast[uint](root.__value.bytes)))
        marker.__value.frame_slots += 1
        index += 1
    }
    return true
}

func scan_context_registers(marker: Ref[internal.gc.core.Marker],
                            snapshot: Ref[internal.threads.Thread_Context]) {
    require snapshot.__value.nregs <= internal.threads.context_registers
    var index: uint = 0
    while index < snapshot.__value.nregs {
        internal.gc.mark.mark_ambiguous(marker,
            snapshot.__value.regs[index])
        index += 1
    }
}

func required_stack_high(mutator: Ref[internal.gc.core.Mutator]) -> Ref[byte] {
    let high: Ref[byte]? = mutator.__value.stack_hi
    if high != nil {
        return high
    }
    require false
}

func mark_mutator_roots(marker: Ref[internal.gc.core.Marker],
                               mutator: Ref[internal.gc.core.Mutator]) {
    var index: uint = 0
    while index < mutator.__value.nroots {
        internal.gc.mark.mark_object(marker,
            internal.gc.roots.slot_at(mutator, index).__value)
        index += 1
    }
    index = 0
    while index < mutator.__value.ntls_roots {
        let entry: Ref[internal.gc.roots.TLS_Root_Entry] = internal.gc.roots.tls_root_at(mutator, index)
        internal.gc.mark.trace_root(marker, entry.__value.address, entry.__value.type_index)
        index += 1
    }
    if mutator.__value.thread_id != internal.threads.thread_id() {
        internal.gc.mark.mark_object(marker, mutator.__value.last_alloc)
    }
}

func mark_thread_roots(marker: Ref[internal.gc.core.Marker],
                              mutator: Ref[internal.gc.core.Mutator],
                              stopped: bool) {
    mark_mutator_roots(marker, mutator)
    if !marker.__value.heap.__value.cfg.scan_stacks {
        return
    }
    let high: Ref[byte] = required_stack_high(mutator)
    if mutator.__value.thread_id == internal.threads.thread_id() {
        __os_thread_capture_self(ref mutator.__value.captured)
        scan_context_registers(marker, ref mutator.__value.captured)
        let self_sp: Ref[byte]? = mutator.__value.captured.sp
        if self_sp != nil {
            scan_stack(marker, self_sp, mutator.__value.captured.fp,
                context_pc(ref mutator.__value.captured), high, false)
        } else {
            require false
        }
    } elif __atomic_load(ref mutator.__value.blocking) != 0 and !stopped {
        scan_context_registers(marker, ref mutator.__value.captured)
        let blocked_sp: Ref[byte]? = mutator.__value.blocked_sp
        if blocked_sp != nil {
            scan_stack(marker, blocked_sp, mutator.__value.captured.fp,
                context_pc(ref mutator.__value.captured), high, false)
        } else {
            require false
        }
    } else {
        require mutator.__value.ctx_valid
        scan_context_registers(marker, ref mutator.__value.captured)
        let stopped_sp: Ref[byte]? = mutator.__value.captured.sp
        if stopped_sp != nil {
            scan_stack(marker, stopped_sp, mutator.__value.captured.fp, 0,
                high, true)
        } else {
            require false
        }
    }
}

func mark_global_roots(marker: Ref[internal.gc.core.Marker]) {
    var storage_index: u32 = 1
    while storage_index < internal.abi.storage_count() {
        let row: Ref[internal.abi.Storage_Record]? = internal.abi.storage_at(
            storage_index)
        if row == nil {
            require false
        }
        let address: Ref[byte]? = internal.abi.storage_address(storage_index)
        if row != nil {
            if row.__value.segment_kind == cast[u32](internal.abi.Storage_Kind.tls) and
                row.__value.symbol_index != 0 and address == nil {
                require false
            }
            if address != nil {
                internal.gc.mark.trace_root(marker, address,
                    row.__value.type_index)
            }
        }
        storage_index += 1
    }
    var index: uint = 0
    while index < marker.__value.heap.__value.nglobals {
        internal.gc.mark.mark_object(marker,
            internal.gc.roots.global_slot_at(marker.__value.heap, index).__value)
        index += 1
    }
}

func mark_roots(marker: Ref[internal.gc.core.Marker]) {
    mark_global_roots(marker)
    internal.gc.finalize.mark_locked(marker)
    var current: Ref[internal.gc.core.Mutator]? = marker.__value.heap.__value.mutators
    while current != nil {
        let mutator: Ref[internal.gc.core.Mutator] = current
        if mutator.__value.thread_primary {
            mark_thread_roots(marker, mutator, true)
        } else {
            mark_mutator_roots(marker, mutator)
        }
        current = mutator.__value.next
    }
}

func reserve_bump(marker: Ref[internal.gc.core.Marker],
                         bump: Ref[internal.gc.core.Bump], inflight: bool) {
    let limit:  Ref[byte]? = __volatile_load(ref bump.__value.limit)
    let cursor: Ref[byte]? = __volatile_load(ref bump.__value.cursor)
    if limit != nil {
        let heap:  Ref[internal.gc.core.Heap]           = marker.__value.heap
        let block: Ref[internal.gc.core.Block_Metadata] = internal.gc.core.block_of_bytes(
            __gc_byte_offset(limit, -1))
        let base:           Ref[byte] = internal.gc.core.block_base(block)
        let base_address:   uint      = __abi_ref_address(base)
        let payload_start:  uint      = base_address + internal.gc.core.header_lines() * internal.gc.core.line_bytes
        let block_end:      uint      = base_address + internal.gc.core.block_bytes
        let limit_address:  uint      = __abi_ref_address(limit)
        var low:            uint      = payload_start
        var cursor_address: uint      = 0
        if cursor != nil {
            cursor_address = __abi_ref_address(cursor)
        }
        let cursor_in_block: bool = cursor_address > payload_start and cursor_address <= block_end
        if cursor_in_block and cursor_address - payload_start > internal.gc.los.los_threshold {
            low = cursor_address - internal.gc.los.los_threshold
        }
        if low >= limit_address {
            return
        }

        let first: uint = (low - base_address) / internal.gc.core.line_bytes
        let last:  uint = (limit_address - 1 - base_address) / internal.gc.core.line_bytes
        internal.gc.core.mark_lines(base, first * internal.gc.core.line_bytes,
            (last - first + 1) * internal.gc.core.line_bytes, heap.__value.mark_epoch)

        if inflight and cursor_in_block {
            let header: Ref[internal.gc.core.Object_Header]? = internal.gc.registry.find_object(heap, cursor_address - 1)
            if header != nil {
                internal.gc.mark.mark_object(marker,
                    internal.gc.core.payload_of(header))
            }
        }
    }
}

func reserve_bumps(marker: Ref[internal.gc.core.Marker]) {
    let heap:        Ref[internal.gc.core.Heap]     = marker.__value.heap
    let self_thread: uint                     = internal.threads.thread_id()
    var current:     Ref[internal.gc.core.Mutator]? = heap.__value.mutators
    while current != nil {
        let mutator:  Ref[internal.gc.core.Mutator] = current
        let inflight: bool                    = mutator.__value.thread_id != self_thread
        reserve_bump(marker, ref mutator.__value.small, inflight)
        reserve_bump(marker, ref mutator.__value.overflow, inflight)
        current = mutator.__value.next
    }
}

func drain_barrier_buffers(marker: Ref[internal.gc.core.Marker]) {
    let heap:    Ref[internal.gc.core.Heap]     = marker.__value.heap
    var current: Ref[internal.gc.core.Mutator]? = heap.__value.mutators
    while current != nil {
        let mutator: Ref[internal.gc.core.Mutator] = current
        if mutator.__value.write_buffer_epoch == heap.__value.mark_epoch {
            var index: uint = 0
            while index < mutator.__value.write_buffer_count {
                let slot: Ref[Ref[byte]?] = ref mutator.__value.write_buffer[index]
                internal.gc.mark.mark_object(marker, slot.__value)
                index += 1
            }
        }
        mutator.__value.write_buffer_count = 0
        current = mutator.__value.next
    }
    internal.gc.mark.barrier_queue_drain(marker)
}

func mark_black_lines(block: Ref[internal.gc.core.Block_Metadata], epoch: u32) {
    let base:          Ref[byte] = internal.gc.core.block_base(block)
    let first_granule: uint      = internal.gc.core.header_lines() * internal.gc.core.line_bytes / internal.gc.core.granule_bytes
    let first_word:    uint      = first_granule / internal.gc.core.word_bits
    let word_count:    uint      = (internal.gc.core.block_bytes / internal.gc.core.granule_bytes) / internal.gc.core.word_bits
    var word:          uint      = first_word
    while word < word_count {
        var bits: u64 = __atomic_load_relaxed(internal.gc.core.mark_word_at(base, word))
        while bits != 0 {
            let bit:           uint                          = __count_trailing_zeros(cast[uint](bits))
            let granule:       uint                          = word * internal.gc.core.word_bits + bit
            let offset:        uint                          = granule * internal.gc.core.granule_bytes
            let header:        Ref[internal.gc.core.Object_Header] = internal.gc.core.block_object_header_at(base, offset)
            let bytes:         uint                          = internal.gc.core.object_bytes(header)
            let granule_bytes: uint                          = internal.gc.core.granule_bytes
            let rounded:       uint                          = ((bytes + granule_bytes - 1) / granule_bytes) * granule_bytes
            internal.gc.core.mark_lines(base, offset, rounded, epoch)
            bits = bits & (bits - 1)
        }
        word += 1
    }
}

func sweep_block(heap: Ref[internal.gc.core.Heap], block: Ref[internal.gc.core.Block_Metadata],
                        epoch: u32) {
    let base:       Ref[byte] = internal.gc.core.block_base(block)
    let have_marks: bool      = __atomic_load_acquire(ref block.__value.mark_epoch) == epoch
    if have_marks and __atomic_load(ref block.__value.black_epoch) == epoch {
        mark_black_lines(block, epoch)
    }

    let first_granule: uint = internal.gc.core.header_lines() * internal.gc.core.line_bytes / internal.gc.core.granule_bytes
    let first_word:    uint = first_granule / internal.gc.core.word_bits
    let word_count:    uint = (internal.gc.core.block_bytes / internal.gc.core.granule_bytes) / internal.gc.core.word_bits
    var word:          uint = first_word
    while word < word_count {
        let starts: u64 = __atomic_load_relaxed(internal.gc.core.start_word_at(base, word))
        var marks:  u64 = 0
        if have_marks {
            marks = __atomic_load_relaxed(internal.gc.core.mark_word_at(base, word))
        }
        when debug_enabled() {
            var dead: u64 = starts & ~marks
            while dead != 0 {
                let bit:    uint                          = __count_trailing_zeros(cast[uint](dead))
                let offset: uint                          = (word * internal.gc.core.word_bits + bit) * internal.gc.core.granule_bytes
                let header: Ref[internal.gc.core.Object_Header] = internal.gc.core.block_object_header_at(base, offset)
                assert (header.__value.meta & internal.gc.core.obj_final) == 0
                dead = dead & (dead - 1)
            }
        }
        if starts != (starts & marks) {
            __atomic_store_relaxed(internal.gc.core.start_word_at(base, word), starts & marks)
        }
        word += 1
    }

    var free_lines: uint = 0
    var previous:   bool = false
    var line:       uint = internal.gc.core.header_lines()
    let line_count: uint = internal.gc.core.block_bytes / internal.gc.core.line_bytes
    while line < line_count {
        let marked: bool = internal.gc.core.line_marked_in(base, line, epoch)
        if marked or previous {
            previous = marked
        } else {
            free_lines += 1
            if heap.__value.cfg.poison_free {
                let line_base: Ref[byte] = __gc_byte_offset(base,
                    line * internal.gc.core.line_bytes)
                __gc_memset(line_base, 0xdb, internal.gc.core.line_bytes)
            }
        }
        line += 1
    }

    assert epoch == heap.__value.epoch
    if block.__value.sweep_epoch != epoch {
        __atomic_fetch_sub(ref heap.__value.nunswept, 1)
    }
    block.__value.free_lines = cast[u16](free_lines)
    block.__value.sweep_epoch = epoch
}

func prune_owned(heap: Ref[internal.gc.core.Heap], sweep: bool) {
    var slot:    Ref[Ref[internal.gc.core.Block_Metadata]?] = ref heap.__value.owned
    var current: Ref[internal.gc.core.Block_Metadata]?      = slot.__value
    while current != nil {
        let block: Ref[internal.gc.core.Block_Metadata] = current
        if block.__value.state == cast[u8](internal.gc.core.Block_State.owned) {
            if sweep {
                sweep_block(heap, block, heap.__value.epoch)
            }
            slot = ref block.__value.own_next
        } else {
            slot.__value = block.__value.own_next
            block.__value.own_next = nil
            block.__value.on_owned = false
        }
        current = slot.__value
    }
}

func sweep_some(heap: Ref[internal.gc.core.Heap], count: uint) -> bool {
    let sweeping: u32 = cast[u32](internal.gc.core.Phase.sweeping)
    if __atomic_load(ref heap.__value.phase) != sweeping or !heap.__value.sweep_ready {
        return false
    }

    let epoch:     u32                             = heap.__value.epoch
    var remaining: uint                            = count
    var did_work:  bool                            = false
    var candidate: Ref[internal.gc.core.Block_Metadata]? = heap.__value.sweep_cursor
    while candidate != nil {
        if remaining == 0 {
            break
        }
        let block: Ref[internal.gc.core.Block_Metadata] = candidate
        heap.__value.sweep_cursor = block.__value.all_next
        if block.__value.state != cast[u8](internal.gc.core.Block_State.owned) and
            block.__value.sweep_epoch != epoch {
            sweep_block(heap, block, epoch)
            internal.gc.alloc.list_block(heap, block)
            remaining -= 1
            did_work = true
        }
        candidate = heap.__value.sweep_cursor
    }

    var cursor: Ref[Ref[internal.gc.core.Los_Obj]?] = heap.__value.los_cursor
    var large:  Ref[internal.gc.core.Los_Obj]?      = cursor.__value
    while large != nil {
        if remaining == 0 {
            break
        }
        let obj: Ref[internal.gc.core.Los_Obj] = large
        if __atomic_load_relaxed(ref obj.__value.marked) == epoch {
            cursor = ref obj.__value.next
        } else {
            cursor.__value = obj.__value.next
            internal.gc.los.release(heap, obj)
        }
        remaining -= 1
        did_work = true
        large = cursor.__value
    }
    heap.__value.los_cursor = cursor
    if heap.__value.sweep_cursor == nil and cursor.__value == nil {
        __atomic_store(ref heap.__value.phase, cast[u32](internal.gc.core.Phase.idle))
    }
    return did_work
}

func sweep_all(heap: Ref[internal.gc.core.Heap]) {
    let sweeping: u32 = cast[u32](internal.gc.core.Phase.sweeping)
    while __atomic_load(ref heap.__value.phase) == sweeping and heap.__value.sweep_ready {
        sweep_some(heap, ~cast[uint](0))
    }
}

func update_pacing(heap: Ref[internal.gc.core.Heap]) {
    let live:   uint = heap.__value.last_marked_bytes
    let scaled: f64  = cast[f64](live) * heap.__value.cfg.growth_factor
    var target: uint = heap.__value.cfg.initial_heap_bytes
    if scaled > cast[f64]target {
        let maximum: uint = ~cast[uint](0)
        if scaled >= cast[f64]maximum {
            target = maximum
        } else {
            target = cast[uint]scaled
        }
    }
    if heap.__value.cfg.max_heap_bytes != 0 and target > heap.__value.cfg.max_heap_bytes {
        target = heap.__value.cfg.max_heap_bytes
    }

    var budget: uint = 0
    if target > live {
        budget = target - live
    }
    if budget < min_budget {
        budget = min_budget
    }

    heap.__value.live_bytes = live
    heap.__value.target_bytes = target
    heap.__value.alloc_budget = budget
    heap.__value.alloc_since_gc = 0

    let maximum: uint = ~cast[uint](0)
    var keep:    uint = maximum
    if budget <= maximum - target {
        keep = target + budget
    }
    if heap.__value.cfg.max_heap_bytes != 0 and keep > heap.__value.cfg.max_heap_bytes {
        keep = heap.__value.cfg.max_heap_bytes
    }
    heap.__value.keep_bytes = keep
}

func reset_counters(heap: Ref[internal.gc.core.Heap]) {
    __atomic_store(ref heap.__value.cnt_objects, 0)
    __atomic_store(ref heap.__value.cnt_bytes, 0)
    __atomic_store(ref heap.__value.cnt_worker_objects, 0)
    __atomic_store(ref heap.__value.cnt_stack_words, 0)
    __atomic_store(ref heap.__value.cnt_frame_slots, 0)
    __atomic_store(ref heap.__value.cnt_hits, 0)
}

func begin_epoch_locked(heap: Ref[internal.gc.core.Heap]) {
    sweep_all(heap)
    var block: Ref[internal.gc.core.Block_Metadata]? = heap.__value.all_blocks
    while block != nil {
        assert block.__value.sweep_epoch == heap.__value.epoch
        block = block.__value.all_next
    }
    assert __atomic_load(ref heap.__value.nunswept) == 0

    heap.__value.mark_epoch = heap.__value.epoch + 1
    reset_counters(heap)
    let row: Ref[internal.abi.Type_Record]? = internal.abi.type_for(
        typeof(heap.__value.cycle))
    if row != nil {
        __gc_memset(ref heap.__value.cycle, 0,
            internal.abi.size_bytes(row))
    } else {
        require false
    }
    heap.__value.cycle.epoch = heap.__value.mark_epoch
    heap.__value.cycle.rounds = cast[u32](heap.__value.hs_rounds)
    heap.__value.cycle.stragglers = cast[u32](heap.__value.hs_stragglers)
    heap.__value.cycle_start = __unobserved(__os_now_ns())
}

func end_epoch_locked(heap: Ref[internal.gc.core.Heap]) {
    assert heap.__value.pool_full == nil and heap.__value.pool_active == 0
    internal.gc.core.set_marking(heap, false)
    heap.__value.black_alloc = false
    heap.__value.epoch = heap.__value.mark_epoch
    __atomic_store(ref heap.__value.nunswept, heap.__value.nblocks)

    heap.__value.free_blocks = nil
    heap.__value.nfree = 0
    heap.__value.recyclable_blocks = nil
    heap.__value.nrecyclable = 0
    heap.__value.nfull = 0
    heap.__value.sweep_cursor = heap.__value.all_blocks
    heap.__value.los_cursor = ref heap.__value.los

    heap.__value.last_marked_objects = __atomic_load(ref heap.__value.cnt_objects)
    heap.__value.last_marked_bytes = __atomic_load(ref heap.__value.cnt_bytes)
    heap.__value.last_worker_objects = __atomic_load(ref heap.__value.cnt_worker_objects)
    heap.__value.last_stack_words = __atomic_load(ref heap.__value.cnt_stack_words)
    heap.__value.last_frame_slots = __atomic_load(ref heap.__value.cnt_frame_slots)
    heap.__value.last_conservative_hits = __atomic_load(ref heap.__value.cnt_hits)
    heap.__value.collections += 1

    heap.__value.cycle.marked_objects = heap.__value.last_marked_objects
    heap.__value.cycle.marked_bytes = heap.__value.last_marked_bytes
    heap.__value.cycle.allocated_bytes = heap.__value.alloc_since_gc
    update_pacing(heap)
    __atomic_store(ref heap.__value.phase, cast[u32](internal.gc.core.Phase.sweeping))
}

func reclaim_cache(heap: Ref[internal.gc.core.Heap], bump: Ref[internal.gc.core.Bump]) {
    let empty:   Ref[internal.gc.core.Block_Metadata]? = nil
    var current: Ref[internal.gc.core.Block_Metadata]? = __atomic_exchange(
        ref bump.__value.cache, empty)
    while current != nil {
        let block: Ref[internal.gc.core.Block_Metadata] = current
        current = block.__value.next
        internal.gc.core.set_block_state(heap, block, internal.gc.core.Block_State.retired)
    }
}

func reclaim_caches(heap: Ref[internal.gc.core.Heap]) {
    var current: Ref[internal.gc.core.Mutator]? = heap.__value.mutators
    while current != nil {
        let mutator: Ref[internal.gc.core.Mutator] = current
        reclaim_cache(heap, ref mutator.__value.small)
        reclaim_cache(heap, ref mutator.__value.overflow)
        current = mutator.__value.next
    }
}

func release_los(heap: Ref[internal.gc.core.Heap]) {
    var current: Ref[internal.gc.core.Los_Obj]? = heap.__value.release_los
    while current != nil {
        let obj: Ref[internal.gc.core.Los_Obj] = current
        heap.__value.release_los = obj.__value.next
        internal.gc.registry.los_unregister(heap, obj)
        internal.memory.unmap(obj.__value.mapping, obj.__value.mapped_bytes)
        current = heap.__value.release_los
    }
}

func finish_cycle(heap: Ref[internal.gc.core.Heap], fresh: bool) {
    if fresh {
        begin_epoch_locked(heap)
    }
    stop_world(heap)

    var marker: internal.gc.core.Marker
    internal.gc.mark.marker_init(marker, heap, false)
    reclaim_caches(heap)
    drain_barrier_buffers(ref marker)
    reserve_bumps(ref marker)
    mark_roots(ref marker)
    internal.gc.mark.drain_to_termination(ref marker)
    internal.gc.finalize.find_dead_locked(ref marker)
    internal.gc.mark.drain_to_termination(ref marker)
    internal.gc.mark.marker_stats(ref marker)

    end_epoch_locked(heap)
    prune_owned(heap, true)
    var current: Ref[internal.gc.core.Mutator]? = heap.__value.mutators
    while current != nil {
        let mutator: Ref[internal.gc.core.Mutator] = current
        mutator.__value.black = false
        mutator.__value.write_buffer_count = 0
        __atomic_store(ref mutator.__value.hs_state,
            cast[u32](internal.gc.core.Handshake_State.idle))
        current = mutator.__value.next
    }
    heap.__value.sweep_ready = true

    start_world(heap)
    release_los(heap)
    emit_cycle(heap, heap.__value.cycle.kind)
}

func remark_locked(heap: Ref[internal.gc.core.Heap]) {
    if __atomic_load(ref heap.__value.phase) == cast[u32](internal.gc.core.Phase.marking) {
        finish_cycle(heap, false)
    }
}

func start_marking_locked(heap: Ref[internal.gc.core.Heap]) {
    begin_epoch_locked(heap)
    stop_world(heap)

    var marker: internal.gc.core.Marker
    internal.gc.mark.marker_init(marker, heap, false)
    mark_roots(ref marker)
    internal.gc.mark.marker_flush(ref marker)
    internal.gc.mark.marker_stats(ref marker)

    internal.gc.core.set_marking(heap, true)
    __atomic_store(ref heap.__value.phase, cast[u32](internal.gc.core.Phase.marking))
    start_world(heap)
}

func request_cycle(heap: Ref[internal.gc.core.Heap]) {
    __atomic_store(ref heap.__value.cycle_requested, true)
    internal.gc.mark.wake_workers(heap)
}

func cycle_done(heap: Ref[internal.gc.core.Heap]) {
    __atomic_store(ref heap.__value.cycle_active, false)
    internal.gc.core.signal(ref heap.__value.cycle_ended)
}

func claim_cycle(heap: Ref[internal.gc.core.Heap]) {
    while true {
        if __atomic_compare_exchange(ref heap.__value.cycle_active, false, true) {
            return
        }
        internal.gc.handshake.wait_for_cycle(heap)
    }
}

func collect_full_locked(heap: Ref[internal.gc.core.Heap]) {
    remark_locked(heap)
    finish_cycle(heap, true)
}

func collect(heap: Ref[internal.gc.core.Heap]) {
    claim_cycle(heap)
    internal.gc.heap.lock(heap)
    collect_full_locked(heap)
    sweep_all(heap)
    internal.gc.heap.unlock(heap)
    cycle_done(heap)
}

func collect_start(heap: Ref[internal.gc.core.Heap]) {
    if __atomic_load(ref heap.__value.nworkers) != 0 {
        request_cycle(heap)
        return
    }
    internal.gc.heap.lock(heap)
    if __atomic_load(ref heap.__value.phase) != cast[u32](internal.gc.core.Phase.marking) {
        start_marking_locked(heap)
    }
    internal.gc.heap.unlock(heap)
}

func collect_step(heap: Ref[internal.gc.core.Heap], max_objects: uint) -> bool {
    internal.gc.heap.lock(heap)
    if __atomic_load(ref heap.__value.phase) != cast[u32](internal.gc.core.Phase.marking) {
        internal.gc.heap.unlock(heap)
        return false
    }
    var marker: internal.gc.core.Marker
    internal.gc.mark.marker_init(marker, heap, false)
    internal.gc.mark.barrier_queue_drain(ref marker)
    internal.gc.mark.marker_drain(ref marker, max_objects)
    internal.gc.mark.marker_flush(ref marker)
    internal.gc.mark.marker_stats(ref marker)
    let more: bool = !internal.gc.mark.mark_quiescent(heap) or
        heap.__value.barrier_queue_count != 0
    internal.gc.heap.unlock(heap)
    return more
}

func collect_finish(heap: Ref[internal.gc.core.Heap]) {
    if __atomic_load(ref heap.__value.nworkers) != 0 {
        internal.gc.handshake.wait_for_cycle(heap)
        return
    }
    internal.gc.heap.lock(heap)
    remark_locked(heap)
    internal.gc.heap.unlock(heap)
}

func maybe_collect(heap: Ref[internal.gc.core.Heap], request: uint) -> bool {
    let maximum: uint = ~cast[uint](0)
    var used:    uint = maximum
    if request <= maximum - heap.__value.alloc_since_gc {
        used = heap.__value.alloc_since_gc + request
    }
    let phase: u32 = __atomic_load(ref heap.__value.phase)
    if __atomic_load(ref heap.__value.nworkers) != 0 {
        if __atomic_load(ref heap.__value.cycle_active) {
            return phase == cast[u32](internal.gc.core.Phase.marking) and
                used > (heap.__value.alloc_budget / 100) * concurrent_force_pct
        }
        if phase != cast[u32](internal.gc.core.Phase.marking) and
            used > (heap.__value.alloc_budget / 100) * concurrent_start_pct {
            request_cycle(heap)
        }
        return false
    }
    if used > heap.__value.alloc_budget {
        finish_cycle(heap, phase != cast[u32](internal.gc.core.Phase.marking))
    }
    return false
}

func worker(heap: Ref[internal.gc.core.Heap]) {
    var marker: internal.gc.core.Marker
    internal.gc.mark.marker_init(marker, heap, true)
    __atomic_fetch_add(ref heap.__value.nworkers, 1)

    while !__atomic_load(ref heap.__value.shutdown) {
        var did:     uint = internal.gc.mark.marker_drain(ref marker, 0)
        let phase:   u32  = __atomic_load(ref heap.__value.phase)
        let stopped: bool = __atomic_load(ref heap.__value.stw)
        internal.gc.mark.marker_stats(ref marker)

        if !stopped and __atomic_load(ref heap.__value.cycle_requested) and
            __atomic_compare_exchange(ref heap.__value.cycle_active, false, true) {
            __atomic_store(ref heap.__value.cycle_requested, false)
            internal.gc.handshake.run_handshake_cycle(heap)
            cycle_done(heap)
            did += 1
        } elif !stopped and phase == cast[u32](internal.gc.core.Phase.sweeping) and
            internal.locks.mutex_try_lock(ref heap.__value.lock,
                                          timeout_ns = 0) {
            if sweep_some(heap, sweep_batch) {
                did += 1
            }
            internal.gc.heap.unlock(heap)
        }

        if did == 0 {
            internal.locks.condition_lock(ref heap.__value.work_progress)
            if !__atomic_load(ref heap.__value.shutdown)
                and !__atomic_load(ref heap.__value.cycle_requested) {
                internal.locks.condition_wait(ref heap.__value.work_progress,
                    timeout_ns = internal.gc.core.wait_slice_ns,
                    unlock = false)
            }
            internal.locks.condition_unlock(ref heap.__value.work_progress)
        }
    }

    internal.gc.mark.marker_flush(ref marker)
    __atomic_fetch_sub(ref heap.__value.nworkers, 1)
}
