import internal.abi
import internal.gc.core
import internal.gc.finalize
import internal.gc.hash
import internal.gc.los
import internal.gc.mark
import internal.gc.registry
import internal.gc.roots
import internal.locks
import internal.threads
import internal.memory

const initial_heap_bytes:           uint = 4 * 1024 * 1024
const minimum_blocks:               uint = 4
const initial_array_capacity:       uint = 256
const default_handshake_timeout_us: u32  = 1000
const default_world_timeout_ms:     u32  = 10000

func grow_array(arrp: Ref[Ref[byte]?], cap: Ref[uint],
                       element_bytes: uint, alignment: uint,
                       used: uint, need: uint) -> bool {
    let old_cap: uint = cap.__value
    if need <= old_cap {
        return true
    }
    if used > old_cap or element_bytes == 0 or alignment == 0 or
        (alignment & (alignment - 1)) != 0 {
        return false
    }
    let old: Ref[byte]? = arrp.__value
    if used != 0 and old == nil {
        return false
    }

    let maximum:  uint = ~cast[uint](0)
    var next_cap: uint = initial_array_capacity
    if old_cap != 0 {
        if old_cap > maximum / 2 {
            return false
        }
        next_cap = old_cap * 2
    }
    while next_cap < need {
        if next_cap > maximum / 2 {
            return false
        }
        next_cap *= 2
    }
    if next_cap > maximum / element_bytes {
        return false
    }
    let mapped: Ref[byte]? = internal.memory.map_zeroed(
        next_cap * element_bytes, alignment)
    if mapped != nil {
        let base: Ref[byte] = mapped
        if used != 0 {
            if old != nil {
                __gc_memcpy(base, old, used * element_bytes)
            } else {
                require false
            }
        }
        __gc_signal_fence()
        arrp.__value = base
        cap.__value = next_cap
        __gc_signal_fence()
        if old != nil {
            internal.memory.unmap(old, old_cap * element_bytes)
        }
        return true
    }
    return false
}

func heap_record() -> Ref[internal.abi.Type_Record] {
    let probe: Ref[internal.gc.core.Heap]?         = nil
    let row:   Ref[internal.abi.Type_Record]? = internal.abi.optional_reference_target(typeof(probe))
    if row != nil {
        return row
    }
    require false
}

func config_default(out config: internal.gc.core.Config) {
    config = (initial_heap_bytes = initial_heap_bytes, growth_factor = 2.0,
              max_heap_bytes = 0, poison_free = false,
              handshake_timeout_us = default_handshake_timeout_us,
              scan_stacks = false,
              world_timeout_ms = default_world_timeout_ms,
              finalizer_backlog_limit = 64,
              on_pause = nil, on_cycle = nil, telemetry_user = nil)
}

func lock(heap: Ref[internal.gc.core.Heap]) {
    internal.locks.mutex_lock(ref heap.__value.lock)
}

func unlock(heap: Ref[internal.gc.core.Heap]) {
    internal.locks.mutex_unlock(ref heap.__value.lock)
    internal.gc.finalize.notify(heap)
}

func get_stats(heap: Ref[internal.gc.core.Heap]) -> internal.gc.core.Stats {
    var stats: internal.gc.core.Stats
    lock(heap)
    stats.collections = heap.__value.collections
    stats.objects_allocated = heap.__value.retired_objects
    stats.bytes_allocated = heap.__value.retired_bytes
    stats.refills = heap.__value.retired_refills
    stats.locked_refills = heap.__value.retired_locked_refills
    var current: Ref[internal.gc.core.Mutator]? = heap.__value.mutators
    while current != nil {
        let mutator: Ref[internal.gc.core.Mutator] = current
        stats.objects_allocated += mutator.__value.objects_allocated
        stats.bytes_allocated += mutator.__value.bytes_allocated
        stats.refills += mutator.__value.refills
        stats.locked_refills += mutator.__value.locked_refills
        current = mutator.__value.next
    }
    stats.blocks_owned = __atomic_load(ref heap.__value.nowned)
    stats.blocks_unswept = __atomic_load(ref heap.__value.nunswept)
    stats.blocks_total = heap.__value.nblocks
    stats.blocks_free = heap.__value.nfree
    stats.blocks_recyclable = heap.__value.nrecyclable
    stats.blocks_full = heap.__value.nfull
    stats.los_objects = heap.__value.los_count
    stats.los_bytes = heap.__value.los_bytes
    stats.last_marked_objects = heap.__value.last_marked_objects
    stats.last_marked_bytes = heap.__value.last_marked_bytes
    stats.committed_bytes = internal.gc.core.committed_bytes(heap)
    stats.live_bytes = heap.__value.live_bytes
    stats.target_bytes = heap.__value.target_bytes
    stats.alloc_budget = heap.__value.alloc_budget
    stats.alloc_since_gc = heap.__value.alloc_since_gc
    stats.last_stack_words = heap.__value.last_stack_words
    stats.last_frame_slots = heap.__value.last_frame_slots
    stats.last_conservative_hits = heap.__value.last_conservative_hits
    stats.last_worker_objects = heap.__value.last_worker_objects
    stats.workers = __atomic_load(ref heap.__value.nworkers)
    stats.pauses = heap.__value.pauses
    stats.last_pause_ns = heap.__value.last_pause_ns
    stats.max_pause_ns = heap.__value.max_pause_ns
    stats.total_pause_ns = heap.__value.total_pause_ns
    stats.hs_cycles = heap.__value.hs_cycles
    stats.hs_rounds = heap.__value.hs_rounds
    stats.hs_stragglers = heap.__value.hs_stragglers
    stats.hs_blocking = heap.__value.hs_blocking
    stats.hs_fallbacks = heap.__value.hs_fallbacks
    stats.hs_alloc_waits = __atomic_load(ref heap.__value.hs_alloc_waits)
    internal.locks.mutex_lock(ref heap.__value.fin)
    stats.finalizers_pending = __atomic_load(ref heap.__value.finq_n) +
        heap.__value.running_n
    stats.finalizers_run = __atomic_load(ref heap.__value.finalizers_run)
    internal.locks.mutex_unlock(ref heap.__value.fin)
    stats.phase = cast[i32](__atomic_load(ref heap.__value.phase))
    unlock(heap)
    return stats
}

func create(config: Ref[internal.gc.core.Config]?) -> Ref[internal.gc.core.Heap]? {
    internal.abi.cache_tables()
    internal.gc.core.resolve_layout()
    internal.gc.hash.resolve_hash_slot()
    internal.gc.core.resolve_request_limit()
    let row:    Ref[internal.abi.Type_Record] = heap_record()
    let mapped: Ref[byte]?                   = internal.memory.map_zeroed(
        internal.abi.size_bytes(row), internal.abi.alignment_bytes(row))
    if mapped != nil {
        let heap: Ref[internal.gc.core.Heap] = unsafe_cast[Ref[internal.gc.core.Heap]] mapped

        if config != nil {
            heap.__value.cfg = config.__value
        } else {
            config_default(heap.__value.cfg)
        }
        if !(heap.__value.cfg.growth_factor >= 1.0) {
            heap.__value.cfg.growth_factor = 1.0
        }
        if heap.__value.cfg.initial_heap_bytes < minimum_blocks * internal.gc.core.block_bytes {
            heap.__value.cfg.initial_heap_bytes = minimum_blocks * internal.gc.core.block_bytes
        }
        if heap.__value.cfg.max_heap_bytes != 0 and
            heap.__value.cfg.initial_heap_bytes > heap.__value.cfg.max_heap_bytes {
            heap.__value.cfg.initial_heap_bytes = heap.__value.cfg.max_heap_bytes
        }
        if heap.__value.cfg.handshake_timeout_us == 0 {
            heap.__value.cfg.handshake_timeout_us = default_handshake_timeout_us
        }
        if heap.__value.cfg.world_timeout_ms == 0 {
            heap.__value.cfg.world_timeout_ms = default_world_timeout_ms
        }

        internal.locks.mutex_init(ref heap.__value.lock, collector = true)
        internal.locks.mutex_init(ref heap.__value.fin, collector = true)
        internal.locks.mutex_init(ref heap.__value.pool, collector = true)
        internal.locks.rw_lock_init(ref heap.__value.registry,
                                    collector = true)
        internal.locks.condition_init(ref heap.__value.fin_progress,
                                      collector = true)
        internal.locks.condition_init(ref heap.__value.fin_wake,
                                      collector = true)
        internal.locks.condition_init(ref heap.__value.mark_progress,
                                      collector = true)
        internal.locks.condition_init(ref heap.__value.work_progress,
                                      collector = true)
        internal.locks.condition_init(ref heap.__value.cycle_ended,
                                      collector = true)
        internal.locks.condition_init(ref heap.__value.hs_answered,
                                      collector = true)
        heap.__value.target_bytes = heap.__value.cfg.initial_heap_bytes
        heap.__value.alloc_budget = heap.__value.cfg.initial_heap_bytes
        heap.__value.epoch = 1
        heap.__value.mark_epoch = 1
        heap.__value.los_cursor = ref heap.__value.los
        heap.__value.sweep_ready = true
        __atomic_store(ref heap.__value.phase, cast[u32](internal.gc.core.Phase.idle))
        return heap
    }
    return nil
}

func destroy(heap: Ref[internal.gc.core.Heap]) {
    __atomic_fetch_add(ref heap.__value.fin_live, 1)
    __atomic_store(ref heap.__value.shutdown, true)
    while __atomic_load(ref heap.__value.nworkers) != 0 {
        internal.gc.core.signal(ref heap.__value.work_progress)
        internal.threads.thread_yield()
    }
    internal.gc.finalize.close_thread(heap)
    internal.gc.finalize.release_live(heap)
}

func teardown(heap: Ref[internal.gc.core.Heap]) {
    internal.gc.finalize.run(heap, 0)
    let mutator_probe: Ref[internal.gc.core.Mutator]?      = nil
    let mutator_row:   Ref[internal.abi.Type_Record]? = internal.abi.optional_reference_target(
        typeof(mutator_probe))
    if mutator_row != nil {
        var attached: Ref[internal.gc.core.Mutator]? = heap.__value.mutators
        while attached != nil {
            let mutator: Ref[internal.gc.core.Mutator] = attached
            attached = mutator.__value.next
            internal.gc.roots.free(mutator)
            internal.gc.roots.free_tls(mutator)
            internal.memory.unmap(mutator, internal.abi.size_bytes(mutator_row))
        }
        heap.__value.mutators = nil
        heap.__value.nmutators = 0
    } else {
        require false
    }
    var candidate: Ref[internal.gc.core.Block_Metadata]? = heap.__value.all_blocks
    while candidate != nil {
        let block: Ref[internal.gc.core.Block_Metadata]  = candidate
        let next:  Ref[internal.gc.core.Block_Metadata]? = block.__value.all_next
        internal.memory.unmap(block, internal.gc.core.block_bytes)
        candidate = next
    }
    internal.gc.los.free_all(heap)
    internal.gc.mark.pool_free_all(heap)
    internal.gc.registry.regions_free(heap)
    let final_queue: Ref[byte]? = heap.__value.finq
    if final_queue != nil {
        let probe: Ref[internal.gc.core.Final_Entry]?  = nil
        let row:   Ref[internal.abi.Type_Record]? = internal.abi.optional_reference_target(typeof(probe))
        if row != nil {
            internal.memory.unmap(final_queue, heap.__value.finq_cap * internal.abi.size_bytes(row))
        } else {
            require false
        }
    }
    let queued: Ref[byte]? = heap.__value.barrier_queue
    if queued != nil {
        let probe: Ref[byte]?                    = nil
        let row:   Ref[internal.abi.Type_Record]? = internal.abi.type_for(typeof(probe))
        if row != nil {
            internal.memory.unmap(queued, heap.__value.barrier_queue_capacity
                * internal.abi.size_bytes(row))
        } else {
            require false
        }
    }
    internal.gc.hash.tab_free(ref heap.__value.threads)
    let global_storage: Ref[byte]? = heap.__value.globals
    if global_storage != nil {
        let probe:       Ref[Ref[byte]?]?              = nil
        let pointer_row: Ref[internal.abi.Type_Record]? = internal.abi.type_for(typeof(probe))
        if pointer_row != nil {
            let stride: uint = internal.abi.size_bytes(pointer_row)
            internal.memory.unmap(global_storage, heap.__value.cap_globals * stride)
        } else {
            require false
        }
    }
    internal.gc.hash.index_tab_free(ref heap.__value.global_index)
    internal.memory.unmap(heap, internal.abi.size_bytes(heap_record()))
}
