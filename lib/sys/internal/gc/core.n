import internal.threads
import internal.abi
import internal.gc.hash

public const granule_bytes:     uint = 16
public const line_bytes:        uint = 128
public const block_bytes:       uint = 32768
public const word_bits:         uint = 64
const lines_per_block:          uint = block_bytes / line_bytes
const granules_per_block:       uint = block_bytes / granule_bytes
const bitmap_words:             uint = granules_per_block / 64
public const block_magic:       u32  = 0x6d616e69
public const cache_max:         uint = 8
public const los_classes:       uint = 256
public const obj_large:         uint = 1 << 0
public const obj_array_backing: uint = 1 << 1
public const obj_final:         uint = 1 << 3
const empty_word:               uint = 0
const mark_clearing:            u32  = 0x80000000
public const meta_flag_bits:    uint = 8
const meta_flag_mask:           uint = 0xff
public const packet_cap:        uint = 500
public const final_batch:       uint = 256
public const packet_chunk:      uint = 64
public const write_buffer_cap:  uint = 128
public const lock_slots:        u32  = 64

var object_header_size:         uint = 0
var block_header_line_count:    uint = 0


enum Block_State     { owned, retired, free, recyclable, full }
enum Phase           { idle, marking, sweeping }
enum Handshake_State { idle, requested, busy, claimed, done }
enum Handshake_Kind  { on, scan, sweep }

record Object_Header layout(c) {
    type_index:    u32
    reserved_zero: u32
    meta:          uint
}

record Block_Metadata layout(c) {
    magic:       u32
    state:       u8
    on_owned:    bool
    free_lines:  u16
    sweep_epoch: u32
    mark_epoch:  Atomic[u32]
    black_epoch: Atomic[u32]
    nfinal:      Atomic[u32]
    in_final:    Atomic[bool]
    final_next:  Ref[Block_Metadata]?
    owner:       Ref[Mutator]?
    next:        Ref[Block_Metadata]?
    all_next:    Ref[Block_Metadata]?
    all_prev:    Ref[Block_Metadata]?
    own_next:    Ref[Block_Metadata]?
    line_marks:  Array[Atomic[u8]][lines_per_block]
    mark_bits:   Array[Atomic[uint]][bitmap_words]
    start_bits:  Array[Atomic[uint]][bitmap_words]
}

record Bump layout(c) {
    cursor:     Ref[byte]?
    limit:      Ref[byte]?
    blk:        Ref[Block_Metadata]?
    line:       uint
    seen_epoch: u32
    cache:      Atomic[Ref[Block_Metadata]?]
}

