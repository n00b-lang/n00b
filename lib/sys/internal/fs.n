import internal.errno
import internal.os

func open_read(path: string) -> i32 fail: internal.errno.Errno {
    return internal.os.open(path, internal.os.Access.read_only)!
}

# The size of the file `fd` refers to. Leaves its offset at the start.
func size(fd: i32) -> uint fail: internal.errno.Errno {
    let end: uint = internal.os.seek(fd, 0, internal.os.Whence.end)!
    _ = internal.os.seek(fd, 0, internal.os.Whence.start)!
    return end
}

func read_into(fd: i32, modify buffer: Array[u8], at: uint, count: uint)
    -> uint fail: internal.errno.Errno {
    require at <= __array_length(buffer)
    require count <= __array_length(buffer) - at
    return internal.os.read(fd, buffer, at, at + count)!
}

func close(fd: i32) fail: internal.errno.Errno {
    internal.os.close(fd)!
}

func read_file(path: string) -> Array[u8] fail: internal.errno.Errno {
    let fd: i32 = open_read(path)!
    try {
        let length: uint = size(fd)!
        var data: Array[u8] = new[Array[u8]](length)
        var done: uint = 0
        while done < length {
            let got: uint = read_into(fd, data, done, length - done)!
            if got == 0 {
                # The file shrank while it was read.
                fail internal.errno.Errno.EIO
            }
            done += got
        }
        close(fd)!
        return data
    } fail(failure) {
        try {
            internal.os.close(fd)!
        } fail(ignored) {
        }
        fail failure
    }
}

func data_file(path: string) -> Array[u8] {
    var data: Array[u8] = []
    try {
        data = read_file(path)!
    } fail(failure) {
        os_failure("cannot read data file " + path, cast[int](failure))
    }
    return data
}
