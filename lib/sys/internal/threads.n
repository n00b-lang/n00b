import internal.os.futex
import internal.os.thread

const context_registers: uint = 48

record Thread_Context layout(c) {
    sp:        Ref[byte]?
    fp:        Ref[byte]?
    nregs:     uint
    regs:      Array[uint][context_registers]
    parked:    Atomic[u32]
    handle:    uint
    thread_id: u64
    pc:        Ref[byte]?
}

[-
library n00b

fn n00b_os_thread_id() -> u64
  effects none
fn n00b_os_thread_is_main() -> u64
  effects none
# Starts a thread that runs `entry(argument)`. The runtime makes the thread
# and attaches it to the collector before the entry runs, which n00b code
# can't do on a thread that isn't attached yet.
fn n00b_os_thread_start(entry: *void, argument: ?void) -> c_int
  effects threads, alloc, blocking
# Saves the calling thread's registers, its stack and frame pointers and
# its return address in a `Thread_Context`. It's assembly, which the
# runtime's own entry to a blocking call also uses.
fn n00b_os_thread_capture_self(snapshot: out *u8)
  effects none

binding {
    raw "n00b_os_thread_*"
}
-]'ffi

[-
library n00b

callback Thread_Entry = fn(argument: ?void userdata) -> ?void
  thread any

fn n00b_os_thread_start(entry: Thread_Entry once,
                        argument: ?void userdata entry) -> c_int
  effects threads, alloc, blocking, of entry
-]'ffi

func thread_start(entry: Thread_Entry) -> bool {
    return n00b_os_thread_start(entry) == 0
}

func collector_thread_start(entry: Ref[(Ref[byte]) -> Ref[byte]],
                            argument: Ref[byte]) -> bool {
    return n00b_os_thread_start_raw(unsafe_cast[Ref[byte]] entry,
                                    argument) == 0
}

func thread_is_main() -> bool {
    return n00b_os_thread_is_main_raw() != 0
}

func thread_yield() {
    internal.os.thread.thread_yield()
}

func thread_fence() {
    __thread_fence()
}

func futex_wait(word: Ref[Atomic[u32]], expected: u32, timeout_ns: uint) -> i32 {
    return internal.os.futex.futex_wait(word, expected, timeout_ns)
}

func futex_wake_all(word: Ref[Atomic[u32]]) -> i32 {
    return internal.os.futex.futex_wake_all(word)
}

func thread_id() -> uint {
    return n00b_os_thread_id_raw()
}

func thread_stack_high_self() -> Ref[byte]? {
    return internal.os.thread.thread_stack_high_self()
}

func thread_stack_entry(address: uint) -> bool {
    return internal.os.thread.thread_stack_entry(address)
}

func stack_address() -> uint {
    return __stack_pointer()
}

func stack_red_zone_bytes() -> uint {
    when target_arch() == "x86_64" and target_os() != "windows" {
        return 128
    } else when target_os() == "macos" {
        return 128
    } else {
        return 0
    }
}

func frame_pointer_chain() -> bool {
    when target_os() == "windows" {
        return false
    } else {
        return true
    }
}

func thread_capture_self(snapshot: Ref[Thread_Context]) {
    n00b_os_thread_capture_self_raw(unsafe_cast[Ref[byte]] snapshot)
}

func thread_control_self() -> uint {
    return internal.os.thread.thread_control_self()
}

func cpu_relax() {
    __cpu_relax()
}
