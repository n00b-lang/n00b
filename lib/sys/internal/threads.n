const context_registers: uint = 48

record Thread_Context layout(c) {
    sp:        Ref[byte]?
    fp:        Ref[byte]?
    nregs:     uint
    regs:      Array[uint][context_registers]
    parked:    Atomic[u32]
    handle:    uint
    thread_id: u64
    pc:        Ref[byte]?
}

# The runtime's thread queries, as direct calls. The collector uses these
# where no mutator may be needed, so this literal has no shims and no
# state of its own.
[-
library n00b

fn n00b_os_thread_yield()
  effects none
fn n00b_os_thread_id() -> u64
  effects none
fn n00b_os_thread_is_main() -> u64
  effects none

binding {
    raw "n00b_os_thread_*"
}
-]'ffi

# Starting a thread. The runtime attaches the new thread to the collector
# before it runs the entry, and detaches it after.
[-
library n00b

callback Thread_Entry = fn(argument: ?void userdata) -> ?void
  thread any

fn n00b_os_thread_start(entry: Thread_Entry once,
                        argument: ?void userdata entry) -> c_int
  effects threads, alloc, blocking, of entry
-]'ffi

# Starts a thread that runs `entry`; false when it can't be started. Make
# the entry with `callback[sys.threads.Thread_Entry](ref f, ...)`, binding
# any arguments `f` takes.
func thread_start(entry: Thread_Entry) -> bool {
    return n00b_os_thread_start(entry) == 0
}

# The collector's own thread start, which allocates nothing: the collector
# starts its finalizer thread from code that may run before the thread has
# a mutator, where a callback (an object on the heap) can't be made.
func collector_thread_start(entry: Ref[(Ref[byte]) -> Ref[byte]],
                            argument: Ref[byte]) -> bool {
    return __os_thread_start(entry, argument) == 0
}

func thread_is_main() -> bool {
    return n00b_os_thread_is_main_raw() != 0
}

func thread_yield() {
    n00b_os_thread_yield_raw()
}

func thread_fence() {
    __os_thread_fence()
}

func futex_wait(word: Ref[Atomic[u32]], expected: u32, timeout_ns: uint) -> i32 {
    return __os_futex_wait(word, expected, timeout_ns)
}

func futex_wake_all(word: Ref[Atomic[u32]]) -> i32 {
    return __os_futex_wake_all(word)
}

func thread_id() -> uint {
    return n00b_os_thread_id_raw()
}

func thread_stack_high_self() -> Ref[byte]? {
    return __os_thread_stack_high_self()
}

func stack_address() -> uint {
    return __os_stack_address()
}

func stack_red_zone_bytes() -> uint {
    return __os_stack_red_zone_bytes()
}

func frame_pointer_chain() -> bool {
    return __os_frame_pointer_chain() != 0
}

func thread_control_self() -> uint {
    return __os_thread_control_self()
}

func thread_suspend(control: uint, snapshot: Ref[Thread_Context], timeout_ns: u64)
                   -> i32 {
    return __os_thread_suspend(control, snapshot, timeout_ns)
}

func thread_resume(control: uint, snapshot: Ref[Thread_Context]) -> i32 {
    return __os_thread_resume(control, snapshot)
}

func cpu_relax() {
    __os_cpu_relax()
}
