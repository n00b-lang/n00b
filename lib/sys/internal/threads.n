const context_registers: uint = 48

record Thread_Context layout(c) {
    sp:        Ref[byte]?
    fp:        Ref[byte]?
    nregs:     uint
    regs:      Array[uint][context_registers]
    parked:    Atomic[u32]
    handle:    uint
    thread_id: u64
    pc:        Ref[byte]?
}

func thread_yield() {
    __os_thread_yield()
}

func thread_fence() {
    __os_thread_fence()
}

func futex_wait(word: Ref[Atomic[u32]], expected: u32, timeout_ns: uint) -> i32 {
    return __os_futex_wait(word, expected, timeout_ns)
}

func futex_wake_all(word: Ref[Atomic[u32]]) -> i32 {
    return __os_futex_wake_all(word)
}

func thread_id() -> uint {
    return __os_thread_id()
}

func thread_start(entry: Ref[(Ref[byte]) -> Ref[byte]], argument: Ref[byte]) -> bool {
    return __os_thread_start(entry, argument) == 0
}

func thread_stack_high_self() -> Ref[byte]? {
    return __os_thread_stack_high_self()
}

func stack_address() -> uint {
    return __os_stack_address()
}

func stack_red_zone_bytes() -> uint {
    return __os_stack_red_zone_bytes()
}

func thread_control_self() -> uint {
    return __os_thread_control_self()
}

func thread_capture_self(snapshot: Ref[Thread_Context]) {
    __os_thread_capture_self(snapshot)
}

func thread_suspend(control: uint, snapshot: Ref[Thread_Context], timeout_ns: u64)
                   -> i32 {
    return __os_thread_suspend(control, snapshot, timeout_ns)
}

func thread_resume(control: uint, snapshot: Ref[Thread_Context]) -> i32 {
    return __os_thread_resume(control, snapshot)
}

func cpu_relax() {
    __os_cpu_relax()
}
